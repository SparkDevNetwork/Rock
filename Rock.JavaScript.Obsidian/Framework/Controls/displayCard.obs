<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="displaycard"
         :class="{
            'is-hovering': isHovering && !isRadioSelectable,
            'is-selected': isSelected && !isRadioSelectable,
            'clickable': !!props.onClick && !disabled,
            'is-compact': isCompact,
            'is-disabled': disabled
        }"
         :role="isRadioSelectable ? 'radio' : undefined"
         :aria-checked="isRadioSelectable ? isSelected : undefined"
         @mouseenter="onMouseEnter"
         @mouseleave="onMouseLeave"
         @click="onMainClick">

        <div v-if="isReorderable" class="displaycard-reorder reorder-handle" title="Drag to reorder">
            <i class="ti ti-grip-vertical"></i>
        </div>
        <div class="displaycard-main">
            <slot name="prepend" />

            <div v-if="badgeText" class="displaycard-badge">
                <Badge :badgeType="badgeType === 'default' ? undefined : badgeType">{{ badgeText }}</Badge>
            </div>

            <div class="displaycard-heading">
                <div v-if="iconCssClass"
                     class="displaycard-heading-icon"
                     :class="iconStyle === 'tile' ? `displaycard-heading-icon-tile displaycard-heading-icon-tile-${internalIconLabelType}` : ''">
                    <i v-if="iconStyle === 'tile'" :class="`${iconCssClass}`"></i>
                    <HighlightLabel v-else :labelType="internalIconLabelType" :iconCssClass="`${iconCssClass}`" :customClass="internalIconLabelCustomClass" />
                </div>

                <div v-if="title || description || $slots.description" class="displaycard-heading-text">
                    <h5 v-if="title" v-tooltip.overflow="title" class="displaycard-heading-text-title">
                        <a v-if="titleUrl" :href="titleUrl" @click.stop>{{ title }}</a>
                        <template v-else>{{ title }}</template>
                    </h5>
                    <small v-if="description || $slots.description" v-tooltip.overflow="description" class="displaycard-heading-text-description">
                        <slot name="description">
                            {{ description }}
                        </slot>
                    </small>
                </div>
            </div>

            <div v-if="$slots.middleSection" class="displaycard-content">
                <slot name="middleSection" />
            </div>

            <div v-if="$slots.rightMiddleSection" class="displaycard-content">
                <slot name="rightMiddleSection" />
            </div>

            <div v-if="asideIconCssClass || aside || $slots.aside" class="displaycard-aside">
                <slot name="aside">
                    <i v-if="asideIconCssClass" v-tooltip="aside" :class="`${asideIconCssClass}`"></i>
                    <small v-if="aside" v-tooltip.overflow="aside">{{ aside }}</small>
                </slot>
            </div>

            <div v-if="primaryActions?.length || secondaryActions?.length || $slots.actions" class="displaycard-actions">
                <slot name="actions">
                    <div v-if="primaryActions?.length" class="displaycard-primary-actions">
                        <template v-for="action in primaryActions" :key="`${action.title}${action.iconCssClass}`">
                            <RockButton v-if="action.iconCssClass"
                                        isSquare btnSize="sm"
                                        :btnType="action.type"
                                        :title="action.title"
                                        :tooltip="action.title"
                                        :disabled="action.disabled"
                                        @click.stop="action.handler">
                                <i :class="action.iconCssClass"></i>
                            </RockButton>

                            <RockButton v-else btnSize="sm"
                                        :btnType="action.type"
                                        :title="action.title"
                                        :tooltip="action.title"
                                        :disabled="action.disabled"
                                        @click.stop="action.handler">
                                {{ action.title }}
                            </RockButton>
                        </template>
                    </div>

                    <div v-if="secondaryActions?.length" class="displaycard-secondary-actions">
                        <DropDownMenu align="right"
                                      :items="secondaryActions"
                                      @click.stop
                                      @mouseenter="isHovering = false"
                                      @mouseleave="isHovering = true" />
                    </div>
                </slot>
            </div>

            <div v-if="isRadioSelectable" class="displaycard-selection" :class="{ 'is-checked': isSelected }"></div>
        </div>

        <TransitionVerticalCollapse v-if="$slots.expanded">
            <div v-show="isExpanded" class="displaycard-expanded" @click.stop>
                <slot name="expanded" />
            </div>
        </TransitionVerticalCollapse>
    </div>
</template>

<style scoped>
/* The card is a vertical wrapper: the heading/content/actions row lives in
   .displaycard-main and the accordion region spans the full width beneath it.
   Padding moves to .displaycard-main so the expanded band runs edge to edge. */
.displaycard {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0;
}

.displaycard-main {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-large);
    padding: var(--spacing-large);
}

/* Opt-in (iconStyle="tile") icon tile: a soft, rounded square holding the icon
   glyph, tinted by iconLabelType. The per-type classes set the tile's fg/bg via
   custom properties; an unmapped type falls back to neutral interface colors. */
.displaycard-heading-icon-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--rounded-small);
    background-color: var(--icon-tile-bg, var(--color-interface-softer));
    color: var(--icon-tile-fg, var(--color-interface-strong));
}

.displaycard-heading-icon-tile i {
    font-size: var(--font-size-h5);
    line-height: 1;
}

.displaycard-heading-icon-tile-primary {
    --icon-tile-bg: var(--color-primary-soft);
    --icon-tile-fg: var(--color-primary);
}

.displaycard-heading-icon-tile-info {
    --icon-tile-bg: var(--color-info-soft);
    --icon-tile-fg: var(--color-info-strong);
}

.displaycard-heading-icon-tile-success {
    --icon-tile-bg: var(--color-success-soft);
    --icon-tile-fg: var(--color-success-strong);
}

.displaycard-heading-icon-tile-warning {
    --icon-tile-bg: var(--color-warning-soft);
    --icon-tile-fg: var(--color-warning-strong);
}

.displaycard-heading-icon-tile-danger {
    --icon-tile-bg: var(--color-danger-soft);
    --icon-tile-fg: var(--color-danger-strong);
}

/* A selected card holds the soft-info tint persistently, the same treatment the
   clickable hover state applies, so a chosen card stays visually distinct. The
   expanded band keeps its own surface below, so the tint reads as a highlighted
   header above white content. */
.displaycard.is-selected {
    background-color: var(--color-info-soft);
}

.displaycard-selection {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--color-interface-soft);
}

.displaycard-selection.is-checked {
    border-color: var(--color-primary);
    background-image: radial-gradient(circle, var(--color-primary) 0 35%, transparent 36% 100%);
}

/* A disabled card ignores clicks and dims to signal it is not interactive. Slot
   content is disabled by the consumer, so only the card chrome is dimmed here. */
.displaycard.is-disabled {
    cursor: not-allowed;
    opacity: 0.6;
}

/* An opaque surface keeps the band distinct from the selected/hover header tint.
   Spacing is left to the slot content so the expanded region is not opinionated. */
.displaycard-expanded {
    background-color: var(--color-interface-softer);
    border-bottom-left-radius: var(--rounded-xsmall);
    border-bottom-right-radius: var(--rounded-xsmall);
}

/* Bootstrap's xs tier (below the small breakpoint) stacks the row and tightens
   its spacing; the active breakpoint comes from useBreakpointHelper. */
.displaycard.is-compact .displaycard-main {
    flex-direction: column;
    height: auto;
    padding: var(--spacing-medium);
    gap: var(--spacing-medium);
}

.displaycard-reorder {
    cursor: grab;
}

.displaycard-reorder:active {
    cursor: grabbing;
}
</style>

<script setup lang="ts">
    import { computed, PropType, ref } from "vue";
    import Badge from "./badge.obs";
    import DropDownMenu from "./dropDownMenu.obs";
    import HighlightLabel from "./highlightLabel.obs";
    import RockButton from "./rockButton.obs";
    import TransitionVerticalCollapse from "./transitionVerticalCollapse.obs";
    import { MenuAction } from "@Obsidian/Types/Controls/dropDownMenu";
    import { BadgeType } from "@Obsidian/Enums/Controls/badgeType";
    import { vTooltip } from "@Obsidian/Directives/tooltip";
    import { useBreakpointHelper } from "@Obsidian/Utility/breakpointHelper";

    const highlightLabelTypes = ["default", "primary", "success", "info", "warning", "danger", "type", "campus", "custom"] as const;
    type HighlightLabelType = (typeof highlightLabelTypes)[number];

    const props = defineProps({
        aside: {
            type: String as PropType<string | null | undefined>,
            required: false
        },

        asideIconCssClass: {
            type: String as PropType<string | null | undefined>,
            required: false
        },

        badgeText: {
            type: String as PropType<string | null | undefined>,
            required: false
        },

        badgeType: {
            type: String as PropType<BadgeType | "default">,
            required: false,
            default: "success" as const
        },

        iconCssClass: {
            type: String as PropType<string | null | undefined>,
            required: false
        },

        iconLabelType: {
            type: String as PropType<Omit<HighlightLabelType, "custom"> | string>,
            default: "info" as const
        },

        /**
         * How the leading icon is rendered. "label" (default) draws it as a
         * HighlightLabel badge, preserving existing consumers. "tile" draws it
         * as a soft, rounded icon tile colored by <c>iconLabelType</c>.
         */
        iconStyle: {
            type: String as PropType<"label" | "tile">,
            default: "label" as const
        },

        iconTitleAndDescMinWidth: {
            type: String as PropType<string>,
            required: false,
            default: "150px" as const
        },

        /**
         * Whether this card shows a drag grip so it can be reordered. Off by
         * default.
         *
         * Reordering requires BOTH props: this one, which renders the grip on
         * the card, AND <c>isReorderable</c> on the enclosing
         * <DisplayCardContainer>, which wires up the drag and emits the
         * reorder event.
         */
        isReorderable: {
            type: Boolean,
            default: false
        },

        description: {
            type: String as PropType<string | null | undefined>,
            required: false
        },

        /**
         * When true, the content of the <c>expanded</c> slot is revealed below
         * the card's main row (accordion mode). Defaults to collapsed.
         */
        isExpanded: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /**
         * When true, the card carries a persistent soft-info tint to mark it
         * as chosen. Defaults to unselected so existing consumers are unaffected.
         */
        isSelected: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /**
         * When true, the card acts as a radio option: it renders a trailing radio
         * indicator, exposes radio semantics (role/aria-checked) for assistive
         * tech, and suppresses the soft-info highlight/hover tint so the indicator
         * is the only selection cue. Selection itself is still handled by the
         * consumer via <c>onClick</c>, with the chosen card driven by
         * <c>isSelected</c>. Defaults to false, leaving the standard highlight
         * behavior so existing consumers are unaffected.
         */
        isRadioSelectable: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /**
         * When true, the card ignores clicks and is visually dimmed. Consumers
         * remain responsible for disabling any interactive slot content
         * (checkboxes, action buttons, editors) they provide.
         */
        disabled: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        minWidth: {
            type: String as PropType<string>,
            required: false,
            default: "440px" as const
        },

        primaryActions: {
            type: Array as PropType<MenuAction[] | null | undefined>,
            required: false
        },

        secondaryActions: {
            type: Array as PropType<MenuAction[] | null | undefined>,
            required: false
        },

        title: {
            type: String as PropType<string | null | undefined>,
            required: false
        },

        /**
         * Optional URL the title should link to. When set, the title
         * renders as an anchor; clicks navigate without triggering the
         * card-level <c>onClick</c> handler.
         */
        titleUrl: {
            type: String as PropType<string | null | undefined>,
            required: false
        },

        /**
         * Optional click handler that will be called when the main item
         * is clicked.
         */
        onClick: {
            type: Function as PropType<() => void>,
            required: false
        }
    });

    // #region Values

    const isHovering = ref<boolean>(false);

    const breakpoint = useBreakpointHelper();

    // #endregion Values

    // #region Computed Values

    const internalIconLabelType = computed<HighlightLabelType>(() => {
        const currentValue = props.iconLabelType;

        if (!currentValue) {
            // Return "info" by default if empty.
            return "info";
        }
        else if (isHighlightLabelType(currentValue)) {
            return currentValue;
        }
        else {
            return "custom";
        }
    });

    const internalIconLabelCustomClass = computed<string | undefined>(() => {
        if (isHighlightLabelType(props.iconLabelType) && props.iconLabelType !== "custom") {
            return undefined;
        }
        else {
            return props.iconLabelType as string ?? undefined;
        }
    });

    // Bootstrap's xs tier (below the small breakpoint) drives the compact layout.
    const isCompact = computed<boolean>(() => breakpoint.value.isXs);

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Handles the click event on the main item. This will simply call the
     * onClick function if it is defined. This is used so that we can detect
     * when a click handler is defined and apply the "clickable" class.
     */
    function onMainClick(): void {
        if (props.onClick && !props.disabled) {
            props.onClick();
        }
    }

    function onMouseEnter(): void {
        if (props.onClick && !props.disabled) {
            isHovering.value = true;
        }
    }

    function onMouseLeave(): void {
        if (props.onClick) {
            isHovering.value = false;
        }
    }

    // #endregion Event Handlers

    // #region Functions

    function isHighlightLabelType(value: unknown): value is HighlightLabelType {
        return typeof value === "string"
            && highlightLabelTypes.map(t => t as string).includes(value);
    }

    // #endregion Functions
</script>
