<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="kpi-tile" :class="[`kpi-tile-${variant}`, { 'kpi-tile-borderless': isBorderless }]">
        <div ref="headerElement" class="kpi-tile-header" v-tooltip.overflow="() => getElementText(headerElement)">
            <slot name="label">
                {{ label }}
            </slot>
            <i v-if="help" class="ti ti-info-circle kpi-tile-help" v-tooltip="help"></i>
        </div>

        <div ref="valueElement" class="kpi-tile-value" :style="{ color: valueColor }" v-tooltip.overflow="() => getElementText(valueElement)">
            <slot name="value">
                {{ displayValue }}
            </slot>
        </div>

        <div v-if="$slots.footer" ref="footerElement" class="kpi-tile-footer" v-tooltip.overflow="() => getElementText(footerElement)">
            <slot name="footer" />
        </div>
    </div>
</template>

<style scoped>
.kpi-tile {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-large);

    border: 1px solid var(--color-interface-soft);
    border-radius: var(--rounded-medium);
}

/* Both variants are filled; the light variant simply uses a lighter fill than the default. */
.kpi-tile-default {
    background: var(--color-interface-softer);
}

.kpi-tile-light {
    background: var(--color-interface-softest);
}

.kpi-tile-borderless {
    border: none;
}

/* The three text rows clip to a single line; the overflow tooltip reveals the full text. */
.kpi-tile-header,
.kpi-tile-value,
.kpi-tile-footer {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.kpi-tile-header {
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    color: var(--color-interface-strong);
    margin-bottom: var(--spacing-medium);
}

.kpi-tile-help {
    color: var(--color-interface-medium);
    cursor: pointer;
    margin-left: var(--spacing-tiny);
}

.kpi-tile-value {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-xsmall);
}

.kpi-tile-footer {
    font-size: var(--font-size-xsmall);
    color: var(--color-interface-medium);
}
</style>

<script setup lang="ts">
    import { computed, onMounted, onUnmounted, PropType, ref, watch } from "vue";
    import { vTooltip } from "@Obsidian/Directives/tooltip";

    const props = defineProps({
        /** The short text label describing what the value represents. */
        label: {
            type: String as PropType<string | undefined>
        },

        /** Optional help text shown in a tooltip on an info icon beside the label. */
        help: {
            type: String as PropType<string | undefined>
        },

        /** The value to display. Numbers are formatted with group separators. */
        value: {
            type: [String, Number] as PropType<string | number | undefined>
        },

        /** An optional CSS color applied to the value text. */
        valueColor: {
            type: String as PropType<string | undefined>
        },

        /**
         * The visual variant. "default" is a filled card; "light" uses a lighter fill.
         */
        variant: {
            type: String as PropType<"default" | "light">,
            default: "default"
        },

        /** When true, the tile is drawn without its border. */
        isBorderless: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /**
         * When true, a numeric value counts up to its target when it first appears and
         * whenever it changes. Ignored for string values and when the value slot is used.
         */
        isValueAnimated: {
            type: Boolean as PropType<boolean>,
            default: false
        }
    });

    // #region Values

    const headerElement = ref<HTMLElement | undefined>();
    const valueElement = ref<HTMLElement | undefined>();
    const footerElement = ref<HTMLElement | undefined>();

    // The tweened value shown while a count-up animation is running.
    const animatedValue = ref<number>(typeof props.value === "number" ? props.value : 0);

    // Duration of the count-up in milliseconds. Short enough to stay subtle.
    const animationDurationMs = 800;

    let animationFrame: number | null = null;

    // #endregion Values

    // #region Computed Values

    // The value rendered in the tile: the tweened number while animating, otherwise the
    // formatted number, or the raw string for non-numeric values.
    const displayValue = computed<string>(() => {
        if (typeof props.value !== "number") {
            return props.value ?? "";
        }

        const shown = props.isValueAnimated ? animatedValue.value : props.value;
        return shown.toLocaleString(undefined);
    });

    // #endregion Computed Values

    // #region Functions

    /**
     * Gets the rendered text of a row so it can be used as its tooltip content. The
     * text is read from the element because the rows may be filled by a slot.
     *
     * @param element The row element to read.
     *
     * @returns The trimmed text of the element.
     */
    function getElementText(element: HTMLElement | undefined): string {
        return element?.textContent?.trim() ?? "";
    }

    /**
     * Tweens the displayed value from its current amount to the target with an ease-out
     * curve. Honors the user's reduced-motion preference by jumping straight to the target.
     *
     * @param target The numeric value to count up (or down) to.
     */
    function animateTo(target: number): void {
        if (animationFrame !== null) {
            cancelAnimationFrame(animationFrame);
            animationFrame = null;
        }

        const prefersReducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
        const start = animatedValue.value;

        if (prefersReducedMotion || start === target) {
            animatedValue.value = target;
            return;
        }

        const isInteger = Number.isInteger(target);
        const startTime = performance.now();

        const step = (now: number): void => {
            const progress = Math.min((now - startTime) / animationDurationMs, 1);

            // Ease-out cubic: fast start, gentle settle.
            const eased = 1 - Math.pow(1 - progress, 3);
            const current = start + (target - start) * eased;

            animatedValue.value = isInteger ? Math.round(current) : Math.round(current * 10) / 10;

            if (progress < 1) {
                animationFrame = requestAnimationFrame(step);
            }
            else {
                // Land exactly on the target so no rounding drift remains.
                animatedValue.value = target;
                animationFrame = null;
            }
        };

        animationFrame = requestAnimationFrame(step);
    }

    // #endregion Functions

    // #region Watchers

    watch(() => props.value, (newValue) => {
        if (typeof newValue !== "number") {
            return;
        }

        if (props.isValueAnimated) {
            animateTo(newValue);
        }
        else {
            animatedValue.value = newValue;
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(() => {
        // Roll up from zero the first time an animated numeric value is shown.
        if (props.isValueAnimated && typeof props.value === "number") {
            animatedValue.value = 0;
            animateTo(props.value);
        }
    });

    onUnmounted(() => {
        if (animationFrame !== null) {
            cancelAnimationFrame(animationFrame);
        }
    });

    // #endregion Lifecycle Hooks
</script>
