<template>
    <Panel :hasTitle="false"
           v-model:isFullscreen="isFullscreen">
        <template #panelHeader>
            <div class="panel-header grouped-grid-panel-header flex-shrink-0">
                <h1 class="panel-title grouped-grid-panel-title">
                    <i v-if="titleIconCssClass" :class="titleIconCssClass"></i>
                    <span class="grouped-grid-panel-title-text">{{ title }}</span>
                </h1>

                <div class="grouped-grid-panel-badges mr-3">
                    <HighlightLabel>
                        {{ countMessage }}
                    </HighlightLabel>
                </div>

                <!-- Forces the header actions onto their own row below the title and count at widths under 600px. Hidden at 600px and up by the scoped media query below. -->
                <div style="height: 0; border-bottom: 1px solid var(--color-interface-soft); flex-basis: 100%;" class="grouped-grid-panel-header-separator"></div>
                <div class="flex-grow-1 grouped-grid-panel-header-fill" style="min-width: 1px;"></div>

                <div class="panel-header-actions">
                    <QuickFilter v-model="internalQuickFilterValue"
                                 quickFilterButtonClass="btn-panel-action" />

                    <button v-if="props.onPanelSettingsClick"
                            type="button"
                            class="btn btn-panel-action"
                            :class="{ active: panelSettingsActive }"
                            title="Settings"
                            @click.prevent.stop="props.onPanelSettingsClick">
                        <i class="ti ti-adjustments-horizontal"></i>
                    </button>
                    <button v-if="props.onAddItem"
                            type="button"
                            class="btn btn-add btn-panel-action"
                            title="Add a new item. (Alt+N)"
                            data-shortcut-key="n"
                            @click.prevent.stop="props.onAddItem">
                        <i class="ti ti-square-plus"></i>
                    </button>

                    <button v-if="hasFullscreen"
                            type="button"
                            class="btn btn-panel-action panel-action-fullscreen"
                            :class="{ active: isFullscreen }"
                            title="Toggle Fullscreen"
                            @click.prevent.stop="onFullscreenClick">
                        <i v-if="isFullscreen" class="ti ti-minimize"></i>
                        <i v-else class="ti ti-maximize"></i>
                    </button>

                    <div v-if="hasHeaderSecondaryActions"
                         class="panel-secondary-actions dropdown">
                        <button type="button"
                                class="btn btn-panel-action panel-action-context"
                                data-toggle="dropdown">
                            <i class="ti ti-dots-vertical ti-fw"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li v-for="action in headerSecondaryActions"
                                :key="action.title ?? ''"
                                :class="getHeaderSecondaryActionItemClass(action)">
                                <a href="#" @click.prevent="onActionClick(action, $event)">
                                    <i :class="getHeaderSecondaryActionIconClass(action)"></i>
                                    {{ action.title }}
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </template>
        <template #preBody>
            <ActionToolbar v-model:groupingKey="groupingKey"
                           :groupingFields="groupingFields"
                           :isSelectedView="isSelectedView">
                <template #selectedActionToolbar>
                    <slot name="selectedActionToolbar" />
                </template>
            </ActionToolbar>
        </template>
        <ContentSectionContainer v-if="rows.length > 0" ref="sectionContainer" :sidebar="false">
            <template v-for="(group, index) in filteredGroups" :key="`${groupingKey}-${group.key}`">
                <ContentSection :isCollapsed="getInitialIsCollapsed(group.key, index)"
                                :unmountOnCollapse="true"
                                @onSectionTransition="(isCollapsed) => onGroupTransition(`${groupingKey}-${group.key}`, isCollapsed)"
                                @onSectionHeaderClick="onSectionHeaderClick">
                    <template #title>
                        <div class="d-flex align-items-center" :class="group.textColorCssClass">
                            <template v-if="group.type === 'person'">
                                <PersonAvatar :photoUrl="group.photoUrl ?? ''"
                                              :photoSize="24" />
                            </template>
                            <template v-else>
                                <i v-if="group.iconCssClass" :class="group.iconCssClass" class="mr-3"></i>
                            </template>
                            <span>{{ group.label }}</span>
                        </div>
                    </template>
                    <template #headerActions>
                        <div class="section-header-actions">
                            <slot name="headerActions" v-bind="{ groupRows: group.gridData.rows }" />
                            <HighlightLabel>
                                {{ getCountMessage(group.key, group.gridData.rows) }}
                            </HighlightLabel>
                        </div>
                    </template>
                    <ContentStack>
                        <slot name="grid"
                              v-bind="{ group, setGridRef }" />
                    </ContentStack>
                </ContentSection>
            </template>
        </ContentSectionContainer>
        <template v-else>
            <slot name="emptyView" />
        </template>
    </Panel>
</template>

<style scoped>
:deep(.contentsection-list) {
    gap: var(--spacing-medium);
}

/*
    Allow the header to wrap so the full-width break separator can force the
    actions onto their own line below the title and count on narrow (< 600px)
    screens, mirroring the standard Obsidian grid header. At 600px and up the
    separator and fill are hidden (see the media query below) and everything stays
    on one line, with the title's flex-grow pushing the count and actions right.
*/
.grouped-grid-panel-header {
    flex-wrap: wrap;
}

/*
    Hide the header break separator and fill at 600px and up so the title, count and
    actions sit on one line. Below 600px they are visible and force the actions onto
    their own row. Uses a custom 600px cutoff (matching the action toolbar) rather
    than the d-md-none utility's 768px.
*/
@media (min-width: 600px) {
    .grouped-grid-panel-header-separator,
    .grouped-grid-panel-header-fill {
        display: none;
    }
}

/* Match the grid's badge row: vertically centered and tall enough to give the
   title row a consistent height when the actions wrap beneath it. The count
   must not shrink so that a long title truncates before the count does. */
.grouped-grid-panel-badges {
    display: flex;
    align-items: center;
    height: 56px;
    flex-shrink: 0;
}

/*
    Truncate the title with an ellipsis instead of letting it grow the header.
    flex-basis: 0 makes the title claim only the space left over after the count
    and actions, so a long title ellipsizes within that space rather than pushing
    the count label (or actions) onto a new line. min-width: 0 is required for a
    flex item to shrink below its content width.
*/
.grouped-grid-panel-title {
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/*
    Let the actions wrap when they no longer fit on one line - most notably when
    the quick filter search box expands - the same way the grid's flat header
    actions wrap.

    height: auto overrides the panel-flex rule that sets the actions to
    height: 100%. Outside of fullscreen the panel has no definite height, so that
    100% already collapses to auto; but in fullscreen the panel height is definite
    and, once the header wraps to multiple rows, the 100% resolves to the full
    (multi-row) header height. That stretches the actions container over the whole
    header and floats the buttons in its vertical center. Sizing to content keeps
    the actions on their own row. The selector is qualified with .panel.panel-flex
    so it outweighs the equally-structured global rule it is overriding.
*/
.panel.panel-flex > .panel-header.grouped-grid-panel-header .panel-header-actions {
    flex-wrap: wrap;
    height: auto;
}

.section-header-actions {
    flex-wrap: wrap;
}
</style>

<script setup lang="ts">
    import { computed, ref, watch, PropType, ComponentPublicInstance, Ref } from "vue";
    import { GroupingFieldBag } from "@Obsidian/ViewModels/Core/Grid/groupingFieldBag";
    import { Enumerable } from "@Obsidian/Utility/linq";
    import { pluralize } from "@Obsidian/Utility/stringUtils";
    import { asFormattedString } from "@Obsidian/Utility/numberUtils";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import { IContentSectionHolder } from "@Obsidian/Core/Controls/contentSection";
    import ActionToolbar from "./actionToolbar.obs";
    import PersonAvatar from "../personAvatar.obs";
    import ContentSectionContainer from "../contentSectionContainer.obs";
    import ContentSection from "../contentSection.obs";
    import ContentStack from "../contentStack.obs";
    import HighlightLabel from "../highlightLabel.obs";
    import Panel from "../panel.obs";
    import QuickFilter from "@Obsidian/Controls/Internal/quickFilter.obs";
    import { PanelAction } from "@Obsidian/Types/Controls/panelAction";

    const props = defineProps({
        groupingKey: {
            type: String,
            default: ""
        },
        groupingFields: {
            type: Array as PropType<ListItemBag[]>,
            default: []
        },
        isAutoCollapseEnabled: {
            type: Boolean as PropType<boolean>,
            default: false
        },
        itemTerm: {
            type: String,
            default: "Item"
        },
        isSelectedView: {
            type: Boolean as PropType<boolean>,
            default: false
        },
        rows: {
            type: Object as PropType<Record<string, unknown>[]>,
            required: true
        },
        filteredAndSortedRows: {
            type: Object as PropType<Record<string, unknown>[]>,
            required: true
        },
        panelSettingsActive: {
            type: Boolean as PropType<boolean>,
            default: false
        },
        /**
         * The current text being used for the quick filter search box.
         * The quick filter will only be shown if this value is not undefined.
         */
        quickFilterValue: {
            type: String as PropType<string | undefined>,
            default: undefined
        },
        /**
         * The function to call in response to the add button being clicked.
         * Providing this function will automatically enable the add button.
         */
        onAddItem: {
            type: Function as PropType<(() => void | Promise<void>)>,
            required: false
        },
        /**
         * The function to call in response to the add button being clicked.
         * Providing this function will automatically enable the add button.
         */
        onPanelSettingsClick: {
            type: Function as PropType<(() => void | Promise<void>)>,
            required: false
        },
        /** The title text to display in the panel header. */
        title: {
            type: String as PropType<string>,
            default: ""
        },
        /** The icon CSS class to display next to the title. */
        titleIconCssClass: {
            type: String as PropType<string>,
            default: ""
        },
        /** True if the panel should show a button to toggle fullscreen mode. */
        hasFullscreen: {
            type: Boolean as PropType<boolean>,
            default: false
        },
        /** The list of secondary actions to include in the header's ellipsis menu. */
        headerSecondaryActions: {
            type: Array as PropType<PanelAction[]>,
            required: false
        }
    });

    const emit = defineEmits<{
        (e: "update:quickFilterValue", value: string): void;
        (e: "update:groupingKey", value: string): void;
        (e: "update:orderedRequestKeys", value: string[]): void;
    }>();

    type GroupedGrid = {
        gridData: {
            rows: Record<string, unknown>[];
        };
        iconCssClass?: string | null;
        key?: string | null;
        label?: string | null;
        order?: number | null;
        photoUrl?: string | null;
        textColorCssClass?: string | null;
        type?: string | null;
    };

    const internalQuickFilterValue = useVModelPassthrough(props, "quickFilterValue", emit);
    const groupingKey = useVModelPassthrough(props, "groupingKey", emit);

    /** Tracks fullscreen state, kept in sync with the underlying Panel via v-model. */
    const isFullscreen = ref(false);

    /** True if there are any secondary actions to show in the header's ellipsis menu. */
    const hasHeaderSecondaryActions = computed((): boolean => !!props.headerSecondaryActions && props.headerSecondaryActions.length > 0);

    /** Toggles the panel's fullscreen mode. */
    function onFullscreenClick(): void {
        isFullscreen.value = !isFullscreen.value;
    }

    /**
     * Builds the icon CSS class for a secondary action, appending a text color
     * class for non-default action types so, for example, a "danger" action is
     * tinted red.
     */
    function getHeaderSecondaryActionIconClass(action: PanelAction): string {
        if (!action.iconCssClass) {
            return "";
        }

        let iconClass = action.iconCssClass;

        if (action.type !== "default" && action.type !== "link") {
            iconClass += ` text-${action.type}`;
        }

        return iconClass;
    }

    /** Returns the list item class for a secondary action, disabling it when needed. */
    function getHeaderSecondaryActionItemClass(action: PanelAction): string {
        return action.disabled ? "disabled" : "";
    }

    /** Invokes a secondary action's handler unless the action is disabled. */
    function onActionClick(action: PanelAction, event: Event): void {
        if (action.disabled) {
            return;
        }

        if (action.handler) {
            action.handler(event);
        }
    }
    const sectionContainer = ref<{
        getSections: () => IContentSectionHolder[];
        getRootElRef: () => Ref<HTMLElement | null>;
    } | null>(null);

    let collapsedGroupDictionary: Record<string, boolean> = {};

    type ClearableGridInstance = ComponentPublicInstance<{ clearSelectedKeys: () => void }>;

    const registeredGrids = new Set<ClearableGridInstance>();

    function setGridRef(el: Element | ComponentPublicInstance | null): void {
        if (el && typeof el === "object" && "clearSelectedKeys" in el) {
            registeredGrids.add(el as ClearableGridInstance);
        }
    }

    function clearSelectedKeys(): void {
        registeredGrids.forEach(grid => {
            grid.clearSelectedKeys();
        });
    }

    defineExpose({
        clearSelectedKeys,
        expandAll,
        collapseAll
    });



    const totalGroupCounts = computed(() => {
        const map = new Map<string, number>();

        if (!groupingKey.value) {
            map.set("all", props.rows.length);
            return map;
        }

        for (const row of props.rows) {
            const field = row[groupingKey.value] as GroupingFieldBag;
            const key = field?.key ?? "";

            map.set(key, (map.get(key) ?? 0) + 1);
        }

        return map;
    });


    const filteredGroups = computed((): GroupedGrid[] => {
        if (!groupingKey.value) {
            return [{
                key: "all",
                label: "All",
                gridData: { rows: props.filteredAndSortedRows }
            }];
        }

        const groupedGrids = Enumerable
            .from(props.filteredAndSortedRows)
            .groupBy(r => {
                const field = r[groupingKey.value] as GroupingFieldBag;
                return field?.key ?? "";
            })
            .select(g => {
                const rows = g.toArray();
                const groupingField = rows[0][groupingKey.value] as GroupingFieldBag;

                return {
                    ...groupingField,
                    gridData: { rows }
                };
            })
            .orderBy(g => g.key === "unassigned" ? 0 : 1)
            .thenOrderBy(g => g.order)
            .thenOrderBy(g => g.label)
            .toArray();

        return groupedGrids;
    });

    const orderedRequestKeysAfterGrouping = computed(() =>
        filteredGroups.value
            .flatMap(g => g.gridData.rows)
            .map(r => (r.idKey ?? "") as string)
    );

    const countMessage = computed(() => {
        const totalCount = props.rows?.length ?? 0;
        const filteredCount = props.filteredAndSortedRows.length;

        if (filteredCount === totalCount) {
            return `${asFormattedString(totalCount)} Total ${pluralize("Request", totalCount)}`;
        }
        else {
            return `${asFormattedString(filteredCount)} of ${asFormattedString(totalCount)} Total ${pluralize("Request", totalCount)}`;
        }
    });

    function expandAll(): void {
        sectionContainer.value
            ?.getSections()
            .forEach(s => {
                s.isCollapsed.value = false;
            });
    }

    function collapseAll(section: IContentSectionHolder): void {
        sectionContainer.value
            ?.getSections()
            .forEach(s => {
                if (s !== section) {
                    s.isCollapsed.value = true;
                }
            });
    }


    function getCountMessage(key: string | null | undefined, filteredAndSortedRows: Record<string, unknown>[]): string {
        if (!key) {
            return "";
        }

        const totalGroupCount = totalGroupCounts.value.get(key) ?? 0;

        if (filteredAndSortedRows.length === totalGroupCount) {
            return `${asFormattedString(filteredAndSortedRows.length)} ${pluralize(props.itemTerm, filteredAndSortedRows.length)}`;
        }
        else {
            return `${asFormattedString(filteredAndSortedRows.length)} of ${asFormattedString(totalGroupCount)} ${pluralize(props.itemTerm, totalGroupCount)}`;
        }
    }

    function onGroupTransition(key: string, isCollapsed: boolean): void {
        // When a section opens and auto-collapse is enabled, collapse all other sections.
        if (props.isAutoCollapseEnabled && !isCollapsed) {
            collapsedGroupDictionary = {};
        }

        collapsedGroupDictionary[key] = isCollapsed;
    }

    function onSectionHeaderClick(section: IContentSectionHolder): void {
        if (props.isAutoCollapseEnabled) {
            collapseAll(section);
        }
    }

    function getInitialIsCollapsed(groupKey: string | null | undefined, index: number): boolean {
        const key = `${groupingKey.value}-${groupKey ?? ""}`;

        // If we've already seen a transition for this section, honor it.
        if (key in collapsedGroupDictionary) {
            return collapsedGroupDictionary[key];
        }

        // Default behavior on first mount:
        // Expand first group unless it's "unassigned", then expand the second group.
        const firstExpandedIndex = filteredGroups.value[0]?.key === "unassigned" ? 1 : 0;

        // If auto-collapse is enabled and another section is already open, start this
        // new section collapsed to maintain the single-open invariant. This handles
        // sections remounting after a filter is cleared.
        if (props.isAutoCollapseEnabled && Object.values(collapsedGroupDictionary).some(v => !v)) {
            return true;
        }

        const result = index !== firstExpandedIndex;
        return result; // true means collapsed
    }

    watch(groupingKey, () => {
        collapsedGroupDictionary = {};
    });

    watch(orderedRequestKeysAfterGrouping, (keys) => {
        emit("update:orderedRequestKeys", keys);
    }, { immediate: true });
</script>
