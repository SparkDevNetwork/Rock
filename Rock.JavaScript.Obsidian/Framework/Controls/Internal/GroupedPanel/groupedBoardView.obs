<template>
    <div ref="boardViewRef" class="grouped-board-view">
        <div v-for="group in groups"
             :key="group.key ?? ''"
             class="board-column shadow-md">
            <div class="board-column-header d-flex align-items-center gap-sm">
                <template v-if="group.type === 'person'">
                    <PersonAvatar :photoUrl="group.photoUrl ?? ''"
                                  :photoSize="24"
                                  marginRight="0" />
                </template>
                <template v-else>
                    <i v-if="group.iconCssClass"
                       :class="[group.iconCssClass, group.textColorCssClass]"
                       :style="group.iconStyle"></i>
                </template>
                <span class="font-weight-semibold text-truncate" :class="group.textColorCssClass" v-tooltip.overflow="group.label">{{ group.label }}</span>
                <span class="ml-auto text-interface-medium">{{ group.gridData.rows.length }}</span>
            </div>
            <div class="board-column-body"
                 v-drag-source="dragSourceOptions"
                 v-drag-target="dragSourceOptions.id"
                 :data-group-key="group.key ?? ''">
                <div v-for="row in group.gridData.rows"
                     :key="(row.idKey as string)"
                     :data-id-key="(row.idKey as string)"
                     class="board-card-wrapper">
                    <slot name="boardCard" v-bind="{ row }" />
                </div>
                <div v-if="group.gridData.rows.length === 0" class="board-column-empty">
                    <slot name="emptyColumn" />
                </div>
            </div>
        </div>
    </div>
</template>

<style scoped>
.grouped-board-view {
    display: flex;
    gap: var(--spacing-large);
    overflow-x: auto;
    height: 100%;
    padding-bottom: var(--spacing-xsmall);
}

.board-column {
    padding: var(--spacing-medium) 0;
    background-color: var(--color-interface-softer);
    border-radius: var(--rounded-large);
    flex: 0 0 348px;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-medium);
    width: 380px;
    max-width: none;
    /* Allow the column to shrink so the column body scrolls rather than the page. */
    /* min-height: 0; */
    /* overflow-y: auto; */
}

.board-column-header {
    padding: var(--spacing-xsmall) 0;
    margin: 0 var(--spacing-medium);
    display: flex;
    align-items: center;
    gap: var(--spacing-xsmall);
    border-bottom: 2px solid var(--color-interface-soft);
}

.board-column-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-small);
    /* Fill remaining column height and scroll cards independently. */
    flex: 1;
    min-height: 0;

    /* overflow must be set in the base state for scrollbar-gutter to reserve space. */
    overflow-y: auto;
    scrollbar-gutter: stable;
    padding: 0 var(--spacing-xsmall) 0 var(--spacing-medium);
}

/* Set the srollbar to transparent when there is no hover event. */
.board-column-body::-webkit-scrollbar {
    background-color: transparent;
}

.board-column-body::-webkit-scrollbar-thumb {
    background-color: transparent;
}

.board-column-body:hover::-webkit-scrollbar {
    background-color: var(--color-interface-softer);
}

.board-column-body:hover::-webkit-scrollbar-thumb {
    background-color: var(--color-interface-soft);
}

.board-column-body:hover::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-interface-medium);
}

.board-column.drag-over {
    outline: solid 2px var(--color-primary);
    outline-offset: -2px;
    background-color: color-mix(in srgb, var(--color-primary) 5%, transparent);
}

.board-column.drag-over .board-column-empty {
    display: none;
}

.board-column.drag-disabled {
    opacity: 0.5;
    transition: opacity 0.15s ease;
}
</style>

<style>
/* Dragula mirror and transit styles — must not be scoped. */
.gu-mirror {
    cursor: grabbing;
    box-shadow: 0 0 0 1px var(--color-primary);
    border-radius: var(--rounded-small);
    transform: rotate(-5deg);
}

.gu-transit {
    opacity: 0.3;
}

body.is-dragging,
body.is-dragging * {
    cursor: grabbing !important;
}
</style>

<script setup lang="ts">
    import { computed, PropType, ref } from "vue";
    import { DragSource as vDragSource, DragTarget as vDragTarget, IDragSourceOptions } from "@Obsidian/Directives/dragDrop";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { GroupedGrid } from "./types.partial";
    import { vTooltip } from "@Obsidian/Directives/tooltip";
    import PersonAvatar from "@Obsidian/Controls/personAvatar.obs";

    const props = defineProps({
        /** The pre-computed groups to render as board columns. */
        groups: {
            type: Array as PropType<GroupedGrid[]>,
            required: true
        },

        /**
         * Optional callback that determines whether a card from
         * sourceGroupKey can be dropped onto targetGroupKey. When
         * undefined all columns accept drops (default behavior).
         */
        canDropOnGroup: {
            type: Function as PropType<((sourceGroupKey: string, targetGroupKey: string) => boolean) | undefined>,
            required: false,
            default: undefined
        }
    });

    const emit = defineEmits<{
        (e: "cardMoved", idKey: string, fromGroupKey: string, toGroupKey: string, beforeIdKey: string | null): void;
    }>();

    const boardViewRef = ref<HTMLElement | null>(null);

    // #region Drag and Drop

    const dragId = newGuid();

    /** Shared drag source options for all board columns. A single id links
     *  every column as both a source and a target so cards can move freely. */
    const dragSourceOptions = computed<IDragSourceOptions>(() => ({
        id: dragId,
        copyElement: false,

        startDrag(operation) {
            // Prevent the empty-column placeholder from being dragged.
            return !(operation.element as HTMLElement).classList.contains("board-column-empty");
        },

        acceptDrop(operation) {
            if (!props.canDropOnGroup) {
                return true;
            }

            const sourceKey = (operation.sourceContainer as HTMLElement)?.dataset.groupKey;
            const targetKey = (operation.targetContainer as HTMLElement)?.dataset.groupKey;

            if (!sourceKey || !targetKey) {
                return false;
            }

            return props.canDropOnGroup(sourceKey, targetKey);
        },

        dragBegin(operation) {
            document.body.classList.add("is-dragging");

            // When a drop constraint callback is provided, mark columns
            // that cannot accept the dragged card so they appear disabled.
            if (props.canDropOnGroup) {
                const sourceKey = (operation.sourceContainer as HTMLElement)?.dataset.groupKey ?? "";

                boardViewRef.value?.querySelectorAll<HTMLElement>(".board-column-body").forEach(body => {
                    const targetKey = body.dataset.groupKey ?? "";

                    if (targetKey !== sourceKey && !props.canDropOnGroup!(sourceKey, targetKey)) {
                        body.closest(".board-column")?.classList.add("drag-disabled");
                    }
                });
            }
        },

        dragOver(operation) {
            operation.targetContainer?.closest(".board-column")?.classList.add("drag-over");
        },

        dragOut(operation) {
            operation.targetContainer?.closest(".board-column")?.classList.remove("drag-over");
        },

        dragEnd() {
            document.body.classList.remove("is-dragging");

            // Safety cleanup of all highlights.
            document.querySelectorAll(".board-column.drag-over")
                .forEach(el => el.classList.remove("drag-over"));
            document.querySelectorAll(".board-column.drag-disabled")
                .forEach(el => el.classList.remove("drag-disabled"));
        },

        dragDrop(operation) {
            const element = operation.element as HTMLElement;
            const sourceContainer = operation.sourceContainer as HTMLElement;
            const targetContainer = operation.targetContainer as HTMLElement | undefined;

            const idKey = element.dataset.idKey;
            const fromGroupKey = sourceContainer.dataset.groupKey;
            const toGroupKey = targetContainer?.dataset.groupKey;

            // Get the idKey of the card this was dropped before (null = end of column).
            const targetSibling = operation.targetSibling as HTMLElement | undefined;
            const beforeIdKey = targetSibling?.dataset?.idKey ?? null;

            if (!idKey || !fromGroupKey || !toGroupKey) {
                return;
            }

            // Revert Dragula's DOM mutation — let Vue re-render from data.
            operation.element.remove();
            operation.sourceContainer.insertBefore(
                operation.element,
                operation.sourceSibling ?? null
            );

            emit("cardMoved", idKey, fromGroupKey, toGroupKey, beforeIdKey);
        }
    }));

    // #endregion
</script>
