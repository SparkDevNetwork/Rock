<template>
    <div class="grouped-board-view">
        <div v-for="group in groups"
             :key="group.key ?? ''"
             class="board-column shadow-md">
            <div class="board-column-header d-flex align-items-center gap-sm">
                <template v-if="group.type === 'person'">
                    <PersonAvatar :photoUrl="group.photoUrl ?? ''"
                                  :photoSize="24"
                                  marginRight="0" />
                </template>
                <template v-else>
                    <i v-if="group.iconCssClass"
                       :class="[group.iconCssClass, group.textColorCssClass]"
                       :style="group.iconStyle"></i>
                </template>
                <span class="font-weight-semibold" :class="group.textColorCssClass">{{ group.label }}</span>
                <span class="ml-auto text-interface-medium">{{ group.gridData.rows.length }}</span>
            </div>
            <div class="board-column-body"
                 v-drag-source="dragSourceOptions"
                 v-drag-target="dragSourceOptions.id"
                 :data-group-key="group.key ?? ''">
                <div v-for="row in group.gridData.rows"
                     :key="(row.idKey as string)"
                     :data-id-key="(row.idKey as string)"
                     class="board-card-wrapper">
                    <slot name="boardCard" v-bind="{ row }" />
                </div>
            </div>
        </div>
    </div>
</template>

<style scoped>
.grouped-board-view {
    display: flex;
    gap: var(--spacing-large);
    overflow-x: auto;
    height: 100%;
    padding-bottom: var(--spacing-xsmall);
}

.board-column {
    padding: var(--spacing-medium);
    background-color: var(--color-interface-softer);
    border-radius: var(--rounded-large);
    flex: 0 0 332px;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-medium);
    width: 364px;
    max-width: none;
    /* Allow the column to shrink so the column body scrolls rather than the page. */
    min-height: 0;
}

.board-column-header {
    padding: var(--spacing-xsmall) var(--spacing-small);
    display: flex;
    align-items: center;
    gap: var(--spacing-xsmall);
    /* border-bottom: 2px solid var(--color-interface-soft); */
}

.board-column-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-small);
    /* Fill remaining column height and scroll cards independently. */
    flex: 1;
    min-height: 0;
    overflow-y: auto;
}

.board-column.drag-over {
    outline: solid 2px var(--color-primary);
    outline-offset: -2px;
    background-color: color-mix(in srgb, var(--color-primary) 5%, transparent);
}
</style>

<style>
/* Dragula mirror and transit styles — must not be scoped. */
.gu-mirror {
    cursor: grabbing;
    box-shadow: 0 0 0 1px var(--color-primary);
    border-radius: var(--rounded-small);
    transform: rotate(-5deg);
}

.gu-transit {
    opacity: 0.3;
}

body.is-dragging,
body.is-dragging * {
    cursor: grabbing !important;
}
</style>

<script setup lang="ts">
    import { PropType } from "vue";
    import { DragSource as vDragSource, DragTarget as vDragTarget, IDragSourceOptions } from "@Obsidian/Directives/dragDrop";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { GroupedGrid } from "./types.partial";
    import PersonAvatar from "@Obsidian/Controls/personAvatar.obs";

    defineProps({
        /** The pre-computed groups to render as board columns. */
        groups: {
            type: Array as PropType<GroupedGrid[]>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "cardMoved", idKey: string, fromGroupKey: string, toGroupKey: string): void;
    }>();

    // #region Drag and Drop

    const dragId = newGuid();

    /** Shared drag source options for all board columns. A single id links
     *  every column as both a source and a target so cards can move freely. */
    const dragSourceOptions: IDragSourceOptions = {
        id: dragId,
        copyElement: false,

        dragBegin() {
            document.body.classList.add("is-dragging");
        },

        dragOver(operation) {
            operation.targetContainer?.closest(".board-column")?.classList.add("drag-over");
        },

        dragOut(operation) {
            operation.targetContainer?.closest(".board-column")?.classList.remove("drag-over");
        },

        dragEnd() {
            document.body.classList.remove("is-dragging");

            // Safety cleanup of all highlights.
            document.querySelectorAll(".board-column.drag-over")
                .forEach(el => el.classList.remove("drag-over"));
        },

        dragDrop(operation) {
            const element = operation.element as HTMLElement;
            const sourceContainer = operation.sourceContainer as HTMLElement;
            const targetContainer = operation.targetContainer as HTMLElement | undefined;

            const idKey = element.dataset.idKey;
            const fromGroupKey = sourceContainer.dataset.groupKey;
            const toGroupKey = targetContainer?.dataset.groupKey;

            if (!idKey || !fromGroupKey || !toGroupKey || fromGroupKey === toGroupKey) {
                return;
            }

            // Revert Dragula's DOM mutation — let Vue re-render from data.
            operation.element.remove();
            operation.sourceContainer.insertBefore(
                operation.element,
                operation.sourceSibling ?? null
            );

            emit("cardMoved", idKey, fromGroupKey, toGroupKey);
        }
    };

    // #endregion
</script>
