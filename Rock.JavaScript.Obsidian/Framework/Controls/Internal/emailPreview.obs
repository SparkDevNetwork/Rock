<template>
    <div v-if="message" class="email-body">
        <iframe ref="iframeElement" :srcdoc="message" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"></iframe>
    </div>
</template>

<style scoped>
.email-body {
    display: flex;
    background: var(--color-interface-softest);
}

html[theme="dark"] .email-body {
    background: var(--color-interface-strongest);
}

.email-body iframe {
    width: 100%;
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, PropType, ref, watch } from "vue";

    const defaultMinimumPixelHeight = 450;

    const props = defineProps({
        message: {
            type: String as PropType<string>,
            required: true
        },

        minimumPixelHeight: {
            type: Number as PropType<number>,
            default: 450
        }
    });

    // #region Values

    /*
        10/16/2026 - MSE

        The iframe in the template shows stored message HTML, so it is sandboxed with
        "allow-same-origin allow-popups allow-popups-to-escape-sandbox". allow-same-origin is only
        there so the parent can measure the content height (updateHeight and the ResizeObserver).
        Never add allow-scripts: a same-origin frame that may run script can remove its own sandbox.

        Reason: Stop stored XSS through the communication email preview.
    */
    const iframeElement = ref<HTMLIFrameElement | undefined>();

    let loadHandler: (() => void) | null = null;
    let resizeObserver: ResizeObserver | null = null;

    // #endregion Values

    const minimumPixelHeight = computed((): number => {
        return props.minimumPixelHeight > 0
            ? props.minimumPixelHeight
            : defaultMinimumPixelHeight;
    });

    // #region Functions

    /*
        10/29/2026 - MSE

        The height is measured from the iframe body and the iframe is then resized to that height.
        When the message sets "html, body { height: 100% }" the body is always exactly as tall as
        the iframe, so any visible content outside a full-height wrapper makes body.scrollHeight
        larger than the iframe. Growing the iframe grows the body, the ResizeObserver fires again,
        and the preview grows forever. This style is added to the preview document only (never to
        the message string, so it is not saved or sent) to let the body size to its content so the
        measurement settles. The iframe minimum height still fills the preview area.

        Reason: Stop the Communication Detail email preview from growing without end (#7138).
    */
    function injectAutoHeightStyle(doc: Document): void {
        const styleId = "rock-email-preview-auto-height";

        if (doc.getElementById(styleId)) {
            return;
        }

        const style = doc.createElement("style");
        style.id = styleId;
        style.textContent = "html, body { height: auto !important; min-height: 0 !important; }";

        // Appended to the end of the document (after the body) so it comes after any email
        // styles, including style blocks inside the body, and wins at equal specificity.
        doc.documentElement.appendChild(style);
    }

    // #endregion Functions

    // #region Watchers

    watch(iframeElement, (newIframe, oldIFrame) => {
        resizeObserver?.disconnect();
        resizeObserver = null;

        if (oldIFrame && loadHandler) {
            oldIFrame.removeEventListener("load", loadHandler);
        }

        if (!newIframe) {
            return;
        }

        const updateHeight = (): void => {
            nextTick(() => {
                const contentHeight = newIframe.contentWindow
                    ?.document.body.scrollHeight
                    ?? minimumPixelHeight.value;

                newIframe.style.height = `${contentHeight}px`;
                newIframe.style.minHeight = `${minimumPixelHeight.value}px`;
            });
        };

        if (window.ResizeObserver) {
            resizeObserver = new ResizeObserver(() => {
                updateHeight();
            });
        }

        loadHandler = () => {
            const doc = newIframe.contentDocument || newIframe.contentWindow?.document;

            // Must run before the first measurement so height is never based on a body that
            // is stretched to the iframe.
            if (doc) {
                injectAutoHeightStyle(doc);
            }

            updateHeight();

            // Fallback: ensure height settles even if late layout changes occur.
            setTimeout(() => updateHeight(), 100);

            if (doc?.body && resizeObserver) {
                // The message changed (new srcdoc) so stop watching the previous body.
                resizeObserver.disconnect();
                resizeObserver.observe(doc.body);
            }
        };

        newIframe.addEventListener("load", loadHandler);
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onBeforeUnmount(() => {
        resizeObserver?.disconnect();
    });

    // #endregion Lifecycle Hooks
</script>
