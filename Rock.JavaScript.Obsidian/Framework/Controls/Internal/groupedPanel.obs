<template>
    <Panel :hasTitle="false"
           v-model:isFullscreen="isFullscreen"
           :type="isBoardView ? 'block' : 'default'"
           :panelBodyCssClass="panelBodyCssClasses"
           :worksurfaceMode="isBoardView">
        <template #panelHeader>
            <div class="panel-header grouped-grid-panel-header flex-shrink-0">
                <h1 class="panel-title grouped-grid-panel-title">
                    <i v-if="titleIconCssClass" :class="titleIconCssClass"></i>
                    <span class="grouped-grid-panel-title-text">{{ title }}</span>
                </h1>

                <div v-if="groupingFields.length > 1"
                     class="d-flex align-items-center gap-xs mr-3">
                    <ButtonDropDownList v-if="groupingFields.length > 1"
                                        v-model="groupingKey"
                                        :items="groupingFields"
                                        :btnSize="BtnSize.ExtraSmall">
                        <template #selectionPrepend>
                            <i class="ti ti-list-details mr-spacing-tiny"></i>
                            <span class="group-label">Group By:</span>
                        </template>
                    </ButtonDropDownList>
                </div>

                <div class="grouped-grid-panel-badges mr-3">
                    <HighlightLabel>
                        {{ countMessage }}
                    </HighlightLabel>
                </div>

                <!-- Forces the header actions onto their own row below the title and count at widths under 610px. Hidden at 610px and up by the scoped media query below. -->
                <div style="height: 0; border-bottom: 1px solid var(--color-interface-soft); flex-basis: 100%;" class="grouped-grid-panel-header-separator"></div>
                <div class="flex-grow-1 grouped-grid-panel-header-fill" style="min-width: 1px;"></div>

                <div class="panel-header-actions">
                    <QuickFilter v-model="internalQuickFilterValue"
                                 quickFilterButtonClass="btn-panel-action" />

                    <button v-if="props.onPanelSettingsClick"
                            type="button"
                            class="btn btn-panel-action"
                            :class="{ active: panelSettingsActive }"
                            title="Settings"
                            @click.prevent.stop="props.onPanelSettingsClick">
                        <i class="ti ti-adjustments-horizontal"></i>
                    </button>
                    <button v-if="props.onSnapshotClick"
                            type="button"
                            class="btn btn-panel-action"
                            :class="{ active: isSnapshotVisible }"
                            title="Toggle Snapshot"
                            @click.prevent.stop="props.onSnapshotClick">
                        <i class="ti ti-chart-bar-popular"></i>
                    </button>
                    <button v-if="props.onAddItem"
                            type="button"
                            class="btn btn-add btn-panel-action"
                            title="Add a new item. (Alt+N)"
                            data-shortcut-key="n"
                            @click.prevent.stop="props.onAddItem">
                        <i class="ti ti-square-plus"></i>
                    </button>

                    <button v-if="hasFullscreen"
                            type="button"
                            class="btn btn-panel-action panel-action-fullscreen"
                            :class="{ active: isFullscreen }"
                            title="Toggle Fullscreen"
                            @click.prevent.stop="onFullscreenClick">
                        <i v-if="isFullscreen" class="ti ti-minimize"></i>
                        <i v-else class="ti ti-maximize"></i>
                    </button>

                    <div v-if="hasHeaderSecondaryActions"
                         class="panel-secondary-actions dropdown">
                        <button type="button"
                                class="btn btn-panel-action panel-action-context"
                                data-toggle="dropdown">
                            <i class="ti ti-dots-vertical ti-fw"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li v-for="action in headerSecondaryActions"
                                :key="action.title ?? ''"
                                :class="getHeaderSecondaryActionItemClass(action)">
                                <a href="#" @click.prevent="onActionClick(action, $event)">
                                    <i :class="getHeaderSecondaryActionIconClass(action)"></i>
                                    {{ action.title }}
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </template>
        <template #preBody>
            <div>
                <TransitionVerticalCollapse>
                    <div v-show="isSnapshotVisible">
                        <slot name="snapshot" />
                    </div>
                </TransitionVerticalCollapse>
                <transition name="action-toolbar-slide">
                    <div v-if="isSelectedView" class="action-toolbar-slide">
                        <div class="action-toolbar-slide-inner">
                            <ActionToolbar :isSelectedView="isSelectedView">
                                <template #selectedActionToolbar>
                                    <slot name="selectedActionToolbar" />
                                </template>
                            </ActionToolbar>
                        </div>
                    </div>
                </transition>
            </div>
        </template>
        <template v-if="rows.length > 0">
            <GroupedListView v-if="isListView"
                             ref="groupedListViewRef"
                             :groups="filteredGroups"
                             :totalGroupCounts="totalGroupCounts"
                             :groupingKey="groupingKey"
                             :isAutoCollapseEnabled="isAutoCollapseEnabled"
                             :itemTerm="itemTerm"
                             :isCountMessageVisible="isCountMessageVisible">
                <template #headerActions="slotProps">
                    <slot name="headerActions" v-bind="slotProps" />
                </template>
                <template #grid="slotProps">
                    <slot name="grid" v-bind="slotProps" />
                </template>
            </GroupedListView>
            <GroupedBoardView v-else-if="isBoardView"
                              :groups="filteredGroups"
                              :canDropOnGroup="canDropOnGroup"
                              :isGroupDrag="isGroupDrag"
                              :selectedCount="selectedCount"
                              @cardMoved="(idKey: string, from: string, to: string, beforeIdKey: string | null) => emit('cardMoved', idKey, from, to, beforeIdKey)">
                <template #boardCard="slotProps">
                    <slot name="boardCard" v-bind="slotProps" />
                </template>
                <template #emptyColumn>
                    <slot name="emptyColumn" />
                </template>
            </GroupedBoardView>
            <template v-if="isGridView">
                <slot name="gridView" />
            </template>
        </template>
        <template v-else>
            <slot name="emptyView" />
        </template>
    </Panel>
</template>

<style scoped>
:deep(.contentsection-list) {
    gap: var(--spacing-medium);
}

.gap-xs {
    gap: var(--spacing-xsmall);
}

/*
    Animates to content size via grid-template-rows 0fr <-> 1fr, driven by
    Vue's <Transition> enter/leave classes. Vue applies the enter-from class
    atomically with DOM insertion, so the toolbar never paints at natural
    height in the panel's fixed-height flex layout.

    This is needed because the groupedBoardView renders the panel with a fixed
    height, causing the standard TransitionVerticalCollapse pattern to not
    function correctly
*/
.action-toolbar-slide {
    display: grid;
    grid-template-rows: 1fr;
}

.action-toolbar-slide-inner {
    overflow: hidden;
    min-height: 0;
}

.action-toolbar-slide-enter-active,
.action-toolbar-slide-leave-active {
    transition: grid-template-rows 0.2s ease-in-out;
}

.action-toolbar-slide-enter-from,
.action-toolbar-slide-leave-to {
    grid-template-rows: 0fr;
}

/*
    Allow the header to wrap so the full-width break separator can force the
    actions onto their own line below the title and count on narrow (< 610px)
    screens, mirroring the standard Obsidian grid header. At 610px and up the
    separator and fill are hidden (see the media query below) and everything stays
    on one line, with the title's flex-grow pushing the count and actions right.
*/
.grouped-grid-panel-header {
    flex-wrap: wrap;
}

/*
    Free up space for the panel header when we reach smaller screen widths.
*/
@media (max-width: 610px) {
    .group-label {
        display: none;
    }

    /*
        Board view (type="block") pins the header to a fixed height of 56px. Once the
        header snaps below 610px and the actions wrap onto their own row, that fixed
        height clips the wrapped content, because the panel hides vertical overflow in
        worksurface mode. Let the header grow to fit while keeping 56px as the minimum
        so the single-row bar height is unchanged. Scoped to .panel-block so only board
        view is affected.
    */
    .panel-block > .grouped-grid-panel-header {
        height: auto;
        min-height: 56px;
    }
}

/*
    Hide the header break separator and fill at 610px and up so the title, count and
    actions sit on one line. Below 610px they are visible and force the actions onto
    their own row. Uses a custom 610px cutoff (matching the action toolbar) rather
    than the d-md-none utility's 768px.
*/
@media (min-width: 610px) {

    .grouped-grid-panel-header-separator,
    .grouped-grid-panel-header-fill {
        display: none;
    }
}

/* Match the grid's badge row: vertically centered and tall enough to give the
   title row a consistent height when the actions wrap beneath it. The count
   must not shrink so that a long title truncates before the count does. */
.grouped-grid-panel-badges {
    display: flex;
    align-items: center;
    height: 56px;
    flex-shrink: 0;
}

/*
    Truncate the title with an ellipsis instead of letting it grow the header.
    flex-basis: 0 makes the title claim only the space left over after the count
    and actions, so a long title ellipsizes within that space rather than pushing
    the count label (or actions) onto a new line. min-width: 0 is required for a
    flex item to shrink below its content width.
*/
.grouped-grid-panel-title {
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/*
    Let the actions wrap when they no longer fit on one line - most notably when
    the quick filter search box expands - the same way the grid's flat header
    actions wrap.

    height: auto overrides the panel-flex rule that sets the actions to
    height: 100%. Outside of fullscreen the panel has no definite height, so that
    100% already collapses to auto; but in fullscreen the panel height is definite
    and, once the header wraps to multiple rows, the 100% resolves to the full
    (multi-row) header height. That stretches the actions container over the whole
    header and floats the buttons in its vertical center. Sizing to content keeps
    the actions on their own row. The selector is qualified with .panel.panel-flex
    so it outweighs the equally-structured global rule it is overriding.
*/
.panel.panel-flex > .panel-header.grouped-grid-panel-header .panel-header-actions {
    flex-wrap: wrap;
    height: auto;
}
</style>

<script setup lang="ts">
    import { computed, ref, watch, PropType } from "vue";
    import { Enumerable } from "@Obsidian/Utility/linq";
    import { pluralize } from "@Obsidian/Utility/stringUtils";
    import { asFormattedString } from "@Obsidian/Utility/numberUtils";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import HighlightLabel from "../highlightLabel.obs";
    import Panel from "../panel.obs";
    import QuickFilter from "@Obsidian/Controls/Internal/quickFilter.obs";
    import ActionToolbar from "./GroupedPanel/actionToolbar.obs";
    import GroupedListView from "./GroupedPanel/groupedListView.obs";
    import GroupedBoardView from "./GroupedPanel/groupedBoardView.obs";
    import ButtonDropDownList from "../buttonDropDownList.obs";
    import { BtnSize } from "@Obsidian/Enums/Controls/btnSize";
    import { GroupedGrid } from "./GroupedPanel/types.partial";
    import TransitionVerticalCollapse from "../transitionVerticalCollapse.obs";
    import { PanelAction } from "@Obsidian/Types/Controls/panelAction";

    const props = defineProps({
        groupingKey: {
            type: String,
            default: ""
        },
        groupingFields: {
            type: Array as PropType<ListItemBag[]>,
            default: []
        },
        isAutoCollapseEnabled: {
            type: Boolean as PropType<boolean>,
            default: false
        },
        itemTerm: {
            type: String,
            default: "Item"
        },
        isSelectedView: {
            type: Boolean as PropType<boolean>,
            default: false
        },
        rows: {
            type: Object as PropType<Record<string, unknown>[]>,
            required: true
        },
        filteredAndSortedRows: {
            type: Object as PropType<Record<string, unknown>[]>,
            required: true
        },
        panelSettingsActive: {
            type: Boolean as PropType<boolean>,
            default: false
        },
        /**
         * The current text being used for the quick filter search box.
         * The quick filter will only be shown if this value is not undefined.
         */
        quickFilterValue: {
            type: String as PropType<string | undefined>,
            default: undefined
        },
        /**
         * The current view-mode value used by the toggle button group. Should
         * match the `value` of the active item in `viewModeItems`.
         */
        viewMode: {
            type: String as PropType<string>,
            required: true
        },
        /**
         * The function to call in response to the settings button being clicked.
         * Providing this function will automatically enable the settings button.
         */
        onPanelSettingsClick: {
            type: Function as PropType<(() => void | Promise<void>)>,
            required: false
        },
        /**
         * The function to call in response to the add button being clicked.
         * Providing this function will automatically enable the add button.
         */
        onAddItem: {
            type: Function as PropType<(() => void | Promise<void>)>,
            required: false
        },
        /**
         * A dictionary of all available groups for each grouping dimension, keyed
         * by grouping field name. When provided, the board view will show columns
         * for all groups in the active dimension — even those with no data rows.
         */
        availableGroups: {
            type: Object as PropType<Record<string, GroupedGrid[]>>,
            required: false,
            default: undefined
        },

        /**
         * Optional callback that determines whether a card from
         * sourceGroupKey can be dropped onto targetGroupKey. When
         * undefined all columns accept drops (default behavior).
         */
        canDropOnGroup: {
            type: Function as PropType<((sourceGroupKey: string, targetGroupKey: string) => boolean) | undefined>,
            required: false,
            default: undefined
        },

        /**
         * Optional callback invoked at drag start to determine whether
         * the card being dragged is part of a multi-card selection.
         * Drives group-drag visual styling on the board view.
         */
        isGroupDrag: {
            type: Function as PropType<((idKey: string) => boolean) | undefined>,
            required: false,
            default: undefined
        },

        /** Number of selected cards to display on the group-drag badge. */
        selectedCount: {
            type: Number,
            required: false,
            default: 0
        },

        /**
         * Controls visibility of the per-group count label in the list view's
         * section headers. Accepts a boolean for uniform behavior across all
         * groups, or a predicate that receives the group so individual sections
         * can show/hide the label independently.
         */
        isCountMessageVisible: {
            type: [Boolean, Function] as PropType<boolean | ((group: GroupedGrid) => boolean)>,
            default: true
        },

        /**
         * The function to call in response to the snapshot being clicked.
         * Providing this function will automatically enable the snapshot button.
         */
        onSnapshotClick: {
            type: Function as PropType<(() => void | Promise<void>)>,
            required: false
        },

        isSnapshotVisible: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** The title text to display in the panel header. */
        title: {
            type: String as PropType<string>,
            default: ""
        },

        /** The icon CSS class to display next to the title. */
        titleIconCssClass: {
            type: String as PropType<string>,
            default: ""
        },

        /** True if the panel should show a button to toggle fullscreen mode. */
        hasFullscreen: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** The list of secondary actions to include in the header's ellipsis menu. */
        headerSecondaryActions: {
            type: Array as PropType<PanelAction[]>,
            required: false
        }
    });

    const emit = defineEmits<{
        (e: "update:quickFilterValue", value: string): void;
        (e: "update:groupingKey", value: string): void;
        (e: "update:orderedRequestKeys", value: string[]): void;
        (e: "update:viewMode", value: string): void;
        (e: "cardMoved", idKey: string, fromGroupKey: string, toGroupKey: string, beforeIdKey: string | null): void;
    }>();

    const internalQuickFilterValue = useVModelPassthrough(props, "quickFilterValue", emit);
    const groupingKey = useVModelPassthrough(props, "groupingKey", emit);

    /** Tracks fullscreen state, kept in sync with the underlying Panel via v-model. */
    const isFullscreen = ref(false);

    const groupedListViewRef = ref<InstanceType<typeof GroupedListView> | null>(null);

    /*
        4/23/26 - KBH

        This control is intended for use on Full Worksurface pages. It disables
        "full worksurface" behavior when the user switches to List View or Grid
        View, and re-enables it for Board View.

        Rationale: The Full Worksurface layout is required for Board View to
        render and function correctly. List View and Grid View do not need
        (and are negatively affected by) this layout, so the control scopes
        the behavior to Board View only.
    */
    const isListView = computed(() => props.viewMode === "list");
    const isBoardView = computed(() => props.viewMode === "board");
    const isGridView = computed(() => props.viewMode === "grid");

    const panelBodyCssClasses = computed(() => {
        // Remove the panel body pading when in Grid View.
        if (isGridView.value) {
            return "p-spacing-none";
        }
    });

    // #region Grouping Computation

    /**
     * Builds a map of total (unfiltered) row counts per group key. This is used
     * to show "X of Y Items" labels when a filter reduces the visible rows.
     */
    const totalGroupCounts = computed(() => {
        const map = new Map<string, number>();

        if (!groupingKey.value) {
            map.set("all", props.rows.length);
            return map;
        }

        for (const row of props.rows) {
            const key = (row[groupingKey.value] as string) ?? "";

            map.set(key, (map.get(key) ?? 0) + 1);
        }

        return map;
    });

    /**
     * Builds a lookup from grouping key to GroupedGrid metadata for the
     * active grouping dimension, sourced from the availableGroups prop.
     */
    const availableGroupsByKey = computed((): Map<string, GroupedGrid> => {
        const map = new Map<string, GroupedGrid>();
        const groups = props.availableGroups?.[groupingKey.value];

        if (groups) {
            for (const group of groups) {
                if (group.key) {
                    map.set(group.key, group);
                }
            }
        }

        return map;
    });

    /**
     * Groups the filtered and sorted rows by the active grouping key. The
     * resulting array is ordered with "unassigned" first, then by order, then
     * alphabetically by label. When availableGroups is provided and the view
     * is in board mode, empty groups are included so that all columns appear.
     */
    const filteredGroups = computed((): GroupedGrid[] => {
        if (!groupingKey.value) {
            return [{
                key: "all",
                label: "All",
                gridData: { rows: props.filteredAndSortedRows }
            }];
        }

        // Group rows by their string key value.
        const dataGroups = Enumerable
            .from(props.filteredAndSortedRows)
            .groupBy(r => {
                return (r[groupingKey.value] as string) ?? "";
            })
            .select(g => {
                const rows = g.toArray();
                const key = g.key;

                // Look up display metadata from available groups.
                const metadata = availableGroupsByKey.value.get(key);

                return <GroupedGrid>{
                    key,
                    label: metadata?.label ?? key,
                    iconCssClass: metadata?.iconCssClass,
                    iconStyle: metadata?.iconStyle,
                    textColorCssClass: metadata?.textColorCssClass,
                    photoUrl: metadata?.photoUrl,
                    type: metadata?.type,
                    order: metadata?.order,
                    gridData: { rows }
                };
            })
            .toArray();

        // In board mode, merge in any available groups that have no data rows.
        if (isBoardView.value && availableGroupsByKey.value.size > 0) {
            const existingKeys = new Set(dataGroups.map(g => g.key));

            for (const [key, metadata] of availableGroupsByKey.value) {
                if (!existingKeys.has(key)) {
                    dataGroups.push({
                        ...metadata,
                        gridData: { rows: [] }
                    });
                }
            }
        }

        return Enumerable
            .from(dataGroups)
            .orderBy(g => g.key === "unassigned" ? 0 : 1)
            .thenOrderBy(g => g.order)
            .thenOrderBy(g => g.label)
            .toArray();
    });

    // #endregion

    // #region Panel Header

    const countMessage = computed(() => {
        const totalCount = props.rows?.length ?? 0;
        const filteredCount = props.filteredAndSortedRows.length;

        if (filteredCount === totalCount) {
            return `${asFormattedString(totalCount)} Total ${pluralize("Request", totalCount)}`;
        }
        else {
            return `${asFormattedString(filteredCount)} of ${asFormattedString(totalCount)} Total ${pluralize("Request", totalCount)}`;
        }
    });

    /** True if there are any secondary actions to show in the header's ellipsis menu. */
    const hasHeaderSecondaryActions = computed((): boolean => !!props.headerSecondaryActions && props.headerSecondaryActions.length > 0);

    /** Toggles the panel's fullscreen mode. */
    function onFullscreenClick(): void {
        isFullscreen.value = !isFullscreen.value;
    }

    /**
     * Builds the icon CSS class for a secondary action, appending a text color
     * class for non-default action types so, for example, a "danger" action is
     * tinted red.
     */
    function getHeaderSecondaryActionIconClass(action: PanelAction): string {
        if (!action.iconCssClass) {
            return "";
        }

        let iconClass = action.iconCssClass;

        if (action.type !== "default" && action.type !== "link") {
            iconClass += ` text-${action.type}`;
        }

        return iconClass;
    }

    /** Returns the list item class for a secondary action, disabling it when needed. */
    function getHeaderSecondaryActionItemClass(action: PanelAction): string {
        return action.disabled ? "disabled" : "";
    }

    /** Invokes a secondary action's handler unless the action is disabled. */
    function onActionClick(action: PanelAction, event: Event): void {
        if (action.disabled) {
            return;
        }

        if (action.handler) {
            action.handler(event);
        }
    }

    // #endregion

    // #region Ordered Keys

    const orderedRequestKeysAfterGrouping = computed(() =>
        filteredGroups.value
            .flatMap(g => g.gridData.rows)
            .map(r => (r.idKey ?? "") as string)
    );

    watch(orderedRequestKeysAfterGrouping, (keys) => {
        emit("update:orderedRequestKeys", keys);
    }, { immediate: true });

    // #endregion

    // #region Exposed Methods

    /** Clears selected keys on all registered grid instances (list view only). */
    function clearSelectedKeys(): void {
        groupedListViewRef.value?.clearSelectedKeys();
    }

    /** Expands all sections (list view only). */
    function expandAll(): void {
        groupedListViewRef.value?.expandAll();
    }

    /** Collapses all sections (list view only). */
    function collapseAll(): void {
        groupedListViewRef.value?.collapseAll();
    }

    defineExpose({ clearSelectedKeys, expandAll, collapseAll });

    // #endregion
</script>
