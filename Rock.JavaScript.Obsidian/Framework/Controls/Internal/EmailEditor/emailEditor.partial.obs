<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="email-editor-wrapper styled-scroll">
        <NotificationBox v-if="isNestedSectionWarningShown"
                         class="nested-section-warning"
                         alertType="warning"
                         dismissible
                         heading="Nested sections may not display in some mail apps."
                         @dismiss="onNestedSectionWarningDismissed">
            This email has {{ nestedSectionCount }} {{ nestedSectionCount === 1 ? "section" : "sections" }} placed inside other sections.
            Apple Mail on iPhone and iPad can leave that content blank.
            Moving the content into fewer nested sections resolves it.
            <div class="nested-section-warning-switch">
                <InlineSwitch v-model="isNestedSectionHighlightEnabled" label="Highlight affected sections" />
            </div>
        </NotificationBox>

        <div class="email-editor">
            <SidePanel v-if="ltr"
                       v-model:bodyGlobalProps="bodyGlobalProps"
                       v-model:buttonGlobalProps="buttonGlobalProps"
                       v-model:selectedComponentElement="selectedComponentElement"
                       v-model:dividerGlobalProps="dividerGlobalProps"
                       :emailDocument="emailDocument"
                       :imageComponentBinaryFileTypeGuid="imageComponentBinaryFileTypeGuid"
                       :ltr="ltr"
                       :mergeFields="mergeFields"
                       :recipientPersonIds="recipientPersonIds"
                       :shortLinkCheckToken="shortLinkCheckToken"
                       :shortLinkGetPageId="shortLinkGetPageId"
                       :shortLinkSites="shortLinkSites"
                       :shortLinkTokenMinLength="shortLinkTokenMinLength"
                       :usageType="usageType"
                       :videoProviderNames="videoProviderNames"
                       @cloneComponent="onCloneComponent"
                       @completeComponent="onCompleteComponent"
                       @componentTypeDragStart="onComponentTypeDragStart"
                       @componentTypeDragEnd="onComponentTypeDragEnd"
                       @deleteComponent="onDeleteComponent"
                       @replaceComponent="onReplaceComponent">
                <template v-if="$slots.bodySettingsPrepend" #bodySettingsPrepend>
                    <slot name="bodySettingsPrepend"></slot>
                </template>
            </SidePanel>

            <div class="email-designer-container">
                <EmailDesigner v-model:selectedComponentElement="selectedComponentElement"
                               :html="html"
                               :cloneComponentRequest="cloneComponentRequest"
                               :completeComponentRequest="completeComponentRequest"
                               :deleteComponentRequest="deleteComponentRequest"
                               :componentTypeDragStartRequest="componentTypeDragStartRequest"
                               :componentTypeDragEndRequest="componentTypeDragEndRequest"
                               :getHtmlRequest="getHtmlRequest"
                               :replaceComponentRequest="replaceComponentRequest"
                               :isDisabled="disabled"
                               :isNestedSectionHighlightEnabled="isNestedSectionHighlightEnabled"
                               @emailDocumentUpdated="onEmailDocumentUpdated"
                               @componentAdded="onComponentAdded"
                               @nestedSectionsChanged="onNestedSectionsChanged" />
            </div>

            <SidePanel v-if="!ltr"
                       v-model:bodyGlobalProps="bodyGlobalProps"
                       v-model:buttonGlobalProps="buttonGlobalProps"
                       v-model:dividerGlobalProps="dividerGlobalProps"
                       v-model:selectedComponentElement="selectedComponentElement"
                       :emailDocument="emailDocument"
                       :imageComponentBinaryFileTypeGuid="imageComponentBinaryFileTypeGuid"
                       :ltr="ltr"
                       :mergeFields="mergeFields"
                       :recipientPersonIds="recipientPersonIds"
                       :shortLinkCheckToken="shortLinkCheckToken"
                       :shortLinkGetPageId="shortLinkGetPageId"
                       :shortLinkSites="shortLinkSites"
                       :shortLinkTokenMinLength="shortLinkTokenMinLength"
                       :usageType="usageType"
                       :videoProviderNames="videoProviderNames"
                       @cloneComponent="onCloneComponent"
                       @completeComponent="onCompleteComponent"
                       @componentTypeDragStart="onComponentTypeDragStart"
                       @componentTypeDragEnd="onComponentTypeDragEnd"
                       @deleteComponent="onDeleteComponent"
                       @replaceComponent="onReplaceComponent">
                <template v-if="$slots.bodySettingsPrepend" #bodySettingsPrepend>
                    <slot name="bodySettingsPrepend"></slot>
                </template>
            </SidePanel>
        </div>
    </div>
</template>

<style scoped>
/* #region Email Editor Container */
.email-editor-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.nested-section-warning {
    margin-bottom: 0;
}

.nested-section-warning-switch {
    margin-top: var(--spacing-xsmall);
}

/* #endregion Email Editor Container */

/* #region Email Editor */
.email-editor {
    display: flex;
    flex-grow: 1;
    background-color: var(--color-interface-softest);
    overflow: hidden;
}

.email-designer-container {
    flex-grow: 1;
    flex-basis: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-interface-soft);
}

/* #endregion Email Editor */
</style>

<script setup lang="ts">
    import { PropType, computed, ref, watch } from "vue";
    import EmailDesigner from "./emailDesigner.partial.obs";
    import SidePanel from "./sidePanel.partial.obs";
    import InlineSwitch from "@Obsidian/Controls/inlineSwitch.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { BodyGlobalProps, ButtonGlobalProps, CloneComponentRequest, CompleteComponentRequest, ComponentTypeDragEndRequest, ComponentTypeDragStartRequest, ComponentTypeName, DeleteComponentRequest, DividerGlobalProps, ReplaceComponentRequest } from "./types.partial";
    import { GetHtmlRequest, UsageType } from "./types.partial";
    import { BinaryFiletype } from "@Obsidian/SystemGuids/binaryFiletype";
    import { Guid } from "@Obsidian/Types";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { useSecurityGrantToken } from "@Obsidian/Utility/block";
    import { EmailEditorApi, provideApi } from "./api";
    import {
        bodyGlobalAdapter,
        buttonComponentAdapter,
        buttonGlobalAdapter,
        codeComponentAdapter,
        dividerComponentAdapter,
        dividerGlobalAdapter,
        imageComponentAdapter,
        rsvpComponentAdapter,
        textComponentAdapter,
        titleComponentAdapter,
        videoComponentAdapter
    } from "./utils.partial";

    defineProps({
        html: {
            type: String as PropType<string>,
            required: true
        },

        emailEditorCssClass: {
            type: String as PropType<string | null | undefined>
        },

        getHtmlRequest: {
            type: Object as PropType<GetHtmlRequest | null | undefined>,
            required: false
        },

        imageComponentBinaryFileTypeGuid: {
            type: String as PropType<Guid>,
            default: BinaryFiletype.CommunicationImage
        },

        disabled: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        ltr: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** Paragraph & Lava components - the merge fields available for selection. */
        mergeFields: {
            type: Object as PropType<string[] | undefined>,
            required: true
        },

        /** RSVP component - the recipients who should be registered in the RSVP component when the register button is clicked. */
        recipientPersonIds: {
            type: Object as PropType<number[] | null | undefined>,
            required: true
        },

        shortLinkCheckToken: {
            type: Object as PropType<((token: string, siteId: number) => Promise<string>) | null | undefined>
        },

        shortLinkGetPageId: {
            type: Object as PropType<((pageGuid: Guid) => Promise<number | null | undefined>) | null | undefined>
        },

        shortLinkSites: {
            type: Array as PropType<ListItemBag[] | null | undefined>
        },

        shortLinkTokenMinLength: {
            type: Number as PropType<number | null | undefined>
        },

        usageType: {
            type: String as PropType<UsageType>,
            default: "email" as const
        },

        /** Video component - the video provider names used to add context to the Source Video URL help text. */
        videoProviderNames: {
            type: Object as PropType<string[] | null | undefined>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:communicationTemplateGuid", value: Guid | null | undefined): void;
        (e: "emailDocumentUpdated", document: Document): void;
    }>();

    defineExpose({
        getApi
    });

    const securityGrantToken = useSecurityGrantToken();
    const api = new EmailEditorApi({ securityGrantToken });
    provideApi(api);

    // #region Values

    const selectedComponentElement = ref<HTMLElement | null | undefined>();
    const emailDocument = ref<Document | null | undefined>();

    const cloneComponentRequest = ref<CloneComponentRequest | null | undefined>();
    const completeComponentRequest = ref<CompleteComponentRequest | null | undefined>();
    const deleteComponentRequest = ref<DeleteComponentRequest | null | undefined>();
    const componentTypeDragStartRequest = ref<ComponentTypeDragStartRequest | null | undefined>();
    const componentTypeDragEndRequest = ref<ComponentTypeDragEndRequest | null | undefined>();
    const replaceComponentRequest = ref<ReplaceComponentRequest | null | undefined>();

    const bodyGlobalProps = ref<BodyGlobalProps>({} as BodyGlobalProps);
    const buttonGlobalProps = ref<ButtonGlobalProps>({} as ButtonGlobalProps);
    const dividerGlobalProps = ref<DividerGlobalProps>({} as DividerGlobalProps);

    const nestedSectionCount = ref<number>(0);
    const isNestedSectionWarningDismissed = ref<boolean>(false);

    // Defaults on so the offending sections are visible the moment the warning appears.
    const isNestedSectionHighlightEnabled = ref<boolean>(true);

    // #endregion

    // #region Computed Values

    const isNestedSectionWarningShown = computed<boolean>(() => nestedSectionCount.value > 0 && !isNestedSectionWarningDismissed.value);

    // #endregion Computed Values

    // #region Functions

    /**
     * Gets the API for the email editor.
     *
     * @returns The API for the email editor. This is used to communicate with server on behalf of the email editor.
     */
    function getApi(): EmailEditorApi {
        return api;
    }

    // #endregion

    // #region Event Handlers

    function onComponentTypeDragStart(event: ComponentTypeDragStartRequest): void {
        componentTypeDragStartRequest.value = event;
    }

    function onComponentTypeDragEnd(event: ComponentTypeDragEndRequest): void {
        componentTypeDragEndRequest.value = event;
    }

    function onCloneComponent(event: CloneComponentRequest): void {
        cloneComponentRequest.value = event;
    }

    function onReplaceComponent(event: ReplaceComponentRequest): void {
        replaceComponentRequest.value = event;
    }

    function onCompleteComponent(event: CompleteComponentRequest): void {
        completeComponentRequest.value = event;
    }

    function onDeleteComponent(event: DeleteComponentRequest): void {
        deleteComponentRequest.value = event;
    }

    function onNestedSectionsChanged(event: { nestedSectionCount: number }): void {
        // Let a dismissed warning return once the problem clears and later reappears.
        // The highlight switch keeps whatever state the person left it in; forcing it
        // back on would nudge annoyed users toward dismissing the warning altogether.
        if (event.nestedSectionCount === 0) {
            isNestedSectionWarningDismissed.value = false;
        }

        nestedSectionCount.value = event.nestedSectionCount;
    }

    function onNestedSectionWarningDismissed(): void {
        isNestedSectionWarningDismissed.value = true;

        // The switch lives in the banner, so dismissing must also clear the highlight
        // or the overlays would linger with no visible control to turn them off.
        isNestedSectionHighlightEnabled.value = false;
    }

    function onEmailDocumentUpdated(eventArgs: { emailDocument: Document, areGlobalDefaultsRequired: boolean }): void {
        const { emailDocument: emailDoc, areGlobalDefaultsRequired } = eventArgs;

        // Migrate all components in the document.
        titleComponentAdapter.migrateAllComponents(emailDoc);
        textComponentAdapter.migrateAllComponents(emailDoc);
        imageComponentAdapter.migrateAllComponents(emailDoc);
        buttonComponentAdapter.migrateAllComponents(emailDoc);
        videoComponentAdapter.migrateAllComponents(emailDoc);
        dividerComponentAdapter.migrateAllComponents(emailDoc);
        rsvpComponentAdapter.migrateAllComponents(emailDoc);
        codeComponentAdapter.migrateAllComponents(emailDoc);

        // Initialize global props.

        if (areGlobalDefaultsRequired || bodyGlobalAdapter.areGlobalDefaultsNeeded(emailDoc)) {
            bodyGlobalProps.value = bodyGlobalAdapter.getDefaultGlobalProps();
            bodyGlobalAdapter.writeGlobalProps(emailDoc, bodyGlobalProps.value);
        }
        else {
            bodyGlobalAdapter.migrateGlobalProps(emailDoc);
            bodyGlobalProps.value = bodyGlobalAdapter.readGlobalProps(emailDoc);
        }

        if (areGlobalDefaultsRequired || buttonGlobalAdapter.areGlobalDefaultsNeeded(emailDoc)) {
            buttonGlobalProps.value = buttonGlobalAdapter.getDefaultGlobalProps();
            buttonGlobalAdapter.writeGlobalProps(emailDoc, buttonGlobalProps.value);
        }
        else {
            buttonGlobalAdapter.migrateGlobalProps(emailDoc);
            buttonGlobalProps.value = buttonGlobalAdapter.readGlobalProps(emailDoc);
        }

        if (areGlobalDefaultsRequired || dividerGlobalAdapter.areGlobalDefaultsNeeded(emailDoc)) {
            dividerGlobalProps.value = dividerGlobalAdapter.getDefaultGlobalProps();
            dividerGlobalAdapter.writeGlobalProps(emailDoc, dividerGlobalProps.value);
        }
        else {
            dividerGlobalAdapter.migrateGlobalProps(emailDoc);
            dividerGlobalProps.value = dividerGlobalAdapter.readGlobalProps(emailDoc);
        }

        // Update the email document reference after migrations in case setting it triggers reactivity.
        emailDocument.value = emailDoc;
        emit("emailDocumentUpdated", emailDoc);
    }

    function onComponentAdded(event: { componentTypeName: ComponentTypeName; componentElement: HTMLElement }): void {
        if (emailDocument.value) {
            buttonGlobalAdapter.onComponentAdded({
                emailDocument: emailDocument.value,
                componentElement: event.componentElement,
                componentTypeName: event.componentTypeName,
                globalProps: buttonGlobalProps.value
            });

            dividerGlobalAdapter.onComponentAdded({
                emailDocument: emailDocument.value,
                componentElement: event.componentElement,
                componentTypeName: event.componentTypeName,
                globalProps: dividerGlobalProps.value
            });

            bodyGlobalAdapter.onComponentAdded({
                emailDocument: emailDocument.value,
                componentElement: event.componentElement,
                componentTypeName: event.componentTypeName,
                globalProps: bodyGlobalProps.value
            });
        }
    }

    // #endregion Event Handlers

    // #region Watchers

    watch(bodyGlobalProps, (newValue) => {
        if (emailDocument.value) {
            bodyGlobalAdapter.writeGlobalProps(emailDocument.value, newValue);
        }
    });

    watch(buttonGlobalProps, (newValue) => {
        if (emailDocument.value) {
            buttonGlobalAdapter.writeGlobalProps(emailDocument.value, newValue);
        }
    });

    watch(dividerGlobalProps, (newValue) => {
        if (emailDocument.value) {
            dividerGlobalAdapter.writeGlobalProps(emailDocument.value, newValue);
        }
    });

    // #endregion Watchers
</script>
