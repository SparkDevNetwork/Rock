<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <HighlightLabel v-if="trendInfo && !isCompact"
                    :labelType="labelType"
                    customClass="kpi-v2-trend-plain"
                    :iconCssClass="trendInfo.iconCssClass"
                    :tooltip="tooltipText"
                    tooltipPlacement="top"
                    :aria-label="trendInfo.ariaLabel">{{ trendInfo.text }}</HighlightLabel>

    <span v-else-if="trendInfo"
          class="kpi-v2-trend"
          :class="cssClasses"
          :aria-label="trendInfo.ariaLabel"
          v-tooltip="tooltipText">
        <i :class="trendInfo.iconCssClass"></i>
        <span v-if="trendInfo.text">{{ trendInfo.text }}</span>
    </span>
</template>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import HighlightLabel from "@Obsidian/Controls/highlightLabel.obs";
    import { vTooltip } from "@Obsidian/Directives/tooltip";
    import { getKpiTrendInfo, KpiTrend, KpiTrendDisplay, KpiTrendInfo, KpiTrendSentiment } from "@Obsidian/Core/Controls/kpi";

    const props = defineProps({
        /** The trend to show. Nothing renders when it is null or undefined. */
        trend: {
            type: [Number, String] as PropType<KpiTrend | null | undefined>
        },

        /** When true a rise is shown as negative and a drop as positive. */
        isLowerBetter: {
            type: Boolean,
            default: false
        },

        /** Whether the headline shows the arrow and percent, or the arrow only. */
        display: {
            type: String as PropType<KpiTrendDisplay | undefined>
        },

        /** An optional tooltip for the trend. */
        tooltip: {
            type: String as PropType<string | null | undefined>
        },

        /** When true the trend is drawn as plain text for a content row instead of a label. */
        isCompact: {
            type: Boolean,
            default: false
        }
    });

    // #region Computed Values

    const trendInfo = computed((): KpiTrendInfo | null => {
        return getKpiTrendInfo(props.trend, {
            isLowerBetter: props.isLowerBetter,
            display: props.isCompact ? undefined : props.display,
            tooltip: props.tooltip
        });
    });

    // "unknown" is drawn with no fill, so it uses a custom label class instead of a label type.
    const labelType = computed((): "success" | "danger" | "default" | "custom" => {
        if (!trendInfo.value || trendInfo.value.isPlain) {
            return "custom";
        }

        if (trendInfo.value.sentiment === KpiTrendSentiment.Positive) {
            return "success";
        }

        if (trendInfo.value.sentiment === KpiTrendSentiment.Negative) {
            return "danger";
        }

        return "default";
    });

    const cssClasses = computed((): string[] => {
        if (!trendInfo.value) {
            return [];
        }

        return [
            trendInfo.value.sentiment,
            trendInfo.value.isPlain ? "plain" : ""
        ].filter(cssClass => cssClass !== "");
    });

    const tooltipText = computed((): string => {
        return trendInfo.value?.tooltip ?? "";
    });

    // #endregion Computed Values
</script>
