<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <RockFormField :modelValue="internalValue" v-bind="standardFieldProps" disableLabel :rules="mutatedRules" name="campus-account-amount-picker">
        <Loading :isLoading="isLoading">
            <template v-if="accountAmountEntryMode == 'singleAccount'">
                <CurrencyBox :currencyCodeDefinedValueGuid="currencyCodeDefinedValueGuid ?? undefined" v-model="amount" disableLabel :disabled="disabled || singleAmountReadOnly" :class="amountEntrySingleCssClass" />
                <CampusPicker label="Campus"
                              v-model="internalCampusBag"
                              v-if="isCampusPickerVisible"
                              :includeInactive="includeInactiveCampuses"
                              :campusTypeFilter="campusTypeFilter ?? undefined"
                              :campusStatusFilter="campusStatusFilter ?? undefined"
                              :disabled="disabled" />
                <BaseAsyncPicker v-model="selectedAccount"
                                 v-bind="standardFieldProps"
                                 :label="undefined"
                                 :disabled="disabled"
                                 :displayStyle="PickerDisplayStyle.Condensed"
                                 :items="accountPickerAccounts" />
            </template>
            <template v-else>
                <CurrencyBox v-for="accountAmount in amounts" :key="accountAmount?.account?.value!" :label="accountAmount?.account?.text" v-model="accountAmount.amount" :currencyCodeDefinedValueGuid="currencyCodeDefinedValueGuid ?? undefined" :disabled="disabled || !!accountAmount.readOnly" />
                <CampusPicker label="Campus"
                              v-model="internalCampusBag"
                              v-if="isCampusPickerVisible"
                              :includeInactive="includeInactiveCampuses"
                              :campusTypeFilter="campusTypeFilter ?? undefined"
                              :campusStatusFilter="campusStatusFilter ?? undefined"
                              :disabled="disabled" />
            </template>
        </Loading>
    </RockFormField>
</template>

<script setup lang="ts">
    import { PropType, computed, ref, watch } from "vue";
    import RockFormField from "./rockFormField.obs";
    import CurrencyBox from "./currencyBox.obs";
    import CampusPicker from "./campusPicker.obs";
    import Loading from "./loading.obs";
    import { Guid } from "@Obsidian/Types";
    import { PickerDisplayStyle } from "@Obsidian/Enums/Controls/pickerDisplayStyle";
    import { useVModelPassthrough, standardRockFormFieldProps, useStandardRockFormFieldProps } from "@Obsidian/Utility/component";
    import { areEqual, toGuidOrNull } from "@Obsidian/Utility/guid";
    import { useHttp } from "@Obsidian/Utility/http";
    import { useSuspense } from "@Obsidian/Utility/suspense";
    import { containsRequiredRule, normalizeRules } from "@Obsidian/ValidationRules";
    import { CampusAccountAmountPickerGetAccountsOptionsBag } from "@Obsidian/ViewModels/Rest/Controls/campusAccountAmountPickerGetAccountsOptionsBag";
    import { CampusAccountAmountPickerGetAccountsResultItemBag } from "@Obsidian/ViewModels/Rest/Controls/campusAccountAmountPickerGetAccountsResultItemBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import BaseAsyncPicker from "./baseAsyncPicker.obs";
    import { useSecurityGrantToken } from "@Obsidian/Utility/block";

    type AccountAmount = {
        amount: number | null,
        account: ListItemBag | null,
        readOnly: boolean
    };

    type PresetAccountAmount = {
        accountGuid?: Guid | null,
        amount?: number | null,
        isReadOnly: boolean
    };

    const props = defineProps({
        /** The currently selected account(s) and amount value(s). */
        modelValue: {
            type: Array as PropType<AccountAmount[] | undefined>,
            required: false
        },

        /** V-Model of the Guid of the selected campus */
        campusGuid: {
            type: String as PropType<Guid | null>,
            default: null
        },

        /** Specifies the currency used */
        currencyCodeDefinedValueGuid: {
            type: String as PropType<Guid | null>,
            default: null
        },

        /**
         * Single account will show a dropdown of accounts to choose from and one textbox to enter the amount of money.
         * Multiple accounts will show a textbox for each possible account so you can add money for multiple accounts.
         */
        accountAmountEntryMode: {
            type: String as PropType<"singleAccount" | "multipleAccounts">,
            default: "singleAccount"
        },

        /** The Lava Template to use as the amount input label for each account. Default is "Account.PublicName". */
        accountHeaderTemplate: {
            type: String,
            default: null
        },

        /**
         * A pre-resolved list of accounts to present. Provide either this or
         * `selectableAccountGuids` to control which accounts are shown. When
         * set, the control renders these accounts as-is and does not fetch from
         * the server, so the caller can include accounts the endpoint would
         * not return (e.g., non-public) or apply custom labels.
         */
        accounts: {
            type: Array as PropType<ListItemBag[] | null>,
            default: null
        },

        /**
         * Initial per-account amounts to seed, matched by account Guid. An entry
         * flagged isReadOnly renders that account's amount input disabled so the
         * giver cannot change it.
         */
        presetAccountAmounts: {
            type: Array as PropType<PresetAccountAmount[] | null>,
            default: null
        },

        /**
         * The Guids of the selectable accounts to fetch and display. Provide
         * either this or `accounts` to control which accounts are shown.
         * Accounts specified here are shown only if active, public, and within
         * their respective start and end date. An empty array (the default)
         * fetches all eligible accounts.
         */
        selectableAccountGuids: {
            type: Array as PropType<Guid[]>,
            default: () => []
        },

        /**
         * If enabled the Accounts will be ordered by the index of `props.selectableAccountGuids`,
         * that is they will be rendered in the order in which the Account Guids were added to the `props.selectableAccountGuids`
         */
        orderBySelectableAccountsIndex: {
            type: Boolean,
            default: false
        },

        /**
         * If true, the campus picker is never rendered. Set this when the
         * consumer manages campus selection itself (e.g., in a separate picker).
         */
        alwaysHideCampus: {
            type: Boolean,
            default: false
        },

        /** If true, the campus picker will be hidden when `campusGuid` has a value. */
        hideCampusIfKnown: {
            type: Boolean,
            default: false
        },

        /** If true then inactive campuses will be included in the list of options. */
        includeInactiveCampuses: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** Campus type defined value guids that limit which campuses are included in the list of options. */
        campusTypeFilter: {
            type: [String, Array] as PropType<Guid | Guid[] | null>,
            default: null
        },

        /** Campus status defined value guids that limit which campuses are included in the list of options. */
        campusStatusFilter: {
            type: [String, Array] as PropType<Guid | Guid[] | null>,
            default: null
        },

        /** HTML class attribute applied to the single amount textbox */
        amountEntrySingleCssClass: {
            type: String,
            default: ""
        },

        /** When true, the amount, account, and campus inputs are disabled. */
        disabled: {
            type: Boolean,
            default: false
        },

        ...standardRockFormFieldProps
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: AccountAmount[] | null): void
        (e: "update:campusGuid", value: Guid | null): void
    }>();

    // #region Values

    const internalValue = useVModelPassthrough(props, "modelValue", emit);
    const internalCampusGuid = useVModelPassthrough(props, "campusGuid", emit);
    const standardFieldProps = useStandardRockFormFieldProps(props);
    const hideCampusPicker = ref(false);

    // Account Fetching Variables
    const http = useHttp();
    const loadedAccounts = ref<CampusAccountAmountPickerGetAccountsResultItemBag[] | null>(null);
    const loadedAccountListItems = ref<ListItemBag[] | null>(null);
    const securityToken = useSecurityGrantToken();
    const isLoading = ref(false);
    const hasLoadedOnce = ref(false);

    // Single Account Mode Variables
    const amount = ref<number | null>();
    const selectedAccount = ref<ListItemBag | null>(null);
    const singleAmountReadOnly = ref(false);

    // Multiple Account Mode Variables
    const amounts = ref<AccountAmount[]>([]);

    // #endregion

    // #region Computed Values

    /**
     * The actual items to make available to the picker. This allows us to do any
     * post-processing, such as adding additional items, and still be lazy loaded as well.
     */
    const accountPickerAccounts = computed((): ListItemBag[] | (() => Promise<ListItemBag[]>) => {
        return loadedAccountListItems.value ?? loadAccountOptions;
    });

    /** The ListItemBag version of the internalCampusGuid */
    const internalCampusBag = computed<ListItemBag>({
        get() {
            return { value: internalCampusGuid.value };
        },
        set(newValue) {
            internalCampusGuid.value = toGuidOrNull(newValue.value);
        }
    });

    /** Whether the inner campus picker should render. */
    const isCampusPickerVisible = computed((): boolean => {
        return !props.alwaysHideCampus && !hideCampusPicker.value;
    });

    const mutatedRules = computed(() => {
        if (containsRequiredRule(props.rules)) {
            const rules = normalizeRules(props.rules);
            const index = rules.indexOf("required");
            rules[index] = function accountAmountRequired(): string | true {
                const hasAmount = !!internalValue.value?.some(aa => !!aa.amount);
                return hasAmount || "Please enter an amount.";
            };
            return rules;
        }

        return props.rules;
    });

    // #endregion

    // #region Watchers

    // Inbound sync: populate the local editable state once the accounts have
    // loaded (or the entry mode changes). Set account(s) and amount(s) as follows:
    watch([loadedAccountListItems, () => props.accountAmountEntryMode], () => {
        if (loadedAccountListItems.value && loadedAccountListItems.value.length) {
            // Multiple Account Mode (loop over each account):
            if (props.accountAmountEntryMode === "multipleAccounts") {
                amounts.value = loadedAccountListItems.value.map(account => {
                    // If there's a read-only preset for this account, it always takes precedence, and locks the input.
                    const preset = findPreset(account.value);
                    if (preset?.isReadOnly) {
                        return {
                            amount: preset.amount ?? null,
                            account,
                            readOnly: true
                        };
                    }

                    // If the individual has already entered an amount for this account, keep it.
                    const existing = amounts.value.find(a => a.account?.value === account.value);
                    if (existing) {
                        return existing;
                    }

                    // If the incoming model value has an entry for this account, use it.
                    const fromModel = props.modelValue?.find(aa => aa.account?.value === account.value);
                    if (fromModel) {
                        return fromModel;
                    }

                    // Finally, if there's a preset for this account, use it. Otherwise, start with a blank amount.
                    return {
                        amount: preset?.amount ?? null,
                        account,
                        readOnly: false
                    };
                });
            }
            // Single Account Mode:
            else {
                // Has the individual already selected an account that is [still] in the list?
                const isSelectedAccountInList =
                    selectedAccount.value
                    && loadedAccountListItems.value.some(a =>
                        a.value === selectedAccount.value?.value
                    );

                if (!isSelectedAccountInList) {
                    // If the model value has an account that is in the list, select it.
                    const current = props.modelValue?.[0];
                    const matchedModelAccount = current?.account?.value
                        ? loadedAccountListItems.value.find(a => a.value === current.account?.value)
                        : undefined;

                    // If not, select the first account in the list.
                    selectedAccount.value = matchedModelAccount ?? loadedAccountListItems.value[0];
                }

                // Resolve the amount for the selected account by the same precedence as multi-account mode above.
                resolveSingleAccountAmount();
            }
        }
    });

    watch(() => props.hideCampusIfKnown, () => {
        // We don't want this to be `computed` because we only want to change if hideCampusIfKnow changes because the
        // campusGuid will get changed, so campusGuid needs to be passed in from the start.
        hideCampusPicker.value = !!(props.campusGuid && props.hideCampusIfKnown);
    }, { immediate: true });

    // Outbound sync: rebuild the model value as a brand-new array whenever the local editable state changes.
    watch([amount, selectedAccount, amounts, () => props.accountAmountEntryMode], () => {
        if (props.accountAmountEntryMode === "singleAccount") {
            internalValue.value = [{
                account: selectedAccount.value,
                amount: amount.value || null,
                readOnly: singleAmountReadOnly.value
            }];
        }
        else {
            internalValue.value = amounts.value.map(aa => {
                return {
                    amount: aa.amount,
                    account: aa.account,
                    readOnly: aa.readOnly
                };
            });
        }
    }, { deep: true });

    watch(() => [props.orderBySelectableAccountsIndex, props.selectableAccountGuids, props.accountHeaderTemplate, props.accounts], () => loadAccountOptions());

    // Re-seed (and re-lock) the single-mode amount when the giver picks a different account.
    watch(selectedAccount, () => resolveSingleAccountAmount());

    // #endregion

    // #region Functions

    /** Finds the seed preset for an account Guid, when one was provided. */
    function findPreset(accountGuid: string | null | undefined): PresetAccountAmount | undefined {
        const guid = toGuidOrNull(accountGuid);
        if (!guid || !props.presetAccountAmounts) {
            return undefined;
        }

        return props.presetAccountAmounts.find(preset => areEqual(preset.accountGuid, guid));
    }

    /**
     * Resolves the selected single-mode account's amount and read-only state, by the same
     * precedence as the multiple-account flow: a read-only preset wins and locks the input;
     * otherwise an amount already in the box is kept; then the model value; then an editable
     * preset seed; then blank.
     */
    function resolveSingleAccountAmount(): void {
        const account = selectedAccount.value?.value;
        const preset = findPreset(account);

        // If there's a read-only preset for this account, it always takes precedence, and locks the input.
        if (preset?.isReadOnly) {
            singleAmountReadOnly.value = true;
            amount.value = preset.amount ?? null;
            return;
        }

        // The account is editable from here on.
        singleAmountReadOnly.value = false;

        // If the individual has already entered an amount (or one was kept across a switch), keep it.
        if (amount.value) {
            return;
        }

        // If the incoming model value has an entry for this account, use it.
        const fromModel = props.modelValue?.find(aa => aa.account?.value === account);
        if (fromModel) {
            amount.value = fromModel.amount ?? null;
            return;
        }

        // Finally, if there's a preset for this account, use it. Otherwise, start with a blank amount.
        amount.value = preset?.amount ?? null;
    }

    /** Loads the items from the server. */
    async function loadAccountOptions(): Promise<ListItemBag[]> {
        // When the consumer supplies a resolved account list, render it as-is and
        // skip the server fetch. This lets the consumer include accounts the
        // endpoint would not return (e.g., non-public ones) and control the labels.
        if (props.accounts) {
            loadedAccountListItems.value = props.accounts.map(account => ({ text: account.text, value: account.value }));
            hasLoadedOnce.value = true;
            isLoading.value = false;
            return loadedAccountListItems.value;
        }

        const options: CampusAccountAmountPickerGetAccountsOptionsBag = {
            selectableAccountGuids: props.selectableAccountGuids.map(s => toGuidOrNull(s)).filter(g => g !== null).map(g => g as Guid),
            orderBySelectableAccountsIndex: props.orderBySelectableAccountsIndex,
            accountHeaderTemplate: props.accountHeaderTemplate,
            securityGrantToken: securityToken.value
        };

        // Show the loading indicator only on the first fetch. Later reloads
        // (such as adding an account) refresh in the background so amounts
        // already entered stay visible instead of flashing the loader.
        if (!hasLoadedOnce.value) {
            isLoading.value = true;
        }

        const result = await http.post<CampusAccountAmountPickerGetAccountsResultItemBag[]>("/api/v2/Controls/CampusAccountAmountPickerGetAccounts", undefined, options);

        if (result.isSuccess && result.data) {
            loadedAccounts.value = result.data;
            loadedAccountListItems.value = result.data.map(item => ({ text: item.name, value: item.value }));

            hasLoadedOnce.value = true;
            isLoading.value = false;
            return loadedAccountListItems.value;
        }
        else {
            console.error(result.errorMessage ?? "Unknown error while loading data.");
            loadedAccounts.value = [];
            isLoading.value = false;
            return [];
        }
    }

    // #endregion

    // Initialize account data
    const suspense = useSuspense();

    if (suspense) {
        suspense.addOperation(loadAccountOptions());
    }
    else {
        loadAccountOptions();
    }
</script>
