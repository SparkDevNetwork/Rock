<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="gm-container" :class="isExpanded ? 'expanded-map-size' : 'static-map-size'">
        <!--
            On-map drawing toolbar. Positioned absolutely inside gm-container,
            overlaid on the map to the right of Google's Map / Styled Map
            toggles. We deliberately do not use map.controls.push for this
            toolbar because Google's internal control-layout pass happens at
            an unpredictable point after the map's idle event, which causes
            a visible slide as the wrapper's wrapper gets repositioned. By
            owning the position ourselves the toolbar appears at its final
            spot on the first paint. The left offset is tuned to clear the
            Map / Styled Map controls; if those grow (e.g. localized labels)
            this may need adjustment.
        -->
        <div class="gm-tool-bar">
            <button ref="panButton"
                    type="button"
                    class="gm-tool-button"
                    :disabled="!isDrawing"
                    @click.prevent="cancelDrawing"
                    title="Cancel drawing"
                    aria-label="Cancel drawing"><i class="ti ti-hand-stop"></i></button>
            <button ref="drawButton"
                    type="button"
                    class="gm-tool-button"
                    :class="{ 'text-info': isDrawing }"
                    :disabled="isDrawing || hasShapeOnMap"
                    v-show="!hasShapeOnMap"
                    @click.prevent="startDrawing"
                    :title="drawingMode === 'Polygon' ? 'Draw a geo-fence' : 'Draw point'"
                    :aria-label="drawingMode === 'Polygon' ? 'Draw a geo-fence' : 'Draw point'"><i class="ti" :class="drawingMode === 'Polygon' ? 'ti-polygon' : 'ti-map-pin'"></i></button>
            <button ref="clearButton"
                    type="button"
                    class="gm-tool-button"
                    :disabled="!isShapeSelected"
                    @click.prevent="deleteSelectedShape()"
                    title="Delete selected shape"
                    aria-label="Delete selected shape"><i class="ti ti-x"></i></button>
        </div>
        <!-- This is where the Google Map (with our custom drawing toolbar) will go. -->
        <Loading :isLoading="!isReady" :class="isExpanded ? 'expanded-map-size' : 'static-map-size'">
            <div ref="mapContainer" :class="isExpanded ? 'expanded-map-size' : 'static-map-size'" class="gm-map"></div>
        </Loading>
    </div>
</template>

<script setup lang="ts">
    /* global google */
    /// <reference types="google.maps" />
    import { computed, nextTick, onBeforeMount, onMounted, PropType, ref, watch } from "vue";
    import { Guid } from "@Obsidian/Types";
    import { DrawingMode, Coordinate } from "@Obsidian/Types/Controls/geo";
    import { toCoordinate, wellKnownToCoordinates, coordinatesToWellKnown, loadMapResources, createLatLng } from "@Obsidian/Utility/geo";
    import { DefinedValue } from "@Obsidian/SystemGuids/definedValue";
    import Loading from "@Obsidian/Controls/loading.obs";
    import { confirm } from "@Obsidian/Utility/dialogs";
    import { GeoPickerGoogleMapSettingsBag } from "@Obsidian/ViewModels/Rest/Controls/geoPickerGoogleMapSettingsBag";
    import { isNullOrWhiteSpace } from "@Obsidian/Utility/stringUtils";

    const props = defineProps({
        /**
         * Point or polygon coordinate string in the Well Known Text format:
         * "POINT(longitude latitude)" or "POLYGON((longitude latitude, longitude latitude, ...))"
         */
        modelValue: {
            type: String,
            default: ""
        },

        /**
         * What are we drawing? Point or Polygon? This prop is not reactive.
         */
        drawingMode: {
            type: String as PropType<DrawingMode>,
            required: true
        },

        /**
         * GUID of a DefinedValue of the Map Styles DefinedType. Determines the way the map looks.
         */
        mapStyleValueGuid: {
            type: String as PropType<Guid>,
            default: DefinedValue.MapStyleRock
        },

        /**
         * Latitude coordinate to center map on if not initialized with a shape. This prop is not reactive.
         */
        centerLatitude: {
            type: Number as PropType<number>,
            default: null
        },

        /**
         * Longitude coordinate to center map on if not initialized with a shape. This prop is not reactive.
         */
        centerLongitude: {
            type: Number as PropType<number>,
            default: null
        },

        /**
         * Whether to use the normal static size or have the map fill its container
         */
        isExpanded: {
            type: Boolean as PropType<boolean>,
            default: false
        },
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: string): void
        (e: "update:valueLabel", value: string): void
    }>();

    // #region Values

    // References to DOM elements
    const panButton = ref<HTMLButtonElement | null>(null);
    const drawButton = ref<HTMLButtonElement | null>(null);
    const clearButton = ref<HTMLButtonElement | null>(null);
    const mapContainer = ref<HTMLDivElement | null>(null);

    // variables used to determine when everything is ready so we can initialize the map
    const isGoogleLoaded = ref(false);
    const isMounted = ref(false);
    const isReady = computed(() => isGoogleLoaded.value && isMounted.value);

    // Reactive toolbar state. The three buttons are gated on these:
    //   pan  -> active only while in-progress polygon vertices are being collected
    //   draw -> active only when no shape exists and we are not currently drawing
    //   x    -> active only when a shape exists AND is currently selected
    const isDrawing = ref(false);
    const hasShapeOnMap = ref(false);
    const isShapeSelected = ref(false);

    let drawingMode = props.drawingMode;
    let map: google.maps.Map | null = null;
    let centerLatitude = props.centerLatitude; // Get from prop on init; we aren't reacting to it
    let centerLongitude = props.centerLongitude; // Get from prop on init; we aren't reacting to it
    let minLat: number | null = null;
    let minLng: number | null = null;
    let maxLat: number | null = null;
    let maxLng: number | null = null;
    let fillColor = "0088cc";
    let strokeColor = "0088cc";
    let styles: google.maps.MapTypeStyle[] = [];
    // Custom wrapper around AdvancedMarkerElement that ducktypes the parts of
    // the Marker API we touch, used when the active Map Style has a mapId.
    type AdvancedMarkerWrapper = {
        position: google.maps.LatLng;
        map: google.maps.Map | null;
        marker_element: google.maps.marker.AdvancedMarkerElement;
        getPosition(): google.maps.LatLng;
        getPath(): string;
        setPosition(position: google.maps.LatLng): void;
        setMap(newMap: google.maps.Map | null): void;
    };
    type SelectableShape = google.maps.Polygon | google.maps.Marker | AdvancedMarkerWrapper;

    // The committed shape (Polygon, Marker, or custom AdvancedMarker wrapper).
    let shape: SelectableShape | null = null;
    let marker: google.maps.Symbol | null = null;
    let mapId: string | null = null;

    // In-progress polygon drawing state. These are cleared when a polygon is
    // finished, the user cancels via the pan button, or the polyline is abandoned.
    let workingVertices: google.maps.LatLng[] = [];
    let workingPolyline: google.maps.Polyline | null = null;
    let firstVertexMarker: google.maps.Marker | null = null;
    let mapClickListener: google.maps.MapsEventListener | null = null;
    let mapDblclickListener: google.maps.MapsEventListener | null = null;
    let mapMousemoveListener: google.maps.MapsEventListener | null = null;

    // #endregion

    // #region Computed Values

    // The main value.
    // Internally we use an array of Coordinates
    // Externally we give a point or polygon in the Well Know Text format (for DB compatibility)
    const internalValue = computed({
        // Prop is in DB format; convert for use internally
        get(): Coordinate[] {
            return wellKnownToCoordinates(props.modelValue ?? "", drawingMode);
        },
        // Convert the value to Well Known Text for emitting
        set(newValue: Coordinate[]): void {
            emit("update:modelValue", coordinatesToWellKnown(newValue, drawingMode));
        }
    });

    // #endregion

    // #region Watchers

    // We can initialize the map now that everything is ready
    watch([isReady], initialize);

    // When we resize, let Google Maps know
    watch(() => props.isExpanded, async () => {
        if (isReady.value) {
            await nextTick(); // Wait until rerender before telling G to resize
            google.maps.event.trigger(map as google.maps.Map, "resize");
        }
    });

    // #endregion

    // #region Functions

    /**
     * Initialize the map and our custom drawing toolbar.
     */
    async function initialize(isReady): Promise<void> {
        if (!isReady) {
            return;
        }

        marker = {
            path: "M 0,0 C -2,-20 -10,-22 -10,-30 A 10,10 0 1,1 10,-30 C 10,-22 2,-20 0,0 z",
            fillColor: "#FE7569",
            fillOpacity: 1,
            strokeColor: "#000",
            strokeWeight: 1,
            scale: 1,
            labelOrigin: new google.maps.Point(0, -28)
        };

        // Make sure the map's DIV will be rendered so we have a reference to it
        await nextTick();

        // Create a new StyledMapType object, passing it the array of styles,
        // as well as the name to be displayed on the map type control.
        var styledMap = new google.maps.StyledMapType(styles, { name: "Styled Map" });

        // Check if the mapId has a value.
        let isMapIdEmpty = isNullOrWhiteSpace(mapId);

        // WARNING: I though about removing the "center:" from the options here but then the
        // map's controls were different and then our delete button was out of alignment.
        var mapOptions = {
            center: new google.maps.LatLng(centerLatitude, centerLongitude),
            zoom: 16,
            streetViewControl: false,
            fullscreenControl: false,
            mapTypeControlOptions: {
                mapTypeIds: [google.maps.MapTypeId.ROADMAP, "map_style"],
            },
            ...(!isMapIdEmpty && { mapId: mapId })
        };

        map = new google.maps.Map(mapContainer.value as HTMLElement, mapOptions);

        // Note: the on-map drawing toolbar lives in our own DOM (inside
        // gm-container, position:absolute) rather than being pushed into
        // map.controls. Doing it this way avoids Google's unpredictable
        // post-idle control-layout pass, which caused the toolbar to slide
        // into place after first paint. See the .gm-tool-bar CSS rule.

        //Associate the styled map with the MapTypeId and set it to display.
        map.mapTypes.set("map_style", styledMap);
        map.setMapTypeId("map_style");

        // Render a saved shape if one is already present, then enter hasShape.
        if (internalValue.value && internalValue.value.length > 0) {
            let initialShape: SelectableShape;

            if (drawingMode === "Polygon") {
                initialShape = new google.maps.Polygon({
                    paths: internalValue.value.map((c: Coordinate) => createLatLng(...c)),
                    clickable: true,
                    editable: true,
                    strokeColor: strokeColor,
                    fillColor: fillColor,
                    strokeWeight: 2,
                    map
                });
            }
            else {
                initialShape = createPointMarker(new google.maps.LatLng(...internalValue.value[0]));
            }

            setCurrentShape(initialShape);
            fitBounds(map);
        }

        // Clicking the map (in empty space) while a shape exists deselects it
        // so the X button goes inactive. Guard against deselecting while the
        // user is mid-draw, where map clicks are how we collect vertices.
        // We never remove this listener; it lives for the map's lifetime.
        google.maps.event.addListener(map, "click", () => {
            if (isDrawing.value) {
                return;
            }

            deselect();
        });
    }

    /**
     * Enter drawing mode. From idle, this switches the cursor to crosshair and
     * binds the map listeners that collect either a single point click or a
     * sequence of polygon vertices.
     */
    function startDrawing(): void {
        if (isDrawing.value || hasShapeOnMap.value || !map) {
            return;
        }

        isDrawing.value = true;
        map.setOptions({ draggableCursor: "crosshair" });

        if (drawingMode === "Point") {
            mapClickListener = google.maps.event.addListener(map, "click", (e: google.maps.MapMouseEvent) => {
                if (!e.latLng) {
                    return;
                }

                finishPoint(e.latLng);
            });
        }
        else {
            // While the user is laying down polygon vertices, suppress Google's
            // default dblclick-to-zoom so the dblclick that finalizes the
            // polygon doesn't also zoom the map. Restored on finish/cancel.
            map.setOptions({ disableDoubleClickZoom: true });

            workingVertices = [];
            workingPolyline = new google.maps.Polyline({
                path: [],
                strokeColor: strokeColor,
                strokeWeight: 2,
                // The rubber-band line follows the cursor; if it were clickable
                // Google Maps would treat clicks on it as polyline hits and
                // swallow the map click that should be adding the next vertex.
                clickable: false,
                map: map as google.maps.Map
            });

            mapClickListener = google.maps.event.addListener(map, "click", (e: google.maps.MapMouseEvent) => {
                if (!e.latLng) {
                    return;
                }

                addPolygonVertex(e.latLng);
            });

            // Double-clicking the map places a final vertex at the dblclick
            // position and then closes the polygon back to the first vertex,
            // mirroring the legacy DrawingManager. Because browsers fire two
            // click events before a dblclick, the second click produces a
            // near-duplicate trailing vertex that we strip before closing.
            mapDblclickListener = google.maps.event.addListener(map, "dblclick", () => {
                dedupeTrailingVertex();
                tryFinishPolygon();
            });

            // Rubber-band the working polyline from the last placed vertex to
            // the cursor so the user can see where the next segment will land.
            mapMousemoveListener = google.maps.event.addListener(map, "mousemove", (e: google.maps.MapMouseEvent) => {
                if (!e.latLng || workingVertices.length === 0) {
                    return;
                }

                workingPolyline?.setPath([...workingVertices, e.latLng]);
            });
        }
    }

    /**
     * Append a vertex to the in-progress polyline. The first vertex also gets
     * a small marker so the user can click it to snap-close the polygon.
     */
    function addPolygonVertex(latLng: google.maps.LatLng): void {
        workingVertices.push(latLng);
        workingPolyline?.setPath(workingVertices);

        if (workingVertices.length === 1) {
            firstVertexMarker = new google.maps.Marker({
                position: latLng,
                map: map as google.maps.Map,
                icon: {
                    path: google.maps.SymbolPath.CIRCLE,
                    scale: 6,
                    fillColor: fillColor,
                    fillOpacity: 1,
                    strokeColor: strokeColor,
                    strokeWeight: 2
                },
                zIndex: 100
            });

            google.maps.event.addListener(firstVertexMarker, "click", () => {
                tryFinishPolygon();
            });
        }
    }

    /**
     * Close the polygon if the user has placed enough vertices (at least 3).
     * Fewer vertices is treated as "still drawing"; this lets a stray
     * double-click or first-vertex click early in the draw fall through silently.
     */
    function tryFinishPolygon(): void {
        if (workingVertices.length < 3) {
            return;
        }

        finishPolygon();
    }

    /**
     * Pop the trailing vertex if it is a near-duplicate of the one before it.
     * A double-click delivers two click events at the same position followed by
     * a dblclick; the second click would otherwise leave a redundant vertex at
     * the dblclick site.
     */
    function dedupeTrailingVertex(): void {
        if (workingVertices.length < 2) {
            return;
        }

        const last = workingVertices[workingVertices.length - 1];
        const secondLast = workingVertices[workingVertices.length - 2];

        if (Math.abs(last.lat() - secondLast.lat()) < 0.00001
            && Math.abs(last.lng() - secondLast.lng()) < 0.00001) {
            workingVertices.pop();
            workingPolyline?.setPath(workingVertices);
        }
    }

    /**
     * Build the final editable Polygon from the working vertices and commit it
     * as the current shape.
     */
    function finishPolygon(): void {
        removeMapDrawListeners();
        map?.setOptions({ draggableCursor: null, disableDoubleClickZoom: false });

        const polygon = new google.maps.Polygon({
            paths: workingVertices,
            clickable: true,
            editable: true,
            strokeColor: strokeColor,
            fillColor: fillColor,
            strokeWeight: 2,
            map: map as google.maps.Map
        });

        cleanupWorkingShapes();
        isDrawing.value = false;
        setCurrentShape(polygon);
    }

    /**
     * Commit the single point click as the current shape.
     */
    function finishPoint(latLng: google.maps.LatLng): void {
        removeMapDrawListeners();
        map?.setOptions({ draggableCursor: null });

        const marker = createPointMarker(latLng);
        isDrawing.value = false;
        setCurrentShape(marker);
    }

    /**
     * Cancel an in-progress draw. Used by the active Pan button. Discards any
     * in-progress polyline / vertex marker and returns to idle.
     */
    function cancelDrawing(): void {
        if (!isDrawing.value) {
            return;
        }

        removeMapDrawListeners();
        map?.setOptions({ draggableCursor: null, disableDoubleClickZoom: false });
        cleanupWorkingShapes();
        isDrawing.value = false;
    }

    function removeMapDrawListeners(): void {
        if (mapClickListener) {
            google.maps.event.removeListener(mapClickListener);
            mapClickListener = null;
        }

        if (mapDblclickListener) {
            google.maps.event.removeListener(mapDblclickListener);
            mapDblclickListener = null;
        }

        if (mapMousemoveListener) {
            google.maps.event.removeListener(mapMousemoveListener);
            mapMousemoveListener = null;
        }
    }

    function cleanupWorkingShapes(): void {
        if (workingPolyline) {
            workingPolyline.setMap(null);
            workingPolyline = null;
        }

        if (firstVertexMarker) {
            firstVertexMarker.setMap(null);
            firstVertexMarker = null;
        }

        workingVertices = [];
    }

    /**
     * Build a Marker (or AdvancedMarkerElement wrapper when a mapId is set on
     * the active Map Style). Used by both the pre-loaded value path and the
     * point-mode draw completion.
     */
    function createPointMarker(position: google.maps.LatLng): SelectableShape {
        if (isNullOrWhiteSpace(mapId)) {
            return new google.maps.Marker({
                position: position,
                map: map as google.maps.Map,
                clickable: true,
                icon: marker as google.maps.Symbol
            });
        }
        else {
            // Typed local so TypeScript can bind `this` inside each method
            // to AdvancedMarkerWrapper (rather than the SelectableShape union,
            // whose Polygon branch has no `position` / `map` / `marker_element`).
            const wrapper: AdvancedMarkerWrapper = {
                position: position,
                map: map,
                marker_element: new google.maps.marker.AdvancedMarkerElement({
                    position: position,
                    map: map
                }),
                getPosition: function () {
                    return this.position;
                },
                getPath: function () {
                    return this.position.toUrlValue();
                },
                setPosition: function (position) {
                    this.position = position;
                    this.marker_element.position = position;
                },
                setMap: function (newMap) {
                    this.map = newMap;
                    this.marker_element.map = newMap;
                }
            };
            return wrapper;
        }
    }

    /**
     * Commit a shape (either newly drawn or loaded from a saved value) as the
     * current selection. Wires the standard mutation and click listeners.
     */
    function setCurrentShape(newShape: SelectableShape): void {
        shape = newShape;
        hasShapeOnMap.value = true;
        select(newShape);

        if (drawingMode === "Polygon") {
            const poly = shape as google.maps.Polygon;
            internalValue.value = pathToCoordinates(poly.getPath());

            // add listener for moving polygon points.
            google.maps.event.addListener(poly.getPath(), "set_at", () => {
                updateShape(poly);
            });

            // add listener for adding new points.
            google.maps.event.addListener(poly.getPath(), "insert_at", () => {
                updateShape(poly);
            });

            // Add an event listener to implement right-click to delete node
            google.maps.event.addListener(poly, "rightclick", (ev) => {
                if (ev.vertex != null) {
                    poly.getPath().removeAt(ev.vertex);
                }

                updateShape(poly);
            });

            // add listener for selecting the polygon
            google.maps.event.addListener(poly, "click", () => {
                select(poly);
            });
        }
        else {
            const m = shape as google.maps.Marker;
            const position = m.getPosition();

            if (!position) {
                internalValue.value = [];
            }
            else {
                internalValue.value = [toCoordinate(position)];
            }

            // add listener for re-selecting the marker
            google.maps.event.addListener(m, "click", () => {
                select(m);
            });
        }
    }

    /**
     * When nodes are added/moved/deleted from a polygon, this makes sure the component's value is up-to-date
     */
    function updateShape(updatedShape: google.maps.Polygon): void {
        shape = updatedShape as google.maps.Polygon;

        let path = shape.getPath();

        // if the last vertex has been removed, there's no more shape, so delete it and let us draw a new one.
        if (path.getLength() === 0) {
            deleteSelectedShape(true);
            return;
        }

        const coordinates: Coordinate[] = pathToCoordinates(path);

        internalValue.value = coordinates;
    }

    /**
     * Select the shape for editing/deleting
     */
    function select(s: SelectableShape | null): void {
        if (s == null) {
            return;
        }

        setEditable(true);
        isShapeSelected.value = true;
    }

    /**
     * Unselects the selected shape (if selected) and disables the delete button.
     */
    function deselect(): void {
        setEditable(false);
        isShapeSelected.value = false;
    }

    /**
     * If the current shape is a polygon, make it editable
     */
    function setEditable(isEditable: boolean): void {
        if (shape && drawingMode === "Polygon") {
            (shape as google.maps.Polygon).setEditable(isEditable);
        }
    }

    /**
     * Finds the point/polygon boundary and sets the map viewport to fit
     */
    function fitBounds(map: google.maps.Map): void {
        if (!internalValue.value) {
            // if no path, then set the center using the options
            const newLatLng = new google.maps.LatLng(
                centerLatitude,
                centerLongitude
            );

            map.setCenter(newLatLng);
            return;
        }

        const coords = internalValue.value;

        if (drawingMode === "Point") {
            map.setCenter(new google.maps.LatLng(...coords[0]));
            return;
        }

        // find the most southWest and northEast points of the path.
        for (let i = 0; i < coords.length; i++) {
            const [lat, lng] = coords[i];

            if (minLat == null || lat < minLat) {
                minLat = lat;
            }
            if (maxLat == null || lat > maxLat) {
                maxLat = lat;
            }
            if (minLng == null || lng < minLng) {
                minLng = lng;
            }
            if (maxLng == null || lng > maxLng) {
                maxLng = lng;
            }
        }

        // Set the viewport to contain the given bounds.
        const southWest = new google.maps.LatLng(minLat ?? 0, minLng);
        const northEast = new google.maps.LatLng(maxLat ?? 0, maxLng);
        const bounds = new google.maps.LatLngBounds(southWest, northEast);
        map.fitBounds(bounds);
    }

    /**
     * Delete the selected shape and return to the idle drawing state so the
     * Draw button becomes active again.
     */
    async function deleteSelectedShape(confirmed: boolean = false): Promise<void> {
        if (shape && (confirmed || await confirm("Delete selected shape?"))) {
            deselect();
            shape.setMap(null);
            shape = null;

            hasShapeOnMap.value = false;
            internalValue.value = [];
        }
    }

    /**
     * Takes a Google Polygon path and converts it into a Coordinate array
     */
    function pathToCoordinates(path: google.maps.MVCArray<google.maps.LatLng>): Coordinate[] {
        const coordinates: string[] = [];

        // Iterate over the vertices of the shape's path
        for (let i = 0; i < path.getLength(); i++) {
            const xy = path.getAt(i);
            coordinates[i] = xy.toUrlValue();
        }

        // if the last vertex is not already the first, then add the first vertex to the end of the path.
        if (path.getAt(0).toUrlValue() !== coordinates[coordinates.length - 1]) {
            coordinates.push(path.getAt(0).toUrlValue());
        }

        return coordinates.map(coord => toCoordinate(coord, false));
    }

    // #endregion

    // #region Life Cycle

    /*
     * Load Google Maps and grab data needed from the server
     */
    onBeforeMount(async (): Promise<void> => {
        const googleMapSettings = await loadMapResources({ mapStyleValueGuid: props.mapStyleValueGuid });

        centerLatitude = centerLatitude ?? googleMapSettings.centerLatitude ?? 33.590795;
        centerLongitude = centerLongitude ?? googleMapSettings.centerLongitude ?? -112.126459;
        let geoPickerGoogleMapSettingsBag = googleMapSettings as GeoPickerGoogleMapSettingsBag;

        if (geoPickerGoogleMapSettingsBag) {
            mapId = geoPickerGoogleMapSettingsBag.googleMapId ?? "";
        }

        try {
            styles = JSON.parse(googleMapSettings.mapStyle ?? "");
        }
        catch { /* empty */ }

        fillColor = strokeColor = googleMapSettings.markerColor ? "#" + googleMapSettings.markerColor : "#0088cc";

        isGoogleLoaded.value = true;
    });

    // Mark the component as mounted so we can know when we're ready to initialize
    onMounted((): void => {
        isMounted.value = true;
    });

    // #endregion
</script>

<style>
.gm-container {
    position: relative;
}

.gm-map {
    overflow: hidden;
}

/* Wrapper around the three drawing toolbar buttons. Positioned absolutely
   over the map at top-left, offset past Google's Map / Styled Map toggles.
   We position it ourselves (rather than pushing it into map.controls) so
   the toolbar appears at its final spot on the first paint and is not
   subject to Google's post-idle control-layout pass. */
.gm-tool-bar {
    position: absolute;
    top: 5px;
    left: 220px;
    z-index: 10;
    display: inline-flex;
}

/* Shared chrome for the three on-map drawing toolbar buttons. Sized and shadowed
   to harmonize with Google's Map / Styled Map toggles. */
.gm-tool-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin: 5px 0 0 5px;
    background: white;
    color: #333;
    border: 0;
    border-radius: 2px;
    box-shadow: rgba(0, 0, 0, 0.3) 0 1px 4px -1px;
    cursor: pointer;
    font-size: 16px;
    padding: 0;
    line-height: 0;
}

.gm-tool-button:hover:not(:disabled) {
    background: whitesmoke;
}

.gm-tool-button:disabled {
    color: #aaa;
    cursor: default;
}

/* When a tool is disabled because its mode is currently in use (e.g. the Draw
   button while polygon drawing is in progress), text-info signals "in use".
   The default :disabled color would otherwise force #aaa. */
.gm-tool-button.text-info:disabled {
    color: var(--color-info-strong);
}

/* The X (delete) tool uses the red-brown color from the legacy clear button
   to signal a destructive action. Only when clickable; a disabled X stays #aaa. */
.gm-tool-button:not(:disabled) i.ti-x {
    color: #8c4b4b;
}

.gm-tool-button i.ti {
    line-height: 1;
}

.static-map-size {
    height: 300px;
    width: 500px;
}

.expanded-map-size {
    height: 100%;
    width: 100%;
}
</style>
