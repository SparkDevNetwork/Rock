<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'net472'">8.0</LangVersion>
    <PackageId>RockRMS.Rock.Blocks</PackageId>
    <RockWebPath>..\RockWeb</RockWebPath>
    <CopyToRockWeb>True</CopyToRockWeb>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="DefaultTvApplication.js" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <Compile Remove="Crm\AttributeValues.cs" />
    <Compile Remove="Example\LargeDatasetGrid.cs" />
    <Compile Remove="Example\PersonDetail.cs" />
    <Compile Remove="Example\PersonSecondary.cs" />
    <Compile Remove="Finance\TransactionEntry.cs" />
    <Compile Remove="Security\Login.cs" />
    <Compile Remove="Utility\StarkDetail.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="DefaultTvApplication.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rock.Common\Rock.Common.csproj" />
    <ProjectReference Include="..\Rock.DownhillCss\Rock.DownhillCss.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rock.Enums\Rock.Enums.csproj" />
    <ProjectReference Include="..\Rock.Lava.Shared\Rock.Lava.Shared.csproj" />
    <ProjectReference Include="..\Rock.NCOA\Rock.NCOA.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rock.Rest\Rock.Rest.csproj" />
    <ProjectReference Include="..\Rock.Slingshot\Rock.Slingshot.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rock.Version\Rock.Version.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rock.ViewModels\Rock.ViewModels.csproj" />
    <ProjectReference Include="..\Rock\Rock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rock.Slingshot\Rock.Slingshot.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == '' or '$(TargetFramework)' == 'net472'">
    <Reference Include="Rock.Common.Mobile">
      <HintPath>..\RockWeb\Bin\Rock.Common.Mobile.dll</HintPath>
    </Reference>
    <Reference Include="Slingshot.Core">
      <HintPath>..\libs\Slingshot\net472\Slingshot.Core.dll</HintPath>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Mobile\Connection\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != 'net472'">
    <Reference Include="Slingshot.Core">
      <HintPath>..\libs\Slingshot\net10.0\Slingshot.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>