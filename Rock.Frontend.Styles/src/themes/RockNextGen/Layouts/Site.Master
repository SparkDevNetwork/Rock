<%@ Master Language="C#" AutoEventWireup="true" Inherits="Rock.Web.UI.RockMasterPage" %>
<%@ Import Namespace="System.Web.Optimization" %>
<!DOCTYPE html>

<!--
  _______       _____           _   ____         _______ _             _____ _
 |__   __|     / ____|         | | |  _ \       |__   __| |           / ____| |
    | | ___   | |  __  ___   __| | | |_) | ___     | |  | |__   ___  | |  __| | ___  _ __ _   _
    | |/ _ \  | | |_ |/ _ \ / _` | |  _ < / _ \    | |  | '_ \ / _ \ | | |_ | |/ _ \| '__| | | |
    | | (_) | | |__| | (_) | (_| | | |_) |  __/    | |  | | | |  __/ | |__| | | (_) | |  | |_| |
    |_|\___/   \_____|\___/ \__,_| |____/ \___|    |_|  |_| |_|\___|  \_____|_|\___/|_|   \__, |
                                                                                           __/ |
                                                                                          |___/

We believe in Jesus Christ as our Lord and Savior, the Son of God. We embrace His virgin birth,
sinless life, sacrificial death on the cross for our sins, His resurrection from the dead, and
His promised return. Our faith is steadfast, rooted in the unchanging truth of the Bible, and
through Christ, we find forgiveness, salvation, and the assurance of eternal life.
-->

<script runat="server">

    // keep code below to call base class init method

    /// <summary>
    /// Raises the <see cref="E:System.Web.UI.Control.Init" /> event.
    /// </summary>
    /// <param name="e">An <see cref="T:System.EventArgs" /> object that contains the event data.</param>
    protected override void OnInit( EventArgs e )
    {
        base.OnInit( e );
    }

    protected override void OnPreRender( EventArgs e )
    {
        base.OnPreRender( e );

        var rockPage = this.Page as Rock.Web.UI.RockPage;
        if (rockPage != null)
        {
            var pageCache = Rock.Web.Cache.PageCache.Get( rockPage.PageId );
            if (pageCache != null )
            {
                if (pageCache.PageDisplayTitle == false || string.IsNullOrWhiteSpace( rockPage.PageTitle ) )
                {
                    secPageTitle.Visible = false;
                }
            }
        }
    }
</script>

<html>
<head runat="server">

    <meta charset="utf-8">
    <title></title>

    <script src="<%# System.Web.Optimization.Scripts.Url("~/Scripts/Bundles/RockJQueryLatest") %>"></script>



    <!-- Set the viewport width to device width for mobile -->
	<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">

    <asp:ContentPlaceHolder ID="css" runat="server" />

	<!-- Included CSS Files -->
	<link rel="stylesheet" href="<%# ResolveRockUrl("~~/Styles/theme.css", true) %>"/>

    <script src="<%# ResolveRockUrl("~~/Assets/Scripts/theme.js", true) %>"></script> 

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>
<body runat="server" id="body">
    <form id="form1" runat="server">

        <%--
            app-shell chrome. The visual treatment lives in
            Styles/_app-shell.scss and applies wherever this .app-shell
            structure renders.

            The original shell zone names (Navigation, Header, Login, Footer),
            the feature/main content placeholders, and the #content-wrapper /
            .main-content / #secPageTitle hooks are all preserved so existing page
            block instances and child layouts keep rendering.
        --%>
        <div class="page-wrapper app-shell">

            <%-- Fixed inset sidebar. The App Shell Navigation Obsidian block lives in the
                 Navigation zone; the real header chrome (bookmark + notifications) is pulled
                 into the sidebar header row via the Header zone. --%>
            <aside id="app-shell-sidebar" class="app-shell-sidebar navbar-static-side d-print-none" role="navigation">
                <div class="app-shell-sidebar-actions d-print-none">
                    <Rock:Zone Name="Header" runat="server" />
                </div>
                <Rock:Zone Name="Navigation" CssClass="zone-navigation" runat="server" />

                <%-- Account menu pinned to the bottom of the sidebar. This is the real
                     Login Status block (hosted in the Login zone), styled to match the
                     app-shell footer via _app-shell.scss, rather than being reimplemented
                     inside the navigation block. --%>
                <div class="app-shell-sidebar-footer d-print-none">
                    <Rock:Zone Name="Login" CssClass="zone-login" runat="server" />
                </div>
            </aside>

            <%-- Backdrop shown behind the off-canvas drawer on small screens. --%>
            <div class="app-shell-scrim js-app-shell-scrim" aria-hidden="true"></div>

            <%-- Raised inset card holding the thin header and the page content. --%>
            <main id="content-wrapper" class="app-shell-inset">

                <nav class="app-shell-header rock-top-header d-print-none">
                    <div class="app-shell-breadcrumb">
                        <Rock:PageBreadCrumbs ID="PageBreadCrumbs" runat="server" />
                    </div>

                    <%-- Page Title: hidden in the app-shell header, but kept so the server-side
                         display logic continues to work. --%>
                    <section id="secPageTitle" class="page-title-display" runat="server">
                        <div class="page-title">
                            <h1 class="title"><Rock:PageIcon ID="PageIcon" runat="server" /> <Rock:PageTitle ID="PageTitle" runat="server" /></h1>
                        </div>
                    </section>
                </nav>

                <asp:ContentPlaceHolder ID="feature" runat="server"></asp:ContentPlaceHolder>

                <div class="main-content">
                    <asp:ContentPlaceHolder ID="main" runat="server"></asp:ContentPlaceHolder>

                    <div class="main-footer">
                        <Rock:Zone Name="Footer" runat="server" />
                    </div>
                </div>
            </main>

        </div>

        <%--
            Hidden home for the chrome blocks the App Shell Navigation experiment
            retires (Page Menu, Smart Search). The hotfix migration parks those
            instances into these zones; rendering them here keeps them out of the
            page flow instead of orphaning at the bottom. Reversible via the
            migration's Down(). The Login Status block is NOT parked: it renders in
            the sidebar footer's Login zone above.
        --%>
        <div class="app-shell-parked-zones d-print-none" aria-hidden="true" style="display:none">
            <Rock:Zone Name="app-shell-parked-Navigation" runat="server" />
            <Rock:Zone Name="app-shell-parked-Header" runat="server" />
        </div>

        <%-- controls for scriptmanager and update panel --%>
        <asp:ScriptManager ID="sManager" runat="server"/>
        <asp:UpdateProgress id="updateProgress" runat="server" DisplayAfter="800">
		        <ProgressTemplate>
                <div class="updateprogress-status">
                    <div class="updateprogress-loader">
                        <svg viewBox="0 0 135 140" xmlns="http://www.w3.org/2000/svg" fill="CurrentColor"><rect y="10" width="15" height="120" rx="6"><animate attributeName="height" begin="0.5s" dur="1s" values="120;110;100;90;80;70;60;50;40;140;120" calcMode="linear" repeatCount="indefinite"/><animate attributeName="y" begin="0.5s" dur="1s" values="10;15;20;25;30;35;40;45;50;0;10" calcMode="linear" repeatCount="indefinite"/></rect><rect x="30" y="10" width="15" height="120" rx="6"><animate attributeName="height" begin="0.25s" dur="1s" values="120;110;100;90;80;70;60;50;40;140;120" calcMode="linear" repeatCount="indefinite"/><animate attributeName="y" begin="0.25s" dur="1s" values="10;15;20;25;30;35;40;45;50;0;10" calcMode="linear" repeatCount="indefinite"/></rect><rect x="60" width="15" height="140" rx="6"><animate attributeName="height" begin="0s" dur="1s" values="120;110;100;90;80;70;60;50;40;140;120" calcMode="linear" repeatCount="indefinite"/><animate attributeName="y" begin="0s" dur="1s" values="10;15;20;25;30;35;40;45;50;0;10" calcMode="linear" repeatCount="indefinite"/></rect><rect x="90" y="10" width="15" height="120" rx="6"><animate attributeName="height" begin="0.25s" dur="1s" values="120;110;100;90;80;70;60;50;40;140;120" calcMode="linear" repeatCount="indefinite"/><animate attributeName="y" begin="0.25s" dur="1s" values="10;15;20;25;30;35;40;45;50;0;10" calcMode="linear" repeatCount="indefinite"/></rect><rect x="120" y="10" width="15" height="120" rx="6"><animate attributeName="height" begin="0.5s" dur="1s" values="120;110;100;90;80;70;60;50;40;140;120" calcMode="linear" repeatCount="indefinite"/><animate attributeName="y" begin="0.5s" dur="1s" values="10;15;20;25;30;35;40;45;50;0;10" calcMode="linear" repeatCount="indefinite"/></rect></svg>        
                    </div>
                </div>
                <div class="updateprogress-bg modal-backdrop"></div>
		        </ProgressTemplate>
        </asp:UpdateProgress>
    </form>

    <script>
        Sys.Application.add_load(BindNavEvents);
        Sys.Application.add_load(PreventNumberScroll);
        Sys.Application.add_load(HandleBackForwardCache);
    </script>

</body>
</html>
