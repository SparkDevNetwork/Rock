<Rock:ParentLayout src="~~/Layouts/SiteMaster.lava">
    <!-- Start Content Area -->
    <section id="page-content">
        <!-- Ajax Error -->
        <div class="alert alert-danger ajax-error no-index" style="display:none">
            <p><strong>Error</strong></p>
            <span class="ajax-error-message"></span>
        </div>

        <div class="row">
            <div class="col-md-12">
                <Rock:Zone Name="Feature" runat="server"></Rock:Zone>
            </div>
        </div>

        <div class="row">
            <div class="col-md-9">
                <Rock:Zone Name="Main" runat="server"></Rock:Zone>
            </div>
            <div class="col-md-3">
                <Rock:Zone Name="Sidebar 1" runat="server"></Rock:Zone>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <Rock:Zone Name="Section A" runat="server"></Rock:Zone>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <Rock:Zone Name="Section B" runat="server"></Rock:Zone>
            </div>
            <div class="col-md-4">
                <Rock:Zone Name="Section C" runat="server"></Rock:Zone>
            </div>
            <div class="col-md-4">
                <Rock:Zone Name="Section D" runat="server"></Rock:Zone>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <Rock:Zone Name="Section E" runat="server"></Rock:Zone>
            </div>
            <div class="col-md-6">
                <Rock:Zone Name="Section F" runat="server"></Rock:Zone>
            </div>
        </div>
    </section>
    <!-- End Content Area -->
</Rock:ParentLayout>
