<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RockWebPath>..\RockWeb</RockWebPath>
    <CopyToRockWeb>True</CopyToRockWeb>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="2.16.3" />
    <PackageReference Condition="'$(TargetFramework)' == '' or '$(TargetFramework)' == 'net472'" Include="Microsoft.AspNet.WebApi.Core" Version="5.2.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rock.Common\Rock.Common.csproj" />
    <ProjectReference Include="..\Rock.Enums\Rock.Enums.csproj" />
    <ProjectReference Include="..\Rock.Lava.Shared\Rock.Lava.Shared.csproj" />
    <ProjectReference Include="..\Rock.Rest\Rock.Rest.csproj" />
    <ProjectReference Include="..\Rock.Slingshot.Model\Rock.Slingshot.Model.csproj" />
    <ProjectReference Include="..\Rock\Rock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Condition="'$(TargetFramework)' == '' or '$(TargetFramework)' == 'net472'" Include="Slingshot.Core">
      <HintPath>..\libs\Slingshot\net472\Slingshot.Core.dll</HintPath>
    </Reference>
    <Reference Condition="'$(TargetFramework)' == 'net10.0'" Include="Slingshot.Core">
      <HintPath>..\libs\Slingshot\net10.0\Slingshot.Core.dll</HintPath>
    </Reference>
    <!--<Reference Include="Microsoft.CSharp" />-->
    <Reference Condition="'$(TargetFramework)' == '' or '$(TargetFramework)' == 'net472'" Include="System.IO.Compression" />
    <!--<Reference Include="System.Web" />-->
  </ItemGroup>

</Project>