<template>
    <NotificationBox alertType="warning" heading="Important">
        <p>Enabling this option could result in a large number of people being inactivated in your database. Everyone in your database that does not meet all of the selected criteria below will be inactivated. Unselecting any of the options below, will result in more people being inactivated. Each person that is inactivated will also be inactivated in most of the groups that they belong to as well. This includes the security roles they belong to. Once these people have been inactivated in their groups, there is no process to revert that change.</p>
    </NotificationBox>

    <ContentStack>
        <CheckBox v-model="settings.isEnabled"
                  label="Enable"
                  text="Enable the automatic inactivating of individuals who are currently active and who meet all of the following selected criteria." />
    </ContentStack>

    <fieldset :disabled="!settings.isEnabled">
        <div class="margin-b-lg">
            <NumberBox v-model="settings.recordsOlderThan"
                       label="The number of days that the records must be older to get considered for Inactivate process."
                       inputGroupClasses="input-width-md">
                <template #inputGroupAppend>
                    <span class="input-group-addon">days</span>
                </template>
            </NumberBox>
        </div>

        <div class="d-flex align-items-start margin-b-lg">
            <CheckBox v-model="settings.isNoLastContributionEnabled" label="" class="margin-r-sm" />
            <div class="flex-fill">
                <NumberBox v-model="settings.noLastContributionPeriod"
                           label="No family member has made a contribution in the last"
                           inputGroupClasses="input-width-md">
                    <template #inputGroupAppend>
                        <span class="input-group-addon">days</span>
                    </template>
                </NumberBox>
            </div>
        </div>

        <div class="d-flex align-items-start margin-b-lg">
            <CheckBox v-model="settings.isNoAttendanceInGroupTypeEnabled" label="" class="margin-r-sm" />
            <div class="flex-fill">
                <div class="row">
                    <div class="col-xs-12 col-sm-6">
                        <NumberBox v-model="settings.noAttendanceInGroupTypeDays"
                                   label="No family member has attended any group type that takes attendance in the last"
                                   inputGroupClasses="input-width-md">
                            <template #inputGroupAppend>
                                <span class="input-group-addon">days</span>
                            </template>
                        </NumberBox>
                    </div>
                    <div class="col-xs-12 col-sm-6">
                        <ListBox v-model="attendanceInGroupType"
                                 label="Ignore any attendance in the following group types"
                                 :items="attendanceGroupTypes"
                                 enhanceForLongLists
                                 :key="listBoxKey" />
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-start margin-b-lg">
            <CheckBox v-model="settings.isNotRegisteredInAnyEventEnabled" label="" class="margin-r-sm" />
            <div class="flex-fill">
                <NumberBox v-model="settings.notRegisteredInAnyEventDays"
                           label="No family member has registered for any event in the last"
                           inputGroupClasses="input-width-md">
                    <template #inputGroupAppend>
                        <span class="input-group-addon">days</span>
                    </template>
                </NumberBox>
            </div>
        </div>

        <div class="d-flex align-items-start margin-b-lg">
            <CheckBox v-model="settings.isNoSiteLoginEnabled" label="" class="margin-r-sm" />
            <div class="flex-fill">
                <NumberBox v-model="settings.noSiteLoginPeriod"
                           label="No family member has logged into Rock in the last"
                           inputGroupClasses="input-width-md">
                    <template #inputGroupAppend>
                        <span class="input-group-addon">days</span>
                    </template>
                </NumberBox>
            </div>
        </div>

        <div class="d-flex align-items-start margin-b-lg">
            <CheckBox v-model="settings.isNoPrayerRequestEnabled" label="" class="margin-r-sm" />
            <div class="flex-fill">
                <NumberBox v-model="settings.noPrayerRequestPeriod"
                           label="No family member has submitted a prayer request in the last"
                           inputGroupClasses="input-width-md">
                    <template #inputGroupAppend>
                        <span class="input-group-addon">days</span>
                    </template>
                </NumberBox>
            </div>
        </div>

        <div class="d-flex align-items-start margin-b-lg">
            <CheckBox v-model="settings.isNoPersonAttributesEnabled" label="" class="margin-r-sm" />
            <div class="flex-fill">
                <div class="row">
                    <div class="col-xs-12 col-sm-6">
                        <NumberBox v-model="settings.noPersonAttributesDays"
                                   label="No family member has a person attribute value updated in the last"
                                   inputGroupClasses="input-width-md">
                            <template #inputGroupAppend>
                                <span class="input-group-addon">days</span>
                            </template>
                        </NumberBox>
                    </div>
                    <div class="col-xs-12 col-sm-6">
                        <ListBox v-model="personAttributeValues"
                                 label="Ignore any updates to the following attributes"
                                 :items="personAttributes"
                                 enhanceForLongLists
                                 :key="listBoxKey" />
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-start margin-b-lg">
            <CheckBox v-model="settings.isNoInteractionsEnabled" label="" class="margin-r-sm" />
            <div class="flex-fill">
                <RockLabel>No family member has an interaction of the following type in the last</RockLabel>
                <ConditionalWell>
                    <InteractionChannelList v-model="noInteractions" />
                </ConditionalWell>
            </div>
        </div>

        <div class="d-flex align-items-start margin-b-lg">
            <CheckBox v-model="settings.isNotInDataViewEnabled" label="" class="margin-r-sm" />
            <div class="flex-fill">
                <DataViewPicker v-model="settings.notInDataView"
                                label="The person is not in the following data view"
                                :entityTypeGuid="EntityType.Person" />
            </div>
        </div>
    </fieldset>
</template>

<script setup lang="ts">
    import { computed, nextTick, PropType, ref, watch, WritableComputedRef } from "vue";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import ListBox from "@Obsidian/Controls/listBox.obs";
    import NumberBox from "@Obsidian/Controls/numberBox.obs";
    import RockLabel from "@Obsidian/Controls/rockLabel.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import ConditionalWell from "@Obsidian/Controls/conditionalWell.obs";
    import DataViewPicker from "@Obsidian/Controls/dataViewPicker.obs";
    import InteractionChannelList from "./interactionChannelList.partial.obs";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { InactivatePeopleSettingsBag } from "@Obsidian/ViewModels/Blocks/Administration/DataAutomationSettings/inactivatePeopleSettingsBag";
    import { DataAutomationInteractionItemBag } from "@Obsidian/ViewModels/Blocks/Administration/DataAutomationSettings/dataAutomationInteractionItemBag";

    const props = defineProps({
        settings: {
            type: Object as PropType<InactivatePeopleSettingsBag>,
            required: true
        },

        attendanceGroupTypes: {
            type: Array as PropType<ListItemBag[]>,
            required: true
        },

        personAttributes: {
            type: Array as PropType<ListItemBag[]>,
            required: true
        },

        /** True when this section is expanded and its content is visible. */
        isExpanded: {
            type: Boolean as PropType<boolean>,
            default: false
        }
    });

    // #region Values

    // Bumping this key remounts the enhanced (Chosen) list boxes so jQuery
    // Chosen initializes against a visible element.
    const listBoxKey = ref(0);

    // #endregion Values

    // #region Computed Values

    // ListBox binds to a string array, so bridge the nullable bag properties to
    // always-present arrays.
    const attendanceInGroupType: WritableComputedRef<string[]> = computed({
        get: () => props.settings.attendanceInGroupType ?? [],
        set: (value) => props.settings.attendanceInGroupType = value
    });

    const personAttributeValues: WritableComputedRef<string[]> = computed({
        get: () => props.settings.personAttributes ?? [],
        set: (value) => props.settings.personAttributes = value
    });

    const noInteractions: WritableComputedRef<DataAutomationInteractionItemBag[]> = computed({
        get: () => props.settings.noInteractions ?? [],
        set: (value) => props.settings.noInteractions = value
    });

    // #endregion Computed Values

    // #region Watchers

    // Chosen caches its hidden/disabled state at initialization, so remount the
    // list boxes whenever the section becomes visible or its enabled state
    // changes. This rebuilds Chosen against a shown, correctly-enabled element.
    watch(() => [props.isExpanded, props.settings.isEnabled], () => {
        if (props.isExpanded) {
            nextTick(() => {
                listBoxKey.value++;
            });
        }
    });

    // #endregion Watchers
</script>
