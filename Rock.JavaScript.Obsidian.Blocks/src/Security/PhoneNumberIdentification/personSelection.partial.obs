<template>
    <div>
        <div class="mb-3" v-html="instructions"></div>

        <RockButton v-for="(person, index) in people"
                    :key="person.value ?? index"
                    :btnType="BtnType.Primary"
                    :disabled="isProcessing"
                    :isLoading="isProcessing && selectedValue === person.value"
                    class="btn-lg btn-block mt-3"
                    type="button"
                    @click="onSelect(person.value)">
            {{ person.text }}
        </RockButton>
    </div>
</template>

<script setup lang="ts">
    import { PropType, ref } from "vue";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    defineProps({
        instructions: {
            type: String as PropType<string>,
            default: ""
        },

        people: {
            type: Array as PropType<ListItemBag[]>,
            default: () => []
        },

        isProcessing: {
            type: Boolean as PropType<boolean>,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "select", personValue: string): void
    }>();

    /** The value of the person the individual selected, used to show the spinner on the chosen button only. */
    const selectedValue = ref<string | null>(null);

    function onSelect(personValue: string | null | undefined): void {
        if (personValue) {
            selectedValue.value = personValue;
            emit("select", personValue);
        }
    }
</script>
