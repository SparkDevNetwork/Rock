}

.form-builder-grow :deep(.form-layout-body > .form-template-item-section) > .form-template-section-preview {
    background-color: var(--color-info-strong);
}

.form-builder-grow :deep(.configurable-zone.zone-section:not(.active):hover) > .zone-actions .zone-action:not(:hover),
.form-builder-grow :deep(.configurable-zone.zone-form-header:not(.active):hover) > .zone-actions .zone-action:not(:hover),
.form-builder-grow :deep(.configurable-zone.zone-person-entry:not(.active):hover) > .zone-actions .zone-action:not(:hover),
.form-builder-grow :deep(.configurable-zone.zone-form-footer:not(.active):hover) > .zone-actions .zone-action:not(:hover) {
    color: var(--color-interface-strong);
}

.form-builder-grow :deep(.zone-action) {
    --color-danger: var(--color-danger-strong);
}

.form-builder-grow :deep(.configurable-zone.zone-section.active) > .zone-content-container {
    border-color: var(--color-info-strong);
    border-style: solid;
}

.form-builder-grow :deep(.configurable-zone.zone-section.active) > .zone-actions {
    background-color: var(--color-info-soft);
    border-color: var(--color-info-strong);
}

.form-builder-grow :deep(.configurable-zone.zone-section.active) > .zone-actions .zone-action {
