    margin-top: -9px;
}

.gu-mirror.form-template-item-field .icon.ti-hash + .form-template-range-indicator {
    margin-top: -6px;
}

.gu-mirror.form-template-item-field > .text {
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    margin: 0;
    line-height: 1.15;
}

.gu-mirror.form-template-item-section {
    gap: var(--spacing-xsmall);
    padding: var(--spacing-medium);
    font-size: var(--font-size-xsmall);
    font-weight: var(--font-weight-regular);
    color: var(--color-interface-strong);
}
</style>

<style scoped>
