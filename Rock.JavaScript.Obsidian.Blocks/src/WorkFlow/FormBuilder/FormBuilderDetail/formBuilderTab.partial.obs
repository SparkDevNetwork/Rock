    margin-bottom: var(--spacing-tiny);
}

.gu-mirror.form-template-item-field .icon {
    width: 24px;
    height: 24px;
    margin: 0;
    font-size: 24px;
    line-height: 1;
}

.gu-mirror.form-template-item-field .form-template-range-indicator {
    margin-top: -4px;
    font-size: 14px;
    line-height: 1;
}

