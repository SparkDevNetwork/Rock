    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    gap: var(--spacing-tiny);
    min-height: 88px;
    padding: var(--spacing-medium);
    color: var(--color-info-strong);
    background-color: var(--color-info-soft);
    border: 0;
    box-shadow: none;
    text-align: center;
