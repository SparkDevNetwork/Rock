<template>
    <Panel title="Platform Mobile Application" type="block">
        <template #headerActions>
            <span :class="['label', versionLabelClass]">{{ versionLabelText }}</span>

            <RockButton v-if="buttonText"
                        btnType="primary"
                        btnSize="sm"
                        class="ml-2"
                        :isLoading="isRunning && !isSavingSettings"
                        :disabled="isSavingSettings"
                        loadingText="Running..."
                        @click="onRunClick">
                {{ buttonText }}
            </RockButton>
        </template>

        <NotificationBox v-if="errorMessage" alertType="danger">
            {{ errorMessage }}
        </NotificationBox>

        <NotificationBox v-if="state === PlatformMobileAppBuildState.AheadOfCode" alertType="warning">
            <p><strong>Database is ahead of this Rock</strong></p>
            <p>The platform mobile application is at version {{ stampVersion }}, but this Rock's builder only goes up to {{ currentDefinitionVersion }}. This happens after a Rock downgrade, or when a database from a newer Rock is restored onto an older one. Nothing can run until this Rock is on the version the database came from.</p>
        </NotificationBox>

        <p v-if="state === PlatformMobileAppBuildState.NotBuilt">
            The platform mobile application has not been built in this Rock yet. Build App creates it from the definition that ships with this Rock.
        </p>
        <p v-else-if="state === PlatformMobileAppBuildState.UpdateAvailable">
            This Rock carries a newer definition of the platform mobile application ({{ currentDefinitionVersion }}) than the one installed ({{ stampVersion }}). Update App applies the difference.
        </p>
        <p v-else-if="state === PlatformMobileAppBuildState.Current">
            The platform mobile application is up to date. Repair App puts back anything that was changed outside this panel, and is safe to run at any time.
        </p>

        <div v-if="isSettingsSectionVisible" class="mt-3">
            <h5>Settings</h5>

            <template v-if="!isEditMode">
                <ValueDetailList :modelValue="settingsValues" />

                <RockButton v-if="config.isEditable"
                            btnType="primary"
                            btnSize="sm"
                            :disabled="isRunning"
                            @click="onEditClick">
                    Edit
                </RockButton>
            </template>

            <template v-else>
                <div class="row">
                    <div class="col-md-6">
                        <ImageUploader v-model="editLightLogo"
                                       label="Logo, Light Background"
                                       help="The logo shown inside the app over a light navigation bar. Recommended height of 120px and minimum width of 560px."
                                       :disabled="isRunning" />
                    </div>

                    <div class="col-md-6">
                        <ImageUploader v-model="editDarkLogo"
                                       label="Logo, Dark Background"
                                       help="The logo shown inside the app over a dark navigation bar, in dark mode."
                                       :disabled="isRunning" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <ColorPicker v-model="editColorStrong"
                                     label="Color, Strong"
                                     help="The main shade of the church's color, used for buttons and links. In dark mode the app swaps it with the soft shade."
                                     rules="required"
                                     :disabled="isRunning" />
                    </div>

                    <div class="col-md-6">
                        <ColorPicker v-model="editColorSoft"
                                     label="Color, Soft"
                                     help="A light tint of the church's color, used for backgrounds behind it. It becomes the accent in dark mode."
                                     rules="required"
                                     :disabled="isRunning" />
                    </div>
                </div>

                <DropDownList v-model="editContentCollection"
                              label="Content Collection"
                              help="The collection the app's Content page shows. Choose none to take the Content button off the home page."
                              :items="contentCollectionOptions"
                              :showBlankItem="true"
                              blankValue=""
                              :disabled="isRunning || !contentCollectionOptions.length"
                              style="max-width: 360px;" />

                <p v-if="!contentCollectionOptions.length" class="text-muted">
                    There are no content collections in this Rock yet. Create one under CMS &gt; Content Collections first.
                </p>

                <p class="text-muted">
                    Saving runs the builder right away, so the app is redeployed with the new settings.
                </p>

                <div class="actions">
                    <RockButton btnType="primary"
                                :isLoading="isSavingSettings"
                                loadingText="Saving..."
                                :disabled="isRunning && !isSavingSettings"
                                @click="onSaveSettingsClick">
                        Save
                    </RockButton>

                    <RockButton btnType="link"
                                :disabled="isRunning"
                                @click="onCancelClick">
                        Cancel
                    </RockButton>
                </div>
            </template>
        </div>

        <div v-if="lastRun" class="mt-3">
            <h5>
                Last {{ lastRunModeText }}
                <small v-if="lastRunCompletedText">{{ lastRunCompletedText }}</small>
                <span :class="['label', 'ml-2', lastRun.isSuccess ? 'label-success' : 'label-danger']">{{ lastRun.isSuccess ? "Succeeded" : "Failed" }}</span>
            </h5>

            <p v-if="!hasAnyChanges && lastRun.isSuccess" class="text-muted">
                Nothing needed changing.
            </p>

            <div v-for="version in lastRunVersions" :key="version.version ?? ''" class="mb-2">
                <strong>Version {{ version.version }}</strong>

                <NotificationBox v-if="version.error" alertType="danger" class="mt-1 mb-1">
                    {{ version.error }}
                </NotificationBox>

                <ul v-if="version.created?.length" class="mb-1">
                    <li v-for="item in version.created" :key="'c' + item">Created {{ item }}</li>
                </ul>

                <ul v-if="version.updated?.length" class="mb-1">
                    <li v-for="item in version.updated" :key="'u' + item">Put back {{ item }}</li>
                </ul>
            </div>

            <NotificationBox v-if="lastRun.deployError" alertType="danger">
                <strong>Deploy failed:</strong> {{ lastRun.deployError }}
            </NotificationBox>

            <NotificationBox v-if="lastRun.unexpectedRecords?.length" alertType="warning">
                <p><strong>Unexpected records</strong></p>
                <p>These records are on the platform mobile application but are not part of its definition. They can only have been added outside the supported admin screens. They were left in place.</p>
                <ul class="mb-0">
                    <li v-for="item in lastRun.unexpectedRecords" :key="item">{{ item }}</li>
                </ul>
            </NotificationBox>
        </div>
    </Panel>
</template>

<script setup lang="ts">
    import ColorPicker from "@Obsidian/Controls/colorPicker.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import ImageUploader from "@Obsidian/Controls/imageUploader.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import ValueDetailList from "@Obsidian/Controls/valueDetailList.obs";
    import { ValueDetailListItemBuilder } from "@Obsidian/Core/Controls/valueDetailListItemBuilder";
    import { ValueDetailListItem } from "@Obsidian/Types/Controls/valueDetailListItem";
    import { PlatformMobileAppBuildState } from "@Obsidian/Enums/Mobile/platformMobileAppBuildState";
    import { PlatformMobileAppRunModeDescription } from "@Obsidian/Enums/Mobile/platformMobileAppRunMode";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { RockDateTime } from "@Obsidian/Utility/rockDateTime";
    import { PlatformMobileAppDetailInitializationBag } from "@Obsidian/ViewModels/Blocks/Mobile/PlatformMobileAppDetail/platformMobileAppDetailInitializationBag";
    import { PlatformMobileAppRunReportBag } from "@Obsidian/ViewModels/Blocks/Mobile/PlatformMobileAppDetail/platformMobileAppRunReportBag";
    import { PlatformMobileAppSettingsBag } from "@Obsidian/ViewModels/Blocks/Mobile/PlatformMobileAppDetail/platformMobileAppSettingsBag";
    import { PlatformMobileAppVersionReportBag } from "@Obsidian/ViewModels/Blocks/Mobile/PlatformMobileAppDetail/platformMobileAppVersionReportBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { areEqual, toGuidOrNull } from "@Obsidian/Utility/guid";
    import { escapeHtml } from "@Obsidian/Utility/stringUtils";
    import { computed, ref } from "vue";

    const config = useConfigurationValues<PlatformMobileAppDetailInitializationBag>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const state = ref<PlatformMobileAppBuildState>(config.state);
    const stampVersion = ref(config.stampVersion ?? null);
    const currentDefinitionVersion = ref(config.currentDefinitionVersion ?? null);
    const lastRun = ref<PlatformMobileAppRunReportBag | null>(config.lastRun ?? null);
    const isRunning = ref(false);
    const isSavingSettings = ref(false);
    const isEditMode = ref(false);
    const errorMessage = ref("");
    const contentCollectionOptions = ref<ListItemBag[]>(config.contentCollectionOptions ?? []);
    const settings = ref<PlatformMobileAppSettingsBag | null>(config.settings ?? null);

    /** The content collection being edited, as the dropdown's string value. */
    const editContentCollection = ref("");
    const editLightLogo = ref<ListItemBag | undefined>(undefined);
    const editDarkLogo = ref<ListItemBag | undefined>(undefined);
    const editColorStrong = ref("");
    const editColorSoft = ref("");

    // #endregion Values

    // #region Computed Values

    /** The label on the one builder button, or null when no action is offered. */
    const buttonText = computed((): string | null => {
        if (!config.isEditable) {
            return null;
        }

        switch (state.value) {
            case PlatformMobileAppBuildState.NotBuilt:
                return "Build App";

            case PlatformMobileAppBuildState.UpdateAvailable:
                return "Update App";

            case PlatformMobileAppBuildState.Current:
                return "Repair App";

            default:
                return null;
        }
    });

    const versionLabelText = computed((): string => {
        switch (state.value) {
            case PlatformMobileAppBuildState.NotBuilt:
                return "Not Built";

            case PlatformMobileAppBuildState.UpdateAvailable:
                return `Version ${stampVersion.value}, Update Available`;

            case PlatformMobileAppBuildState.AheadOfCode:
                return `Version ${stampVersion.value}, Ahead Of Rock`;

            default:
                return `Version ${stampVersion.value}`;
        }
    });

    const versionLabelClass = computed((): string => {
        switch (state.value) {
            case PlatformMobileAppBuildState.UpdateAvailable:
                return "label-info";

            case PlatformMobileAppBuildState.AheadOfCode:
                return "label-warning";

            default:
                return "label-default";
        }
    });

    const lastRunModeText = computed((): string => {
        return lastRun.value ? PlatformMobileAppRunModeDescription[lastRun.value.mode] : "";
    });

    const lastRunCompletedText = computed((): string => {
        const value = lastRun.value?.completedDateTime ?? lastRun.value?.startedDateTime;

        return value ? RockDateTime.parseISO(value)?.toASPString("g") ?? "" : "";
    });

    const lastRunVersions = computed((): PlatformMobileAppVersionReportBag[] => {
        return lastRun.value?.versions ?? [];
    });

    /** The settings live on the platform Site, so they are only offered once the app exists and can run. */
    const isSettingsSectionVisible = computed((): boolean => {
        return !!settings.value
            && (state.value === PlatformMobileAppBuildState.Current
                || state.value === PlatformMobileAppBuildState.UpdateAvailable);
    });

    /** The saved settings, shown read only until Edit is clicked. */
    const settingsValues = computed((): ValueDetailListItem[] => {
        const valueBuilder = new ValueDetailListItemBuilder();
        const collectionGuid = settings.value?.contentCollectionGuid;
        const collection = contentCollectionOptions.value.find(o => areEqual(o.value, collectionGuid));

        addLogoValue(valueBuilder, "Logo, Light Background", settings.value?.lightLogo);
        addLogoValue(valueBuilder, "Logo, Dark Background", settings.value?.darkLogo);
        addColorValue(valueBuilder, "Color, Strong", settings.value?.colorStrong);
        addColorValue(valueBuilder, "Color, Soft", settings.value?.colorSoft);
        valueBuilder.addTextValue("Content Collection", collection?.text ?? "Not set. The app shows no Content page until one is picked.");

        return valueBuilder.build();
    });

    const hasAnyChanges = computed((): boolean => {
        return lastRunVersions.value.some(v => (v.created?.length ?? 0) > 0 || (v.updated?.length ?? 0) > 0);
    });

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Runs the builder. Build, Update and Repair are all safe to repeat, so there is no
     * confirmation step.
     */
    async function onRunClick(): Promise<void> {
        errorMessage.value = "";
        isRunning.value = true;

        try {
            const result = await invokeBlockAction<PlatformMobileAppDetailInitializationBag>("Run");

            if (result.isSuccess && result.data) {
                applyBag(result.data);
            }
            else {
                errorMessage.value = result.errorMessage ?? "Unable to run the builder.";
            }
        }
        finally {
            isRunning.value = false;
        }
    }

    /** Switches the settings to edit mode, starting from what is saved. */
    function onEditClick(): void {
        errorMessage.value = "";
        editContentCollection.value = settings.value?.contentCollectionGuid ?? "";
        editLightLogo.value = settings.value?.lightLogo ?? undefined;
        editDarkLogo.value = settings.value?.darkLogo ?? undefined;
        editColorStrong.value = settings.value?.colorStrong ?? "";
        editColorSoft.value = settings.value?.colorSoft ?? "";
        isEditMode.value = true;
    }

    /** Leaves edit mode without saving. */
    function onCancelClick(): void {
        isEditMode.value = false;
    }

    /**
     * Saves every setting at once. The server runs the builder right after, so the
     * button shows as saving for the whole of it and the app is deployed only once.
     */
    async function onSaveSettingsClick(): Promise<void> {
        errorMessage.value = "";
        isRunning.value = true;
        isSavingSettings.value = true;

        const bag: PlatformMobileAppSettingsBag = {
            contentCollectionGuid: toGuidOrNull(editContentCollection.value),
            lightLogo: editLightLogo.value ?? null,
            darkLogo: editDarkLogo.value ?? null,
            colorStrong: editColorStrong.value,
            colorSoft: editColorSoft.value
        };

        try {
            const result = await invokeBlockAction<PlatformMobileAppDetailInitializationBag>("SaveSettings", { bag });

            if (result.isSuccess && result.data) {
                applyBag(result.data);
                isEditMode.value = false;
            }
            else {
                errorMessage.value = result.errorMessage ?? "Unable to save the settings.";
            }
        }
        finally {
            isRunning.value = false;
            isSavingSettings.value = false;
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Adds a logo to the view mode list as a small preview, or says it is not set.
     *
     * @param valueBuilder The list being built.
     * @param title The label.
     * @param logo The uploaded logo, if any.
     */
    function addLogoValue(valueBuilder: ValueDetailListItemBuilder, title: string, logo: ListItemBag | null | undefined): void {
        const guid = toGuidOrNull(logo?.value);

        if (!guid) {
            valueBuilder.addTextValue(title, "Not set");
            return;
        }

        valueBuilder.addHtmlValue(title, `<img src="/GetImage.ashx?guid=${guid}&maxHeight=60" alt="${escapeHtml(logo?.text ?? "")}" style="max-height: 60px;" />`);
    }

    /**
     * Adds a color to the view mode list as a swatch beside its value.
     *
     * @param valueBuilder The list being built.
     * @param title The label.
     * @param color The color value, if any.
     */
    function addColorValue(valueBuilder: ValueDetailListItemBuilder, title: string, color: string | null | undefined): void {
        if (!color) {
            valueBuilder.addTextValue(title, "Not set");
            return;
        }

        // Only a plain color value goes into the style attribute; anything else shows as text.
        const isPlainColor = /^[#a-zA-Z0-9(),.%\s]+$/.test(color);

        if (!isPlainColor) {
            valueBuilder.addTextValue(title, color);
            return;
        }

        const safeColor = escapeHtml(color);

        valueBuilder.addHtmlValue(title, `<span style="display: inline-block; width: 16px; height: 16px; border-radius: 4px; vertical-align: middle; border: 1px solid rgba(0, 0, 0, 0.15); background: ${safeColor};"></span> ${safeColor}`);
    }

    /**
     * Shows the state the server returned after a run.
     *
     * @param bag The refreshed initialization bag.
     */
    function applyBag(bag: PlatformMobileAppDetailInitializationBag): void {
        state.value = bag.state;
        stampVersion.value = bag.stampVersion ?? null;
        currentDefinitionVersion.value = bag.currentDefinitionVersion ?? null;
        lastRun.value = bag.lastRun ?? null;
        contentCollectionOptions.value = bag.contentCollectionOptions ?? [];
        settings.value = bag.settings ?? null;
    }

    // #endregion Functions
</script>
