<template>
    <ContentSectionWrapper :sidebar="false">
        <ContentSection light>
            <ContentStack>
                <div class="row">
                    <div class="col-md-6">
                        <TextBox v-model="editFunctionName"
                                 label="Name"
                                 :rules="['required', validateFunctionName]" />
                    </div>
                </div>

                <TextBox v-model="editFunctionDescription"
                         label="Description"
                         rules="required"
                         textMode="multiline" />
            </ContentStack>
        </ContentSection>

        <ContentSection title="Configuration"
                        icon="ti ti-settings">
            <ContentStack>
                <div class="row">
                    <div class="col-md-6">
                        <DropDownList v-model="editFunctionType"
                                      label="Type"
                                      :items="editFunctionTypeItems"
                                      rules="required" />
                    </div>
                </div>

                <TextBox v-model="editFunctionPreamble"
                         label="Preamble" />

                <div v-if="editFunctionType === FunctionType.AIPrompt.toString()"
                     class="row">
                    <div class="col-md-4">
                        <NumberBox v-model="editFunctionTemperature"
                                   label="Temperature"
                                   help="The temperature to use when generating the response. A higher value will produce more random results."
                                   rules="required"
                                   :minimumValue="0" />
                    </div>

                    <div class="col-md-4">
                        <NumberBox v-model="editFunctionMaxTokens"
                                   label="Max Tokens"
                                   help="The maximum number of tokens to generate in the response."
                                   :minimumValue="1" />
                    </div>

                    <div class="col-md-4">
                        <CheckBox v-model="editFunctionPreRenderLava"
                                  label="Pre-render Lava"
                                  help="Turning this on will render Lava over the prompt before it is processed by the language model." />
                    </div>
                </div>

                <CodeEditor v-model="editFunctionPrompt"
                            label="Prompt"
                            editor="monaco"
                            :mode="editFunctionPromptMode"
                            :maxEditorHeight="400"
                            rules="required" />
            </ContentStack>
        </ContentSection>

        <ContentSection title="Instructions"
                        icon="ti ti-info-circle"
                        overflowText="Help">
            <ContentStack>
                <InstructionList v-model="editFunctionInstructions" />
            </ContentStack>

            <template #overflow>
                <p>
                    Instructions are used to provide additional context to the
                    language model about how to use this tool.
                </p>

                <ul>
                    <li>Purpose - Describes the basic purpose of the tool.</li>
                    <li>Usage - Provides details on usage instructions for the tool.</li>
                    <li>Guardrail - Provides instructions around how to safely call the tool (like warnings that data will be updated or deleted.)</li>
                    <li>Prerequisite - Describes steps that should be completed before calling this step.</li>
                    <li>Example - Provides an example of usage for the orchestrator.</li>
                    <li>Returns - Provides information about what the tool will return after it is called.</li>
                </ul>
            </template>
        </ContentSection>

        <ContentSection v-if="editFunctionType === FunctionType.ExecuteLava.toString()"
                        title="Parameters"
                        icon="ti ti-adjustments-cog">
            <ContentStack>
                <RockLabel help="The parameters that will be passed to your Lava as merge fields. These are used by the language model to understand what data is passed in, but it is not guaranteed to perfectly honor what is defined here.">
                    Parameter List
                </RockLabel>

                <div class="control-wrapper">
                    <ParameterList v-model="editFunctionPromptParameters" />
                </div>
            </ContentStack>
        </ContentSection>
    </ContentSectionWrapper>
</template>

<script setup lang="ts">
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import CodeEditor from "@Obsidian/Controls/codeEditor.obs";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    import ContentSectionWrapper from "@Obsidian/Controls/contentSectionWrapper.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import InstructionList from "./instructionList.partial.obs";
    import NumberBox from "@Obsidian/Controls/numberBox.obs";
    import ParameterList from "./parameterList.partial.obs";
    import RockLabel from "@Obsidian/Controls/rockLabel.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import { computed, PropType, ref, watch } from "vue";
    import { AugmentedParameterSchemaBag, InstructionItem, InstructionTypes } from "./types.partial";
    import { enumToListItemBag } from "@Obsidian/Utility/enumUtils";
    import { FunctionType, FunctionTypeDescription } from "@Obsidian/Enums/AI/Agent/functionType";
    import { AISkillFunctionBag } from "@Obsidian/ViewModels/Blocks/AI/AISkillFunctionList/aiSkillFunctionBag";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { toNumber } from "@Obsidian/Utility/numberUtils";
    import { updateRefValue } from "@Obsidian/Utility/component";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<AISkillFunctionBag>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: AISkillFunctionBag): void;
    }>();

    // #region Values

    const editFunctionName = ref("");
    const editFunctionType = ref("");
    const editFunctionDescription = ref("");
    const editFunctionPreamble = ref("");
    const editFunctionInstructions = ref<InstructionItem[]>([]);
    const editFunctionPreRenderLava = ref(false);
    const editFunctionTemperature = ref(0.7);
    const editFunctionMaxTokens = ref<number>();
    const editFunctionPrompt = ref("");
    const editFunctionPromptParameters = ref<AugmentedParameterSchemaBag[]>([]);

    // They are not allowed to set a function type to C# code.
    const editFunctionTypeItems = enumToListItemBag(FunctionTypeDescription)
        .filter(i => i.value !== FunctionType.ExecuteCode.toString());

    // #endregion

    // #region Computed Values

    const editFunctionPromptMode = computed((): "text" | "lava" => {
        if (editFunctionType.value === FunctionType.ExecuteLava.toString()) {
            return "lava";
        }

        return editFunctionType.value === FunctionType.AIPrompt.toString()
            && editFunctionPreRenderLava.value ? "lava" : "text";
    });

    // #endregion

    // #region Functions

    /**
     * Validates the function name to ensure it only contains valid characters.
     *
     * @param value The value to validate.
     *
     * @returns A string with an error message if the value is invalid, or true if the value is valid.
     */
    function validateFunctionName(value: unknown): string | true {
        if (typeof value !== "string") {
            return true;
        }

        if (value.match(/[^a-zA-Z0-9_ ]/)) {
            return "may only contain letters, numbers, underscores and spaces.";
        }

        return true;
    }

    // #endregion

    watch(() => props.modelValue, () => {
        updateRefValue(editFunctionName, props.modelValue.name ?? "");
        updateRefValue(editFunctionType, props.modelValue.functionType.toString());
        updateRefValue(editFunctionDescription, props.modelValue.description ?? "");
        updateRefValue(editFunctionPreamble, props.modelValue.preamble ?? "");
        updateRefValue(editFunctionInstructions, props.modelValue.instructions
            ?.map(h => ({ id: h.category || newGuid(), type: h.text as InstructionTypes, text: h.value ?? "" }))
            ?? []);
        updateRefValue(editFunctionPreRenderLava, props.modelValue.preRenderLava);
        updateRefValue(editFunctionTemperature, props.modelValue.temperature);
        updateRefValue(editFunctionMaxTokens, props.modelValue.maxTokens ?? undefined);
        updateRefValue(editFunctionPrompt, props.modelValue.prompt ?? "");
        updateRefValue(editFunctionPromptParameters, props.modelValue.promptParameters
            ?.map(p => ({ id: newGuid(), ...p }))
            ?? []);
    }, { immediate: true });

    watch([editFunctionName, editFunctionType, editFunctionDescription, editFunctionPreamble, editFunctionInstructions, editFunctionPreRenderLava, editFunctionTemperature, editFunctionMaxTokens, editFunctionPrompt, editFunctionPromptParameters], () => {
        emit("update:modelValue", {
            name: editFunctionName.value,
            functionType: <FunctionType>toNumber(editFunctionType.value),
            description: editFunctionDescription.value,
            instructions: editFunctionInstructions.value.map(h => ({ text: h.type, value: h.text, category: h.id })),
            preamble: editFunctionPreamble.value,
            preRenderLava: editFunctionPreRenderLava.value,
            temperature: editFunctionTemperature.value,
            maxTokens: editFunctionMaxTokens.value,
            prompt: editFunctionPrompt.value,
            promptParameters: editFunctionPromptParameters.value
        });
    });
</script>
