<template>
    <div class="sessions-container" ref="sessionsContainer">
        <div v-for="session in sessions"
             :key="session.idKey!"
             class="session"
             :class="{ 'active': session.idKey === sessionIdKey }"
             @click="onSelectSession(session.idKey!)">
            <div class="session-item">
                <div class="session-title">
                    <div class="session-name">{{ session.name || "Unnamed Session" }}</div>
                    <RockButton v-if="sessions.length > 1"
                                class="btn btn-xs btn-square btn-danger session-delete"
                                @click.stop="onDeleteSession(session)">
                        <i class="ti ti-x"></i>
                    </RockButton>
                </div>
                <div class="session-date">
                        {{ RockDateTime.parseISO(session.lastMessageDateTime!)?.localDateTime.toASPString("g") }}
                    </div>
            </div>
        </div>
    </div>
</template>

<script setup lang="ts">
    import { PropType } from "vue";
    import { ChatSessionBag } from "./types";
    import { RockDateTime } from "@Obsidian/Utility/rockDateTime";
    import RockButton from "@Obsidian/Controls/rockButton.obs";

    defineProps({
        sessions: {
            type: Array as PropType<ChatSessionBag[]>,
            required: true
        },

        sessionIdKey: {
            type: String as PropType<string>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "selectSession", sessionIdKey: string): void;
        (e: "deleteSession", session: ChatSessionBag): void;
    }>();

    function onSelectSession(sessionIdKey: string): void {
        emit("selectSession", sessionIdKey);
    }

    function onDeleteSession(session: ChatSessionBag): void {
        emit("deleteSession", session);
    }
</script>
