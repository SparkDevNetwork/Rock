<template>
    <TabbedModal v-model="isModelVisible"
                 v-model:selectedTab="messageDebugTab"
                 :tabs="tabs"
                 modalContentClasses="chat-bot-debug-modal"
                 title="Message Debug Information"
                 cancelText="Close">
        <template #tabpane="{ item }">
            <div v-if="item === 'Tool Calls'" class="message-debug-tool-calls">
                <div v-if="getDebugToolCalls(debugMessage).length === 0" class="text-muted">
                    No tool calls for this request.
                </div>

                <Panel v-for="func in getDebugToolCalls(debugMessage)"
                       :title="func.name"
                       :key="func.name"
                       hasCollapse>
                    <template #headerActions>
                        <div class="label-group">
                            <span v-if="!func.error" class="label label-success">Success</span>
                            <span v-else class="label label-danger">Failed</span>
                            <span class="label label-info">{{ func.duration }}</span>
                        </div>
                    </template>

                    <div class="tool-args">
                        <h4>Arguments</h4>
                        <pre v-html="highlightJavaScript(func.args)"></pre>
                    </div>

                    <div v-if="!func.error" class="tool-result">
                        <h4>Result</h4>
                        <pre v-html="highlightJavaScript(func.result)"></pre>
                    </div>

                    <div v-if="func.error" class="tool-error">
                        <h4>Error</h4>
                        <div>{{ func.error }}</div>
                    </div>
                </Panel>
            </div>

            <div v-else-if="item === 'Logs'" class="message-debug-log">
                <pre v-html="getDebugLogText(debugMessage)"></pre>
            </div>
        </template>
    </TabbedModal>
</template>

<script setup lang="ts">
    import HighlightJs from "@Obsidian/Libs/highlightJs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import TabbedModal from "@Obsidian/Controls/tabbedModal.obs";
    import { getDebugLogText, getDebugToolCalls } from "./tools.partial";
    import { ExtendedChatMessageBag } from "./types";
    import { PropType, ref, watch } from "vue";
    import { escapeHtml } from "@Obsidian/Utility/stringUtils";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";

    const props = defineProps({
        modelValue: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        debugMessage: {
            type: Object as PropType<ExtendedChatMessageBag | null>,
            required: true
        },
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: boolean): void;
    }>();

    const isModelVisible = useVModelPassthrough(props, "modelValue", emit);

    // The tab array is declared outside the template so its reference stays stable
    // and the tabbed content doesn't reset itself on every render.
    const tabs = ["Tool Calls", "Logs"];

    const messageDebugTab = ref<string>(tabs[0]);

    function highlightJavaScript(code: string): string {
        try {
            var jsonObject = JSON.parse(code);

            return HighlightJs.highlight(JSON.stringify(jsonObject, null, 2), {
                language: "json"
            })?.value ?? escapeHtml(code);
        }
        catch {
            return escapeHtml(code);
        }
    }

    watch(isModelVisible, () => {
        if (isModelVisible.value) {
            messageDebugTab.value = tabs[0];
        }
    });
</script>
