<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <ContentSectionContainer>
        <ContentSection light>
            <div class="basic-fields">
                <div class="row">
                    <div class="col-md-6">
                        <TextBox v-model="name" label="Name" rules="required" />
                    </div>

                    <div class="col-md-6">
                        <IconPicker v-model="iconCssClass" label="Icon" />
                    </div>
                </div>

                <TextBox v-model="description" label="Description" textMode="multiline" />
            </div>
        </ContentSection>

        <ContentSection title="General" icon="ti ti-settings" :order="1">
            <ContentStack title="Check-in Type Flow"
                          description="Control how the screen should flow depending on if a family or an individual is checking in. A family check-in type will give additional settings for the flow.">
                <RadioButtonList v-model="checkInType"
                                 label="Check-in Type"
                                 help="The type of check-in experience to use for this type. Family check-in allows more than one person in the family to be checked in at a time."
                                 :items="checkInTypeItems" />

                <ConditionalWell v-if="isFamilyCheckIn">
                    <RadioButtonList v-model="autoSelectOptions"
                                     label="Family Member Auto-Select Mode"
                                     help='The options that should be pre-selected if a family member has previously checked in. "People Only" will only select the person and then require you to select the placement options. "People & Their Area/Group/Location" will automatically pre-select all placement options.'
                                     :items="autoSelectOptionsItems" />

                    <NumberBox v-model="autoSelectDaysBack"
                               label="Days Back for Auto-Selecting Family Members"
                               help="The number of days back to look for a previous check-in for each person in the family (or related person). If they have previously checked within this number of days, they will automatically be selected during the Family check-in process."
                               inputGroupClasses="input-width-md"
                               :minimumValue="0">
                        <template #inputGroupAppend>
                            <span class="input-group-addon">Days</span>
                        </template>
                    </NumberBox>

                    <InlineCheckBox v-model="useSameOptions"
                                    label="Reuse Selections for Additional Service Times"
                                    help="When a family member is checking in to multiple services, reuse their first service's selections (area, group, location) for each additional service." />

                    <InlineCheckBox v-model="preventDuplicateCheckin"
                                    label="Prevent Duplicate Check-in"
                                    help="Should people be prevented from checking in to a specific service time (schedule) more than once?" />
                </ConditionalWell>
            </ContentStack>

            <ContentStack title="Kiosk Features"
                          description="These settings control the basic kiosk features for check-in and check-out.">
                <InlineCheckBox v-model="allowCheckoutAtKiosk"
                                label="Enable Self Check-out at Kiosk"
                                help="Allows individuals to check out using the kiosks." />

                <InlineCheckBox v-model="enableRemoveFamilyKiosk"
                                label="Allow Removing Guests from Family"
                                help='Only supported in next-gen check-in. Allows individuals to remove guests from their family at the kiosk without supervisor approval. A guest is a non-family member connected by a relationship. This will remove all relationships that are marked as "Can Check-in".'
                                trailblazerField />

                <InlineCheckBox v-model="enablePresence"
                                label="Enable Presence Confirmation"
                                help='When enabled, the attendance record will not be marked as being "present" until the individual is set to "Present" by the assistant using the Check-in Manager application.'
                                trailblazerField />
            </ContentStack>

            <ContentStack title="Display"
                          description="Set what kind of content to display during check-in.">
                <DropDownList v-model="promotionsContentChannelGuid"
                              label="Promotions Content Channel"
                              help="The content channel to use for displaying promotions on the kiosk welcome screen. Only supported by next-gen check-in."
                              :items="promotionsContentChannelItems"
                              trailblazerField />

                <InlineCheckBox v-model="hidePhotos"
                                label="Hide Individual Photos"
                                help="Select this option if photos should not be displayed when selecting people from the family during check-in." />

                <InlineCheckBox v-model="displayLocationCount"
                                label="Display Location Occupancy Count"
                                help="Should the room location selection buttons include a count of how many people are currently checked in to that location?"
                                trailblazerField />

                <DropDownList v-model="achievementTypes"
                              label="Celebration Achievement Types"
                              help="Select achievement types that will be used for check-in celebrations."
                              :items="achievementTypeItems"
                              multiple
                              trailblazerField />
            </ContentStack>
        </ContentSection>

        <ContentSection title="Supervising Check-in" icon="ti ti-tool" :order="2" :isCollapsed="true">
            <ContentStack title="Supervision Capabilities"
                          description="Configure the capabilities for check-in that supervisors and check-in managers have access to.">
                <InlineCheckBox v-model="enableManager"
                                label="Enable Supervisor Mode"
                                help="Show an option on the check-in welcome screen that allows an individual to view the supervision screen (after entering a passcode)." />

                <ConditionalWell v-if="enableManager">
                    <InlineCheckBox v-model="enableOverride"
                                    label="Enable Supervisor Override"
                                    help="Show an option on the check-in supervisor screen that allows a supervisor to check-in a person and ignore any specific group requirements, such as age and grade." />
                </ConditionalWell>

                <InlineCheckBox v-model="allowCheckoutInManager"
                                label="Enable Check-out in Manager"
                                help="Allows check-out to be enabled in the Check-in Manager." />
            </ContentStack>
        </ContentSection>

        <ContentSection title="Search & Security Codes" icon="ti ti-list-search" :order="3" :isCollapsed="true">
            <ContentStack title="Search"
                          description="Configure how people are searched and matched during the check-in process.">
                <RadioButtonList v-model="searchType"
                                 label="Search Type"
                                 help="The type of search that is available after the person clicks the check-in button on the check-in Welcome screen. Note, the individual can also always check-in using a scanned barcode, fingerprint, RFID card, etc. if the scanner is attached and configured for keyboard wedge mode."
                                 :items="searchTypeItems" />

                <ConditionalWell v-if="isPhoneBasedSearch">
                    <NumberBox v-model="minPhoneLength"
                               label="Phone Number Minimum Length"
                               help="The minimum number of digits that needs to be entered for a phone number search (default is 4)."
                               inputClasses="input-width-md"
                               :minimumValue="1"
                               :maximumValue="10" />

                    <NumberBox v-model="maxPhoneLength"
                               label="Phone Number Maximum Length"
                               help="The maximum number of digits that can be entered for a phone number search (default is 10)."
                               inputClasses="input-width-md"
                               :minimumValue="1"
                               :maximumValue="10" />

                    <RadioButtonList v-model="phoneSearchType"
                                     label="Phone Number Comparison Method"
                                     help="Determines how an individual's phone number is matched against the digits they enter during check-in."
                                     :items="phoneSearchTypeItems"
                                     trailblazerField />
                </ConditionalWell>

                <NumberBox v-model="maxResults"
                           label="Maximum Number of Results"
                           help="The maximum number of search results to return when searching for families (default is 100)."
                           inputClasses="input-width-md"
                           :minimumValue="0"
                           trailblazerField />

                <TextBox v-model="searchRegex"
                         label="Regular Expression Filter"
                         help="An optional regular expression that will be run against any search input before the search is performed. This is useful for removing any special characters."
                         inputClasses="input-width-xxl"
                         trailblazerField />
            </ContentStack>

            <ContentStack title="Security Codes"
                          description="Configure the length and format of security codes printed on labels. Rock will generate alpha-numeric characters first, followed by alphabetic, then numeric codes. The length of the code will be the sum of all three character counts. Note: A 3-character alpha-numeric setting provides 13,744 unique codes per day. Larger churches should consider using at least 4 characters to avoid duplicates.">
                <NumberBox v-model="codeAlphaNumericLength"
                           label="Alpha-Numeric Characters"
                           help="The number of alpha-numeric characters to include. This includes most uppercase letters and numbers, but some are intentionally excluded for clarity and security."
                           inputClasses="input-width-md"
                           :minimumValue="0"
                           :maximumValue="10" />

                <NumberBox v-model="codeAlphaLength"
                           label="Alpha Characters"
                           help="The number of alpha characters to include. This includes most uppercase letters, but some are intentionally excluded for clarity and security."
                           inputClasses="input-width-md"
                           :minimumValue="0"
                           :maximumValue="10"
                           trailblazerField />

                <NumberBox v-model="codeNumericLength"
                           label="Numeric Characters"
                           help="The number of numeric characters to include. This includes most numbers, but some are intentionally excluded for clarity and security."
                           inputClasses="input-width-md"
                           :minimumValue="0"
                           :maximumValue="10"
                           trailblazerField />

                <InlineCheckBox v-model="codeRandom"
                                label="Random Numeric Values"
                                help="Should the numbers be randomized (vs. generated in order)." />

                <InlineCheckBox v-model="useSameCodeForFamily"
                                label="Use Same Code for Family"
                                help="Use the same security code for everyone being checked in together. Only applies when checking in multiple people at the same time, such as during family check-in." />
            </ContentStack>
        </ContentSection>

        <ContentSection title="Check-in Registration" icon="ti ti-forms" :order="4" :isCollapsed="true">
            <ContentStack title="General Registration Settings"
                          description="Configure general features and default settings for new individuals.">
                <DefinedValuePicker v-model="defaultPersonConnectionStatus"
                                    label="Default Person Connection Status"
                                    help="When adding a new person, this will be the connection status they are created with."
                                    :definedTypeGuid="DefinedType.PersonConnectionStatus"
                                    showBlankItem />

                <DefinedValuePicker v-model="defaultPersonRecordSource"
                                    label="Default Person Record Source"
                                    help="The record source to use when creating a new person (default = 'Check-in'). If a 'RecordSource' page parameter is found, it will be used instead."
                                    :definedTypeGuid="DefinedType.RecordSourceType" />

                <InlineCheckBox v-model="enableCheckInAfterRegistration"
                                label="Enable Check-in After Registration"
                                help="This determines if the family should continue on the check-in path after being registered, or if they should be directed to a different kiosk after registration (take them back to search)." />

                <InlineCheckBox v-model="displaySmsEnabled"
                                label="Display SMS Option for Phone Numbers"
                                help="Display an option to enable SMS messaging for the individual's phone number." />

                <ConditionalWell v-if="displaySmsEnabled">
                    <InlineCheckBox v-model="smsEnabledByDefault"
                                    label="Enable SMS by Default"
                                    help="Enables the SMS messaging option for the new phone numbers by default." />
                </ConditionalWell>

                <RadioButtonList v-model="displaySuffix"
                                 label="Display Name Suffix"
                                 help="Display the name suffix field (such as Jr or Sr) when editing an individual's information."
                                 :items="displaySuffixItems"
                                 trailblazerField />
            </ContentStack>

            <ContentStack title="Adult Registration Fields"
                          description="Configure the types of information to collect from adults during registration.">
                <DropDownList v-model="requiredAttributesForAdults"
                              label="Required Attributes for Adults"
                              help="The person attributes that will be displayed as required input fields when adding or updating adults."
                              :items="personAttributeItems"
                              multiple
                              enhanceForLongLists
                              trailblazerField />

                <DropDownList v-model="optionalAttributesForAdults"
                              label="Optional Attributes for Adults"
                              help="The person attributes that will be displayed as optional input fields when adding or updating adults."
                              :items="personAttributeItems"
                              multiple
                              enhanceForLongLists
                              trailblazerField />

                <RadioButtonList v-model="displayBirthdateForAdults"
                                 label="Display Birthdate for Adults"
                                 help="Controls how the birthdate input field should be displayed for adults."
                                 :items="requirementLevelItems" />

                <RadioButtonList v-model="displayRaceForAdults"
                                 label="Display Race for Adults"
                                 help="Controls how the race input field should be displayed for adults."
                                 :items="requirementLevelItems"
                                 trailblazerField />

                <RadioButtonList v-model="displayEthnicityForAdults"
                                 label="Display Ethnicity for Adults"
                                 help="Controls how the ethnicity input field should be displayed for adults."
                                 :items="requirementLevelItems"
                                 trailblazerField />

                <InlineCheckBox v-model="displayAlternateIdForAdults"
                                label="Display Alternate ID Field for Adults"
                                help="Controls if the alternate identifier input field should be displayed for adults. The alternate identifier is used when searching for a scanned barcode tag."
                                trailblazerField />
            </ContentStack>

            <ContentStack title="Children Registration Fields"
                          description="Configure the types of information to collect from children during registration.">
                <DropDownList v-model="requiredAttributesForChildren"
                              label="Required Attributes for Children"
                              help="The person attributes that will be displayed as required input fields when adding or updating children."
                              :items="personAttributeItems"
                              multiple
                              enhanceForLongLists
                              trailblazerField />

                <DropDownList v-model="optionalAttributesForChildren"
                              label="Optional Attributes for Children"
                              help="The person attributes that will be displayed as optional input fields when adding or updating children."
                              :items="personAttributeItems"
                              multiple
                              enhanceForLongLists
                              trailblazerField />

                <RadioButtonList v-model="displayBirthdateForChildren"
                                 label="Display Birthdate for Children"
                                 help="Controls how the birthdate input field should be displayed for children."
                                 :items="requirementLevelItems" />

                <RadioButtonList v-model="displayGradeForChildren"
                                 label="Display Grade for Children"
                                 help="Controls how the grade input field should be displayed for children."
                                 :items="requirementLevelItems" />

                <RadioButtonList v-model="displayMobilePhoneForChildren"
                                 label="Display Mobile Phone for Children"
                                 help="Controls how the mobile phone input field should be displayed for children."
                                 :items="requirementLevelEnumItems" />

                <RadioButtonList v-model="displayRaceForChildren"
                                 label="Display Race for Children"
                                 help="Controls how the race input field should be displayed for children."
                                 :items="requirementLevelItems"
                                 trailblazerField />

                <RadioButtonList v-model="displayEthnicityForChildren"
                                 label="Display Ethnicity for Children"
                                 help="Controls how the ethnicity input field should be displayed for children."
                                 :items="requirementLevelItems"
                                 trailblazerField />

                <InlineCheckBox v-model="displayAlternateIdForChildren"
                                label="Display Alternate ID Field for Children"
                                help="Controls if the alternate identifier input field should be displayed for children. The alternate identifier is used when searching for a scanned barcode tag."
                                trailblazerField />

                <InlineCheckBox v-model="requireRelationshipTypeSelectionForChildren"
                                label="Require Relationship Type Selection for Children"
                                help="Requires the individual to select a relationship type from the list. 'Child' will not be pre-selected automatically when turned on."
                                trailblazerField />

                <NumberBox v-model="gradeConfirmationAge"
                           label="Minimum Age for Grade Confirmation"
                           help="Sets the minimum age at which the grade confirmation dialog appears while adding or editing a child when no grade has been entered. Use decimals for partial years (e.g., 5.5). Only applies if grade is optional. Leave blank to disable the dialog."
                           inputClasses="input-width-md"
                           :decimalCount="1"
                           :minimumValue="0"
                           trailblazerField />
            </ContentStack>

            <ContentStack title="Family Registration Fields"
                          description="Configure the types of information to collect from families during registration.">
                <RadioButtonList v-model="displayAddressForFamilies"
                                 label="Display Address for Families"
                                 help="Controls how the family address field displayed when adding or editing a family during registration."
                                 :items="requirementLevelEnumItems" />

                <DropDownList v-model="requiredAttributesForFamilies"
                              label="Required Attributes for Families"
                              help="The family attributes that will be displayed as required input fields when adding or updating family records."
                              :items="familyAttributeItems"
                              multiple
                              trailblazerField />

                <DropDownList v-model="optionalAttributesForFamilies"
                              label="Optional Attributes for Families"
                              help="The family attributes that will be displayed as optional input fields when adding or updating family records."
                              :items="familyAttributeItems"
                              multiple
                              trailblazerField />
            </ContentStack>

            <ContentStack v-if="isTrailblazerMode"
                          title="Child Relationship Settings"
                          description="Configure the relationship types that are displayed when adding a child. You can also specify which of those will add the child to the parent's family and which ones will add them to a new family with a relationship back to the parent's family.">
                <DropDownList v-model="childRelationshipTypes"
                              label="Relationship Types"
                              help="The known relationships to display in the child's 'Relationship to Adult' field."
                              :items="relationshipTypeItems"
                              multiple
                              trailblazerField />

                <DropDownList v-model="addChildToParentsFamilyRelationshipTypes"
                              label="Add Child to Parent's Family for These Relationship Types"
                              help="Choose which relationship types will add a new child to the same family as the adults."
                              :items="relationshipTypeItems"
                              multiple
                              trailblazerField />

                <DropDownList v-model="addChildToNewFamilyRelationshipTypes"
                              label="Add Child to New Family for These Relationship Types"
                              help="Choose which relationship types will add a new child to a separate family, with a 'Can Check-in' relationship back to the adults in the primary family."
                              :items="relationshipTypeItems"
                              multiple
                              trailblazerField />
            </ContentStack>

            <ContentStack v-if="isTrailblazerMode"
                          title="Registration Workflows"
                          description="Configure optional workflows to run when a new family or person is registered.">
                <WorkflowTypePicker v-model="newFamilyWorkflowTypes"
                                    label="New Family Workflow Types"
                                    help="The workflow types that should be launched when a family is added."
                                    multiple
                                    trailblazerField />

                <WorkflowTypePicker v-model="newPersonWorkflowTypes"
                                    label="New Person Workflow Types"
                                    help="The workflow types that should be launched when a person is added."
                                    multiple
                                    trailblazerField />
            </ContentStack>
        </ContentSection>

        <ContentSection title="Advanced Settings" icon="ti ti-adjustments-cog" :order="5" :isCollapsed="true">
            <ContentStack title="Additional Filters & Settings"
                          description="Configure requirements like age, grade, or ability level, enable proximity check-in, and filter who can check in.">
                <RadioButtonList v-model="abilityLevelDetermination"
                                 label="Ability Level Determination"
                                 help="Determines how check-in should gather the individual's current ability level.<ul><li>'Ask' means that the individual will be asked as a part of each check-in.</li><li>'Don't Ask' will trust that there is another process in place to gather ability level information and the individual will not be asked for their level during check-in.</li><li>'Don't Ask If There Is No Ability Level' will only ask if the individual does <b>not</b> already have an ability level. This will allow a person's ability level to be updated during the check-in process but not initially set.</li><li>'Don't Ask If There Is An Ability Level' will only ask if the individual <b>does</b> already have an ability level (this is only supported in next-gen check-in).</li></ul>"
                                 :items="abilityLevelDeterminationItems"
                                 trailblazerField />

                <RadioButtonList v-model="gradeAndAgeMatchingBehavior"
                                 label="Grade & Age Matching Behavior"
                                 help='Only supported in next-gen check-in. Defines how the Grade Range and Age Range/Birthdate Range values are used (blank ranges are still allowed in all cases). See documentation for edge cases not described here. "Grade And Age Must Match" means Grade Range and one of Age Range or Birthdate Range must match. "Age Match Not Required" means that if a Grade Range is specified on the group and the person has a matching Grade then that will be considered sufficient and neither Age Range nor Birthdate Range will be checked even if they are specified. "Prioritize Grade Over Age" will use the same filtering logic as Age Match Not Required. After that, if any groups were matched by grade then all groups that were not matched by grade will be excluded.'
                                 :items="gradeAndAgeMatchingBehaviorItems"
                                 trailblazerField />

                <RadioButtonList v-model="ageRestriction"
                                 label="Age Restriction"
                                 help="Limits the ages of people that will be considered for check-in when using this configuration. This also limits who will be displayed on the person select screen. Only applies to next-gen check-in."
                                 :items="ageRestrictionItems"
                                 trailblazerField />

                <InlineCheckBox v-model="enableProximityCheckIn"
                                label="Enable Proximity Check-in"
                                help="Makes this check-in configuration and all areas and groups available for proximity check-in with a native Rock Mobile application."
                                trailblazerField />

                <ConditionalWell v-if="enableProximityCheckIn && isTrailblazerMode">
                    <CodeEditor v-model="proximityAttendanceNotificationTemplate"
                                label="Notification Template"
                                help="The Lava template used to generate the push notification message when an individual is successfully checked in via proximity. This message will be sent to the associated device. Only used when proximity check-in is enabled."
                                mode="lava" />
                </ConditionalWell>

                <InlineCheckBox v-model="preventInactivePeople"
                                label="Hide Inactive People"
                                help="When enabled, individuals who are marked as inactive will not be shown in the results or allowed to check-in." />

                <InlineCheckBox v-model="ageRequired"
                                label="Age is Required"
                                help="If an area and/or group has an age requirement, check this option to prevent people without an age from checking into that area/group." />

                <InlineCheckBox v-model="gradeRequired"
                                label="Grade is Required"
                                help="If an area and/or group has a grade requirement, check this option to prevent people without a grade from checking into that area/group." />
            </ContentStack>

            <ContentStack title="Special Needs"
                          description="Configure check-in settings to accommodate individuals with special needs.">
                <InlineCheckBox v-model="hideSpecialNeedsGroups"
                                label="Hide Special Needs Groups"
                                help="A special needs group will only be available if the person is marked as special needs." />

                <InlineCheckBox v-model="hideNonSpecialNeedsGroups"
                                label="Hide Non-Special Needs Groups"
                                help="A non-special needs group will only be available if the person is not marked as special needs." />
            </ContentStack>

            <ContentStack v-if="isTrailblazerMode && hasAttributeValues"
                          title="Custom Attributes"
                          description="Configure any custom settings defined on your system.">
                <AttributeValuesContainer v-model="attributeValues"
                                          :attributes="attributes"
                                          isEditMode />
            </ContentStack>
        </ContentSection>

        <ContentSection v-if="showClassicCheckInSettings && isTrailblazerMode"
                        title="Classic Check-in Settings"
                        icon="ti ti-file-settings"
                        :order="6"
                        :isCollapsed="true">
            <ContentStack title="Display"
                          description="Control how often the kiosk refreshes its check-in configuration and what is displayed on the success screen.">
                <NumberBox v-model="refreshInterval"
                           label="Refresh Interval"
                           help="How often (seconds) should the welcome page automatically refresh and check for updated configuration information?"
                           inputGroupClasses="input-width-lg"
                           :minimumValue="0">
                    <template #inputGroupAppend>
                        <span class="input-group-addon">Seconds</span>
                    </template>
                </NumberBox>

                <RadioButtonList v-model="successTemplateDisplayMode"
                                 label="Success Template Display Mode"
                                 help="'Never' will hide the custom success template. 'Replace' will replace the current success content with the template. 'Append' will place the success template content under the existing content."
                                 :items="successTemplateDisplayModeItems" />

                <ConditionalWell v-if="isSuccessTemplateVisible">
                    <CodeEditor v-model="successTemplate"
                                label="Success Template"
                                help="The lava template to use when rendering the Success result on the Success Block."
                                mode="lava" />
                </ConditionalWell>
            </ContentStack>

            <ContentStack title="Templates"
                          description="Customize the content shown on the start page, family and person selection screens, and the success screen.">
                <CodeEditor v-model="startTemplate"
                            label="Start Screen Template"
                            help="The lava template to use when rendering the Start button on the Welcome Block."
                            mode="lava" />

                <CodeEditor v-model="familySelectTemplate"
                            label="Family Select Screen Template"
                            help="The lava template to use when rendering each family button on the Family Select."
                            mode="lava" />

                <CodeEditor v-model="personSelectTemplate"
                            label="Person Select Screen Template"
                            help="The lava template used to append additional information to each person button on the Person Select & Multi-Person Select Check-in blocks."
                            mode="lava" />
            </ContentStack>

            <ContentStack title="Custom Header Text"
                          description="Configure the header text for each step of the check-in process.">
                <CodeEditor v-model="actionSelectHeaderTemplate"
                            label="Action Select Header Template"
                            help="The lava template to use for the 'Action Select' check-in block header. The available merge fields are:<br>{{ Family }} which is a Group object and is the current family."
                            mode="lava" />

                <CodeEditor v-model="checkoutPersonSelectHeaderTemplate"
                            label="Check-out Person Select Header Template"
                            help="The lava template to use for the 'Checkout Person Select' check-in block header. The available merge fields are:<br>{{ Family }} which is a Group object and is the current family."
                            mode="lava" />

                <CodeEditor v-model="personSelectHeaderTemplate"
                            label="Person Select Header Template"
                            help="The lava template to use for the 'Person Select' check-in block header. The available merge fields are:<br>{{ Family }} which is a Group object and is the current family."
                            mode="lava" />

                <CodeEditor v-model="multiPersonSelectHeaderTemplate"
                            label="Multi-Person Select Header Template"
                            help="The lava template to use for the 'Multi Person Select' check-in block header. The available merge fields are:<br>{{ Family }} which is a Group object and is the current family."
                            mode="lava" />

                <CodeEditor v-model="groupTypeSelectHeaderTemplate"
                            label="Group Type Select Header Template"
                            help="The lava template to use for the 'Group Type Select' check-in block header. The available merge fields are:<br>{{ Family }} which is a Group object and is the current family.<br>{{ Individual }} which is a Person object and is the current selected person.<br>{{ SelectedSchedule }} is a Schedule object and is the current selected schedule."
                            mode="lava" />

                <CodeEditor v-model="timeSelectHeaderTemplate"
                            label="Time Select Header Template"
                            help="The lava template to use for the 'Time Select' check-in block header. The available merge fields are:<br>{{ Family }} which is a Group object and is the current family.<br>{{ SelectedIndividuals }} is a list of Person objects which contains all of the currently selected persons.<br>{{ CheckinType }} is the type of check-in given as a string which will be either 'Family' or 'Individual'.<br>{{ SelectedGroup }} is a Group object and corresponds to the selected check-in group listed in Areas and Groups. This only applies for individual check-in types.<br>{{ SelectedLocation }} is a Location and corresponds to the selected location for the group. This only applies for individual check-in types."
                            mode="lava" />

                <CodeEditor v-model="abilityLevelSelectHeaderTemplate"
                            label="Ability Level Select Header Template"
                            help="The lava template to use for the 'Ability Level Select' check-in block header. The available merge fields are:<br>{{ Family }} which is a Group object and is the current family.<br>{{ Individual }} which is a Person object and is the current selected person.<br>{{ SelectedArea }} is a GroupType object and corresponds to the selected check-in Area listed in Areas and Groups."
                            mode="lava" />

                <CodeEditor v-model="locationSelectHeaderTemplate"
                            label="Location Select Header Template"
                            help="The lava template to use for the 'Location Select' check-in block header. The available merge fields are:<br>{{ Family }} which is a Group object and is the current family.<br>{{ Individual }} which is a Person object and is the current selected person.<br>{{ SelectedGroup }} is a Group object and corresponds to the selected check-in group listed in Areas and Groups.<br>{{ SelectedSchedule }} is a Schedule object and is the current selected schedule."
                            mode="lava" />

                <CodeEditor v-model="groupSelectHeaderTemplate"
                            label="Group Select Header Template"
                            help="The lava template to use for the 'Group Select' check-in block header. The available merge fields are:<br>{{ Family }} which is a Group object and is the current family.<br>{{ Individual }} which is a Person object and is the current selected person.<br>{{ SelectedArea }} is a GroupType object and corresponds to the selected check-in Area listed in Areas and Groups.<br>{{ SelectedSchedule }} is a Schedule object and is the current selected schedule."
                            mode="lava" />
            </ContentStack>
        </ContentSection>
    </ContentSectionContainer>
</template>

<script setup lang="ts">
    import { computed, PropType, ref, watch } from "vue";
    import { CheckInType, CheckInTypeDescription, RegistrationFieldDisplay } from "./types.partial";
    import AttributeValuesContainer from "@Obsidian/Controls/attributeValuesContainer.obs";
    import CodeEditor from "@Obsidian/Controls/codeEditor.obs";
    import ConditionalWell from "@Obsidian/Controls/conditionalWell.obs";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    import ContentSectionContainer from "@Obsidian/Controls/contentSectionContainer.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import DefinedValuePicker from "@Obsidian/Controls/definedValuePicker.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import IconPicker from "@Obsidian/Controls/iconPicker.obs";
    import InlineCheckBox from "@Obsidian/Controls/inlineCheckBox.obs";
    import NumberBox from "@Obsidian/Controls/numberBox.obs";
    import RadioButtonList from "@Obsidian/Controls/radioButtonList.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import WorkflowTypePicker from "@Obsidian/Controls/workflowTypePicker.obs";
    import { AbilityLevelDeterminationMode, AbilityLevelDeterminationModeDescription } from "@Obsidian/Enums/CheckIn/abilityLevelDeterminationMode";
    import { AdultsOrChildrenSelectionMode, AdultsOrChildrenSelectionModeDescription } from "@Obsidian/Enums/CheckIn/adultsOrChildrenSelectionMode";
    import { AgeRestrictionMode } from "@Obsidian/Enums/CheckIn/ageRestrictionMode";
    import { RequirementLevel } from "@Obsidian/Enums/Controls/requirementLevel";
    import { AutoSelectMode, AutoSelectModeDescription } from "@Obsidian/Enums/CheckIn/autoSelectMode";
    import { AgeRestrictionModeDescription } from "@Obsidian/Enums/CheckIn/ageRestrictionMode";
    import { GradeAndAgeMatchingMode, GradeAndAgeMatchingModeDescription } from "@Obsidian/Enums/CheckIn/gradeAndAgeMatchingMode";
    import { PhoneSearchMode, PhoneSearchModeDescription } from "@Obsidian/Enums/CheckIn/phoneSearchMode";
    import { SuccessLavaTemplateDisplayMode, SuccessLavaTemplateDisplayModeDescription } from "@Obsidian/Enums/CheckIn/successLavaTemplateDisplayMode";
    import { useStore } from "@Obsidian/PageState";
    import { DefinedType } from "@Obsidian/SystemGuids/definedType";
    import { DefinedValue } from "@Obsidian/SystemGuids/definedValue";
    import { setPropertiesBoxValue, watchPropertyChanges } from "@Obsidian/Utility/block";
    import { propertyRef, updateRefValue } from "@Obsidian/Utility/component";
    import { enumToListItemBag } from "@Obsidian/Utility/enumUtils";
    import { areEqual } from "@Obsidian/Utility/guid";
    import { toNumberOrNull } from "@Obsidian/Utility/numberUtils";
    import { CheckInBasicSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInBasicSettingsBag";
    import { CheckInConfigurationSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInConfigurationSettingsBag";
    import { CheckInConfigurationSettingsOptionsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInConfigurationSettingsOptionsBag";
    import { CheckInDisplaySettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInDisplaySettingsBag";
    import { CheckInAdultRegistrationSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInAdultRegistrationSettingsBag";
    import { CheckInChildRegistrationSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInChildRegistrationSettingsBag";
    import { CheckInChildRelationshipSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInChildRelationshipSettingsBag";
    import { CheckInFamilyRegistrationSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInFamilyRegistrationSettingsBag";
    import { CheckInRegistrationWorkflowSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInRegistrationWorkflowSettingsBag";
    import { CheckInAdditionalFiltersAndSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInAdditionalFiltersAndSettingsBag";
    import { CheckInClassicDisplaySettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInClassicDisplaySettingsBag";
    import { CheckInClassicTemplatesSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInClassicTemplatesSettingsBag";
    import { CheckInClassicCustomHeaderTextSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInClassicCustomHeaderTextSettingsBag";
    import { CheckInSpecialNeedsSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInSpecialNeedsSettingsBag";
    import { CheckInGeneralRegistrationSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInGeneralRegistrationSettingsBag";
    import { CheckInKioskFeaturesSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInKioskFeaturesSettingsBag";
    import { CheckInSearchSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInSearchSettingsBag";
    import { CheckInSecurityCodesSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInSecurityCodesSettingsBag";
    import { CheckInSupervisionSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInSupervisionSettingsBag";
    import { CheckInTypeFlowSettingsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInConfigurationSettings/checkInTypeFlowSettingsBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";

    const store = useStore();

    const props = defineProps({
        modelValue: {
            type: Object as PropType<ValidPropertiesBox<CheckInConfigurationSettingsBag>>,
            required: true
        },

        options: {
            type: Object as PropType<CheckInConfigurationSettingsOptionsBag>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: ValidPropertiesBox<CheckInConfigurationSettingsBag>): void,
        (e: "propertyChanged", value: string): void
    }>();

    /** The selectable check-in type options. */
    const checkInTypeItems = enumToListItemBag(CheckInTypeDescription);

    /** The selectable auto-select options. */
    const autoSelectOptionsItems = enumToListItemBag(AutoSelectModeDescription);

    /** The selectable phone-number comparison method options. */
    const phoneSearchTypeItems = enumToListItemBag(PhoneSearchModeDescription);

    /** The selectable Display Name Suffix mode options. */
    const displaySuffixItems = enumToListItemBag(AdultsOrChildrenSelectionModeDescription);

    /** The selectable Ability Level Determination options. */
    const abilityLevelDeterminationItems = enumToListItemBag(AbilityLevelDeterminationModeDescription);

    /** The selectable Grade & Age Matching Behavior options. */
    const gradeAndAgeMatchingBehaviorItems = enumToListItemBag(GradeAndAgeMatchingModeDescription);

    /** The selectable Age Restriction options. */
    const ageRestrictionItems = enumToListItemBag(AgeRestrictionModeDescription);

    /** The selectable Success Template Display Mode options. */
    const successTemplateDisplayModeItems = enumToListItemBag(SuccessLavaTemplateDisplayModeDescription);

    /** The selectable Hide / Optional / Required options shared by the registration display fields. */
    const requirementLevelItems: ListItemBag[] = [
        { text: RegistrationFieldDisplay.Hide, value: RegistrationFieldDisplay.Hide },
        { text: RegistrationFieldDisplay.Optional, value: RegistrationFieldDisplay.Optional },
        { text: RegistrationFieldDisplay.Required, value: RegistrationFieldDisplay.Required }
    ];

    /**
     * The selectable Hide / Optional / Required options for display fields
     * whose values are persisted as Rock.Enums.Controls.RequirementLevel
     * (int-backed) inside CheckInTemplateSettings, so the three UI choices map
     * to enum members: Hide=Unavailable, Optional=Optional, Required=Required.
     * (Unspecified is intentionally excluded from the UI.)
     */
    const requirementLevelEnumItems: ListItemBag[] = [
        { text: "Hide", value: String(RequirementLevel.Unavailable) },
        { text: "Optional", value: String(RequirementLevel.Optional) },
        { text: "Required", value: String(RequirementLevel.Required) }
    ];

    // #region Values

    // Basic Settings
    const name = propertyRef(props.modelValue.bag?.basicSettings?.name ?? "", "Name");
    const iconCssClass = propertyRef(props.modelValue.bag?.basicSettings?.iconCssClass ?? "", "IconCssClass");
    const description = propertyRef(props.modelValue.bag?.basicSettings?.description ?? "", "Description");

    // Type Flow Settings
    const checkInType = ref<string>(props.modelValue.bag?.typeFlowSettings?.checkInType ?? CheckInType.Individual);
    const autoSelectOptions = ref<string>(props.modelValue.bag?.typeFlowSettings?.autoSelectOptions?.toString() ?? String(AutoSelectMode.PeopleOnly));
    const autoSelectDaysBack = ref<number | null>(props.modelValue.bag?.typeFlowSettings?.autoSelectDaysBack ?? null);
    const useSameOptions = ref(props.modelValue.bag?.typeFlowSettings?.useSameOptions ?? false);
    const preventDuplicateCheckin = ref(props.modelValue.bag?.typeFlowSettings?.preventDuplicateCheckin ?? false);

    // Kiosk Features Settings
    const allowCheckoutAtKiosk = ref(props.modelValue.bag?.kioskFeaturesSettings?.allowCheckoutAtKiosk ?? false);
    const enableRemoveFamilyKiosk = ref(props.modelValue.bag?.kioskFeaturesSettings?.enableRemoveFamilyKiosk ?? false);
    const enablePresence = ref(props.modelValue.bag?.kioskFeaturesSettings?.enablePresence ?? false);

    // Display Settings
    const promotionsContentChannelGuid = ref(props.modelValue.bag?.displaySettings?.promotionsContentChannelGuid ?? "");
    const hidePhotos = ref(props.modelValue.bag?.displaySettings?.hidePhotos ?? false);
    const displayLocationCount = ref(props.modelValue.bag?.displaySettings?.displayLocationCount ?? false);
    const achievementTypes = ref<string[]>(props.modelValue.bag?.displaySettings?.achievementTypes ?? []);

    // Supervision Settings
    const enableManager = ref(props.modelValue.bag?.supervisionSettings?.enableManager ?? false);
    const enableOverride = ref(props.modelValue.bag?.supervisionSettings?.enableOverride ?? false);
    const allowCheckoutInManager = ref(props.modelValue.bag?.supervisionSettings?.allowCheckoutInManager ?? false);

    // Search Settings
    const searchType = ref(props.modelValue.bag?.searchSettings?.searchType ?? DefinedValue.CheckinSearchTypePhoneNumber);
    const minPhoneLength = ref<number | null>(props.modelValue.bag?.searchSettings?.minPhoneLength ?? null);
    const maxPhoneLength = ref<number | null>(props.modelValue.bag?.searchSettings?.maxPhoneLength ?? null);
    const phoneSearchType = ref<string>(props.modelValue.bag?.searchSettings?.phoneSearchType?.toString() ?? String(PhoneSearchMode.Contains));
    const maxResults = ref<number | null>(props.modelValue.bag?.searchSettings?.maxResults ?? null);
    const searchRegex = ref(props.modelValue.bag?.searchSettings?.searchRegex ?? "");

    // Security Codes Settings
    const codeAlphaNumericLength = ref<number | null>(props.modelValue.bag?.securityCodesSettings?.codeAlphaNumericLength ?? null);
    const codeAlphaLength = ref<number | null>(props.modelValue.bag?.securityCodesSettings?.codeAlphaLength ?? null);
    const codeNumericLength = ref<number | null>(props.modelValue.bag?.securityCodesSettings?.codeNumericLength ?? null);
    const codeRandom = ref(props.modelValue.bag?.securityCodesSettings?.codeRandom ?? false);
    const useSameCodeForFamily = ref(props.modelValue.bag?.securityCodesSettings?.useSameCodeForFamily ?? false);

    // General Registration Settings
    const defaultPersonConnectionStatus = ref(props.modelValue.bag?.generalRegistrationSettings?.defaultPersonConnectionStatus ?? null);
    const defaultPersonRecordSource = ref(props.modelValue.bag?.generalRegistrationSettings?.defaultPersonRecordSource ?? null);
    const enableCheckInAfterRegistration = ref(props.modelValue.bag?.generalRegistrationSettings?.enableCheckInAfterRegistration ?? false);
    const displaySmsEnabled = ref(props.modelValue.bag?.generalRegistrationSettings?.displaySmsEnabled ?? false);
    const smsEnabledByDefault = ref(props.modelValue.bag?.generalRegistrationSettings?.smsEnabledByDefault ?? false);
    const displaySuffix = ref<string>(props.modelValue.bag?.generalRegistrationSettings?.displaySuffix.toString() ?? String(AdultsOrChildrenSelectionMode.AdultsAndChildren));

    // Adult Registration Settings
    const requiredAttributesForAdults = ref<string[]>(props.modelValue.bag?.adultRegistrationSettings?.requiredAttributesForAdults ?? []);
    const optionalAttributesForAdults = ref<string[]>(props.modelValue.bag?.adultRegistrationSettings?.optionalAttributesForAdults ?? []);
    const displayBirthdateForAdults = ref(props.modelValue.bag?.adultRegistrationSettings?.displayBirthdateForAdults ?? RegistrationFieldDisplay.Hide);
    const displayRaceForAdults = ref(props.modelValue.bag?.adultRegistrationSettings?.displayRaceForAdults ?? RegistrationFieldDisplay.Hide);
    const displayEthnicityForAdults = ref(props.modelValue.bag?.adultRegistrationSettings?.displayEthnicityForAdults ?? RegistrationFieldDisplay.Hide);
    const displayAlternateIdForAdults = ref(props.modelValue.bag?.adultRegistrationSettings?.displayAlternateIdForAdults ?? false);

    // Child Registration Settings
    const requiredAttributesForChildren = ref<string[]>(props.modelValue.bag?.childRegistrationSettings?.requiredAttributesForChildren ?? []);
    const optionalAttributesForChildren = ref<string[]>(props.modelValue.bag?.childRegistrationSettings?.optionalAttributesForChildren ?? []);
    const displayBirthdateForChildren = ref(props.modelValue.bag?.childRegistrationSettings?.displayBirthdateForChildren ?? RegistrationFieldDisplay.Hide);
    const displayGradeForChildren = ref(props.modelValue.bag?.childRegistrationSettings?.displayGradeForChildren ?? RegistrationFieldDisplay.Hide);
    const displayMobilePhoneForChildren = ref<string>(props.modelValue.bag?.childRegistrationSettings?.displayMobilePhoneForChildren.toString() ?? String(RequirementLevel.Optional));
    const displayRaceForChildren = ref(props.modelValue.bag?.childRegistrationSettings?.displayRaceForChildren ?? RegistrationFieldDisplay.Hide);
    const displayEthnicityForChildren = ref(props.modelValue.bag?.childRegistrationSettings?.displayEthnicityForChildren ?? RegistrationFieldDisplay.Hide);
    const displayAlternateIdForChildren = ref(props.modelValue.bag?.childRegistrationSettings?.displayAlternateIdForChildren ?? false);
    const requireRelationshipTypeSelectionForChildren = ref(props.modelValue.bag?.childRegistrationSettings?.requireRelationshipTypeSelectionForChildren ?? false);
    const gradeConfirmationAge = ref<number | null>(props.modelValue.bag?.childRegistrationSettings?.gradeConfirmationAge ?? null);

    // Family Registration Settings
    const displayAddressForFamilies = ref<string>(props.modelValue.bag?.familyRegistrationSettings?.displayAddressForFamilies.toString() ?? String(RequirementLevel.Optional));
    const requiredAttributesForFamilies = ref<string[]>(props.modelValue.bag?.familyRegistrationSettings?.requiredAttributesForFamilies ?? []);
    const optionalAttributesForFamilies = ref<string[]>(props.modelValue.bag?.familyRegistrationSettings?.optionalAttributesForFamilies ?? []);

    // Child Relationship Settings
    const childRelationshipTypes = ref<string[]>(props.modelValue.bag?.childRelationshipSettings?.childRelationshipTypes ?? []);
    const addChildToParentsFamilyRelationshipTypes = ref<string[]>(props.modelValue.bag?.childRelationshipSettings?.addChildToParentsFamilyRelationshipTypes ?? []);
    const addChildToNewFamilyRelationshipTypes = ref<string[]>(props.modelValue.bag?.childRelationshipSettings?.addChildToNewFamilyRelationshipTypes ?? []);

    // Registration Workflow Settings
    const newFamilyWorkflowTypes = ref<ListItemBag[]>(props.modelValue.bag?.registrationWorkflowSettings?.newFamilyWorkflowTypes ?? []);
    const newPersonWorkflowTypes = ref<ListItemBag[]>(props.modelValue.bag?.registrationWorkflowSettings?.newPersonWorkflowTypes ?? []);

    // Additional Filters & Settings
    const abilityLevelDetermination = ref<string>(props.modelValue.bag?.additionalFiltersAndSettings?.abilityLevelDetermination?.toString() ?? String(AbilityLevelDeterminationMode.Ask));
    const gradeAndAgeMatchingBehavior = ref<string>(props.modelValue.bag?.additionalFiltersAndSettings?.gradeAndAgeMatchingBehavior?.toString() ?? String(GradeAndAgeMatchingMode.GradeAndAgeMustMatch));
    const ageRestriction = ref<string>(props.modelValue.bag?.additionalFiltersAndSettings?.ageRestriction?.toString() ?? String(AgeRestrictionMode.ShowAll));
    const enableProximityCheckIn = ref(props.modelValue.bag?.additionalFiltersAndSettings?.enableProximityCheckIn ?? false);
    const proximityAttendanceNotificationTemplate = ref(props.modelValue.bag?.additionalFiltersAndSettings?.proximityAttendanceNotificationTemplate ?? "");
    const preventInactivePeople = ref(props.modelValue.bag?.additionalFiltersAndSettings?.preventInactivePeople ?? false);
    const ageRequired = ref(props.modelValue.bag?.additionalFiltersAndSettings?.ageRequired ?? false);
    const gradeRequired = ref(props.modelValue.bag?.additionalFiltersAndSettings?.gradeRequired ?? false);

    // Special Needs Settings
    const hideSpecialNeedsGroups = ref(props.modelValue.bag?.specialNeedsSettings?.hideSpecialNeedsGroups ?? false);
    const hideNonSpecialNeedsGroups = ref(props.modelValue.bag?.specialNeedsSettings?.hideNonSpecialNeedsGroups ?? false);

    // Custom Attributes (any GroupType attribute not explicitly managed by a first-class field on this block).
    // These come straight off EntityBagBase rather than living inside a sub-bag.
    const attributes = ref(props.modelValue.bag?.attributes ?? {});
    const attributeValues = ref(props.modelValue.bag?.attributeValues ?? {});

    // Classic Display Settings
    const refreshInterval = ref<number | null>(props.modelValue.bag?.classicDisplaySettings?.refreshInterval ?? null);
    const successTemplateDisplayMode = ref<string>(props.modelValue.bag?.classicDisplaySettings?.successTemplateDisplayMode?.toString() ?? String(SuccessLavaTemplateDisplayMode.Never));
    const successTemplate = ref(props.modelValue.bag?.classicDisplaySettings?.successTemplate ?? "");

    // Classic Templates Settings
    const startTemplate = ref(props.modelValue.bag?.classicTemplatesSettings?.startTemplate ?? "");
    const familySelectTemplate = ref(props.modelValue.bag?.classicTemplatesSettings?.familySelectTemplate ?? "");
    const personSelectTemplate = ref(props.modelValue.bag?.classicTemplatesSettings?.personSelectTemplate ?? "");

    // Classic Custom Header Text Settings
    const actionSelectHeaderTemplate = ref(props.modelValue.bag?.classicCustomHeaderTextSettings?.actionSelectHeaderTemplate ?? "");
    const checkoutPersonSelectHeaderTemplate = ref(props.modelValue.bag?.classicCustomHeaderTextSettings?.checkoutPersonSelectHeaderTemplate ?? "");
    const personSelectHeaderTemplate = ref(props.modelValue.bag?.classicCustomHeaderTextSettings?.personSelectHeaderTemplate ?? "");
    const multiPersonSelectHeaderTemplate = ref(props.modelValue.bag?.classicCustomHeaderTextSettings?.multiPersonSelectHeaderTemplate ?? "");
    const groupTypeSelectHeaderTemplate = ref(props.modelValue.bag?.classicCustomHeaderTextSettings?.groupTypeSelectHeaderTemplate ?? "");
    const timeSelectHeaderTemplate = ref(props.modelValue.bag?.classicCustomHeaderTextSettings?.timeSelectHeaderTemplate ?? "");
    const abilityLevelSelectHeaderTemplate = ref(props.modelValue.bag?.classicCustomHeaderTextSettings?.abilityLevelSelectHeaderTemplate ?? "");
    const locationSelectHeaderTemplate = ref(props.modelValue.bag?.classicCustomHeaderTextSettings?.locationSelectHeaderTemplate ?? "");
    const groupSelectHeaderTemplate = ref(props.modelValue.bag?.classicCustomHeaderTextSettings?.groupSelectHeaderTemplate ?? "");

    // The properties that are being edited. This should only contain
    // objects returned by propertyRef().
    const propRefs = [name, iconCssClass, description];

    const typeFlowSettingsRefs = [checkInType, autoSelectOptions, autoSelectDaysBack, useSameOptions, preventDuplicateCheckin];

    const kioskFeaturesSettingsRefs = [allowCheckoutAtKiosk, enableRemoveFamilyKiosk, enablePresence];

    const displaySettingsRefs = [promotionsContentChannelGuid, hidePhotos, displayLocationCount, achievementTypes];

    const supervisionSettingsRefs = [enableManager, enableOverride, allowCheckoutInManager];

    const searchSettingsRefs = [searchType, minPhoneLength, maxPhoneLength, phoneSearchType, maxResults, searchRegex];

    const securityCodesSettingsRefs = [codeAlphaNumericLength, codeAlphaLength, codeNumericLength, codeRandom, useSameCodeForFamily];

    const generalRegistrationSettingsRefs = [defaultPersonConnectionStatus, defaultPersonRecordSource, enableCheckInAfterRegistration, displaySmsEnabled, smsEnabledByDefault, displaySuffix];

    const adultRegistrationSettingsRefs = [requiredAttributesForAdults, optionalAttributesForAdults, displayBirthdateForAdults, displayRaceForAdults, displayEthnicityForAdults, displayAlternateIdForAdults];

    const childRegistrationSettingsRefs = [requiredAttributesForChildren, optionalAttributesForChildren, displayBirthdateForChildren, displayGradeForChildren, displayMobilePhoneForChildren, displayRaceForChildren, displayEthnicityForChildren, displayAlternateIdForChildren, requireRelationshipTypeSelectionForChildren, gradeConfirmationAge];

    const familyRegistrationSettingsRefs = [displayAddressForFamilies, requiredAttributesForFamilies, optionalAttributesForFamilies];

    const childRelationshipSettingsRefs = [childRelationshipTypes, addChildToParentsFamilyRelationshipTypes, addChildToNewFamilyRelationshipTypes];

    const registrationWorkflowSettingsRefs = [newFamilyWorkflowTypes, newPersonWorkflowTypes];

    const additionalFiltersAndSettingsRefs = [abilityLevelDetermination, gradeAndAgeMatchingBehavior, ageRestriction, enableProximityCheckIn, proximityAttendanceNotificationTemplate, preventInactivePeople, ageRequired, gradeRequired];

    const specialNeedsSettingsRefs = [hideSpecialNeedsGroups, hideNonSpecialNeedsGroups];

    const customAttributeRefs = [attributeValues];

    const classicDisplaySettingsRefs = [refreshInterval, successTemplateDisplayMode, successTemplate];

    const classicTemplatesSettingsRefs = [startTemplate, familySelectTemplate, personSelectTemplate];

    const classicCustomHeaderTextSettingsRefs = [actionSelectHeaderTemplate, checkoutPersonSelectHeaderTemplate, personSelectHeaderTemplate, multiPersonSelectHeaderTemplate, groupTypeSelectHeaderTemplate, timeSelectHeaderTemplate, abilityLevelSelectHeaderTemplate, locationSelectHeaderTemplate, groupSelectHeaderTemplate];

    // #endregion Values

    // #region Computed Values

    /** Whether the experience-mode picker is currently set to Trailblazer.
     */
    const isTrailblazerMode = computed((): boolean => store.state.trailblazerMode);

    /** Whether the Family check-in flow is currently selected, which exposes additional flow-related settings. */
    const isFamilyCheckIn = computed((): boolean =>
        checkInType.value === CheckInType.Family
    );

    /** The selectable promotions content channels. */
    const promotionsContentChannelItems = computed((): ListItemBag[] =>
        props.options.promotionsContentChannels ?? []
    );

    /** The selectable achievement types. */
    const achievementTypeItems = computed((): ListItemBag[] =>
        props.options.achievementTypes ?? []
    );

    /** The selectable person attributes for the required/optional registration pickers. */
    const personAttributeItems = computed((): ListItemBag[] =>
        props.options.personAttributes ?? []
    );

    /** The selectable family (group) attributes for the required/optional family attribute pickers. */
    const familyAttributeItems = computed((): ListItemBag[] =>
        props.options.familyAttributes ?? []
    );

    /** The selectable known-relationship roles for the Child Relationship Settings pickers. */
    const relationshipTypeItems = computed((): ListItemBag[] =>
        props.options.relationshipTypes ?? []
    );

    /**
     * Whether any unmanaged GroupType attributes exist for this configuration. The Custom Attributes stack
     * is rendered only when this is true.
     */
    const hasAttributeValues = computed((): boolean =>
        Object.keys(attributes.value).length > 0
    );

    /** Whether the Classic Check-in Settings section should be shown, gated by the block setting of the same name. */
    const showClassicCheckInSettings = computed((): boolean =>
        props.options.showClassicCheckInSettings ?? false
    );

    /**
     * Whether the Success Template editor should be visible.
     */
    const isSuccessTemplateVisible = computed((): boolean =>
        toNumberOrNull(successTemplateDisplayMode.value) !== SuccessLavaTemplateDisplayMode.Never
    );

    /** The selectable search types (Phone Number, Name, Name & Phone) — sourced from the Check-in Search Type defined type. */
    const searchTypeItems = computed((): ListItemBag[] =>
        props.options.searchTypes ?? []
    );

    /** Whether the currently selected search type involves phone-number entry, which gates the related fields. */
    const isPhoneBasedSearch = computed((): boolean => {
        if (!searchType.value) {
            return false;
        }

        return !areEqual(searchType.value, DefinedValue.CheckinSearchTypeName);
    });

    // #endregion Computed Values

    // #region Watchers

    // Watch for parental changes in our model value and update all our values.
    watch(() => props.modelValue, () => {
        updateRefValue(name, props.modelValue.bag?.basicSettings?.name ?? "");
        updateRefValue(iconCssClass, props.modelValue.bag?.basicSettings?.iconCssClass ?? "");
        updateRefValue(description, props.modelValue.bag?.basicSettings?.description ?? "");

        updateRefValue(checkInType, props.modelValue.bag?.typeFlowSettings?.checkInType ?? CheckInType.Individual);
        updateRefValue(autoSelectOptions, props.modelValue.bag?.typeFlowSettings?.autoSelectOptions?.toString() ?? String(AutoSelectMode.PeopleOnly));
        updateRefValue(autoSelectDaysBack, props.modelValue.bag?.typeFlowSettings?.autoSelectDaysBack ?? null);
        updateRefValue(useSameOptions, props.modelValue.bag?.typeFlowSettings?.useSameOptions ?? false);
        updateRefValue(preventDuplicateCheckin, props.modelValue.bag?.typeFlowSettings?.preventDuplicateCheckin ?? false);

        updateRefValue(allowCheckoutAtKiosk, props.modelValue.bag?.kioskFeaturesSettings?.allowCheckoutAtKiosk ?? false);
        updateRefValue(enableRemoveFamilyKiosk, props.modelValue.bag?.kioskFeaturesSettings?.enableRemoveFamilyKiosk ?? false);
        updateRefValue(enablePresence, props.modelValue.bag?.kioskFeaturesSettings?.enablePresence ?? false);

        updateRefValue(promotionsContentChannelGuid, props.modelValue.bag?.displaySettings?.promotionsContentChannelGuid ?? "");
        updateRefValue(hidePhotos, props.modelValue.bag?.displaySettings?.hidePhotos ?? false);
        updateRefValue(displayLocationCount, props.modelValue.bag?.displaySettings?.displayLocationCount ?? false);
        updateRefValue(achievementTypes, props.modelValue.bag?.displaySettings?.achievementTypes ?? []);

        updateRefValue(enableManager, props.modelValue.bag?.supervisionSettings?.enableManager ?? false);
        updateRefValue(enableOverride, props.modelValue.bag?.supervisionSettings?.enableOverride ?? false);
        updateRefValue(allowCheckoutInManager, props.modelValue.bag?.supervisionSettings?.allowCheckoutInManager ?? false);

        updateRefValue(searchType, props.modelValue.bag?.searchSettings?.searchType ?? DefinedValue.CheckinSearchTypePhoneNumber);
        updateRefValue(minPhoneLength, props.modelValue.bag?.searchSettings?.minPhoneLength ?? null);
        updateRefValue(maxPhoneLength, props.modelValue.bag?.searchSettings?.maxPhoneLength ?? null);
        updateRefValue(phoneSearchType, props.modelValue.bag?.searchSettings?.phoneSearchType?.toString() ?? String(PhoneSearchMode.Contains));
        updateRefValue(maxResults, props.modelValue.bag?.searchSettings?.maxResults ?? null);
        updateRefValue(searchRegex, props.modelValue.bag?.searchSettings?.searchRegex ?? "");

        updateRefValue(codeAlphaNumericLength, props.modelValue.bag?.securityCodesSettings?.codeAlphaNumericLength ?? null);
        updateRefValue(codeAlphaLength, props.modelValue.bag?.securityCodesSettings?.codeAlphaLength ?? null);
        updateRefValue(codeNumericLength, props.modelValue.bag?.securityCodesSettings?.codeNumericLength ?? null);
        updateRefValue(codeRandom, props.modelValue.bag?.securityCodesSettings?.codeRandom ?? false);
        updateRefValue(useSameCodeForFamily, props.modelValue.bag?.securityCodesSettings?.useSameCodeForFamily ?? false);

        updateRefValue(defaultPersonConnectionStatus, props.modelValue.bag?.generalRegistrationSettings?.defaultPersonConnectionStatus ?? null);
        updateRefValue(defaultPersonRecordSource, props.modelValue.bag?.generalRegistrationSettings?.defaultPersonRecordSource ?? null);
        updateRefValue(enableCheckInAfterRegistration, props.modelValue.bag?.generalRegistrationSettings?.enableCheckInAfterRegistration ?? false);
        updateRefValue(displaySmsEnabled, props.modelValue.bag?.generalRegistrationSettings?.displaySmsEnabled ?? false);
        updateRefValue(smsEnabledByDefault, props.modelValue.bag?.generalRegistrationSettings?.smsEnabledByDefault ?? false);
        updateRefValue(displaySuffix, props.modelValue.bag?.generalRegistrationSettings?.displaySuffix.toString() ?? String(AdultsOrChildrenSelectionMode.AdultsAndChildren));

        updateRefValue(requiredAttributesForAdults, props.modelValue.bag?.adultRegistrationSettings?.requiredAttributesForAdults ?? []);
        updateRefValue(optionalAttributesForAdults, props.modelValue.bag?.adultRegistrationSettings?.optionalAttributesForAdults ?? []);
        updateRefValue(displayBirthdateForAdults, props.modelValue.bag?.adultRegistrationSettings?.displayBirthdateForAdults ?? RegistrationFieldDisplay.Hide);
        updateRefValue(displayRaceForAdults, props.modelValue.bag?.adultRegistrationSettings?.displayRaceForAdults ?? RegistrationFieldDisplay.Hide);
        updateRefValue(displayEthnicityForAdults, props.modelValue.bag?.adultRegistrationSettings?.displayEthnicityForAdults ?? RegistrationFieldDisplay.Hide);
        updateRefValue(displayAlternateIdForAdults, props.modelValue.bag?.adultRegistrationSettings?.displayAlternateIdForAdults ?? false);

        updateRefValue(requiredAttributesForChildren, props.modelValue.bag?.childRegistrationSettings?.requiredAttributesForChildren ?? []);
        updateRefValue(optionalAttributesForChildren, props.modelValue.bag?.childRegistrationSettings?.optionalAttributesForChildren ?? []);
        updateRefValue(displayBirthdateForChildren, props.modelValue.bag?.childRegistrationSettings?.displayBirthdateForChildren ?? RegistrationFieldDisplay.Hide);
        updateRefValue(displayGradeForChildren, props.modelValue.bag?.childRegistrationSettings?.displayGradeForChildren ?? RegistrationFieldDisplay.Hide);
        updateRefValue(displayMobilePhoneForChildren, props.modelValue.bag?.childRegistrationSettings?.displayMobilePhoneForChildren.toString() ?? String(RequirementLevel.Optional));
        updateRefValue(displayRaceForChildren, props.modelValue.bag?.childRegistrationSettings?.displayRaceForChildren ?? RegistrationFieldDisplay.Hide);
        updateRefValue(displayEthnicityForChildren, props.modelValue.bag?.childRegistrationSettings?.displayEthnicityForChildren ?? RegistrationFieldDisplay.Hide);
        updateRefValue(displayAlternateIdForChildren, props.modelValue.bag?.childRegistrationSettings?.displayAlternateIdForChildren ?? false);
        updateRefValue(requireRelationshipTypeSelectionForChildren, props.modelValue.bag?.childRegistrationSettings?.requireRelationshipTypeSelectionForChildren ?? false);
        updateRefValue(gradeConfirmationAge, props.modelValue.bag?.childRegistrationSettings?.gradeConfirmationAge ?? null);

        updateRefValue(displayAddressForFamilies, props.modelValue.bag?.familyRegistrationSettings?.displayAddressForFamilies.toString() ?? String(RequirementLevel.Optional));
        updateRefValue(requiredAttributesForFamilies, props.modelValue.bag?.familyRegistrationSettings?.requiredAttributesForFamilies ?? []);
        updateRefValue(optionalAttributesForFamilies, props.modelValue.bag?.familyRegistrationSettings?.optionalAttributesForFamilies ?? []);

        updateRefValue(childRelationshipTypes, props.modelValue.bag?.childRelationshipSettings?.childRelationshipTypes ?? []);
        updateRefValue(addChildToParentsFamilyRelationshipTypes, props.modelValue.bag?.childRelationshipSettings?.addChildToParentsFamilyRelationshipTypes ?? []);
        updateRefValue(addChildToNewFamilyRelationshipTypes, props.modelValue.bag?.childRelationshipSettings?.addChildToNewFamilyRelationshipTypes ?? []);

        updateRefValue(newFamilyWorkflowTypes, props.modelValue.bag?.registrationWorkflowSettings?.newFamilyWorkflowTypes ?? []);
        updateRefValue(newPersonWorkflowTypes, props.modelValue.bag?.registrationWorkflowSettings?.newPersonWorkflowTypes ?? []);

        updateRefValue(abilityLevelDetermination, props.modelValue.bag?.additionalFiltersAndSettings?.abilityLevelDetermination?.toString() ?? String(AbilityLevelDeterminationMode.Ask));
        updateRefValue(gradeAndAgeMatchingBehavior, props.modelValue.bag?.additionalFiltersAndSettings?.gradeAndAgeMatchingBehavior?.toString() ?? String(GradeAndAgeMatchingMode.GradeAndAgeMustMatch));
        updateRefValue(ageRestriction, props.modelValue.bag?.additionalFiltersAndSettings?.ageRestriction?.toString() ?? String(AgeRestrictionMode.ShowAll));
        updateRefValue(enableProximityCheckIn, props.modelValue.bag?.additionalFiltersAndSettings?.enableProximityCheckIn ?? false);
        updateRefValue(proximityAttendanceNotificationTemplate, props.modelValue.bag?.additionalFiltersAndSettings?.proximityAttendanceNotificationTemplate ?? "");
        updateRefValue(preventInactivePeople, props.modelValue.bag?.additionalFiltersAndSettings?.preventInactivePeople ?? false);
        updateRefValue(ageRequired, props.modelValue.bag?.additionalFiltersAndSettings?.ageRequired ?? false);
        updateRefValue(gradeRequired, props.modelValue.bag?.additionalFiltersAndSettings?.gradeRequired ?? false);

        updateRefValue(hideSpecialNeedsGroups, props.modelValue.bag?.specialNeedsSettings?.hideSpecialNeedsGroups ?? false);
        updateRefValue(hideNonSpecialNeedsGroups, props.modelValue.bag?.specialNeedsSettings?.hideNonSpecialNeedsGroups ?? false);

        updateRefValue(attributes, props.modelValue.bag?.attributes ?? {});
        updateRefValue(attributeValues, props.modelValue.bag?.attributeValues ?? {});

        updateRefValue(refreshInterval, props.modelValue.bag?.classicDisplaySettings?.refreshInterval ?? null);
        updateRefValue(successTemplateDisplayMode, props.modelValue.bag?.classicDisplaySettings?.successTemplateDisplayMode?.toString() ?? String(SuccessLavaTemplateDisplayMode.Never));
        updateRefValue(successTemplate, props.modelValue.bag?.classicDisplaySettings?.successTemplate ?? "");

        updateRefValue(startTemplate, props.modelValue.bag?.classicTemplatesSettings?.startTemplate ?? "");
        updateRefValue(familySelectTemplate, props.modelValue.bag?.classicTemplatesSettings?.familySelectTemplate ?? "");
        updateRefValue(personSelectTemplate, props.modelValue.bag?.classicTemplatesSettings?.personSelectTemplate ?? "");

        updateRefValue(actionSelectHeaderTemplate, props.modelValue.bag?.classicCustomHeaderTextSettings?.actionSelectHeaderTemplate ?? "");
        updateRefValue(checkoutPersonSelectHeaderTemplate, props.modelValue.bag?.classicCustomHeaderTextSettings?.checkoutPersonSelectHeaderTemplate ?? "");
        updateRefValue(personSelectHeaderTemplate, props.modelValue.bag?.classicCustomHeaderTextSettings?.personSelectHeaderTemplate ?? "");
        updateRefValue(multiPersonSelectHeaderTemplate, props.modelValue.bag?.classicCustomHeaderTextSettings?.multiPersonSelectHeaderTemplate ?? "");
        updateRefValue(groupTypeSelectHeaderTemplate, props.modelValue.bag?.classicCustomHeaderTextSettings?.groupTypeSelectHeaderTemplate ?? "");
        updateRefValue(timeSelectHeaderTemplate, props.modelValue.bag?.classicCustomHeaderTextSettings?.timeSelectHeaderTemplate ?? "");
        updateRefValue(abilityLevelSelectHeaderTemplate, props.modelValue.bag?.classicCustomHeaderTextSettings?.abilityLevelSelectHeaderTemplate ?? "");
        updateRefValue(locationSelectHeaderTemplate, props.modelValue.bag?.classicCustomHeaderTextSettings?.locationSelectHeaderTemplate ?? "");
        updateRefValue(groupSelectHeaderTemplate, props.modelValue.bag?.classicCustomHeaderTextSettings?.groupSelectHeaderTemplate ?? "");
    });

    // Determines which values we want to track changes on (defined in the
    // array) and then emit a new object defined as newValue.
    watch([...propRefs, ...typeFlowSettingsRefs, ...kioskFeaturesSettingsRefs, ...displaySettingsRefs, ...supervisionSettingsRefs, ...searchSettingsRefs, ...securityCodesSettingsRefs, ...generalRegistrationSettingsRefs, ...adultRegistrationSettingsRefs, ...childRegistrationSettingsRefs, ...familyRegistrationSettingsRefs, ...childRelationshipSettingsRefs, ...registrationWorkflowSettingsRefs, ...additionalFiltersAndSettingsRefs, ...specialNeedsSettingsRefs, ...customAttributeRefs, ...classicDisplaySettingsRefs, ...classicTemplatesSettingsRefs, ...classicCustomHeaderTextSettingsRefs], () => {
        const newValue: ValidPropertiesBox<CheckInConfigurationSettingsBag> = {
            bag: { ...props.modelValue.bag } as CheckInConfigurationSettingsBag,
            validProperties: props.modelValue.validProperties
        };

        const basicSettings: CheckInBasicSettingsBag = {
            ...(props.modelValue.bag?.basicSettings ?? {}),
            name: name.value,
            iconCssClass: iconCssClass.value,
            description: description.value
        };

        const typeFlowSettings: CheckInTypeFlowSettingsBag = {
            ...(props.modelValue.bag?.typeFlowSettings ?? {}),
            checkInType: checkInType.value,
            autoSelectOptions: toNumberOrNull(autoSelectOptions.value) as AutoSelectMode | null,
            autoSelectDaysBack: autoSelectDaysBack.value,
            useSameOptions: useSameOptions.value,
            preventDuplicateCheckin: preventDuplicateCheckin.value
        };

        const kioskFeaturesSettings: CheckInKioskFeaturesSettingsBag = {
            ...(props.modelValue.bag?.kioskFeaturesSettings ?? {}),
            allowCheckoutAtKiosk: allowCheckoutAtKiosk.value,
            enableRemoveFamilyKiosk: enableRemoveFamilyKiosk.value,
            enablePresence: enablePresence.value
        };

        const displaySettings: CheckInDisplaySettingsBag = {
            ...(props.modelValue.bag?.displaySettings ?? {}),
            promotionsContentChannelGuid: promotionsContentChannelGuid.value,
            hidePhotos: hidePhotos.value,
            displayLocationCount: displayLocationCount.value,
            achievementTypes: achievementTypes.value
        };

        const supervisionSettings: CheckInSupervisionSettingsBag = {
            ...(props.modelValue.bag?.supervisionSettings ?? {}),
            enableManager: enableManager.value,
            enableOverride: enableOverride.value,
            allowCheckoutInManager: allowCheckoutInManager.value
        };

        const searchSettings: CheckInSearchSettingsBag = {
            ...(props.modelValue.bag?.searchSettings ?? {}),
            searchType: searchType.value,
            minPhoneLength: minPhoneLength.value,
            maxPhoneLength: maxPhoneLength.value,
            phoneSearchType: toNumberOrNull(phoneSearchType.value) as PhoneSearchMode | null,
            maxResults: maxResults.value,
            searchRegex: searchRegex.value
        };

        const securityCodesSettings: CheckInSecurityCodesSettingsBag = {
            ...(props.modelValue.bag?.securityCodesSettings ?? {}),
            codeAlphaNumericLength: codeAlphaNumericLength.value,
            codeAlphaLength: codeAlphaLength.value,
            codeNumericLength: codeNumericLength.value,
            codeRandom: codeRandom.value,
            useSameCodeForFamily: useSameCodeForFamily.value
        };

        const generalRegistrationSettings: CheckInGeneralRegistrationSettingsBag = {
            ...(props.modelValue.bag?.generalRegistrationSettings ?? {}),
            defaultPersonConnectionStatus: defaultPersonConnectionStatus.value,
            defaultPersonRecordSource: defaultPersonRecordSource.value,
            enableCheckInAfterRegistration: enableCheckInAfterRegistration.value,
            displaySmsEnabled: displaySmsEnabled.value,
            smsEnabledByDefault: smsEnabledByDefault.value,
            displaySuffix: toNumberOrNull(displaySuffix.value) as AdultsOrChildrenSelectionMode
        };

        const adultRegistrationSettings: CheckInAdultRegistrationSettingsBag = {
            ...(props.modelValue.bag?.adultRegistrationSettings ?? {}),
            requiredAttributesForAdults: requiredAttributesForAdults.value,
            optionalAttributesForAdults: optionalAttributesForAdults.value,
            displayBirthdateForAdults: displayBirthdateForAdults.value,
            displayRaceForAdults: displayRaceForAdults.value,
            displayEthnicityForAdults: displayEthnicityForAdults.value,
            displayAlternateIdForAdults: displayAlternateIdForAdults.value
        };

        const childRegistrationSettings: CheckInChildRegistrationSettingsBag = {
            ...(props.modelValue.bag?.childRegistrationSettings ?? {}),
            requiredAttributesForChildren: requiredAttributesForChildren.value,
            optionalAttributesForChildren: optionalAttributesForChildren.value,
            displayBirthdateForChildren: displayBirthdateForChildren.value,
            displayGradeForChildren: displayGradeForChildren.value,
            displayMobilePhoneForChildren: toNumberOrNull(displayMobilePhoneForChildren.value) as RequirementLevel,
            displayRaceForChildren: displayRaceForChildren.value,
            displayEthnicityForChildren: displayEthnicityForChildren.value,
            displayAlternateIdForChildren: displayAlternateIdForChildren.value,
            requireRelationshipTypeSelectionForChildren: requireRelationshipTypeSelectionForChildren.value,
            gradeConfirmationAge: gradeConfirmationAge.value
        };

        const familyRegistrationSettings: CheckInFamilyRegistrationSettingsBag = {
            ...(props.modelValue.bag?.familyRegistrationSettings ?? {}),
            displayAddressForFamilies: toNumberOrNull(displayAddressForFamilies.value) as RequirementLevel,
            requiredAttributesForFamilies: requiredAttributesForFamilies.value,
            optionalAttributesForFamilies: optionalAttributesForFamilies.value
        };

        const childRelationshipSettings: CheckInChildRelationshipSettingsBag = {
            ...(props.modelValue.bag?.childRelationshipSettings ?? {}),
            childRelationshipTypes: childRelationshipTypes.value,
            addChildToParentsFamilyRelationshipTypes: addChildToParentsFamilyRelationshipTypes.value,
            addChildToNewFamilyRelationshipTypes: addChildToNewFamilyRelationshipTypes.value
        };

        const registrationWorkflowSettings: CheckInRegistrationWorkflowSettingsBag = {
            ...(props.modelValue.bag?.registrationWorkflowSettings ?? {}),
            newFamilyWorkflowTypes: newFamilyWorkflowTypes.value,
            newPersonWorkflowTypes: newPersonWorkflowTypes.value
        };

        const additionalFiltersAndSettings: CheckInAdditionalFiltersAndSettingsBag = {
            ...(props.modelValue.bag?.additionalFiltersAndSettings ?? {}),
            abilityLevelDetermination: toNumberOrNull(abilityLevelDetermination.value) as AbilityLevelDeterminationMode | null,
            gradeAndAgeMatchingBehavior: toNumberOrNull(gradeAndAgeMatchingBehavior.value) as GradeAndAgeMatchingMode | null,
            ageRestriction: toNumberOrNull(ageRestriction.value) as AgeRestrictionMode | null,
            enableProximityCheckIn: enableProximityCheckIn.value,
            proximityAttendanceNotificationTemplate: proximityAttendanceNotificationTemplate.value,
            preventInactivePeople: preventInactivePeople.value,
            ageRequired: ageRequired.value,
            gradeRequired: gradeRequired.value
        };

        const specialNeedsSettings: CheckInSpecialNeedsSettingsBag = {
            ...(props.modelValue.bag?.specialNeedsSettings ?? {}),
            hideSpecialNeedsGroups: hideSpecialNeedsGroups.value,
            hideNonSpecialNeedsGroups: hideNonSpecialNeedsGroups.value
        };

        // This should suffice for now, but if a conclusion is reached on how to
        // handle bags with nested properties, this will warrant a second look.
        setPropertiesBoxValue(newValue, "basicSettings", basicSettings);
        setPropertiesBoxValue(newValue, "typeFlowSettings", typeFlowSettings);
        setPropertiesBoxValue(newValue, "kioskFeaturesSettings", kioskFeaturesSettings);
        setPropertiesBoxValue(newValue, "displaySettings", displaySettings);
        setPropertiesBoxValue(newValue, "supervisionSettings", supervisionSettings);
        setPropertiesBoxValue(newValue, "searchSettings", searchSettings);
        setPropertiesBoxValue(newValue, "securityCodesSettings", securityCodesSettings);
        setPropertiesBoxValue(newValue, "generalRegistrationSettings", generalRegistrationSettings);
        setPropertiesBoxValue(newValue, "adultRegistrationSettings", adultRegistrationSettings);
        setPropertiesBoxValue(newValue, "childRegistrationSettings", childRegistrationSettings);
        setPropertiesBoxValue(newValue, "familyRegistrationSettings", familyRegistrationSettings);
        setPropertiesBoxValue(newValue, "childRelationshipSettings", childRelationshipSettings);
        setPropertiesBoxValue(newValue, "registrationWorkflowSettings", registrationWorkflowSettings);
        setPropertiesBoxValue(newValue, "additionalFiltersAndSettings", additionalFiltersAndSettings);
        setPropertiesBoxValue(newValue, "specialNeedsSettings", specialNeedsSettings);
        setPropertiesBoxValue(newValue, "attributeValues", attributeValues.value);

        const classicDisplaySettings: CheckInClassicDisplaySettingsBag = {
            ...(props.modelValue.bag?.classicDisplaySettings ?? {}),
            refreshInterval: refreshInterval.value,
            successTemplateDisplayMode: toNumberOrNull(successTemplateDisplayMode.value) as SuccessLavaTemplateDisplayMode | null,
            successTemplate: successTemplate.value
        };
        setPropertiesBoxValue(newValue, "classicDisplaySettings", classicDisplaySettings);

        const classicTemplatesSettings: CheckInClassicTemplatesSettingsBag = {
            ...(props.modelValue.bag?.classicTemplatesSettings ?? {}),
            startTemplate: startTemplate.value,
            familySelectTemplate: familySelectTemplate.value,
            personSelectTemplate: personSelectTemplate.value
        };
        setPropertiesBoxValue(newValue, "classicTemplatesSettings", classicTemplatesSettings);

        const classicCustomHeaderTextSettings: CheckInClassicCustomHeaderTextSettingsBag = {
            ...(props.modelValue.bag?.classicCustomHeaderTextSettings ?? {}),
            actionSelectHeaderTemplate: actionSelectHeaderTemplate.value,
            checkoutPersonSelectHeaderTemplate: checkoutPersonSelectHeaderTemplate.value,
            personSelectHeaderTemplate: personSelectHeaderTemplate.value,
            multiPersonSelectHeaderTemplate: multiPersonSelectHeaderTemplate.value,
            groupTypeSelectHeaderTemplate: groupTypeSelectHeaderTemplate.value,
            timeSelectHeaderTemplate: timeSelectHeaderTemplate.value,
            abilityLevelSelectHeaderTemplate: abilityLevelSelectHeaderTemplate.value,
            locationSelectHeaderTemplate: locationSelectHeaderTemplate.value,
            groupSelectHeaderTemplate: groupSelectHeaderTemplate.value
        };
        setPropertiesBoxValue(newValue, "classicCustomHeaderTextSettings", classicCustomHeaderTextSettings);

        emit("update:modelValue", newValue);
    });

    // #endregion Watchers

    // Watch for any changes to props that represent properties and then
    // automatically emit which property changed.
    watchPropertyChanges(propRefs, emit);
</script>
