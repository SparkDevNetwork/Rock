<template>
    <ContextSlicer title="Filters"
                   class="connection-opportunity-navigation-slicer"
                   showCampus>
        <DropDownList v-model="area"
                      :items="areaItems ?? []"
                      :showBlankItem="true"
                      blankValue="All Areas" />
    </ContextSlicer>

    <Panel title="Schedule Builder"
           :headerSecondaryActions="secondaryActions"
           v-model:quickFilterValue="quickFilterValue"
           hasNoBodyPadding>
        <template #headerActions>
            <HighlightLabel>
                {{ getCountLabelText }}
            </HighlightLabel>
        </template>

        <template #subheaderLeft>
            <div class="check-in-schedule-builder-filters row">
                <div v-if="!config.hasValidCheckInConfigurationPageParam" class="col-md-4">
                    <GroupTypePicker v-model="groupType"
                                     label="Group Type"
                                     :groupTypes="[...groupTypeItems]"
                                     :showBlankItem="true"
                                     blankValue="All" />
                </div>

                <div class="col-md-4">
                    <LocationItemPicker v-model="parentLocation"
                                        label="Parent Location"
                                        :rootLocationGuid="parentLocationRootGuid"
                                        inputClasses="input-width-xl" />
                </div>

                <div class="col-md-4">
                    <CategoryPicker v-model="scheduleCategory"
                                    label="Schedule Category"
                                    :entityTypeGuid="EntityType.Schedule"
                                    inputClasses="input-width-xl" />
                </div>
            </div>

            <NotificationBox v-if="showNoGroupLocationsWarning"
                             :alertType="AlertType.Warning"
                             heading="Warning: ">
                No group locations found. Consider <a class="alert-link" href="/admin/checkin/configuration">adding a group location</a> or changing your filters.
            </NotificationBox>
            <NotificationBox v-else-if="showNoSchedulesWarning"
                             :alertType="AlertType.Warning"
                             heading="Warning: ">
                No schedules found. Consider <a class="alert-link" href="/admin/checkin/schedules">adding a schedule</a> or changing your filters.
            </NotificationBox>
        </template>

        <template v-if="showGrid" #default>
            <div class="check-in-schedule-builer-grid">
                <CheckInScheduleBuilderGrid :groupLocations="filteredGroupLocations"
                                            :schedules="schedules"
                                            :disabled="isDisabled" />
            </div>
        </template>

        <template #footerActions>
            <div class="check-in-schedule-builder-actions">
                <RockButton :btnType="BtnType.Primary"
                            :isLoading="isSaving"
                            :disabled="isDisabled"
                            @click="onSaveClick">
                    Save
                </RockButton>
                <RockButton :btnType="BtnType.Link"
                            :disabled="isSaving || isLoading"
                            @click="onCancel">
                    Cancel
                </RockButton>
                <NotificationBox v-if="showSaveNotification"
                                 :alertType="saveNotificationType"
                                 class="mb-0">
                    {{ saveNotificationText }}
                </NotificationBox>
            </div>
        </template>
    </Panel>

    <Modal v-model="showCloneScheduleModal" title="Copy Schedule">
        <RockForm v-model:submit="submitClonedSchedule" @submit="processClonedSchedule">
            <NotificationBox alertType="info">This will copy all the enabled locations from the source schedule into the destination schedule. Note: The Schedule Builder will need to be saved after cloning a schedule.</NotificationBox>
            <div class="row">
                <div class="col-md-6">
                    <SchedulePicker v-model="sourceSchedule" label="Source Schedule" rules="required" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <SchedulePicker v-model="destinationSchedule" label="Destination Schedule" rules="required" />
                </div>
            </div>
        </RockForm>

        <template #customButtons>
            <RockButton btnType="primary" @click="submitClonedSchedule = true">Add</RockButton>
        </template>
    </Modal>
</template>

<script setup lang="ts">
    import { computed, onMounted, ref, watch } from "vue";
    import CheckInScheduleBuilderGrid from "./CheckInScheduleBuilder/checkinScheduleBuilderGrid.partial.obs";
    import { PreferenceKey, NavigationUrlKey } from "./CheckInScheduleBuilder/types.partial";
    import CategoryPicker from "@Obsidian/Controls/categoryPicker.obs";
    import ContextSlicer from "@Obsidian/Controls/contextSlicer.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import GroupTypePicker from "@Obsidian/Controls/groupTypePicker.obs";
    import HighlightLabel from "@Obsidian/Controls/highlightLabel.obs";
    import LocationItemPicker from "@Obsidian/Controls/locationItemPicker.obs";
    import Modal from "@Obsidian/Controls/modal.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import SchedulePicker from "@Obsidian/Controls/schedulePicker.obs";
    import { useContextEntities } from "@Obsidian/Core/Utilities/contextEntity";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { Guid } from "@Obsidian/Types";
    import { PanelAction } from "@Obsidian/Types/Controls/panelAction";
    import { ContextEntityChangedData, Message } from "@Obsidian/Types/Utility/browserBus";
    import { onConfigurationValuesChanged, useBlockBrowserBus, useConfigurationValues, useInvokeBlockAction, usePersonPreferences, useReloadBlock } from "@Obsidian/Utility/block";
    import { PageMessages } from "@Obsidian/Utility/browserBus";
    import { alert } from "@Obsidian/Utility/dialogs";
    import { areEqual } from "@Obsidian/Utility/guid";
    import { makeUrlRedirectSafe } from "@Obsidian/Utility/url";
    import { CheckInScheduleBuilderDataBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInScheduleBuilder/checkInScheduleBuilderDataBag";
    import { CheckInScheduleBuilderOptionsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInScheduleBuilder/checkInScheduleBuilderOptionsBag";
    import { CloneScheduleBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInScheduleBuilder/cloneScheduleBag";
    import { GroupLocationsBag } from "@Obsidian/ViewModels/Blocks/CheckIn/Configuration/CheckInScheduleBuilder/groupLocationsBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    const config = useConfigurationValues<CheckInScheduleBuilderOptionsBag>();
    const preferences = usePersonPreferences().blockPreferences;
    const browserBus = useBlockBrowserBus();
    const contextEntities = useContextEntities();
    const invokeBlockAction = useInvokeBlockAction();

    onConfigurationValuesChanged(useReloadBlock());

    browserBus.subscribe(PageMessages.ContextEntityChanged, async (message: Message<ContextEntityChangedData>) => {
        if (areEqual(message.data.entityTypeGuid, EntityType.Campus)) {
            await updateParentLocationRootGuid();
            await loadScheduleBuilderData();
        }
    });

    // #region Values

    const hasCompletedInitialLoad = ref(false);

    const saveNotificationType = ref<AlertType>(AlertType.Success);
    const saveNotificationText = ref<string>("");
    const showSaveNotification = ref<boolean>(false);
    const isSaving = ref<boolean>(false);
    const isLoading = ref<boolean>(false);
    const groupLocations = ref<GroupLocationsBag[]>([]);
    const schedules = ref<ListItemBag[]>([]);

    // Filter Data
    const quickFilterValue = ref<string>("");
    const parentLocationRootGuid = ref<string | null>(null);
    const areaItems = ref<ListItemBag[]>(config.areas ?? []);
    const groupTypeItems = ref<Guid[]>(config.groupTypes ?? []);
    const groupType = ref<ListItemBag>(preferences.getValue(PreferenceKey.SelectedGroupType) ? JSON.parse(preferences.getValue(PreferenceKey.SelectedGroupType)) : {});
    const parentLocation = ref<ListItemBag>(preferences.getValue(PreferenceKey.SelectedParentLocation) ? JSON.parse(preferences.getValue(PreferenceKey.SelectedParentLocation)) : {});
    const area = ref<string>(preferences.getValue(PreferenceKey.SelectedArea));
    const scheduleCategory = ref<ListItemBag>(preferences.getValue(PreferenceKey.SelectedCategory) ? JSON.parse(preferences.getValue(PreferenceKey.SelectedCategory)) : (config.defaultScheduleCategory ?? {}));

    // Modal Data
    const showCloneScheduleModal = ref<boolean>(false);
    const submitClonedSchedule = ref<boolean>(false);
    const sourceSchedule = ref<ListItemBag>();
    const destinationSchedule = ref<ListItemBag>();

    // #endregion Values

    // #region Computed Values

    /** Gets the label text for the count of schedule locations. */
    const getCountLabelText = computed((): string => {
        if (groupLocations.value.length > filteredGroupLocations.value.length) {
            return `${filteredGroupLocations.value.length} of ${groupLocations.value.length} Schedule Locations`;
        }
        return groupLocations.value.length === 1 ? `${groupLocations.value.length} Schedule Location` : `${groupLocations.value.length} Schedule Locations`;
    });

    /**
     * Gets the list of secondary action items to be included in the panel.
     */
    const secondaryActions = computed((): PanelAction[] => {
        const actions: PanelAction[] = [{
            title: "Clone Schedule",
            iconCssClass: "ti ti-copy-plus",
            type: "default",
            handler: (_: Event) => {
                showCloneScheduleModal.value = true;
            }
        }];

        return actions;
    });

    /** Gets the filtered list of group locations based on the quick filter value. */
    const filteredGroupLocations = computed((): GroupLocationsBag[] => {
        return groupLocations.value.filter(location => {
            const searchTerm = quickFilterValue.value.toLowerCase();

            return (
                location.groupPath?.toLowerCase().includes(searchTerm) ||
                location.areaPath?.toLowerCase().includes(searchTerm) ||
                location.locationPath?.toLowerCase().includes(searchTerm) ||
                location.locationName?.toLowerCase().includes(searchTerm)
            );
        });
    });

    /** Determines if there are any group locations available. */
    const anyGroupLocations = computed((): boolean => {
        return groupLocations.value.length > 0;
    });

    /** Determines if there are any schedules available. */
    const anySchedules = computed((): boolean => {
        return schedules.value.length > 0;
    });

    /** Determines if the no group locations warning should be shown. */
    const showNoGroupLocationsWarning = computed((): boolean => {
        return hasCompletedInitialLoad.value && !isLoading.value && !anyGroupLocations.value;
    });

    /** Determines if the no schedules warning should be shown. */
    const showNoSchedulesWarning = computed((): boolean => {
        return hasCompletedInitialLoad.value && !isLoading.value && !anySchedules.value;
    });

    /** Determines if the schedule builder grid should be shown. */
    const showGrid = computed((): boolean => {
        return anyGroupLocations.value && anySchedules.value;
    });

    /** Determines if the schedule builder grid should be disabled. */
    const isDisabled = computed((): boolean => {
        return isLoading.value
            || isSaving.value
            || schedules.value.length === 0;
    });

    // #endregion Computed Values

    // #region Functions

    /**
     * Resolves the current campus context and updates parentLocationRootGuid
     * to scope the Parent Location picker to that campus's location tree.
     */
    async function updateParentLocationRootGuid(): Promise<void> {
        const campusBag = await contextEntities.get(EntityType.Campus);
        const campusGuid = campusBag?.value ?? null;
        parentLocationRootGuid.value = (campusGuid && config.campusRootLocations?.[campusGuid]) || null;
    }

    /**
     * Loads the schedule builder data.
     */
    async function loadScheduleBuilderData(): Promise<void> {
        isLoading.value = true;
        const response = await invokeBlockAction<CheckInScheduleBuilderDataBag>("LoadGroupScheduleLocationData");

        if (response.isSuccess && response.data) {
            groupLocations.value = response.data?.groupLocations ?? [];
            schedules.value = response.data?.schedules ?? [];
            isLoading.value = false;
        }

        hasCompletedInitialLoad.value = true;
    }

    /**
     * Saves the current group's location schedule settings.
     */
    async function onSaveClick(): Promise<void> {
        isSaving.value = true;
        const data = {
            scheduledLocations: groupLocations.value
        };

        const response = await invokeBlockAction("Save", data);

        if (response.isSuccess) {
            saveNotificationType.value = AlertType.Success;
            saveNotificationText.value = "Changes have been saved.";
        }
        else {
            saveNotificationType.value = AlertType.Danger;
            saveNotificationText.value = response.errorMessage ?? "Unknown error while saving schedule information.";
        }

        isSaving.value = false;
        showSaveNotification.value = true;
        if (config.navigationUrls?.[NavigationUrlKey.ParentPage]) {
            window.location.href = makeUrlRedirectSafe(config.navigationUrls[NavigationUrlKey.ParentPage]);
        }
        else {
            setTimeout(() => {
                showSaveNotification.value = false;
            }, 3000);
        }
    }

    /**
     * Processes the clone schedule operation and sets the groupLocations value to the
     * result of the clone process.
     */
    async function processClonedSchedule(): Promise<void> {
        const data: CloneScheduleBag = {
            sourceSchedule: sourceSchedule.value,
            destinationSchedule: destinationSchedule.value,
            currentScheduleConfiguration: groupLocations.value
        };

        const response = await invokeBlockAction<GroupLocationsBag[]>("ProcessClonedSchedule", {
            bag: data
        });

        if (response.isSuccess && response.data) {
            submitClonedSchedule.value = false;
            showCloneScheduleModal.value = false;
            groupLocations.value = response.data ?? [];
            return;
        }

        await alert(response.errorMessage || "Unknown error while cloning schedule information.");
    }

    /**
     * Event handler for the Cancel button being clicked while in Edit or Add mode.
     * Handles redirect to parent page.
     */
    function onCancel(): void {
        if (config.navigationUrls?.[NavigationUrlKey.ParentPage]) {
            window.location.href = makeUrlRedirectSafe(config.navigationUrls[NavigationUrlKey.ParentPage]);
        }
    }

    // #endregion Functions

    // #region Watchers

    watch([groupType, parentLocation, area, scheduleCategory], async () => {
        preferences.setValue(PreferenceKey.SelectedGroupType, JSON.stringify(groupType.value));
        preferences.setValue(PreferenceKey.SelectedParentLocation, JSON.stringify(parentLocation.value));
        preferences.setValue(PreferenceKey.SelectedArea, area.value);
        preferences.setValue(PreferenceKey.SelectedCategory, JSON.stringify(scheduleCategory.value));

        await preferences.save();
        await loadScheduleBuilderData();
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(async () => {
        await updateParentLocationRootGuid();
        await loadScheduleBuilderData();
    });

    // #endregion Lifecycle Hooks

</script>
