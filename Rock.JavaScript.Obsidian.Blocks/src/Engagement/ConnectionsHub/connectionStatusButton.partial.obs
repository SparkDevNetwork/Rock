<template>
    <div v-if="isSequentialStatusMode"
         class="connectionstatus-button"
         :class="{ 'cursor-not-allowed': disabled }"
         :style="`background-color: ${highlightColor}`">
        <span :ref="(el) => addTooltipIfOverflow(el as HTMLElement, currentStatusName ?? '')">{{ currentStatusName }}</span>
        <i class="ti ti-circle-check" aria-hidden="true"></i>
    </div>
    <div v-else
         class="connectionstatus-button"
         :class="{ 'cursor-not-allowed': disabled }"
         :style="`background-color: ${highlightColor}`">
        <span :ref="(el) => addTooltipIfOverflow(el as HTMLElement, currentStatusName ?? '')">{{ currentStatusName }}</span>
        <i class="ti ti-caret-down-filled"></i>
    </div>
</template>


<script setup lang="ts">
    import { PropType } from "vue";
    import { addTooltipIfOverflow } from "./types.partial";

    defineProps({
        isSequentialStatusMode: {
            type: Boolean as PropType<boolean | null | undefined>,
            required: true
        },

        highlightColor: {
            type: String as PropType<string | null | undefined>,
            required: true
        },

        currentStatusName: {
            type: String as PropType<string | null | undefined>,
            required: true
        },

        disabled: {
            type: Boolean as PropType<boolean>,
            default: false
        }
    });
</script>
