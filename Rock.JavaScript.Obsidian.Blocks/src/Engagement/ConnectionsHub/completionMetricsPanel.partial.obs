<template>
    <div class="completion-metrics-grid">
        <KpiTile v-for="tile in tiles"
                 isBorderless
                 :key="tile.label"
                 variant="light"
                 :label="tile.label"
                 :help="tile.help"
                 :value="tile.value">
            <template #footer>
                <span :style="{ color: tile.color }">{{ tile.difference || '-' }}</span> {{ footerSuffix }}
            </template>
        </KpiTile>
    </div>
</template>

<script setup lang="ts">
    /**
     * completionMetricsPanel.partial.obs - Renders the four connection completion metric tiles
     * (Timeliness, Responsiveness, Requests Completed, Average Time to Complete) for the
     * Connections Hub snapshot, each showing a current value and a color-coded delta versus
     * the comparison period.
     *
     * The tile presentation comes from the shared KpiTile control; this partial owns only the
     * metric-to-tile mapping (value/delta formatting and trend coloring).
     */
    import { computed, PropType } from "vue";
    import KpiTile from "@Obsidian/Controls/kpiTile.obs";
    import { CompletionMetricsBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/completionMetricsBag";

    const props = defineProps({
        /**
         * The completion metrics payload. When null or undefined the tiles render
         * placeholder dashes.
         */
        metrics: {
            type: Object as PropType<CompletionMetricsBag | null | undefined>,
            default: null
        },

        /**
         * Suffix text appended after each tile's signed delta (e.g. " vs. Previous 28 Days").
         * Pass an empty string to suppress the comparative context.
         */
        footerSuffix: {
            type: String as PropType<string>,
            default: ""
        }
    });

    // Color tokens for the delta indicator. Strings are CSS variable references so they follow the theme.
    const positiveColor = "var(--color-success-strong)";
    const negativeColor = "var(--color-danger-strong)";
    const neutralColor = "var(--color-interface-medium)";

    type CompletionTile = {
        label: string;
        value: string;
        help: string;
        difference: string;
        color: string;
    };

    /** Formats a percentage delta for the tile footer. */
    function formatDeltaPercent(deltaPercent: number): string {
        if (deltaPercent > 0) {
            return `+${deltaPercent.toLocaleString(undefined, { style: "percent" })}`;
        }
        else if (deltaPercent < 0) {
            return deltaPercent.toLocaleString(undefined, { style: "percent" });
        }
        else {
            return "No change";
        }
    }

    /** Formats a decimal delta for the tile footer. */
    function formatDeltaDecimal(deltaDecimal: number): string {
        if (deltaDecimal > 0) {
            return `+${deltaDecimal.toLocaleString(undefined, { style: "decimal", maximumFractionDigits: 1 })}`;
        }
        else if (deltaDecimal < 0) {
            return deltaDecimal.toLocaleString(undefined, { style: "decimal", maximumFractionDigits: 1 });
        }
        else {
            return "No change";
        }
    }

    /** Returns the trend color for a metric where an increase is good. */
    function getTrendColor(delta: number): string {
        if (delta === 0) {
            return neutralColor;
        }
        else if (delta > 0) {
            return positiveColor;
        }
        else {
            return negativeColor;
        }
    }

    /** Returns the trend color for a metric where an increase is bad. */
    function getTrendColorInverted(delta: number): string {
        if (delta === 0) {
            return neutralColor;
        }
        else if (delta > 0) {
            return negativeColor;
        }
        else {
            return positiveColor;
        }
    }

    /** Formats a day count as "1 Day" or "N Days" (max 1 fraction digit). */
    function formatDays(days: number): string {
        return days === 1
            ? "1 Day"
            : `${days.toLocaleString(undefined, { style: "decimal", maximumFractionDigits: 1 })} Days`;
    }

    const tiles = computed<CompletionTile[]>(() => {
        const metrics = props.metrics;

        if (!metrics) {
            return [
                { label: "Timeliness", value: "-", help: "The percentage of completed requests that were finished on or before their due date during this period.", difference: "", color: neutralColor },
                { label: "Responsiveness (Rsp)", value: "-", help: "The average number of days between when a request was submitted and when a connector first acted on it during this period.", difference: "", color: neutralColor },
                { label: "Requests Completed", value: "-", help: "The total number of requests marked as completed during this period.", difference: "", color: neutralColor },
                { label: "Average Time to Complete", value: "-", help: "The average number of days from request submission to completion, across all requests closed in this period.", difference: "", color: neutralColor }
            ];
        }

        return [
            {
                label: "Timeliness",
                value: metrics.timelinessPercent.toLocaleString(undefined, { style: "percent" }),
                help: "The percentage of completed requests that were finished on or before their due date during this period.",
                difference: formatDeltaPercent(metrics.timelinessPercentDelta),
                color: getTrendColor(metrics.timelinessPercentDelta)
            },
            {
                label: "Responsiveness (Rsp)",
                value: formatDays(metrics.averageResponsivenessDays),
                help: "The average number of days between when a request was submitted and when a connector first acted on it during this period.",
                difference: formatDeltaDecimal(metrics.averageResponsivenessDaysDelta),
                // For responsiveness, an increase is a negative trend.
                color: getTrendColorInverted(metrics.averageResponsivenessDaysDelta)
            },
            {
                label: "Requests Completed",
                value: metrics.requestsCompletedCount.toLocaleString(),
                help: "The total number of requests marked as completed during this period.",
                difference: formatDeltaDecimal(metrics.requestsCompletedCountDelta),
                color: getTrendColor(metrics.requestsCompletedCountDelta)
            },
            {
                label: "Average Time to Complete",
                value: formatDays(metrics.averageCompletionDays),
                help: "The average number of days from request submission to completion, across all requests closed in this period.",
                difference: formatDeltaDecimal(metrics.averageCompletionDaysDelta),
                // For average time to complete, an increase is a negative trend.
                color: getTrendColorInverted(metrics.averageCompletionDaysDelta)
            }
        ];
    });
</script>
