<template>
    <KpiContainer :columns="4" isFlush>
        <KpiCard v-for="tile in tiles"
                 :key="tile.title"
                 :title="tile.title"
                 :help="tile.help"
                 :value="tile.value"
                 :valueTrend="tile.valueTrend"
                 :valueTrendTooltip="tile.valueTrendTooltip"
                 :valueDescription="tile.valueDescription"
                 :isLowerBetter="tile.isLowerBetter"
                 :hasError="hasError"
                 :isLoading="!metrics && !hasError" />
    </KpiContainer>
</template>

<script setup lang="ts">
    /**
     * completionMetricsPanel.partial.obs - Renders the four connection completion metric cards
     * (Timeliness, Responsiveness, Completed, Avg. Time to Complete) for the
     * Connections Hub snapshot, each showing a current value and the change versus the
     * comparison period.
     *
     * The card presentation comes from the shared KpiCard control; this partial owns only the
     * metric-to-card mapping (value and delta formatting). Every delta is an absolute
     * difference (percentage points, days or a count), not a percent change, so the card's
     * trend is given as a direction and the signed difference is written out beside it.
     */
    import { computed, PropType } from "vue";
    import KpiCard from "@Obsidian/Controls/kpiCard.obs";
    import KpiContainer from "@Obsidian/Controls/kpiContainer.obs";
    import { KpiHelpSection, KpiTrendDirection } from "@Obsidian/Core/Controls/kpi";
    import { CompletionMetricsBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/completionMetricsBag";

    // #region Types

    type CompletionTile = {
        title: string;
        help: KpiHelpSection[];
        value: string | null;
        valueTrend: KpiTrendDirection | null;
        valueTrendTooltip: string | null;
        valueDescription: string;
        isLowerBetter: boolean;
    };

    // #endregion Types

    const props = defineProps({
        /**
         * The completion metrics payload. When null or undefined the cards render
         * their loading state.
         */
        metrics: {
            type: Object as PropType<CompletionMetricsBag | null | undefined>,
            default: null
        },

        /**
         * When true the cards show their error state instead of loading, such as after the
         * metrics request failed. Takes precedence over the loading state.
         */
        hasError: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /**
         * Suffix text appended after each card's signed delta (e.g. " vs. Previous 28 Days").
         * Pass an empty string to suppress the comparative context.
         */
        footerSuffix: {
            type: String as PropType<string>,
            default: ""
        }
    });

    // #region Values

    const timelinessHelp: KpiHelpSection[] = [
        { text: "The percentage of completed requests that were finished on or before their due date during this period." }
    ];
    const responsivenessHelp: KpiHelpSection[] = [
        { text: "The average number of days between when a request was submitted and when a connector first acted on it during this period." }
    ];
    const requestsCompletedHelp: KpiHelpSection[] = [
        { text: "The total number of requests marked as completed during this period." }
    ];
    const averageCompletionHelp: KpiHelpSection[] = [
        { text: "The average number of days from request submission to completion, across all requests closed in this period." }
    ];

    // #endregion Values

    // #region Computed Values

    const tiles = computed<CompletionTile[]>(() => {
        const metrics = props.metrics;

        if (!metrics) {
            return [
                makeTile("Timeliness", timelinessHelp, null, null, false),
                makeTile("Responsiveness (Rsp)", responsivenessHelp, null, null, true),
                makeTile("Completed", requestsCompletedHelp, null, null, false),
                makeTile("Avg. Time to Complete", averageCompletionHelp, null, null, true)
            ];
        }

        return [
            makeTile(
                "Timeliness",
                timelinessHelp,
                metrics.timelinessPercent.toLocaleString(undefined, { style: "percent" }),
                { text: formatDeltaPercent(metrics.timelinessPercentDelta), delta: metrics.timelinessPercentDelta },
                false
            ),
            // For responsiveness, an increase is a negative trend.
            makeTile(
                "Responsiveness (Rsp)",
                responsivenessHelp,
                formatDays(metrics.averageResponsivenessDays),
                { text: formatDeltaDecimal(metrics.averageResponsivenessDaysDelta), delta: metrics.averageResponsivenessDaysDelta },
                true
            ),
            makeTile(
                "Completed",
                requestsCompletedHelp,
                metrics.requestsCompletedCount.toLocaleString(),
                { text: formatDeltaDecimal(metrics.requestsCompletedCountDelta), delta: metrics.requestsCompletedCountDelta },
                false
            ),
            // For average time to complete, an increase is a negative trend.
            makeTile(
                "Avg. Time to Complete",
                averageCompletionHelp,
                formatDays(metrics.averageCompletionDays),
                { text: formatDeltaDecimal(metrics.averageCompletionDaysDelta), delta: metrics.averageCompletionDaysDelta },
                true
            )
        ];
    });

    // #endregion Computed Values

    // #region Functions

    /** Formats a percentage delta for the card description. */
    function formatDeltaPercent(deltaPercent: number): string {
        if (deltaPercent > 0) {
            return `+${deltaPercent.toLocaleString(undefined, { style: "percent" })}`;
        }
        else if (deltaPercent < 0) {
            return deltaPercent.toLocaleString(undefined, { style: "percent" });
        }
        else {
            return "No change";
        }
    }

    /** Formats a decimal delta for the card description. */
    function formatDeltaDecimal(deltaDecimal: number): string {
        if (deltaDecimal > 0) {
            return `+${deltaDecimal.toLocaleString(undefined, { style: "decimal", maximumFractionDigits: 1 })}`;
        }
        else if (deltaDecimal < 0) {
            return deltaDecimal.toLocaleString(undefined, { style: "decimal", maximumFractionDigits: 1 });
        }
        else {
            return "No change";
        }
    }

    /** Formats a day count as "1 Day" or "N Days" (max 1 fraction digit). */
    function formatDays(days: number): string {
        return days === 1
            ? "1 Day"
            : `${days.toLocaleString(undefined, { style: "decimal", maximumFractionDigits: 1 })} Days`;
    }

    /** Gets the card trend direction for a delta. The card colors it using the card's lower-is-better setting. */
    function getTrendDirection(delta: number): KpiTrendDirection {
        if (delta > 0) {
            return KpiTrendDirection.Up;
        }
        else if (delta < 0) {
            return KpiTrendDirection.Down;
        }
        else {
            return KpiTrendDirection.Flat;
        }
    }

    /**
     * Builds the display model for one card.
     *
     * @param title The card title.
     * @param help The help popover sections.
     * @param value The formatted headline value, or null when there are no metrics yet.
     * @param difference The signed difference text and raw delta, or null when there are no metrics yet.
     * @param isLowerBetter True when a drop in the value is the better outcome.
     */
    function makeTile(title: string, help: KpiHelpSection[], value: string | null, difference: { text: string, delta: number } | null, isLowerBetter: boolean): CompletionTile {
        // The card has no slot for the signed difference, so it leads the description line.
        const description = difference
            ? [difference.text, props.footerSuffix.trim()].filter(part => part).join(" ")
            : "";

        return {
            title,
            help,
            value,
            valueTrend: difference ? getTrendDirection(difference.delta) : null,
            valueTrendTooltip: difference?.text ?? null,
            valueDescription: description,
            isLowerBetter
        };
    }

    // #endregion Functions
</script>
