<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Modal v-model="isVisible"
           title="View Options"
           saveText="Save"
           @save="onSave">
        <ContentSectionContainer :sidebar="false">
            <ContentSection title="View" icon="ti ti-eye" disableCollapse>
                <ContentStack>
                    <div class="row">
                        <div class="col-md-6">
                            <DropDownList v-model="sortBy"
                                          :items="sortByItems"
                                          label="Sort By" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <DropDownList v-model="gridDataToShow"
                                          :items="props.gridDataToShowItems"
                                          label="Grid Data to Show"
                                          multiple />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <CheckBox v-model="isRequestSourceShown"
                                      label=""
                                      text="Show Source of Request" />
                        </div>
                    </div>
                </ContentStack>
            </ContentSection>
            <ContentSection title="Filter" icon="ti ti-filter" disableCollapse>
                <ContentStack>
                    <CheckBoxList v-model="stateFilter"
                                  :items="props.connectionStates"
                                  label="State" />
                    <CheckBoxList v-if="!isMyConnectionsView"
                                  v-model="statusFilter"
                                  :items="connectionStatusItems"
                                  label="Status" />
                    <CheckBoxList v-model="dueFilter"
                                  :items="dueStatusItems"
                                  label="Due" />
                </ContentStack>
            </ContentSection>
            <ContentSection v-if="hasAttributeFilters && !isMyConnectionsView"
                            title="Attribute Filters"
                            icon="ti ti-binary-tree-2"
                            disableCollapse>
                <ContentStack>
                    <template v-for="(attr, index) in props.attributeFilters" :key="attr.key ?? index">
                        <div class="row">
                            <div v-if="attr.key" class="form-group attribute-filter-group col-md-6">
                                <RockLabel>{{ attr.name }}</RockLabel>
                                <RockAttributeFilter v-model="attributeFilterValues[attr.key]"
                                                     :attribute="attr" />
                            </div>
                        </div>
                    </template>
                </ContentStack>
            </ContentSection>
        </ContentSectionContainer>
    </Modal>
</template>

<script setup lang="ts">
    import Modal from "@Obsidian/Controls/modal.obs";
    import ContentSectionContainer from "@Obsidian/Controls/contentSectionContainer.obs";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import CheckBoxList from "@Obsidian/Controls/checkBoxList.obs";
    import RockAttributeFilter from "@Obsidian/Controls/rockAttributeFilter.obs";
    import RockLabel from "@Obsidian/Controls/rockLabel.obs";
    import { ref, PropType, watch, computed } from "vue";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import { deepEqual } from "@Obsidian/Utility/util";
    import { ViewOptions } from "./types.partial";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { PublicAttributeBag } from "@Obsidian/ViewModels/Utility/publicAttributeBag";
    import { ComparisonValue } from "@Obsidian/Types/Reporting/comparisonValue";
    import { enumToListItemBag } from "@Obsidian/Utility/enumUtils";
    import { DueStatusDescription } from "@Obsidian/Enums/Connection/dueStatus";
    import { ConnectionStatusBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionStatusBag";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<ViewOptions>,
            required: true
        },
        visible: {
            type: Boolean as PropType<boolean>,
            required: true
        },
        gridDataToShowItems: {
            type: Array as PropType<ListItemBag[]>,
            required: true
        },
        connectionStates: {
            type: Array as PropType<ListItemBag[]>,
            required: true
        },
        connectionStatuses: {
            type: Array as PropType<ConnectionStatusBag[]>,
            required: true
        },
        attributeFilters: {
            type: Array as PropType<PublicAttributeBag[]>,
            default: () => []
        },
        isMyConnectionsView: {
            type: Boolean as PropType<boolean>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: ViewOptions): void;
        (e: "update:visible", value: boolean): void;
        (e: "close"): void;
    }>();

    const isVisible = useVModelPassthrough(props, "visible", emit);
    const sortBy = ref(props.modelValue.sortBy ?? "DueDateAsc");
    const gridDataToShow = ref(props.modelValue.gridDataToShow ?? []);
    const isRequestSourceShown = ref(props.modelValue.isRequestSourceShown);
    const stateFilter = ref(props.modelValue.stateFilter ?? []);
    const statusFilter = ref(props.modelValue.statusFilter ?? []);
    const dueFilter = ref(props.modelValue.dueFilter ?? []);
    const attributeFilterValues = ref<Record<string, ComparisonValue>>({ ...(props.modelValue.attributeFilterValues ?? {}) });

    const dueStatusItems = enumToListItemBag(DueStatusDescription);

    const hasAttributeFilters = computed((): boolean => props.attributeFilters.length > 0);

    const sortByItems = [
        {
            text: "Date Added (Oldest First)",
            value: "DateAddedAsc"
        },
        {
            text: "Date Added (Newest First)",
            value: "DateAddedDesc"
        },
        {
            text: "Due Date (Soonest First)",
            value: "DueDateDesc"
        },
        {
            text: "Due Date (Latest First)",
            value: "DueDateAsc"
        },
        {
            text: "Requester (A-Z)",
            value: "RequesterAsc"
        },
        {
            text: "Requester (Z-A)",
            value: "RequesterDesc"
        },
        {
            text: "Last Activity (Oldest First)",
            value: "LastActivityAsc"
        },
        {
            text: "Last Activity (Newest First)",
            value: "LastActivityDesc"
        }
    ];

    const connectionStatusItems = computed<ListItemBag[]>(() => {
        return (
            props.connectionStatuses?.map(s => ({
                value: s.guid,
                text: s.name
            })) ?? []
        );
    });

    function onSave(): void {
        const value: ViewOptions = {
            sortBy: sortBy.value,
            gridDataToShow: gridDataToShow.value,
            isRequestSourceShown: isRequestSourceShown.value,
            stateFilter: stateFilter.value,
            statusFilter: statusFilter.value,
            dueFilter: dueFilter.value,
            attributeFilterValues: { ...attributeFilterValues.value }
        };

        // Skip the emit (and the watchers it triggers in the parent) when nothing
        // actually changed. Without this guard the spread on attributeFilterValues
        // produces a new reference every time the modal saves, which fires the
        // attribute-filter watcher and reloads the grid even on a no-op save.
        if (!deepEqual(value, props.modelValue, true)) {
            emit("update:modelValue", value);
        }

        isVisible.value = false;
    }

    watch(isVisible, () => {
        if (isVisible.value) {
            // Re-seed the local refs from the latest modelValue every time the modal opens.
            // This component stays mounted while the modal is hidden, so without this the
            // refs would hold stale values when external state (e.g., the active opportunity
            // filter narrowing or widening gridDataToShow) has changed since the last open.
            sortBy.value = props.modelValue.sortBy ?? "DueDateAsc";
            gridDataToShow.value = props.modelValue.gridDataToShow ?? [];
            isRequestSourceShown.value = props.modelValue.isRequestSourceShown;
            stateFilter.value = props.modelValue.stateFilter ?? [];
            statusFilter.value = props.modelValue.statusFilter ?? [];
            dueFilter.value = props.modelValue.dueFilter ?? [];
        }
        else {
            emit("close");
        }
    });

</script>
