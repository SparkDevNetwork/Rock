<template>
    <template v-if="connectionRequestRow.requestDetails">
        <PersonCard :photoUrl="connectionRequestRow.requestDetails.photoUrl ?? ''"
                    :name="`${connectionRequestRow.requestDetails.nickName} ${connectionRequestRow.requestDetails.lastName}`"
                    :campusShortCode="campusLabel?.shortCode"
                    :campusColor="campusLabel?.color"
                    :hideCampusLabel="hideCampusLabel"
                    @click="selectRequest">
            <template #secondaryHeaderActions>
                <template v-if="canEditConnectionRequests">
                    <li>
                        <button type="button"
                                @click.stop="() => emit('changeState', ConnectionState.Active, connectionRequest)"
                                class="dropdown-item btn-link py-spacing-xs px-spacing-md font-weight-semibold">
                            <i class="ti ti-user pr-spacing-sm text-interface-medium"></i>Set as Active
                        </button>
                    </li>
                    <li>
                        <button type="button"
                                @click.stop="() => emit('changeState', ConnectionState.Inactive, connectionRequest)"
                                class="dropdown-item btn-link py-spacing-xs px-spacing-md font-weight-semibold">
                            <i class="ti ti-user-off pr-spacing-sm text-interface-medium"></i>Set as Inactive
                        </button>
                    </li>
                    <li v-if="options?.isFutureFollowUpEnabled">
                        <button type="button"
                                @click.stop="() => emit('changeState', ConnectionState.FutureFollowUp, connectionRequest)"
                                class="dropdown-item btn-link py-spacing-xs px-spacing-md font-weight-semibold">
                            <i class="ti ti-calendar pr-spacing-sm text-interface-medium"></i>Set as Future Follow-Up
                        </button>
                    </li>
                    <li>
                        <button type="button"
                                @click.stop="() => emit('changeState', ConnectionState.Connected, connectionRequest)"
                                class="dropdown-item btn-link py-spacing-xs px-spacing-md font-weight-semibold">
                            <i class="ti ti-circle-check pr-spacing-sm text-interface-medium"></i>Mark Complete
                        </button>
                    </li>
                </template>
                <li>
                    <button type="button"
                            @click.stop="() => emit('launchWorkflow', connectionRequest)"
                            class="dropdown-item btn-link py-spacing-xs px-spacing-md font-weight-semibold">
                        <i class="ti ti-settings-cog pr-spacing-sm text-interface-medium"></i>Launch Workflow
                    </button>
                </li>
                <template v-if="canEditConnectionRequests">
                    <li v-if="options?.isRequestSecurityEnabled">
                        <button type="button"
                                @click.stop="() => emit('showSecurity', connectionRequestRow.idKey)"
                                class="dropdown-item btn-link py-spacing-xs px-spacing-md font-weight-semibold">
                            <i class="ti ti-lock pr-spacing-sm text-interface-medium"></i>Security
                        </button>
                    </li>
                    <li>
                        <button type="button"
                                @click.stop="() => emit('delete', connectionRequest)"
                                class="dropdown-item btn-link py-spacing-xs px-spacing-md font-weight-semibold text-danger">
                            <i class="ti ti-trash pr-spacing-sm text-danger"></i>Delete
                        </button>
                    </li>
                </template>
            </template>
            <template v-if="connectionState !== ConnectionState.Active" #subheader>
                <div class="py-spacing-xs px-spacing-sm text-center text-semibold text-sm"
                     :class="stateColorClasses">
                    <template v-if="connectionState === ConnectionState.FutureFollowUp">
                        Future Follow-Up: {{ daysElapsed(connectionRequestRow.followUpDate) }}
                    </template>
                    <template v-else>
                        {{ ConnectionStateDescription[connectionState] }}
                    </template>
                </div>
            </template>
            <template #body>
                <div class="details-container border-top">
                    <dl>
                        <dt>Opportunity</dt>
                        <dd class="text-semibold"
                            :ref="(el) => addTooltipIfOverflow(el as HTMLElement, connectionRequestRow.connectionOpportunity ?? '')">
                            <i v-if="connectionRequestRow.opportunityGrouping?.iconCssClass"
                               :class="connectionRequestRow.opportunityGrouping.iconCssClass"
                               class="mr-spacing-tiny"></i>
                            {{ connectionRequestRow.connectionOpportunity }}
                        </dd>
                        <dt>Due Date</dt>
                        <dd v-if="!isNullOrWhiteSpace(connectionRequestRow.dueDate)"
                            :class="getDueDateColor(connectionRequestRow.dueStatus, connectionState === ConnectionState.Connected)"
                            :ref="(el) => addTooltipIfOverflow(el as HTMLElement, daysElapsed(connectionRequestRow.dueDate))">
                            {{ daysElapsed(connectionRequestRow.dueDate, true) }}
                        </dd>
                        <dd v-else>
                            <i class="ti ti-minus"></i>
                        </dd>
                    </dl>
                </div>
                <div v-if="attributesToShow?.length && attributesToShow.length > 0"
                     class="details-container bg-interface-softer border-top">
                    <dl>
                        <template v-for="attrFieldvalue in attributesToShow">
                            <dt :ref="(el) => addTooltipIfOverflow(el as HTMLElement, attrFieldvalue.title ?? '')">
                                {{ attrFieldvalue.title }}
                            </dt>
                            <dd v-if="!isNullOrWhiteSpace(getAttributeTextValue(attrFieldvalue))"
                                :ref="(el) => addTooltipIfOverflow(el as HTMLElement, getAttributeTextValue(attrFieldvalue)!)">
                                {{ getAttributeTextValue(attrFieldvalue) }}
                            </dd>
                            <dd v-else>
                                <i class="ti ti-minus"></i>
                            </dd>
                        </template>
                    </dl>
                </div>
            </template>
            <template #footer>
                <div class="py-spacing-sm px-spacing-md border-top d-flex align-items-center justify-content-between">
                    <HighlightLabel :labelType="getConnectorLabelType()"
                                    iconCssClass="ti ti-user-circle">
                        {{ connectionRequestRow.connectorDetails?.text }}
                    </HighlightLabel>
                    <div class="d-flex align-items-center gap-sm text-sm text-interface-medium">
                        <div class="d-flex align-items-center gap-extra-tiny">
                            <i class="ti ti-calendar-plus"></i>
                            {{ getElapsedShortTime(connectionRequestRow.createdDateTime) }}
                        </div>
                        <div class="d-flex align-items-center gap-extra-tiny">
                            <i class="ti ti-bolt"></i>
                            {{ connectionRequestRow.activityCount }}
                        </div>
                    </div>
                </div>
            </template>
        </PersonCard>
    </template>
</template>

<style scoped>
.text-emerald {
    color: #10B981 !important;
}

.gap-sm {
    gap: var(--spacing-small);
}

.gap-tiny {
    gap: var(--spacing-tiny);
}

.gap-extra-tiny {
    gap: 2px;
}
</style>

<script setup lang="ts">
    import PersonCard from "@Obsidian/Controls/Internal/personCard.obs";
    import HighlightLabel from "@Obsidian/Controls/highlightLabel.obs";
    import { ref, PropType, watch, computed } from "vue";
    import { PersonFieldBag } from "@Obsidian/ViewModels/Core/Grid/personFieldBag";
    import { ConnectionState, ConnectionStateDescription } from "@Obsidian/Enums/Connection/connectionState";
    import { RockDateTime } from "@Obsidian/Utility/rockDateTime";
    import { ConnectionsHubOptionsBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionsHubOptionsBag";
    import { CampusLabelBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/campusLabelBag";
    import { isNullOrWhiteSpace } from "@Obsidian/Utility/stringUtils";
    import { GroupingFieldBag } from "@Obsidian/ViewModels/Core/Grid/groupingFieldBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { ConnectionStatusBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionStatusBag";
    import { DueStatus } from "@Obsidian/Enums/Connection/dueStatus";
    import { AttributeFieldDefinitionBag } from "@Obsidian/ViewModels/Core/Grid/attributeFieldDefinitionBag";
    import { addTooltipIfOverflow } from "./types.partial";

    type ConnectionRequestCardRow = {
        idKey?: string | null;
        connectorGrouping?: GroupingFieldBag | null;
        campusGrouping?: GroupingFieldBag | null;
        opportunityGrouping?: GroupingFieldBag | null;
        statusGrouping?: GroupingFieldBag | null;
        stateGrouping?: GroupingFieldBag | null;
        dueStatusGrouping?: GroupingFieldBag | null;
        connectorDetails?: ListItemBag | null;
        requestDetails?: PersonFieldBag | null;
        requesterPersonAliasGuid?: string | null;
        connectionOpportunity?: string | null;
        connectionOpportunityGuid?: string | null;
        connectionTypeSource?: string | null;
        campus?: string | null;
        campusGuid?: string | null;
        group?: string | null;
        connectionStatus?: ConnectionStatusBag | null;
        lastActivityDateTime?: string | null;
        activityCount?: number | null;
        createdDateTime?: string | null;
        dueDate?: string | null;
        dueSoonDate?: string | null;
        completedDateTime?: string | null;
        dueStatus?: DueStatus | null;
        followUpDate?: string | null;
        connectionState?: ConnectionState | null;
        celebrationText?: string | null;
        reminderCount?: number | null;
        hasPlacementGroup?: boolean | null;
        hasRequiredGroupRequirements?: boolean | null;
    };

    /**
     * Maps a raw grid row to a typed ConnectionRequestCardRow.
     */
    function toConnectionRequestCardRow(row: Record<string, unknown>): ConnectionRequestCardRow {
        return {
            idKey: row.idKey as string | null | undefined,
            connectorGrouping: row.connectorGrouping as GroupingFieldBag | null | undefined,
            campusGrouping: row.campusGrouping as GroupingFieldBag | null | undefined,
            opportunityGrouping: row.opportunityGrouping as GroupingFieldBag | null | undefined,
            statusGrouping: row.statusGrouping as GroupingFieldBag | null | undefined,
            stateGrouping: row.stateGrouping as GroupingFieldBag | null | undefined,
            dueStatusGrouping: row.dueStatusGrouping as GroupingFieldBag | null | undefined,
            connectorDetails: row.connectorDetails as ListItemBag | null | undefined,
            requestDetails: row.requestDetails as PersonFieldBag | null | undefined,
            requesterPersonAliasGuid: row.requesterPersonAliasGuid as string | null | undefined,
            connectionOpportunity: row.connectionOpportunity as string | null | undefined,
            connectionOpportunityGuid: row.connectionOpportunityGuid as string | null | undefined,
            connectionTypeSource: row.connectionTypeSource as string | null | undefined,
            campus: row.campus as string | null | undefined,
            campusGuid: row.campusGuid as string | null | undefined,
            group: row.group as string | null | undefined,
            connectionStatus: row.connectionStatus as ConnectionStatusBag | null | undefined,
            lastActivityDateTime: row.lastActivityDateTime as string | null | undefined,
            activityCount: row.activityCount as number | null | undefined,
            createdDateTime: row.createdDateTime as string | null | undefined,
            dueDate: row.dueDate as string | null | undefined,
            dueSoonDate: row.dueSoonDate as string | null | undefined,
            completedDateTime: row.completedDateTime as string | null | undefined,
            dueStatus: row.dueStatus as DueStatus | null | undefined,
            followUpDate: row.followUpDate as string | null | undefined,
            connectionState: row.connectionState as ConnectionState | null | undefined,
            celebrationText: row.celebrationText as string | null | undefined,
            reminderCount: row.reminderCount as number | null | undefined,
            hasPlacementGroup: row.hasPlacementGroup as boolean | null | undefined,
            hasRequiredGroupRequirements: row.hasRequiredGroupRequirements as boolean | null | undefined,
        };
    }

    const props = defineProps({
        connectionRequest: {
            type: Object as PropType<Record<string, unknown>>,
            default: {}
        },

        options: {
            type: Object as PropType<ConnectionsHubOptionsBag | null | undefined>,
            default: {}
        },

        canEditConnectionRequests: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        hideCampusLabel: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        attributesToShow: {
            type: Array as PropType<AttributeFieldDefinitionBag[] | undefined>,
            required: true
        },

        currentPersonIdKey: {
            type: String as PropType<string | null | undefined>,
            default: ""
        }
    });

    const emit = defineEmits<{
        (e: "selectItem", value: string): void;
        (e: "changeState", state: ConnectionState, row: Record<string, unknown>): void;
        (e: "launchWorkflow", row: Record<string, unknown>): void;
        (e: "showSecurity", value: string | null | undefined): void;
        (e: "delete", row: Record<string, unknown>): void;
    }>();

    // Map the raw grid row to a typed view for use within this component.
    const connectionRequestRow = computed<ConnectionRequestCardRow>(() => toConnectionRequestCardRow(props.connectionRequest));
    const connectionState = computed<ConnectionState>(() => (props.connectionRequest["connectionState"] as ConnectionState | undefined) ?? ConnectionState.Active);

    const campusLabel = computed<CampusLabelBag | undefined>(() => {
        const campusGuid = connectionRequestRow.value.campusGuid;

        if (!campusGuid || !props.options?.campusLabels) {
            return;
        }

        return props.options.campusLabels.find(c => c.guid === campusGuid);
    });
    const stateColorClasses = computed<string>(() => {
        switch (connectionRequestRow.value.connectionState) {
            case ConnectionState.Inactive: {
                return "bg-warning-soft text-warning-strong";
            }
            case ConnectionState.FutureFollowUp: {
                return "bg-info-soft text-info-strong";
            }
            case ConnectionState.Connected: {
                return "bg-success-soft text-success-strong";
            }
            default: {
                return "";
            }
        }
    });

    const daysElapsed = (dateTimeIsoToCheck: string | null | undefined, isDueDateCheck: boolean = false): string => {
        const isCompleted = connectionState.value === ConnectionState.Connected;

        if (!dateTimeIsoToCheck) {
            return "";
        }

        const dateTimeToCheck = RockDateTime.parseISO(dateTimeIsoToCheck);
        if (!dateTimeToCheck) {
            return "";
        }

        // Use the completion date as the reference point if completed, otherwise use today
        let referenceDate: RockDateTime;
        if (isCompleted) {
            const completedDateTimeIso = connectionRequestRow.value.completedDateTime;
            const completedDate = RockDateTime.parseISO(completedDateTimeIso ?? "")?.date;

            referenceDate = completedDate ? completedDate : RockDateTime.now().date;
        }
        else {
            referenceDate = RockDateTime.now().date;
        }
        const dateToCheck = dateTimeToCheck.date;

        const msPerDay = 1000 * 60 * 60 * 24;

        const diffDays = Math.round((dateToCheck.toMilliseconds() - referenceDate.toMilliseconds()) / msPerDay);

        if (isCompleted) {
            if (diffDays > 0) {
                return `Completed ${diffDays} ${diffDays === 1 ? "Day" : "Days"} Before Due`;
            }
            else if (diffDays < 0) {
                const lateDays = Math.abs(diffDays);
                return `Completed ${lateDays} ${lateDays === 1 ? "Day" : "Days"} After Due`;
            }
            else {
                return "Completed on Due Date";
            }
        }

        if (diffDays > 0) {
            const pre = isDueDateCheck ? "Due in" : "In";
            return `${pre} ${diffDays} ${diffDays === 1 ? "Day" : "Days"}`;
        }
        else if (diffDays < 0) {
            const pastDays = Math.abs(diffDays);
            const pastDateTerm = isDueDateCheck ? "Overdue" : "Ago";
            return `${pastDays} ${pastDays === 1 ? "Day" : "Days"} ${pastDateTerm}`;
        }
        else {
            return "Today";
        }
    };

    function getDueDateColor(dueStatus: DueStatus | null | undefined, isCompleted: boolean): string {
        switch (dueStatus) {
            case DueStatus.DueLater:
                return isCompleted ? "text-emerald text-semibold" : "text-interface-strong";
            case DueStatus.DueSoon:
                return "text-warning text-semibold";
            case DueStatus.Overdue:
                return "text-danger text-semibold";
            default:
                return "text-interface-strong";
        }
    }

    function getConnectorLabelType(): "warning" | "info" | "default" {
        if (connectionRequestRow.value.connectorDetails?.value === "unassigned") {
            return "warning";
        }
        else if (connectionRequestRow.value.connectorDetails?.value === props.currentPersonIdKey) {
            return "info";
        }
        return "default";
    }

    function selectRequest(): void {
        const requestIdKey = connectionRequestRow.value.idKey;

        if (!requestIdKey || isNullOrWhiteSpace(requestIdKey)) {
            return;
        }

        emit("selectItem", requestIdKey);
    }

    /**
     * Gets the text value for the atttribute field
     * @param column The column.
     * @returns A string value or undefined if there is no value.
     */
    function getAttributeTextValue(fieldBag: AttributeFieldDefinitionBag): string | undefined {
        if (!fieldBag.name) {
            return undefined;
        }

        const value = props.connectionRequest[fieldBag.name];

        if (!value || typeof value !== "object") {
            return undefined;
        }

        if (typeof value["text"] !== "string") {
            return undefined;
        }

        return value["text"];
    }

    /** The time elapsed since the specified date in a human-readable format. */
    function getElapsedShortTime(date: string | null | undefined): string {
        return RockDateTime.parseISO(date ?? "")?.localDateTime.toElapsedShortString() ?? "";
    }
</script>
