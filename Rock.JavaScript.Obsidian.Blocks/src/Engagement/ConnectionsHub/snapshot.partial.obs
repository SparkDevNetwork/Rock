<template>
    <div class="snapshot-container">
        <div class="header">{{ metrics?.dashboardTitle }} • <span class="subtext">Last 28 Days</span></div>
        <CompletionMetricsPanel :metrics="metrics"
                                footerSuffix=" vs. Previous 28 Days" />
    </div>
</template>

<style scoped>
.snapshot-container {
    padding: var(--spacing-large);
    background-color: var(--color-interface-softer);
    border-bottom: 1px solid var(--color-interface-soft);
}

.snapshot-container .header {
    color: var(--color-interface-strong);
    font-size: var(--font-size-h6);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--spacing-medium);
}

.snapshot-container .subtext {
    color: var(--color-interface-medium);
}
</style>

<script setup lang="ts">
    /**
     * completionMetricsPanel.partial.obs - Renders the four connection completion metric tiles
     * (Timeliness, Responsiveness, Requests Completed, Average Time to Complete) for the
     * Connections Hub snapshot, each showing a current value and a color-coded delta versus
     * the comparison period.
     *
     * Self-contained: the trend coloring, delta formatting, and ellipsis tooltip behavior are
     * defined locally so this partial has no dependency on any other block's partials. This
     * intentionally duplicates the equivalent display logic in the ConnectionOperationalSnapshot
     * block rather than sharing a component.
     */
    import { PropType } from "vue";
    import { CompletionMetricsBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/completionMetricsBag";
    import CompletionMetricsPanel from "./completionMetricsPanel.partial.obs";

    defineProps({
        /**
         * The completion metrics payload. When null or undefined the tiles render
         * placeholder dashes.
         */
        metrics: {
            type: Object as PropType<CompletionMetricsBag | null | undefined>,
            default: null
        },

        isConnectorCurrentPerson: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        connectorName: {
            type: String as PropType<string>,
            default: ""
        }
    });


</script>
