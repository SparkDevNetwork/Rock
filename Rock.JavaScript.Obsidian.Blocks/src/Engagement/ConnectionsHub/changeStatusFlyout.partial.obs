<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Flyout v-model="isVisible"
            :anchorEl="anchorEl"
            :onSave="onFlyoutSubmit">
        <template #default>

            <div>
                <NotificationBox v-if="errorMessage"
                                 alertType="danger"
                                 dismissible
                                 @dismiss="onErrorMessageDismissed">
                    {{ errorMessage }}
                </NotificationBox>
            </div>

            <template v-if="isLastStatus">
                <p>This request has reached its final status. Would you like to mark it as Complete?</p>
            </template>
            <template v-else>
                <template v-if="connectionTypeOptions?.isSequentialStatusMode">
                    <p>Are you sure you want to advance to the next status for this request?</p>
                    <div class="row">
                        <div class="col-md-6">
                            <StaticFormControl :modelValue="currentStatus?.text ?? ''"
                                               label="Current Status" />
                        </div>
                        <div class="col-md-6">
                            <StaticFormControl :modelValue="nextStatus?.text ?? ''"
                                               label="Next Status" />
                        </div>
                    </div>
                </template>
                <template v-else>
                    <DropDownList v-model="status"
                                  :items="connectionStatusItems"
                                  label="Status"
                                  :showBlankItem="false" />
                </template>
                <TextBox v-model="note"
                         label="Note"
                         textMode="multiline"
                         :rules="isNoteRequired ? 'required' : ''" />
            </template>
        </template>
        <template #footer>
            <div v-if="isLastStatus"
                 class="flyout-footer-actions-laststatus">
                <RockButton @click="completeRequest"
                            :btnSize="BtnSize.Small"
                            :btnType="BtnType.Primary"
                            :disabled="!connectionRequestUpdateBag.canCompleteRequest || isSaving"
                            :isLoading="isCompletionButtonLoading"
                            :title="completeButtonTooltip">
                    Mark Complete
                </RockButton>
                <RockButton @click="closeFlyout"
                            :btnSize="BtnSize.Small"
                            :btnType="BtnType.Link">
                    Cancel
                </RockButton>
            </div>
            <div v-else
                 class="flyout-footer-actions">
                <RockButton @click="completeRequest"
                            :btnSize="BtnSize.Small"
                            :disabled="!connectionRequestUpdateBag.canCompleteRequest || isSaving"
                            :isLoading="isCompletionButtonLoading"
                            :title="completeButtonTooltip">
                    Mark Complete
                </RockButton>
                <div>
                    <RockButton type="submit"
                                :btnSize="BtnSize.Small"
                                :btnType="BtnType.Primary"
                                :disabled="isSaving">
                        {{ connectionTypeOptions?.isSequentialStatusMode ? "Confirm" : "Save" }}
                    </RockButton>
                    <RockButton @click="closeFlyout"
                                :btnSize="BtnSize.Small"
                                :btnType="BtnType.Link">
                        Cancel
                    </RockButton>
                </div>
            </div>
        </template>
    </Flyout>
</template>


<script setup lang="ts">
    import Flyout from "@Obsidian/Controls/flyout.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import StaticFormControl from "@Obsidian/Controls/staticFormControl.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import { ref, PropType, watch, computed } from "vue";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { ConnectionRequestUpdateBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionRequestUpdateBag";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { BtnSize } from "@Obsidian/Enums/Controls/btnSize";
    import { ConnectionState } from "@Obsidian/Enums/Connection/connectionState";
    import { UpdateConnectionRequestStatesBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/updateConnectionRequestStatesBag";
    import { ConnectionTypeOptionsBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionTypeOptionsBag";
    import { ConnectionStatusBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionStatusBag";


    const props = defineProps({
        modelValue: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        errorMessage: {
            type: String as PropType<string>,
            required: true
        },

        isCompletionButtonLoading: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        connectionRequestUpdateBag: {
            type: Object as PropType<ConnectionRequestUpdateBag>,
            required: true
        },

        connectionTypeOptions: {
            type: Object as PropType<ConnectionTypeOptionsBag | null>,
            required: true
        },

        isNoteRequired: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        anchorEl: {
            type: Object as PropType<HTMLElement | null>,
            required: true
        },

        isSaving: {
            type: Boolean as PropType<boolean>,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: boolean): void;
        (e: "updateStatus", value: ConnectionRequestUpdateBag): void;
        (e: "updateState", value: UpdateConnectionRequestStatesBag): void;
        (e: "dismissErrorMessage"): void;
        (e: "close"): void;
    }>();

    const errorMessage = computed(() => props.errorMessage);

    const isVisible = useVModelPassthrough(props, "modelValue", emit);

    const status = ref("");
    const note = ref("");

    const connectionStatusItems = computed<ListItemBag[]>(() => {
        let statuses: ConnectionStatusBag[] | null | undefined = props.connectionTypeOptions?.connectionStatuses;

        return (
            statuses?.slice() // avoid mutating source
                .sort((a, b) => a.order - b.order)
                .map(s => ({
                    value: s.guid,
                    text: s.name
                })) ?? []
        );
    });

    const currentStatusIndex = computed(() => {
        if (!status.value || !props.connectionTypeOptions?.isSequentialStatusMode) {
            return -1;
        }

        return connectionStatusItems.value.findIndex(
            s => s.value === status.value
        );
    });

    const isLastStatus = computed(() => {
        return (
            currentStatusIndex.value !== -1 &&
            currentStatusIndex.value === connectionStatusItems.value.length - 1
        );
    });

    const currentStatus = computed(() => {
        if (currentStatusIndex.value === -1) {
            return null;
        }

        return connectionStatusItems.value[currentStatusIndex.value];
    });

    const nextStatus = computed(() => {
        if (isLastStatus.value || currentStatusIndex.value === -1) {
            return null;
        }

        return connectionStatusItems.value[currentStatusIndex.value + 1];
    });

    const completeButtonTooltip = computed(() => {
        if (!props.connectionRequestUpdateBag.canCompleteRequest) {
            return "Missing Placement Group Requirements.";
        }
        return "";
    });

    function resetFields(): void {
        status.value = "";
        note.value = "";
        onErrorMessageDismissed();
    }

    function closeFlyout(): void {
        isVisible.value = false;
    }

    function completeRequest(): void {
        const updateBag: UpdateConnectionRequestStatesBag = {
            connectionRequestIdKeys: [props.connectionRequestUpdateBag.connectionRequestIdKey ?? ""],
            connectionState: ConnectionState.Connected
        };
        emit("updateState", updateBag);
    }

    function onFlyoutSubmit(): void {
        const newStatus = props.connectionTypeOptions?.isSequentialStatusMode ? nextStatus.value?.value : status.value;
        const updateBag: ConnectionRequestUpdateBag = {
            ...props.connectionRequestUpdateBag,
            connectionStatusKey: newStatus,
            note: note.value
        };

        emit("updateStatus", updateBag);
    }

    function onErrorMessageDismissed(): void {
        emit("dismissErrorMessage");
    }

    watch(isVisible, () => {
        if (!isVisible.value) {
            emit("close");
            resetFields();
        }
    });

    watch(() => props.connectionRequestUpdateBag, bag => {
        status.value = bag.connectionStatusKey ?? "";
    }, { immediate: true });
</script>
