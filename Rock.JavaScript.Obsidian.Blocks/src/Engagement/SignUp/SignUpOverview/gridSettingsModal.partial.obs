<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Modal v-model="isVisible"
           title="Settings"
           saveText="Save"
           @save="onSave">
        <SectionHeader title="Filters" />

        <div class="row">
            <div class="col-md-6">
                <SlidingDateRangePicker v-model="dateRange"
                                        label="Schedule Date Range" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <GroupPicker v-model="parentGroup"
                             label="Parent Group"
                             :includedGroupTypeGuids="signUpProjectGroupTypeGuids" />
            </div>
        </div>

        <div class="form-group">
            <RockLabel>Slots Available</RockLabel>
            <div class="d-flex">
                <DropDownList v-model="slotsAvailableComparisonType"
                              :items="slotsAvailableComparisonItems"
                              inputClasses="input-width-lg"
                              class="mr-2" />
                <NumberBox v-model="slotsAvailableComparisonValue" :decimalCount="0"
                           inputClasses="input-width-sm" />
            </div>
        </div>
    </Modal>
</template>

<script setup lang="ts">
    import { PropType, ref, watch } from "vue";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import GroupPicker from "@Obsidian/Controls/groupPicker.obs";
    import Modal from "@Obsidian/Controls/modal.obs";
    import NumberBox from "@Obsidian/Controls/numberBox.obs";
    import RockLabel from "@Obsidian/Controls/rockLabel.obs";
    import SectionHeader from "@Obsidian/Controls/sectionHeader.obs";
    import SlidingDateRangePicker from "@Obsidian/Controls/slidingDateRangePicker.obs";
    import { getFilteredComparisonTypeOptions } from "@Obsidian/Core/Reporting/comparisonTypeOptions";
    import { ComparisonType } from "@Obsidian/Enums/Reporting/comparisonType";
    import { Guid } from "@Obsidian/Types";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import { SlidingDateRange } from "@Obsidian/Utility/slidingDateRange";
    import { deepEqual } from "@Obsidian/Utility/util";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { GridSettingsOptions } from "./types.partial";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<GridSettingsOptions>,
            required: true
        },

        visible: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        /** The unique identifiers of the group types the parent group picker is limited to. */
        signUpProjectGroupTypeGuids: {
            type: Array as PropType<Guid[]>,
            default: () => []
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: GridSettingsOptions): void;
        (e: "update:visible", value: boolean): void;
        (e: "close"): void;
    }>();

    // #region Values

    const slotsAvailableComparisonItems = getFilteredComparisonTypeOptions(
        ComparisonType.EqualTo,
        ComparisonType.NotEqualTo,
        ComparisonType.GreaterThan,
        ComparisonType.GreaterThanOrEqualTo,
        ComparisonType.LessThan,
        ComparisonType.LessThanOrEqualTo
    );

    const dateRange = ref<SlidingDateRange | null>(props.modelValue.dateRange ?? null);
    const parentGroup = ref<ListItemBag | null>(props.modelValue.parentGroup ?? null);
    const slotsAvailableComparisonType = ref<string>(props.modelValue.slotsAvailableComparisonType ?? "");
    const slotsAvailableComparisonValue = ref<number | null>(props.modelValue.slotsAvailableComparisonValue ?? null);

    const isVisible = useVModelPassthrough(props, "visible", emit);

    // #endregion Values

    // #region Event Handlers

    /**
     * Called when the save button is clicked, emits the updated settings when
     * they actually changed.
     */
    function onSave(): void {
        const value: GridSettingsOptions = {
            dateRange: dateRange.value,
            parentGroup: parentGroup.value,
            slotsAvailableComparisonType: slotsAvailableComparisonType.value || null,
            // The server parses this value as an integer; a decimal would silently
            // disable the filter while the settings icon still shows it as active.
            slotsAvailableComparisonValue: slotsAvailableComparisonValue.value != null
                ? Math.round(slotsAvailableComparisonValue.value)
                : null
        };

        if (!deepEqual(value, props.modelValue, true)) {
            emit("update:modelValue", value);
        }

        isVisible.value = false;
    }

    // #endregion Event Handlers

    // #region Watchers

    watch(slotsAvailableComparisonType, () => {
        // Clearing the comparison type clears the compare value with it.
        if (!slotsAvailableComparisonType.value) {
            slotsAvailableComparisonValue.value = null;
        }
    });

    watch(() => props.modelValue, () => {
        dateRange.value = props.modelValue.dateRange ?? null;
        parentGroup.value = props.modelValue.parentGroup ?? null;
        slotsAvailableComparisonType.value = props.modelValue.slotsAvailableComparisonType ?? "";
        slotsAvailableComparisonValue.value = props.modelValue.slotsAvailableComparisonValue ?? null;
    });

    watch(isVisible, () => {
        if (!isVisible.value) {
            emit("close");
        }
    });

    // #endregion Watchers
</script>
