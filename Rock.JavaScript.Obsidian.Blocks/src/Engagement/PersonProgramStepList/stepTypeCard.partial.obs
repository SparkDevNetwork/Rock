<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="step-card" :class="cardClasses">
        <div class="card-info" v-html="stepType.cardHtml"></div>

        <div class="step-card-hover">
            <button v-if="stepType.isAddEnabled"
                    type="button"
                    class="card-add-step-button"
                    @click="emit('add', stepType.id)">
                <span>
                    <i class="ti ti-circle-plus ti-2x"></i>
                    <br />
                    Add a {{ stepTerm }}
                </span>
            </button>

            <div v-if="isPrerequisiteListShown" class="prereq-list">
                <p class="prereq-list-info">This {{ stepTerm }} requires the following prerequisites:</p>
                <ul class="list-unstyled">
                    <li v-for="name in stepType.prerequisiteNames" :key="name">{{ name }}</li>
                </ul>
            </div>

            <table v-if="steps.length > 0" class="step-records-table">
                <tbody>
                    <tr v-for="step in steps" :key="step.idKey ?? ''">
                        <td class="steps-status">
                            {{ step.statusName }}
                            <br />
                            <small>{{ formatDate(step.completedDateTime) }}</small>
                        </td>
                        <td v-if="step.canEdit">
                            <button type="button" class="btn-actions" @click="emit('edit', stepType.id, step.id)">
                                <i class="ti ti-pencil"></i>
                            </button>
                        </td>
                        <td v-if="step.canDelete">
                            <button type="button" class="btn-actions btn-delete" @click="onDeleteClick(step.idKey ?? '')">
                                <i class="ti ti-x"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</template>

<style scoped>
    /* TODO: Port RockWeb/Styles/Blocks/Steps/PersonProgramStepList.css using Rock CSS variables. */
    .step-card {
        position: relative;
        min-height: 260px;
        overflow: hidden;
        text-align: center;
        border: 1px solid var(--theme-light);
    }

    .step-card-hover {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        opacity: 0;
        transform: translateY(100%);
        transition: opacity .25s, transform .25s;
        background: var(--theme-white);
    }

    .step-card:hover > .step-card-hover {
        opacity: 1;
        transform: translateY(0);
    }

    .card-add-step-button {
        display: flex;
        flex: 1 1 auto;
        align-items: center;
        justify-content: center;
        border: 0;
        background: transparent;
    }

    .step-records-table {
        width: 100%;
        margin-top: auto;
    }
</style>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import { confirmDelete } from "@Obsidian/Utility/dialogs";
    import { RockDateTime } from "@Obsidian/Utility/rockDateTime";
    import { PersonProgramStepBag } from "@Obsidian/ViewModels/Blocks/Engagement/PersonProgramStepList/personProgramStepBag";
    import { PersonProgramStepTypeBag } from "@Obsidian/ViewModels/Blocks/Engagement/PersonProgramStepList/personProgramStepTypeBag";

    const props = defineProps({
        stepType: {
            type: Object as PropType<PersonProgramStepTypeBag>,
            required: true
        },

        stepTerm: {
            type: String as PropType<string>,
            required: true
        },

        isBlockEditable: {
            type: Boolean as PropType<boolean>,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "add", stepTypeId: number): void;
        (e: "edit", stepTypeId: number, stepId: number): void;
        (e: "delete", stepIdKey: string): void;
    }>();

    // #region Computed Values

    const steps = computed((): PersonProgramStepBag[] => props.stepType.steps ?? []);

    const isPrerequisiteListShown = computed((): boolean => props.isBlockEditable && !props.stepType.hasMetPrerequisites);

    const cardClasses = computed((): Record<string, boolean> => {
        return {
            "is-complete": props.stepType.isComplete,
            "has-steps": props.stepType.hasSteps,
            "no-steps": !props.stepType.hasSteps,
            "has-add": props.stepType.isAddEnabled,
            "has-prerequisite": isPrerequisiteListShown.value
        };
    });

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Called when a step's delete icon is clicked. Confirms before emitting.
     *
     * @param stepIdKey The identifier key of the step.
     */
    async function onDeleteClick(stepIdKey: string): Promise<void> {
        if (await confirmDelete(props.stepTerm)) {
            emit("delete", stepIdKey);
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Formats an ISO date string as a short date, or an empty string.
     *
     * @param value The ISO 8601 date string.
     */
    function formatDate(value: string | null | undefined): string {
        if (!value) {
            return "";
        }

        return RockDateTime.parseISO(value)?.toASPString("d") ?? "";
    }

    // #endregion Functions
</script>
