<template>
    <ContentStack title="Attribute List"
                  description="Define custom attributes for this connection type to store configuration details. Note: After adding new attributes, save the Connection Type before setting their values."
                  headerLocation="top">
        <EditableAttributesGrid v-model="attributes"
                                itemTerm="Type Attribute"
                                modalTitle="Type Attributes"
                                :attributeEntityTypeGuid="EntityType.ConnectionType" />
    </ContentStack>

    <ContentStack v-if="hasAttributes"
                  title="Set Attribute Values"
                  description="Add values to the attributes you configured above."
                  headerLocation="top">
        <AttributeValuesContainer v-model="internalAttributeValues"
                                  :attributes="attributesForAttributeValueContainer"
                                  isEditMode
                                  :showCategoryLabel="false" />
    </ContentStack>
</template>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import EditableAttributesGrid from "@Obsidian/Controls/editableAttributesGrid.obs";
    import AttributeValuesContainer from "@Obsidian/Controls/attributeValuesContainer.obs";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { PublicAttributeBag } from "@Obsidian/ViewModels/Utility/publicAttributeBag";
    import { PublicEditableAttributeBag } from "@Obsidian/ViewModels/Utility/publicEditableAttributeBag";

    const props = defineProps({
        /**
         * The editable list of connection type attributes configured for this connection type.
         */
        connectionTypeAttributes: {
            type: Object as PropType<PublicEditableAttributeBag[]>,
            required: true
        },

        /**
         * PublicAttributeBags for use in the attribute values container (connection type scoped).
         */
        attributesForAttributeValueContainer: {
            type: Object as PropType<Record<string, PublicAttributeBag>>,
            required: true
        },

        /**
         * Current attribute values for the connection type.
         */
        attributeValues: {
            type: Object as PropType<Record<string, string>>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:connectionTypeAttributes", value: PublicEditableAttributeBag[]): void,
        (e: "update:attributeValues", value: Record<string, string>): void
    }>();

    // #region Computed Values

    const attributes = computed({
        get(): PublicEditableAttributeBag[] {
            return props.connectionTypeAttributes ?? [];
        },
        set(value: PublicEditableAttributeBag[]) {
            emit("update:connectionTypeAttributes", value);
        }
    });

    const internalAttributeValues = computed({
        get(): Record<string, string> {
            return props.attributeValues;
        },
        set(value: Record<string, string>) {
            emit("update:attributeValues", value);
        }
    });

    const hasAttributes = computed((): boolean => {
        return Object.keys(props.attributesForAttributeValueContainer).length > 0;
    });

    // #endregion Computed Values
</script>
