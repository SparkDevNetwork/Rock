<template>
    <ContentStack title="Attribute List"
                  description="Define custom attributes that appear on every connection request within this connection type. Each individual request stores its own values for these attributes."
                  headerLocation="top">
        <EditableAttributesGrid v-model="attributes"
                                itemTerm="Request Attribute"
                                modalTitle="Request Attributes"
                                :attributeEntityTypeGuid="EntityType.ConnectionRequest"
                                :reservedKeyNames="externalReservedKeyNames" />
    </ContentStack>
</template>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import EditableAttributesGrid from "@Obsidian/Controls/editableAttributesGrid.obs";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { PublicEditableAttributeBag } from "@Obsidian/ViewModels/Utility/publicEditableAttributeBag";

    const props = defineProps({
        /**
         * The editable list of connection request attributes configured for this connection type.
         */
        connectionRequestAttributes: {
            type: Object as PropType<PublicEditableAttributeBag[]>,
            required: true
        },

        /**
         * Request attribute keys already used on any opportunity under this connection type.
         * These are reserved so type-level attributes cannot reuse them.
         */
        reservedOpportunityAttributeKeys: {
            type: Array as PropType<string[]>,
            default: () => []
        }
    });

    const emit = defineEmits<{
        (e: "update:connectionRequestAttributes", value: PublicEditableAttributeBag[]): void
    }>();

    // #region Computed Values

    const attributes = computed({
        get(): PublicEditableAttributeBag[] {
            return props.connectionRequestAttributes ?? [];
        },
        set(value: PublicEditableAttributeBag[]) {
            emit("update:connectionRequestAttributes", value);
        }
    });

    /**
     * Keys already used by opportunity-level request attributes, reserved so
     * type-level attributes cannot collide with them. The keys of the editable
     * attributes themselves are reserved by the EditableAttributesGrid.
     */
    const externalReservedKeyNames = computed((): string[] => {
        return (props.reservedOpportunityAttributeKeys ?? [])
            .filter((k): k is string => !!k);
    });

    // #endregion Computed Values
</script>
