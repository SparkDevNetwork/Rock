        isCelebrationModalVisible.value = true;
    }

    function showReminderModal(row: Record<string, unknown> | null = null, detailBox: ConnectionRequestDetailBox | null = null): void {
        if (!row && !detailBox) {
            return;
        }

        let requesterPersonAliasGuid;

        if (row) {
            requesterPersonAliasGuid = row["requesterPersonAliasGuid"] as string | null | undefined;

        }
        else {
            requesterPersonAliasGuid = detailBox?.entity?.requesterPersonAliasGuid;
        }

        if (!requesterPersonAliasGuid || typeof requesterPersonAliasGuid !== "string") {
            return;
        }

        reminderEntityGuid.value = requesterPersonAliasGuid;
        prepareRequestDetailsForModal(row, detailBox);
        isReminderModalVisible.value = true;
    }

