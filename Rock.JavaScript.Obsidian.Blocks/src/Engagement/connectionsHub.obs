    function selectTransferProcess(bag: TransferConnectionRequestBag): void {
        if (isBulkTransfer.value) {
            bulkTransferRequests(bag);
        }
        else {
            transferSingleRequest(bag);
        }
    }

    async function bulkTransferRequests(bag: TransferConnectionRequestBag): Promise<void> {
        try {
            isModalSaving.value = true;

            const result = await invokeBlockAction<ConnectionListGridUpdateBag[]>("BulkTransferConnectionRequests", {
                connectionRequestIdKeys: allSelectedKeys.value,
                bag
            });

            if (result.isSuccess && result.data) {
                const rowsByIdKey = new Map(
                    gridData.value?.rows?.map(r => [r.idKey, r])
                );

                for (const updateBag of result.data) {
                    const row = rowsByIdKey.get(updateBag.idKey);
                    if (!row) {
                        continue;
                    }

                    row.opportunityGrouping = updateBag.opportunityGrouping;
                    row.campusGrouping = updateBag.campusGrouping;
                    row.stateGrouping = updateBag.stateGrouping;
                    row.statusGrouping = updateBag.statusGrouping;
                    row.stateGrouping = updateBag.stateGrouping;
                    row.dueStatusGrouping = updateBag.dueStatusGrouping;
                    row.statusGrouping = updateBag.statusGrouping;
                    row.connectionStatus = updateBag.connectionStatusBag;
                    row.connectionState = updateBag.connectionState;
                    row.dueStatus = updateBag.dueStatus;
                    row.dueDate = updateBag.dueDate;
                    row.dueSoonDate = updateBag.dueSoonDate;
                    row.followUpDate = updateBag.followUpDate;
                    row.completedDateTime = updateBag.completedDateTime;
                    row.connectionOpportunity = updateBag.connectionOpportunity;
                    row.connectionOpportunityGuid = updateBag.connectionOpportunityGuid;
                    row.connectionOpportunityIconCssClass = updateBag.connectionOpportunityIconCssClass;
                    row.campus = updateBag.campus;
                    row.campusGuid = updateBag.campusGuid;
                    row.lastActivityDateTime = updateBag.lastActivityDateTime;
                    row.activityCount = updateBag.activityCount;

                    // If the request's current connector was not preserved, then update the row data.
                    if (bag.connectorOption !== "current") {
                        row.connectorGrouping = updateBag.connectorGrouping;
                        row.connectorDetails = updateBag.connectorDetails;
                    }
                }

                mergeConnectorGroupings(result.data.map(u => u.connectorGroupingField));

                // Need to validate the updated rows still meet server filter requirements.
                applyServerFilters();

                clearAllSelections();
                isTransferModalVisible.value = false;
            }
            else {
                modalErrorMessage.value = result.errorMessage ?? "An unknown error occurred while transferring the connection request.";
            }
        }
        finally {
            isModalSaving.value = false;
        }
    }

    async function onTransferClick(): Promise<void> {
        isTransferModalVisible.value = true;
        areTransferDetailsLoading.value = true;

        const result = await invokeBlockAction<TransferConnectionRequestDetailsBag>("GetTransferDetails", {
            key: dockedPanelDetailsBox.value?.entity?.connectionRequestIdKey
        });

        if (result.isSuccess && result.data) {
            transferRequestDetails.value = result.data;
        }
        else {
            modalErrorMessage.value = result.errorMessage ?? "An error occurred while getting transfer details.";
        }

        areTransferDetailsLoading.value = false;
    }

    async function transferSingleRequest(bag: TransferConnectionRequestBag): Promise<void> {
        try {
            isModalSaving.value = true;

            const result = await invokeBlockAction<ConnectionListUpdateBox>("TransferConnectionRequest", {
                bag
            });

            if (result.isSuccess && result.data && result.data.detailBox) {
                if (result.data.gridRow) {
                    syncGridData(result.data.gridRow);
                }

                mergeConnectorGroupings([result.data.connectorGroupingField]);

                dockedPanelDetailsBox.value = result.data.detailBox;

                isTransferModalVisible.value = false;
            }
            else {
                modalErrorMessage.value = result.errorMessage ?? "An unknown error occurred while transferring the connection request.";
            }
        }
        finally {
            isModalSaving.value = false;
        }
    }

    async function checkForActiveRequester(requesterPersonAliasGuid: string, typeIdKey: string): Promise<void> {
        const result = await invokeBlockAction<boolean>("CheckForActiveRequest", {
            requesterPersonAliasGuid,
            connectionTypeIdKey: typeIdKey
        });

        if (result.isSuccess && result.data !== null) {
            isExistingActiveRequesterOnConnectionType.value = result.data;
        }
        else {
            modalErrorMessage.value = "An error occurred while checking if the selected requester had any active requests.";
        }
    }

    async function onAddRequest(box: ValidPropertiesBox<ConnectionRequestBag>): Promise<void> {
        try {
            isModalSaving.value = true;

            const result = await saveConnectionRequest(box);

            if (result.isSuccess && result.data) {
                if (result.data.gridRow) {
                    syncGridData(result.data.gridRow);
                }

                mergeConnectorGroupings([result.data.connectorGroupingField]);

                isAddConnectionRequestModalVisible.value = false;
                return;
            }
            else {
                modalErrorMessage.value = result.errorMessage ?? "An unknown error occurred while adding the request.";
            }
        }
        finally {
            isModalSaving.value = false;
        }
    }

    async function saveConnectionRequest(box: ValidPropertiesBox<ConnectionRequestBag>): Promise<HttpResult<ConnectionListUpdateBox>> {
        const result = await invokeBlockAction<ConnectionListUpdateBox>("SaveConnectionRequest", {
            box
        });

        return result;
    }

    async function updateConnectorFromModal(connector: string): Promise<void> {
        try {
            isModalSaving.value = true;
            await reassignConnector(allSelectedKeys.value, connector);
        }
        finally {
            isModalSaving.value = false;
        }
    }

    async function reassignConnector(connectionRequestIdKeys: string[], connector: string, fromDockedPanel: boolean = false): Promise<void> {
        // If the action comes from a docked panel than the Connection Type could be different than the Connection Type of the List View.
        let connectionTypeIdKey: string | null | undefined;
        if (isDockedPanelVisible.value) {
            connectionTypeIdKey = dockedPanelDetailsBox.value?.options?.connectionTypeIdKey;
        }
        else {
            // AssignRequestModal (the only non-docked-panel caller) is bulk-only.
            connectionTypeIdKey = bulkConnectionTypeOptions.value?.idKey;
        }

        const result = await invokeBlockAction<ConnectionListGridUpdateBag[]>("ReassignConnector", {
            connectionRequestIdKeys: connectionRequestIdKeys,
            connectorPersonAliasGuid: connector,
            connectionTypeIdKey
        });

        if (result.isSuccess && result.data) {
            const rowsByIdKey = new Map(
                gridData.value?.rows?.map(r => [r.idKey, r])
            );

            for (const updateBag of result.data) {
                const row = rowsByIdKey.get(updateBag.idKey);
                if (!row) {
                    continue;
                }

                row.connectorGrouping = updateBag.connectorGrouping;
                row.connectorDetails = updateBag.connectorDetails;
            }

            mergeConnectorGroupings(result.data.map(u => u.connectorGroupingField));

            // Need to validate the updated rows still meet server filter requirements.
            applyServerFilters();

            if (fromDockedPanel) {
                dockedPanelDetailsBox.value?.entity?.connectorPerson === result.data[0].connectorDetails?.value;
                refreshActivityEntries(connectionRequestIdKeys[0]);
            }

            clearAllSelections();
            isAssignRequestModalVisible.value = false;
            return;
        }

        modalErrorMessage.value = result.errorMessage ?? "An error occurred while assigning the Connector.";
    }

    async function fetchConnectionCampaigns(): Promise<void> {
        const result = await invokeBlockAction<Record<string, ConnectionCampaignBag[]>>("FetchConnectionCampaigns");

        if (result.isSuccess && result.data) {
            campaignRecordBags.value = result.data;
            return;
        }
        console.error(result.errorMessage);
    }

    async function assignRequestsFromCampaign(bag: AssignFromCampaignBag): Promise<void> {
        try {
            isModalSaving.value = true;

            const result = await invokeBlockAction("AssignConnectionRequestsFromCampaign", { bag });

            if (result.isSuccess) {
                loadGridData();
                isAddFromCampaignModalVisible.value = false;
                return;
            }

            modalErrorMessage.value = result.errorMessage ?? "An error occurred while assigning Connection Requests from the selected Campaign.";
        }
        finally {
            isModalSaving.value = false;
        }
    }

    async function upsertCelebration(bag: UpsertCelebrationBag): Promise<void> {
        try {
            isModalSaving.value = true;

            // If the action comes from a docked panel than the Connection Type could be different than the Connection Type of the List View.
            let connectionTypeIdKey: string | null | undefined;
            if (isDockedPanelVisible.value) {
                connectionTypeIdKey = dockedPanelDetailsBox.value?.options?.connectionTypeIdKey;
            }
            else {
                connectionTypeIdKey = activeRowConnectionTypeIdKey.value;
            }

            const result = await invokeBlockAction<ConnectionListGridUpdateBag>("UpsertCelebrationText", { bag, connectionTypeIdKey });

            if (result.isSuccess && result.data) {
                const row = gridData.value?.rows?.find(r => r.idKey === result.data?.idKey);

                if (row) {
                    row.celebrationText = result.data.celebrationText;
                }
                if (dockedPanelDetailsBox.value?.entity) {
                    dockedPanelDetailsBox.value.entity.celebrationText = result.data.celebrationText;
                }

                isCelebrationModalVisible.value = false;
                return;
            }

            modalErrorMessage.value = result.errorMessage ?? "An error occurred while updating the celebration.";
        }
        finally {
            isModalSaving.value = false;
        }
    }

    async function getConnectionRequestDetails(requestIdKey: string): Promise<void> {
        // Explicitly enter the loading state before fetching. We cannot rely on the docked
        // panel's detailsBox watch to do this, because when the previous request errored the
        // details box is already undefined, so re-assigning undefined below is not a reference
        // change and the watch never fires to show the loading skeleton.
        connectionRequestDockedPanelRef.value?.setIsLoading(true);

        dockedPanelDetailsBox.value = undefined;

        const result = await invokeBlockAction<ConnectionRequestDetailBox>("GetConnectionRequestDetails", { connectionRequestIdKey: requestIdKey });

        if (result.isSuccess && result.data) {
            dockedPanelDetailsBox.value = result.data;
            return;
        }

        connectionRequestDockedPanelRef.value?.setIsLoading(false);
        connectionRequestDockedPanelRef.value?.setErrorMessage("view", result.errorMessage ?? "An error occurred while getting the Connection Request details.");
    }

    async function refreshActivityEntries(requestIdKey: string | null | undefined): Promise<void> {
        // We only need to refresh activity entries if the docked panel is open and has data.
        if (!isDockedPanelVisible.value || !dockedPanelDetailsBox.value?.entity || !requestIdKey) {
            return;
        }

        const result = await invokeBlockAction<ActivityEntryBag[]>("GetActivityEntries", {
            connectionRequestIdKey: requestIdKey
        });

        if (result.isSuccess && result.data) {
            dockedPanelDetailsBox.value.entity.activityEntries = result.data;
        }
        else {
            connectionRequestDockedPanelRef.value?.setErrorMessage("activity", result.errorMessage ?? "An error occurred while getting the Connection Request activity entries.");
        }
    }

    async function reorderConnectionRequest(idKey: string, beforeIdKey: string | null, statusGroupKey: string): Promise<void> {
        const result = await invokeBlockAction<number>("ReorderConnectionRequest", {
            connectionRequestIdKey: idKey,
            beforeIdKey
        });
        const rowIndex = gridData.value?.rows?.findIndex(r => r.idKey === idKey) ?? -1;

        if (result.isSuccess && gridData.value?.rows && rowIndex !== -1) {
            const newOrder = result.data as number;

            // Mirror the server-side BulkUpdate: increment sibling orders
            // in the same status column at or after the new position.
            for (const sibling of gridData.value.rows) {
                if (sibling.idKey !== idKey
                    && sibling.statusGrouping === statusGroupKey
                    && (sibling.order as number) >= newOrder) {
                    (sibling.order as number) += 1;
                }
            }

            const row = gridData.value.rows[rowIndex];
            row.order = newOrder;
        }
        else {
            console.error(result.errorMessage ?? "An error occurred while reordering the Connection Request.");
        }
    }

    async function getSnapshotMetrics(): Promise<void> {
        const result = await invokeBlockAction<CompletionMetricsBag>("GetSnapshotMetrics");

        if (result.isSuccess && result.data) {
            snapshotMetrics.value = result.data;
        }
        else {
            console.error(result.errorMessage ?? "An unknown error occurred while fetching the snapshot metrics.");
        }
    }

    // Refetches the snapshot metrics when the snapshot is open so it reflects the current
    // Connection Type, Opportunity, and Campus filters. The server reads the Type and
    // Opportunity filters from person preferences, so callers must persist those preferences
    // before invoking this; Campus is read from the request context entity.
    function refreshSnapshotMetricsIfVisible(): void {
        if (isSnapshotVisible.value) {
            getSnapshotMetrics();
        }
    }

    // #endregion Block Actions

    // When any modal is open, disable close-on-outside-click for the docked panel so that
    // clicking inside a modal doesn't accidentally close the panel behind it.
    watch([isTransferModalVisible, isCelebrationModalVisible, isActivityModalVisible, isReminderModalVisible, isSendSMSModalVisible, isSendEmailModalVisible, isFlyoutOpen, isModalAlertVisible, isDeleteRequestModalVisible], (values) => {
        handleClickOutsideSettingForDockedPanel(!values.some(Boolean));
    });

    watch(isChangeStatusModalVisible, () => {
        // Clear selected status whenever the change status modal is closed.
        if (!isChangeStatusModalVisible.value) {
            selectedStatus.value = null;
        }
    });

    watch(selectedConnector, async () => {
        preferences.setValue(PreferenceKey.SelectedConnector, selectedConnector.value);

        removeCurrentUrlQueryParams("Connector");

        await preferences.save();

        loadGridData();
    });

    watch(selectedCampus, () => {
        newConnectionRequest.value.bag = {
            ...newConnectionRequest.value.bag,
            campusGuid: selectedCampus.value?.value ?? null
        };

        refreshSnapshotMetricsIfVisible();
    });

    watch(selectedType, async () => {
        if (!isMyConnectionsView.value) {
            return;
        }

        preferences.setValue(PreferenceKey.FilterConnectionType, selectedType.value);

        await preferences.save();

        // Once the individual changes or clears the type filter, the FilterConnectionType
        // preference is the source of truth. Clear the ConnectionType query string param (used
        // only to seed the filter on arrival) so a page reload doesn't re-apply the seeded type.
        removeCurrentUrlQueryParams("ConnectionType");

        if (!isNullOrWhiteSpace(selectedType.value)) {
            await refreshUserEditPermissions();
        }
        else {
            canEditGlobalConnectionRequests.value = allConnectionTypeOptions.value.flatMap(t => t.canEditConnectionRequests).some(t => t === true);
        }

        refreshSnapshotMetricsIfVisible();
        loadGridData();
    });

    watch(selectedOpportunity, async () => {
        preferences.setValue(getConnectionFilterKey(PreferenceKey.ConnectionmOpportunityFilterConnectionTypeIdKey), selectedOpportunity.value);

        await preferences.save();

        refreshSnapshotMetricsIfVisible();

        newConnectionRequest.value.bag = {
            connectionOpportunityGuid: selectedOpportunity.value
        };
        if (!isNullOrWhiteSpace(selectedOpportunity.value)) {
            await fetchConnectionOpportunityDetails(selectedOpportunity.value);
        }
        else {
            connectionOpportunityDetails.value = {};
        }

        // Remove the Connection Opportunity query param and ensure ConnectionType is present.
        removeCurrentUrlQueryParams("ConnectionOpportunity");

        // If there is no connection type query string parameter present, we need to add it
        // because we've just removed the Connection Opportunity query string parameter.
        if (staticConnectionTypeOptions.value?.idKey) {
            const url = new URL(window.location.href);
            if (!url.searchParams.has("ConnectionType")) {
                url.searchParams.set("ConnectionType", staticConnectionTypeOptions.value.idKey);
                history.replaceState(null, "", url.toString());
            }
        }

        await refreshUserEditPermissions();
        loadGridData();
    });

    // Ensure the selected grouping remains valid when the available grouping options
    // change (e.g., when filtering out opportunity grouping after selecting an opportunity).
    watch(groupingFields, (newFields) => {
        const selected = selectedGrouping.value;

        const isStillValid = newFields.some(f => f.value === selected);

        if (!isStillValid) {
            selectedGrouping.value = newFields[0]?.value ?? "";
        }
    });

    watch(viewOptions, async () => {
        preferences.setValue(getConnectionFilterKey(PreferenceKey.FilterSortByConnectionTypIdKey), viewOptions.value.sortBy ?? "");
        preferences.setValue(getConnectionFilterKey(PreferenceKey.FilterGridDataToShowConnectionTypIdKey), JSON.stringify(viewOptions.value.gridDataToShow));
        preferences.setValue(getConnectionFilterKey(PreferenceKey.FilterIsRequestSourceShownConnectionTypIdKey), viewOptions.value.isRequestSourceShown.toString());
        preferences.setValue(getConnectionFilterKey(PreferenceKey.FilterStatusConnectionTypIdKey), JSON.stringify(viewOptions.value.statusFilter));
        preferences.setValue(getConnectionFilterKey(PreferenceKey.FilterDueConnectionTypIdKey), JSON.stringify(viewOptions.value.dueFilter));

        await preferences.save();
    });

    // Attribute filters apply server-side, so persist them and reload the grid
    // whenever the user saves a change to them from the View Options modal.
    //
    // The modal's onSave creates a new attributeFilterValues object on every emit
    // (via { ...attributeFilterValues.value }), which means a reference-only watch
    // would fire even when an unrelated client-side filter (status, due) changed.
    // We compare the new value against the previous value deeply so that this
    // watcher only triggers a grid reload when an attribute filter actually changed.
    watch(() => viewOptions.value.attributeFilterValues, async (newValue, oldValue) => {
        if (deepEqual(newValue, oldValue, true)) {
            return;
        }

        preferences.setValue(getConnectionFilterKey(PreferenceKey.FilterAttributeValuesConnectionTypeIdKey), JSON.stringify(newValue ?? {}));
        await preferences.save();
        loadGridData();
    });

    watch(selectedView, async () => {
        removeCurrentUrlQueryParams("SelectedView");
        clearAllSelections();

        if (selectedView.value === "list") {
            selectedGrouping.value = isNullOrWhiteSpace(preferences.getValue(PreferenceKey.SelectedGroupByMode)) ? selectedGrouping.value : preferences.getValue(PreferenceKey.SelectedGroupByMode);
        }

        preferences.setValue(getConnectionFilterKey(PreferenceKey.SelectedViewConnectionTypeIdKey), selectedView.value);

        await preferences.save();
    });

    watch(() => viewOptions.value.stateFilter, async () => {
        preferences.setValue(getConnectionFilterKey(PreferenceKey.FilterStateConnectionTypIdKey), JSON.stringify(viewOptions.value.stateFilter));
        await preferences.save();
        loadGridData();
    });

    // watch(newConnectionRequest, () => {
    //     onAddRequest(newConnectionRequest.value);
    // });

    watch(selectedGrouping, async () => {
        // Only update the selected group by mode person preference when the selected view is "List".
        if (selectedView.value !== "list") {
            return;
        }

        preferences.setValue(PreferenceKey.SelectedGroupByMode, selectedGrouping.value);
        await preferences.save();
    });

    watch(isAutoCollapseEnabled, async () => {
        preferences.setValue(PreferenceKey.IsAutoCollapseEnabled, isAutoCollapseEnabled.value.toString());
        await preferences.save();
    });

    watch(selectedRequestKeyForDockedPanel, async () => {
        if (!isNullOrWhiteSpace(selectedRequestKeyForDockedPanel.value)) {
            await getConnectionRequestDetails(selectedRequestKeyForDockedPanel.value);
        }
    });

    watch(isActivityModalVisible, (isVisible) => {
        if (!isVisible) {
            activityToEdit.value = null;
        }
    });

    watch(rawQuickFilter, debounce(() => {
        debouncedQuickFilter.value = rawQuickFilter.value;
    }, 150));

    loadContextValues();

    if (isNullOrWhiteSpace(box.options?.errorMessage)) {
        loadGridData();
    }
    else {
        requestListErrorMessage.value = box.options?.errorMessage ?? "An error occurred while loading the Block.";
        areRequestsLoading.value = false;
    }

    if (!isNullOrWhiteSpace(box.options?.connectionRequestIdKey)) {
        onSelectItem(box.options!.connectionRequestIdKey!);
    }

    onConfigurationValuesChanged(useReloadBlock());

    onMounted(() => {
        document.addEventListener("click", handleOutsideClick);
    });

    onBeforeUnmount(() => {
        document.removeEventListener("click", handleOutsideClick);
    });
</script>
