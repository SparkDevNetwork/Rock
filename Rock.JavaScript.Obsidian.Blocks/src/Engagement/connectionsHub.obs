<template>
    <div class="connections-hub">
        <ContextSlicer title="View"
                       class="connections-hub-slicer"
                       showCampus
                       isContentWrapped>
            <template #default>
                <div class="connections-hub-view-toggle">
                    <ButtonGroup v-show="enabledViews.length > 1"
                                 v-model="selectedView"
                                 :items="enabledViews"
                                 :btnSize="BtnSize.ExtraSmall" />
                </div>
                <DropDownList v-if="!isMyConnectionsView"
                              v-model="selectedConnector"
                              :items="staticConnectionTypeOptions?.connectorKeyItems ?? []"
                              blankValue="All Requests"
                              enhanceForLongLists
                              class="ant-select-sm" />
                <DropDownList v-else-if="!selectedOpportunity"
                              v-model="selectedType"
                              :items="box.options?.connectionTypeItems ?? []"
                              class="ant-select-sm"
                              blankValue="All Types" />
                <DropDownList v-model="selectedOpportunity"
                              :items="connectionOpportunities ?? []"
                              class="ant-select-sm"
                              blankValue="All Opportunities" />
            </template>
            <template #rightContent v-if="!isMyConnectionsView">
                <RockButton isSquare
                            title="My Connections"
                            :btnSize="BtnSize.Small"
                            @click="onMyConnectionsClick">
                    <i class="ti ti-user-circle"></i>
                </RockButton>
            </template>
        </ContextSlicer>

        <GroupedPanel v-model:quickFilterValue="rawQuickFilter"
                      v-model:groupingKey="selectedGrouping"
                      v-model:orderedRequestKeys="orderedRequestKeys"
                      v-model:viewMode="selectedView"
                      ref="groupedPanel"
                      :title="box.options?.title ?? ''"
                      :titleIconCssClass="`${box.options?.iconCssClass ?? ''} panel-icon`"
                      :isSelectedView="hasAnySelectedKeys"
                      :rows="gridData?.rows ?? []"
                      :filteredAndSortedRows="visibleRowsFilteredByGrid"
                      :panelSettingsActive="hasSettingsFilters"
                      :groupingFields="groupingFields"
                      itemTerm="Request"
                      :isCountMessageVisible="isGroupCountMessageVisible"
                      hasFullscreen
                      :onAddItem="canEditConnectionRequests ? onAddItem : undefined"
                      :onPanelSettingsClick="onPanelSettingsClick"
                      :isAutoCollapseEnabled="isAutoCollapseEnabled"
                      :headerSecondaryActions="secondaryActions"
                      :availableGroups="availableGroups"
                      :canDropOnGroup="canDropOnGroup"
                      :isGroupDrag="isCardInGroupDrag"
                      :selectedCount="allSelectedKeys.length"
                      :onSnapshotClick="isMyConnectionsView ? onSnapshotClick : undefined"
                      :isSnapshotVisible="isSnapshotVisible"
                      @cardMoved="onCardMoved">
            <template #snapshot>
                <Snapshot :metrics="snapshotMetrics" />
            </template>
            <template #selectedActionToolbar>
                <div ref="toolbarElement" class="left-actions">
                    <div class="selected-count">
                        <RockLabel class="selected-count-label">Selected</RockLabel>
                        <Badge class="selected-count-badge">{{ allSelectedKeys.length }}</Badge>
                    </div>
                    <div class="toolbar-primary-actions">
                        <!-- Primary actions are always shown as buttons in both layouts. -->
                        <RockButton class="activity-btn" @click="showAssignRequestModal" :disabled="!canEditConnectionRequests || disableConnectionTypeSpecificBulkActions">
                            <i class="ti ti-user-circle"></i>
                            <span class="activity-btn-label">Assign</span>
                        </RockButton>
                        <RockButton @click="showChangeStatusModal()" class="activity-btn" :disabled="!canEditConnectionRequests || disableConnectionTypeSpecificBulkActions">
                            <template v-if="bulkConnectionTypeOptions?.isSequentialStatusMode">
                                <i class="ti ti-arrow-right"></i>
                                <span class="activity-btn-label">Advance to Next Status</span>
                            </template>
                            <template v-else>
                                <i class="ti ti-select"></i>
                                <span class="activity-btn-label">Change Status</span>
                            </template>
                        </RockButton>

                        <!-- Left-hand secondary actions: buttons on wide screens, folded into the overflow menu when compact. -->
                        <template v-if="!isToolbarCompact">
                            <RockButton v-for="action in primaryToolbarActions"
                                        :key="action.key"
                                        class="activity-btn"
                                        :disabled="isToolbarActionDisabled(action)"
                                        @click="action.handler()">
                                <i :class="action.iconCssClass"></i>
                                <span class="activity-btn-label">{{ action.label }}</span>
                            </RockButton>
                        </template>

                        <!--
                            A single overflow menu. On wide screens it holds only the edit-only state
                            changes; when the toolbar collapses (isToolbarCompact) the secondary
                            actions fold in above them.
                        -->
                        <DropDownContent v-if="isToolbarOverflowMenuShown"
                                         v-model="isToolbarOverflowMenuOpen"
                                         enableFlip
                                         :placement="isToolbarCompact ? 'bottom-end' : 'bottom-start'"
                                         preventAnchorClickPropagation>
                            <template #anchor>
                                <i class="ti ti-dots-vertical dropdown-anchor-icon"></i>
                            </template>
                            <div class="dropdown-content">
                                <template v-if="isToolbarCompact">
                                    <div v-for="action in foldedToolbarActions"
                                         :key="action.key"
                                         class="dropdown-content-item dropdown-content-item--menu-action"
                                         :class="{ 'dropdown-content-item--danger': action.isDanger, disabled: isToolbarActionDisabled(action) }"
                                         @click.stop="onToolbarMenuActionClick(action)">
                                        <i :class="getToolbarMenuIconClass(action)"></i>{{ action.label }}
                                    </div>
                                    <div v-if="canEditConnectionRequests" class="dropdown-content-divider"></div>
                                </template>
                                <template v-if="canEditConnectionRequests">
                                    <div v-for="action in stateToolbarActions"
                                         :key="action.key"
                                         class="dropdown-content-item dropdown-content-item--menu-action"
                                         :class="{ 'dropdown-content-item--danger': action.isDanger, disabled: isToolbarActionDisabled(action) }"
                                         @click.stop="onToolbarMenuActionClick(action)">
                                        <i :class="getToolbarMenuIconClass(action)"></i>{{ action.label }}
                                    </div>
                                </template>
                            </div>
                        </DropDownContent>
                    </div>
                </div>
                <div class="right-actions">
                    <!-- Right-hand secondary actions: buttons on wide screens, folded into the overflow menu when compact. -->
                    <template v-if="!isToolbarCompact">
                        <div class="toolbar-communication-actions">
                            <RockButton v-for="action in communicationToolbarActions"
                                        :key="action.key"
                                        class="activity-btn"
                                        :disabled="isToolbarActionDisabled(action)"
                                        @click="action.handler()">
                                <i :class="action.iconCssClass"></i>
                                <span class="activity-btn-label">{{ action.label }}</span>
                            </RockButton>
                        </div>
                        <div class="border-left-divider toolbar-management-actions">
                            <RockButton v-for="action in managementToolbarActions"
                                        :key="action.key"
                                        class="activity-btn"
                                        :disabled="isToolbarActionDisabled(action)"
                                        @click="action.handler()">
                                <i :class="action.iconCssClass"></i>
                                <span class="activity-btn-label">{{ action.label }}</span>
                            </RockButton>
                        </div>
                    </template>
                    <div class="toolbar-clear-selection">
                        <i class="ti ti-x" @click="clearAllSelections"></i>
                    </div>
                </div>
            </template>
            <template #headerActions="{ groupRows }">
                <HighlightLabel v-if="shouldShowDueSoonHighlight(groupRows)" labelType="warning">
                    {{ getDueSoonCount(groupRows) }} Due Soon
                </HighlightLabel>
                <HighlightLabel v-if="shouldShowOverdueHighlight(groupRows)" labelType="danger">
                    {{ getOverdueCount(groupRows) }} Overdue
                </HighlightLabel>
            </template>
            <template #grid="{ group, setGridRef }">
                <Grid :definition="box.gridDefinition ?? undefined"
                      :ref="setGridRef"
                      :data="group.gridData"
                      keyField="idKey"
                      :isTitleHidden="true"
                      :isSearchVisible="false"
                      :isFooterHidden="true"
                      :showExport="false"
                      :showMergeTemplate="false"
                      :isCountMessageVisible="false"
                      :hideFilterHeaderRow="true"
                      light
                      :forceVirtualRowsOnLight="true"
                      class="grid-hover"
                      @selectedKeysChanged="state => onSelectedKeysChanged(group.key, state)"
                      @selectItem="onSelectItem"
                      @onLoad="state => onGridLoad(group.key, state)"
                      @onUnload="state => onGridUnload(group.key, state)">
                    <SelectColumn />

                    <PersonColumn name="requestDetails"
                                  title="Request Details"
                                  field="requestDetails" />

                    <Column v-if="isMyConnectionsView"
                            name="type"
                            field="connectionTypeName"
                            width="80px">
                        <template #format="{ row }">
                            <div class="type-icon-container" v-tooltip="`Type: ${row.connectionTypeName}`">
                                <i :class="row.connectionTypeIconCssClass" class="type-icon"></i>
                            </div>
                        </template>
                    </Column>

                    <Column v-if="viewOptions.gridDataToShow?.includes('connectionOpportunity') && selectedGrouping !== 'opportunityGrouping'"
                            name="connectionOpportunity"
                            field="connectionOpportunity">
                        <template #format="{ row }">
                            <div class="grid-opportunity-cell">
                                <HighlightLabel labelType="custom"
                                                customClass="label-default grid-opportunity-cell-label">
                                    {{ row.connectionOpportunity }}
                                </HighlightLabel>
                                <span v-if="!isNullOrWhiteSpace(row.connectionTypeSource) && viewOptions.isRequestSourceShown"
                                      class="grid-cell-subtext">
                                    {{ row.connectionTypeSource }}
                                </span>
                            </div>
                        </template>
                    </Column>

                    <Column v-if="selectedGrouping !== 'connectorGrouping'"
                            title="Connector"
                            name="connectorDetails"
                            field="connectorDetails">
                        <template #format="{ row }">
                            {{ row.connectorDetails?.text }}
                        </template>
                    </Column>

                    <Column v-if="selectedGrouping !== 'campusGrouping'"
                            name="campus"
                            title="Campus"
                            field="campus">
                        <template #format="{ row }">
                            <div v-if="!!row.campus">
                                {{ row.campus }}
                            </div>
                            <div v-else>
                                <i class="ti ti-minus"></i>
                            </div>
                        </template>
                    </Column>

                    <Column v-if="allConnectionTypeOptions.some(t => t.areGroupPlacementsEnabled)"
                            name="group"
                            title="Group"
                            field="group">
                        <template #format="{ row }">
                            <template v-if="!!row.group && connectionTypeOptionsByIdKey[row.connectionTypeIdKey]?.areGroupPlacementsEnabled">
                                <div v-if="row.isPendingMember" class="grid-group-cell" :class="{ 'grid-group-cell--archived': !!row.isPlacementGroupInactiveOrArchived }" v-tooltip="'Pending group member. The requester will be added once the request is completed.'">
                                    {{ row.group }}
                                    <i class="ti ti-user-share"></i>
                                </div>
                                <div v-else class="grid-group-cell" :class="{ 'grid-group-cell--archived': !!row.isPlacementGroupInactiveOrArchived }">
                                    {{ row.group }}
                                </div>
                            </template>
                            <div v-else>
                                <i class="ti ti-minus"></i>
                            </div>
                        </template>
                    </Column>

                    <Column v-if="viewOptions.gridDataToShow?.includes('activity')"
                            name="activity"
                            title="Activity"
                            field="activity">
                        <template #format="{ row }">
                            <div v-if="!!row.lastActivityDateTime && !!row.activityCount"
                                 class="grid-activity-cell">
                                <div class="activity-metric activity-metric--date">
                                    <i class="ti ti-calendar-month"></i>
                                    <span>
                                        {{ getElapsedShortTime(row.lastActivityDateTime) }}
                                    </span>
                                </div>
                                <div class="activity-metric activity-metric--count">
                                    <i class="ti ti-bolt"></i>
                                    <span>
                                        {{ row.activityCount }}
                                    </span>
                                </div>
                            </div>
                            <div v-else>
                                <i class="ti ti-minus"></i>
                            </div>
                        </template>
                    </Column>

                    <Column v-if="viewOptions.gridDataToShow?.includes('dueDate')"
                            name="dueDate"
                            title="Due"
                            field="dueDate"
                            width="2%">
                        <template #format="{ row }">
                            <div v-if="!!row.dueDate && row.connectionState !== ConnectionState.Inactive" :class="getDueDateColor(row.dueStatus, row.connectionState === ConnectionState.Connected)">
                                {{ formatDueDateShortLabel(row.dueDate, row.connectionState === ConnectionState.Connected, row.completedDateTime) }}
                            </div>
                            <div v-else>
                                <i class="ti ti-minus"></i>
                            </div>
                        </template>
                    </Column>

                    <AttributeColumns :attributes="attributesToShow" />

                    <Column v-if="allConnectionTypeOptions.some(t => t.areCelebrationsEnabled)"
                            name="celebration"
                            field="celebration"
                            width="52">
                        <template #format="{ row }">
                            <template v-if="!isMyConnectionsView || connectionTypeOptionsByIdKey[row.connectionTypeIdKey]?.areCelebrationsEnabled === true">
                                <i v-if="isNullOrWhiteSpace(row.celebrationText)"
                                   class="ti ti-confetti grid-action-icon"
                                   :ref="(el) => addTooltip(el as Element)"
                                   data-toggle="tooltip"
                                   data-placement="auto"
                                   data-container="body"
                                   data-original-title="Add Celebration"
                                   @click.stop="showCelebrationModal(row)">
                                </i>
                                <i v-else
                                   class="ti ti-confetti-filled grid-action-icon grid-action-icon--active"
                                   :ref="(el) => addTooltip(el as Element)"
                                   data-toggle="tooltip"
                                   data-placement="auto"
                                   data-container="body"
                                   data-original-title="Has Celebration"
                                   @click.stop="showCelebrationModal(row)">
                                </i>
                            </template>
                            <template v-else>
                                <i class="ti ti-confetti disabled"></i>
                            </template>
                        </template>
                    </Column>

                    <Column v-if="allConnectionTypeOptions.some(t => t.areRemindersEnabled)"
                            name="reminder"
                            field="reminder"
                            width="52">
                        <template #format="{ row }">
                            <template v-if="!isMyConnectionsView || connectionTypeOptionsByIdKey[row.connectionTypeIdKey]?.areRemindersEnabled === true">
                                <i v-if="row.reminderCount > 0"
                                   class="ti ti-bell-filled grid-action-icon grid-action-icon--active"
                                   :ref="(el) => addTooltip(el as Element)"
                                   data-toggle="tooltip"
                                   data-placement="auto"
                                   data-container="body"
                                   :data-original-title="`${row.reminderCount} ${pluralize('Reminder', row.reminderCount)}`"
                                   @click.stop="showReminderModal(row)">
                                </i>
                                <i v-else
                                   class="ti ti-bell grid-action-icon"
                                   :ref="(el) => addTooltip(el as Element)"
                                   data-toggle="tooltip"
                                   data-placement="auto"
                                   data-container="body"
                                   data-original-title="Add Reminder"
                                   @click.stop="showReminderModal(row)">
                                </i>
                            </template>
                            <template v-else>
                                <i class="ti ti-bell disabled"></i>
                            </template>
                        </template>
                    </Column>

                    <Column name="connectionStatus"
                            field="connectionStatus">
                        <template #format="{ row }">
                            <div class="grid-status-cell">
                                <template v-if="row.connectionState === ConnectionState.Active">
                                    <ConnectionStatusButton :isSequentialStatusMode="connectionTypeOptionsByIdKey[row.connectionTypeIdKey]?.isSequentialStatusMode"
                                                            :highlightColor="row.connectionStatus.highlightColor"
                                                            :currentStatusName="row.connectionStatus.name"
                                                            :disabled="!canEditConnectionRequests"
                                                            @click.stop="(e) => onStatusClick(row, e)" />
                                </template>
                                <div v-else-if="row.connectionState === ConnectionState.Inactive"
                                     class="grid-status-cell-state-label text-slate">
                                    {{ ConnectionStateDescription[ConnectionState.Inactive] }}
                                </div>
                                <div v-else-if="row.connectionState === ConnectionState.FutureFollowUp"
                                     class="grid-status-cell-state-label grid-status-cell-state-label--future-follow-up">
                                    {{ ConnectionStateDescription[ConnectionState.FutureFollowUp] }} - {{ asLocaleString(row.followUpDate) }}
                                </div>
                                <div v-else-if="row.connectionState === ConnectionState.Connected"
                                     class="grid-status-cell-state-label text-emerald">
                                    {{ ConnectionStateDescription[ConnectionState.Connected] }}
                                </div>
                            </div>
                        </template>
                    </Column>

                    <Column name="options"
                            field="options"
                            width="52"
                            itemClass="grid-cell-overflow">
                        <template #format="{ row }">
                            <DropDownContent :modelValue="openDropdownIndex === row.idKey"
                                             @update:modelValue="val => openDropdownIndex = val ? row.idKey : null"
                                             enableFlip
                                             placement="bottom-end"
                                             preventAnchorClickPropagation>
                                <template #anchor>
                                    <i class="ti ti-dots-vertical dropdown-anchor-icon"></i>
                                </template>
                                <div class="dropdown-content">
                                    <template v-if="canEditConnectionRequests">
                                        <div class="dropdown-content-item dropdown-content-item--menu-action"
                                             @click.stop="showChangeStateModal(ConnectionState.Active, row)">
                                            <i class="ti ti-user"></i>Set as Active
                                        </div>
                                        <div class="dropdown-content-item dropdown-content-item--menu-action"
                                             @click.stop="showChangeStateModal(ConnectionState.Inactive, row)">
                                            <i class="ti ti-user-off"></i>Set as Inactive
                                        </div>
                                        <div v-if="box.options?.connectionTypeOptionsByIdKey && box.options.connectionTypeOptionsByIdKey[row.connectionTypeIdKey]?.isFutureFollowUpEnabled"
                                             class="dropdown-content-item dropdown-content-item--menu-action"
                                             @click.stop="showChangeStateModal(ConnectionState.FutureFollowUp, row)">
                                            <i class="ti ti-calendar"></i>Set as Future Follow-Up
                                        </div>
                                        <div class="dropdown-content-item dropdown-content-item--menu-action"
                                             @click.stop="showChangeStateModal(ConnectionState.Connected, row)">
                                            <i class="ti ti-circle-check"></i>Mark Complete
                                        </div>
                                    </template>
                                    <div class="dropdown-content-item dropdown-content-item--menu-action"
                                         @click.stop="showLaunchWorkflowModal(row)">
                                        <i class="ti ti-settings-cog"></i>Launch Workflow
                                    </div>
                                    <template v-if="canEditConnectionRequests">
                                        <div v-if="!row.isRequestSecurityDisabled"
                                             class="dropdown-content-item dropdown-content-item--menu-action"
                                             @click.stop="showSecurityModal(row.idKey)">
                                            <i class="ti ti-lock"></i>Security
                                        </div>
                                        <div class="dropdown-content-item dropdown-content-item--menu-action dropdown-content-item--danger"
                                             @click.stop="showDeleteRequestModal(row)">
                                            <i class="ti ti-trash"></i>Delete
                                        </div>
                                    </template>
                                </div>
                            </DropDownContent>
                        </template>
                    </Column>
                </Grid>
            </template>
            <template #emptyView>
                <template v-if="areRequestsLoading">
                    <!-- Board View Skeleton -->
                    <div v-if="selectedView === 'board'" class="skeleton-board">
                        <div v-for="columnIndex in skeletonCount" :key="`board-col-${columnIndex}`" class="skeleton-board-column">
                            <div class="skeleton skeleton-heading"></div>
                            <div v-for="cardIndex in 4" :key="`board-card-${columnIndex}-${cardIndex}`"
                                 class="skeleton skeleton-board-card"></div>
                        </div>
                    </div>
                    <!-- Grid View Skeleton -->
                    <div v-else-if="selectedView === 'grid'" class="skeleton-grid">
                        <div v-for="rowIndex in 16" :key="`grid-row-${rowIndex}`" class="skeleton-grid-row" :class="{ 'skeleton-grid-row--alt': rowIndex % 2 === 0 }">
                            <div v-for="colIndex in 8" :key="`grid-col-${colIndex}`"
                                 :style="colIndex % 2 === 0 ? 'max-width: 260px;' : 'max-width: 160px;'"
                                 class="skeleton skeleton-text" />
                        </div>
                    </div>
                    <!-- List View Skeleton -->
                    <div v-else class="skeleton-list">
                        <div v-for="index in skeletonCount" :key="`list-${index}`" class="skeleton skeleton-list-item"></div>
                    </div>
                </template>
                <template v-else>
                    <NotificationBox v-if="!isNullOrWhiteSpace(requestListErrorMessage)"
                                     alertType="danger">
                        {{ requestListErrorMessage }}
                    </NotificationBox>
                    <div class="empty-list">
                        <i class="ti ti-id-off empty-list-icon"></i>
                        <div class="empty-list-message">
                            No Connection Requests Available
                        </div>
                        <div v-if="canEditConnectionRequests"
                             class="empty-list-cta"
                             @click="onAddItem">
                            Add a Request to Get Started
                        </div>
                    </div>
                </template>
            </template>
            <template #boardCard="{ row }">
                <ConnectionRequestCard :connectionRequest="row"
                                       :options="box.options"
                                       :connectionTypeOptions="staticConnectionTypeOptions"
                                       :canEditConnectionRequests="canEditConnectionRequests"
                                       :hideCampusLabel="selectedCampus !== null"
                                       :viewOptions="viewOptions"
                                       :attributesToShow="attributesToShow"
                                       :currentPersonIdKey="currentPerson?.idKey"
                                       :isSelected="allSelectedKeySet.has(row.idKey as string)"
                                       @selectItem="onSelectBoardCard"
                                       @toggleSelection="onToggleBoardCardSelection"
                                       @changeState="showChangeStateModal"
                                       @launchWorkflow="showLaunchWorkflowModal"
                                       @showSecurity="showSecurityModal"
                                       @delete="showDeleteRequestModal" />
            </template>
            <template #emptyColumn>
                <div class="grid-empty-column">No requests available.</div>
            </template>
            <template #gridView>
                <Grid :definition="box.gridDefinition ?? undefined"
                      :data="gridViewData"
                      ref="gridViewGridRef"
                      keyField="idKey"
                      personKeyField="personIdKey"
                      :isTitleHidden="true"
                      :isSearchVisible="false"
                      :isFooterHidden="true"
                      :showExport="false"
                      :showMergeTemplate="false"
                      :isCountMessageVisible="false"
                      :hideFilterHeaderRow="true"
                      :entityTypeGuid="EntityType.ConnectionRequest"
                      class="grid-hover connections-hub-list-grid"
                      @selectItem="onSelectItem"
                      @selectedKeysChanged="state => onSelectedKeysChanged('all', state)"
                      @filteredRowsChanged="onFilteredRowsChanged">
                    <SelectColumn />

                    <Column name="requestDetails"
                            title="Name"
                            field="requestDetails"
                            :filter="pickExistingValueFilter"
                            :filterValue="getRequesterFilterValue"
                            :sortValue="getRequesterFilterValue">
                        <template #format="{ row }">
                            {{ row.requestDetails.nickName }} {{ row.requestDetails.lastName }}
                        </template>
                    </Column>

                    <Column title="Connector"
                            name="connectorDetails"
                            field="connectorDetails"
                            :filter="pickExistingValueFilter"
                            :filterValue="getConnectorFilterValue"
                            :sortValue="getConnectorFilterValue">
                        <template #format="{ row }">
                            {{ row.connectorDetails?.text }}
                        </template>
                    </Column>

                    <Column name="campus"
                            title="Campus"
                            field="campus"
                            :filter="pickExistingValueFilter">
                        <template #format="{ row }">
                            <div v-if="!!row.campus">
                                {{ row.campus }}
                            </div>
                            <div v-else>
                                <i class="ti ti-minus"></i>
                            </div>
                        </template>
                    </Column>

                    <TextColumn name="connectionTypeName"
                                title="Type"
                                field="connectionTypeName"
                                :filter="pickExistingValueFilter" />

                    <Column v-if="viewOptions.gridDataToShow?.includes('connectionOpportunity')"
                            name="connectionOpportunity"
                            title="Opportunity"
                            field="connectionOpportunity"
                            :filter="pickExistingValueFilter">
                        <template #format="{ row }">
                            <div class="grid-opportunity-cell">
                                <div>
                                    {{ row.connectionOpportunity }}
                                </div>
                                <span v-if="!isNullOrWhiteSpace(row.connectionTypeSource) && viewOptions.isRequestSourceShown"
                                      class="grid-cell-subtext">
                                    {{ row.connectionTypeSource }}
                                </span>
                            </div>
                        </template>
                        <template #condensed="{ row }">
                            {{ row.connectionOpportunity }}
                        </template>
                    </Column>

                    <Column v-if="allConnectionTypeOptions.some(t => t.areGroupPlacementsEnabled)"
                            name="group"
                            title="Group"
                            field="group"
                            :filter="pickExistingValueFilter">
                        <template #format="{ row }">
                            <template v-if="!!row.group && (!isMyConnectionsView || connectionTypeOptionsByIdKey[row.connectionTypeIdKey]?.areGroupPlacementsEnabled === true)">
                                <div v-if="row.isPendingMember" class="grid-group-cell" v-tooltip="'Pending group member. The requester will be added once the request is completed.'">
                                    {{ row.group }}
                                    <i class="ti ti-user-share"></i>
                                </div>
                                <div v-else>
                                    {{ row.group }}
                                </div>
                            </template>
                            <div v-else>
                                <i class="ti ti-minus"></i>
                            </div>
                        </template>
                        <template #condensed="{ row }">
                            <div v-if="!!row.group">
                                {{ row.group }}
                            </div>
                            <div v-else>
                                <i class="ti ti-minus"></i>
                            </div>
                        </template>
                    </Column>

                    <Column v-if="viewOptions.gridDataToShow?.includes('activity')"
                            name="activityCount"
                            title="Activity"
                            field="activityCount">
                        <template #format="{ row }">
                            <div v-if="!!row.lastActivityDateTime && !!row.activityCount"
                                 class="grid-activity-count-cell">
                                <div>
                                    {{ row.activityCount }} {{ pluralize("Activity", row.activityCount) }}
                                </div>
                                <div class="grid-cell-subtext" v-tooltip="`Last Activity: ${formatColumnDate(row.lastActivityDateTime)}`">
                                    Last Activity: {{ getElapsedShortTime(row.lastActivityDateTime) }}
                                </div>
                            </div>
                            <div v-else>
                                <i class="ti ti-minus"></i>
                            </div>
                        </template>
                    </Column>

                    <Column v-if="viewOptions.gridDataToShow?.includes('dueDate')"
                            name="dueDate"
                            title="Due Date"
                            field="dueDate"
                            width="5%"
                            :filter="dateValueFilter"
                            :sortValue="getDueDateSortValue">
                        <template #format="{ row }">
                            <div v-if="!!row.dueDate && row.connectionState !== ConnectionState.Inactive" :class="getDueDateColor(row.dueStatus, row.connectionState === ConnectionState.Connected)">
                                {{ formatColumnDate(row.dueDate) }}
                            </div>
                            <div v-else>
                                <i class="ti ti-minus"></i>
                            </div>
                        </template>
                    </Column>

                    <Column name="connectionState"
                            title="State"
                            field="connectionState"
                            :filter="pickExistingValueFilter">
                        <template #format="{ row }">
                            <HighlightLabel :labelType="getConnectionStateLabel(row.connectionState)">
                                {{ ConnectionStateDescription[row.connectionState] }}<template v-if="row.connectionState === ConnectionState.FutureFollowUp"> - {{ formatColumnDate(row.followUpDate) }}</template>
                            </HighlightLabel>
                        </template>
                        <template #condensed="{ row }">
                            <HighlightLabel :labelType="getConnectionStateLabel(row.connectionState)">
                                {{ ConnectionStateDescription[row.connectionState] }}
                            </HighlightLabel>
                        </template>
                    </Column>

                    <Column name="connectionStatus"
                            title="Status"
                            field="connectionStatus"
                            width="5%"
                            :filter="pickExistingValueFilter"
                            :filterValue="getStatusFilterValue"
                            :sortValue="getStatusFilterValue">
                        <template #format="{ row }">
                            <HighlightLabel labelType="custom"
                                            :style="`background-color: ${row.connectionStatus.highlightColor};`">
                                <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" v-tooltip.overflow="row.connectionStatus.name">
                                    {{ row.connectionStatus.name }}
                                </div>
                            </HighlightLabel>
                        </template>
                    </Column>

                    <AttributeColumns :attributes="attributesToShow" />

                    <SecurityColumn v-if="canEditConnectionRequests" disabledField="isRequestSecurityDisabled" :itemTitle="() => 'Item'" />
                </Grid>
            </template>
        </GroupedPanel>

        <ChangeStatusFlyout v-model="isFlyoutOpen"
                            :errorMessage="flyoutErrorMessage"
                            :isCompletionButtonLoading="isFlyoutCompletionButtonLoading"
                            :isSaving="isFlyoutSaving"
                            :anchorEl="flyoutAnchorEl"
                            :connectionRequestUpdateBag="connectionRequestUpdateBag"
                            :isNoteRequired="isNoteRequired"
                            :connectionTypeOptions="activeActionConnectionTypeOptions"
                            @updateStatus="changeRequestStatus"
                            @updateState="updateStateFromFlyout"
                            @dismissErrorMessage="flyoutErrorMessage = ''"
                            @close="onFlyoutClose" />

        <AddConnectionRequestModal :modelValue="newConnectionRequest"
                                   v-model:visible="isAddConnectionRequestModalVisible"
                                   :options="box.options"
                                   :connectionStateItems="connectionStateItems"
                                   :connectionTypeOptionsByIdKey="connectionTypeOptionsByIdKey"
                                   :selectedConnectionTypeOptions="selectedConnectionTypeOptions"
                                   :connectionOpportunityDetails="connectionOpportunityDetails"
                                   :placementGroupDetails="placementGroupDetails"
                                   :isConnectionOpportunityFilterSelected="hasSelectedOpportunity"
                                   :isExistingActiveRequesterOnConnectionType="isExistingActiveRequesterOnConnectionType"
                                   :isSaving="isModalSaving"
                                   :errorMessage="modalErrorMessage"
                                   @dismissErrorMessage="onModalErrorMessageDismissed"
                                   @checkForActiveRequester="checkForActiveRequester"
                                   @save="onAddRequest"
                                   @close="resetNewConnectionRequest"
                                   @fetchConnectionOpportunityDetails="fetchConnectionOpportunityDetails"
                                   @fetchConnectorOptions="fetchConnectorOptionsForAdd"
                                   @fetchPlacementGroupItems="fetchPlacementGroupItems"
                                   @fetchPlacementGroupDetails="fetchPlacementGroupDetails" />

        <AddFromCampaignModal v-model:visible="isAddFromCampaignModalVisible"
                              :selectedOpportunityGuid="selectedOpportunity"
                              :allConnectionOpportunityItems="connectionOpportunities ?? []"
                              :isLoading="areCampaignsLoading"
                              :isSaving="isModalSaving"
                              :campaignRecordBags="campaignRecordBags"
                              :errorMessage="modalErrorMessage"
                              @dismissErrorMessage="onModalErrorMessageDismissed"
                              @close="onModalErrorMessageDismissed"
                              @assignRequests="assignRequestsFromCampaign" />

        <CelebrationModal v-model:visible="isCelebrationModalVisible"
                          :requestDetails="requestDetailsForModal"
                          :viewOptions="viewOptions"
                          :isSaving="isModalSaving"
                          :canEditCelebration="canEditConnectionRequests"
                          :errorMessage="modalErrorMessage"
                          @dismissErrorMessage="onModalErrorMessageDismissed"
                          @close="onModalErrorMessageDismissed"
                          @upsertCelebration="upsertCelebration" />

        <ReminderModal v-model="isReminderModalVisible"
                       :contextEntityGuid="reminderEntityGuid"
                       :contextEntityTypeGuid="EntityType.PersonAlias"
                       :areDetailsRequired="true"
                       :isAdditionalOptionsLinkVisible="false"
                       @reminderClosed="decreaseReminderCount"
                       @addSuccess="increaseReminderCount">
            <template #postBody>
                <RequestTable :requestDetails="requestDetailsForModal"
                              :viewOptions="viewOptions"
                              :isConnectorVisible="true" />
            </template>
        </ReminderModal>

        <AssignRequestModal v-model:visible="isAssignRequestModalVisible"
                            :connectorItems="bulkConnectionTypeOptions?.connectorAliasItems ?? []"
                            :requestDetails="requestDetailsForModal"
                            :viewOptions="viewOptions"
                            :isSaving="isModalSaving"
                            :errorMessage="modalErrorMessage"
                            @dismissErrorMessage="onModalErrorMessageDismissed"
                            @close="onModalErrorMessageDismissed"
                            @updateConnector="updateConnectorFromModal" />
        <ChangeStateModal v-model:visible="isChangeStateModalVisible"
                          :isLoading="areRequestDetailsForModalLoading"
                          :isSaving="isModalSaving"
                          :connectionState="changeStateTo"
                          :requestDetails="requestDetailsForModal"
                          :failingRequestDetails="failingRequestDetailsForModal"
                          :viewOptions="viewOptions"
                          :errorMessage="modalErrorMessage"
                          @dismissErrorMessage="onModalErrorMessageDismissed"
                          @close="onModalErrorMessageDismissed"
                          @updateState="updateStateFromModal" />
        <DeleteRequestModal v-model:visible="isDeleteRequestModalVisible"
                            :requestDetails="requestDetailsForModal"
                            :viewOptions="viewOptions"
                            :isSaving="isModalSaving"
                            :errorMessage="modalErrorMessage"
                            @dismissErrorMessage="onModalErrorMessageDismissed"
                            @close="onModalErrorMessageDismissed"
                            @deleteRequests="deleteRequestsFromModal" />
        <ActivityModal v-model:visible="isActivityModalVisible"
                       :connectorItems="activeActionConnectionTypeOptions?.connectorAliasItems ?? []"
                       :requestDetails="requestDetailsForModal"
                       :connectionActivities="connectionActivityItems ?? []"
                       :viewOptions="viewOptions"
                       :currentPerson="currentPerson"
                       :activityToEdit="activityToEdit"
                       :isSaving="isModalSaving"
                       :errorMessage="modalErrorMessage"
                       @dismissErrorMessage="onModalErrorMessageDismissed"
                       @close="onModalErrorMessageDismissed"
                       @upsertActivity="upsertActivity" />
        <ChangeStatusModal v-model:visible="isChangeStatusModalVisible"
                           :connectionStatusItems="connectionStatusItems"
                           :isSequentialMode="activeActionConnectionTypeOptions?.isSequentialStatusMode ?? false"
                           :isSaving="isModalSaving"
                           :requestDetails="requestDetailsForModal"
                           :viewOptions="viewOptions"
                           :errorMessage="modalErrorMessage"
                           :selectedStatus="selectedStatus"
                           @dismissErrorMessage="onModalErrorMessageDismissed"
                           @close="onModalErrorMessageDismissed"
                           @updateStatus="updateStatusFromModal" />
        <LaunchWorkflowModal v-model:visible="isLaunchWorkflowModalVisible"
                             :workflowItems="activeActionConnectionTypeOptions?.workflowItems ?? []"
                             :requestDetails="requestDetailsForModal"
                             :viewOptions="viewOptions"
                             :isSaving="isModalSaving"
                             :errorMessage="modalErrorMessage"
                             @dismissErrorMessage="onModalErrorMessageDismissed"
                             @close="onModalErrorMessageDismissed"
                             @launchWorkflows="launchWorkflowForRequests" />
        <SendSMSModal v-model:visible="isSendSMSModalVisible"
                      :communicationRecipients="communicationRecipients"
                      :smsFromSystemPhoneNumbers="smsFromSystemPhoneNumbers"
                      :smsSnippets="smsSnippets"
                      @onSuccessfulSend="refreshActivityEntries(dockedPanelDetailsBox?.entity?.connectionRequestIdKey)" />
        <SendEmailModal v-model:visible="isSendEmailModalVisible"
                        :communicationRecipients="communicationRecipients"
                        :communicationTemplates="communicationTemplates"
                        :fromName="emailFromName"
                        :fromEmail="emailFromEmail"
                        @onSuccessfulSend="refreshActivityEntries(dockedPanelDetailsBox?.entity?.connectionRequestIdKey)" />
        <ViewOptionsModal :modelValue="viewOptionsForModal"
                          @update:modelValue="onViewOptionsUpdate"
                          v-model:visible="isViewOptionsModalVisible"
                          :gridDataToShowItems="filteredGridDataToShowItems"
                          :connectionStates="connectionStateItems"
                          :connectionStatuses="staticConnectionTypeOptions?.connectionStatuses ?? []"
                          :attributeFilters="visibleAttributeFilters"
                          :isMyConnectionsView="isMyConnectionsView" />

        <ModalAlert v-model="isModalAlertVisible">
            <p>{{ modalAlertText }}</p>
        </ModalAlert>

        <ConnectionRequestDockedPanel v-model="isDockedPanelVisible"
                                      ref="connectionRequestDockedPanelRef"
                                      :currentKey="selectedRequestKeyForDockedPanel"
                                      :connectionRequestBreadcrumbs="connectionRequestBreadcrumbs"
                                      :orderedKeys="orderedRequestKeys ?? []"
                                      :detailsBox="dockedPanelDetailsBox"
                                      :dockedPanelCloseOnOutsideClick="dockedPanelCloseOnOutsideClick"
                                      :navigationUrls="box.navigationUrls ?? {}"
                                      @navigate="updateSelectedRequestKey"
                                      @navigateToBreadcrumb="navigateToBreadcrumb"
                                      @navigateToAdditionalRequest="navigateToAdditionalRequest"
                                      @editActivity="onEditActivity"
                                      :isSaving="isDockedPanelSaving"
                                      @editRequest="onEditRequest"
                                      @transferRequest="onTransferClick"
                                      @addActivity="showAddActivityModal(dockedPanelDetailsBox)"
                                      @onCelebrationClick="box => showCelebrationModal(null, box)"
                                      @onReminderClick="box => showReminderModal(null, box)"
                                      @onSMSClick="showSMSModal(true)"
                                      @onEmailClick="showEmailModal(true)"
                                      @onReassignConnector="(connector) => reassignConnector([dockedPanelDetailsBox?.entity?.connectionRequestIdKey ?? ''], connector, true)"
                                      @onRequestStateChanged="updateRequestStates"
                                      @onStatusButtonClick="onStatusClickFromDockedPanel"
                                      @launchWorkflow="launchWorkflowForRequests"
                                      @deleteRequest="showDeleteRequestModal(null, dockedPanelDetailsBox)" />

        <TransferConnectionRequestModal v-model="isTransferModalVisible"
                                        :isLoading="areTransferDetailsLoading"
                                        :transferDetails="transferRequestDetails"
                                        :isSaving="isModalSaving"
                                        :errorMessage="modalErrorMessage"
                                        :isBulkTransfer="isBulkTransfer"
                                        :requestDetails="requestDetailsForModal"
                                        :viewOptions="viewOptions"
                                        @fetchConnectorOptions="fetchConnectorOptionsForTransfer"
                                        @dismissErrorMessage="onModalErrorMessageDismissed"
                                        @close="onTransferModalClose"
                                        @transfer="selectTransferProcess" />
    </div>
</template>

<script setup lang="ts">
    import { onConfigurationValuesChanged, useBlockBrowserBus, useConfigurationValues, useInvokeBlockAction, usePersonPreferences, useReloadBlock } from "@Obsidian/Utility/block";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { GroupingFieldBag } from "@Obsidian/ViewModels/Core/Grid/groupingFieldBag";
    import { computed, onBeforeUnmount, onMounted, reactive, ref, watch } from "vue";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { ConnectionsHubOptionsBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionsHubOptionsBag";
    import { ConnectionTypeOptionsBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionTypeOptionsBag";
    import Grid, { Column, PersonColumn, SelectColumn, AttributeColumns, SecurityColumn, pickExistingValueFilter, dateValueFilter } from "@Obsidian/Controls/grid";
    import { GridDataToShowItemBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/gridDataToShowItemBag";
    import { ConnectionRequestAttributeFilterBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionRequestAttributeFilterBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { PublicAttributeBag } from "@Obsidian/ViewModels/Utility/publicAttributeBag";
    import DropDownContent from "@Obsidian/Controls/dropDownContent.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import HighlightLabel from "@Obsidian/Controls/highlightLabel.obs";
    import GroupedPanel from "@Obsidian/Controls/Internal/groupedPanel.obs";
    import { GroupedGrid } from "@Obsidian/Controls/Internal/GroupedPanel/types.partial";
    import Snapshot from "./ConnectionsHub/snapshot.partial.obs";
    import { CompletionMetricsBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/completionMetricsBag";
    import { isNullOrWhiteSpace, pluralize, safeParseJson } from "@Obsidian/Utility/stringUtils";
    import { RockDateTime } from "@Obsidian/Utility/rockDateTime";
    import { tooltip } from "@Obsidian/Utility/tooltip";
    import { DueStatus } from "@Obsidian/Enums/Connection/dueStatus";
    import AddConnectionRequestModal from "./ConnectionsHub/addConnectionRequestModal.partial.obs";
    import { PersonFieldBag } from "@Obsidian/ViewModels/Core/Grid/personFieldBag";
    import ContextSlicer from "@Obsidian/Controls/contextSlicer.obs";
    import { ContextEntityChangedData, Message } from "@Obsidian/Types/Utility/browserBus";
    import { useContextEntities } from "@Obsidian/Core/Utilities/contextEntity";
    import { PageMessages } from "@Obsidian/Utility/browserBus";
    import { areEqual, toGuidOrNull } from "@Obsidian/Utility/guid";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { CommunicationRecipientBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/communicationRecipientBag";
    import { CommunicationTemplateBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/communicationTemplateBag";
    import { ConnectionRequestBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionRequestBag";
    import { ConnectionOpportunityDetailBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionOpportunityDetailBag";
    import { GetEmailConfigurationRequestBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/getEmailConfigurationRequestBag";
    import { GetEmailConfigurationResponseBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/getEmailConfigurationResponseBag";
    import { GetSmsConfigurationRequestBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/getSmsConfigurationRequestBag";
    import { GetSmsConfigurationResponseBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/getSmsConfigurationResponseBag";
    import { PlacementGroupDetailsBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/placementGroupDetailsBag";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";
    import { NavigationUrlKey, PreferenceKey, ViewOptions } from "./ConnectionsHub/types.partial";
    import { IGridState } from "@Obsidian/Types/Controls/grid";
    import { HttpResult } from "@Obsidian/Types/Utility/http";
    import { asBoolean } from "@Obsidian/Utility/booleanUtils";
    import RockLabel from "@Obsidian/Controls/rockLabel.obs";
    import Badge from "@Obsidian/Controls/badge.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import SendEmailModal from "./ConnectionsHub/sendEmailModal.partial.obs";
    import SendSMSModal from "./ConnectionsHub/sendSMSModal.partial.obs";
    import ViewOptionsModal from "./ConnectionsHub/viewOptionsModal.partial.obs";
    import { ConnectionState, ConnectionStateDescription } from "@Obsidian/Enums/Connection/connectionState";
    import { ConnectionStatusBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionStatusBag";
    import { CurrentPersonBag } from "@Obsidian/ViewModels/Crm/currentPersonBag";
    import { useStore } from "@Obsidian/PageState";
    import AssignRequestModal from "./ConnectionsHub/assignRequestModal.partial.obs";
    import { BulkRequestViewBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/bulkRequestViewBag";
    import DeleteRequestModal from "./ConnectionsHub/deleteRequestModal.partial.obs";
    import ActivityModal from "./ConnectionsHub/activityModal.partial.obs";
    import ChangeStatusModal from "./ConnectionsHub/changeStatusModal.partial.obs";
    import LaunchWorkflowModal from "./ConnectionsHub/launchWorkflowModal.partial.obs";
    import { PanelAction } from "@Obsidian/Types/Controls/panelAction";
    import { ConnectionListGridUpdateBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionListGridUpdateBag";
    import ChangeStatusFlyout from "./ConnectionsHub/changeStatusFlyout.partial.obs";
    import { ConnectionRequestUpdateBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionRequestUpdateBag";
    import { ConnectionCampaignBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionCampaignBag";
    import AddFromCampaignModal from "./ConnectionsHub/addFromCampaignModal.partial.obs";
    import { AssignFromCampaignBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/assignFromCampaignBag";
    import ChangeStateModal from "./ConnectionsHub/changeStateModal.partial.obs";
    import { UpdateConnectionRequestStatesBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/updateConnectionRequestStatesBag";
    import { ActivityBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/activityBag";
    import { ActivityEntryBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/activityEntryBag";
    import { LaunchWorkflowBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/launchWorkflowBag";
    import { LaunchWorkflowResultBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/launchWorkflowResultBag";
    import ModalAlert from "@Obsidian/Controls/modalAlert.obs";
    import { showSecurity } from "@Obsidian/Utility/dialogs";
    import CelebrationModal from "./ConnectionsHub/celebrationModal.partial.obs";
    import { UpsertCelebrationBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/UpsertCelebrationBag";
    import ReminderModal from "@Obsidian/Controls/Internal/reminderModal.obs";
    import RequestTable from "./ConnectionsHub/requestTable.partial.obs";
    import ConnectionRequestDockedPanel from "./ConnectionsHub/connectionRequestDockedPanel.partial.obs";
    import { downloadFile } from "@Obsidian/Utility/file";
    import { debounce, deepEqual } from "@Obsidian/Utility/util";
    import { removeCurrentUrlQueryParams } from "@Obsidian/Utility/url";
    import { ConnectionRequestDetailBox } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionRequestDetailBox";
    import { ConnectionListUpdateBox } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionListUpdateBox";
    import { ConnectionsHubGridDataBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionsHubGridDataBag";
    import { TransferConnectionRequestBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/transferConnectionRequestBag";
    import TransferConnectionRequestModal from "./ConnectionsHub/transferConnectionRequestModal.partial.obs";
    import { TransferConnectionRequestDetailsBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/transferConnectionRequestDetailsBag";
    import ConnectionStatusButton from "./ConnectionsHub/connectionStatusButton.partial.obs";
    import { ConnectionActivityTypeBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectionActivityTypeBag";
    import { updateRefValue } from "@Obsidian/Utility/component";
    import { ConnectorOptionsBag } from "@Obsidian/ViewModels/Blocks/Engagement/ConnectionsHub/connectorOptionsBag";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import ConnectionRequestCard from "./ConnectionsHub/connectionRequestCard.partial.obs";
    import { vTooltip } from "@Obsidian/Directives/tooltip";
    import ButtonGroup from "@Obsidian/Controls/buttonGroup.obs";
    import { BtnSize } from "@Obsidian/Enums/Controls/btnSize";
    import { enumToListItemBag } from "@Obsidian/Utility/enumUtils";

    const box = useConfigurationValues<ListBlockBox<ConnectionsHubOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();
    const preferences = usePersonPreferences().blockPreferences;
    const browserBus = useBlockBrowserBus();
    const contextEntities = useContextEntities();
    const store = useStore();

    browserBus.subscribe(PageMessages.ContextEntityChanged, async (message: Message<ContextEntityChangedData>) => {
        if (areEqual(message.data.entityTypeGuid, EntityType.Campus)) {
            const campusBag = await contextEntities.get(EntityType.Campus);
            updateRefValue(selectedCampus, campusBag ?? null);

            loadGridData();
        }
    });

    const allGroupingFields = <ListItemBag[]>[
        {
            text: "Connector",
            value: "connectorGrouping"
        },
        {
            text: "State",
            value: "stateGrouping"
        },
        {
            text: "Status",
            value: "statusGrouping"
        },
        {
            text: "Type",
            value: "typeGrouping"
        },
        {
            text: "Opportunity",
            value: "opportunityGrouping"
        },
        {
            text: "Campus",
            value: "campusGrouping"
        },
        {
            text: "Due Status",
            value: "dueStatusGrouping"
        }
    ];

    type IconListItemBag = {
        text: string;
        value: string;
        iconCssClass?: string;
    };

    const enabledViews = <IconListItemBag[]>[];
    if (box.options?.isListViewEnabled) {
        enabledViews.push({
            text: "List",
            iconCssClass: "ti ti-layout-list",
            value: "list"
        });
    }
    if (box.options?.isBoardViewEnabled) {
        enabledViews.push({
            text: "Board",
            iconCssClass: "ti ti-layout-cards",
            value: "board"
        });
    }
    if (box.options?.isGridViewEnabled) {
        enabledViews.push({
            text: "Grid",
            iconCssClass: "ti ti-table",
            value: "grid"
        });
    }

    const isMyConnectionsView = ref<boolean>(box.options?.isMyConnectionsView ?? false);

    const myConnectionsPageUrl = ref(box.navigationUrls?.[NavigationUrlKey.MyConnectionsPage]);

    function onMyConnectionsClick(): void {
        if (myConnectionsPageUrl.value) {
            window.location.href = myConnectionsPageUrl.value;
        }
    }

    // Always-defined view of the per-Connection-Type options dictionary, so consumers can
    // index into it without repeating the null and optional-chain dance on every access.
    const connectionTypeOptionsByIdKey = computed<Record<string, ConnectionTypeOptionsBag>>(() => box.options?.connectionTypeOptionsByIdKey ?? {});

    // Flat list of per-Connection-Type options. Use with `.some()` / `.every()` / `.filter()`
    // when you need to check or aggregate a property across all loaded Connection Types.
    const allConnectionTypeOptions = computed<ConnectionTypeOptionsBag[]>(() => Object.values(connectionTypeOptionsByIdKey.value));

    const connectionStateItems = computed<ListItemBag[]>(() => {
        if (allConnectionTypeOptions.value.some(t => t.isFutureFollowUpEnabled)) {
            return enumToListItemBag(ConnectionStateDescription);
        }

        return enumToListItemBag(ConnectionStateDescription).filter(s => parseInt(s.value ?? "") !== ConnectionState.FutureFollowUp);
    });

    // In Standard mode the server populates the dictionary with a single entry: the
    // Connection Type this page is anchored to. This computed surfaces that type so
    // consumers can read its options without having to derive "first/only entry" inline.
    // Returns undefined in My Connections mode, where the active type is user-driven.
    const staticConnectionTypeOptions = computed<ConnectionTypeOptionsBag | undefined>(() => {
        if (isMyConnectionsView.value) {
            return undefined;
        }
        return allConnectionTypeOptions.value[0];
    });

    // Soft security check to see if the user can edit the list of connection requests.
    const canEditGlobalConnectionRequests = ref<boolean>((() => {
        if (!isMyConnectionsView.value) {
            return staticConnectionTypeOptions.value?.canEditConnectionRequests ?? false;
        }

        return allConnectionTypeOptions.value.flatMap(t => t.canEditConnectionRequests).some(t => t === true);
    })());

    // Context Slicer configuration
    const selectedCampus = ref<ListItemBag | null>(null);
    const selectedConnector = ref<string>(isNullOrWhiteSpace(preferences.getValue(PreferenceKey.SelectedConnector)) ? (store.state.currentPerson?.idKey ?? "") : preferences.getValue(PreferenceKey.SelectedConnector));
    const internalSelectedType = ref(preferences.getValue(PreferenceKey.FilterConnectionType));
    const internalSelectedOpportunity = ref(box.options?.connectionOpportunityGuidFromPageParameter ?? preferences.getValue(getConnectionFilterKey(PreferenceKey.ConnectionmOpportunityFilterConnectionTypeIdKey)));

    // Add Connection Request Configuration
    const newConnectionRequest = ref<ValidPropertiesBox<ConnectionRequestBag>>({ bag: { connectionOpportunityGuid: internalSelectedOpportunity.value, campusGuid: selectedCampus.value?.value } as ConnectionRequestBag });
    const isExistingActiveRequesterOnConnectionType = ref<boolean>(false);
    const isAddConnectionRequestModalVisible = ref(false);
    const connectionOpportunityDetails = ref<ConnectionOpportunityDetailBag>(box.options?.connectionOpportunityDetailsFromFilter ?? {});
    const placementGroupDetails = ref<PlacementGroupDetailsBag>();

    // Grouped Grid Configuration
    const selectedKeys = ref<Record<string, string[]>>({});
    const selectedKeysOnUnmount = ref<Record<string, string[]>>({});
    const groupedPanel = ref();
    const rawQuickFilter = ref("");
    const debouncedQuickFilter = ref(rawQuickFilter.value);
    const isAutoCollapseEnabled = ref<boolean>(asBoolean(preferences.getValue(PreferenceKey.IsAutoCollapseEnabled)));
    const openDropdownIndex = ref<string | null | undefined>();
    // Holds the raw grid data returned from the server
    const gridData = ref<GridDataBag>();

    /**
     * Grouping metadata for connectors discovered from grid data and row updates
     * that are not part of the block-load connector groupings, e.g. a connector
     * who is not a member of any connector group. Keyed by grouping key.
     */
    const supplementalConnectorGroupings = ref<Record<string, GroupingFieldBag>>({});
    const requestListErrorMessage = ref<string>("");
    const areRequestsLoading = ref<boolean>(true);
    const isSnapshotVisible = ref<boolean>(false);
    const snapshotMetrics = ref<CompletionMetricsBag | null>(null);

    // Modal Configuration
    const modalErrorMessage = ref<string>("");
    const isSendSMSModalVisible = ref(false);
    const isSendEmailModalVisible = ref(false);
    const isCelebrationModalVisible = ref(false);
    const isAssignRequestModalVisible = ref(false);
    const isDeleteRequestModalVisible = ref(false);
    const isActivityModalVisible = ref(false);
    const isChangeStatusModalVisible = ref(false);
    const isReminderModalVisible = ref(false);
    const isLaunchWorkflowModalVisible = ref(false);
    const isChangeStateModalVisible = ref(false);
    const isAddFromCampaignModalVisible = ref(false);
    const isTransferModalVisible = ref<boolean>(false);
    const isModalAlertVisible = ref(false);
    const isViewOptionsModalVisible = ref(false);
    const modalAlertText = ref();
    const isModalSaving = ref(false);
    const requestDetailsForModal = ref<BulkRequestViewBag[]>([]);
    // Refs for specific modals
    const reminderEntityGuid = ref<string>("");
    const changeStateTo = ref<ConnectionState>(ConnectionState.Active);
    const areCampaignsLoading = ref(false);
    const campaignRecordBags = ref();
    const areRequestDetailsForModalLoading = ref<boolean>(false);
    const areTransferDetailsLoading = ref<boolean>(false);
    const failingRequestDetailsForModal = ref<BulkRequestViewBag[]>([]);
    const activityToEdit = ref<ActivityEntryBag | null>(null);
    const transferRequestDetails = ref<TransferConnectionRequestDetailsBag>();
    const viewOptions = ref<ViewOptions>({
        sortBy: preferences.getValue(getConnectionFilterKey(PreferenceKey.FilterSortByConnectionTypIdKey)),
        gridDataToShow: safeParseJson(preferences.getValue(getConnectionFilterKey(PreferenceKey.FilterGridDataToShowConnectionTypIdKey))),
        isRequestSourceShown: asBoolean(preferences.getValue(getConnectionFilterKey(PreferenceKey.FilterIsRequestSourceShownConnectionTypIdKey))),
        stateFilter: safeParseJson(preferences.getValue(getConnectionFilterKey(PreferenceKey.FilterStateConnectionTypIdKey))),
        statusFilter: safeParseJson(preferences.getValue(getConnectionFilterKey(PreferenceKey.FilterStatusConnectionTypIdKey))),
        dueFilter: safeParseJson(preferences.getValue(getConnectionFilterKey(PreferenceKey.FilterDueConnectionTypIdKey))),
        attributeFilterValues: safeParseJson(preferences.getValue(getConnectionFilterKey(PreferenceKey.FilterAttributeValuesConnectionTypeIdKey))) ?? {},
    });
    const selectedStatus = ref<string | null | undefined>();
    const isBulkTransfer = ref<boolean>(false);
    // SMS and Email modal state
    const communicationRecipients = ref<CommunicationRecipientBag[] | null | undefined>();
    const smsFromSystemPhoneNumbers = ref<ListItemBag[]>([]);
    const smsSnippets = ref<ListItemBag[]>([]);
    const communicationTemplates = ref<CommunicationTemplateBag[]>([]);
    const emailFromName = ref<string>("");
    const emailFromEmail = ref<string>("");

    // Flyout Configuration
    const isFlyoutOpen = ref(false);
    const flyoutErrorMessage = ref<string>("");
    const isFlyoutSaving = ref<boolean>(false);
    const isFlyoutCompletionButtonLoading = ref<boolean>(false);
    const flyoutAnchorEl = ref<HTMLElement | null>(null);
    const isNoteRequired = ref(false);

    /** The idKey of the card that the most recent board drag was dropped before,
     *  used to attach positional data to status update bags sent to the server.
     *  Null means the card was dropped at the end of the column. */
    const cardMovedBeforeIdKey = ref<string | null>(null);

    // Docked Panel Configuration
    const isDockedPanelSaving = ref<boolean>(false);
    const connectionRequestUpdateBag = ref<ConnectionRequestUpdateBag>({} as ConnectionRequestUpdateBag);
    const orderedRequestKeys = ref<string[]>([]);
    const isDockedPanelVisible = ref(false);
    const selectedRequestKeyForDockedPanel = ref();
    const dockedPanelDetailsBox = ref<ConnectionRequestDetailBox>();
    const connectionRequestDockedPanelRef = ref<InstanceType<typeof ConnectionRequestDockedPanel>>();
    const dockedPanelCloseOnOutsideClick = ref<boolean>(true);
    // Breadcrumbs are used when a user navigates to an "additional request"
    const connectionRequestBreadcrumbs = ref<ListItemBag[]>([]);

    /*
        Connection Type scope state.

        Two independent action scopes exist on this block and are derived separately:

        - Bulk scope: driven entirely by the current selection set (computed below).
        - Per-row scope: set by every per-row entry point through prepareRequestDetailsForModal
          (or directly via the helpers for the flyout, which does not go through that path).

        isBulkAction selects which scope shared modals (Change Status, Change State,
        Launch Workflow, Delete Request, Add Activity) should read through
        activeActionConnectionTypeOptions.
    */
    const activeRowConnectionTypeIdKey = ref<string | null>(null);
    const isBulkAction = ref<boolean>(false);

    const selectedView = ref<string>((() => {
        const preferenceValue = preferences.getValue(getConnectionFilterKey(PreferenceKey.SelectedViewConnectionTypeIdKey));
        return isNullOrWhiteSpace(preferenceValue) ? enabledViews[0]?.value : preferenceValue;
    })());

    const selectedGrouping = ref<string>((() => {
        if (selectedView.value === "board") {
            return "statusGrouping";
        }

        const defaultGrouping = isMyConnectionsView.value ? "dueStatusGrouping" : "connectorGrouping";

        return isNullOrWhiteSpace(preferences.getValue(PreferenceKey.SelectedGroupByMode)) ? defaultGrouping : preferences.getValue(PreferenceKey.SelectedGroupByMode);
    })());

    const gridViewGridRef = ref();
    const gridViewFilteredRows = ref<Record<string, unknown>[]>();

    // #region Computed Values

    const canEditConnectionRequests = computed<boolean>(() => {
        // If the Docked Panel is currently open and the box has data then use the security derived from the specific request.
        if (isDockedPanelVisible.value && dockedPanelDetailsBox.value?.options) {
            return dockedPanelDetailsBox.value.options.canEditConnectionRequest;
        }

        return canEditGlobalConnectionRequests.value;
    });

    const currentPerson = computed((): CurrentPersonBag | null => {
        return store.state.currentPerson;
    });

    /**
     * Gets the list of secondary action items to be included in the panel.
     * This is computed because the auto-collapse toggle title depends on reactive state.
     */
    const secondaryActions = computed((): PanelAction[] => {
        const actions: PanelAction[] = [
            {
                type: "default",
                iconCssClass: "ti ti-plus",
                title: "Add From Campaign",
                handler: showAddFromCampaignModal
            }
        ];

        if (selectedView.value === "list") {
            actions.push(
                {
                    type: "default",
                    iconCssClass: "ti ti-viewport-short",
                    title: isAutoCollapseEnabled.value ? "Turn Off Auto-Collapse" : "Turn On Auto-Collapse",
                    handler: toggleAutoCollapse
                },
                {
                    type: "default",
                    iconCssClass: "ti ti-chevrons-up",
                    title: "Collapse All",
                    handler: collapseAll
                }
            );
        }
        else if (selectedView.value === "grid") {
            actions.push(
                {
                    type: "default",
                    iconCssClass: "ti ti-message",
                    title: "Communicate",
                    handler: onCommunicate
                },
                {
                    type: "default",
                    iconCssClass: "ti ti-files",
                    title: "Merge Template",
                    handler: mergeTemplate
                },
                {
                    type: "default",
                    iconCssClass: "ti ti-users",
                    title: "Merge People",
                    handler: mergePerson
                }
            );
        }

        actions.push({
            type: "default",
            iconCssClass: "ti ti-file-excel",
            title: "Export to Excel",
            handler: exportToExcel
        });

        actions.push({
            type: "default",
            iconCssClass: "ti ti-file-spreadsheet",
            title: "Export to CSV",
            handler: exportToCsv
        });

        return actions;
    });

    // Computed setter normalizes v-model updates so the dropdown’s blank "All Types" value is never stored in component state.
    const selectedType = computed({
        get: () => internalSelectedType.value,
        set: value => {
            internalSelectedType.value = toGuidOrNull(value) ?? "";
        }
    });

    // Computed setter normalizes v-model updates so the dropdown’s blank "All Opportunities" value is never stored in component state.
    const selectedOpportunity = computed({
        get: () => internalSelectedOpportunity.value,
        set: value => {
            internalSelectedOpportunity.value = toGuidOrNull(value) ?? "";
        }
    });

    const connectionOpportunities = computed(() => {
        if (!isMyConnectionsView.value) {
            return staticConnectionTypeOptions.value?.connectionOpportunities;
        }

        if (isNullOrWhiteSpace(selectedType.value)) {
            return allConnectionTypeOptions.value.flatMap(t => t.connectionOpportunities ?? []);
        }

        return allConnectionTypeOptions.value.find(t => areEqual(t.guid, selectedType.value))?.connectionOpportunities ?? [];
    });

    // Resolves the per-Type options bag the Add Connection Request modal should
    // drive its Status, Source, IsSequentialStatusMode, and Connectors lists from.
    // Standard mode populates the dictionary with a single entry on the server,
    // so the lookup-by-filter falls through to "first entry" when no filter is set.
    // In My Connections mode with no Type filter selected, the modal will resolve
    // the Type from whichever Opportunity the user picks.
    const selectedConnectionTypeOptions = computed(() => {
        if (!isNullOrWhiteSpace(selectedType.value)) {
            return allConnectionTypeOptions.value.find(t => areEqual(t.guid, selectedType.value)) ?? null;
        }

        if (allConnectionTypeOptions.value.length === 1) {
            return allConnectionTypeOptions.value[0];
        }

        return null;
    });

    const groupingFields = computed(() => {
        let filteredGroupingFields = allGroupingFields;

        // No grouping on Grid View
        if (selectedView.value === "grid") {
            return [];
        }

        if (isMyConnectionsView.value) {
            filteredGroupingFields = filteredGroupingFields.filter(g => g.value !== "opportunityGrouping" && g.value !== "connectorGrouping");
            if (!isNullOrWhiteSpace(selectedType.value)) {
                filteredGroupingFields = filteredGroupingFields.filter(g => g.value !== "typeGrouping");
            }
        }
        else {
            filteredGroupingFields = filteredGroupingFields.filter(g => g.value !== "typeGrouping");
        }

        // Board mode only allows status grouping.
        if (selectedView.value === "board") {
            return filteredGroupingFields.filter(g => g.value === "statusGrouping");
        }

        if (!isNullOrWhiteSpace(selectedOpportunity.value)) {
            filteredGroupingFields = filteredGroupingFields.filter(g => g.value !== "opportunityGrouping");
        }
        if (!isNullOrWhiteSpace(selectedCampus.value?.value)) {
            filteredGroupingFields = filteredGroupingFields.filter(g => g.value !== "campusGrouping");
        }

        return filteredGroupingFields;
    });

    /** Converts the backend available groupings into the format expected by GroupedPanel. */
    const availableGroups = computed<Record<string, GroupedGrid[]> | undefined>(() => {
        const raw = box.options?.availableGroupings;
        if (!raw) {
            return undefined;
        }

        // When a status filter is active, restrict available status columns to
        // only the allowed statuses so excluded ones don't appear as empty board
        // columns. Map filter GUIDs to IdKeys via connectionStatuses on the
        // filter-driven Connection Type (which is the only one represented in board view).
        const activeStatusFilter = viewOptions.value.statusFilter;
        const allowedStatusKeys = activeStatusFilter?.length
            ? (selectedConnectionTypeOptions.value?.connectionStatuses ?? [])
                .filter(s => activeStatusFilter.includes(s.guid) && s.idKey)
                .map(s => s.idKey!)
            : null;

        const result: Record<string, GroupedGrid[]> = {};
        for (const [key, bags] of Object.entries(raw)) {
            const filteredBags = key === "statusGrouping" && allowedStatusKeys?.length
                ? bags.filter(bag => bag.key && allowedStatusKeys.includes(bag.key))
                : bags;

            result[key] = filteredBags.map(bag => ({
                ...bag,
                gridData: { rows: [] }
            }));
        }

        // Union in connectors discovered from grid data and row updates that are
        // not part of the block-load connector groupings. Without this the grouped
        // panel would fall back to showing the raw grouping key as the group label.
        const connectorGroups = result["connectorGrouping"];
        if (connectorGroups) {
            const knownKeys = new Set(connectorGroups.map(g => g.key));
            for (const bag of Object.values(supplementalConnectorGroupings.value)) {
                if (bag.key && !knownKeys.has(bag.key)) {
                    connectorGroups.push({
                        ...bag,
                        gridData: { rows: [] }
                    });
                }
            }
        }

        return result;
    });

    const hasSelectedOpportunity = computed(() => !isNullOrWhiteSpace(selectedOpportunity.value));

    /**
     * Column choices shown in the View Options modal. Items scoped to one or more
     * Connection Opportunities are hidden when an unrelated opportunity is the
     * active filter, so the user does not see columns that would be empty for
     * every visible row.
     */
    const filteredGridDataToShowItems = computed<ListItemBag[]>(() => {
        const items: GridDataToShowItemBag[] = box.options?.gridDataToShowItems ?? [];
        const activeOpportunityGuid = selectedOpportunity.value;
        const hasActiveFilter = !isNullOrWhiteSpace(activeOpportunityGuid);

        return items
            .filter(item => {
                const scopeGuids = item.connectionOpportunityGuids;
                if (!scopeGuids || scopeGuids.length === 0) {
                    return true;
                }
                if (!hasActiveFilter) {
                    return true;
                }
                return scopeGuids.some(g => areEqual(g, activeOpportunityGuid));
            })
            .map(item => item.listItemBag as ListItemBag);
    });

    /** Set of grid item values currently visible to the user under the active opportunity filter. */
    const inScopeGridDataToShowValues = computed<Set<string>>(() => {
        return new Set(
            filteredGridDataToShowItems.value
                .map(i => i.value)
                .filter((v): v is string => !!v)
        );
    });

    /**
     * Attribute filters shown in the View Options modal. Mirrors the column-visibility
     * rule above: type-level attributes are always shown, opportunity-scoped attributes
     * are hidden when an unrelated opportunity is the active filter. Persisted filter
     * values for hidden attributes stay in viewOptions.attributeFilterValues and become
     * inert server-side; switching back to a relevant opportunity restores them.
     */
    const visibleAttributeFilters = computed<PublicAttributeBag[]>(() => {
        const items: ConnectionRequestAttributeFilterBag[] = box.options?.attributeFilters ?? [];
        const activeOpportunityGuid = selectedOpportunity.value;
        const hasActiveFilter = !isNullOrWhiteSpace(activeOpportunityGuid);

        return items
            .filter(item => {
                const scopeGuids = item.connectionOpportunityGuids;
                if (!scopeGuids || scopeGuids.length === 0) {
                    return true;
                }
                if (!hasActiveFilter) {
                    return true;
                }
                return scopeGuids.some(g => areEqual(g, activeOpportunityGuid));
            })
            .map(item => item.attribute)
            .filter((attr): attr is PublicAttributeBag => !!attr);
    });

    /**
     * View Options to present to the modal: identical to the saved view options except
     * gridDataToShow is narrowed to values that exist in the modal's items list. Out-of-scope
     * saved selections are intentionally excluded from the dropdown's v-model so the multi-select
     * does not carry phantom values, and are re-merged in onViewOptionsUpdate on save.
     */
    const viewOptionsForModal = computed<ViewOptions>(() => ({
        ...viewOptions.value,
        gridDataToShow: (viewOptions.value.gridDataToShow ?? [])
            .filter(v => inScopeGridDataToShowValues.value.has(v)),
    }));

    const skeletonCount = computed<number>(() => selectedGrouping.value === "connectorGrouping" && !isNullOrWhiteSpace(selectedConnector.value) && selectedConnector.value !== "All Requests" ? 1 : 3);

    const allSelectedKeys = computed(() => Object.values(selectedKeys.value).flat());
    const allSelectedKeySet = computed(() => new Set(allSelectedKeys.value));
    const hasAnySelectedKeys = computed(() => allSelectedKeys.value.length > 0);

    // #region Selected-Row Action Toolbar

    /**
     * Describes one action in the selected-row toolbar. The same definition renders as
     * a toolbar button on wide screens and as an overflow-menu item when the toolbar
     * collapses, so each action exists in the DOM exactly once.
     */
    type SelectedRowAction = {
        /** Stable key for v-for. */
        key: string;
        /** Button label, menu text, and tooltip. */
        label: string;
        /** Tabler icon CSS class, e.g. "ti ti-mail-plus". */
        iconCssClass: string;
        /** Invoked when the action is clicked. */
        handler: () => void;
        /** When true, the action is disabled unless the user can edit connection requests. */
        requiresEditPermission?: boolean;
        /**
         * When true, the action is connection-type-specific and is disabled when the current
         * bulk selection spans multiple connection types (disableConnectionTypeSpecificBulkActions).
         */
        isConnectionTypeSpecific?: boolean;
        /** When true, the action is styled as destructive. */
        isDanger?: boolean;
    };

    /*
        The toolbar folds its secondary actions into a single overflow menu once it is too
        narrow to show them all as buttons. Its width is measured directly with a
        ResizeObserver rather than a viewport media query, so the collapse tracks the space
        the toolbar actually has - which shrinks when the docked request panel is open or the
        block sits in a narrow column - not the window size. This mirrors the docked panel's
        own width-driven button collapse. Each action is still rendered exactly once, as a
        button (wide) or a menu item (compact).
    */

    /** Width (px) below which the secondary actions collapse into the overflow menu. */
    const toolbarCompactWidthThreshold = 700;

    /** The toolbar container's measured width; 0 until the first measurement, which reads as wide. */
    const toolbarPixelWidth = ref<number>(0);

    /** Element ref on the toolbar content, used to locate and measure its container. */
    const toolbarElement = ref<HTMLElement | null>(null);

    /** True when the toolbar is too narrow to show every secondary action as a button. */
    const isToolbarCompact = computed<boolean>(() => toolbarPixelWidth.value > 0 && toolbarPixelWidth.value < toolbarCompactWidthThreshold);

    // Measures the toolbar's actual rendered width. The .action-toolbar container is sized by
    // the panel, not by the buttons inside it, so collapsing the content cannot feed back and
    // change the measured width (which would otherwise loop).
    const toolbarResizeObserver = new ResizeObserver(entries => {
        for (const entry of entries) {
            toolbarPixelWidth.value = entry.contentRect.width;
        }
    });

    // The toolbar only renders while rows are selected, so (re-)attach the observer to its
    // container whenever the content mounts or unmounts.
    watch(toolbarElement, (element) => {
        toolbarResizeObserver.disconnect();

        const container = element?.closest(".action-toolbar");
        if (container) {
            toolbarResizeObserver.observe(container);
        }
    });

    onBeforeUnmount(() => toolbarResizeObserver.disconnect());

    /** Left-hand secondary actions - buttons on wide screens, folded into the menu when compact. */
    const primaryToolbarActions: SelectedRowAction[] = [
        { key: "launchWorkflow", label: "Launch Workflow", iconCssClass: "ti ti-settings-cog", handler: () => showLaunchWorkflowModal(), isConnectionTypeSpecific: true },
        { key: "complete", label: "Complete", iconCssClass: "ti ti-circle-check", handler: () => showChangeStateModal(ConnectionState.Connected), requiresEditPermission: true },
    ];

    /** Communication actions - buttons on the right of the wide toolbar, folded into the menu when compact. */
    const communicationToolbarActions: SelectedRowAction[] = [
        { key: "sms", label: "SMS", iconCssClass: "ti ti-message-circle-plus", handler: () => showSMSModal(), isConnectionTypeSpecific: true },
        { key: "email", label: "Email", iconCssClass: "ti ti-mail-plus", handler: () => showEmailModal(), isConnectionTypeSpecific: true },
    ];

    /** Management actions - buttons on the right of the wide toolbar, folded into the menu when compact. */
    const managementToolbarActions: SelectedRowAction[] = [
        { key: "addActivity", label: "Add Activity", iconCssClass: "ti ti-activity", handler: () => showAddActivityModal(), requiresEditPermission: true, isConnectionTypeSpecific: true },
        { key: "transfer", label: "Transfer", iconCssClass: "ti ti-switch-3", handler: () => showBulkTransferModal(), requiresEditPermission: true, isConnectionTypeSpecific: true },
    ];

    /** State-change actions - always shown in the overflow menu (edit-only) in both layouts. */
    const stateToolbarActions = computed<SelectedRowAction[]>(() => {
        const actions: SelectedRowAction[] = [
            { key: "setActive", label: "Set as Active", iconCssClass: "ti ti-user", handler: () => showChangeStateModal(ConnectionState.Active), requiresEditPermission: true },
            { key: "setInactive", label: "Set as Inactive", iconCssClass: "ti ti-user-off", handler: () => showChangeStateModal(ConnectionState.Inactive), requiresEditPermission: true },
        ];

        // Future follow-up is only a valid state when the selected requests' connection type enables it.
        // When the bulk selection spans multiple connection types, bulkConnectionTypeOptions is null and
        // this stays hidden, matching how the other connection-type-specific actions are disabled.
        if (bulkConnectionTypeOptions.value?.isFutureFollowUpEnabled) {
            actions.push({ key: "futureFollowUp", label: "Set as Future Follow-Up", iconCssClass: "ti ti-calendar", handler: () => showChangeStateModal(ConnectionState.FutureFollowUp), requiresEditPermission: true });
        }

        actions.push({ key: "delete", label: "Delete", iconCssClass: "ti ti-trash", handler: () => showDeleteRequestModal(), requiresEditPermission: true, isDanger: true });

        return actions;
    });

    /** Every secondary action that folds into the overflow menu when the toolbar is compact. */
    const foldedToolbarActions = computed<SelectedRowAction[]>(() => [
        ...primaryToolbarActions,
        ...communicationToolbarActions,
        ...managementToolbarActions,
    ]);

    /** The overflow menu is shown when compact (it holds the folded actions) or when the user can edit (it holds the state changes). */
    const isToolbarOverflowMenuShown = computed<boolean>(() => isToolbarCompact.value || canEditConnectionRequests.value);

    /** True while the toolbar overflow menu (the "..." DropDownContent) is open. */
    const isToolbarOverflowMenuOpen = ref<boolean>(false);

    /**
     * True when an action is unavailable - either it needs edit permission the current user
     * does not have, or it is connection-type-specific and the bulk selection spans multiple
     * connection types.
     */
    function isToolbarActionDisabled(action: SelectedRowAction): boolean {
        if (action.requiresEditPermission && !canEditConnectionRequests.value) {
            return true;
        }

        if (action.isConnectionTypeSpecific && disableConnectionTypeSpecificBulkActions.value) {
            return true;
        }

        return false;
    }

    /** Builds the icon class for an overflow-menu item, tinting destructive actions red. */
    function getToolbarMenuIconClass(action: SelectedRowAction): string {
        return action.iconCssClass;
    }

    /**
     * Runs an overflow-menu action and closes the menu. Disabled actions are ignored
     * so the DropDownContent items behave like the disabled buttons they replaced.
     * The menu is closed explicitly here because the action handlers open modals
     * rather than triggering the outside-click that would otherwise dismiss it.
     */
    function onToolbarMenuActionClick(action: SelectedRowAction): void {
        if (isToolbarActionDisabled(action)) {
            return;
        }

        isToolbarOverflowMenuOpen.value = false;
        action.handler();
    }

    // #endregion Selected-Row Action Toolbar

    const selectedRequestDetails = computed((): BulkRequestViewBag[] => {
        if (!gridData.value?.rows?.length) {
            return [];
        }

        return gridData.value.rows.map(row => {
            const idKey = row["idKey"] as string | null | undefined;

            if (!idKey || !allSelectedKeySet.value.has(idKey)) {
                return null;
            }

            return getBulkRequestViewBagFromRow(row, idKey);
        }).filter((r): r is BulkRequestViewBag => r !== null);
    });

    const attributesToShow = computed(() => {
        return box.gridDefinition?.attributeFields?.filter(a => {
            if (!a.name) {
                return false;
            }

            // The saved gridDataToShow preference can carry selections from other
            // opportunities. Only render a column when the attribute is both selected
            // to show AND currently in scope of the active opportunity filter, so
            // out-of-scope selections stay preserved in the preference but do not
            // surface as empty columns.
            if (!inScopeGridDataToShowValues.value.has(a.name)) {
                return false;
            }

            return viewOptions.value.gridDataToShow?.includes(a.name) ?? false;
        });
    });

    /** `true` if the panel settings is performing any filtering. */
    const hasSettingsFilters = computed((): boolean => {
        return !!viewOptions.value.stateFilter?.length
            || !!viewOptions.value.statusFilter?.length
            || !!viewOptions.value.dueFilter?.length;
    });

    const normalizedQuickFilter = computed(() => debouncedQuickFilter.value.toLowerCase());

    const connectionStatusItems = computed<ListItemBag[]>(() => {
        let statuses: ConnectionStatusBag[] | null | undefined;

        if (isDockedPanelVisible.value && dockedPanelDetailsBox.value?.options?.connectionStatuses) {
            statuses = dockedPanelDetailsBox.value.options.connectionStatuses;
        }
        else if (isMyConnectionsView.value) {
            statuses = activeActionConnectionTypeOptions.value?.connectionStatuses;
        }
        else {
            statuses = staticConnectionTypeOptions.value?.connectionStatuses;
        }

        return (
            statuses?.slice() // avoid mutating source
                .sort((a, b) => a.order - b.order)
                .map(s => ({
                    value: s.guid,
                    text: s.name
                })) ?? []
        );
    });

    const connectionActivityItems = computed<ConnectionActivityTypeBag[] | null | undefined>(() => {
        const activities = dockedPanelDetailsBox.value?.options?.connectionActivities
            ?? activeActionConnectionTypeOptions.value?.connectionActivities;

        return activities;
    });

    const visibleRows = computed(() => {
        if (!gridData.value?.rows) {
            return [];
        }

        let rows = gridData.value.rows;

        rows = filterRows(rows);
        rows = sortRows(rows);

        return rows;
    });

    const gridViewData = computed<GridDataBag>(() => ({
        rows: visibleRows.value
    }));

    /*
    * Computed value that applies column filters from Grid View to the visibleRows computed property.
    * When the Connections Hub is not in Grid View, the visible rows property will be returned and no
    * Grid column filtering will be applied.
    *
    * Used to populate the count label in the Grouped Panel and as the filtered row set from which
    * the Block exports to Excel.
    */
    const visibleRowsFilteredByGrid = computed(() => {
        if (selectedView.value !== "grid") {
            return visibleRows.value;
        }

        // When in grid view, the grid has already applied its own column filters and
        // reported back the surviving rows via onFilteredRowsChanged. Filter the
        // source rows down to only those whose idKey appears in that set so the panel
        // counts/display stay in sync with what the grid is showing.
        if (gridViewFilteredRows.value) {
            const filteredKeySet = new Set(gridViewFilteredRows.value.map(r => r["idKey"]));
            return visibleRows.value.filter(r => filteredKeySet.has(r["idKey"]));
        }

        return visibleRows.value;
    });

    // Distinct Connection Type Id Keys among the currently selected rows. Drives
    // the bulk scope and is also sent to the server for bulk state updates.
    const distinctSelectedConnectionTypeIdKeys = computed<string[]>(() => {
        if (!hasAnySelectedKeys.value) {
            return [];
        }

        return [...new Set(
            visibleRowsFilteredByGrid.value
                .filter(row => {
                    const idKey = row["idKey"] as string | null | undefined;
                    return !!idKey && allSelectedKeySet.value.has(idKey);
                })
                .map(row => row["connectionTypeIdKey"] as string | null | undefined)
                .filter((key): key is string => !!key)
        )];
    });

    // Bulk-scope Connection Type Id Key. Null when no selection exists, or when
    // a mixed-type selection in My Connections view prevents single-type bulk actions.
    const bulkConnectionTypeIdKey = computed<string | null>(() => {
        if (!hasAnySelectedKeys.value) {
            return null;
        }

        if (!isMyConnectionsView.value) {
            return staticConnectionTypeOptions.value?.idKey ?? null;
        }

        return distinctSelectedConnectionTypeIdKeys.value.length === 1
            ? distinctSelectedConnectionTypeIdKeys.value[0]
            : null;
    });

    // Bulk-scope Connection Type Options. Read by the bulk action toolbar
    // and by any bulk-only modal.
    const bulkConnectionTypeOptions = computed<ConnectionTypeOptionsBag | null>(() =>
        bulkConnectionTypeIdKey.value
            ? connectionTypeOptionsByIdKey.value[bulkConnectionTypeIdKey.value] ?? null
            : null);

    // Per-row scope Connection Type Options.
    const activeRowConnectionTypeOptions = computed<ConnectionTypeOptionsBag | null>(() =>
        activeRowConnectionTypeIdKey.value
            ? connectionTypeOptionsByIdKey.value[activeRowConnectionTypeIdKey.value] ?? null
            : null);

    // Resolves to the bulk or per-row scope depending on which entry point opened
    // the action. Bind shared modals (Change Status, Change State, Launch Workflow,
    // Delete Request, Add Activity) here so they read from the scope that opened them.
    const activeActionConnectionTypeOptions = computed<ConnectionTypeOptionsBag | null>(() =>
        isBulkAction.value ? bulkConnectionTypeOptions.value : activeRowConnectionTypeOptions.value);

    // Disabled in the bulk toolbar when a selection exists but no single Connection
    // Type can be resolved (mixed-type selection in My Connections view).
    const disableConnectionTypeSpecificBulkActions = computed<boolean>(() =>
        hasAnySelectedKeys.value && bulkConnectionTypeOptions.value === null);

    // #endregion Computed Values

    // #region Grid Functions

    function filterRows(rows: Record<string, unknown>[]): Record<string, unknown>[] {
        return rows.filter(row => {
            const requestDetailsValue = row["requestDetails"] as PersonFieldBag | undefined;

            if (!requestDetailsValue || typeof requestDetailsValue !== "object") {
                return false;
            }

            // Status Filter
            if (viewOptions.value.statusFilter && viewOptions.value.statusFilter.length > 0) {
                const statusValue = row["connectionStatus"] as ConnectionStatusBag | undefined;

                if (!statusValue || typeof statusValue !== "object") {
                    return false;
                }

                if (!viewOptions.value.statusFilter.includes(statusValue.guid)) {
                    return false;
                }
            }

            // Due Filter
            if (viewOptions.value.dueFilter && viewOptions.value.dueFilter.length > 0) {
                const dueStatusValue = row["dueStatus"] as DueStatus | null | undefined;

                if (dueStatusValue === null || typeof dueStatusValue !== "number") {
                    return false;
                }

                if (!viewOptions.value.dueFilter.includes(dueStatusValue.toString())) {
                    return false;
                }
            }

            // Quick filter
            const filter = normalizedQuickFilter.value;

            return !filter || (`${requestDetailsValue.nickName} ${requestDetailsValue.lastName}`).toLowerCase().includes(filter);
        });
    }

    function sortRows(rows: Record<string, unknown>[]): Record<string, unknown>[] {
        const sortBy = viewOptions.value.sortBy;

        if (isNullOrWhiteSpace(sortBy)) {
            // When no explicit sort is selected, sort by the persisted
            // order on the connection request (ascending).
            return rows.sort((a, b) => {
                const aOrder = (a["order"] as number | null | undefined) ?? 0;
                const bOrder = (b["order"] as number | null | undefined) ?? 0;

                return aOrder - bOrder;
            });
        }

        return rows.sort((a, b) => {
            switch (sortBy) {
                case "DateAddedAsc": {
                    const aDate = a["createdDateTime"] as string | null | undefined;
                    const bDate = b["createdDateTime"] as string | null | undefined;

                    return compareIsoDates(aDate, bDate, "asc");
                }

                case "DateAddedDesc": {
                    const aDate = a["createdDateTime"] as string | null | undefined;
                    const bDate = b["createdDateTime"] as string | null | undefined;

                    return compareIsoDates(aDate, bDate, "desc");
                }

                case "DueDateAsc": {
                    const aDate = a["dueDate"] as string | null | undefined;
                    const bDate = b["dueDate"] as string | null | undefined;

                    return compareIsoDates(aDate, bDate, "asc");
                }

                case "DueDateDesc": {
                    const aDate = a["dueDate"] as string | null | undefined;
                    const bDate = b["dueDate"] as string | null | undefined;

                    return compareIsoDates(aDate, bDate, "desc");
                }

                case "RequesterAsc": {
                    const aDetails = a["requestDetails"] as PersonFieldBag | null | undefined;
                    const bDetails = b["requestDetails"] as PersonFieldBag | null | undefined;

                    const aLast = (aDetails?.lastName ?? "").toLowerCase();
                    const bLast = (bDetails?.lastName ?? "").toLowerCase();

                    const lastNameResult = aLast.localeCompare(bLast);
                    if (lastNameResult !== 0) {
                        return lastNameResult;
                    }

                    const aNick = (aDetails?.nickName ?? "").toLowerCase();
                    const bNick = (bDetails?.nickName ?? "").toLowerCase();

                    return aNick.localeCompare(bNick);
                }

                case "RequesterDesc": {
                    const aDetails = a["requestDetails"] as PersonFieldBag | null | undefined;
                    const bDetails = b["requestDetails"] as PersonFieldBag | null | undefined;

                    const aLast = (aDetails?.lastName ?? "").toLowerCase();
                    const bLast = (bDetails?.lastName ?? "").toLowerCase();

                    const lastNameResult = bLast.localeCompare(aLast);
                    if (lastNameResult !== 0) {
                        return lastNameResult;
                    }

                    const aNick = (aDetails?.nickName ?? "").toLowerCase();
                    const bNick = (bDetails?.nickName ?? "").toLowerCase();

                    return bNick.localeCompare(aNick);
                }

                case "LastActivityAsc": {
                    const aDate = a["lastActivityDateTime"] as string | null | undefined;
                    const bDate = b["lastActivityDateTime"] as string | null | undefined;

                    return compareIsoDates(aDate, bDate, "asc");
                }

                case "LastActivityDesc": {
                    const aDate = a["lastActivityDateTime"] as string | null | undefined;
                    const bDate = b["lastActivityDateTime"] as string | null | undefined;

                    return compareIsoDates(aDate, bDate, "desc");
                }

                default:
                    return 0;
            }
        });
    }

    function applyServerFilters(): void {
        if (!gridData.value?.rows) {
            return;
        }

        gridData.value.rows = gridData.value.rows.filter(row => {
            return isRowVisibleWithServerFilters(row);
        });
    }

    function isRowVisibleWithServerFilters(row: Record<string, unknown>): boolean {
        // State Filter
        if (viewOptions.value.stateFilter && viewOptions.value.stateFilter.length > 0) {
            const stateValue = row["connectionState"] as ConnectionState | undefined;

            if (stateValue === null || stateValue === undefined || typeof stateValue !== "number") {
                return false;
            }

            if (!viewOptions.value.stateFilter.includes(stateValue.toString())) {
                return false;
            }
        }

        // Connector filter
        if (!isNullOrWhiteSpace(selectedConnector.value) && selectedConnector.value !== "All Requests") {
            const connectorValue = row["connectorDetails"] as ListItemBag | undefined;

            if (!connectorValue || typeof connectorValue !== "object") {
                return false;
            }

            // Check against the selected connector filter.
            return connectorValue?.value === selectedConnector.value;
        }

        // Campus Filter
        if (!isNullOrWhiteSpace(selectedCampus.value?.value)) {
            const campusGuid = row["campusGuid"] as string | null | undefined;
            if (!areEqual(selectedCampus.value?.value, campusGuid)) {
                return false;
            }
        }

        // Connection Opportunity Filter
        if (!isNullOrWhiteSpace(selectedOpportunity.value)) {
            const connectionOpportunityGuid = row["connectionOpportunityGuid"] as string | null | undefined;
            if (!areEqual(selectedOpportunity.value, connectionOpportunityGuid)) {
                return false;
            }
        }

        return true;
    }

    function getOverdueCount(rows: Record<string, unknown>[]): number {
        return rows.filter(r => r["dueStatus"] === DueStatus.Overdue).length;
    }

    function getDueSoonCount(rows: Record<string, unknown>[]): number {
        return rows.filter(r => r["dueStatus"] === DueStatus.DueSoon).length;
    }

    /*
        Each row within a "Due Status" group shares the same dueStatus, so we can
        infer the group's status from any row to decide which highlight label belongs
        in that group's header.
    */
    function shouldShowDueSoonHighlight(rows: Record<string, unknown>[]): boolean {
        if (selectedGrouping.value !== "dueStatusGrouping") {
            return true;
        }
        return rows[0]?.["dueStatus"] === DueStatus.DueSoon;
    }

    function shouldShowOverdueHighlight(rows: Record<string, unknown>[]): boolean {
        if (selectedGrouping.value !== "dueStatusGrouping") {
            return true;
        }
        return rows[0]?.["dueStatus"] === DueStatus.Overdue;
    }

    /*
        In Due Status grouping, the Overdue and Due Soon sections show their own
        status-specific highlight label, so the generic "X Requests" label is
        suppressed there to avoid duplication. The other group (On Track)
        keeps the generic label.
    */
    function isGroupCountMessageVisible(group: GroupedGrid): boolean {
        if (selectedGrouping.value !== "dueStatusGrouping") {
            return true;
        }
        const groupDueStatus = group.gridData.rows[0]?.["dueStatus"];
        return groupDueStatus !== DueStatus.Overdue && groupDueStatus !== DueStatus.DueSoon;
    }

    /**
     * Called when a row has been selected by the individual.
     *
     * @param key The key of the row that was selected.
     */
    function onSelectItem(key: string): void {
        // When a new request is selected from the list we need to clear breadcrumbs.
        connectionRequestBreadcrumbs.value = [];

        selectedRequestKeyForDockedPanel.value = key;
        isFlyoutOpen.value = false;
        isDockedPanelVisible.value = true;
    }

    /**
     * Handles a plain click on a board card. Clears any active multi-selection
     * before opening the docked detail panel so plain click is a "focus one"
     * action. Ctrl+click goes through onToggleBoardCardSelection instead.
     */
    function onSelectBoardCard(key: string): void {
        if (hasAnySelectedKeys.value) {
            clearAllSelections();
        }

        onSelectItem(key);
    }

    /**
     * Toggles a card in/out of the board-view selection bucket. Board-view
     * selections live under the "board" key in `selectedKeys` so they flow
     * through `allSelectedKeys` and drive the shared bulk-action toolbar.
     */
    function onToggleBoardCardSelection(groupKey: string, idKey: string): void {
        const current = selectedKeys.value[groupKey] ?? [];

        // If the connection type has sequential status configured then we must clear
        // selections in any status grouping that does not match the selected group key.
        // We can use static connection type options here because the board view can only
        // be rendered with 1 Connection Type.
        if (staticConnectionTypeOptions.value?.isSequentialStatusMode) {
            Object.keys(selectedKeys.value)
                .filter(key => key !== groupKey)
                .forEach(key => selectedKeys.value[key] = []);
        }

        selectedKeys.value[groupKey] = current.includes(idKey)
            ? current.filter(k => k !== idKey)
            : [...current, idKey];
    }

    function onAddItem(): void {
        isAddConnectionRequestModalVisible.value = true;
    }

    /**
     * Called when the rows that match the user filters have changed.
     *
     * @param state The state object that describes the grid.
     */
    function onFilteredRowsChanged(state: IGridState): void {
        gridViewFilteredRows.value = [...state.filteredRows];
    }

    // #endregion Grid Functions

    // #region Board Functions

    /**
     * When sequential status mode is active and grouped by status,
     * only allow drops on the next sequential status column.
     */
    const canDropOnGroup = computed<((sourceGroupKey: string, targetGroupKey: string) => boolean) | undefined>(() => {
        if (!staticConnectionTypeOptions.value?.isSequentialStatusMode || selectedGrouping.value !== "statusGrouping") {
            return undefined;
        }

        const statuses = staticConnectionTypeOptions.value.connectionStatuses ?? [];
        const sortedStatuses = [...statuses].sort((a, b) => a.order - b.order);
        const nextKeyByKey = new Map<string, string>();

        for (let i = 0; i < sortedStatuses.length - 1; i++) {
            const currentKey = sortedStatuses[i].idKey;
            const nextKey = sortedStatuses[i + 1].idKey;

            if (currentKey && nextKey) {
                nextKeyByKey.set(currentKey, nextKey);
            }
        }

        return (sourceGroupKey: string, targetGroupKey: string): boolean => {
            return nextKeyByKey.get(sourceGroupKey) === targetGroupKey;
        };
    });

    /**
     * Reports whether a card is part of a multi-card selection so the board
     * view can apply group-drag styling to the mirror and transit previews.
     * Matches the group-drag trigger condition in onCardMoved.
     */
    function isCardInGroupDrag(idKey: string): boolean {
        return allSelectedKeys.value.length > 1 && allSelectedKeySet.value.has(idKey);
    }

    function onCardMoved(idKey: string, fromGroupKey: string, toGroupKey: string, beforeIdKey: string | null): void {
        // If the from key and to key are the same then we just need to reorder the request.
        if (fromGroupKey === toGroupKey) {
            // Don't reorder if the board is sorted by a custom field.
            if (viewOptions.value.sortBy) {
                return;
            }
            reorderConnectionRequest(idKey, beforeIdKey, toGroupKey);
            return;
        }

        if (!gridData.value?.rows) {
            return;
        }
        const row = gridData.value.rows.find(r => r.idKey === idKey);

        // Only set value needed for reorder if the sortBy filter is empty (defaulting to Order).
        if (isNullOrWhiteSpace(viewOptions.value.sortBy)) {
            cardMovedBeforeIdKey.value = beforeIdKey;
        }

        // Group drag: dragged card is part of a multi-card selection.
        // Fall through to single-card path if not selected or sole selection,
        // so we never move cards the user didn't drag.
        const isGroupDrag = allSelectedKeys.value.length > 1 && allSelectedKeySet.value.has(idKey);

        // This Block only supports status grouping, so a cross-column move
        // always represents a status change. Other groupings (connector, state,
        // opportunity, campus, due status) are not supported on the Block at this time.
        selectedStatus.value = staticConnectionTypeOptions.value?.connectionStatuses?.find(s => s.idKey === toGroupKey)?.guid;

        // Pass in null if the card was moved from a group drag, otherwise pass in the data row
        // of the card that has been dragged.
        showChangeStatusModal(isGroupDrag ? null : row);
    }

    // #endregion Board Functions

    // #region Docked Panel Functions

    function updateSelectedRequestKey(key: string | null): void {
        dockedPanelDetailsBox.value = undefined;
        if (!isNullOrWhiteSpace(key)) {
            selectedRequestKeyForDockedPanel.value = key;
        }
    }

    // #endregion Docked Panel Functions

    // #region Modal Functions

    function resetNewConnectionRequest(): void {
        newConnectionRequest.value = { bag: { connectionOpportunityGuid: internalSelectedOpportunity.value, campusGuid: selectedCampus.value?.value } as ConnectionRequestBag };
        isExistingActiveRequesterOnConnectionType.value = false;
        onModalErrorMessageDismissed();
    }

    function onModalErrorMessageDismissed(): void {
        modalErrorMessage.value = "";
    }

    function onTransferModalClose(): void {
        isBulkTransfer.value = false;
        onModalErrorMessageDismissed();
    }

    // #endregioin Modal Functions

    // #region Helper Functions

    /** The time elapsed since the specified date in a human-readable format. */
    function getElapsedShortTime(date: string | null | undefined): string {
        return RockDateTime.parseISO(date ?? "")?.localDateTime.toElapsedShortString() ?? "";
    }

    function compareIsoDates(isoA?: string | null, isoB?: string | null, direction: string = "asc"): number {
        const dateA = RockDateTime.parseISO(isoA ?? "");
        const dateB = RockDateTime.parseISO(isoB ?? "");

        if (dateA && dateB) {
            const result = dateA.compareTo(dateB);
            return direction === "asc" ? result : -result;
        }

        if (dateA && !dateB) {
            return -1;
        }

        if (!dateA && dateB) {
            return 1;
        }

        return 0;
    }

    /**
    * Gets the filter value text to use for the requester column.
    *
    * @param row The row to be filtered.
    */
    function getRequesterFilterValue(row: Record<string, unknown>): string {
        const person = row["requestDetails"] as PersonFieldBag;
        return !person ? "" : `${person.nickName} ${person.lastName}`;
    }

    /**
    * Gets the filter value text to use for the connector column.
    *
    * @param row The row to be filtered.
    */
    function getConnectorFilterValue(row: Record<string, unknown>): string {
        const connectorItem = row["connectorDetails"] as ListItemBag;
        return !connectorItem ? "" : `${connectorItem.text}`;
    }

    /**
    * Gets the filter value text to use for the status column.
    *
    * @param row The row to be filtered.
    */
    function getStatusFilterValue(row: Record<string, unknown>): string {
        const statusBag = row["connectionStatus"] as ConnectionStatusBag;
        return !statusBag ? "" : `${statusBag.name}`;
    }

    /*
        5/7/26 - KBH

        Inactive requests render the due date cell as "-" even when the underlying DueDate has a value.
        Returning undefined here keeps those rows aligned with rows that truly have no due date so
        sorting matches what the user sees rather than the hidden ISO string.

        Reason: Hide-on-Inactive cells must sort like empty cells.
    */
    function getDueDateSortValue(row: Record<string, unknown>): string | undefined {
        const dueDate = row["dueDate"] as string | null | undefined;
        const connectionState = row["connectionState"] as ConnectionState | null | undefined;

        if (!dueDate || connectionState === ConnectionState.Inactive) {
            return undefined;
        }

        return dueDate;
    }

    function formatColumnDate(date: string | null | undefined): string {
        return RockDateTime.parseISO(date as string)?.toASPString("d") ?? "";
    }

    function formatDueDateShortLabel(dueDate: string | null | undefined, isCompleted: boolean, completedDateTime: string | null | undefined): string {
        // Use the completion date as the reference point if completed, otherwise use today
        const referenceDate = isCompleted ? RockDateTime.parseISO(completedDateTime ?? "")?.date : RockDateTime.now().date;
        const due = RockDateTime.parseISO(dueDate ?? "")?.date;

        // If either date is missing/invalid, return empty string
        if (!due || !referenceDate) {
            return "";
        }

        // Calculate the difference in days between the due date and the reference date
        const msPerDay = 1000 * 60 * 60 * 24;
        const dayDiff = Math.round(
            (due.toMilliseconds() - referenceDate.toMilliseconds()) / msPerDay
        );

        // Show "Today" label only for active (non-completed) tasks due today
        if (dayDiff === 0 && !isCompleted) {
            return "Today";
        }

        return `${dayDiff}d`;
    }

    function getDueDateColor(dueStatus: DueStatus | null | undefined, isCompleted: boolean): string {
        switch (dueStatus) {
            case DueStatus.DueLater:
                return isCompleted ? "grid-due-date-label grid-due-date-label--completed-early" : "grid-due-date-label grid-due-date-label--neutral";
            case DueStatus.DueSoon:
                return "grid-due-date-label grid-due-date-label--due-soon";
            case DueStatus.Overdue:
                return "grid-due-date-label grid-due-date-label--overdue";
            default:
                return "grid-due-date-label grid-due-date-label--neutral";
        }
    }

    function getConnectionStateLabel(state: ConnectionState | undefined): "default" | "primary" | "success" | "info" | "warning" | "danger" | "campus" | "type" | "custom" {
        switch (state) {
            case ConnectionState.Active:
                return "default";
            case ConnectionState.FutureFollowUp:
                return "info";
            case ConnectionState.Inactive:
                return "warning";
            case ConnectionState.Connected:
                return "success";
            default:
                return "default";
        }
    }

    function asLocaleString(dateTime: string | null | undefined): string {
        let date = RockDateTime.parseISO(dateTime ?? "");

        if (!date) {
            return "";
        }

        return date.toLocaleString({ year: "numeric", month: "numeric", day: "numeric" });
    }

    /**
     * Gets a preference key with the current connection type id applied.
     *
     * Replaces the `{0}` token in the provided preference key with the
     * configured `connectionTypeIdKey`, if available.
     *
     * @param preferenceKey The preference key template containing a `{0}` token.
     * @returns The resolved preference key, or an empty string if unavailable.
     */
    function getConnectionFilterKey(preferenceKey: string): string {
        if (isMyConnectionsView.value) {
            return preferenceKey.replace("{0}", "my-connections");
        }
        else if (!staticConnectionTypeOptions.value?.idKey) {
            return "";
        }

        return preferenceKey.replace("{0}", staticConnectionTypeOptions.value.idKey);
    }

    /** Adds the tooltip behavior to the element. */
    function addTooltip(element: Element | null): void {
        if (element) {
            tooltip(element);
        }
    }

    // #endregion Helper Functions

    function onPanelSettingsClick(): void {
        isViewOptionsModalVisible.value = true;
    }

    function onSnapshotClick(): void {
        isSnapshotVisible.value = !isSnapshotVisible.value;
        // Fetch snapshot data on true.
        if (isSnapshotVisible.value === true) {
            getSnapshotMetrics();
        }
    }

    /**
     * Selections that were saved but are currently out of scope (because the active
     * opportunity filter excludes them) are not shown in the modal and therefore could
     * not have been intentionally toggled off there. Preserve them so the corresponding
     * column reappears when the user navigates back to that opportunity or clears the
     * filter. Persistence to person preferences is handled by the deep watcher on
     * viewOptions.
     */
    function onViewOptionsUpdate(updatedViewOptions: ViewOptions): void {
        const previousSelections = viewOptions.value.gridDataToShow ?? [];
        const hiddenSavedSelections = previousSelections.filter(
            v => !inScopeGridDataToShowValues.value.has(v)
        );
        const newInScopeSelections = updatedViewOptions.gridDataToShow ?? [];
        const mergedGridDataToShow = [...newInScopeSelections, ...hiddenSavedSelections];

        viewOptions.value = {
            ...updatedViewOptions,
            gridDataToShow: mergedGridDataToShow,
        };
    }

    function decreaseReminderCount(requesterPersonAliasGuid: string): void {
        const row = gridData.value?.rows?.find(r => r.requesterPersonAliasGuid === requesterPersonAliasGuid);

        if (row && typeof row.reminderCount === "number") {
            row.reminderCount--;
        }

        if (dockedPanelDetailsBox.value?.entity) {
            dockedPanelDetailsBox.value.entity.reminderCount--;
        }
    }

    function increaseReminderCount(requesterPersonAliasGuid: string): void {
        const row = gridData.value?.rows?.find(r => r.requesterPersonAliasGuid === requesterPersonAliasGuid);

        if (row && typeof row.reminderCount === "number") {
            row.reminderCount++;
        }

        if (dockedPanelDetailsBox.value?.entity) {
            dockedPanelDetailsBox.value.entity.reminderCount++;
        }
    }

    /**
     * Called when the individual changes which rows are selected.
     *
     * @param state The state object that describes the grid.
     */
    function onSelectedKeysChanged(key: string | null | undefined, state: IGridState): void {
        if (!key) {
            return;
        }

        selectedKeys.value[key] = [...state.selectedKeys];
    }

    /**
     * Updates the grid state's selected keys to equal the selected keys before the grid unmounted.
     * @param key the grid's grouping key
     * @param state the grid state
     */
    function onGridLoad(key: string | null | undefined, state: IGridState): void {
        if (!key || !selectedKeysOnUnmount.value[key]) {
            return;
        }
        state.selectedKeys = [...state.selectedKeys, ...selectedKeysOnUnmount.value[key]];
    }

    /**
     * Saves the grid's selected keys before the grid unmounts.
     * @param key the grid's grouping key
     * @param state the grid state
     */
    function onGridUnload(key: string | null | undefined, state: IGridState): void {
        if (!key) {
            return;
        }
        selectedKeysOnUnmount.value[key] = [...state.selectedKeys];
    }

    function setSingleRequestDetail(row: Record<string, unknown> | null, dockedPanelBox: ConnectionRequestDetailBox | null): void {
        let requestDetailsBag;

        if (!row && !dockedPanelBox) {
            return;
        }

        if (row) {
            requestDetailsBag = getBulkRequestViewBagFromRow(row);
        }
        else if (dockedPanelBox) {
            requestDetailsBag = getBulkRequestViewBagFromDockedPanelDetails(dockedPanelBox);
        }

        requestDetailsForModal.value = [requestDetailsBag];
    }

    function getBulkRequestViewBagFromRow(row: Record<string, unknown>, idKey: string | null | undefined = null): BulkRequestViewBag {
        if (isNullOrWhiteSpace(idKey)) {
            idKey = row["idKey"] as string | null | undefined;
        }

        const connectionOpportunity = row["connectionOpportunity"] as string | null | undefined;
        const connectionOpportunityGuid = row["connectionOpportunityGuid"] as string | null | undefined;
        const connectionStatus = row["connectionStatus"] as ConnectionStatusBag | null | undefined;
        const connectionTypeSource = row["connectionTypeSource"] as string | null | undefined;
        const connector = row["connectorDetails"] as ListItemBag | null | undefined;
        const dueDate = row["dueDate"] as string | null | undefined;
        const requester = row["requestDetails"] as PersonFieldBag | null | undefined;
        const celebrationText = row["celebrationText"] as string | null | undefined;
        const hasPlacementGroup = row["hasPlacementGroup"] as boolean | null | undefined;

        return {
            idKey,
            connectionOpportunity,
            connectionOpportunityGuid,
            connectionStatus,
            connectionTypeSource,
            connector,
            dueDate,
            requester,
            celebrationText,
            hasPlacementGroup
        } as BulkRequestViewBag;
    }

    function getBulkRequestViewBagFromDockedPanelDetails(box: ConnectionRequestDetailBox): BulkRequestViewBag {
        if (!box.options || !box.entity) {
            return {};
        }

        const connector = box.options.connectorItems?.find(c => c.listItemBag?.value === box.entity?.connectorPerson)?.listItemBag;
        const hasPlacementGroup = !!box.entity?.placementGroup;

        const bag = <BulkRequestViewBag>{
            idKey: box.entity.connectionRequestIdKey,
            connectionOpportunity: box.entity.connectionOpportunityName,
            connectionOpportunityGuid: box.entity.connectionOpportunityGuid,
            connectionStatus: box.entity.connectionStatus,
            connectionTypeSource: box.entity.connectionTypeSource,
            connector: connector,
            dueDate: box.entity.dueDate,
            requester: box.entity.requesterPerson,
            celebrationText: box.entity.celebrationText,
            hasPlacementGroup
        };

        return bag;
    }

    function prepareRequestDetailsForModal(row: Record<string, unknown> | null = null, dockedPanelBox: ConnectionRequestDetailBox | null = null): void {
        // If row and dockedPanelBox are both null then we are in bulk action mode.
        if (row === null && dockedPanelBox === null) {
            requestDetailsForModal.value = selectedRequestDetails.value;
            isBulkAction.value = true;
            activeRowConnectionTypeIdKey.value = null;
            return;
        }

        setSingleRequestDetail(row, dockedPanelBox);
        isBulkAction.value = false;

        if (row) {
            activeRowConnectionTypeIdKey.value = (row["connectionTypeIdKey"] as string | null | undefined) ?? null;
        }
        else if (dockedPanelBox) {
            activeRowConnectionTypeIdKey.value = dockedPanelBox.options?.connectionTypeIdKey ?? null;
        }
    }

    function collapseAll(): void {
        groupedPanel.value.collapseAll();
    }

    function toggleAutoCollapse(): void {
        isAutoCollapseEnabled.value = !isAutoCollapseEnabled.value;
    }

    // #region Export to Excel or CSV

    /**
     * Builds the workbook containing the currently visible connection requests,
     * along with the raw row data and the title used for the export. This is
     * shared by the Excel and CSV export paths so the two formats stay in sync.
     * Follows the same pattern as the Grid component's getExportWorkbook
     * (grid.partial.obs).
     */
    async function getExportWorkbook(): Promise<{ workbook: import("@Obsidian/Libs/exceljs").Workbook, rowData: Record<string, unknown>[], title: string } | null> {
        // When the user has selected specific rows, limit the export to just
        // those rows. Otherwise, export every currently visible row.
        let rows = visibleRowsFilteredByGrid.value;

        if (hasAnySelectedKeys.value) {
            rows = rows.filter(row => {
                const idKey = row["idKey"] as string | null | undefined;
                return !!idKey && allSelectedKeySet.value.has(idKey);
            });
        }

        if (!rows.length) {
            return null;
        }

        // Build the list of columns to export based on current view options.
        type ExportColumn = {
            key: string;
            title: string;
            getValue: (row: Record<string, unknown>) => unknown;
        };

        const columns: ExportColumn[] = [];

        columns.push({
            key: "id",
            title: "Id",
            getValue: (row) => row.id
        });

        columns.push({
            key: "name",
            title: "Name",
            getValue: (row) => {
                const person = row.requestDetails as PersonFieldBag | null;
                return person ? `${person.nickName ?? ""} ${person.lastName ?? ""}`.trim() : "";
            }
        });

        const gridDataToShow = viewOptions.value.gridDataToShow ?? [];

        if (gridDataToShow.includes("connectionOpportunity")) {
            columns.push({
                key: "connectionOpportunity",
                title: "Connection Opportunity",
                getValue: (row) => (row.connectionOpportunity as string) ?? ""
            });

            if (viewOptions.value.isRequestSourceShown) {
                columns.push({
                    key: "connectionTypeSource",
                    title: "Connection Request Source",
                    getValue: (row) => (row.connectionTypeSource as string) ?? ""
                });
            }
        }

        columns.push({
            key: "connectorDetails",
            title: "Connector",
            getValue: (row) => (row.connectorDetails as ListItemBag | null)?.text ?? ""
        });

        columns.push({
            key: "campus",
            title: "Campus",
            getValue: (row) => (row.campus as string) ?? ""
        });

        if (allConnectionTypeOptions.value.some(t => t.areGroupPlacementsEnabled)) {
            columns.push({
                key: "group",
                title: "Placement Group",
                getValue: (row) => (row.group as string) ?? ""
            });
        }

        if (gridDataToShow.includes("activity")) {
            columns.push({
                key: "lastActivityDateTime",
                title: "Last Activity Date",
                getValue: (row) => toExcelDate(row.lastActivityDateTime as string | null | undefined)
            });

            columns.push({
                key: "activityCount",
                title: "Activity Count",
                getValue: (row) => (row.activityCount as number) ?? ""
            });
        }

        if (gridDataToShow.includes("dueDate")) {
            columns.push({
                key: "dueDate",
                title: "Due Date",
                getValue: (row) => toExcelDate(row.dueDate as string | null | undefined)
            });
            columns.push({
                key: "dueSoonDate",
                title: "Due Soon Date",
                getValue: (row) => toExcelDate(row.dueSoonDate as string | null | undefined)
            });
        }

        columns.push({
            key: "connectionStatus",
            title: "Connection Status",
            getValue: (row) => (row.connectionStatus as ConnectionStatusBag | null)?.name ?? ""
        });

        columns.push({
            key: "connectionState",
            title: "Connection State",
            getValue: (row) => {
                const state = row.connectionState as ConnectionState | null | undefined;
                return state != null ? (ConnectionStateDescription[state] ?? "") : "";
            }
        });

        columns.push({
            key: "createdDateTime",
            title: "Created Date",
            getValue: (row) => toExcelDate(row.createdDateTime as string | null | undefined)
        });

        if (allConnectionTypeOptions.value.some(t => t.isFutureFollowUpEnabled)) {
            columns.push({
                key: "followUpDate",
                title: "Follow-Up Date",
                getValue: (row) => toExcelDate(row.followUpDate as string | null | undefined)
            });
        }

        columns.push({
            key: "completedDateTime",
            title: "Completed Date",
            getValue: (row) => toExcelDate(row.completedDateTime as string | null | undefined)
        });

        columns.push({
            key: "order",
            title: "Order",
            getValue: (row) => row.order
        });

        // Attribute columns the user has selected.
        for (const attr of (attributesToShow.value ?? [])) {
            const attrName = attr.name;
            if (!attrName) {
                return null;
            }
            columns.push({
                key: attrName,
                title: attr.title ?? attrName,
                getValue: (row) => {
                    const value = row[attrName];

                    if (!value || typeof value !== "object") {
                        return undefined;
                    }

                    if (typeof value["text"] !== "string") {
                        return undefined;
                    }

                    return value["text"];
                }
            });
        }

        columns.push({
            key: "requesterPersonAliasGuid",
            title: "Person Alias Guid",
            getValue: (row) => row.requesterPersonAliasGuid
        });

        columns.push({
            key: "connectionOpportunityGuid",
            title: "Connection Opportunity Guid",
            getValue: (row) => row.connectionOpportunityGuid
        });

        columns.push({
            key: "campusGuid",
            title: "Campus Guid",
            getValue: (row) => row.campusGuid
        });

        // Dynamically import ExcelJS so it is only loaded when needed.
        const exceljs = await import("@Obsidian/Libs/exceljs");
        const title = box.options?.title || "Connection Requests";

        const workbook = new exceljs.Workbook();
        workbook.created = new Date();
        workbook.modified = new Date();
        const worksheet = workbook.addWorksheet(title);

        // Set the column headers.
        worksheet.columns = columns.map(c => ({
            header: c.title,
            key: c.key
        }));

        // Build the data rows.
        const rowData: Record<string, unknown>[] = [];
        for (const row of rows) {
            const record: Record<string, unknown> = {};
            for (const col of columns) {
                record[col.key] = col.getValue(row);
            }
            rowData.push(record);
        }

        worksheet.addRows(rowData);

        return { workbook, rowData, title };
    }

    /**
     * Triggers an automatic download of the workbook so it can be saved to
     * the filesystem. Mirrors the Grid component's downloadWorkbook helper
     * (grid.partial.obs) so CSV and Excel paths share a single download flow.
     *
     * @param workbook The workbook to be downloaded by the browser.
     * @param title The title of the workbook, used as the base for the filename.
     * @param format The format to use when downloading the workbook.
     */
    async function downloadWorkbook(workbook: import("@Obsidian/Libs/exceljs").Workbook, title: string, format: "csv" | "xlsx"): Promise<void> {
        const buffer = format === "xlsx"
            ? await workbook.xlsx.writeBuffer()
            : await workbook.csv.writeBuffer();

        const data = new Blob([buffer], { type: "application/octet-stream" });

        await downloadFile(data, `${title.replace(/[^a-zA-Z0-9\-_]/g, "")}.${format}`);
    }

    /**
     * Exports the currently visible connection requests to an Excel file.
     * Follows the same formatting pattern as the Grid component's built-in
     * export (grid.partial.obs).
     */
    async function exportToExcel(): Promise<void> {
        const result = await getExportWorkbook();

        if (!result) {
            return;
        }

        const { workbook, rowData, title } = result;
        const worksheet = workbook.getWorksheet(title);

        if (!worksheet) {
            return;
        }

        // Apply formatting to data rows.
        const lineHeight = 15;
        const padding = 2;

        worksheet.eachRow((row, index) => {
            let maxLines = 1;

            row.eachCell((cell) => {
                const text = cell.value?.toString() ?? "";

                if (text.includes("\n")) {
                    const lineCount = text.split("\n").length;
                    if (lineCount > maxLines) {
                        maxLines = lineCount;
                    }

                    cell.alignment = { wrapText: true, vertical: "top" };
                }
                else {
                    cell.alignment = { wrapText: false, vertical: "top" };
                }

                row.height = (maxLines * lineHeight) + padding;

                // Zebra striping every other row.
                if ((index + 1) % 2 === 0) {
                    cell.fill = {
                        type: "pattern",
                        pattern: "solid",
                        fgColor: { argb: "ffc6f1c7" }
                    };
                }
            });
        });

        // Freeze the header rows.
        worksheet.views = [{ state: "frozen", ySplit: 3 }];

        // Auto-fit column widths.
        for (const column of worksheet.columns) {
            if (!column.key) {
                continue;
            }

            let maxLength: number = (column.header?.toString() ?? "").length + 3;

            for (const row of rowData) {
                const value = row[column.key];

                if (typeof value === "string") {
                    const longestLineLength = value.split("\n").reduce((max, str) => Math.max(max, str.length), 0);
                    maxLength = Math.max(maxLength, longestLineLength + 1);
                }
                else if (typeof value === "boolean") {
                    maxLength = Math.max(maxLength, 6);
                }
                else if (value instanceof Date) {
                    maxLength = Math.max(maxLength, 11);
                }
                else {
                    maxLength = Math.max(maxLength, String(value).length + 1);
                }
            }

            column.width = Math.min(80, Math.max(4, maxLength));
        }

        // Insert the title and export timestamp header rows.
        worksheet.insertRows(1, [{}, {}]);
        worksheet.getCell(1, 1).value = title;
        worksheet.getCell(2, 1).value = `Exported on ${RockDateTime.now().toASPString("G")}`;
        worksheet.getCell(1, 1).font = { size: 18 };

        // Style header rows (title, timestamp, column headers).
        worksheet.getRows(1, 3)?.forEach(row => {
            row.eachCell(cell => {
                cell.fill = {
                    type: "pattern",
                    pattern: "solid",
                    fgColor: { argb: "ffdedede" }
                };
                cell.font = cell.font ?? {};
                cell.font.bold = true;
            });
        });

        worksheet.mergeCells(1, 1, 1, worksheet.columns.length);
        worksheet.mergeCells(2, 1, 2, worksheet.columns.length);

        // Set up auto-filter on the data range.
        worksheet.autoFilter = {
            from: { row: 3, column: 1 },
            to: { row: rowData.length + 3, column: worksheet.columns.length }
        };

        await downloadWorkbook(workbook, title, "xlsx");
    }

    /**
     * Exports the currently visible connection requests to a CSV file. Skips
     * Excel-only formatting (styling, merged header rows, auto-filter) since
     * CSV is a plain text format. Mirrors onExportToCsv in grid.partial.obs.
     */
    async function exportToCsv(): Promise<void> {
        const result = await getExportWorkbook();

        if (!result) {
            return;
        }

        const { workbook, title } = result;

        await downloadWorkbook(workbook, title, "csv");
    }

    /**
     * Converts an ISO date string to a UTC Date object suitable for Excel.
     * Excel is not timezone aware, so we strip the zone information.
     */
    function toExcelDate(isoDate: string | null | undefined): Date | string {
        const parsed = RockDateTime.parseISO(isoDate ?? "");

        if (!parsed) {
            return "";
        }

        return new Date(Date.UTC(parsed.year, parsed.month - 1, parsed.day, parsed.hour, parsed.minute, parsed.second));
    }

    // #endregion Export to Excel or CSV

