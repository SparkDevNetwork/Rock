<template>
    <Modal v-model="isVisible"
           title="Settings"
           saveText="Save"
           @save="onSave">
        <ContentSection light class="mb-3">
            <div>
                <div class="row">
                    <div class="col-md-6">
                        <SlidingDateRangePicker v-model="dateRange"
                                                label="Date Range"
                                                rules="required"
                                                :isRangeClearable="false" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <NumberRangeBox v-model="amountRange"
                                        label="Amount Range" />
                    </div>
                </div>
            </div>
        </ContentSection>

        <ContentSection title="Payment Method" icon="ti ti-wallet" class="mb-3">
            <div>
                <div class="row">
                    <div class="col-md-6">
                        <DefinedValuePicker v-model="currencyType"
                                            :showBlankItem="true"
                                            label="Currency Type"
                                            :definedTypeGuid="DefinedType.FinancialCurrencyType"
                                            :displayStyle="PickerDisplayStyle.Condensed" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <DefinedValuePicker v-model="creditCardType"
                                            label="Credit Card Type"
                                            :showBlankItem="true"
                                            :definedTypeGuid="DefinedType.FinancialCreditCardType"
                                            :displayStyle="PickerDisplayStyle.Condensed" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <DefinedValuePicker v-model="sourceType"
                                            label="Source Type"
                                            :showBlankItem="true"
                                            :definedTypeGuid="DefinedType.FinancialSourceType"
                                            :displayStyle="PickerDisplayStyle.Condensed" />
                    </div>
                </div>
            </div>
        </ContentSection>

        <ContentSection title="Transaction Details" icon="ti ti-list-details" class="mb-3">
            <div>
                <div class="row">
                    <div class="col-md-6">
                        <TextBox v-model="transactionCode"
                                 label="Transaction Code" />
                    </div>
                </div>
                <div class="row">
                    <div v-if="isForeignKeyFilterVisible" class="col-md-6">
                        <TextBox v-model="foreignKey"
                                 label="Foreign Key" />
                    </div>
                </div>
                <div class="row">
                    <div v-if="isAccountFilterVisible" class="col-md-6">
                        <AccountPicker v-model="account"
                                       label="Account"
                                       :activeOnly="isActiveAccountsOnlyFilter" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <DefinedValuePicker v-model="transactionType"
                                            label="Transaction Type"
                                            :showBlankItem="true"
                                            :definedTypeGuid="DefinedType.FinancialTransactionType"
                                            :displayStyle="PickerDisplayStyle.Condensed" />
                    </div>
                </div>
                <div v-if="isCampusFilterVisible" class="row">
                    <div class="col-md-6">
                        <CampusPicker v-model="campusOfBatch"
                                      :showBlankItem="true"
                                      label="Campus of Batch"
                                      :includeInactive="true"
                                      :forceVisible="true" />
                    </div>
                </div>
                <div v-if="isCampusFilterVisible" class="row">
                    <div class="col-md-6">
                        <CampusPicker v-model="campusOfAccount"
                                      :showBlankItem="true"
                                      :includeInactive="true"
                                      label="Campus of Account"
                                      :forceVisible="true" />
                    </div>
                </div>
            </div>
        </ContentSection>
    </Modal>
</template>

<script setup lang="ts">
    import { PickerDisplayStyle } from "@Obsidian/Enums/Controls/pickerDisplayStyle";
    import { DefinedType } from "@Obsidian/SystemGuids/definedType";
    import AccountPicker from "@Obsidian/Controls/accountPicker.obs";
    import CampusPicker from "@Obsidian/Controls/campusPicker.obs";
    import SlidingDateRangePicker from "@Obsidian/Controls/slidingDateRangePicker.obs";
    import DefinedValuePicker from "@Obsidian/Controls/definedValuePicker.obs";
    import Modal from "@Obsidian/Controls/modal.obs";
    import NumberRangeBox from "@Obsidian/Controls/numberRangeBox.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import { nextTick, PropType, ref, watch } from "vue";
    import { GridSettingsOptions } from "./types.partial";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { SlidingDateRange } from "@Obsidian/Utility/slidingDateRange";
    import { deepEqual } from "@Obsidian/Utility/util";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<GridSettingsOptions>,
            required: true
        },

        defaultSlidingDateRange: {
            type: Object as PropType<SlidingDateRange>,
            required: true
        },

        visible: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        isForeignKeyFilterVisible: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        isAccountFilterVisible: {
            type: Boolean as PropType<boolean>,
            default: true
        },

        isActiveAccountsOnlyFilter: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        isCampusFilterVisible: {
            type: Boolean as PropType<boolean>,
            default: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: GridSettingsOptions): void;
        (e: "update:visible", value: boolean): void;
        (e: "close"): void;
    }>();

    // #region Values

    const isVisible = useVModelPassthrough(props, "visible", emit);

    const dateRange = ref<SlidingDateRange | null>(props.modelValue.dateRange ?? props.defaultSlidingDateRange);
    const amountRange = ref(props.modelValue.amountRange);
    const currencyType = ref(props.modelValue.currencyType ?? null);
    const creditCardType = ref(props.modelValue.creditCardType ?? null);
    const sourceType = ref(props.modelValue.sourceType ?? null);
    const transactionType = ref(props.modelValue.transactionType ?? null);
    const transactionCode = ref(props.modelValue.transactionCode ?? "");
    const foreignKey = ref(props.modelValue.foreignKey ?? "");
    const account = ref(props.modelValue.account as ListItemBag);
    const campusOfBatch = ref(props.modelValue.campusOfBatch as ListItemBag);
    const campusOfAccount = ref(props.modelValue.campusOfAccount as ListItemBag);

    // #endregion Values

    // #region Event Handlers

    function onSave(): void {
        const value: GridSettingsOptions = {
            dateRange: dateRange.value,
            amountRange: amountRange.value,
            currencyType: currencyType.value,
            creditCardType: creditCardType.value,
            sourceType: sourceType.value,
            transactionType: transactionType.value,
            transactionCode: transactionCode.value || null,
            foreignKey: foreignKey.value || null,
            account: account.value,
            campusOfBatch: campusOfBatch.value,
            campusOfAccount: campusOfAccount.value,
        };

        if (!deepEqual(value, props.modelValue, true)) {
            emit("update:modelValue", value);
        }

        isVisible.value = false;
    }

    // #endregion Event Handlers

    // #region Watchers

    watch(() => props.modelValue, () => {
        dateRange.value = props.modelValue.dateRange ?? props.defaultSlidingDateRange;
        amountRange.value = props.modelValue.amountRange;
        currencyType.value = props.modelValue.currencyType ?? null;
        creditCardType.value = props.modelValue.creditCardType ?? null;
        sourceType.value = props.modelValue.sourceType ?? null;
        transactionType.value = props.modelValue.transactionType ?? null;
        transactionCode.value = props.modelValue.transactionCode ?? "";
        foreignKey.value = props.modelValue.foreignKey ?? "";
        account.value = props.modelValue.account as ListItemBag;
        campusOfBatch.value = props.modelValue.campusOfBatch as ListItemBag;
        campusOfAccount.value = props.modelValue.campusOfAccount as ListItemBag;
    });

    // The date range is required; if the user clears it, fall back to the default range.
    watch(dateRange, () => {
        nextTick(() => {
            if (!dateRange.value) {
                dateRange.value = props.defaultSlidingDateRange;
            }
        });
    });

    watch(isVisible, () => {
        if (!isVisible.value) {
            emit("close");
        }
    });

    // #endregion Watchers
</script>
