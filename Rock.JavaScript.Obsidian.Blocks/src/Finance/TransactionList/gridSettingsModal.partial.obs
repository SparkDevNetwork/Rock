<template>
    <Modal v-model="isVisible"
           title="Settings"
           saveText="Save"
           @save="onSave">
        <!-- TODO Step 4: filter fields — Date Range, Amount Range, Payment Method
             (Currency Type, Credit Card Type, Source Type), Transaction Details
             (Transaction Code, Foreign Key, Account, Transaction Type,
             Campus of Batch, Campus of Account), Person, and dynamic attribute filters. -->
    </Modal>
</template>

<script setup lang="ts">
    import Modal from "@Obsidian/Controls/modal.obs";
    import { ref, watch } from "vue";

    const props = defineProps<{
        visible: boolean;
    }>();

    const emit = defineEmits<{
        (e: "update:visible", value: boolean): void;
    }>();

    // #region Values

    const isVisible = ref(props.visible);

    // #endregion Values

    // #region Event Handlers

    function onSave(): void {
        // TODO Step 4: persist filter selections and close.
        isVisible.value = false;
    }

    // #endregion Event Handlers

    // #region Watchers

    watch(() => props.visible, () => {
        isVisible.value = props.visible;
    });

    watch(isVisible, () => {
        emit("update:visible", isVisible.value);
    });

    // #endregion Watchers
</script>
