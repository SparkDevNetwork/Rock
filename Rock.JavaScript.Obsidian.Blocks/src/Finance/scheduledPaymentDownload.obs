<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Panel title="Scheduled Payment Download" titleIconCssClass="ti ti-download" type="block">
        <RockForm @submit="onDownloadClick">
            <FinancialGatewayPicker v-model="financialGateway"
                                    label="Payment Gateway"
                                    rules="required" />

            <DateRangePicker v-model="dateRange"
                             label="Date Range"
                             rules="required" />

            <div class="actions">
                <RockButton btnType="primary"
                            type="submit"
                            autoLoading
                            :isLoading="isDownloading"
                            loadingText="Downloading...">
                    Download Transactions
                </RockButton>
            </div>

            <NotificationBox v-if="successMessage"
                             alertType="success"
                             heading="Transaction Download Summary:"
                             v-html="successMessage" />

            <NotificationBox v-if="errorMessage"
                             alertType="danger"
                             v-html="errorMessage" />
        </RockForm>
    </Panel>
</template>

<script setup lang="ts">
    import { ref } from "vue";
    import { useInvokeBlockAction } from "@Obsidian/Utility/block";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import FinancialGatewayPicker from "@Obsidian/Controls/financialGatewayPicker.obs";
    import DateRangePicker from "@Obsidian/Controls/dateRangePicker.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { DateRangeParts } from "@Obsidian/Types/Controls/dateRangePicker";
    import { DownloadTransactionsRequestBag } from "@Obsidian/ViewModels/Blocks/Finance/ScheduledPaymentDownload/downloadTransactionsRequestBag";
    import { DownloadTransactionsResultBag } from "@Obsidian/ViewModels/Blocks/Finance/ScheduledPaymentDownload/downloadTransactionsResultBag";

    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const financialGateway = ref<ListItemBag | undefined>();
    const dateRange = ref<DateRangeParts | undefined>();

    const successMessage = ref("");
    const errorMessage = ref("");
    const isDownloading = ref(false);

    // #endregion Values

    // #region Event Handlers

    /**
     * Event handler for the Download Transactions button. Sends the selected
     * gateway and date range to the server and shows the returned summary.
     */
    async function onDownloadClick(): Promise<void> {
        successMessage.value = "";
        errorMessage.value = "";
        isDownloading.value = true;

        try {
            const bag: DownloadTransactionsRequestBag = {
                financialGatewayGuid: financialGateway.value?.value,
                startDate: dateRange.value?.lowerValue,
                endDate: dateRange.value?.upperValue
            };

            const response = await invokeBlockAction<DownloadTransactionsResultBag>("DownloadTransactions", { bag });

            if (response.isError) {
                errorMessage.value = response.errorMessage ?? "Unable to download transactions.";
                return;
            }

            successMessage.value = response.data?.summaryHtml ?? "";
        }
        finally {
            isDownloading.value = false;
        }
    }

    // #endregion Event Handlers
</script>
