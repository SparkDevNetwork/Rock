<template>
    <Grid :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="idKey"
          itemTerm="Transaction"
          :entityTypeGuid="EntityType.FinancialTransaction"
          :customActions="customActions"
          liveUpdates>

        <template #gridHeaderBadges>
            <div class="d-flex justify-content-end px-3 py-2">
                <div class="btn-group">
                    <RockButton :btnType="(pendingViewMode ?? viewMode) === ViewMode.Transactions ? BtnType.Primary : BtnType.Default"
                                :btnSize="BtnSize.Small"
                                :disabled="pendingViewMode !== null"
                                @click="onViewModeClick(ViewMode.Transactions)">
                        Transactions
                    </RockButton>
                    <RockButton :btnType="(pendingViewMode ?? viewMode) === ViewMode.Accounts ? BtnType.Primary : BtnType.Default"
                                :btnSize="BtnSize.Small"
                                :disabled="pendingViewMode !== null"
                                @click="onViewModeClick(ViewMode.Accounts)">
                        Accounts
                    </RockButton>
                </div>
            </div>
        </template>

        <TextColumn name="transactionIdKey" field="transactionIdKey" :hideOnScreen="true" />

        <SelectColumn />
        <PersonColumn name="person" title="Name" field="person" width="200px" />
        <DateTimeColumn name="transactionDateTime" title="Date" field="transactionDateTime" :showSeconds="true" />

        <Column name="daysSinceLastTransaction" title="Last Transaction" field="daysSinceLastTransaction" headerClass="text-right" itemClass="text-right">
            <template #format="{ row }">
                <div class="w-100">
                    <span v-if="row.daysSinceLastTransaction != null">{{ row.daysSinceLastTransaction }}d</span>
                </div>
            </template>
        </Column>

        <CurrencyColumn name="totalAmount" title="Amount" field="totalAmount" />
        <TextColumn name="foreignCurrency" title="Foreign Currency" field="foreignCurrency" />
        <TextColumn name="currencyType" title="Currency Type" field="currencyType" width="200px" />
        <TextColumn name="transactionCode" title="Transaction Code" field="transactionCode" width="200px" />
        <TextColumn name="foreignKey" title="Foreign Key" field="foreignKey" width="150px" />
        <NumberColumn name="batchId" title="Batch Id" field="batchId" />
        <TextColumn name="batchIdKey" field="batchIdKey" :hideOnScreen="true" />

        <Column name="accounts" title="Accounts" field="accounts">
            <template #format="{ row }">
                <div class="text-sm">
                    <div v-for="account in row.accounts">
                        {{ account.name }}: {{ toCurrencyOrNull(account.amount, config.options?.currencyInfo) }}
                    </div>
                </div>
            </template>
        </Column>

        <TextColumn name="summary" title="Comments" field="summary" width="200px" />
        <AttributeColumns :attributes="attributeFields" />

        <Column name="image" title="Image" field="image" v-if="showImages" :width="imageColumnWidth">
            <template #format="{ row }">
                <img v-if="row.image" :src="row.image" :max-height="`${imageHeight}px`" width="auto" @load="onImageLoad" />
            </template>
        </Column>

        <TextColumn name="status" title="Status" field="status" :hideOnScreen="true" />
        <DateTimeColumn name="settledDate" title="Settled Date" field="settledDate" :hideOnScreen="true" />
        <TextColumn name="processorBatchId" title="Processor Batch Id" field="processorBatchId" :hideOnScreen="true" />

    </Grid>
</template>

<script setup lang="ts">
    import { useConfigurationValues, useInvokeBlockAction, usePersonPreferences } from "@Obsidian/Utility/block";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import Grid, { AttributeColumns, Column, CurrencyColumn, DateTimeColumn, NumberColumn, PersonColumn, SelectColumn, TextColumn } from "@Obsidian/Controls/grid";
    import { GridAction } from "@Obsidian/Types/Controls/grid";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import { BtnSize } from "@Obsidian/Enums/Controls/btnSize";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { TransactionListOptionsBag } from "@Obsidian/ViewModels/Blocks/Finance/TransactionList/transactionListOptionsBag";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { AttributeFieldDefinitionBag } from "@Obsidian/ViewModels/Core/Grid/attributeFieldDefinitionBag";
    import { computed, reactive, ref } from "vue";
    import { PreferenceKey, ViewMode } from "./TransactionList/types.partial";
    import { toCurrencyOrNull } from "@Obsidian/Utility/numberUtils";

    const config = useConfigurationValues<ListBlockBox<TransactionListOptionsBag>>();
    console.log("Configuration values:", config);
    const invokeBlockAction = useInvokeBlockAction();
    const preferences = usePersonPreferences().blockPreferences;

    // #region Values

    const gridDataSource = ref<Promise<GridDataBag>>();
    let gridData: GridDataBag | undefined;
    const viewMode = ref<string>(config.options?.viewMode ?? ViewMode.Transactions);
    const pendingViewMode = ref<string | null>(null);
    const showImages = ref<boolean>(preferences.getValue(PreferenceKey.ShowImages) === "true");
    const imageHeight = config.options?.imageHeight ?? 200;

    // The widest rendered image measured so far, in pixels. The column grows to fit the widest
    // image as each one loads. Reset whenever the grid data reloads.
    const maxImageWidth = ref<number>(0);

    // #endregion Values

    // #region Computed Values

    const imageColumnWidth = computed<string | undefined>(() => {
        return maxImageWidth.value > 0 ? `${maxImageWidth.value}px` : undefined;
    });

    const attributeFields = computed<AttributeFieldDefinitionBag[]>(() => {
        return viewMode.value === ViewMode.Accounts
            ? (config.options?.transactionDetailAttributeOptions ?? [])
            : (config.options?.transactionAttributeOptions ?? []);
    });

    const customActions = computed((): GridAction[] => {
        if (!config.options?.isImagesToggleVisible) {
            return [];
        }

        return [{
            title: showImages.value ? "Hide Images" : "Show Images",
            iconCssClass: showImages.value ? "ti ti-photo-off" : "ti ti-photo",
            handler: onToggleImages
        }];
    });

    // #endregion Computed Values

    // #region Functions

    /**
     * Called when the grid is requesting the row data be loaded.
     */
    async function loadGridData(): Promise<GridDataBag> {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (result.isSuccess && result.data) {
            gridData = reactive(result.data);

            // Reset the measured width so a new data set re-fits the column to its own images.
            maxImageWidth.value = 0;

            console.log("Grid data loaded:", gridData);
            return gridData;
        }
        else {
            throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
        }
    }

    /**
     * Gets the combined left and right padding, in pixels, of the grid cell containing the given
     * element. The cell padding is driven by `--table-cell-padding-x`; reading the resolved
     * padding off the cell returns pixels regardless of the unit the variable is authored in.
     *
     * @param element An element inside the grid cell.
     * @returns The horizontal padding in pixels, or 0 if the cell cannot be found.
     */
    function getCellPaddingX(element: HTMLElement): number {
        const cell = element.closest(".grid-cell") as HTMLElement | null;

        if (!cell) {
            return 0;
        }

        const style = getComputedStyle(cell);

        return parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
    }

    // #endregion Functions

    // #region Event Handlers

    /**
     * Called when one of the view mode toggle buttons is clicked. Saves the selected
     * view mode on the server, then reloads the grid data for the new mode.
     *
     * @param mode The view mode that was selected.
     */
    async function onViewModeClick(mode: string): Promise<void> {
        if (viewMode.value === mode || pendingViewMode.value === mode) {
            return;
        }

        pendingViewMode.value = mode;

        await invokeBlockAction("SetViewMode", { viewMode: mode });

        const data = await loadGridData();

        viewMode.value = mode;
        pendingViewMode.value = null;
        gridDataSource.value = Promise.resolve(data);
    }

    /**
     * Toggles the "Show Images" preference and reloads the grid so image URLs
     * are included or excluded in the next data response.
     */
    async function onToggleImages(): Promise<void> {
        showImages.value = !showImages.value;
        preferences.setValue(PreferenceKey.ShowImages, showImages.value.toString());
        await preferences.save();
    }

    /**
     * Measures each image as it loads and grows the column to fit the widest one. The rendered
     * width is the natural aspect ratio scaled to the configured image height, plus the cell's
     * horizontal padding so the image is not clipped by the column edge.
     *
     * @param event The image load event.
     */
    function onImageLoad(event: Event): void {
        const img = event.target as HTMLImageElement;

        if (img.naturalHeight === 0) {
            return;
        }

        const renderedWidth = (img.naturalWidth / img.naturalHeight) * imageHeight;
        const totalWidth = renderedWidth + getCellPaddingX(img);

        if (totalWidth > maxImageWidth.value) {
            maxImageWidth.value = totalWidth;
        }
    }

    // #endregion Event Handlers

    gridDataSource.value = loadGridData();
</script>
