<template>
    <div v-html="content"></div>
</template>

<script setup lang="ts">
    import { ref } from "vue";
    import { onConfigurationValuesChanged, useConfigurationValues, useReloadBlock } from "@Obsidian/Utility/block";
    import { CustomBlockBox } from "@Obsidian/ViewModels/Blocks/customBlockBox";
    import { BenevolenceRequestStatementLavaBag } from "@Obsidian/ViewModels/Blocks/Finance/BenevolenceRequestStatementLava/benevolenceRequestStatementLavaBag";
    import { BenevolenceRequestStatementLavaOptionsBag } from "@Obsidian/ViewModels/Blocks/Finance/BenevolenceRequestStatementLava/benevolenceRequestStatementLavaOptionsBag";

    const config = useConfigurationValues<CustomBlockBox<BenevolenceRequestStatementLavaBag, BenevolenceRequestStatementLavaOptionsBag>>();

    // All blocks auto reload when changing block settings unless there is an
    // explicit reason not to (like using a custom reload function instead),
    // in which case you can remove this code.
    onConfigurationValuesChanged(useReloadBlock());

    const content = ref(config.bag?.content ?? "");
</script>
