<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <GalleryAndResult :value="{ type, title, description, iconCssClass }"
                      :importCode="importCode"
                      :exampleCode="exampleCode"
                      enableReflection>

        <EmptyState :type="typeProp"
                    :title="title || undefined"
                    :description="isDescriptionHidden ? '' : (description || undefined)"
                    :iconCssClass="iconCssClass || undefined"
                    :isBordered="isBordered">
            <template v-if="actions === 'clearFilters'">
                <RockButton :btnType="BtnType.Link" @click="onActionClick('Clear Filters')">Clear Filters</RockButton>
            </template>
            <template v-else-if="actions === 'primaryAndSecondary'">
                <RockButton :btnType="BtnType.Primary" @click="onActionClick('New Communication')">New Communication</RockButton>
                <RockButton :btnType="BtnType.Default" @click="onActionClick('View Templates')">View Templates</RockButton>
            </template>
            <template v-else-if="actions === 'addButton'">
                <RockButton :btnType="BtnType.Default" @click="onActionClick('Add Group')"><i class="ti ti-plus"></i> Add Group</RockButton>
            </template>
            <template v-else-if="actions === 'upload'">
                <RockButton :btnType="BtnType.Default" @click="onActionClick('Upload Image')"><i class="ti ti-upload"></i> Upload Image</RockButton>
                <small class="text-muted">JPG, PNG or GIF up to 10 MB</small>
            </template>
        </EmptyState>

        <template #settings>
            <div class="row">
                <div class="col-md-4">
                    <DropDownList label="Type" v-model="type" :items="typeOptions" :showBlankItem="false" help="Picks the standard icon, title and description." />
                </div>
                <div class="col-md-4">
                    <TextBox label="Title" v-model="title" help="Blank uses the standard title for the type." />
                </div>
                <div class="col-md-4">
                    <TextBox label="Icon CSS Class" v-model="iconCssClass" help="Blank uses the standard icon for the type, e.g. ti ti-mood-empty." />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <TextBox label="Description" v-model="description" textMode="multiline" help="Blank uses the standard description for the type." />
                </div>
                <div class="col-md-3">
                    <CheckBox label="Hide Description" v-model="isDescriptionHidden" help="Passes an empty description, which hides the description line." />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <DropDownList label="Slot Content Examples" v-model="actions" :items="actionOptions" :showBlankItem="false" help="The control's slot renders below the message. Any control can be placed in it, such as buttons or links. These are examples of what a block might slot in." />
                </div>
                <div class="col-md-3">
                    <CheckBox label="Bordered" v-model="isBordered" help="Adds a border. Use it when the empty state sits directly on the block surface, not inside a panel." />
                </div>
            </div>
        </template>
    </GalleryAndResult>
</template>

<script setup lang="ts">
    import { computed, ref } from "vue";
    import GalleryAndResult from "./common/galleryAndResult.partial.obs";
    import EmptyState from "@Obsidian/Controls/emptyState.obs";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { getSfcControlImportPath } from "./common/utils.partial";

    const typeOptions: ListItemBag[] = [
        { text: "No Data", value: "noData" },
        { text: "No Items", value: "noItems" },
        { text: "No Results", value: "noResults" },
        { text: "No Access", value: "noAccess" },
        { text: "Unavailable", value: "unavailable" }
    ];

    const actionOptions: ListItemBag[] = [
        { text: "None (empty slot)", value: "none" },
        { text: "Slot: Clear Filters link button", value: "clearFilters" },
        { text: "Slot: Primary and secondary buttons", value: "primaryAndSecondary" },
        { text: "Slot: Add button with icon", value: "addButton" },
        { text: "Slot: Upload button with help text", value: "upload" }
    ];

    // The dropdowns emit plain strings, so these are typed as strings and narrowed below.
    const type = ref("noData");
    const title = ref("");
    const description = ref("");
    const iconCssClass = ref("");
    const isDescriptionHidden = ref(false);
    const actions = ref("none");
    const isBordered = ref(false);

    const onActionClick = (label: string): void => alert(`"${label}" clicked. Blocks are responsible for handling their own actions.`);

    const typeProp = computed(() => type.value as "noData" | "noItems" | "noResults" | "noAccess" | "unavailable");

    const slotExamples: Record<string, string> = {
        clearFilters: `<RockButton :btnType="BtnType.Link" @click="onClearFilters">Clear Filters</RockButton>`,
        primaryAndSecondary: `<RockButton :btnType="BtnType.Primary" @click="onNewCommunication">New Communication</RockButton>\n    <RockButton :btnType="BtnType.Default" @click="onViewTemplates">View Templates</RockButton>`,
        addButton: `<RockButton :btnType="BtnType.Default" @click="onAddGroup"><i class="ti ti-plus"></i> Add Group</RockButton>`,
        upload: `<RockButton :btnType="BtnType.Default" @click="onUploadImage"><i class="ti ti-upload"></i> Upload Image</RockButton>\n    <small class="text-muted">JPG, PNG or GIF up to 10 MB</small>`
    };

    const importCode = getSfcControlImportPath("emptyState");
    const exampleCode = computed((): string => {
        const attributes = [
            `type="${type.value}"`,
            title.value ? `title="${title.value}"` : "",
            isDescriptionHidden.value ? "description=\"\"" : description.value ? `description="${description.value}"` : "",
            iconCssClass.value ? `iconCssClass="${iconCssClass.value}"` : "",
            isBordered.value ? "isBordered" : ""
        ].filter(attribute => attribute !== "");

        const slotContent = slotExamples[actions.value];

        if (!slotContent) {
            return `<EmptyState ${attributes.join("\n            ")} />`;
        }

        return `<EmptyState ${attributes.join("\n            ")}>\n    ${slotContent}\n</EmptyState>`;
    });
</script>
