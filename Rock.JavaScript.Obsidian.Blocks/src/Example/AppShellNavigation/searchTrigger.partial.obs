<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="asn-group asn-search-group">
        <button type="button" class="asn-search-btn" aria-label="Search" @click="onOpen">
            <i class="ti ti-search asn-search-icon"></i>
            <span class="asn-label asn-search-text">Search...</span>
            <kbd class="asn-kbd asn-label">⌘K</kbd>
        </button>

        <!--
            Custom centered command-style dialog (Teleported to body) that mirrors
            app-shell's search dialog. The SmartSearch markup is kept intact so Rock's
            searchField.js control (typeahead, scope filter, result navigation)
            works exactly like the header Smart Search block: the input stays inside
            a .smartsearch ancestor alongside the data-key options, the hidden filter
            input, and the dropdown menu. Presentation lives in _app-shell.scss
            (".asn-search-dialog"); the scope selector is placed as a leading pill.

            The dialog is kept in the DOM and toggled with v-show (not v-if): the
            searchField control is initialized once against a stable input element,
            exactly like the always-mounted smartSearch.obs block. Recreating the
            input with v-if left the control bound to a detached element, so the
            hidden search-type input could not be read and the search API rejected
            the request as a Bad Request.
        -->
        <Teleport to="body">
            <Transition name="asn-dialog">
                <div v-show="isOpen" class="asn-search-overlay" @click.self="onClose">
                    <div class="asn-search-dialog" role="dialog" aria-modal="true" aria-label="Search">
                        <i class="ti ti-search asn-search-dialog-icon" aria-hidden="true"></i>

                        <div class="smartsearch searchinput">
                            <ul class="nav smartsearch-type">
                                <li class="dropdown">
                                    <a class="dropdown-toggle navbar-link" data-toggle="dropdown">
                                        <span>{{ defaultFilterLabel }}</span>
                                        <b class="ti ti-caret-down-filled"></b>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li v-for="(filter, index) in searchFilters"
                                            :key="filter.key ?? index"
                                            :data-key="filter.key"
                                            :data-target="filter.resultUrl">
                                            <a>{{ filter.label }}</a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                            <input type="search"
                                   ref="inputElement"
                                   :id="uniqueId"
                                   v-model="internalValue"
                                   class="searchinput tt-query"
                                   placeholder="Type to search..."
                                   autocomplete="off"
                                   spellcheck="false"
                                   dir="auto">
                            <input type="hidden"
                                   ref="hiddenFilterInput"
                                   :name="hiddenFilterId"
                                   :id="hiddenFilterId">
                        </div>

                        <button type="button" class="asn-search-dialog-close" aria-label="Close search" @click="onClose">
                            <i class="ti ti-x" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </Transition>
        </Teleport>
    </div>
</template>

<script setup lang="ts">
    // Resting-state styles (.asn-search-*) live globally in the theme's
    // _app-shell.scss so the server-rendered sidebar is styled before this
    // island mounts. See appShellNavigation.obs for the full rationale.
    import { computed, nextTick, onBeforeUnmount, ref, watch } from "vue";
    import { useHttp } from "@Obsidian/Utility/http";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { SearchFilterBag } from "@Obsidian/ViewModels/Blocks/Core/SmartSearch/searchFilterBag";

    // #region Values

    const http = useHttp();
    const isOpen = ref(false);
    const uniqueId = `rock-searchField-${newGuid()}`;
    const hiddenFilterId = `rock-searchFilter-${newGuid()}`;
    const internalValue = ref("");

    const inputElement = ref<HTMLInputElement | null>(null);
    const hiddenFilterInput = ref<HTMLInputElement | null>(null);

    const searchFilters = ref<SearchFilterBag[]>();
    let isControlInitialized = false;

    // #endregion Values

    // #region Computed Values

    const defaultFilterLabel = computed<string>(() => {
        if (!searchFilters.value || searchFilters.value.length === 0) {
            return "";
        }

        return searchFilters.value[0].label ?? "";
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onOpen(): void {
        isOpen.value = true;
    }

    function onClose(): void {
        isOpen.value = false;
    }

    function onKeyDown(event: KeyboardEvent): void {
        // Cmd/Ctrl+K opens the search dialog from anywhere.
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
            event.preventDefault();
            isOpen.value = true;
            return;
        }

        if (event.key === "Escape" && isOpen.value) {
            isOpen.value = false;
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /** Fetches the available search filters from the API. */
    async function fetchSearchFilters(): Promise<void> {
        const response = await http.post<SearchFilterBag[]>("/api/v2/Controls/SearchFieldGetSearchFilters");

        if (response.isSuccess && response.data) {
            searchFilters.value = response.data;
        }
        else {
            console.error("Error fetching search filters from server", response.errorMessage);
        }
    }

    /**
     * Initializes Rock's searchField control against the input once the DOM and
     * filters are ready. Runs a single time; the input element is stable (the
     * dialog is kept in the DOM via v-show), so the control stays valid across
     * open/close and the hidden search-type input can always be read.
     */
    function initializeControl(): void {
        if (isControlInitialized || !inputElement.value || !hiddenFilterInput.value || !searchFilters.value) {
            return;
        }

        if (searchFilters.value.length > 0) {
            hiddenFilterInput.value.value = searchFilters.value[0].key ?? "";
        }

        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const rock = window["Rock"] as any;
        if (rock?.controls?.searchField?.initialize) {
            rock.controls.searchField.initialize({ controlId: uniqueId });
            isControlInitialized = true;
        }
    }

    // #endregion Functions

    // #region Watchers

    // Initialize the control as soon as the input, hidden input, and filters are all
    // available (mirrors smartSearch.obs). With v-show the elements exist from mount.
    watch([inputElement, hiddenFilterInput, searchFilters], () => {
        initializeControl();
    });

    // Focus the input each time the dialog opens.
    watch(isOpen, async (open) => {
        if (!open) {
            return;
        }

        await nextTick();
        inputElement.value?.focus();
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    fetchSearchFilters();

    document.addEventListener("keydown", onKeyDown);

    onBeforeUnmount(() => {
        document.removeEventListener("keydown", onKeyDown);
    });

    // #endregion Lifecycle Hooks
</script>
