    background-color: var(--accent);
}
</style>

<script setup lang="ts">
    import { computed, onBeforeUnmount, ref, watch } from "vue";
    import { useFloating, autoUpdate, offset, flip, shift } from "@Obsidian/Libs/floating-ui";
    import { notifications } from "./data.partial";

    // #region Values

    const isOpen = ref(false);
    const triggerRef = ref<HTMLElement | null>(null);
    const floatingRef = ref<HTMLElement | null>(null);

    // Local copy so "mark all read" can flip the unread flags.
    const items = ref(notifications.map((notification) => ({ ...notification })));

    const { floatingStyles } = useFloating(triggerRef, floatingRef, {
        placement: "bottom-end",
        strategy: "fixed",
        whileElementsMounted: autoUpdate,
        middleware: [offset(8), flip(), shift({ padding: 8 })]
    });

    // #endregion Values

    // #region Computed Values

    const unreadCount = computed((): number => items.value.filter((item) => item.isUnread).length);

    // #endregion Computed Values

    // #region Event Handlers

    function onToggle(): void {
        isOpen.value = !isOpen.value;
    }

    function onMarkAllRead(): void {
        items.value = items.value.map((item) => ({ ...item, isUnread: false }));
    }

    function onDocumentPointerDown(event: PointerEvent): void {
        const target = event.target as Node;
        if (triggerRef.value?.contains(target) || floatingRef.value?.contains(target)) {
            return;
        }

        isOpen.value = false;
    }

    function onKeyDown(event: KeyboardEvent): void {
        if (event.key === "Escape") {
            isOpen.value = false;
        }
    }

    // #endregion Event Handlers

    // #region Watchers

    watch(isOpen, (open) => {
        if (open) {
            document.addEventListener("pointerdown", onDocumentPointerDown, true);
            document.addEventListener("keydown", onKeyDown);
        }
        else {
            document.removeEventListener("pointerdown", onDocumentPointerDown, true);
            document.removeEventListener("keydown", onKeyDown);
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onBeforeUnmount(() => {
        document.removeEventListener("pointerdown", onDocumentPointerDown, true);
        document.removeEventListener("keydown", onKeyDown);
    });

    // #endregion Lifecycle Hooks
</script>
