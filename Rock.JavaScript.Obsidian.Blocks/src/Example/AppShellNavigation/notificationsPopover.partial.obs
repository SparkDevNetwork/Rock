<template>
    <div class="np-root">
        <button ref="triggerRef" type="button" class="np-bell" aria-label="Notifications" @click="onToggle">
            <i class="ti ti-bell"></i>
            <span v-if="unreadCount > 0" class="np-dot" aria-hidden="true"></span>
        </button>

        <div v-if="isOpen" ref="floatingRef" class="np-panel" :style="floatingStyles">
            <div class="np-header">
                <div class="np-header-title">
                    Notifications
                    <span v-if="unreadCount > 0" class="np-count">{{ unreadCount }}</span>
                </div>
                <button type="button" class="np-mark" title="Mark all as read" @click="onMarkAllRead">
                    <i class="ti ti-checks"></i>
                </button>
            </div>

            <div class="np-list">
                <div v-for="item in items"
                     :key="item.id"
                     class="np-item"
                     :class="{ 'is-unread': item.isUnread }">
                    <span class="np-icon" :class="`variant-${item.variant}`">
                        <i :class="item.iconClass"></i>
                    </span>

                    <div class="np-item-body">
                        <div class="np-item-titlerow">
                            <span class="np-item-title">{{ item.title }}</span>
                            <span v-if="item.badge" class="np-item-badge">{{ item.badge }}</span>
                            <span v-if="item.isUnread" class="np-unread-dot" aria-hidden="true"></span>
                        </div>
                        <p v-if="item.body" class="np-item-text">{{ item.body }}</p>

                        <div v-if="item.meta || item.actions" class="np-item-extra">
                            <span v-if="item.meta" class="np-meta">
                                <span class="np-meta-label">{{ item.meta.label }}</span>
                                <span class="np-meta-value">{{ item.meta.value }}</span>
                            </span>
                            <span v-if="item.actions" class="np-actions">
                                <button v-for="action in item.actions"
                                        :key="action.label"
                                        type="button"
                                        class="app-shell-btn-mini"
                                        :class="action.variant">{{ action.label }}</button>
                            </span>
                        </div>

                        <span class="np-time">{{ item.time }}</span>
                    </div>
                </div>
            </div>

            <div class="np-footer">
                <button type="button" class="np-viewall">View all notifications</button>
            </div>
        </div>
    </div>
</template>

