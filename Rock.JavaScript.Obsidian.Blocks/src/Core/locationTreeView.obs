<template>
    <div class="location-tree-view rock-tree-view">
        <NotificationBox v-if="errorMessage" alertType="danger" class="mb-0">{{ errorMessage }}</NotificationBox>
        <Panel :title="panelTitle || 'Locations'"
               type="block"
               hasNoBodyPadding
               :isCollapsible="false"
               :isInitiallyCollapsed="false">
            <template #headerActions>
                <DropDownMenu v-if="isAddLocationVisible"
                              :items="addLocationActions"
                              align="right"
                              anchorButtonCssClass="btn-panel-action btn-add"
                              :isAnchorButtonOverflow="false">
                    <i class="ti ti-plus"></i>
                </DropDownMenu>
            </template>

            <div class="rock-tree-view-tree">
                <TreeList v-model="selectedKeys"
                          :provider="itemProvider"
                          :initiallyExpanded="initiallyExpanded"
                          :selectFirstByDefault="false"
                          autoExpand
                          @update:modelValue="onSelect"
                          @treeitem-expanded="onExpand"
                          @treeitem-collapsed="onCollapse" />
            </div>
        </Panel>
    </div>
</template>

<script setup lang="ts">
    import { computed, ref } from "vue";
    import DropDownMenu from "@Obsidian/Controls/dropDownMenu.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import TreeList from "@Obsidian/Controls/treeList.obs";
    import { Guid } from "@Obsidian/Types";
    import { MenuAction } from "@Obsidian/Types/Controls/dropDownMenu";
    import { emptyGuid } from "@Obsidian/Utility/guid";
    import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, useReloadBlock, useSecurityGrantToken } from "@Obsidian/Utility/block";
    import { LocationTreeItemProvider } from "@Obsidian/Utility/treeItemProviders";
    import { TreeItemBag } from "@Obsidian/ViewModels/Utility/treeItemBag";
    import { CustomBlockBox } from "@Obsidian/ViewModels/Blocks/customBlockBox";
    import { LocationTreeViewBag } from "@Obsidian/ViewModels/Blocks/Core/LocationTreeView/locationTreeViewBag";
    import { LocationTreeViewOptionsBag } from "@Obsidian/ViewModels/Blocks/Core/LocationTreeView/locationTreeViewOptionsBag";
    import { LocationTreeViewBlockAttributesBag } from "@Obsidian/ViewModels/Blocks/Core/LocationTreeView/locationTreeViewBlockAttributesBag";

    // #region Values

    const box = useConfigurationValues<CustomBlockBox<LocationTreeViewBag, LocationTreeViewOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();
    const securityGrantToken = useSecurityGrantToken();
    const reloadBlock = useReloadBlock();

    const bag: LocationTreeViewBag = box.bag ?? {
        isAddLocationVisible: false,
        isAddRootEnabled: false,
        isAddChildEnabled: false
    };
    const blockProperties: LocationTreeViewBlockAttributesBag = box.options?.blockProperties ?? {};

    // Auto-select the first location by navigating immediately when the server supplied a URL.
    if (bag.autoSelectUrl) {
        window.location.href = bag.autoSelectUrl;
    }

    const panelTitle = blockProperties.panelTitle ?? "";
    // Reactive so navigation failures can surface without replacing the tree.
    const errorMessage = ref(bag.errorMessage ?? "");

    const isAddLocationVisible = bag.isAddLocationVisible === true;
    const isAddRootEnabled = bag.isAddRootEnabled === true;

    const selectedKeys = ref<string[]>(bag.selectedLocationGuids ?? []);
    const initiallyExpanded = ref<string[]>(bag.expandedLocationGuids ?? []);
    const expandedKeys = ref<string[]>([...(bag.expandedLocationGuids ?? [])]);

    const itemProvider = buildProvider();

    // #endregion Values

    // #region Computed Values

    const addLocationActions = computed<MenuAction[]>(() => [
        {
            title: "Add Top-Level",
            type: "default",
            handler: onAddRoot,
            disabled: !isAddRootEnabled
        },
        {
            title: "Add Child To Selected",
            type: "default",
            handler: onAddChild,
            disabled: selectedKeys.value.length !== 1 || bag.isAddChildEnabled !== true
        }
    ]);

    // #endregion Computed Values

    // #region Event Handlers

    /** Navigates to the selected location (Detail Page, or current page when none is configured). */
    function onSelect(values: string[]): void {
        const selectedGuid = values.length > 0 ? values[0] : null;
        if (!selectedGuid) {
            return;
        }

        // Ignore re-selecting the same location (e.g. deep-link restore on load).
        const currentSelected = bag.selectedLocationGuids?.[0] ?? null;
        if (currentSelected && selectedGuid.toLowerCase() === currentSelected.toLowerCase()) {
            return;
        }

        navigateToNode(selectedGuid as Guid, emptyGuid);
    }

    /** Tracks an expanded node so navigate URLs can restore the open state. */
    function onExpand(item: TreeItemBag): void {
        if (item.value && !expandedKeys.value.includes(item.value)) {
            expandedKeys.value = [...expandedKeys.value, item.value];
        }
    }

    /** Stops tracking a collapsed node. */
    function onCollapse(item: TreeItemBag): void {
        if (item.value) {
            expandedKeys.value = expandedKeys.value.filter(v => v !== item.value);
        }
    }

    /** Adds a top-level location by navigating to the Detail Page with a new-location parameter. */
    function onAddRoot(): void {
        navigateToNode(emptyGuid, emptyGuid);
    }

    /** Adds a child of the selected location. */
    function onAddChild(): void {
        navigateToNode(emptyGuid, (selectedKeys.value[0] as Guid) ?? emptyGuid);
    }

    // #endregion Event Handlers

    // #region Functions

    /** Configures a location item provider from the block's settings. */
    function buildProvider(): LocationTreeItemProvider {
        const provider = new LocationTreeItemProvider();
        provider.securityGrantToken = securityGrantToken.value;
        // WebForms used /api/Locations/getchildren (all named locations, including inactive).
        // The v2 endpoint filters inactive by default; opt in to inactive to preserve parity.
        provider.includeInactive = true;
        return provider;
    }

    /** Asks the server for the node's Detail Page URL (or add-action URL) and navigates there. */
    async function navigateToNode(nodeGuid: Guid, parentGuid: Guid): Promise<void> {
        errorMessage.value = "";

        const result = await invokeBlockAction<string>("GetNavigationUrl", {
            locationGuid: nodeGuid,
            parentGuid,
            expandedGuids: expandedKeys.value
        });

        if (result.isSuccess && result.data) {
            window.location.href = result.data;
            return;
        }

        errorMessage.value = result.errorMessage
            || "Could not determine the navigation URL for the selected location.";
    }

    // #endregion Functions

    // #region Lifecycle Hooks

    // Reload the block when its settings change so the new configuration takes effect.
    onConfigurationValuesChanged(reloadBlock);

    // #endregion Lifecycle Hooks
</script>
