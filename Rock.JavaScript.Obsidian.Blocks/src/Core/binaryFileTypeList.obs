<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Grid :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="idKey"
          itemTerm="File Types"
          :entityTypeGuid="EntityType.BinaryFileType"
          stickyHeader
          liveUpdates
          :onAddItem="config.isAddEnabled ? onAddItem : undefined"
          @selectItem="onSelectItem">
        <HighlightDetailColumn name="name"
                               title="Name"
                               field="name"
                               :filter="textValueFilter"
                               :filterValuex="textValueFilter"
                               :quickFilterValuex="textValueFilter"
                               visiblePriority="xs"
                               width="35%"
                               :hideOnScreen="false">
            <template #detailFormat="{ row }">
                {{ row.name }}
                <template v-if="row.desciption != row.name">{{ row.description }}</template>
            </template>
        </HighlightDetailColumn>

        <TextColumn name="storageEntityType"
                    title="Storage Type"
                    field="storageEntityType"
                    :filter="pickExistingValueFilter"
                    visiblePriority="xs" />

        <NumberColumn name="fileCount"
                      title="File Count"
                      field="fileCount"
                      :filter="numberValueFilter"
                      visiblePriority="lg" />


        <BooleanColumn name="isSystem"
                       title="System"
                       field="isSystem"
                       width="1%"
                       visiblePriority="lg" />

        <BooleanColumn name="cacheToServerFileSystem"
                       title="Cache To Server"
                       field="cacheToServerFileSystem"
                       visiblePriority="lg" />

        <BooleanColumn name="requiresViewSecurity"
                       title="Requires View Security"
                       field="requiresViewSecurity"
                       visiblePriority="xs" />

        <TextColumn name="isPublicViewable"
                    title="Status"
                    field="isPublicViewable"
                    :filter="pickExistingValueFilter"
                    :quickFilterValue="getLabelTextValue"
                    :sortValue="getLabelTextValue"
                    width="160px"
                    visiblePriority="xs">

            <template #format="{ row }">
                <div>
                    <HighlightLabel v-if="row.isPublicViewable"
                                    labelType="warning"
                                    iconCssClass="ti ti-lock-open">
                        Public Viewable
                    </HighlightLabel>
                </div>
            </template>
        </TextColumn>
        <AttributeColumns :attributes="config.gridDefinition?.attributeFields ?? []" />

        <SecurityColumn :itemTitle="'name'" />

        <DeleteColumn v-if="config.isDeleteEnabled" @click="onDeleteClick" />
    </Grid>
</template>

<script setup lang="ts">
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import Grid, { AttributeColumns, HighlightDetailColumn, BooleanColumn, TextColumn, textValueFilter, pickExistingValueFilter, DeleteColumn, SecurityColumn, SelectColumn, numberValueFilter, NumberColumn, Column } from "@Obsidian/Controls/grid";
    import HighlightLabel from "@Obsidian/Controls/highlightLabel.obs";
    import { alert } from "@Obsidian/Utility/dialogs";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { BinaryFileTypeListOptionsBag } from "@Obsidian/ViewModels/Blocks/Core/BinaryFileTypeList/binaryFileTypeListOptionsBag";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { NavigationUrlKey } from "./BinaryFileTypeList/types.partial";
    import { reactive, ref } from "vue";

    const config = useConfigurationValues<ListBlockBox<BinaryFileTypeListOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const gridDataSource = ref<Promise<GridDataBag>>();
    let gridData: GridDataBag | undefined;

    // #endregion

    // #region Functions

    /**
     * Called when the grid is requesting the row data be loaded.
     */
    async function loadGridData(): Promise<GridDataBag> {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (result.isSuccess && result.data) {
            gridData = reactive(result.data);
            return gridData;
        }
        else {
            throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
        }
    }

    /**
     * Called when the grid is requesting the row data be loaded.
     */
    function getLabelTextValue(row: Record<string, unknown>): string {
        const booleanValue = row["isPublicViewable"];

        if (booleanValue) {
            return "Public Viewable";
        }
        else {
            return "";
        }
    }

    // #endregion

    // #region Event Handlers

    /**
     * Called when a row has been selected by the individual.
     *
     * @param key The key of the row that was selected.
     */
    function onSelectItem(key: string): void {
        if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
            window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", key);
        }
    }

    /**
     * Called when a row's delete button has been clicked by the individual. This
     * happens only if they have confirmed the delete action.
     */
    async function onDeleteClick(key: string): Promise<void> {
        const result = await invokeBlockAction<string>("Delete", {
            key
        });

        if (result.isSuccess) {
            if (gridData && gridData.rows) {
                const index = gridData.rows.findIndex(r => r["idKey"] === key);

                if (index !== -1) {
                    gridData.rows?.splice(index, 1);
                }
            }
        }
        else {
            await alert(result.errorMessage ?? "Unknown error while trying to delete binary file type.");
        }
    }

    /**
     * Called when the Add button has been clicked by the indivual.
     */
    function onAddItem(): void {
        if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
            window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", "0");
        }
    }

    // #endregion

    gridDataSource.value = loadGridData();
</script>
