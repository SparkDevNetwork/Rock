<template>
    <NotificationBox v-if="errorMessage" alertType="danger">{{ errorMessage }}</NotificationBox>
    <div v-else class="category-tree-view rock-tree-view">
        <Panel v-if="panelTitle || !isEntityTypeConfigured"
               :title="panelTitle || 'Categories'"
               :isDrawerOpen="showSearch || showConfig"
               type="block"
               :hasNoBodyPadding="isEntityTypeConfigured"
               :isCollapsible="false"
               :isInitiallyCollapsed="false">
            <template #headerActions>
                <button v-if="canEdit && showEntityAdd"
                        type="button"
                        class="btn btn-panel-action btn-add"
                        :title="addEntityTitle"
                        :disabled="selectedKeys.length !== 1"
                        @click="onAddEntity">
                    <i class="ti ti-plus"></i>
                </button>
                <DropDownMenu v-if="canEdit"
                              title="Add Category"
                              :items="addCategoryActions"
                              align="right"
                              anchorButtonCssClass="btn-panel-action"
                              :isAnchorButtonOverflow="false">
                    <i class="ti ti-folder-plus"></i>
                </DropDownMenu>
                <button v-if="isSearchVisible"
                        type="button"
                        class="btn btn-panel-action"
                        title="Search"
                        @click="onToggleSearch">
                    <i class="ti ti-search"></i>
                </button>
                <button v-if="isActiveFilterVisible"
                        type="button"
                        class="btn btn-panel-action"
                        title="Options"
                        @click="onToggleConfig">
                    <i class="ti ti-dots-vertical"></i>
                </button>
            </template>

            <template v-if="isSearchVisible || isActiveFilterVisible" #drawer>
                <div v-if="showSearch" class="category-tree-view-search input-group input-group-sm">
                    <input v-model="searchTerm"
                           type="text"
                           class="form-control"
                           placeholder="Quick Find"
                           @keyup.enter="onSearch" />
                    <span class="input-group-btn">
                        <button type="button" class="btn btn-default" title="Search" @click="onSearch">
                            <i class="ti ti-search"></i>
                        </button>
                    </span>
                </div>
                <Toggle v-else-if="showConfig" v-model="showActiveOnly" label="Show" trueText="Active" falseText="All" btnSize="xs" />
            </template>

            <!-- An empty toggle slot suppresses the Panel's default chevron pull so the header
                 Search and Options buttons are the only affordances that open the drawer. -->
            <template v-if="isSearchVisible || isActiveFilterVisible" #drawerToggle>
                <span class="d-none"></span>
            </template>

            <NotificationBox v-if="!isEntityTypeConfigured" alertType="warning">Please select an entity type in the block settings.</NotificationBox>
            <div v-else class="rock-tree-view-tree">
                <TreeList v-model="selectedKeys"
                          :provider="itemProvider"
                          :initiallyExpanded="initiallyExpanded"
                          :selectFirstByDefault="selectFirstByDefault"
                          autoExpand
                          @update:modelValue="onSelect"
                          @treeitem-expanded="onExpand"
                          @treeitem-collapsed="onCollapse" />
            </div>
        </Panel>
        <TreeList v-else
                  v-model="selectedKeys"
                  :provider="itemProvider"
                  :initiallyExpanded="initiallyExpanded"
                  :selectFirstByDefault="selectFirstByDefault"
                  autoExpand
                  @update:modelValue="onSelect"
                  @treeitem-expanded="onExpand"
                  @treeitem-collapsed="onCollapse" />
    </div>
</template>

<script setup lang="ts">
    import { computed, ref, watch } from "vue";
    import DropDownMenu from "@Obsidian/Controls/dropDownMenu.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import Toggle from "@Obsidian/Controls/toggle.obs";
    import TreeList from "@Obsidian/Controls/treeList.obs";
    import { Guid } from "@Obsidian/Types";
    import { MenuAction } from "@Obsidian/Types/Controls/dropDownMenu";
    import { emptyGuid } from "@Obsidian/Utility/guid";
    import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, useReloadBlock, useSecurityGrantToken } from "@Obsidian/Utility/block";
    import { CategoryTreeItemProvider } from "@Obsidian/Utility/treeItemProviders";
    import { TreeItemBag } from "@Obsidian/ViewModels/Utility/treeItemBag";
    import { CustomBlockBox } from "@Obsidian/ViewModels/Blocks/customBlockBox";
    import { CategoryTreeViewBag } from "@Obsidian/ViewModels/Blocks/Core/CategoryTreeView/categoryTreeViewBag";
    import { CategoryTreeViewOptionsBag } from "@Obsidian/ViewModels/Blocks/Core/CategoryTreeView/categoryTreeViewOptionsBag";
    import { CategoryTreeViewBlockAttributesBag } from "@Obsidian/ViewModels/Blocks/Core/CategoryTreeView/categoryTreeViewBlockAttributesBag";

    // #region Values

    const box = useConfigurationValues<CustomBlockBox<CategoryTreeViewBag, CategoryTreeViewOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();
    const securityGrantToken = useSecurityGrantToken();
    const reloadBlock = useReloadBlock();

    const bag: CategoryTreeViewBag = box.bag ?? {
        canEdit: false,
        hideInactiveItems: false,
        isActiveFilterVisible: false
    };
    const blockProperties: CategoryTreeViewBlockAttributesBag = box.options?.blockProperties ?? {
        showOnlyCategories: true,
        showUnnamedEntityItems: false
    };

    // The search button navigates here; the button is hidden when it is not configured.
    const searchResultsPageUrl = box.navigationUrls?.["SearchResultsPage"] ?? "";
    const isSearchVisible = searchResultsPageUrl.length > 0;

    const panelTitle = blockProperties.panelTitle;
    const errorMessage = bag.errorMessage ?? "";

    // Without a configured Entity Type the tree has no categories to resolve, so the block
    // shows setup guidance in place of an empty tree.
    const isEntityTypeConfigured = !!blockProperties.entityTypeGuid;

    // The add affordances are shown only to people with EDIT on the block.
    const canEdit = bag.canEdit === true;

    // The active/inactive filter is shown only for entity types that track an active flag.
    const isActiveFilterVisible = bag.isActiveFilterVisible === true;

    // The add-entity affordance shows when the tree includes categorized entities; selecting it
    // navigates to the Detail Page to add one.
    const showEntityAdd = blockProperties.showOnlyCategories === false;
    const addEntityTitle = `Add ${blockProperties.entityTypeFriendlyName || "Item"}`;

    const showSearch = ref(false);
    const showConfig = ref(false);
    const searchTerm = ref("");

    // Inactive items are shown unless the person's saved preference hides them, matching the
    // WebForms default of showing all items.
    const showInactiveItems = ref(bag.hideInactiveItems !== true);

    const selectedKeys = ref<string[]>(bag.selectedCategoryGuids ?? []);
    const initiallyExpanded = ref<string[]>(bag.expandedCategoryGuids ?? []);
    const expandedKeys = ref<string[]>([...( bag.expandedCategoryGuids ?? [] )]);

    // The tree never auto-navigates on load; a category is selected only by an explicit click or a
    // deep link. This matches the WebForms block, which did not jump to the first category.
    const selectFirstByDefault = false;
    const itemProvider = ref(buildProvider());

    // #endregion Values

    // #region Computed Values

    // showInactiveItems is the source of truth for the filter; this exposes its inverse so the
    // two-state control reads as Active / All.
    const showActiveOnly = computed<boolean>({
        get: () => !showInactiveItems.value,
        set: (value) => {
            showInactiveItems.value = !value;
        }
    });

    const addCategoryActions = computed<MenuAction[]>(() => [
        {
            title: "Add Top-Level",
            type: "default",
            handler: onAddCategory
        },
        {
            title: "Add Child To Selected",
            type: "default",
            handler: onAddSubCategory,
            disabled: selectedKeys.value.length !== 1
        }
    ]);

    // #endregion Computed Values

    // #region Event Handlers

    /** Navigates to the selected node (the Detail Page, or the current page when none is configured). */
    function onSelect(values: string[]): void {
        const selectedGuid = values.length > 0 ? values[0] : null;
        navigateToNode((selectedGuid as Guid) ?? emptyGuid, emptyGuid);
    }

    /** Tracks an expanded node so navigate URLs can restore the open state. */
    function onExpand(item: TreeItemBag): void {
        if (item.value && !expandedKeys.value.includes(item.value)) {
            expandedKeys.value = [...expandedKeys.value, item.value];
        }
    }

    /** Stops tracking a collapsed node. */
    function onCollapse(item: TreeItemBag): void {
        if (item.value) {
            expandedKeys.value = expandedKeys.value.filter(v => v !== item.value);
        }
    }

    /** Adds a top-level category by navigating to the Detail Page with a new-category parameter. */
    function onAddCategory(): void {
        navigateToNode(emptyGuid, emptyGuid);
    }

    /** Adds a child of the selected category by navigating to the Detail Page with the parent. */
    function onAddSubCategory(): void {
        navigateToNode(emptyGuid, (selectedKeys.value[0] as Guid) ?? emptyGuid);
    }

    /** Adds a new entity parented to the selected node's category. */
    async function onAddEntity(): Promise<void> {
        const result = await invokeBlockAction<string>("GetAddEntityUrl", {
            selectedGuid: (selectedKeys.value[0] as Guid) ?? emptyGuid
        });

        if (result.isSuccess && result.data) {
            window.location.href = result.data;
        }
    }

    /** Opens the search in the panel drawer, closing the filter drawer if it was open. */
    function onToggleSearch(): void {
        showSearch.value = !showSearch.value;
        if (showSearch.value) {
            showConfig.value = false;
        }
    }

    /** Opens the active/inactive filter in the panel drawer, closing search if it was open. */
    function onToggleConfig(): void {
        showConfig.value = !showConfig.value;
        if (showConfig.value) {
            showSearch.value = false;
        }
    }

    /** Navigates to the Search Results Page with the entered term. */
    function onSearch(): void {
        const term = searchTerm.value.trim();
        if (!searchResultsPageUrl || term.length === 0) {
            return;
        }

        const separator = searchResultsPageUrl.includes("?") ? "&" : "?";
        window.location.href = `${searchResultsPageUrl}${separator}SearchType=name&SearchTerm=${encodeURIComponent(term)}`;
    }

    // #endregion Event Handlers

    // #region Functions

    /** Configures a category item provider from the block's settings and the active filter. */
    function buildProvider(): CategoryTreeItemProvider {
        const provider = new CategoryTreeItemProvider();
        provider.entityTypeGuid = blockProperties.entityTypeGuid ?? undefined;
        provider.rootCategoryGuid = blockProperties.rootCategoryGuid ?? undefined;
        provider.entityTypeQualifierColumn = blockProperties.entityTypeQualifierColumn ?? undefined;
        provider.entityTypeQualifierValue = blockProperties.entityTypeQualifierValue ?? undefined;
        provider.securityGrantToken = securityGrantToken.value;
        provider.getCategorizedItems = blockProperties.showOnlyCategories === false;
        provider.includeUnnamedEntityItems = blockProperties.showUnnamedEntityItems === true;
        provider.includeInactiveItems = showInactiveItems.value;
        provider.excludedCategoryGuids = blockProperties.excludeCategoryGuids ?? undefined;
        provider.defaultIconCssClass = blockProperties.defaultIconCssClass ?? undefined;
        return provider;
    }

    /** Asks the server for the node's Detail Page URL (or add-action URL) and navigates there. */
    async function navigateToNode(nodeGuid: Guid, parentGuid: Guid): Promise<void> {
        const result = await invokeBlockAction<string>("GetNavigationUrl", {
            categoryGuid: nodeGuid,
            parentGuid,
            expandedGuids: expandedKeys.value
        });

        if (result.isSuccess && result.data) {
            window.location.href = result.data;
        }
    }

    /** Persists the active/inactive preference and re-fetches the tree with the new filter. */
    async function onHideInactiveChanged(): Promise<void> {
        await invokeBlockAction("SetHideInactiveItems", { hideInactiveItems: !showInactiveItems.value });
        itemProvider.value = buildProvider();
    }

    // #endregion Functions

    // #region Watchers

    watch(showInactiveItems, () => {
        onHideInactiveChanged();
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    // Reload the block when its settings change so the new configuration takes effect.
    onConfigurationValuesChanged(reloadBlock);

    // #endregion Lifecycle Hooks
</script>
