<template>
    <NotificationBox v-if="config.errorMessage" alertType="warning">
        {{ config.errorMessage }}
    </NotificationBox>


    <Grid v-else-if="config.options?.hasContextEntity"
          :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="idKey"
          itemTerm="Change"
          :title="config.options?.panelTitle ?? 'History Log'"
          :exportTitle="config.options?.exportFileName ?? 'History Log'"
          :entityTypeGuid="EntityType.History"
          :showMergeTemplate="false"
          :showLaunchWorkflow="false"
          stickyHeader
          liveUpdates
          gridSettings
          :gridSettingsActive="hasSettingsFilters"
          @gridSettingsClick="isGridSettingsVisible = true">

        <template #gridHeaderBadges>
            <HighlightLabel labelType="info" class="mr-3">
                {{ config.options.createdDateText }}
            </HighlightLabel>
        </template>

        <TextColumn v-if="config.options?.isCategoryColumnVisible"
                    name="categoryName"
                    title="Category"
                    field="categoryName"
                    :filter="pickExistingValueFilter"
                    visiblePriority="xs" />

        <PersonColumn name="createdByPerson"
                      title="Who"
                      field="createdByPerson"
                      :hideAvatar="true"
                      :showAsLink="true"
                      visiblePriority="xs" />

        <Column name="historyList"
                title="Did"
                field="historyList"
                :filter="textValueFilter"
                :filterValue="getHistorySummaryText"
                :quickFilterValue="getHistorySummaryText"
                :sortValue="getHistorySummarySortValue"
                :exportValue="getHistorySummaryText"
                itemClass="wrap-text"
                visiblePriority="xs"
                width="45%">
            <template #format="{ row }">
                <div class="history-summary-list">
                    <div
                         v-for="(item, index) in getHistorySummaryItems(row)"
                         :key="index"
                         v-html="item"
                         class="history-summary-line" />
                </div>
            </template>

            <template #skeleton>
                <div class="skeleton skeleton-text skeleton-rounded" />
            </template>
        </Column>

        <Column name="formattedCaption"
                title="What"
                field="formattedCaption"
                :filter="textValueFilter"
                :filterValue="getCaptionText"
                :quickFilterValue="getCaptionText"
                :sortValue="getCaptionText"
                itemClass="wrap-text"
                visiblePriority="xs"
                width="20%">
            <template #format="{ row }">
                <span v-html="row.formattedCaption as string"></span>
            </template>

            <template #skeleton>
                <div class="skeleton skeleton-text skeleton-rounded" />
            </template>
        </Column>

        <DateTimeColumn name="createdDateTime"
                        title="When"
                        field="createdDateTime"
                        :filter="dateValueFilter"
                        :quickFilterValue="getElapsedFilterValue"
                        headerClass="title-right"
                        itemClass="justify-content-end text-right"
                        visiblePriority="xs"
                        :tooltip="getFormattedDateTime"
                        width="10%">
            <template #format="{ row }">
                <span>{{ getElapsed(row.createdDateTime as string) }}</span>
            </template>
        </DateTimeColumn>
    </Grid>

    <GridSettingsModal v-model="gridSettings"
                       v-model:visible="isGridSettingsVisible"
                       :showCategoryFilter="isCategoryFilterVisible" />
</template>

<style>
.title-right .grid-column-title {
    text-align: right;
}

.wrap-text {
    line-break: anywhere;
}

.history-summary-line {
    display: block;
}
</style>

<script setup lang="ts">
    import { computed, reactive, ref, watch } from "vue";
    import GridSettingsModal from "./HistoryLog/gridSettingsModal.partial.obs";
    import HighlightLabel from "@Obsidian/Controls/highlightLabel.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, usePersonPreferences, useReloadBlock } from "@Obsidian/Utility/block";
    import { safeParseJson } from "@Obsidian/Utility/stringUtils";
    import { RockDateTime } from "@Obsidian/Utility/rockDateTime";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import Grid, { Column, DateTimeColumn, dateValueFilter, PersonColumn, pickExistingValueFilter, TextColumn, textValueFilter } from "@Obsidian/Controls/grid";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { HistoryLogOptionsBag } from "@Obsidian/ViewModels/Blocks/Core/HistoryLog/historyLogOptionsBag";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { GridSettingsOptions, PreferenceKey } from "./HistoryLog/types.partial";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { formatAspDate } from "@Obsidian/Utility/aspDateFormat";

    const config = useConfigurationValues<ListBlockBox<HistoryLogOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();
    const preferences = usePersonPreferences().blockPreferences;

    onConfigurationValuesChanged(useReloadBlock());

    // #region Values

    const isGridSettingsVisible = ref(false);
    const isCategoryFilterVisible = computed((): boolean => config.options?.isCategoryFilterVisible ?? false);
    const gridDataSource = ref<Promise<GridDataBag>>();
    let gridData: GridDataBag | undefined;

    const gridSettings = ref<GridSettingsOptions>({
        category: safeParseJson<ListItemBag>(preferences.getValue(PreferenceKey.FilterCategory)),
        dateRangeLowerValue: preferences.getValue(PreferenceKey.FilterDateRangeLowerValue),
        dateRangeUpperValue: preferences.getValue(PreferenceKey.FilterDateRangeUpperValue)
    });

    // #endregion Values

    // #region Computed Values

    /** `true` if the grid settings are performing any filtering. */
    const hasSettingsFilters = computed((): boolean => {
        return (isCategoryFilterVisible.value && !!gridSettings.value.category?.value)
            || !!gridSettings.value.dateRangeLowerValue
            || !!gridSettings.value.dateRangeUpperValue;
    });

    // #endregion Computed Values

    // #region Functions

    /**
     * Called when the grid is requesting the row data be loaded.
     */
    async function loadGridData(): Promise<GridDataBag> {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (result.isSuccess && result.data) {
            gridData = reactive(result.data);
            return gridData;
        }
        else {
            throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
        }
    }

    /**
     * Gets the HTML summary items for the Did column.
     *
     * @param row The row being formatted.
     */
    function getHistorySummaryItems(row: Record<string, unknown>): string[] {
        return Array.isArray(row.historyList) ? row.historyList as string[] : [];
    }

    /**
     * Gets the plain-text summary value used for filtering and quick filtering.
     *
     * @param row The row being evaluated.
     */
    function getHistorySummaryText(row: Record<string, unknown>): string {
        return row.historySummaryText as string ?? "";
    }

    /**
     * Gets the plain-text summary value used for sorting the Did column.
     *
     * @param row The row being evaluated.
     */
    function getHistorySummarySortValue(row: Record<string, unknown>): string {
        return row.historySummarySortValue as string ?? "";
    }

    /**
     * Gets the plain-text caption for filtering and sorting the What column.
     *
     * @param row The row being evaluated.
     */
    function getCaptionText(row: Record<string, unknown>): string {
        return row.captionText as string ?? "";
    }

    /**
     * Gets the elapsed time text for the supplied date.
     *
     * @param value The ISO date string.
     */
    function getElapsed(value: string): string {
        return RockDateTime.parseISO(value)?.localDateTime.toElapsedString() ?? "";
    }

    /**
     * Gets a formatted date time from the provided date time string.
     *
     * @param dateTimeString The date time string to format.
     */
    function getFormattedDateTime(row: Record<string, unknown>): string {
        const rockDateTime = RockDateTime.parseISO(row.createdDateTime as string);
        if (!rockDateTime) {
            return "";
        }

        return formatAspDate(rockDateTime, "g");
    }

    /**
     * Gets the elapsed text for quick filtering the When column.
     *
     * @param row The row being evaluated.
     */
    function getElapsedFilterValue(row: Record<string, unknown>): string {
        return getElapsed(row.createdDateTime as string);
    }

    // #endregion Functions

    watch(gridSettings, async () => {
        preferences.setValue(PreferenceKey.FilterCategory, gridSettings.value.category ? JSON.stringify(gridSettings.value.category) : "");
        preferences.setValue(PreferenceKey.FilterDateRangeLowerValue, gridSettings.value.dateRangeLowerValue ?? "");
        preferences.setValue(PreferenceKey.FilterDateRangeUpperValue, gridSettings.value.dateRangeUpperValue ?? "");

        await preferences.save();

        gridDataSource.value = loadGridData();
    });

    if (config.options?.hasContextEntity) {
        gridDataSource.value = loadGridData();
    }
</script>
