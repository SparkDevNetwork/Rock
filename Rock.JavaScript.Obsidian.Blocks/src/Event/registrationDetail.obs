<template>
    <NotificationBox v-if="blockError" alertType="warning">{{ blockError }}</NotificationBox>

    <NotificationBox v-if="errorMessage" ref="errorMessageElement" alertType="danger">{{ errorMessage }}</NotificationBox>

    <NotificationBox v-if="chargedNotRecordedMessage" alertType="danger">{{ chargedNotRecordedMessage }}</NotificationBox>

    <template v-if="!blockError && registrationViewBag">
        <Wizard :templateName="registrationViewBag.registrationTemplateName ?? ''"
                :templateUrl="registrationViewBag.registrationTemplateUrl ?? ''"
                :instanceName="registrationViewBag.registrationInstanceName ?? ''"
                :instanceUrl="registrationViewBag.registrationInstanceUrl ?? ''"
                :registrationName="registrationViewBag.registrationName ?? ''" />

        <DetailBlock v-model:mode="panelMode"
                     name="Registration"
                     title="Registration Details"
                     :labels="blockLabels"
                     :showLabelsInHeader="true"
                     :alwaysShowLabels="true"
                     :entityKey="entityKey"
                     :entityTypeGuid="entityTypeGuid"
                     entityTypeName="Registration"
                     :isAuditHidden="true"
                     :isBadgesVisible="false"
                     :isDeleteVisible="isEditOrDeleteVisible"
                     :isEditVisible="isEditOrDeleteVisible"
                     :isFollowVisible="false"
                     :isSecurityHidden="true"
                     additionalDeleteMessage="All of the registrants will also be deleted!"
                     @cancelEdit="onCancelEdit"
                     @delete="onDelete"
                     @edit="onEdit"
                     @save="onSave">
            <template #view>
                <ViewPanel :modelValue="registrationViewBag"
                           :isEditable="isEditable"
                           v-model:selectedTab="selectedAccountTab"
                           :transactionDetailPageUrl="transactionDetailPageUrl"
                           :isProcessPaymentBlocked="isProcessPaymentBlocked"
                           :isPaymentProcessing="isPaymentProcessing"
                           :actionErrorMessage="actionErrorMessage"
                           @updated="onRegistrationUpdated"
                           @chargedNotRecorded="onChargedNotRecorded"
                           @paymentProcessingChanged="onPaymentProcessingChanged"
                           @error="onActionError" />
            </template>

            <template #edit>
                <EditPanel v-model="registrationEditBag" @propertyChanged="baseBlock.onPropertyChanged" />
            </template>

            <template v-if="isViewMode" #footerSecondaryActions>
                <RockButton v-if="auditPageUrl" btnType="default" btnSize="sm" title="View Audit Log" @click="onAuditLogClick">
                    <i class="ti ti-file-type-txt"></i> Audit Log
                </RockButton>
                <RockButton v-if="isEditable"
                            btnType="default"
                            btnSize="sm"
                            isSquare
                            class="margin-l-sm"
                            title="Move Registration"
                            :disabled="isPaymentProcessing"
                            @click="onMoveClick">
                    <i class="ti ti-external-link"></i>
                </RockButton>
            </template>
        </DetailBlock>

        <template v-if="isViewMode">
            <RegistrantPanel v-for="(registrant, index) in registrants"
                             :key="registrant.idKey ?? index"
                             :registrant="registrant"
                             :attributeDefinitions="registrationViewBag.registrantAttributes ?? {}"
                             :isEditable="isEditable"
                             :isActionDisabled="isRegistrantActionRunning || isPaymentProcessing"
                             :registrantPageUrl="registrantPageUrl"
                             :groupMemberPageUrl="groupMemberPageUrl"
                             @addToGroup="onAddRegistrantToGroup"
                             @delete="onDeleteRegistrant" />

            <div v-if="isEditable && addRegistrantUrl" class="row">
                <div class="col-md-12">
                    <a :href="addRegistrantUrl" class="btn btn-default btn-xs pull-right margin-b-sm">
                        <i class="ti ti-plus"></i> Add New Registrant
                    </a>
                </div>
            </div>
        </template>

        <MoveRegistrationModal v-model="isMoveModalVisible"
                               :registrationKey="entityKey"
                               @moved="onRegistrationMoved" />
    </template>
</template>

<script setup lang="ts">
    import { computed, nextTick, onMounted, ref } from "vue";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import DetailBlock from "@Obsidian/Templates/detailBlock";
    import { DetailPanelMode } from "@Obsidian/Enums/Controls/detailPanelMode";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { PanelAction } from "@Obsidian/Types/Controls/panelAction";
    import { onConfigurationValuesChanged, useConfigurationValues, useEntityDetailBlock, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
    import { alert, confirm } from "@Obsidian/Utility/dialogs";
    import { makeUrlRedirectSafe } from "@Obsidian/Utility/url";
    import { DetailBlockBox } from "@Obsidian/ViewModels/Blocks/detailBlockBox";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";
    import { RegistrantPanelBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/registrantPanelBag";
    import { RegistrationActionResultBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/registrationActionResultBag";
    import { RegistrationBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/registrationBag";
    import { RegistrationDeleteResultBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/registrationDeleteResultBag";
    import { RegistrationDetailOptionsBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/registrationDetailOptionsBag";
    import EditPanel from "./RegistrationDetail/editPanel.partial.obs";
    import MoveRegistrationModal from "./RegistrationDetail/moveRegistrationModal.partial.obs";
    import RegistrantPanel from "./RegistrationDetail/registrantPanel.partial.obs";
    import ViewPanel from "./RegistrationDetail/viewPanel.partial.obs";
    import Wizard from "./RegistrationDetail/wizard.partial.obs";
    import { AccountTab, getKeyedUrl, NavigationUrlKey } from "./RegistrationDetail/types.partial";

    const config = useConfigurationValues<DetailBlockBox<RegistrationBag, RegistrationDetailOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();

    onConfigurationValuesChanged(useReloadBlock());

    // #region Values

    const blockError = ref(config.errorMessage || (!config.entity ? "The specified registration could not be viewed." : ""));
    const errorMessage = ref("");
    const errorMessageElement = ref<InstanceType<typeof NotificationBox> | null>(null);
    const actionErrorMessage = ref("");

    /**
     * Describes a payment that was charged but not recorded. It is kept until
     * the page is reloaded so the transaction code stays visible.
     */
    const chargedNotRecordedMessage = ref("");

    const registrationViewBag = ref<RegistrationBag | null>(config.entity ?? null);
    const registrationEditBag = ref<ValidPropertiesBox<RegistrationBag>>({
        bag: {} as RegistrationBag
    });

    const entityTypeGuid = EntityType.Registration;
    const panelMode = ref<DetailPanelMode>(DetailPanelMode.View);
    const selectedAccountTab = ref<AccountTab>(AccountTab.Account);
    const isMoveModalVisible = ref(false);
    const isProcessPaymentBlocked = ref(false);

    /**
     * True from the moment a payment token is asked for until the payment
     * finishes (or the token wait ends without a payment). Edit, delete,
     * move, registrant actions and payment plan changes are blocked then,
     * because a token that arrives starts the payment at once, and leaving
     * view mode would unmount the payment form and lose the result of the
     * payment.
     */
    const isPaymentProcessing = ref(false);

    /** The identifier key of the registrant whose action is running, if any. */
    const busyRegistrantKey = ref("");

    /** Shown when a registrant action is asked for while another one is running. */
    const registrantActionBusyMessage = "Please wait for the current action to finish.";

    /** Shown when a registrant action is asked for while a payment is processing. */
    const paymentProcessingBusyMessage = "Please wait for the payment to finish.";

    const baseBlock = useEntityDetailBlock({
        blockConfig: config,
        entity: registrationEditBag
    });

    // #endregion Values

    // #region Computed Values

    const entityKey = computed((): string => {
        return registrationViewBag.value?.idKey ?? "";
    });

    const isEditable = computed((): boolean => {
        return config.isEditable === true;
    });

    const isEditOrDeleteVisible = computed((): boolean => {
        return isEditable.value && !isPaymentProcessing.value;
    });

    const isRegistrantActionRunning = computed((): boolean => {
        return !!busyRegistrantKey.value;
    });

    const isViewMode = computed((): boolean => {
        return panelMode.value === DetailPanelMode.View;
    });

    const registrants = computed((): RegistrantPanelBag[] => {
        return registrationViewBag.value?.registrants ?? [];
    });

    const registrantPageUrl = computed((): string => {
        return config.navigationUrls?.[NavigationUrlKey.RegistrantPage] ?? "";
    });

    const groupMemberPageUrl = computed((): string => {
        return config.navigationUrls?.[NavigationUrlKey.GroupMemberPage] ?? "";
    });

    const transactionDetailPageUrl = computed((): string => {
        return config.navigationUrls?.[NavigationUrlKey.TransactionDetailPage] ?? "";
    });

    const auditPageUrl = computed((): string => {
        return config.navigationUrls?.[NavigationUrlKey.AuditPage] ?? "";
    });

    const addRegistrantUrl = computed((): string => {
        return getKeyedUrl(registrantPageUrl.value, "0");
    });

    // Labels come from the view bag so they stay visible while editing.
    const blockLabels = computed((): PanelAction[] | undefined => {
        const bag = registrationViewBag.value;

        if (!bag?.isCostLabelVisible) {
            return undefined;
        }

        return [
            {
                title: bag.costText ?? "",
                type: "info",
                tooltip: "Cost"
            },
            {
                title: bag.balanceDueText ?? "",
                type: bag.balanceDueLabelType ?? "success",
                tooltip: "Balance Due",
                iconCssClass: bag.isPaymentPlanActive ? "ti ti-calendar-event" : undefined
            }
        ];
    });

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Event handler for the Cancel button being clicked while in Edit mode.
     *
     * @returns true so the panel returns to view mode.
     */
    async function onCancelEdit(): Promise<boolean> {
        return true;
    }

    /**
     * Event handler for the Delete button being clicked. The first
     * confirmation has already been shown by the panel.
     *
     * @returns false if it should stay on the page; or a string containing a redirect URL.
     */
    async function onDelete(): Promise<false | string> {
        errorMessage.value = "";

        if (isPaymentProcessing.value) {
            return false;
        }

        if (registrationViewBag.value?.isPaymentPlanActive) {
            const isConfirmed = await confirm("This registration has an active payment plan. Are you sure that you want to delete the registration? The payment plan will be deactivated and will no longer be associated with a registration.");

            if (!isConfirmed) {
                return false;
            }
        }

        // A payment may have started while a confirmation was open.
        if (isPaymentProcessing.value) {
            return false;
        }

        const result = await invokeBlockAction<RegistrationDeleteResultBag>("Delete", {
            key: entityKey.value
        });

        if (!result.isSuccess || !result.data) {
            errorMessage.value = result.errorMessage ?? "Unknown error while trying to delete registration.";
            scrollToErrorNotification();
            return false;
        }

        if (result.data.warningMessage) {
            await alert(result.data.warningMessage);
        }

        return result.data.redirectUrl || "/";
    }

    /**
     * Event handler for the Edit button being clicked.
     *
     * @returns true if the panel should enter edit mode; otherwise false.
     */
    async function onEdit(): Promise<boolean> {
        errorMessage.value = "";

        // Edit mode unmounts the view, which would lose the result of a
        // payment that is being sent. This also covers the keyboard shortcut.
        if (isPaymentProcessing.value) {
            return false;
        }

        const result = await invokeBlockAction<ValidPropertiesBox<RegistrationBag>>("Edit", {
            key: entityKey.value
        });

        // A payment may have started while the edit values were loading.
        if (isPaymentProcessing.value) {
            return false;
        }

        if (result.isSuccess && result.data?.bag) {
            registrationEditBag.value = {
                bag: result.data.bag,
                validProperties: result.data.validProperties ?? Object.keys(result.data.bag)
            };

            return true;
        }

        errorMessage.value = result.errorMessage ?? "Unknown error while trying to edit registration.";
        scrollToErrorNotification();
        return false;
    }

    /**
     * Event handler for the Save button being clicked.
     *
     * @returns true if the panel should leave edit mode; otherwise false.
     */
    async function onSave(): Promise<boolean> {
        errorMessage.value = "";

        const result = await invokeBlockAction<RegistrationActionResultBag>("Save", {
            box: registrationEditBag.value
        });

        if (result.isSuccess && result.data?.registration) {
            setRegistration(result.data.registration, AccountTab.Account);

            // The registration was saved but a follow-up step (such as adding
            // registrants to the target group) did not complete.
            if (result.data.warningMessage) {
                await alert(result.data.warningMessage);
            }

            return true;
        }

        errorMessage.value = result.errorMessage ?? "Unknown error while trying to save registration.";
        scrollToErrorNotification();
        return false;
    }

    /**
     * Navigates to the audit log of the registration.
     */
    function onAuditLogClick(): void {
        if (auditPageUrl.value) {
            window.location.href = makeUrlRedirectSafe(auditPageUrl.value);
        }
    }

    /**
     * Opens the move registration dialog.
     */
    function onMoveClick(): void {
        // A move rebuilds the registration under a payment that is running.
        if (isPaymentProcessing.value) {
            return;
        }

        isMoveModalVisible.value = true;
    }

    /**
     * Shows the registration rebuilt after it was moved.
     *
     * @param registration The rebuilt registration.
     */
    function onRegistrationMoved(registration: RegistrationBag): void {
        setRegistration(registration, AccountTab.Account);
    }

    /**
     * Shows a registration rebuilt by an action.
     *
     * @param registration The rebuilt registration.
     * @param tab The account tab to show.
     */
    function onRegistrationUpdated(registration: RegistrationBag, tab: AccountTab): void {
        setRegistration(registration, tab);
    }

    /**
     * Blocks further gateway payments after a payment was charged but could
     * not be recorded, and tells the person what happened.
     *
     * @param message The message describing what happened.
     */
    async function onChargedNotRecorded(message: string): Promise<void> {
        isProcessPaymentBlocked.value = true;
        chargedNotRecordedMessage.value = message;
        await alert(message);
    }

    /**
     * Tracks whether a payment is processing.
     *
     * @param isProcessing True from the payment token request until the payment finishes.
     */
    function onPaymentProcessingChanged(isProcessing: boolean): void {
        isPaymentProcessing.value = isProcessing;
    }

    /**
     * Shows the error of an action.
     *
     * @param message The error message.
     */
    function onActionError(message: string): void {
        actionErrorMessage.value = message;
    }

    /**
     * Adds a registrant to the target group.
     *
     * @param registrantKey The identifier key of the registrant.
     */
    async function onAddRegistrantToGroup(registrantKey: string): Promise<void> {
        if (busyRegistrantKey.value) {
            await alert(registrantActionBusyMessage);
            return;
        }

        // This action rebuilds the registration, which would race with the
        // registration returned by the payment that is running.
        if (isPaymentProcessing.value) {
            await alert(paymentProcessingBusyMessage);
            return;
        }

        actionErrorMessage.value = "";
        busyRegistrantKey.value = registrantKey;

        try {
            const result = await invokeBlockAction<RegistrationActionResultBag>("AddRegistrantToGroup", {
                key: entityKey.value,
                registrantKey
            });

            if (result.isSuccess && result.data?.registration) {
                setRegistration(result.data.registration, AccountTab.Account);
                return;
            }

            await alert(result.errorMessage ?? "Unknown error while trying to add the registrant to the group.");
        }
        finally {
            busyRegistrantKey.value = "";
        }
    }

    /**
     * Deletes a registrant.
     *
     * @param registrantKey The identifier key of the registrant.
     */
    async function onDeleteRegistrant(registrantKey: string): Promise<void> {
        // The delete was confirmed while another registrant action started,
        // so say why nothing happens instead of dropping it silently.
        if (busyRegistrantKey.value) {
            await alert(registrantActionBusyMessage);
            return;
        }

        // A payment may have started while the delete was being confirmed;
        // deleting a registrant changes the cost the payment is charged for.
        if (isPaymentProcessing.value) {
            await alert(paymentProcessingBusyMessage);
            return;
        }

        actionErrorMessage.value = "";
        busyRegistrantKey.value = registrantKey;

        try {
            const result = await invokeBlockAction<RegistrationActionResultBag>("DeleteRegistrant", {
                key: entityKey.value,
                registrantKey
            });

            if (result.isSuccess && result.data?.registration) {
                setRegistration(result.data.registration, AccountTab.Account);
                return;
            }

            await alert(result.errorMessage ?? "Unknown error while trying to delete the registrant.");
        }
        finally {
            busyRegistrantKey.value = "";
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Scrolls the error message into view, since it is shown above the panel
     * and can be off screen on a long form.
     */
    function scrollToErrorNotification(): void {
        nextTick(() => {
            errorMessageElement.value?.$el?.scrollIntoView({
                behavior: "smooth",
                block: "nearest"
            });
        });
    }

    /**
     * Shows a rebuilt registration and the selected account tab.
     *
     * @param registration The rebuilt registration.
     * @param tab The account tab to show.
     */
    function setRegistration(registration: RegistrationBag, tab: AccountTab): void {
        registrationViewBag.value = registration;
        selectedAccountTab.value = tab;
        actionErrorMessage.value = "";
    }

    /**
     * Scrolls to the registrant named in the URL hash. The registrant panels
     * render after the browser has already tried to follow the hash, so the
     * browser cannot do it on its own.
     */
    async function scrollToRegistrantAnchor(): Promise<void> {
        const hash = window.location.hash;

        if (hash.length < 2) {
            return;
        }

        let anchorName: string;

        try {
            anchorName = decodeURIComponent(hash.substring(1));
        }
        catch {
            // Intentionally ignored: a malformed hash simply does not name a registrant.
            return;
        }

        // Only registrant anchors are followed, and the name is looked up
        // directly so it is never parsed as a selector.
        if (!registrants.value.some(r => r.idKey === anchorName)) {
            return;
        }

        const anchor = document.getElementsByName(anchorName)[0];

        if (!anchor) {
            return;
        }

        await waitForBlockLoaded(anchor);

        anchor.scrollIntoView();
    }

    /**
     * Waits until the block that contains an element has finished loading,
     * which is when its loading placeholder has been removed.
     *
     * @param element An element inside this block.
     *
     * @returns A promise that resolves once the block has finished loading.
     */
    function waitForBlockLoaded(element: HTMLElement): Promise<void> {
        /*
            10/7/2026 - MSE

            The block is mounted inside a fixed height loading placeholder that
            the page removes shortly afterwards. Scrolling before then scrolls
            the placeholder, which is reset when it is removed, so the page
            never moves. The page marks the block's root element with loading
            classes until the placeholder is gone, so the scroll waits for this
            block's root to lose them. Other blocks on the page do not matter.
            A timeout makes sure the scroll still happens if the classes are
            never removed.

            Reason: Scroll to the registrant only after this block's placeholder is gone.
        */
        const loadingSelector = ".obsidian-block-loading, .obsidian-block-has-placeholder";
        const blockRoot = element.closest(loadingSelector);

        return new Promise(resolve => {
            if (!blockRoot) {
                resolve();
                return;
            }

            const observer = new MutationObserver(() => {
                if (!blockRoot.matches(loadingSelector)) {
                    finish();
                }
            });

            const timeoutId = window.setTimeout(() => finish(), 6000);

            function finish(): void {
                observer.disconnect();
                window.clearTimeout(timeoutId);
                resolve();
            }

            observer.observe(blockRoot, { attributes: true, attributeFilter: ["class"] });
        });
    }

    // #endregion Functions

    // #region Lifecycle Hooks

    onMounted(async () => {
        await nextTick();
        await scrollToRegistrantAnchor();
    });

    // #endregion Lifecycle Hooks
</script>
