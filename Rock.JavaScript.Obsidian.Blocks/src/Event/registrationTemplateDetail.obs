<template>
    <NotificationBox v-if="blockError" alertType="danger" v-html="blockError"></NotificationBox>

    <NotificationBox v-if="errorMessage" alertType="danger" v-html="errorMessage"></NotificationBox>

    <DetailBlock v-if="!blockError && !isPageUnscoped"
                 v-model:mode="panelMode"
                 name="Registration Template"
                 :title="panelTitle"
                 :labels="blockLabels"
                 :showLabelsInHeader="true"
                 :footerSecondaryActions="footerSecondaryActions"
                 :entityKey="entityKey"
                 :entityTypeGuid="entityTypeGuid"
                 entityTypeName="Registration Template"
                 :isAuditHidden="false"
                 :isBadgesVisible="false"
                 :isDeleteVisible="isEditable"
                 :isEditVisible="isEditable"
                 :isFollowVisible="false"
                 :isSecurityHidden="!isEditable"
                 additionalDeleteMessage="All of the instances, and the registrations and registrants from each instance will also be deleted!"
                 @cancelEdit="onCancelEdit"
                 @delete="onDelete"
                 @edit="onEdit"
                 @save="onSave">
        <template #view>
            <ViewPanel :modelValue="registrationTemplateViewBag" :options="options" />
        </template>

        <template #edit>
            <EditPanel ref="editPanel" v-model="registrationTemplateEditBag" :options="options" @propertyChanged="baseBlock.onPropertyChanged" />
        </template>
    </DetailBlock>
</template>

<script setup lang="ts">
    import { computed, ref } from "vue";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import DetailBlock from "@Obsidian/Templates/detailBlock";
    import { DetailPanelMode } from "@Obsidian/Enums/Controls/detailPanelMode";
    import { PanelAction } from "@Obsidian/Types/Controls/panelAction";
    import { confirm } from "@Obsidian/Utility/dialogs";
    import { useConfigurationValues, useInvokeBlockAction, useEntityDetailBlock, onConfigurationValuesChanged, useReloadBlock } from "@Obsidian/Utility/block";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { DetailBlockBox } from "@Obsidian/ViewModels/Blocks/detailBlockBox";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";
    import EditPanel from "./RegistrationTemplateDetail/editPanel.partial.obs";
    import ViewPanel from "./RegistrationTemplateDetail/viewPanel.partial.obs";
    import { NavigationUrlKey } from "./RegistrationTemplateDetail/types.partial";
    import { RegistrationTemplateBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationTemplateDetail/registrationTemplateBag";
    import { RegistrationTemplateDetailOptionsBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationTemplateDetail/registrationTemplateDetailOptionsBag";

    const config = useConfigurationValues<DetailBlockBox<RegistrationTemplateBag, RegistrationTemplateDetailOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();

    /** Waits for an in-flight gateway features request before Save. */
    const editPanel = ref<{ waitForGatewayFeatures: () => Promise<void> } | null>(null);

    onConfigurationValuesChanged(useReloadBlock());

    // #region Values

    const blockError = ref("");
    const errorMessage = ref("");

    const registrationTemplateViewBag = ref(config.entity);
    const registrationTemplateEditBag = ref<ValidPropertiesBox<RegistrationTemplateBag>>({
        bag: {} as RegistrationTemplateBag
    });
    const entityTypeGuid = EntityType.RegistrationTemplate;
    const options = ref<RegistrationTemplateDetailOptionsBag>(config.options ?? {});

    const panelMode = ref<DetailPanelMode>(DetailPanelMode.View);

    const baseBlock = useEntityDetailBlock({
        blockConfig: config,
        entity: registrationTemplateEditBag
    });

    // #endregion Values

    // #region Computed Values

    const entityKey = computed((): string => {
        return registrationTemplateViewBag.value?.idKey ?? "";
    });

    const isEditable = computed((): boolean => {
        return config.isEditable === true;
    });

    const isViewMode = computed((): boolean => {
        return panelMode.value === DetailPanelMode.View;
    });

    /**
     * Add (including Copy) uses DetailBlock's "Add Registration Template" title
     * instead of the source template name still sitting on the view bag.
     */
    const panelTitle = computed((): string => {
        if (panelMode.value === DetailPanelMode.Add) {
            return "";
        }

        return registrationTemplateViewBag.value?.name ?? "";
    });

    const blockLabels = computed((): PanelAction[] | undefined => {
        if (!isViewMode.value) {
            return undefined;
        }

        const labels: PanelAction[] = [];
        const bag = registrationTemplateViewBag.value;

        if (!bag) {
            return labels;
        }

        if (!bag.isActive) {
            labels.push({
                title: "Inactive",
                type: "danger"
            });
        }

        if (bag.categoryName) {
            labels.push({
                title: bag.categoryName,
                type: "default"
            });
        }

        return labels;
    });

    const footerSecondaryActions = computed((): PanelAction[] => {
        if (!isViewMode.value || !isEditable.value || !registrationTemplateViewBag.value?.idKey) {
            return [];
        }

        return [
            {
                iconCssClass: "ti ti-copy",
                title: "Copy",
                type: "default",
                handler: onCopy
            }
        ];
    });

    /**
     * When the server returns neither an entity nor an error the page is not
     * scoped to a template, so the whole panel stays hidden.
     */
    const isPageUnscoped = computed((): boolean => {
        return !config.entity && !config.errorMessage;
    });

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Event handler for the Cancel button being clicked while in Edit mode.
     * Handles redirect to parent page if creating a new entity.
     *
     * @returns true if the panel should leave edit mode; false if it should stay in edit mode; or a string containing a redirect URL.
     */
    async function onCancelEdit(): Promise<boolean | string> {
        if (!registrationTemplateEditBag.value?.bag?.idKey) {
            if (config.navigationUrls?.[NavigationUrlKey.ParentPage]) {
                return config.navigationUrls[NavigationUrlKey.ParentPage];
            }

            return false;
        }

        return true;
    }

    /**
     * Event handler for the Delete button being clicked. Sends the
     * delete request to the server and then redirects to the target page.
     *
     * @returns false if it should stay on the page; or a string containing a redirect URL.
     */
    async function onDelete(): Promise<false | string> {
        errorMessage.value = "";

        if (registrationTemplateViewBag.value?.hasRegistrations) {
            const confirmed = await confirm("This template has existing instances with existing registrations. Are you sure that you want to delete the template? Any active payment plans will be cancelled on the financial gateway and cannot be reinstated. Payments will not be deleted, but they will no longer be associated with a registration.");

            if (!confirmed) {
                return false;
            }
        }

        const result = await invokeBlockAction<string>("Delete", {
            key: registrationTemplateViewBag.value?.idKey
        });

        if (result.isSuccess && result.data) {
            return result.data;
        }

        errorMessage.value = result.errorMessage ?? "Unknown error while trying to delete registration template.";

        return false;
    }

    /**
     * Event handler for the Edit button being clicked. Request the edit
     * details from the server and then enter edit mode.
     *
     * @returns true if the panel should enter edit mode; otherwise false.
     */
    async function onEdit(): Promise<boolean> {
        const key = registrationTemplateViewBag.value?.idKey;
        const [result, optionsResult] = await Promise.all([
            invokeBlockAction<ValidPropertiesBox<RegistrationTemplateBag>>("Edit", { key }),
            invokeBlockAction<RegistrationTemplateDetailOptionsBag>("GetEditOptions", { key })
        ]);

        if (result.isSuccess && result.data?.bag && optionsResult.isSuccess && optionsResult.data) {
            options.value = optionsResult.data;
            registrationTemplateEditBag.value = {
                bag: result.data.bag,
                validProperties: result.data.validProperties ?? Object.keys(result.data.bag)
            };

            return true;
        }

        errorMessage.value = result.errorMessage ?? optionsResult.errorMessage ?? "Unknown error while trying to edit registration template.";

        return false;
    }

    /**
     * Event handler for the panel's Save event. Send the data to the server
     * to be saved and then leave edit mode or redirect to target page.
     *
     * @returns true if the panel should leave edit mode; false if it should stay in edit mode; or a string containing a redirect URL.
     */
    async function onSave(): Promise<boolean | string> {
        errorMessage.value = "";

        await editPanel.value?.waitForGatewayFeatures();

        const result = await invokeBlockAction<ValidPropertiesBox<RegistrationTemplateBag> | string>("Save", {
            box: registrationTemplateEditBag.value
        });

        if (result.isSuccess && result.data) {
            if (result.statusCode === 200 && typeof result.data === "object") {
                registrationTemplateViewBag.value = result.data.bag;

                return true;
            }

            if (result.statusCode === 201 && typeof result.data === "string") {
                return result.data;
            }
        }

        errorMessage.value = result.errorMessage ?? "Unknown error while trying to save registration template.";

        return false;
    }

    /**
     * Event handler for the Copy action. Requests an unsaved copy of the
     * template from the server and enters Add mode so that Save creates a
     * new template and Cancel leaves the copy behind.
     */
    async function onCopy(): Promise<void> {
        errorMessage.value = "";

        const key = registrationTemplateViewBag.value?.idKey;
        const [result, optionsResult] = await Promise.all([
            invokeBlockAction<ValidPropertiesBox<RegistrationTemplateBag>>("Copy", { key }),
            invokeBlockAction<RegistrationTemplateDetailOptionsBag>("GetEditOptions", { key })
        ]);

        if (result.isSuccess && result.data?.bag && optionsResult.isSuccess && optionsResult.data) {
            options.value = optionsResult.data;
            registrationTemplateEditBag.value = {
                bag: result.data.bag,
                validProperties: result.data.validProperties ?? Object.keys(result.data.bag)
            };

            panelMode.value = DetailPanelMode.Add;

            return;
        }

        errorMessage.value = result.errorMessage ?? optionsResult.errorMessage ?? "Unknown error while trying to copy registration template.";
    }

    // #endregion Event Handlers

    // Handle any initial error conditions or the need to go into edit mode.
    if (config.errorMessage) {
        blockError.value = config.errorMessage;
    }
    else if (config.entity && !config.entity.idKey) {
        registrationTemplateEditBag.value = { bag: config.entity };
        panelMode.value = DetailPanelMode.Add;
    }
</script>
