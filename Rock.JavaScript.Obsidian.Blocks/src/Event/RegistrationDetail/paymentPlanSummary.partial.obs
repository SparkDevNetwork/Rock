<template>
    <div class="well">
        <h4>Payment Plan</h4>

        <RockLiteral :label="paymentPlan.paymentAmountLabel ?? ''">{{ paymentPlan.paymentAmountText }}</RockLiteral>

        <RockLiteral v-if="paymentPlan.nextPaymentDateText" label="Next Payment Date">{{ paymentPlan.nextPaymentDateText }}</RockLiteral>

        <template v-if="paymentPlan.isEditable">
            <span :title="paymentPlan.changeDisabledReason ?? undefined">
                <RockButton btnType="default"
                            btnSize="xs"
                            class="margin-t-sm"
                            :disabled="paymentPlan.isChangeDisabled"
                            @click="onChangeClick">Change</RockButton>
            </span>

            <RockButton btnType="link"
                        btnSize="xs"
                        class="margin-t-sm text-primary"
                        :disabled="paymentPlan.isDeleteDisabled"
                        @click="onDeleteClick">Delete</RockButton>
        </template>

        <NotificationBox v-if="paymentPlan.isAmountMismatch" alertType="warning" class="margin-t-sm" heading="Warning">
            Payment plan and registration amounts don't match.
        </NotificationBox>
    </div>

    <PaymentPlanModal v-model="isChangeModalVisible"
                      :registrationKey="registrationKey"
                      @updated="onPaymentPlanUpdated" />

    <Modal v-model="isDeleteModalVisible"
           title="Are you sure?"
           saveText="Delete"
           :isSaveButtonDisabled="isDeleting"
           :onSave="onDeleteConfirmed">
        <NotificationBox v-if="deleteErrorMessage" alertType="danger">{{ deleteErrorMessage }}</NotificationBox>
        <p>Are you sure you want to delete this payment plan?</p>
    </Modal>
</template>

<script setup lang="ts">
    import { PropType, ref, watch } from "vue";
    import Modal from "@Obsidian/Controls/modal.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import RockLiteral from "@Obsidian/Controls/rockLiteral.obs";
    import { useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { RegistrationActionResultBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/registrationActionResultBag";
    import { RegistrationBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/registrationBag";
    import { RegistrationPaymentPlanSummaryBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/registrationPaymentPlanSummaryBag";
    import PaymentPlanModal from "./paymentPlanModal.partial.obs";

    const props = defineProps({
        paymentPlan: {
            type: Object as PropType<RegistrationPaymentPlanSummaryBag>,
            required: true
        },

        registrationKey: {
            type: String as PropType<string | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        (e: "updated", registration: RegistrationBag): void,
        (e: "deleted", registration: RegistrationBag, warningMessage: string): void
    }>();

    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const isChangeModalVisible = ref(false);
    const isDeleteModalVisible = ref(false);
    const isDeleting = ref(false);
    const deleteErrorMessage = ref("");

    // #endregion Values

    // #region Event Handlers

    /**
     * Opens the dialog used to change the payment plan.
     */
    function onChangeClick(): void {
        isChangeModalVisible.value = true;
    }

    /**
     * Opens the dialog used to confirm deleting the payment plan.
     */
    function onDeleteClick(): void {
        isDeleteModalVisible.value = true;
    }

    /**
     * Passes on the registration rebuilt after the payment plan was changed.
     *
     * @param registration The rebuilt registration.
     */
    function onPaymentPlanUpdated(registration: RegistrationBag): void {
        emit("updated", registration);
    }

    /**
     * Deletes the payment plan. The dialog stays open when the delete fails.
     */
    async function onDeleteConfirmed(): Promise<void> {
        if (isDeleting.value) {
            return;
        }

        isDeleting.value = true;
        deleteErrorMessage.value = "";

        try {
            const result = await invokeBlockAction<RegistrationActionResultBag>("DeletePaymentPlan", {
                key: props.registrationKey
            });

            if (!result.isSuccess || !result.data?.registration) {
                deleteErrorMessage.value = result.errorMessage ?? "Unknown error while trying to delete the payment plan.";
                return;
            }

            isDeleteModalVisible.value = false;
            emit("deleted", result.data.registration, result.data.warningMessage ?? "");
        }
        finally {
            isDeleting.value = false;
        }
    }

    // #endregion Event Handlers

    // #region Watchers

    watch(isDeleteModalVisible, () => {
        if (isDeleteModalVisible.value) {
            deleteErrorMessage.value = "";
        }
    });

    // #endregion Watchers
</script>
