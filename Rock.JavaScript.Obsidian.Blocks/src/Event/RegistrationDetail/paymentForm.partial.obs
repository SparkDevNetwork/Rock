<template>
    <div class="well">
        <h4>Payment Information</h4>

        <NotificationBox v-if="errorMessage" alertType="danger" heading="Error Processing Payment">{{ errorMessage }}</NotificationBox>

        <LoadingIndicator v-if="isLoading" />

        <RockForm v-else @submit="onSubmit">
            <PersonPicker v-if="!isInputDisabled"
                          v-model="payer"
                          label="Payer"
                          help="The person who is making the payment."
                          rules="required" />

            <StaticFormControl v-else
                               label="Payer"
                               :modelValue="payer?.text ?? ''" />

            <CurrencyBox v-model="amount"
                         label="Payment Amount"
                         rules="required"
                         :disabled="isInputDisabled" />

            <TextBox v-model="comments"
                     label="Comments"
                     textMode="multiline"
                     :rows="2"
                     :maxLength="1000"
                     :disabled="isInputDisabled" />

            <template v-if="isManual">
                <DefinedValuePicker v-model="currencyType"
                                    label="Currency Type"
                                    :definedTypeGuid="currencyTypeDefinedTypeGuid"
                                    showBlankItem />

                <DefinedValuePicker v-if="isCreditCard"
                                    v-model="creditCardType"
                                    label="Credit Card Type"
                                    :definedTypeGuid="creditCardTypeDefinedTypeGuid"
                                    showBlankItem />

                <TextBox v-model="transactionCode"
                         label="Transaction Code"
                         :maxLength="50" />
            </template>

            <template v-else-if="gatewayControl">
                <div class="hosted-payment-control">
                    <GatewayControl :key="gatewayControlKey"
                                    :gatewayControlModel="gatewayControl"
                                    :amountToPay="amount ?? 0"
                                    @success="onGatewayControlSuccess"
                                    @error="onGatewayControlError"
                                    @validation="onGatewayControlValidation" />
                </div>

                <NotificationBox v-if="tokenErrorMessage" alertType="validation">{{ tokenErrorMessage }}</NotificationBox>

                <AddressControl v-model="billingAddress"
                                :showAddressLine2="false"
                                rules="required"
                                :disabled="isInputDisabled" />
            </template>

            <div class="actions">
                <RockButton btnType="link" :disabled="isSaving" @click="onCancelClick">Cancel</RockButton>
                <RockButton type="submit"
                            btnType="primary"
                            :disabled="isSubmitDisabled"
                            :isLoading="isSaving"
                            loadingText="Processing...">Submit</RockButton>
                <span v-if="isAwaitingToken" class="text-muted margin-l-sm">{{ awaitingTokenHint }}</span>
            </div>
        </RockForm>
    </div>
</template>

<script setup lang="ts">
    import { computed, onBeforeUnmount, onMounted, PropType, ref } from "vue";
    import AddressControl from "@Obsidian/Controls/addressControl.obs";
    import CurrencyBox from "@Obsidian/Controls/currencyBox.obs";
    import DefinedValuePicker from "@Obsidian/Controls/definedValuePicker.obs";
    import GatewayControl from "@Obsidian/Controls/gatewayControl.obs";
    import LoadingIndicator from "@Obsidian/Controls/loadingIndicator.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import PersonPicker from "@Obsidian/Controls/personPicker.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import StaticFormControl from "@Obsidian/Controls/staticFormControl.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import { provideSubmitPayment, usePaymentEvents } from "@Obsidian/Core/Controls/financialGateway";
    import { DefinedType } from "@Obsidian/SystemGuids/definedType";
    import { DefinedValue } from "@Obsidian/SystemGuids/definedValue";
    import { FormError } from "@Obsidian/Utility/form";
    import { areEqual, newGuid } from "@Obsidian/Utility/guid";
    import { useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { AddressControlBag } from "@Obsidian/ViewModels/Controls/addressControlBag";
    import { GatewayControlBag } from "@Obsidian/ViewModels/Controls/gatewayControlBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { ManualPaymentRequestBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/manualPaymentRequestBag";
    import { ProcessPaymentOptionsBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/processPaymentOptionsBag";
    import { ProcessPaymentRequestBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/processPaymentRequestBag";
    import { RegistrationActionResultBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/registrationActionResultBag";
    import { RegistrationBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrationDetail/registrationBag";
    import { PaymentFormMode } from "./types.partial";

    const props = defineProps({
        mode: {
            type: String as PropType<PaymentFormMode>,
            required: true
        },

        registrationKey: {
            type: String as PropType<string | null>,
            default: null
        },

        defaultPayer: {
            type: Object as PropType<ListItemBag | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        (e: "saved", registration: RegistrationBag): void,
        (e: "cancel"): void,
        (e: "chargedNotRecorded", message: string): void,
        (e: "processingChanged", isProcessing: boolean): void
    }>();

    const invokeBlockAction = useInvokeBlockAction();
    const submitPayment = provideSubmitPayment();
    usePaymentEvents();

    // #region Values

    /** The status code returned when a payment was charged but could not be recorded. */
    const chargedNotRecordedStatusCode = 409;

    /**
     * How long, in milliseconds, a token request is given before Submit may
     * ask the gateway again. It matches the timeout the NMI gateway control
     * gives CollectJS, after which that request reports a timeout.
     */
    const tokenRetryDelay = 10000;

    const currencyTypeDefinedTypeGuid = DefinedType.FinancialCurrencyType;
    const creditCardTypeDefinedTypeGuid = DefinedType.FinancialCreditCardType;

    const isLoading = ref(false);

    /**
     * True while waiting for the gateway control to return a payment token.
     * Nothing has been sent to the server yet, so the payment can still be
     * cancelled, and Submit can be clicked again in case the gateway control
     * ignored the request (it does while it is still loading).
     */
    const isAwaitingToken = ref(false);

    /**
     * True once the current token request has been waited on long enough
     * that Submit may ask the gateway again.
     */
    const isTokenRetryAllowed = ref(false);

    /** The timer that allows Submit to ask the gateway again. */
    let tokenRetryTimerId: number | null = null;

    /**
     * True while the payment is being sent to the server. The payment can no
     * longer be cancelled and the form must stay open until it finishes.
     */
    const isSaving = ref(false);

    /**
     * True once the form was cancelled or closed, so a payment token that
     * arrives late is ignored and never charged.
     */
    let isClosed = false;

    /**
     * The processing state last reported to the parent. A payment is
     * processing from the moment a token is asked for until the payment is
     * recorded or the token wait ends without a payment, because a token that
     * arrives starts the payment at once.
     */
    let isProcessingReported = false;

    const errorMessage = ref("");
    const tokenErrorMessage = ref("");

    const payer = ref<ListItemBag | undefined>(props.defaultPayer ?? undefined);
    const amount = ref<number | null>(null);
    const comments = ref("");
    const currencyType = ref<ListItemBag | null>(null);
    const creditCardType = ref<ListItemBag | null>(null);
    const transactionCode = ref("");

    const gatewayControl = ref<GatewayControlBag | null>(null);
    const gatewayControlKey = ref(0);
    const billingAddress = ref<AddressControlBag>(toFullAddress(null));

    /**
     * Identifies this payment. It is created when the form opens and sent with
     * every retry, so a retry of a payment that was already recorded is never
     * charged or recorded again.
     */
    const transactionGuid = newGuid();

    // #endregion Values

    // #region Computed Values

    const isManual = computed((): boolean => {
        return props.mode === PaymentFormMode.Manual;
    });

    const isSubmitDisabled = computed((): boolean => {
        return isSaving.value || isLoading.value || (!isManual.value && !gatewayControl.value);
    });

    /**
     * True while a payment token is awaited or the payment is being sent, so
     * the payment is charged with the values the person saw when submitting.
     */
    const isInputDisabled = computed((): boolean => {
        return isAwaitingToken.value || isSaving.value;
    });

    const awaitingTokenHint = computed((): string => {
        return isTokenRetryAllowed.value
            ? "Waiting for the payment gateway. If nothing happens, click Submit again."
            : "Waiting for the payment gateway...";
    });

    const isCreditCard = computed((): boolean => {
        return areEqual(currencyType.value?.value, DefinedValue.CurrencyTypeCreditCard);
    });

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Records the manual payment, or asks the gateway control for a payment
     * token when charging through the gateway.
     */
    async function onSubmit(): Promise<void> {
        if (isSaving.value) {
            return;
        }

        /*
            10/7/2026 - MSE

            Submit stays clickable while a token is awaited, because the NMI
            gateway control silently ignores a submit while it is loading
            (first open, or the reload after a failed payment), which would
            otherwise leave the form waiting forever. A second click only asks
            the gateway again; onGatewayControlSuccess still accepts a single
            token and starts a single payment.

            CollectJS is global, so a token from an earlier request can still
            arrive through a reloaded gateway control and be taken for the
            newer request. Asking again is therefore only allowed once the
            earlier request had time to finish (the CollectJS timeout). A
            gateway error or validation message ends the wait, which allows a
            new request at once.

            Reason: A submit ignored by a loading gateway must be retryable
            without a late token charging earlier card details.
        */
        if (isAwaitingToken.value && !isTokenRetryAllowed.value) {
            return;
        }

        errorMessage.value = "";
        tokenErrorMessage.value = "";

        if (isManual.value) {
            await saveManualPayment();
            return;
        }

        if (!gatewayControl.value) {
            return;
        }

        setAwaitingToken(true);
        startTokenRetryTimer();

        try {
            submitPayment();
        }
        catch {
            setAwaitingToken(false);
            errorMessage.value = "The payment gateway is not ready yet. Please try again.";
        }
    }

    /**
     * Cancels the payment.
     */
    function onCancelClick(): void {
        if (isSaving.value) {
            return;
        }

        // The gateway control may still be loading or tokenizing; a token
        // that arrives after this point must not charge the payment.
        isClosed = true;
        setAwaitingToken(false);

        emit("cancel");
    }

    /**
     * Charges the payment with the token from the gateway control.
     *
     * @param token The payment token.
     */
    async function onGatewayControlSuccess(token: string): Promise<void> {
        // Only a token that was asked for by a submit that is still waiting
        // may be charged. The wait ends here, before anything is awaited, so
        // a second token (from Submit being clicked again) is ignored.
        if (isClosed || !isAwaitingToken.value || isSaving.value) {
            return;
        }

        // Set directly rather than through setAwaitingToken(), so the parent
        // never sees processing end between the token and the payment.
        isAwaitingToken.value = false;
        clearTokenRetryTimer();
        await processPayment(token);
    }

    /**
     * Shows an error reported by the gateway control.
     *
     * @param message The error message.
     */
    function onGatewayControlError(message: string): void {
        // The payment is already being sent with a token, so a gateway
        // message no longer describes it.
        if (isSaving.value) {
            return;
        }

        // A remounting gateway can report an empty error; that must not clear
        // an error already shown.
        if (!message) {
            return;
        }

        setAwaitingToken(false);
        tokenErrorMessage.value = message;
    }

    /**
     * Shows the payment fields the gateway control reported as invalid.
     *
     * @param invalidFields The invalid fields.
     */
    function onGatewayControlValidation(invalidFields: FormError[]): void {
        // The payment is already being sent with a token, so a gateway
        // message no longer describes it.
        if (isSaving.value) {
            return;
        }

        // A remounting gateway can report an empty set; that must not clear an
        // error already shown.
        if (invalidFields.length === 0) {
            return;
        }

        setAwaitingToken(false);
        tokenErrorMessage.value = invalidFields.map(f => f.text).join(" ");
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Sets whether a payment token is being awaited and tells the parent if
     * the processing state changed.
     *
     * @param value True while a payment token is being awaited.
     */
    function setAwaitingToken(value: boolean): void {
        isAwaitingToken.value = value;

        if (!value) {
            clearTokenRetryTimer();
        }

        reportProcessing();
    }

    /**
     * Starts the wait after which Submit may ask the gateway for a payment
     * token again.
     */
    function startTokenRetryTimer(): void {
        clearTokenRetryTimer();

        tokenRetryTimerId = window.setTimeout(() => {
            tokenRetryTimerId = null;
            isTokenRetryAllowed.value = true;
        }, tokenRetryDelay);
    }

    /**
     * Stops the retry wait, so Submit may not ask the gateway again until a
     * new token request has been waited on.
     */
    function clearTokenRetryTimer(): void {
        if (tokenRetryTimerId !== null) {
            window.clearTimeout(tokenRetryTimerId);
            tokenRetryTimerId = null;
        }

        isTokenRetryAllowed.value = false;
    }

    /**
     * Sets whether the payment is being sent to the server and tells the
     * parent if the processing state changed.
     *
     * @param value True while the payment is being sent.
     */
    function setSaving(value: boolean): void {
        isSaving.value = value;
        reportProcessing();
    }

    /**
     * Tells the parent whether a payment is processing, so it can keep the
     * form open from the token request until the payment finishes. Only a
     * change is reported.
     */
    function reportProcessing(): void {
        const isProcessing = isAwaitingToken.value || isSaving.value;

        if (isProcessing === isProcessingReported) {
            return;
        }

        isProcessingReported = isProcessing;
        emit("processingChanged", isProcessing);
    }

    /**
     * Expands a partial address into an address with every field present, so
     * the address control does not keep values from a previous address.
     *
     * @param partial The partial address.
     *
     * @returns The full address.
     */
    function toFullAddress(partial: AddressControlBag | null | undefined): AddressControlBag {
        return {
            street1: partial?.street1 ?? "",
            street2: partial?.street2 ?? "",
            city: partial?.city ?? "",
            state: partial?.state ?? "",
            postalCode: partial?.postalCode ?? "",
            country: partial?.country ?? "",
            locality: partial?.locality ?? ""
        };
    }

    /**
     * Records the manual payment.
     */
    async function saveManualPayment(): Promise<void> {
        setSaving(true);

        try {
            const request: ManualPaymentRequestBag = {
                payerPersonAliasGuid: payer.value?.value ?? null,
                amount: amount.value ?? 0,
                comments: comments.value,
                currencyTypeValueGuid: currencyType.value?.value ?? null,
                creditCardTypeValueGuid: isCreditCard.value ? creditCardType.value?.value ?? null : null,
                transactionCode: transactionCode.value
            };

            const result = await invokeBlockAction<RegistrationActionResultBag>("SaveManualPayment", {
                key: props.registrationKey,
                request
            });

            if (result.isSuccess && result.data?.registration) {
                emit("saved", result.data.registration);
                return;
            }

            errorMessage.value = result.errorMessage ?? "Unknown error while trying to save the payment.";
        }
        finally {
            setSaving(false);
        }
    }

    /**
     * Charges the payment through the gateway and records it.
     *
     * @param token The payment token from the gateway control.
     */
    async function processPayment(token: string): Promise<void> {
        setSaving(true);

        try {
            const request: ProcessPaymentRequestBag = {
                transactionGuid,
                gatewayToken: token,
                amount: amount.value ?? 0,
                payerPersonAliasGuid: payer.value?.value ?? null,
                comments: comments.value,
                billingAddress: billingAddress.value
            };

            const result = await invokeBlockAction<RegistrationActionResultBag>("ProcessPayment", {
                key: props.registrationKey,
                request
            });

            if (result.isSuccess && result.data?.registration) {
                emit("saved", result.data.registration);
                return;
            }

            if (result.statusCode === chargedNotRecordedStatusCode) {
                emit("chargedNotRecorded", result.errorMessage ?? "The payment was charged but could not be recorded. Do not resubmit; contact your finance team.");
                return;
            }

            errorMessage.value = result.errorMessage ?? "Unknown error while trying to process the payment.";

            // Payment tokens can only be used once, so the gateway control is
            // reloaded to collect the payment method again.
            gatewayControlKey.value++;
        }
        finally {
            setSaving(false);
        }
    }

    /**
     * Loads the gateway control and the default payment values.
     */
    async function loadProcessPaymentOptions(): Promise<void> {
        isLoading.value = true;

        try {
            const result = await invokeBlockAction<ProcessPaymentOptionsBag>("GetProcessPaymentOptions", {
                key: props.registrationKey
            });

            if (!result.isSuccess || !result.data) {
                errorMessage.value = result.errorMessage ?? "Unknown error while trying to load the payment gateway.";
                return;
            }

            gatewayControl.value = result.data.gatewayControl ?? null;
            amount.value = result.data.amount;
            payer.value = result.data.payer ?? payer.value;
            billingAddress.value = toFullAddress(result.data.billingAddress);
        }
        finally {
            isLoading.value = false;
        }
    }

    // #endregion Functions

    // #region Lifecycle Hooks

    onMounted(() => {
        if (props.mode === PaymentFormMode.Hosted) {
            void loadProcessPaymentOptions();
        }
    });

    onBeforeUnmount(() => {
        isClosed = true;
        clearTokenRetryTimer();

        if (isProcessingReported) {
            isProcessingReported = false;
            emit("processingChanged", false);
        }
    });

    // #endregion Lifecycle Hooks
</script>
