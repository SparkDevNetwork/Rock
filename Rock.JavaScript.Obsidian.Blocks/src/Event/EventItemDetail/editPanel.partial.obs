<template>
    <ContentSectionContainer :sidebar="false">
        <ContentSection light>
            <div class="basic-fields">
                <div class="row">
                    <div class="col-md-6">
                        <TextBox v-model="name"
                                 label="Name"
                                 rules="required" />
                    </div>

                    <div class="col-md-3">
                        <CheckBox v-model="isActive"
                                  label="Active" />
                    </div>

                    <div class="col-md-3">
                        <ButtonGroup v-if="isApprovalConfigurable"
                                     v-model="approvalButtonValue"
                                     label="Status"
                                     help="Whether this event is approved to appear on its calendars. Changeable only by users with approval rights."
                                     formGroupClasses="d-flex flex-column align-items-start"
                                     :items="approvalButtonItems" />

                        <StaticFormControl v-else
                                           label="Status"
                                           modelValue=""
                                           help="Whether this event is approved to appear on its calendars. Changeable only by users with approval rights.">
                            <HighlightLabel :labelType="readOnlyStatusLabelType">{{ readOnlyStatusText }}</HighlightLabel>
                        </StaticFormControl>

                        <span v-if="approvalText" class="text-muted small">{{ approvalText }}</span>
                    </div>
                </div>

                <TextBox v-model="summary"
                         label="Summary"
                         textMode="multiline"
                         help="A short, plain-text summary shown in event lists and as the page's search-result snippet." />
            </div>
        </ContentSection>

        <ContentSection title="Event Item Details"
                        icon="ti ti-calendar-search">
            <div class="event-item-details">
                <HtmlEditor v-model="description"
                            label="Description"
                            help="The full content shown on the event's detail page."
                            :editorHeight="300"
                            toolbar="light" />

                <ImageUploader v-model="photo"
                               label="Photo"
                               help="The image shown with this event in lists and on its detail page."
                               :uploadAsTemporary="true"
                               uploadButtonText="Upload"
                               :showDeleteButton="true" />

                <div class="row">
                    <div class="col-md-6">
                        <TextBox v-model="detailsUrl"
                                 label="Detail Page URL"
                                 help="A custom URL for this event's detail page, used instead of the site's default." />
                    </div>
                </div>
            </div>
        </ContentSection>

        <ContentSection title="Audience &amp; Visibility"
                        icon="ti ti-calendar-search">
            <ContentStack title="Calendars &amp; Audiences"
                          description="Control where this event is published and who it's intended to reach.">
                <CheckBoxList v-model="calendars"
                              label="Calendars"
                              rules="required"
                              help="The calendars this event appears on. At least one is required."
                              :items="availableCalendars" />

                <DropDownList v-model="selectedAudienceValues"
                              label="Audiences"
                              help="The audiences this event is intended for. Used for filtering and reporting."
                              :items="availableAudiences"
                              :multiple="true"
                              :enhanceForLongLists="true" />
            </ContentStack>

            <ContentStack title="Personalization"
                          description="Control when and for whom this event appears by targeting specific audiences and request conditions.">
                <DropDownList v-model="selectedSegmentGuids"
                              label="Audience Segments"
                              help="Limit this event item to specific audience segments."
                              :items="segmentOptions"
                              :multiple="true"
                              :enhanceForLongLists="true" />

                <DropDownList v-model="selectedRequestFilterGuids"
                              label="Request Filters"
                              help="Show this event only when certain request conditions are met (such as device or context)."
                              :items="requestFilterOptions"
                              :multiple="true"
                              :enhanceForLongLists="true" />
            </ContentStack>
        </ContentSection>

        <ContentSection v-if="eventItemAttributes.length > 0"
                        title="Event Attribute Values"
                        icon="ti ti-list-details">
            <div class="event-attribute-values">
                <div v-for="eventItemAttribute in eventItemAttributes" :key="eventItemAttribute.eventCalendarName ?? ''">
                    <h3>{{ eventItemAttribute.eventCalendarName }}</h3>
                    <AttributeValuesContainer v-if="eventItemAttribute.attributeValues && eventItemAttribute.attributes"
                                              v-model="eventItemAttribute.attributeValues"
                                              :showCategoryLabel="false"
                                              :attributes="eventItemAttribute.attributes"
                                              isEditMode
                                              :numberOfColumns="1" />
                </div>
            </div>
        </ContentSection>

        <ContentSection title="Event Occurrence Attributes"
                        icon="ti ti-binary-tree-2">
            <div class="event-occurrence-attributes">
                <Grid :data="occurenceAttributesGridData" keyField="guid" itemTerm="Event Occurrence Attributes" liveUpdates
                      light @addItem="onAddAttribute">
                    <ReorderColumn @orderChanged="onOrderChanged" />

                    <TextColumn name="name"
                                field="name"
                                title="Attribute" />

                    <TextColumn name="description"
                                field="description"
                                title="Description" />

                    <TextColumn name="fieldType"
                                field="fieldType"
                                title="Field Type" />

                    <BooleanColumn name="isRequired"
                                   field="isRequired"
                                   title="Required" />

                    <BooleanColumn name="showInGrid"
                                   field="showInGrid"
                                   title="Show in Grid" />

                    <BooleanColumn name="allowSearch"
                                   field="allowSearch"
                                   title="Allow Search" />

                    <EditColumn @click="onEditAttribute" />

                    <DeleteColumn @click="onDeleteAttribute" disableConfirmation />
                </Grid>

                <Modal v-model="isAttributeModalOpen" title="Event Occurrence Attribute" saveText="Save" :onSave="onStartSaveAttribute">

                    <RockForm v-model:submit="submitEditAttribute" @submit="onSaveAttribute">
                        <AttributeEditor v-model="occurrenceAttribute" :reservedKeyNames="reservedKeyNames" :attributeEntityTypeGuid="EntityType.EventItemOccurrence" :isAllowSearchVisible="true" />
                    </RockForm>

                </Modal>
            </div>
        </ContentSection>
    </ContentSectionContainer>
</template>

<script setup lang="ts">
    import { computed, PropType, ref, watch } from "vue";
    import ContentSectionContainer from "@Obsidian/Controls/contentSectionContainer.obs";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import AttributeValuesContainer from "@Obsidian/Controls/attributeValuesContainer.obs";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import Modal from "@Obsidian/Controls/modal.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import CheckBoxList from "@Obsidian/Controls/checkBoxList.obs";
    import ImageUploader from "@Obsidian/Controls/imageUploader.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import ButtonGroup from "@Obsidian/Controls/buttonGroup.obs";
    import HighlightLabel from "@Obsidian/Controls/highlightLabel.obs";
    import StaticFormControl from "@Obsidian/Controls/staticFormControl.obs";
    import AttributeEditor from "@Obsidian/Controls/attributeEditor.obs";
    import HtmlEditor from "@Obsidian/Controls/htmlEditor.obs";
    import { watchPropertyChanges } from "@Obsidian/Utility/block";
    import { propertyRef, updateRefValue } from "@Obsidian/Utility/component";
    import { Guid } from "@Obsidian/Types";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { EventItemBag } from "@Obsidian/ViewModels/Blocks/Event/EventItemDetail/eventItemBag";
    import { EventItemDetailOptionsBag } from "@Obsidian/ViewModels/Blocks/Event/EventItemDetail/eventItemDetailOptionsBag";
    import { PublicEditableAttributeBag } from "@Obsidian/ViewModels/Utility/publicEditableAttributeBag";
    import { EventItemOccurenceAttributeBag } from "@Obsidian/ViewModels/Blocks/Event/EventItemDetail/eventItemOccurenceAttributeBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import Grid, { TextColumn, DeleteColumn, BooleanColumn, EditColumn, ReorderColumn } from "@Obsidian/Controls/grid";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { FieldType as FieldTypeGuids } from "@Obsidian/SystemGuids/fieldType";
    import { newGuid } from "@Obsidian/Utility/guid";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<EventItemBag>,
            required: true
        },

        options: {
            type: Object as PropType<EventItemDetailOptionsBag>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: EventItemBag): void,
        (e: "propertyChanged", value: string): void
    }>();

    // #region Values

    const attributes = ref(props.modelValue.attributes ?? {});
    const attributeValues = ref(props.modelValue.attributeValues ?? {});
    const description = propertyRef(props.modelValue.description ?? "", "Description");
    const isActive = propertyRef(props.modelValue.isActive ?? false, "IsActive");
    const name = propertyRef(props.modelValue.name ?? "", "Name");
    const summary = propertyRef(props.modelValue.summary ?? "", "Summary");
    const detailsUrl = propertyRef(props.modelValue.detailsUrl ?? "", "DetailsUrl");
    const isApproved = propertyRef(props.modelValue.isApproved ?? false, "IsApproved");
    const photo = propertyRef(props.modelValue.photo ?? {}, "PhotoId");
    const eventOccurenceAttributes = ref(props.modelValue.eventOccurenceAttributes ?? []);
    const calendars = ref(props.modelValue.calendars ?? []);

    const availableCalendars = ref(props.modelValue.availableCalendars ?? []);
    const availableAudiences = ref(props.options.audiences ?? []);

    const isAttributeModalOpen = ref(false);
    const submitEditAttribute = ref(false);
    const occurrenceAttribute = ref<PublicEditableAttributeBag | null>(null);
    const reservedKeyNames = ref<string[]>([]);

    const audiences = ref(props.modelValue.audiences ?? []);
    const selectedSegmentGuids = propertyRef<Guid[]>(props.modelValue.selectedSegmentGuids ?? [], "SelectedSegmentGuids");
    const selectedRequestFilterGuids = propertyRef<Guid[]>(props.modelValue.selectedRequestFilterGuids ?? [], "SelectedRequestFilterGuids");

    const eventItemAttributes = ref(props.modelValue.eventCalendarItemAttributes ?? []);

    const approvalText = ref(props.modelValue.approvalText ?? "");

    // The properties that are being edited. This should only contain
    // objects returned by propertyRef().
    const propRefs = [description, isActive, name, summary, isApproved, detailsUrl, photo, selectedSegmentGuids, selectedRequestFilterGuids];

    const approvalButtonItems = [
        { value: "false", text: "Not Approved", selectedBtnType: BtnType.Warning },
        { value: "true", text: "Approved", selectedBtnType: BtnType.Success }
    ];

    // #endregion Values

    // #region Computed Values

    const occurenceAttributesGridData = computed((): GridDataBag => {
        const rows = (eventOccurenceAttributes.value ?? []).map(x => toAttributeGridRowItem(x));
        return { rows };
    });

    /**
     * String adapter for the ButtonGroup, which binds a string while
     * isApproved is a boolean.
     */
    const approvalButtonValue = computed<string>({
        get(): string {
            return isApproved.value ? "true" : "false";
        },
        set(value: string) {
            isApproved.value = value === "true";
        }
    });

    /**
     * Selected audience values for the multi-select, bridged to the persisted
     * audiences bags.
     */
    const selectedAudienceValues = computed<string[]>({
        get(): string[] {
            return audiences.value.map(a => a.value).filter((v): v is string => !!v);
        },
        set(values: string[]) {
            audiences.value = values
                .map(v => availableAudiences.value.find(a => a.value === v))
                .filter((a): a is ListItemBag => !!a);
        }
    });

    /**
     * Whether the current individual may change the approval status.
     */
    const isApprovalConfigurable = computed((): boolean => props.modelValue.isApprovalConfigurable ?? false);

    const segmentOptions = computed((): ListItemBag[] => props.options.segmentOptions ?? []);

    const requestFilterOptions = computed((): ListItemBag[] => props.options.requestFilterOptions ?? []);

    /**
     * Read-only status label shown when the individual cannot change approval.
     */
    const readOnlyStatusText = computed((): string => isApproved.value ? "Approved" : "Not Approved");

    /**
     * The label type for the read-only status label shown when the individual
     * cannot change approval.
     */
    const readOnlyStatusLabelType = computed((): "success" | "warning" => isApproved.value ? "success" : "warning");

    // #endregion Computed Values

    // #region Functions

    function toAttributeGridRowItem(bag: EventItemOccurenceAttributeBag): Record<string, unknown> {
        return {
            guid: bag.attribute?.guid,
            name: bag.attribute?.name,
            fieldType: bag.fieldType,
            description: bag.attribute?.description,
            isRequired: bag.attribute?.isRequired,
            showInGrid: bag.attribute?.isShowInGrid,
            allowSearch: bag.attribute?.isAllowSearch
        };
    }

    // #endregion Functions

    // #region Event Handlers

    const onAddAttribute = (): void => {
        occurrenceAttribute.value = {} as PublicEditableAttributeBag;
        occurrenceAttribute.value.fieldTypeGuid = FieldTypeGuids.Text;
        isAttributeModalOpen.value = true;
    };

    const onEditAttribute = (key: string): void => {
        const selectedAttribute = eventOccurenceAttributes.value.find(x => x.attribute?.guid === key);
        // If attribute exists set it as current attribute for editing.
        if (selectedAttribute?.attribute) {
            occurrenceAttribute.value = selectedAttribute.attribute;
            isAttributeModalOpen.value = true;
        }
        else {
            onAddAttribute();
        }
    };

    const onDeleteAttribute = async (key: string): Promise<void> => {
        isAttributeModalOpen.value = false;
        eventOccurenceAttributes.value = eventOccurenceAttributes.value.filter(s => s.attribute?.guid !== key);
    };

    const onSaveAttribute = (): void => {

        if (occurrenceAttribute.value && eventOccurenceAttributes.value) {
            const index = eventOccurenceAttributes.value.findIndex(a => a.attribute?.guid === occurrenceAttribute.value?.guid);

            if (index !== -1) {
                const editedAttribute = eventOccurenceAttributes.value.find(a => a.attribute?.guid === occurrenceAttribute.value?.guid);

                if (editedAttribute?.attribute) {
                    editedAttribute.attribute = occurrenceAttribute.value;
                    eventOccurenceAttributes.value.splice(index, 1, editedAttribute);
                }
            }
            else {
                const newEventAttribute = {
                    attribute: occurrenceAttribute.value,
                    fieldType: ""
                };
                newEventAttribute.attribute.guid = newGuid();
                eventOccurenceAttributes.value.push(newEventAttribute);
            }

            isAttributeModalOpen.value = false;
            occurrenceAttribute.value = null;
        }
    };

    const onStartSaveAttribute = (): void => {
        submitEditAttribute.value = true;
    };

    async function onOrderChanged(item: Record<string, unknown>, beforeItem: Record<string, unknown> | null): Promise<boolean> {
        const itemGuid = item["guid"] as string;
        const beforeItemGuid = beforeItem?.["guid"] as string | null;

        const currentItems = [...(eventOccurenceAttributes.value ?? [])];
        const idx = currentItems.findIndex(i => i.attribute?.guid === itemGuid);

        if (idx < 0) {
            return false;
        }

        const itemToMove = currentItems.splice(idx, 1)[0];

        if (beforeItemGuid) {
            const beforeIndex = currentItems.findIndex(i => i.attribute?.guid === beforeItemGuid);
            if (beforeIndex < 0) {
                currentItems.push(itemToMove);
            }
            else {
                currentItems.splice(beforeIndex, 0, itemToMove);
            }
        }
        else {
            currentItems.push(itemToMove);
        }

        eventOccurenceAttributes.value = currentItems;
        return true;
    }

    // #endregion Event Handlers

    // #region Watchers

    // Watch for parental changes in our model value and update all our values.
    watch(() => props.modelValue, () => {
        updateRefValue(attributes, props.modelValue.attributes ?? {});
        updateRefValue(attributeValues, props.modelValue.attributeValues ?? {});
        updateRefValue(description, props.modelValue.description ?? "");
        updateRefValue(isActive, props.modelValue.isActive ?? false);
        updateRefValue(name, props.modelValue.name ?? "");
        updateRefValue(summary, props.modelValue.summary ?? "");
        updateRefValue(isApproved, props.modelValue.isApproved ?? false);
        updateRefValue(detailsUrl, props.modelValue.detailsUrl ?? "");
        updateRefValue(photo, props.modelValue.photo ?? {});
        updateRefValue(audiences, props.modelValue.audiences ?? []);
        updateRefValue(selectedSegmentGuids, props.modelValue.selectedSegmentGuids ?? []);
        updateRefValue(selectedRequestFilterGuids, props.modelValue.selectedRequestFilterGuids ?? []);
        updateRefValue(calendars, props.modelValue.calendars ?? []);
        updateRefValue(eventItemAttributes, props.modelValue.eventCalendarItemAttributes ?? []);
    });

    // Determines which values we want to track changes on (defined in the
    // array) and then emit a new object defined as newValue.
    watch([attributeValues, eventOccurenceAttributes, audiences, calendars, eventItemAttributes, ...propRefs], () => {
        const newValue: EventItemBag = {
            ...props.modelValue,
            attributeValues: attributeValues.value,
            description: description.value,
            isActive: isActive.value,
            name: name.value,
            summary: summary.value,
            isApproved: isApproved.value,
            eventOccurenceAttributes: eventOccurenceAttributes.value,
            detailsUrl: detailsUrl.value,
            photo: photo.value,
            audiences: audiences.value,
            selectedSegmentGuids: selectedSegmentGuids.value,
            selectedRequestFilterGuids: selectedRequestFilterGuids.value,
            calendars: calendars.value,
            eventCalendarItemAttributes: eventItemAttributes.value
        };

        emit("update:modelValue", newValue);
    }, { deep: true });

    // Maintain reservedKeyNames as a derived list of keys from the
    // existing attributes, excluding the attribute currently being
    // edited (matched by guid since the user may be changing the key).
    watch([eventOccurenceAttributes, isAttributeModalOpen, occurrenceAttribute], () => {
        const editingGuid = isAttributeModalOpen.value
            ? occurrenceAttribute.value?.guid
            : null;

        reservedKeyNames.value = (eventOccurenceAttributes.value ?? [])
            .filter(a => !editingGuid || a.attribute?.guid !== editingGuid)
            .map(a => a.attribute?.key)
            .filter((k): k is string => !!k);
    }, { immediate: true, deep: true });

    // Watch for any changes to props that represent properties and then
    // automatically emit which property changed.
    watchPropertyChanges(propRefs, emit);

    // #endregion Watchers
</script>
