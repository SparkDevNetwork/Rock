<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Grid :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="idKey"
          itemTerm="Assessment"
          title="Assessment History"
          exportTitle="Assessment History"
          :entityTypeGuid="EntityType.Assessment"
          stickyHeader
          liveUpdates>

        <TextColumn name="assessmentType"
                    title="Assessment"
                    field="assessmentType"
                    :filter="pickExistingValueFilter"
                    visiblePriority="xs" />

        <LabelColumn name="status"
                     title="Status"
                     field="status"
                     :filter="pickExistingValueFilter"
                     :classSource="statusClassSource"
                     visiblePriority="xs" />

        <DateTimeColumn name="requestedDateTime"
                        title="Requested"
                        field="requestedDateTime"
                        :filter="dateValueFilter"
                        visiblePriority="sm" />

        <PersonColumn name="requestedBy"
                      title="Requested By"
                      field="requestedBy"
                      :hideAvatar="true"
                      :showAsLink="true"
                      :detailField="false"
                      :filter="pickExistingValueFilter"
                      :filterValue="getRequestedByFilterValue"
                      :quickFilterValue="getRequestedByFilterValue"
                      visiblePriority="md" />

        <DateTimeColumn name="completedDateTime"
                        title="Completed"
                        field="completedDateTime"
                        :filter="dateValueFilter"
                        visiblePriority="sm" />

        <DeleteColumn v-if="config.isDeleteEnabled"
                      :rowDisabled="getIsDeleteRowDisabled"
                      @click="onDeleteClick" />
    </Grid>
</template>

<script setup lang="ts">
    import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import Grid, { TextColumn, LabelColumn, DateTimeColumn, PersonColumn, DeleteColumn, dateValueFilter, pickExistingValueFilter } from "@Obsidian/Controls/grid";
    import { alert } from "@Obsidian/Utility/dialogs";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { AssessmentHistoryOptionsBag } from "@Obsidian/ViewModels/Blocks/Crm/AssessmentHistory/assessmentHistoryOptionsBag";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { PersonFieldBag } from "@Obsidian/ViewModels/Core/Grid/personFieldBag";
    import { reactive, ref } from "vue";

    const config = useConfigurationValues<ListBlockBox<AssessmentHistoryOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();

    // All blocks auto reload when changing block settings unless there is an
    // explicit reason not to (like using a custom reload function instead),
    // in which case you can remove this code.
    onConfigurationValuesChanged(useReloadBlock());

    // #region Values

    const gridDataSource = ref<Promise<GridDataBag>>();
    let gridData: GridDataBag | undefined;

    const statusClassSource = {
        Complete: "success",
        Pending: "warning"
    };

    // #endregion Values

    // #region Event Handlers

    /**
     * Called when a row's delete button has been clicked by the individual. This
     * happens only if they have confirmed the delete action.
     *
     * @param key The key of the row to be deleted.
     */
    async function onDeleteClick(key: string): Promise<void> {
        const result = await invokeBlockAction<string>("Delete", {
            key
        });

        if (result.isSuccess) {
            if (gridData && gridData.rows) {
                const index = gridData.rows.findIndex(r => r["idKey"] === key);

                if (index !== -1) {
                    gridData.rows?.splice(index, 1);
                }
            }
        }
        else {
            await alert(result.errorMessage ?? "Unknown error while trying to delete assessment.");
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Called when the grid is requesting the row data be loaded.
     */
    async function loadGridData(): Promise<GridDataBag> {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (result.isSuccess && result.data) {
            gridData = reactive(result.data);
            return gridData;
        }
        else {
            throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
        }
    }

    /**
     * Gets the text used to filter the Requested By column.
     *
     * @param row The row whose filter value is needed.
     *
     * @returns The text to filter and search the column by.
     */
    function getRequestedByFilterValue(row: Record<string, unknown>): string {
        const person = row["requestedBy"] as PersonFieldBag;

        return !person ? "" : `${person.nickName} ${person.lastName}`;
    }

    /**
     * Determines if the delete button is disabled for the specified row.
     * Completed assessments are permanent history and cannot be deleted.
     *
     * @param row The row to be checked.
     *
     * @returns true if the row's delete button should be disabled.
     */
    function getIsDeleteRowDisabled(row: Record<string, unknown>): boolean {
        return row["isCompleted"] === true;
    }

    // #endregion Functions

    gridDataSource.value = loadGridData();
</script>
