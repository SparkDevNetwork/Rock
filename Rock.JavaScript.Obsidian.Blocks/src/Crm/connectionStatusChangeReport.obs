<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Panel title="Connection Status Changes"
           titleIconCssClass="ti ti-arrows-right-left"
           type="block">
        <RockForm @submit="applyFilters">
            <div class="row">
                <div class="col-md-6">
                    <SlidingDateRangePicker v-model="dateRange"
                                            label="Date Range"
                                            help="If selected, only changes within this time period will be shown." />
                </div>
                <div class="col-md-6">
                    <CampusPicker v-model="campus"
                                  label="Campus"
                                  showBlankItem
                                  help="If selected, only people from this campus will be shown." />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <DefinedValuePicker v-model="fromConnectionStatus"
                                        label="Original Status"
                                        :definedTypeGuid="DefinedType.PersonConnectionStatus"
                                        showBlankItem
                                        includeInactive
                                        help="If selected, only changes from this connection status will be shown." />
                </div>
                <div class="col-md-6">
                    <DefinedValuePicker v-model="toConnectionStatus"
                                        label="Updated Status"
                                        :definedTypeGuid="DefinedType.PersonConnectionStatus"
                                        showBlankItem
                                        includeInactive
                                        help="If selected, only changes to this connection status will be shown." />
                </div>
            </div>
            <div class="actions">
                <RockButton type="submit"
                            :btnType="BtnType.Primary"
                            :isLoading="isLoading"
                            loadingText="Loading...">
                    Apply
                </RockButton>
            </div>
        </RockForm>
    </Panel>

    <Grid :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="idKey"
          personKeyField="personIdKey"
          itemTerm="Connection Status Change"
          title="Results"
          :entityTypeGuid="EntityType.Person"
          stickyHeader
          @selectItem="onSelectItem">

        <PersonColumn name="person"
                      title="Name"
                      field="person"
                      :filter="pickExistingValueFilter"
                      :showAsLink="true"
                      visiblePriority="xs"
                      width="25%" />

        <DateColumn name="dateChanged"
                    title="Change Date"
                    field="dateChanged"
                    :filter="dateValueFilter"
                    visiblePriority="md" />

        <TextColumn name="changedBy"
                    title="Changed By"
                    field="changedBy"
                    :filter="textValueFilter"
                    visiblePriority="md" />

        <TextColumn name="originalStatus"
                    title="Original Status"
                    field="originalStatus"
                    :filter="textValueFilter"
                    visiblePriority="md" />

        <TextColumn name="updatedStatus"
                    title="Updated Status"
                    field="updatedStatus"
                    :filter="textValueFilter"
                    visiblePriority="md" />
    </Grid>
</template>

<script setup lang="ts">
    import { reactive, ref } from "vue";
    import { NavigationUrlKey, PreferenceKey, Row } from "./ConnectionStatusChangeReport/types.partial";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import SlidingDateRangePicker from "@Obsidian/Controls/slidingDateRangePicker.obs";
    import CampusPicker from "@Obsidian/Controls/campusPicker.obs";
    import DefinedValuePicker from "@Obsidian/Controls/definedValuePicker.obs";
    import Grid, { DateColumn, PersonColumn, TextColumn, dateValueFilter, pickExistingValueFilter, textValueFilter } from "@Obsidian/Controls/grid";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { DefinedType } from "@Obsidian/SystemGuids/definedType";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, usePersonPreferences, useReloadBlock } from "@Obsidian/Utility/block";
    import { parseSlidingDateRangeString, RangeType, SlidingDateRange, slidingDateRangeToString, TimeUnit } from "@Obsidian/Utility/slidingDateRange";
    import { ConnectionStatusChangeReportOptionsBag } from "@Obsidian/ViewModels/Blocks/Crm/ConnectionStatusChangeReport/connectionStatusChangeReportOptionsBag";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    const config = useConfigurationValues<ListBlockBox<ConnectionStatusChangeReportOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();
    const preferences = usePersonPreferences().blockPreferences;

    onConfigurationValuesChanged(useReloadBlock());

    // Default to the current year so the result set stays bounded when no range is chosen.
    const defaultSlidingDateRange: SlidingDateRange = {
        rangeType: RangeType.Current,
        timeUnit: TimeUnit.Year
    };

    // #region Values

    const dateRange = ref<SlidingDateRange | null>(parseSlidingDateRangeString(config.options?.dateRange ?? "") ?? defaultSlidingDateRange);
    const campus = ref<ListItemBag | null>(config.options?.campus ?? null);
    const fromConnectionStatus = ref<ListItemBag | null>(config.options?.fromConnectionStatus ?? null);
    const toConnectionStatus = ref<ListItemBag | null>(config.options?.toConnectionStatus ?? null);

    const gridDataSource = ref<Promise<GridDataBag>>();
    let gridData: GridDataBag | undefined;

    const isLoading = ref(false);

    // #endregion Values

    // #region Event Handlers

    /**
     * Persists the current filter selections and reloads the grid from the server.
     */
    async function applyFilters(): Promise<void> {
        isLoading.value = true;

        try {
            preferences.setValue(PreferenceKey.FilterDateRange, dateRange.value ? slidingDateRangeToString(dateRange.value) : "");
            preferences.setValue(PreferenceKey.FilterCampus, campus.value?.value ?? "");
            preferences.setValue(PreferenceKey.FilterFromStatus, fromConnectionStatus.value?.value ?? "");
            preferences.setValue(PreferenceKey.FilterToStatus, toConnectionStatus.value?.value ?? "");

            await preferences.save();

            const promise = loadGridData();
            gridDataSource.value = promise;
            await promise;
        }
        finally {
            isLoading.value = false;
        }
    }

    /**
     * Navigates to the configured Person Detail Page for the selected row's person.
     *
     * @param key The key of the row that was selected.
     */
    function onSelectItem(key: string): void {
        const url = config.navigationUrls?.[NavigationUrlKey.PersonDetailPage];

        if (!url || !gridData?.rows) {
            return;
        }

        const row = gridData.rows.find(r => r["idKey"] === key) as Row | undefined;

        if (row?.personIdKey) {
            window.location.href = url.replace("((Key))", row.personIdKey);
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Called when the grid is requesting the row data be loaded.
     */
    async function loadGridData(): Promise<GridDataBag> {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (result.isSuccess && result.data) {
            gridData = reactive(result.data);
            return gridData;
        }
        else {
            throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
        }
    }

    // #endregion Functions

    gridDataSource.value = loadGridData();
</script>
