<template>
    <div class="row">
        <div class="col-md-3 mb-4">
            <ContentSection light>
                <ImageEditor v-model="photo"
                             :binaryFileTypeGuid="BinaryFiletype.PersonImage"
                             label="Photo"
                             help="The photo shown with this person throughout Rock, including check-in and directories." />
            </ContentSection>
        </div>
        <div class="col-md-9">
            <ContentSectionContainer :sidebar="false">
                <ContentSection title="Personal Information"
                                icon="ti ti-user-circle"
                                disableCollapse>
                    <ContentStack title="Name"
                                  description="Enter the person's legal name, plus the name they go by. Rock shows the nickname wherever their name appears.">
                        <div class="row">
                            <div class="col-md-12">
                                <DefinedValuePicker v-model="title"
                                                    :definedTypeGuid="DefinedType.PersonTitle"
                                                    label="Title"
                                                    class="input-width-md"
                                                    :showBlankItem="true" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <FirstNameTextBox v-model="firstName"
                                                  label="First Name"
                                                  rules="nospecialcharacters|noemojisorspecialfonts" />
                            </div>
                            <div class="col-md-6">
                                <TextBox v-model="nickName"
                                         label="Nickname"
                                         rules="nospecialcharacters|noemojisorspecialfonts" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <TextBox v-model="middleName"
                                         label="Middle Name"
                                         rules="nospecialcharacters|noemojisorspecialfonts" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <TextBox v-model="lastName"
                                         label="Last Name"
                                         rules="nospecialcharacters|noemojisorspecialfonts" />
                            </div>
                            <div class="col-md-6">
                                <DefinedValuePicker v-model="suffix"
                                                    :definedTypeGuid="DefinedType.PersonSuffix"
                                                    label="Suffix"
                                                    class="input-width-md"
                                                    :showBlankItem="true" />
                            </div>
                        </div>
                    </ContentStack>
                </ContentSection>
            </ContentSectionContainer>
        </div>
    </div>
</template>

<script setup lang="ts">
    import { PropType, watch } from "vue";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import FirstNameTextBox from "@Obsidian/Controls/firstNameTextBox.obs";
    import DefinedValuePicker from "@Obsidian/Controls/definedValuePicker.obs";
    import ImageEditor from "@Obsidian/Controls/imageEditor.obs";
    import ContentSectionContainer from "@Obsidian/Controls/contentSectionContainer.obs";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import { setPropertiesBoxValue, watchPropertyChanges } from "@Obsidian/Utility/block";
    import { propertyRef, updateRefValue } from "@Obsidian/Utility/component";
    import { BinaryFiletype } from "@Obsidian/SystemGuids/binaryFiletype";
    import { DefinedType } from "@Obsidian/SystemGuids/definedType";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";
    import { EditPersonBag } from "@Obsidian/ViewModels/Blocks/Crm/PersonDetail/EditPerson/editPersonBag";
    import { EditPersonOptionsBag } from "@Obsidian/ViewModels/Blocks/Crm/PersonDetail/EditPerson/editPersonOptionsBag";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<ValidPropertiesBox<EditPersonBag>>,
            required: true
        },

        options: {
            type: Object as PropType<EditPersonOptionsBag>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: ValidPropertiesBox<EditPersonBag>): void,
        (e: "propertyChanged", value: string): void
    }>();

    // #region Values

    // Personal Information > Name
    const title = propertyRef<ListItemBag | null>(props.modelValue?.bag?.title ?? null, "Title");
    const firstName = propertyRef(props.modelValue?.bag?.firstName ?? "", "FirstName");
    const nickName = propertyRef(props.modelValue?.bag?.nickName ?? "", "NickName");
    const middleName = propertyRef(props.modelValue?.bag?.middleName ?? "", "MiddleName");
    const lastName = propertyRef(props.modelValue?.bag?.lastName ?? "", "LastName");
    const suffix = propertyRef<ListItemBag | null>(props.modelValue?.bag?.suffix ?? null, "Suffix");

    // Status & Photo (left column)
    const photo = propertyRef<ListItemBag | null>(props.modelValue?.bag?.photo ?? null, "Photo");

    // The properties that are being edited. This should only contain objects returned by propertyRef().
    const propRefs = [title, firstName, nickName, middleName, lastName, suffix, photo];

    // #endregion Values

    // #region Watchers

    // Watch for parental changes in our model value and update all our values.
    watch(() => props.modelValue, () => {
        updateRefValue(title, props.modelValue?.bag?.title ?? null);
        updateRefValue(firstName, props.modelValue?.bag?.firstName ?? "");
        updateRefValue(nickName, props.modelValue?.bag?.nickName ?? "");
        updateRefValue(middleName, props.modelValue?.bag?.middleName ?? "");
        updateRefValue(lastName, props.modelValue?.bag?.lastName ?? "");
        updateRefValue(suffix, props.modelValue?.bag?.suffix ?? null);
        updateRefValue(photo, props.modelValue?.bag?.photo ?? null);
    });

    // Determines which values we want to track changes on and emits a new box as newValue.
    watch([...propRefs], () => {
        const newValue: ValidPropertiesBox<EditPersonBag> = {
            bag: { ...props.modelValue.bag } as EditPersonBag
        };

        setPropertiesBoxValue(newValue, "title", title.value);
        setPropertiesBoxValue(newValue, "firstName", firstName.value);
        setPropertiesBoxValue(newValue, "nickName", nickName.value);
        setPropertiesBoxValue(newValue, "middleName", middleName.value);
        setPropertiesBoxValue(newValue, "lastName", lastName.value);
        setPropertiesBoxValue(newValue, "suffix", suffix.value);
        setPropertiesBoxValue(newValue, "photo", photo.value);

        emit("update:modelValue", newValue);
    });

    // Watch for any changes to properties and automatically emit which property changed.
    watchPropertyChanges(propRefs, emit);

    // #endregion Watchers
</script>
