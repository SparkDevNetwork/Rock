<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <NotificationBox v-if="blockError" alertType="warning" v-html="blockError" />

    <RockForm v-else v-model:submit="submitForm" @submit="onSave">
        <Panel type="block"
               :title="panelTitle"
               titleIconCssClass="ti ti-user">

            <template #headerActions>
                <ExperienceModePicker />

                <HighlightLabel v-if="options.familyName"
                                labelType="default"
                                iconCssClass="ti ti-users">
                    {{ options.familyName }}
                </HighlightLabel>

                <HighlightLabel v-if="options.campusName"
                                labelType="campus"
                                iconCssClass="ti ti-building">
                    {{ options.campusName }}
                </HighlightLabel>
            </template>

            <NotificationBox v-if="errorMessage" alertType="danger" class="mb-3" v-html="errorMessage" />

            <div class="row">
                <div class="col-md-3 mb-4">
                    <ContentSection light>
                        <div>
                            <ImageEditor v-model="photo"
                                         :binaryFileTypeGuid="BinaryFiletype.PersonImage"
                                         :noPictureUrl="options.noPictureUrl ?? undefined"
                                         label="Profile Photo"
                                         help="The photo shown with this person throughout Rock, including check-in and directories." />

                            <DefinedValuePicker v-if="options.isConnectionStatusEditable"
                                                v-model="connectionStatus"
                                                :definedTypeGuid="DefinedType.PersonConnectionStatus"
                                                label="Connection Status"
                                                help="This person's relationship to your church, such as Member or Attendee."
                                                rules="required" />
                            <StaticFormControl v-else label="Connection Status" :modelValue="connectionStatus?.text ?? ''" />

                            <DefinedValuePicker v-if="options.isRecordStatusEditable"
                                                v-model="recordStatus"
                                                :definedTypeGuid="DefinedType.PersonRecordStatus"
                                                label="Record Status"
                                                help="Whether this person's record is active. Inactive retires a record without deleting it."
                                                :showBlankItem="false" />
                            <StaticFormControl v-else label="Record Status" :modelValue="recordStatus?.text ?? ''" />

                            <p v-if="isRecordInactive && options.isOnlyActiveFamilyMember" class="text-muted mb-3">
                                {{ familyInactiveMessage }}
                            </p>

                            <ConditionalWell v-if="isRecordInactive">
                                <DefinedValuePicker v-if="options.isRecordStatusEditable"
                                                    v-model="recordStatusReason"
                                                    :definedTypeGuid="DefinedType.PersonRecordStatusReason"
                                                    label="Reason"
                                                    help="Why this record is inactive. Used for reporting on why people leave."
                                                    :showBlankItem="true" />
                                <StaticFormControl v-else label="Reason" :modelValue="recordStatusReason?.text ?? ''" />

                                <DatePicker v-if="isReasonDeceased && options.isRecordStatusEditable"
                                            v-model="deceasedDate"
                                            label="Deceased Date"
                                            help="The date this person passed away. Must be on or after their birth date."
                                            :rules="deceasedDateRules" />
                                <StaticFormControl v-else-if="isReasonDeceased" label="Deceased Date" :modelValue="deceasedDate" />

                                <TextBox v-if="options.isRecordStatusEditable"
                                         v-model="inactiveReasonNote"
                                         label="Note"
                                         textMode="multiline"
                                         :rows="3"
                                         help="Additional detail about why this record is inactive." />
                                <StaticFormControl v-else label="Note" :modelValue="inactiveReasonNote" />
                            </ConditionalWell>

                            <DefinedValuePicker v-if="options.isRecordSourceEditable"
                                                v-model="recordSource"
                                                :definedTypeGuid="DefinedType.RecordSourceType"
                                                label="Record Source"
                                                help="How this record first entered Rock. Set automatically when the record is created; changing it replaces the original attribution."
                                                :showBlankItem="true" />
                            <StaticFormControl v-else label="Record Source" :modelValue="recordSource?.text ?? ''" />
                        </div>
                    </ContentSection>
                </div>
                <div class="col-md-9">
                    <NotificationBox v-if="options.accountProtectionProfileMessage"
                                     :alertType="protectionProfileAlertType"
                                     class="mb-3">
                        {{ options.accountProtectionProfileMessage }}
                    </NotificationBox>
                    <ContentSectionContainer :sidebar="false">
                        <ContentSection title="Personal Information"
                                        icon="ti ti-user-circle"
                                        disableCollapse>
                            <ContentStack title="Name"
                                          description="Enter the person's legal name, plus the name they go by. Rock shows the nickname wherever their name appears.">
                                <div class="row">
                                    <div class="col-md-12">
                                        <DefinedValuePicker v-model="title"
                                                            :definedTypeGuid="DefinedType.PersonTitle"
                                                            label="Title"
                                                            class="input-width-md"
                                                            :showBlankItem="true" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <FirstNameTextBox v-model="firstName"
                                                          label="First Name"
                                                          help="The person's legal first name."
                                                          rules="nospecialcharacters|noemojisorspecialfonts" />
                                    </div>
                                    <div class="col-md-6">
                                        <TextBox v-model="nickName"
                                                 label="Nickname"
                                                 help="The name this person goes by. Rock uses it wherever their name is displayed. When blank, the first name is used."
                                                 rules="nospecialcharacters|noemojisorspecialfonts" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <TextBox v-model="middleName"
                                                 label="Middle Name"
                                                 rules="nospecialcharacters|noemojisorspecialfonts" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <TextBox v-model="lastName"
                                                 label="Last Name"
                                                 rules="nospecialcharacters|noemojisorspecialfonts" />
                                    </div>
                                    <div class="col-md-6">
                                        <DefinedValuePicker v-model="suffix"
                                                            :definedTypeGuid="DefinedType.PersonSuffix"
                                                            label="Suffix"
                                                            class="input-width-md"
                                                            :showBlankItem="true" />
                                    </div>
                                </div>
                            </ContentStack>

                            <ContentStack title="Demographics"
                                          description="Provide the details Rock uses for check-in, ministry placement, and reporting.">
                                <RadioButtonList v-model="gender"
                                                 label="Gender"
                                                 :items="genderItems"
                                                 :showBlankItem="false" />

                                <BirthdayPicker v-model="birthDate"
                                                label="Birth Date"
                                                :rules="birthDateRules" />

                                <CheckBox v-model="isLockedAsChild"
                                          label=""
                                          text="Consider Person As Child">
                                    <template #textAppend>
                                        <HelpBlock text="Whether this person is classified as a child, even when their age or family role would make them an adult. Also keeps data automation from moving them into their own family." />
                                    </template>
                                </CheckBox>

                                <div v-if="isGradeShown" class="row">
                                    <div class="col-md-6">
                                        <GradePicker v-model="grade"
                                                     label="Grade"
                                                     :showBlankItem="true" />
                                    </div>
                                    <div class="col-md-6">
                                        <YearPicker v-model="graduationYear"
                                                    label="Graduation Year" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <DefinedValuePicker v-model="maritalStatus"
                                                            :definedTypeGuid="DefinedType.PersonMaritalStatus"
                                                            label="Marital Status"
                                                            :showBlankItem="true" />
                                    </div>
                                    <div v-if="isAnniversaryShown" class="col-md-6">
                                        <DatePicker v-model="anniversaryDate"
                                                    label="Anniversary" />
                                    </div>
                                </div>

                                <div v-if="isRaceShown" class="row">
                                    <div class="col-md-6">
                                        <RacePicker v-model="race"
                                                    :rules="isRaceRequired ? 'required' : ''"
                                                    :showBlankItem="true" />
                                    </div>
                                </div>

                                <div v-if="isEthnicityShown" class="row">
                                    <div class="col-md-6">
                                        <EthnicityPicker v-model="ethnicity"
                                                         :rules="isEthnicityRequired ? 'required' : ''"
                                                         :showBlankItem="true" />
                                    </div>
                                </div>
                            </ContentStack>
                        </ContentSection>

                        <ContentSection title="Communication"
                                        icon="ti ti-message"
                                        disableCollapse>
                            <ContentStack title="Contact Info"
                                          description="Enter this person's phone numbers and email address. Only one number can be SMS enabled. Select ‘Unlisted’ to hide a number from directories and other shared listings.">
                                <div v-for="phoneNumber in phoneNumbers" :key="phoneNumber.phoneTypeGuid" class="row">
                                    <div class="col-xs-6">
                                        <PhoneNumberBox v-model="phoneNumber.number"
                                                        v-model:countryCode="phoneNumber.countryCode"
                                                        :label="phoneNumber.phoneTypeLabel ?? ''" />
                                    </div>
                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label class="control-label">&nbsp;</label>
                                            <div class="control-wrapper d-flex gap-4 align-items-center">
                                                <InlineCheckBox v-if="phoneNumber.isSmsEditable"
                                                                :modelValue="phoneNumber.isMessagingEnabled"
                                                                label="SMS"
                                                                @update:modelValue="value => onSmsChanged(phoneNumber, value)" />
                                                <InlineCheckBox v-model="phoneNumber.isUnlisted"
                                                                label="Unlisted" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <EmailBox v-model="email"
                                                  label="Email" />
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <!-- Spacer label aligns the checkbox with the email input below its label. -->
                                            <label class="control-label">&nbsp;</label>
                                            <div class="control-wrapper">
                                                <InlineCheckBox v-model="isEmailActive"
                                                                label="Email Is Deliverable"
                                                                help="Whether this address can receive mail. Rock clears this automatically after a hard bounce." />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </ContentStack>
                        </ContentSection>
                    </ContentSectionContainer>
                </div>
            </div>

            <template #footerActions>
                <RockButton :btnType="BtnType.Primary"
                            :isLoading="isSaving"
                            autoDisable
                            autoLoading
                            @click="onStartSubmitForm">
                    Save
                </RockButton>
                <RockButton :btnType="BtnType.Link"
                            @click="onCancel">
                    Cancel
                </RockButton>
            </template>

        </Panel>
    </RockForm>
</template>

<script setup lang="ts">
    import { computed, ref, watch } from "vue";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import HighlightLabel from "@Obsidian/Controls/highlightLabel.obs";
    import ExperienceModePicker from "@Obsidian/Controls/experienceModePicker.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import FirstNameTextBox from "@Obsidian/Controls/firstNameTextBox.obs";
    import DefinedValuePicker from "@Obsidian/Controls/definedValuePicker.obs";
    import ImageEditor from "@Obsidian/Controls/imageEditor.obs";
    import StaticFormControl from "@Obsidian/Controls/staticFormControl.obs";
    import DatePicker from "@Obsidian/Controls/datePicker.obs";
    import ConditionalWell from "@Obsidian/Controls/conditionalWell.obs";
    import ContentSectionContainer from "@Obsidian/Controls/contentSectionContainer.obs";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import RadioButtonList from "@Obsidian/Controls/radioButtonList.obs";
    import BirthdayPicker from "@Obsidian/Controls/birthdayPicker.obs";
    import GradePicker from "@Obsidian/Controls/gradePicker.obs";
    import YearPicker from "@Obsidian/Controls/yearPicker.obs";
    import RacePicker from "@Obsidian/Controls/racePicker.obs";
    import EthnicityPicker from "@Obsidian/Controls/ethnicityPicker.obs";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import InlineCheckBox from "@Obsidian/Controls/inlineCheckBox.obs";
    import HelpBlock from "@Obsidian/Controls/helpBlock.obs";
    import PhoneNumberBox from "@Obsidian/Controls/phoneNumberBox.obs";
    import EmailBox from "@Obsidian/Controls/emailBox.obs";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { Gender, GenderDescription } from "@Obsidian/Enums/Crm/gender";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { setPropertiesBoxValue, useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { makeUrlRedirectSafe } from "@Obsidian/Utility/url";
    import { areEqual } from "@Obsidian/Utility/guid";
    import { BinaryFiletype } from "@Obsidian/SystemGuids/binaryFiletype";
    import { DefinedType } from "@Obsidian/SystemGuids/definedType";
    import { DefinedValue } from "@Obsidian/SystemGuids/definedValue";
    import { NavigationUrlKey } from "./EditPerson/types.partial";
    import { DetailBlockBox } from "@Obsidian/ViewModels/Blocks/detailBlockBox";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { BirthdayPickerBag } from "@Obsidian/ViewModels/Controls/birthdayPickerBag";
    import { ValidationRule } from "@Obsidian/ValidationRules";
    import { EditPersonBag } from "@Obsidian/ViewModels/Blocks/Crm/PersonDetail/EditPerson/editPersonBag";
    import { EditPersonOptionsBag } from "@Obsidian/ViewModels/Blocks/Crm/PersonDetail/EditPerson/editPersonOptionsBag";
    import { EditPersonPhoneNumberBag } from "@Obsidian/ViewModels/Blocks/Crm/PersonDetail/EditPerson/editPersonPhoneNumberBag";

    const config = useConfigurationValues<DetailBlockBox<EditPersonBag, EditPersonOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const blockError = ref("");
    const errorMessage = ref("");

    const isSaving = ref(false);
    const isNavigating = ref(false);
    const submitForm = ref(false);

    // Personal Information > Name
    const title = ref<ListItemBag | null>(config.entity?.title ?? null);
    const firstName = ref(config.entity?.firstName ?? "");
    const nickName = ref(config.entity?.nickName ?? "");
    const middleName = ref(config.entity?.middleName ?? "");
    const lastName = ref(config.entity?.lastName ?? "");
    const suffix = ref<ListItemBag | null>(config.entity?.suffix ?? null);

    // Status & Photo (left column)
    const recordStatus = ref<ListItemBag | null>(config.entity?.recordStatus ?? null);
    const connectionStatus = ref<ListItemBag | null>(config.entity?.connectionStatus ?? null);
    const recordSource = ref<ListItemBag | null>(config.entity?.recordSource ?? null);
    const recordStatusReason = ref<ListItemBag | null>(config.entity?.recordStatusReason ?? null);
    const deceasedDate = ref(config.entity?.deceasedDate ?? "");
    const inactiveReasonNote = ref(config.entity?.inactiveReasonNote ?? "");
    const photo = ref<ListItemBag | null>(config.entity?.photo ?? null);

    // Demographics
    // Ordered to match the design (Unknown last), which the shared GenderPicker cannot do.
    const genderItems: ListItemBag[] = [
        { text: GenderDescription[Gender.Male], value: Gender.Male.toString() },
        { text: GenderDescription[Gender.Female], value: Gender.Female.toString() },
        { text: GenderDescription[Gender.Unknown], value: Gender.Unknown.toString() }
    ];
    const gender = ref((config.entity?.gender ?? Gender.Unknown).toString());
    const birthDate = ref<BirthdayPickerBag | null>(config.entity?.birthDate ?? null);
    const grade = ref<ListItemBag | null>(config.entity?.grade ?? null);
    const graduationYear = ref(config.entity?.graduationYear?.toString() ?? "");
    const maritalStatus = ref<ListItemBag | null>(config.entity?.maritalStatus ?? null);
    const anniversaryDate = ref(config.entity?.anniversaryDate ?? "");
    const race = ref<ListItemBag | null>(config.entity?.race ?? null);
    const ethnicity = ref<ListItemBag | null>(config.entity?.ethnicity ?? null);
    const isLockedAsChild = ref(config.entity?.isLockedAsChild ?? false);

    // Communication > Contact Info
    // Coerce the number and country code to strings so the PhoneNumberBox formatter never receives null.
    // No ref type annotation: inference keeps number/countryCode as non-null strings from the map below.
    const phoneNumbers = ref((config.entity?.phoneNumbers ?? []).map(phoneNumber => ({
        ...phoneNumber,
        number: phoneNumber.number ?? "",
        countryCode: phoneNumber.countryCode ?? ""
    })));
    const email = ref(config.entity?.email ?? "");
    const isEmailActive = ref(config.entity?.isEmailActive ?? false);

    // #endregion Values

    // #region Computed Values

    const options = computed((): EditPersonOptionsBag => {
        return config.options ?? {} as EditPersonOptionsBag;
    });

    const panelTitle = computed<string>(() => {
        const displayName = [nickName.value || firstName.value, lastName.value]
            .filter(name => !!name)
            .join(" ")
            .trim();

        return displayName || "Person";
    });

    const protectionProfileAlertType = computed<AlertType>(() => {
        return options.value.accountProtectionProfileAlertType?.toLowerCase() === "danger"
            ? AlertType.Danger
            : AlertType.Warning;
    });

    const isRecordInactive = computed<boolean>(() => {
        return areEqual(recordStatus.value?.value, DefinedValue.PersonRecordStatusInactive);
    });

    const isReasonDeceased = computed<boolean>(() => {
        return areEqual(recordStatusReason.value?.value, DefinedValue.PersonRecordStatusReasonDeceased);
    });

    const familyInactiveMessage = computed<string>(() => {
        const personName = nickName.value || firstName.value || "This person";
        const family = options.value.familyName || "family";
        return `${personName} is the only active member of the ${family}. Saving will also mark the family inactive.`;
    });

    const isGradeShown = computed<boolean>(() => !options.value.isGradeHidden);

    const isMarried = computed<boolean>(() => {
        return areEqual(maritalStatus.value?.value, DefinedValue.PersonMaritalStatusMarried);
    });

    const isAnniversaryShown = computed<boolean>(() => isMarried.value && !options.value.isAnniversaryDateHidden);

    const isRaceShown = computed<boolean>(() => (options.value.raceOption ?? "Hide") !== "Hide");
    const isRaceRequired = computed<boolean>(() => options.value.raceOption === "Required");

    const isEthnicityShown = computed<boolean>(() => (options.value.ethnicityOption ?? "Hide") !== "Hide");
    const isEthnicityRequired = computed<boolean>(() => options.value.ethnicityOption === "Required");

    // Mirror the block setting (WebForms parity): once a birth month and day are present, the year
    // becomes required. The rule reads the birthDate ref directly because RockFormField hands it a
    // date-key string, not the BirthdayPickerBag.
    const birthDateRules = computed<ValidationRule[]>(() => {
        if (!options.value.isCompleteBirthDateRequired) {
            return [];
        }

        return [(): string | boolean => {
            const value = birthDate.value;
            if (value && value.month && value.day && !value.year) {
                return "Birth Date requires a year.";
            }
            return true;
        }];
    });

    // A deceased date, once entered, may not precede a complete birth date (matches WebForms).
    // Only enforced when the birth date has a year; the server re-checks authoritatively.
    const deceasedDateRules = computed<ValidationRule[]>(() => {
        return [(): string | boolean => {
            const bd = birthDate.value;
            if (!deceasedDate.value || !bd || !bd.year || !bd.month || !bd.day) {
                return true;
            }

            const deceased = toComparableDate(deceasedDate.value);
            if (deceased === null) {
                return true;
            }

            const birth = bd.year * 10000 + bd.month * 100 + bd.day;
            if (deceased < birth) {
                return "Deceased Date must be on or after the birth date.";
            }
            return true;
        }];
    });

    // #endregion Computed Values

    // #region Functions

    /**
     * Parses a date string (ISO "yyyy-MM-dd" or US "M/D/yyyy") into a comparable yyyymmdd number,
     * or null when the format is unrecognized (in which case the server performs the check).
     */
    function toComparableDate(dateString: string): number | null {
        const iso = dateString.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
        if (iso) {
            return Number(iso[1]) * 10000 + Number(iso[2]) * 100 + Number(iso[3]);
        }

        const us = dateString.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
        if (us) {
            return Number(us[3]) * 10000 + Number(us[1]) * 100 + Number(us[2]);
        }

        return null;
    }

    /**
     * Keeps the Graduation Year in step with the selected Grade, matching the WebForms grade picker.
     * Grade and Graduation Year are two views of the same stored value.
     */
    function syncGraduationYearFromGrade(): void {
        const offsetText = grade.value?.value;

        if (!offsetText) {
            return;
        }

        const expectedYear = (options.value.gradeTransitionYear + options.value.gradeOffsetAdjustment + Number(offsetText)).toString();

        // Guard against a feedback loop with the reverse watcher; only write when it actually differs.
        if (graduationYear.value !== expectedYear) {
            graduationYear.value = expectedYear;
        }
    }

    /**
     * Keeps the Grade in step with the entered Graduation Year, matching the WebForms grade picker.
     */
    function syncGradeFromGraduationYear(): void {
        let expectedOffset = "";

        if (graduationYear.value) {
            const offset = Number(graduationYear.value) - options.value.gradeTransitionYear - options.value.gradeOffsetAdjustment;
            expectedOffset = offset >= 0 ? offset.toString() : "";
        }

        if ((grade.value?.value ?? "") !== expectedOffset) {
            grade.value = expectedOffset ? { value: expectedOffset } : null;
        }
    }

    // #endregion Functions

    // #region Watchers

    // Redesign bug fix: when the record returns to Active, hide and clear the inactive-only fields.
    watch(isRecordInactive, (inactive) => {
        if (!inactive) {
            recordStatusReason.value = null;
            deceasedDate.value = "";
            inactiveReasonNote.value = "";
        }
    });

    // Clear the deceased date when the reason is no longer Deceased.
    watch(isReasonDeceased, (deceased) => {
        if (!deceased) {
            deceasedDate.value = "";
        }
    });

    // Keep Grade and Graduation Year in sync (they represent the same stored value).
    watch(grade, syncGraduationYearFromGrade);
    watch(graduationYear, syncGradeFromGraduationYear);

    // #endregion Watchers

    // #region Event Handlers

    /**
     * Enforces a single SMS-enabled number: turning SMS on for one row turns it off for every other.
     */
    function onSmsChanged(changed: EditPersonPhoneNumberBag, isEnabled: boolean): void {
        phoneNumbers.value.forEach(phoneNumber => {
            phoneNumber.isMessagingEnabled = isEnabled && phoneNumber.phoneTypeGuid === changed.phoneTypeGuid;
        });
    }

    /**
     * Saves the edited person and redirects to the person profile on success.
     */
    async function onSave(): Promise<void> {
        errorMessage.value = "";
        isSaving.value = true;

        try {
            // Only the edited fields are marked valid; the server writes just those, leaving
            // unbuilt sections untouched.
            const box: ValidPropertiesBox<EditPersonBag> = {
                bag: { ...config.entity } as EditPersonBag
            };

            setPropertiesBoxValue(box, "title", title.value);
            setPropertiesBoxValue(box, "firstName", firstName.value);
            setPropertiesBoxValue(box, "nickName", nickName.value);
            setPropertiesBoxValue(box, "middleName", middleName.value);
            setPropertiesBoxValue(box, "lastName", lastName.value);
            setPropertiesBoxValue(box, "suffix", suffix.value);
            setPropertiesBoxValue(box, "recordStatus", recordStatus.value);
            setPropertiesBoxValue(box, "connectionStatus", connectionStatus.value);
            setPropertiesBoxValue(box, "recordSource", recordSource.value);
            setPropertiesBoxValue(box, "recordStatusReason", recordStatusReason.value);
            setPropertiesBoxValue(box, "deceasedDate", deceasedDate.value);
            setPropertiesBoxValue(box, "inactiveReasonNote", inactiveReasonNote.value);
            setPropertiesBoxValue(box, "photo", photo.value);

            // Demographics. Grade is not sent; only Graduation Year is persisted (the two are the same
            // stored value, kept in sync client-side).
            setPropertiesBoxValue(box, "gender", Number(gender.value) as Gender);
            setPropertiesBoxValue(box, "birthDate", birthDate.value);
            setPropertiesBoxValue(box, "graduationYear", graduationYear.value ? Number(graduationYear.value) : null);
            setPropertiesBoxValue(box, "maritalStatus", maritalStatus.value);
            setPropertiesBoxValue(box, "anniversaryDate", anniversaryDate.value);
            setPropertiesBoxValue(box, "race", race.value);
            setPropertiesBoxValue(box, "ethnicity", ethnicity.value);
            setPropertiesBoxValue(box, "isLockedAsChild", isLockedAsChild.value);

            // Communication > Contact Info.
            setPropertiesBoxValue(box, "phoneNumbers", phoneNumbers.value);
            setPropertiesBoxValue(box, "email", email.value);
            setPropertiesBoxValue(box, "isEmailActive", isEmailActive.value);

            const result = await invokeBlockAction<ValidPropertiesBox<EditPersonBag> | string>("Save", { box });

            if (result.isSuccess && result.data) {
                if (result.statusCode === 200 && typeof result.data === "string") {
                    isNavigating.value = true;
                    window.location.href = makeUrlRedirectSafe(result.data);
                }
            }
            else {
                errorMessage.value = result.errorMessage ?? "Unknown error while trying to save the person.";
            }
        }
        finally {
            isSaving.value = false;
        }
    }

    /**
     * Returns to the person profile without saving.
     */
    function onCancel(): void {
        const parentPageUrl = config.navigationUrls?.[NavigationUrlKey.ParentPage];

        if (parentPageUrl) {
            isNavigating.value = true;
            window.location.href = makeUrlRedirectSafe(parentPageUrl);
        }
    }

    /**
     * Begins the form submission process.
     */
    function onStartSubmitForm(): void {
        submitForm.value = true;
    }

    // #endregion Event Handlers

    // Handle any initial error conditions.
    if (config.errorMessage) {
        blockError.value = config.errorMessage;
    }
    else if (!config.entity) {
        blockError.value = "The person you are trying to edit could not be found.";
    }
</script>
