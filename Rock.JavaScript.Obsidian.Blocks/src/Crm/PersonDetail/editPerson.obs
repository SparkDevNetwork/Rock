<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <NotificationBox v-if="blockError" alertType="warning" v-html="blockError" />

    <RockForm v-else v-model:submit="submitForm" @submit="onSave">
        <Panel type="block"
               :title="panelTitle"
               titleIconCssClass="ti ti-user">

            <template #headerActions>
                <ExperienceModePicker />

                <HighlightLabel v-if="options.familyName"
                                labelType="default"
                                iconCssClass="ti ti-users">
                    {{ options.familyName }}
                </HighlightLabel>

                <HighlightLabel v-if="options.campusName"
                                labelType="campus"
                                iconCssClass="ti ti-building">
                    {{ options.campusName }}
                </HighlightLabel>
            </template>

            <NotificationBox v-if="errorMessage" alertType="danger" class="mb-3" v-html="errorMessage" />

            <NotificationBox v-if="options.accountProtectionProfileMessage"
                             :alertType="protectionProfileAlertType"
                             class="mb-3">
                {{ options.accountProtectionProfileMessage }}
            </NotificationBox>

            <div class="row">
                <div class="col-md-3 mb-4">
                    <ContentSection light>
                        <div>
                            <ImageEditor v-model="photo"
                                         :binaryFileTypeGuid="BinaryFiletype.PersonImage"
                                         :noPictureUrl="options.noPictureUrl ?? undefined"
                                         label="Profile Photo"
                                         help="The photo shown with this person throughout Rock, including check-in and directories." />

                            <DefinedValuePicker v-if="options.isConnectionStatusEditable"
                                                v-model="connectionStatus"
                                                :definedTypeGuid="DefinedType.PersonConnectionStatus"
                                                label="Connection Status"
                                                help="This person's relationship to your church, such as Member or Attendee."
                                                rules="required" />
                            <StaticFormControl v-else label="Connection Status" :modelValue="connectionStatus?.text ?? ''" />

                            <DefinedValuePicker v-if="options.isRecordStatusEditable"
                                                v-model="recordStatus"
                                                :definedTypeGuid="DefinedType.PersonRecordStatus"
                                                label="Record Status"
                                                help="Whether this person's record is active. Inactive retires a record without deleting it."
                                                :showBlankItem="false" />
                            <StaticFormControl v-else label="Record Status" :modelValue="recordStatus?.text ?? ''" />

                            <p v-if="isRecordInactive && options.isOnlyActiveFamilyMember" class="text-muted mb-3">
                                {{ familyInactiveMessage }}
                            </p>

                            <ConditionalWell v-if="isRecordInactive">
                                <DefinedValuePicker v-if="options.isRecordStatusEditable"
                                                    v-model="recordStatusReason"
                                                    :definedTypeGuid="DefinedType.PersonRecordStatusReason"
                                                    label="Reason"
                                                    help="Why this record is inactive. Used for reporting on why people leave."
                                                    :showBlankItem="true" />
                                <StaticFormControl v-else label="Reason" :modelValue="recordStatusReason?.text ?? ''" />

                                <DatePicker v-if="isReasonDeceased && options.isRecordStatusEditable"
                                            v-model="deceasedDate"
                                            label="Deceased Date"
                                            help="The date this person passed away. Must be on or after their birth date." />
                                <StaticFormControl v-else-if="isReasonDeceased" label="Deceased Date" :modelValue="deceasedDate" />

                                <TextBox v-if="options.isRecordStatusEditable"
                                         v-model="inactiveReasonNote"
                                         label="Note"
                                         textMode="multiline"
                                         :rows="3"
                                         help="Additional detail about why this record is inactive." />
                                <StaticFormControl v-else label="Note" :modelValue="inactiveReasonNote" />
                            </ConditionalWell>

                            <DefinedValuePicker v-if="options.isRecordSourceEditable"
                                                v-model="recordSource"
                                                :definedTypeGuid="DefinedType.RecordSourceType"
                                                label="Record Source"
                                                help="How this record first entered Rock. Set automatically when the record is created; changing it replaces the original attribution."
                                                :showBlankItem="true" />
                            <StaticFormControl v-else label="Record Source" :modelValue="recordSource?.text ?? ''" />
                        </div>
                    </ContentSection>
                </div>
                <div class="col-md-9">
                    <ContentSectionContainer :sidebar="false">
                        <ContentSection title="Personal Information"
                                        icon="ti ti-user-circle"
                                        disableCollapse>
                            <ContentStack title="Name"
                                          description="Enter the person's legal name, plus the name they go by. Rock shows the nickname wherever their name appears.">
                                <div class="row">
                                    <div class="col-md-12">
                                        <DefinedValuePicker v-model="title"
                                                            :definedTypeGuid="DefinedType.PersonTitle"
                                                            label="Title"
                                                            class="input-width-md"
                                                            :showBlankItem="true" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <FirstNameTextBox v-model="firstName"
                                                          label="First Name"
                                                          help="The person's legal first name."
                                                          rules="nospecialcharacters|noemojisorspecialfonts" />
                                    </div>
                                    <div class="col-md-6">
                                        <TextBox v-model="nickName"
                                                 label="Nickname"
                                                 help="The name this person goes by. Rock uses it wherever their name is displayed. When blank, the first name is used."
                                                 rules="nospecialcharacters|noemojisorspecialfonts" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <TextBox v-model="middleName"
                                                 label="Middle Name"
                                                 rules="nospecialcharacters|noemojisorspecialfonts" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <TextBox v-model="lastName"
                                                 label="Last Name"
                                                 rules="nospecialcharacters|noemojisorspecialfonts" />
                                    </div>
                                    <div class="col-md-6">
                                        <DefinedValuePicker v-model="suffix"
                                                            :definedTypeGuid="DefinedType.PersonSuffix"
                                                            label="Suffix"
                                                            class="input-width-md"
                                                            :showBlankItem="true" />
                                    </div>
                                </div>
                            </ContentStack>
                        </ContentSection>
                    </ContentSectionContainer>
                </div>
            </div>

            <template #footerActions>
                <RockButton :btnType="BtnType.Primary"
                            :isLoading="isSaving"
                            autoDisable
                            autoLoading
                            @click="onStartSubmitForm">
                    Save
                </RockButton>
                <RockButton :btnType="BtnType.Link"
                            @click="onCancel">
                    Cancel
                </RockButton>
            </template>

        </Panel>
    </RockForm>
</template>

<script setup lang="ts">
    import { computed, ref, watch } from "vue";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import HighlightLabel from "@Obsidian/Controls/highlightLabel.obs";
    import ExperienceModePicker from "@Obsidian/Controls/experienceModePicker.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import FirstNameTextBox from "@Obsidian/Controls/firstNameTextBox.obs";
    import DefinedValuePicker from "@Obsidian/Controls/definedValuePicker.obs";
    import ImageEditor from "@Obsidian/Controls/imageEditor.obs";
    import StaticFormControl from "@Obsidian/Controls/staticFormControl.obs";
    import DatePicker from "@Obsidian/Controls/datePicker.obs";
    import ConditionalWell from "@Obsidian/Controls/conditionalWell.obs";
    import ContentSectionContainer from "@Obsidian/Controls/contentSectionContainer.obs";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { setPropertiesBoxValue, useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { makeUrlRedirectSafe } from "@Obsidian/Utility/url";
    import { areEqual } from "@Obsidian/Utility/guid";
    import { BinaryFiletype } from "@Obsidian/SystemGuids/binaryFiletype";
    import { DefinedType } from "@Obsidian/SystemGuids/definedType";
    import { DefinedValue } from "@Obsidian/SystemGuids/definedValue";
    import { NavigationUrlKey } from "./EditPerson/types.partial";
    import { DetailBlockBox } from "@Obsidian/ViewModels/Blocks/detailBlockBox";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { EditPersonBag } from "@Obsidian/ViewModels/Blocks/Crm/PersonDetail/EditPerson/editPersonBag";
    import { EditPersonOptionsBag } from "@Obsidian/ViewModels/Blocks/Crm/PersonDetail/EditPerson/editPersonOptionsBag";

    const config = useConfigurationValues<DetailBlockBox<EditPersonBag, EditPersonOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const blockError = ref("");
    const errorMessage = ref("");

    const isSaving = ref(false);
    const isNavigating = ref(false);
    const submitForm = ref(false);

    // Personal Information > Name
    const title = ref<ListItemBag | null>(config.entity?.title ?? null);
    const firstName = ref(config.entity?.firstName ?? "");
    const nickName = ref(config.entity?.nickName ?? "");
    const middleName = ref(config.entity?.middleName ?? "");
    const lastName = ref(config.entity?.lastName ?? "");
    const suffix = ref<ListItemBag | null>(config.entity?.suffix ?? null);

    // Status & Photo (left column)
    const recordStatus = ref<ListItemBag | null>(config.entity?.recordStatus ?? null);
    const connectionStatus = ref<ListItemBag | null>(config.entity?.connectionStatus ?? null);
    const recordSource = ref<ListItemBag | null>(config.entity?.recordSource ?? null);
    const recordStatusReason = ref<ListItemBag | null>(config.entity?.recordStatusReason ?? null);
    const deceasedDate = ref(config.entity?.deceasedDate ?? "");
    const inactiveReasonNote = ref(config.entity?.inactiveReasonNote ?? "");
    const photo = ref<ListItemBag | null>(config.entity?.photo ?? null);

    // #endregion Values

    // #region Computed Values

    const options = computed((): EditPersonOptionsBag => {
        return config.options ?? {} as EditPersonOptionsBag;
    });

    const panelTitle = computed<string>(() => {
        const displayName = [nickName.value || firstName.value, lastName.value]
            .filter(name => !!name)
            .join(" ")
            .trim();

        return displayName || "Person";
    });

    const protectionProfileAlertType = computed<AlertType>(() => {
        return options.value.accountProtectionProfileAlertType?.toLowerCase() === "danger"
            ? AlertType.Danger
            : AlertType.Warning;
    });

    const isRecordInactive = computed<boolean>(() => {
        return areEqual(recordStatus.value?.value, DefinedValue.PersonRecordStatusInactive);
    });

    const isReasonDeceased = computed<boolean>(() => {
        return areEqual(recordStatusReason.value?.value, DefinedValue.PersonRecordStatusReasonDeceased);
    });

    const familyInactiveMessage = computed<string>(() => {
        const personName = nickName.value || firstName.value || "This person";
        const family = options.value.familyName || "family";
        return `${personName} is the only active member of the ${family}. Saving will also mark the family inactive.`;
    });

    // #endregion Computed Values

    // #region Watchers

    // Redesign bug fix: when the record returns to Active, hide and clear the inactive-only fields.
    watch(isRecordInactive, (inactive) => {
        if (!inactive) {
            recordStatusReason.value = null;
            deceasedDate.value = "";
            inactiveReasonNote.value = "";
        }
    });

    // Clear the deceased date when the reason is no longer Deceased.
    watch(isReasonDeceased, (deceased) => {
        if (!deceased) {
            deceasedDate.value = "";
        }
    });

    // #endregion Watchers

    // #region Event Handlers

    /**
     * Saves the edited person and redirects to the person profile on success.
     */
    async function onSave(): Promise<void> {
        errorMessage.value = "";
        isSaving.value = true;

        try {
            // Only the edited fields are marked valid; the server writes just those, leaving
            // unbuilt sections untouched.
            const box: ValidPropertiesBox<EditPersonBag> = {
                bag: { ...config.entity } as EditPersonBag
            };

            setPropertiesBoxValue(box, "title", title.value);
            setPropertiesBoxValue(box, "firstName", firstName.value);
            setPropertiesBoxValue(box, "nickName", nickName.value);
            setPropertiesBoxValue(box, "middleName", middleName.value);
            setPropertiesBoxValue(box, "lastName", lastName.value);
            setPropertiesBoxValue(box, "suffix", suffix.value);
            setPropertiesBoxValue(box, "recordStatus", recordStatus.value);
            setPropertiesBoxValue(box, "connectionStatus", connectionStatus.value);
            setPropertiesBoxValue(box, "recordSource", recordSource.value);
            setPropertiesBoxValue(box, "recordStatusReason", recordStatusReason.value);
            setPropertiesBoxValue(box, "deceasedDate", deceasedDate.value);
            setPropertiesBoxValue(box, "inactiveReasonNote", inactiveReasonNote.value);
            setPropertiesBoxValue(box, "photo", photo.value);

            const result = await invokeBlockAction<ValidPropertiesBox<EditPersonBag> | string>("Save", { box });

            if (result.isSuccess && result.data) {
                if (result.statusCode === 200 && typeof result.data === "string") {
                    isNavigating.value = true;
                    window.location.href = makeUrlRedirectSafe(result.data);
                }
            }
            else {
                errorMessage.value = result.errorMessage ?? "Unknown error while trying to save the person.";
            }
        }
        finally {
            isSaving.value = false;
        }
    }

    /**
     * Returns to the person profile without saving.
     */
    function onCancel(): void {
        const parentPageUrl = config.navigationUrls?.[NavigationUrlKey.ParentPage];

        if (parentPageUrl) {
            isNavigating.value = true;
            window.location.href = makeUrlRedirectSafe(parentPageUrl);
        }
    }

    /**
     * Begins the form submission process.
     */
    function onStartSubmitForm(): void {
        submitForm.value = true;
    }

    // #endregion Event Handlers

    // Handle any initial error conditions.
    if (config.errorMessage) {
        blockError.value = config.errorMessage;
    }
    else if (!config.entity) {
        blockError.value = "The person you are trying to edit could not be found.";
    }
</script>
