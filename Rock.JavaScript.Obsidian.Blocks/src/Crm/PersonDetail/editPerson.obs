<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <NotificationBox v-if="blockError" alertType="warning" v-html="blockError" />

    <RockForm v-else v-model:submit="submitForm" @submit="onSave">
        <Panel type="block"
               :title="panelTitle"
               titleIconCssClass="ti ti-user">

            <template #headerActions>
                <ExperienceModePicker />

                <HighlightLabel v-if="options.familyName"
                                labelType="default"
                                iconCssClass="ti ti-users">
                    {{ options.familyName }}
                </HighlightLabel>

                <HighlightLabel v-if="options.campusName"
                                labelType="campus"
                                iconCssClass="ti ti-building">
                    {{ options.campusName }}
                </HighlightLabel>
            </template>

            <NotificationBox v-if="errorMessage" alertType="danger" class="mb-3" v-html="errorMessage" />

            <NotificationBox v-if="options.accountProtectionProfileMessage"
                             :alertType="protectionProfileAlertType"
                             class="mb-3">
                {{ options.accountProtectionProfileMessage }}
            </NotificationBox>

            <EditPanel v-model="editBag"
                       :options="options"
                       @propertyChanged="baseBlock.onPropertyChanged" />

            <template #footerActions>
                <RockButton :btnType="BtnType.Primary"
                            :isLoading="isSaving"
                            autoDisable
                            autoLoading
                            @click="onStartSubmitForm">
                    Save
                </RockButton>
                <RockButton :btnType="BtnType.Link"
                            @click="onCancel">
                    Cancel
                </RockButton>
            </template>

        </Panel>
    </RockForm>
</template>

<script setup lang="ts">
    import { computed, ref } from "vue";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import HighlightLabel from "@Obsidian/Controls/highlightLabel.obs";
    import ExperienceModePicker from "@Obsidian/Controls/experienceModePicker.obs";
    import EditPanel from "./EditPerson/editPanel.partial.obs";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { useConfigurationValues, useInvokeBlockAction, useEntityDetailBlock } from "@Obsidian/Utility/block";
    import { makeUrlRedirectSafe } from "@Obsidian/Utility/url";
    import { NavigationUrlKey } from "./EditPerson/types.partial";
    import { DetailBlockBox } from "@Obsidian/ViewModels/Blocks/detailBlockBox";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";
    import { EditPersonBag } from "@Obsidian/ViewModels/Blocks/Crm/PersonDetail/EditPerson/editPersonBag";
    import { EditPersonOptionsBag } from "@Obsidian/ViewModels/Blocks/Crm/PersonDetail/EditPerson/editPersonOptionsBag";

    const config = useConfigurationValues<DetailBlockBox<EditPersonBag, EditPersonOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const blockError = ref("");
    const errorMessage = ref("");

    const editBag = ref<ValidPropertiesBox<EditPersonBag>>({
        bag: config.entity ?? {} as EditPersonBag,
        validProperties: config.entity ? Object.keys(config.entity) : null
    });

    const isSaving = ref(false);
    const isNavigating = ref(false);
    const submitForm = ref(false);

    const baseBlock = useEntityDetailBlock({
        blockConfig: config,
        entity: editBag
    });

    // #endregion Values

    // #region Computed Values

    const options = computed((): EditPersonOptionsBag => {
        return config.options ?? {} as EditPersonOptionsBag;
    });

    const panelTitle = computed<string>(() => {
        const bag = editBag.value.bag;

        const displayName = [bag?.nickName || bag?.firstName, bag?.lastName]
            .filter(name => !!name)
            .join(" ")
            .trim();

        return displayName || "Person";
    });

    const protectionProfileAlertType = computed<AlertType>(() => {
        return options.value.accountProtectionProfileAlertType?.toLowerCase() === "danger"
            ? AlertType.Danger
            : AlertType.Warning;
    });

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Saves the edited person and redirects to the person profile on success.
     */
    async function onSave(): Promise<void> {
        errorMessage.value = "";
        isSaving.value = true;

        try {
            const result = await invokeBlockAction<ValidPropertiesBox<EditPersonBag> | string>("Save", {
                box: editBag.value
            });

            if (result.isSuccess && result.data) {
                if (result.statusCode === 200 && typeof result.data === "string") {
                    isNavigating.value = true;
                    window.location.href = makeUrlRedirectSafe(result.data);
                }
            }
            else {
                errorMessage.value = result.errorMessage ?? "Unknown error while trying to save the person.";
            }
        }
        finally {
            isSaving.value = false;
        }
    }

    /**
     * Returns to the person profile without saving.
     */
    function onCancel(): void {
        const parentPageUrl = config.navigationUrls?.[NavigationUrlKey.ParentPage];

        if (parentPageUrl) {
            isNavigating.value = true;
            window.location.href = makeUrlRedirectSafe(parentPageUrl);
        }
    }

    /**
     * Begins the form submission process.
     */
    function onStartSubmitForm(): void {
        submitForm.value = true;
    }

    // #endregion Event Handlers

    // Handle any initial error conditions.
    if (config.errorMessage) {
        blockError.value = config.errorMessage;
    }
    else if (!config.entity) {
        blockError.value = "The person you are trying to edit could not be found.";
    }
</script>
