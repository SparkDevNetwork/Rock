<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="key-attributes-edit">
        <RockForm @submit="onSave">
            <fieldset class="attribute-values">
                <RockField v-for="item in fieldItems"
                           :key="item.key"
                           :isEditMode="item.canEdit"
                           :attribute="item.attribute"
                           :modelValue="editValues[item.key]"
                           @update:modelValue="onValueChanged(item.key, $event)" />

                <div class="actions">
                    <button type="submit" accesskey="s" class="btn btn-primary btn-xs" :disabled="isSaving">Save</button>
                    <button type="button" accesskey="c" class="btn btn-link btn-xs" @click="onCancel">Cancel</button>
                </div>
            </fieldset>
        </RockForm>
    </div>
</template>

<style scoped>
.key-attributes-edit :deep(.form-control-static img) {
    max-width: 120px;
    height: auto;
}
</style>

<script setup lang="ts">
    import { computed, PropType, ref } from "vue";
    import RockField from "@Obsidian/Controls/rockField.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import { getSecurityGrant, provideSecurityGrant, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { alert } from "@Obsidian/Utility/dialogs";
    import { PublicAttributeBag } from "@Obsidian/ViewModels/Utility/publicAttributeBag";
    import { KeyAttributesEditBag } from "@Obsidian/ViewModels/Blocks/Crm/PersonDetail/KeyAttributes/keyAttributesEditBag";
    import { KeyAttributesViewBag } from "@Obsidian/ViewModels/Blocks/Crm/PersonDetail/KeyAttributes/keyAttributesViewBag";

    // #region Types

    type FieldItem = {
        key: string;
        canEdit: boolean;
        attribute: PublicAttributeBag;
    };

    // #endregion Types

    const props = defineProps({
        editBag: {
            type: Object as PropType<KeyAttributesEditBag>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "saved", value: KeyAttributesViewBag): void;
        (e: "cancel"): void;
    }>();

    // #region Values

    const invokeBlockAction = useInvokeBlockAction();
    const editValues = ref<Record<string, string>>({ ...(props.editBag.attributeValues ?? {}) });
    const isSaving = ref(false);

    // Field types that need extra security context read it from the provided grant.
    provideSecurityGrant(getSecurityGrant(props.editBag.securityGrantToken));

    // #endregion Values

    // #region Computed Values

    const fieldItems = computed((): FieldItem[] => {
        const attributes = props.editBag.attributes ?? {};

        return (props.editBag.fields ?? [])
            .filter(field => !!field.key && !!attributes[field.key])
            .map(field => ({
                key: field.key as string,
                canEdit: field.canEdit,
                attribute: attributes[field.key as string]
            }));
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onValueChanged(key: string, value: string): void {
        editValues.value[key] = value;
    }

    async function onSave(): Promise<void> {
        isSaving.value = true;

        try {
            // Only send values for attributes the person is allowed to edit.
            const attributeValues: Record<string, string> = {};

            for (const field of props.editBag.fields ?? []) {
                if (field.canEdit && field.key) {
                    attributeValues[field.key] = editValues.value[field.key] ?? "";
                }
            }

            const result = await invokeBlockAction<KeyAttributesViewBag>("SaveAttributeValues", { attributeValues });

            if (result.isSuccess && result.data) {
                emit("saved", result.data);
            }
            else {
                await alert(result.errorMessage || "Unable to save the attribute values.");
            }
        }
        finally {
            isSaving.value = false;
        }
    }

    function onCancel(): void {
        emit("cancel");
    }

    // #endregion Event Handlers
</script>
