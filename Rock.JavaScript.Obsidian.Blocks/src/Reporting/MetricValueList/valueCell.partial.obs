<template>
    {{ formattedValue }}
</template>

<script setup lang="ts">
    import { standardCellProps } from "@Obsidian/Core/Controls/grid";
    import { computed } from "vue";

    const props = defineProps(standardCellProps);

    // Render the raw number without locale grouping separators to match the
    // WebForms RockBoundField output (e.g. "1234.5", not "1,234.5").
    const formattedValue = computed((): string => {
        if (!props.column.field) {
            return "";
        }

        const value = props.row[props.column.field];

        if (typeof value !== "number") {
            return "";
        }

        return value.toLocaleString(undefined, { useGrouping: false });
    });
</script>
