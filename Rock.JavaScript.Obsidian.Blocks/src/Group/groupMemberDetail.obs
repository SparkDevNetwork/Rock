<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <NotificationBox v-if="blockError" alertType="warning" v-html="blockError" />

    <RockForm v-else v-model:submit="submitForm" @submit="onSave">
        <Panel type="block"
               :title="panelTitle"
               :titleIconCssClass="panelIconCssClass">

            <template #headerActions>
                <HighlightLabel v-if="options.addedDateText" labelType="default">{{ options.addedDateText }}</HighlightLabel>
                <!-- TODO: Archived HighlightLabel, Communicate and Move header buttons, ellipsis menu with Audit Details modal. -->
            </template>

            <NotificationBox v-if="errorMessage" alertType="danger" v-html="errorMessage" />
            <NotificationBox v-if="successMessage" alertType="success">{{ successMessage }}</NotificationBox>

            <ContentSectionContainer :sidebar="false">
                <ContentSection disableCollapse
                                light>
                    <div>
                        <div class="row">
                            <div class="col-md-6">
                                <PersonPicker v-if="!isExistingMember"
                                              v-model="person"
                                              label="Person"
                                              rules="required"
                                              :disabled="!isEditable" />
                                <StaticFormControl v-else label="Person" :modelValue="personName">
                                    <div class="d-flex align-items-center">
                                        <PersonAvatar :personIdKey="options.personIdKey ?? ''"
                                                      :photoUrl="options.personPhotoUrl ?? ''"
                                                      marginRight="sm"
                                                      enableHoverInfo />
                                        <span>{{ personName }}</span>
                                    </div>

                                    <div v-for="registration in linkedRegistrations" :key="registration.value ?? ''">
                                        <a :href="registration.value ?? ''">{{ registration.text }}</a>
                                    </div>
                                </StaticFormControl>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <DropDownList v-model="roleId"
                                              label="Role"
                                              :help="roleHelpText"
                                              :items="options.roleItems ?? []"
                                              :showBlankItem="false"
                                              rules="required"
                                              :disabled="!isEditable || options.isRoleLockedBySync" />
                            </div>
                        </div>

                        <template v-if="areRequirementsShown">
                            <div class="mb-3">
                                <RockButton :btnSize="BtnSize.Small" @click="onRefreshRequirements">
                                    <i class="ti ti-refresh"></i> Refresh Requirements
                                </RockButton>
                                <span v-if="isRefreshSuccessShown" class="text-success ml-2">
                                    <i class="ti ti-circle-check"></i> Successfully Refreshed
                                </span>
                            </div>

                            <NotificationBox v-if="options.requirementCalculationErrors"
                                             alertType="danger"
                                             :details="options.requirementCalculationErrors">
                                An error occurred in one or more of the requirement calculations.
                            </NotificationBox>

                            <div v-if="requirementAlerts.length" class="row d-flex flex-wrap">
                                <div v-for="alert in requirementAlerts"
                                     :key="alert.groupRequirementGuid"
                                     class="col-md-4 mb-3">
                                    <div class="alert h-100 mb-0" :class="getRequirementAlertClass(alert)">
                                        <strong>{{ alert.title }}</strong>
                                        <div>{{ alert.statusText }}</div>
                                        <div v-if="alert.summary" class="mt-3">{{ alert.summary }}</div>
                                    </div>
                                </div>
                            </div>
                        </template>

                        <div class="row">
                            <div class="col-md-6">
                                <RadioButtonList v-model="memberStatus"
                                                 label="Member Status"
                                                 help="Whether this member is pending, active, or inactive in the group."
                                                 :items="options.statusItems ?? []"
                                                 :disabled="!isEditable" />
                            </div>
                        </div>

                        <TextBox v-model="note"
                                 label="Note"
                                 help="Internal notes about this member's involvement in the group."
                                 textMode="multiline"
                                 :rows="4"
                                 :disabled="!isEditable" />
                    </div>
                </ContentSection>

                <ContentSection title="Attributes" icon="ti ti-list-details">
                    <!-- TODO: Group Member Attributes stack (editable + viewable) and Group Member Assignment
                         Attributes stack (sign-up mode only) per conversion plan §9.3. Render the whole section
                         only when either stack has attributes. -->
                </ContentSection>

                <ContentSection v-if="options.isSchedulingEnabled" title="Scheduling" icon="ti ti-calendar" isCollapsed>
                    <!-- TODO: Schedule Settings stack (Schedule Template, Schedule Start Date required when a
                         template is set) and Assignment Preferences stack (grid + add/edit/delete) per conversion
                         plan §9.4. -->
                </ContentSection>

                <ContentSection title="Communication" icon="ti ti-message" isCollapsed>
                    <!-- TODO: Preferences stack (Communication Preference radios) and Notifications & Reminders
                         stack (Group Leaders Notified checkbox, Email Reminder Lead Time (Days) number box) per
                         conversion plan §9.5. -->
                </ContentSection>

                <ContentSection title="Administration" icon="ti ti-settings" isCollapsed>
                    <!-- TODO: Required Signed Documents stack (warning alert + Send/Resend button pending Open
                         Decision A + Signed Document uploader) and Chat Settings stack (Chat Muted, Chat Banned)
                         per conversion plan §9.6. -->
                </ContentSection>
            </ContentSectionContainer>

            <template #footerActions>
                <RockButton :btnType="BtnType.Primary" @click="onStartSubmitForm">Save</RockButton>
                <RockButton v-if="options.isSaveThenAddShown" :btnType="BtnType.Link" @click="onSaveThenAdd">Save Then Add</RockButton>
                <RockButton :btnType="BtnType.Link" @click="onCancel">Cancel</RockButton>
            </template>
        </Panel>
    </RockForm>

    <AssignmentPreferenceModal v-model="isAssignmentModalShown" />
    <RestoreArchivedModal v-model="isRestoreModalShown" />
    <MoveGroupMemberModal v-model="isMoveModalShown" />
    <QuickCommunicationModal v-model="isCommunicationModalShown" />
</template>

<script setup lang="ts">
    import { computed, ref } from "vue";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import HighlightLabel from "@Obsidian/Controls/highlightLabel.obs";
    import ContentSectionContainer from "@Obsidian/Controls/contentSectionContainer.obs";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    import PersonPicker from "@Obsidian/Controls/personPicker.obs";
    import PersonAvatar from "@Obsidian/Controls/personAvatar.obs";
    import StaticFormControl from "@Obsidian/Controls/staticFormControl.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import RadioButtonList from "@Obsidian/Controls/radioButtonList.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import AssignmentPreferenceModal from "./GroupMemberDetail/assignmentPreferenceModal.partial.obs";
    import RestoreArchivedModal from "./GroupMemberDetail/restoreArchivedModal.partial.obs";
    import MoveGroupMemberModal from "./GroupMemberDetail/moveGroupMemberModal.partial.obs";
    import QuickCommunicationModal from "./GroupMemberDetail/quickCommunicationModal.partial.obs";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { BtnSize } from "@Obsidian/Enums/Controls/btnSize";
    import { MeetsGroupRequirement } from "@Obsidian/Enums/Group/meetsGroupRequirement";
    import { useConfigurationValues } from "@Obsidian/Utility/block";
    import { DetailBlockBox } from "@Obsidian/ViewModels/Blocks/detailBlockBox";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { GroupMemberBag } from "@Obsidian/ViewModels/Blocks/Group/GroupMemberDetail/groupMemberBag";
    import { GroupMemberDetailOptionsBag } from "@Obsidian/ViewModels/Blocks/Group/GroupMemberDetail/groupMemberDetailOptionsBag";
    import { GroupMemberRequirementAlertBag } from "@Obsidian/ViewModels/Blocks/Group/GroupMemberDetail/groupMemberRequirementAlertBag";

    const config = useConfigurationValues<DetailBlockBox<GroupMemberBag, GroupMemberDetailOptionsBag>>();

    console.log("config:", config);
    // #region Values

    const blockError = ref(config.errorMessage ?? "");
    const errorMessage = ref("");
    const successMessage = ref("");
    const submitForm = ref(false);

    const options = ref(config.options ?? ({} as GroupMemberDetailOptionsBag));

    const isAssignmentModalShown = ref(false);
    const isRestoreModalShown = ref(false);
    const isMoveModalShown = ref(false);
    const isCommunicationModalShown = ref(false);

    const isEditable = config.isEditable === true;

    /** True once the member record exists; the person can no longer change. */
    const isExistingMember = !!config.entity?.idKey;

    const isRefreshSuccessShown = ref(false);

    // Member details section.
    const person = ref<ListItemBag | undefined>(config.entity?.person ?? undefined);
    const roleId = ref(config.entity?.groupRoleId?.toString() ?? "");
    const memberStatus = ref(config.entity?.groupMemberStatus?.toString() ?? "");
    const note = ref(config.entity?.note ?? "");

    // #endregion Values

    // #region Computed Values

    const panelTitle = computed((): string => {
        // TODO: Person full name, or "Add {GroupTerm} {GroupMemberTerm}" in add mode.
        return person.value?.text ?? "Group Member Detail";
    });

    const panelIconCssClass = computed((): string => {
        return options.value.groupIconCssClass || "ti ti-user";
    });

    const personName = computed((): string => {
        return person.value?.text ?? "";
    });

    /** The sync tooltip when Group Sync affects the role list, otherwise the standard helper text. */
    const roleHelpText = computed((): string => {
        return options.value.roleLockedMessage || "The role this person holds within the group.";
    });

    const linkedRegistrations = computed((): ListItemBag[] => {
        return options.value.linkedRegistrations ?? [];
    });

    const areRequirementsShown = computed((): boolean => {
        return options.value.hasGroupRequirements === true && options.value.areRequirementsHidden !== true;
    });

    const requirementAlerts = computed((): GroupMemberRequirementAlertBag[] => {
        return options.value.requirementAlerts ?? [];
    });

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Starts the RockForm submit so validation runs before onSave.
     */
    function onStartSubmitForm(): void {
        submitForm.value = true;
    }

    /**
     * Saves the group member via the Save block action.
     */
    async function onSave(): Promise<void> {
        // TODO: Assemble the ValidPropertiesBox from the field refs via setPropertiesBoxValue
        // (converting roleId/memberStatus back to numbers), invoke the Save block action, and
        // handle navigation, validation errors, and the restore prompt.
    }

    /**
     * Saves the group member, then reloads the page in add mode.
     */
    async function onSaveThenAdd(): Promise<void> {
        // TODO: Save, then full page reload with GroupMemberId=0 and carried parameters.
    }

    /**
     * Cancels editing and navigates back to the parent page or returnUrl.
     */
    function onCancel(): void {
        // TODO: Navigate to returnUrl or the parent page URL.
    }

    /**
     * Recalculates the group requirements and refreshes the inline alerts.
     */
    async function onRefreshRequirements(): Promise<void> {
        // TODO: Invoke the RefreshRequirements block action, replace options.requirementAlerts, then show the success text.
        isRefreshSuccessShown.value = true;
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Gets the alert style for a requirement alert based on its met state.
     */
    function getRequirementAlertClass(alert: GroupMemberRequirementAlertBag): string {
        switch (alert.meetsGroupRequirement) {
            case MeetsGroupRequirement.Meets:
                return "alert-success";

            case MeetsGroupRequirement.MeetsWithWarning:
                return "alert-warning";

            default:
                return "alert-danger";
        }
    }

    // #endregion Functions
</script>
