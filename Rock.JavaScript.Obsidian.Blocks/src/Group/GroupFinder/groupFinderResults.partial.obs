<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="group-finder-results-pane" :class="`is-columns-${columns}`">
        <div v-if="!isResultCountHidden" class="group-finder-result-count">
            <span>{{ resultCountText }}</span>
            <!-- Only while refreshing an already-populated list; the empty/initial load shows the single
                 centered indicator in the body instead, so the two never appear at once. -->
            <LoadingIndicator v-if="isLoading && cards.length > 0" isSmall />
        </div>

        <div v-if="cards.length" class="group-finder-results">
            <GroupFinderCard v-for="card in cards"
                             :key="card.groupGuid ?? ''"
                             :card="card"
                             :data-group-guid="card.groupGuid ?? ''"
                             :class="{ 'is-hovered': card.groupGuid === hoveredGroupGuid, 'is-selected': card.groupGuid === selectedGroupGuid }"
                             @mouseenter="$emit('update:hoveredGroupGuid', card.groupGuid ?? null)"
                             @mouseleave="$emit('update:hoveredGroupGuid', null)"
                             @select="$emit('update:selectedGroupGuid', card.groupGuid ?? null)" />
        </div>

        <!-- With no results yet, a fetch fills the grid with skeleton cards so the loading state reads on a
             wide screen; a refresh that already has cards keeps them and signals loading via the small count
             spinner instead. The skeleton shape follows the card chrome (media, title, text, optional CTA)
             without parsing the configurable Lava, so it approximates rather than mirrors the real card. -->
        <div v-else-if="isLoading" class="group-finder-results" aria-hidden="true">
            <div v-for="index in skeletonCount" :key="index" class="group-finder-skeleton-card">
                <div v-if="hasCardImage" class="skeleton skeleton-block group-finder-skeleton-media"></div>
                <div class="group-finder-skeleton-body">
                    <div class="skeleton skeleton-heading"></div>
                    <div class="skeleton skeleton-text"></div>
                    <div class="skeleton skeleton-text"></div>
                    <div v-if="hasCardCta" class="skeleton skeleton-button group-finder-skeleton-cta"></div>
                </div>
            </div>
        </div>

        <div v-else class="group-finder-empty">
            No groups match your filters. Try adjusting them.
        </div>

        <!-- Sits under the card list (so it never lands between the cards and a side-by-side map). Each
             page swaps its cards and markers together, so the map stays in step with the list. The first,
             last, and current +/- one page always show; the rest collapse behind ellipses. -->
        <nav v-if="isPagerShown" class="group-finder-pager" aria-label="Results pages">
            <RockButton btnType="default" btnSize="sm" :disabled="currentPage === 0" title="Previous page" @click="$emit('pageChange', currentPage - 1)">
                <i class="ti ti-chevron-left"></i>
            </RockButton>

            <template v-for="(item, index) in pageButtons" :key="item.isEllipsis ? `ellipsis-${index}` : `page-${item.page}`">
                <span v-if="item.isEllipsis" class="group-finder-pager-ellipsis">&hellip;</span>
                <RockButton v-else
                            :btnType="item.page === currentPage ? 'primary' : 'default'"
                            btnSize="sm"
                            :disabled="item.page === currentPage"
                            :aria-current="item.page === currentPage ? 'page' : undefined"
                            :title="`Page ${item.page + 1}`"
                            @click="$emit('pageChange', item.page)">
                    {{ item.page + 1 }}
                </RockButton>
            </template>

            <RockButton btnType="default" btnSize="sm" :disabled="currentPage >= pageCount - 1" title="Next page" @click="$emit('pageChange', currentPage + 1)">
                <i class="ti ti-chevron-right"></i>
            </RockButton>
        </nav>
    </div>
</template>

<style scoped>
.group-finder-results-pane {
    min-width: 0;
}

.group-finder-result-count {
    display: flex;
    align-items: center;
    gap: var(--spacing-xsmall);
    padding: var(--spacing-xsmall) 0;
    font-weight: 600;
}

/*
    Skeleton loading card. Uses Rock's shared .skeleton kit for the gray bars and pulse; the wrapper
    mirrors the real card's padded, rounded chrome so the placeholder holds the same footprint in the grid.
*/
.group-finder-skeleton-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-small);
    height: 100%;
    padding: var(--spacing-medium);
    background: var(--color-interface-softest, #fff);
    border: 1px solid transparent;
    border-radius: var(--rounded-xlarge);
}

/* The media band matches the real cover's 21:9 frame rather than the kit's default block height. */
.group-finder-skeleton-media.skeleton.skeleton-block {
    aspect-ratio: 21 / 9;
    height: auto;
    border-radius: var(--rounded-xlarge);
}

.group-finder-skeleton-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 0 var(--spacing-medium);
}

/* The CTA placeholder sits at the end like the real footer's register button. */
.group-finder-skeleton-cta {
    align-self: flex-end;
    margin-top: auto;
}

.group-finder-results {
    display: grid;
    gap: var(--spacing-medium);
}

/*
    Wide/stacked tiers: 370px cards, up to three columns, left-aligned. The min(370px, 100%) floor
    lets a column narrower than a card (a phone with the map hidden) shrink to the container width
    instead of overflowing, so the single column sizes to the device; wider containers keep the fixed
    370px cards.
*/
.group-finder-results-pane.is-columns-auto .group-finder-results {
    grid-template-columns: repeat(auto-fill, minmax(min(370px, 100%), 370px));
    justify-content: start;
    max-width: calc(3 * 370px + 2 * var(--spacing-medium));
}

/* Toggle tier: two flexible columns, since 2x370 will not fit. */
.group-finder-results-pane.is-columns-two .group-finder-results {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

/* Drawer tier: a single full-width column so cards are not skinny in the narrow panel. */
.group-finder-results-pane.is-columns-one .group-finder-results {
    grid-template-columns: minmax(0, 1fr);
}

.group-finder-empty {
    padding: var(--spacing-large) 0;
    color: var(--color-interface-medium, #6c6c6c);
}

/*
    Results pager, under the card list. Shown when the set spans more than one page; each page swaps
    its cards and markers together, so it never accumulates or churns markers the way infinite scroll would.
*/
.group-finder-pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xsmall);
    padding: var(--spacing-medium);
}

.group-finder-pager-ellipsis {
    padding: 0 var(--spacing-xsmall);
    color: var(--color-interface-medium, #6c6c6c);
}
</style>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import GroupFinderCard from "./groupFinderCard.partial.obs";
    import LoadingIndicator from "@Obsidian/Controls/loadingIndicator.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import { GroupFinderCardBag } from "@Obsidian/ViewModels/Blocks/Group/GroupFinder/groupFinderCardBag";

    // #region Values

    // A couple of rows of skeleton cards while the first results load - enough to fill a wide grid without
    // implying a specific result count.
    const skeletonCount = 6;

    const props = defineProps({
        cards: {
            type: Array as PropType<GroupFinderCardBag[]>,
            default: () => []
        },

        /** The clicked group; its card gets the selected outline. */
        selectedGroupGuid: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The hovered group; its card is raised (shadow, no outline). */
        hoveredGroupGuid: {
            type: String as PropType<string | null>,
            default: null
        },

        resultCountText: {
            type: String as PropType<string>,
            default: ""
        },

        /** How the card grid lays out: "auto" (fixed 370px columns), "two", or "one" flexible column. */
        columns: {
            type: String as PropType<"auto" | "two" | "one">,
            default: "auto"
        },

        /** Hides the result count line, e.g. when a container already shows the count. */
        isResultCountHidden: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** Whether a results fetch is in flight, so the pane can show a loading indicator. */
        isLoading: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** Whether cards show an image area, so the loading skeleton includes a media band. */
        hasCardImage: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** Whether cards carry a register call-to-action, so the loading skeleton includes a button bar. */
        hasCardCta: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** Whether to show the pager under the card list (the set spans more than one page). */
        isPagerShown: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** The current zero-based results page. */
        currentPage: {
            type: Number as PropType<number>,
            default: 0
        },

        /** The total number of results pages. */
        pageCount: {
            type: Number as PropType<number>,
            default: 1
        }
    });

    defineEmits<{
        (e: "update:selectedGroupGuid", value: string | null): void;
        (e: "update:hoveredGroupGuid", value: string | null): void;
        (e: "pageChange", value: number): void;
    }>();

    // #endregion Values

    // #region Computed Values

    // The (zero-based) page buttons to render: always the first, last, and current +/- one page, with an
    // ellipsis placeholder wherever the run of numbers skips - so the row stays compact for large sets.
    const pageButtons = computed((): { page: number; isEllipsis: boolean }[] => {
        const count = props.pageCount;
        if (count <= 1) {
            return [];
        }

        const shown = new Set<number>([0, count - 1]);
        for (let page = props.currentPage - 1; page <= props.currentPage + 1; page++) {
            if (page >= 0 && page < count) {
                shown.add(page);
            }
        }

        const items: { page: number; isEllipsis: boolean }[] = [];
        let previous = -1;
        for (const page of [...shown].sort((a, b) => a - b)) {
            if (page - previous > 1) {
                items.push({ page: -1, isEllipsis: true });
            }
            items.push({ page, isEllipsis: false });
            previous = page;
        }

        return items;
    });

    // #endregion Computed Values
</script>
