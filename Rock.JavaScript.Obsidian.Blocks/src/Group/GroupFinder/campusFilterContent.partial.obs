<template>
    <ContentStack>
        <div class="groupfinder-campus-filter">
            <button v-for="campus in campusRows"
                    :key="campus.value"
                    type="button"
                    class="groupfinder-campus-row groupfinder-option-row"
                    :class="{ 'is-selected': isSelected(campus.value) }"
                    @click="toggle(campus.value)">
                <span class="groupfinder-campus-name">{{ campus.name }}</span>
                <i v-if="isSelected(campus.value)" class="ti ti-check groupfinder-campus-check"></i>
            </button>
        </div>
    </ContentStack>
</template>

<script setup lang="ts">
    import { computed } from "vue";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import { useGroupFinderFilters } from "./filterState.partial";

    // #region Values

    const { config, selectedCampuses } = useGroupFinderFilters();

    // #endregion Values

    // #region Computed Values

    const campusRows = computed(() => {
        return (config.campuses ?? []).map(campus => ({
            value: campus.value ?? "",
            name: campus.text ?? ""
        }));
    });

    // #endregion Computed Values

    // #region Event Handlers

    function isSelected(value: string | null | undefined): boolean {
        return !!value && selectedCampuses.value.includes(value);
    }

    function toggle(value: string | null | undefined): void {
        if (!value) {
            return;
        }
        selectedCampuses.value = selectedCampuses.value.includes(value)
            ? selectedCampuses.value.filter(v => v !== value)
            : [...selectedCampuses.value, value];
    }

    // #endregion Event Handlers
</script>
