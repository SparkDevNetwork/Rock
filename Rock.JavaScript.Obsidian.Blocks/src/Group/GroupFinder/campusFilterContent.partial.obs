<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <ContentStack>
        <div class="filter-campus-content">
            <button v-for="campus in campusRows"
                    :key="campus.value"
                    type="button"
                    class="campus-row"
                    :class="{ 'is-selected': isSelected(campus.value) }"
                    @click="toggle(campus.value)">
                <span class="campus-badge">{{ campus.badge }}</span>
                <span class="campus-name">{{ campus.name }}</span>
                <i v-if="isSelected(campus.value)" class="ti ti-check campus-check"></i>
            </button>
        </div>
    </ContentStack>
</template>

<style scoped>
.filter-campus-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-medium);
}

.campus-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-medium);
    width: 100%;
    padding: var(--spacing-tiny);
    border: 0;
    border-radius: var(--rounded-small, 6px);
    background: transparent;
    text-align: left;
    cursor: pointer;
}

.campus-row:hover {
    background: var(--color-interface-softer);
}

/* Matches how Rock's DropDownList marks a selected option: the info-soft (bluish) fill. */
.campus-row.is-selected {
    background: var(--color-info-soft);
    color: var(--color-interface-strong);
}

.campus-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: var(--rounded-small, 6px);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: var(--font-size-small, 14px);
}

.campus-name {
    font-size: var(--font-size-h6, 16px);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-interface-strongest);
}

.campus-check {
    margin-left: auto;
    color: var(--color-info-strong);
}
</style>

<script setup lang="ts">
    import { computed } from "vue";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import { useGroupFinderFilters } from "./filterState.partial";

    // #region Values

    const { config, selectedCampuses } = useGroupFinderFilters();

    // #endregion Values

    // #region Computed Values

    // The badge (avatar text) is built server-side from the campus name and screened against Rock's
    // offensive-code list, so the row just renders it beside the name.
    const campusRows = computed(() => {
        return (config.campuses ?? []).map(campus => ({
            value: campus.value ?? "",
            name: campus.text ?? "",
            badge: campus.badge ?? ""
        }));
    });

    // #endregion Computed Values

    // #region Event Handlers

    function isSelected(value: string | null | undefined): boolean {
        return !!value && selectedCampuses.value.includes(value);
    }

    function toggle(value: string | null | undefined): void {
        if (!value) {
            return;
        }
        selectedCampuses.value = selectedCampuses.value.includes(value)
            ? selectedCampuses.value.filter(v => v !== value)
            : [...selectedCampuses.value, value];
    }

    // #endregion Event Handlers
</script>
