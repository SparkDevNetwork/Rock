<template>
    <div class="toggle-chip-list">
        <button v-for="item in items"
                :key="item.value ?? ''"
                type="button"
                class="toggle-chip"
                :class="{ 'is-selected': isSelected(item) }"
                :disabled="disabled"
                @click="toggle(item)">
            <slot name="chip" :item="item" :isSelected="isSelected(item)">
                {{ item.text }}
            </slot>
        </button>
    </div>
</template>

<style scoped>
.toggle-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xsmall);
}

.toggle-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xsmall);
    padding: var(--spacing-tiny) var(--spacing-small);
    border: 1px solid transparent;
    border-radius: 500px;
    background: var(--color-interface-softer);
    color: var(--color-interface-strong);
    font-size: var(--font-size-small);
    line-height: 1.5;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.12s ease, border-color 0.12s ease, color 0.12s ease;
}

.toggle-chip:hover {
    background: var(--color-interface-soft);
}

.toggle-chip.is-selected {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-interface-softest);
}

.toggle-chip:disabled {
    cursor: default;
    opacity: 0.6;
}

/* Size any leading icon a caller slots into a chip. */
.toggle-chip :slotted(i) {
    font-size: 1rem;
    line-height: 1;
}
</style>

<script setup lang="ts">
    import { PropType } from "vue";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    // #region Values

    const props = defineProps({
        /** The full set of options rendered as chips. */
        items: {
            type: Array as PropType<ListItemBag[]>,
            default: () => []
        },

        /** The selected items. Treated as immutable - toggling a chip emits a new array. */
        modelValue: {
            type: Array as PropType<ListItemBag[]>,
            default: () => []
        },

        /** Whether the chips are non-interactive. */
        disabled: {
            type: Boolean as PropType<boolean>,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: ListItemBag[]): void;
    }>();

    // #endregion Values

    // #region Event Handlers

    function isSelected(item: ListItemBag): boolean {
        return props.modelValue.some(selected => selected.value === item.value);
    }

    // Build and emit a brand-new array rather than mutating modelValue, so the parent's binding updates
    // cleanly and callers can treat the bound value as immutable.
    function toggle(item: ListItemBag): void {
        if (props.disabled) {
            return;
        }

        const next = isSelected(item)
            ? props.modelValue.filter(selected => selected.value !== item.value)
            : [...props.modelValue, item];

        emit("update:modelValue", next);
    }

    // #endregion Event Handlers
</script>
