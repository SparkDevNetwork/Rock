<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Grid :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="id"
          itemTerm="Group"
          title="Search Results"
          emptyDataText="No Groups Found"
          stickyHeader
          :isTitleHidden="true"
          liveUpdates
          exportTitle="Group Search Results"
          :showMergeTemplate="false"
          :showLaunchWorkflow="true"
          @selectItem="onSelectItem">

        <TextColumn name="id"
                    title="Id"
                    field="id"
                    :hideOnScreen="true" />

        <Column name="structure"
                title="Group"
                :filter="textValueFilter"
                :filterValue="getGroupFilterValue"
                :quickFilterValue="getGroupFilterValue"
                :exportValue="getGroupFilterValue"
                visiblePriority="xs">
            <template #format="{ row }">
                <div>
                    <span v-if="row.structure" v-html="row.structure"></span>
                    <template v-if="row.structure"> <i class="ti ti-chevron-right"></i> </template>
                    <a :href="row.url ?? undefined">{{ row.name }}</a>
                </div>
            </template>

            <template #skeleton>
                <div class="skeleton skeleton-text skeleton-rounded" />
            </template>
        </Column>

        <TextColumn name="groupType"
                    title="Type"
                    field="groupType"
                    :filter="textValueFilter"
                    visiblePriority="md" />

        <NumberColumn name="memberCount"
                      title="Member Count"
                      field="memberCount"
                      :filter="numberValueFilter"
                      visiblePriority="md" />

        <TextColumn name="campus"
                    title="Campus"
                    field="campus"
                    :filter="textValueFilter"
                    visiblePriority="lg" />
    </Grid>
</template>

<script setup lang="ts">
    import Grid, {
        Column,
        NumberColumn,
        TextColumn,
        numberValueFilter,
        textValueFilter
    } from "@Obsidian/Controls/grid";
    import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { GroupSearchOptionsBag } from "@Obsidian/ViewModels/Blocks/Group/GroupSearch/groupSearchOptionsBag";
    import { GroupSearchResultBag } from "@Obsidian/ViewModels/Blocks/Group/GroupSearch/groupSearchResultBag";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { onMounted, reactive, ref } from "vue";

    const config = useConfigurationValues<ListBlockBox<GroupSearchOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();

    onConfigurationValuesChanged(useReloadBlock());

    type Row = GroupSearchResultBag;

    // #region Values

    const gridDataSource = ref<Promise<GridDataBag>>();
    let gridData: GridDataBag | undefined;

    // #endregion Values

    // #region Functions

    /**
     * Called when the grid is requesting the row data be loaded.
     */
    async function loadGridData(): Promise<GridDataBag> {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (result.isSuccess && result.data) {
            gridData = reactive(result.data);
            return gridData;
        }
        else {
            throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
        }
    }

    /**
     * Gets the row identified by the specified key.
     *
     * @param key The row key.
     *
     * @returns The matching row; otherwise, undefined.
     */
    function getRow(key: string): Row | undefined {
        const rows = (gridData?.rows ?? []) as Row[];
        return rows.find(r => `${r.id}` === `${key}`);
    }

    /**
     * Gets the combined filter/export text for the group column.
     *
     * @param row The row being formatted.
     *
     * @returns The combined hierarchy path and group name.
     */
    function getGroupFilterValue(row: Record<string, unknown>): string {
        const groupRow = row as Row;
        const structure = stripHtml(groupRow.structure ?? "");

        return structure ? `${structure} > ${groupRow.name ?? ""}` : (groupRow.name ?? "");
    }

    /**
     * Removes HTML tags from a string for filter and export text.
     *
     * @param value The HTML string.
     *
     * @returns Plain text content.
     */
    function stripHtml(value: string): string {
        return value.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
    }

    // #endregion Functions

    // #region Event Handlers

    /**
     * Called when a row has been selected by the individual.
     *
     * @param key The key of the row that was selected.
     */
    function onSelectItem(key: string): void {
        const row = getRow(key);

        if (row?.url) {
            window.location.href = row.url;
        }
    }

    // #endregion Event Handlers

    // #region Lifecycle Hooks

    onMounted(() => {
        // A single search result skips the grid and jumps straight to the group page.
        if (config.options?.redirectUrl) {
            window.location.href = config.options.redirectUrl;
            return;
        }

        gridDataSource.value = loadGridData();
    });

    // #endregion Lifecycle Hooks
</script>
