<template>
    <Modal v-model="isShown" title="Assignment Preference" saveText="Save">
        <!-- TODO: Schedule (required) and Location dropdowns fed by GetScheduleAssignmentOptions,
             with "No Location Preference" as a null locationId, per conversion plan §9.4. -->
    </Modal>
</template>

<script setup lang="ts">
    import { PropType } from "vue";
    import Modal from "@Obsidian/Controls/modal.obs";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";

    const props = defineProps({
        modelValue: {
            type: Boolean as PropType<boolean>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: boolean): void;
    }>();

    // #region Values

    const isShown = useVModelPassthrough(props, "modelValue", emit);

    // #endregion Values
</script>
