<template>
    <Modal v-model="isShown" title="Restore Archived Member">
        {{ message }}

        <template #customButtons>
            <div class="d-flex gap-3 justify-content-end">
                <RockButton @click="onDecline">Don't Restore</RockButton>
                <RockButton :btnType="BtnType.Primary" @click="onRestore">Restore</RockButton>
            </div>
        </template>
    </Modal>
</template>

<script setup lang="ts">
    import { PropType } from "vue";
    import Modal from "@Obsidian/Controls/modal.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";

    const props = defineProps({
        modelValue: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        /** The restore prompt message from the Save response. */
        message: {
            type: String as PropType<string>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: boolean): void;
        (e: "restore"): void;
        (e: "decline"): void;
    }>();

    // #region Values

    const isShown = useVModelPassthrough(props, "modelValue", emit);

    // #endregion Values

    // #region Event Handlers

    /**
     * Restores the archived member instead of creating a new record.
     */
    function onRestore(): void {
        isShown.value = false;
        emit("restore");
    }

    /**
     * Declines the restore so the save creates a new record.
     */
    function onDecline(): void {
        isShown.value = false;
        emit("decline");
    }

    // #endregion Event Handlers
</script>
