             Subject + Message with required validation, SMS from number (static or dropdown), and
             per-case warning alerts from GetCommunicationOptions per conversion plan §9.9. -->
    </Modal>
</template>

<script setup lang="ts">
    import { PropType } from "vue";
    import Modal from "@Obsidian/Controls/modal.obs";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";

    const props = defineProps({
        modelValue: {
            type: Boolean as PropType<boolean>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: boolean): void;
    }>();

    // #region Values

    const isShown = useVModelPassthrough(props, "modelValue", emit);

    // #endregion Values
</script>
