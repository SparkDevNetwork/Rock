<template>
    <Grid v-if="config.options?.isGridVisible"
          :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="idKey"
          personKeyField="personIdKey"
          :title="config.options?.title ?? undefined"
          titleIconCssClass="ti ti-users"
          :itemTerm="config.options?.itemTerm ?? undefined"
          :exportTitle="config.options?.exportTitle ?? undefined"
          :entityTypeGuid="EntityType.GroupMember"
          :rowClass="getRowClass"
          :expectedRowCount="config.expectedRowCount ?? undefined"
          :preferencePrefix="config.options?.groupIdKey ?? ''"
          stickyHeader
          :gridSettings="hasModalFilters"
          :gridSettingsActive="hasSettingsFilters"
          :onAddItem="config.isAddEnabled ? onAddItem : undefined"
          @gridSettingsClick="isGridSettingsVisible = true"
          @selectItem="onSelectItem">

        <template v-if="config.options?.warningMessage" #gridHeaderPrepend>
            <NotificationBox :alertType="AlertType.Warning" class="mb-0">
                <strong>No roles!</strong> {{ config.options.warningMessage }}
            </NotificationBox>
        </template>

        <SelectColumn />

        <Column name="exportFullNameReversed"
                title="Name"
                field="exportFullNameReversed"
                :hideOnScreen="true" />

        <PersonColumn name="person"
                      title="Name"
                      field="person"
                      :formatComponent="PersonNameCell"
                      :isNoteColumnVisible="config.options?.isNoteColumnVisible ?? false"
                      enableHoverInfo
                      :excludeFromExport="true"
                      :filter="pickExistingValueFilter"
                      :quickFilterValue="getPersonNameFilterValue"
                      visiblePriority="xs"
                      width="250px" />

        <TextColumn name="maritalStatus"
                    title="Marital Status"
                    field="maritalStatus"
                    :hideOnScreen="!config.options?.isMaritalStatusColumnVisible"
                    visiblePriority="lg" />

        <Column name="connectionStatus"
                title="Connection Status"
                field="connectionStatus"
                :hideOnScreen="true" />

        <TextColumn v-if="config.options?.isGenderColumnVisible"
                    name="gender"
                    title="Gender"
                    field="gender"
                    :excludeFromExport="true"
                    :filter="pickExistingValueFilter"
                    visiblePriority="lg" />

        <Column name="registrations"
                title="Registration"
                field="registrations"
                itemClass="grid-cell-stack"
                :hideOnScreen="!config.options?.isRegistrationColumnVisible"
                :excludeFromExport="true"
                :disableSort="true"
                :filter="pickExistingValueFilter"
                :filterValues="getRegistrationFilterValues"
                visiblePriority="lg"
                width="180px">
            <template #format="{ row }">
                <div v-for="registration in getRegistrations(row)" :key="registration.value ?? ''">
                    <a v-if="registrationUrl" :href="registrationUrl?.replace('((Key))', registration.value ?? '')" @click.stop>{{ registration.text }}</a>
                    <template v-else>{{ registration.text }}</template>
                </div>
            </template>
        </Column>

        <TextColumn name="role"
                    title="Role"
                    field="role"
                    :filter="pickExistingValueFilter"
                    visiblePriority="xs" />

        <DateColumn name="dateAdded"
                    title="Date Added"
                    field="dateAdded"
                    :hideOnScreen="!config.options?.isDateAddedColumnVisible"
                    :filter="dateValueFilter"
                    visiblePriority="md"
                    width="150px" />

        <DateTimeColumn v-if="config.options?.isAttendanceColumnVisible"
                        name="firstAttended"
                        title="First Attended"
                        field="firstAttended"
                        :excludeFromExport="true"
                        :filter="dateValueFilter"
                        visiblePriority="lg" />

        <DateTimeColumn v-if="config.options?.isAttendanceColumnVisible"
                        name="lastAttended"
                        title="Last Attended"
                        field="lastAttended"
                        :excludeFromExport="true"
                        :filter="dateValueFilter"
                        visiblePriority="lg" />

        <TextColumn name="note"
                    title="Note"
                    field="note"
                    :hideOnScreen="!config.options?.isNoteColumnVisible"
                    visiblePriority="md" />

        <AttributeColumns :attributes="config.gridDefinition?.attributeFields ?? []" />

        <TextColumn name="status"
                    title="Status"
                    field="status"
                    :filter="pickExistingValueFilter"
                    visiblePriority="xs" />

        <Column name="nickName"
                title="Nick Name"
                field="nickName"
                :hideOnScreen="true" />

        <Column name="lastName"
                title="Last Name"
                field="lastName"
                :hideOnScreen="true" />

        <DateColumn name="birthDate"
                    title="Birth Date"
                    field="birthDate"
                    :hideOnScreen="true" />

        <Column name="age"
                title="Age"
                field="age"
                :hideOnScreen="true" />

        <Column name="email"
                title="Email"
                field="email"
                :hideOnScreen="true" />

        <Column name="recordStatusValueId"
                title="RecordStatusValueId"
                field="recordStatusValueId"
                :hideOnScreen="true" />

        <Column name="recordStatus"
                title="Record Status"
                field="recordStatus"
                :hideOnScreen="true" />

        <Column name="exportGender"
                title="Gender"
                field="gender"
                :hideOnScreen="true" />

        <BooleanColumn name="isDeceased"
                       title="Is Deceased"
                       field="isDeceased"
                       :hideOnScreen="true" />

        <Column name="homePhone"
                title="Home Phone"
                field="homePhone"
                :hideOnScreen="true" />

        <Column name="cellPhone"
                title="Cell Phone"
                field="cellPhone"
                :hideOnScreen="true" />

        <Column name="homeAddress"
                title="Home Address"
                field="homeAddress"
                :hideOnScreen="true" />

        <Column name="latitude"
                title="Latitude"
                field="latitude"
                :hideOnScreen="true" />

        <Column name="longitude"
                title="Longitude"
                field="longitude"
                :hideOnScreen="true" />
    </Grid>

    <GridSettingsModal v-if="hasModalFilters"
                       v-model="gridSettings"
                       v-model:visible="isGridSettingsVisible"
                       :isGenderFilterVisible="isGenderFilterVisible"
                       :isCampusFilterVisible="isCampusFilterVisible"
                       :isSignedDocumentFilterVisible="isSignedDocumentFilterVisible"
                       :registrationInstances="config.options?.registrationInstances ?? []" />
</template>

<script setup lang="ts">
    import { computed, ref, watch } from "vue";
    import GridSettingsModal from "./GroupMemberList/gridSettingsModal.partial.obs";
    import PersonNameCell from "./GroupMemberList/personNameCell.partial.obs";
    import { GridSettingsOptions, NavigationUrlKey, PreferenceKey } from "./GroupMemberList/types.partial";
    import Grid, { AttributeColumns, BooleanColumn, Column, DateColumn, DateTimeColumn, dateValueFilter, PersonColumn, pickExistingValueFilter, SelectColumn, TextColumn } from "@Obsidian/Controls/grid";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { MultiValueFilterItem } from "@Obsidian/Types/Controls/grid";
    import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, usePersonPreferences, useReloadBlock } from "@Obsidian/Utility/block";
    import { GroupMemberListOptionsBag } from "@Obsidian/ViewModels/Blocks/Group/GroupMemberList/groupMemberListOptionsBag";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { PersonFieldBag } from "@Obsidian/ViewModels/Core/Grid/personFieldBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    const config = useConfigurationValues<ListBlockBox<GroupMemberListOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();
    const preferences = usePersonPreferences().blockPreferences;

    // All blocks auto reload when changing block settings unless there is an
    // explicit reason not to (like using a custom reload function instead),
    // in which case you can remove this code.
    onConfigurationValuesChanged(useReloadBlock());

    // #region Values

    const gridDataSource = ref<Promise<GridDataBag>>();

    const isGridSettingsVisible = ref(false);

    /** The Family Campus filter is stored as the picker's own list item, so the modal reopens showing its name. */
    const campusPreference = preferences.getValue(makeKeyUniqueToGroup(PreferenceKey.FilterCampus));

    const gridSettings = ref<GridSettingsOptions>({
        campus: campusPreference ? JSON.parse(campusPreference) as ListItemBag : undefined,
        genders: JSON.parse(preferences.getValue(makeKeyUniqueToGroup(PreferenceKey.FilterGender)) || "[]"),
        registrationInstance: preferences.getValue(makeKeyUniqueToGroup(PreferenceKey.FilterRegistrationInstance)),
        signedDocument: preferences.getValue(makeKeyUniqueToGroup(PreferenceKey.FilterSignedDocument))
    });

    // #endregion Values

    // #region Computed Values

    const registrationUrl = computed((): string | undefined => {
        return config.navigationUrls?.[NavigationUrlKey.RegistrationPage] || undefined;
    });

    /** The Gender column's own filter does the job whenever that column is shown. */
    const isGenderFilterVisible = computed((): boolean => {
        return config.options?.isGenderColumnVisible !== true;
    });

    const isCampusFilterVisible = computed((): boolean => {
        return config.options?.isCampusFilterVisible === true;
    });

    const isRegistrationFilterVisible = computed((): boolean => {
        return (config.options?.registrationInstances?.length ?? 0) > 0;
    });

    const isSignedDocumentFilterVisible = computed((): boolean => {
        return config.options?.isSignedDocumentFilterVisible === true;
    });

    /** Every filter in the modal is conditional, so on some groups there is nothing to open it for. */
    const hasModalFilters = computed((): boolean => {
        return isGenderFilterVisible.value
            || isCampusFilterVisible.value
            || isRegistrationFilterVisible.value
            || isSignedDocumentFilterVisible.value;
    });

    /**
     * Whether any of the modal's filters is narrowing the list. A filter whose control is hidden does not
     * count, since the block action ignores it too.
     */
    const hasSettingsFilters = computed((): boolean => {
        return (isGenderFilterVisible.value && (gridSettings.value.genders?.length ?? 0) > 0)
            || (isCampusFilterVisible.value && !!gridSettings.value.campus?.value)
            || (isRegistrationFilterVisible.value && !!gridSettings.value.registrationInstance)
            || (isSignedDocumentFilterVisible.value && !!gridSettings.value.signedDocument);
    });

    // #endregion Computed Values

    // #region Functions

    /**
     * Makes the key unique to the current group.
     *
     * @param key The preference key.
     *
     * @returns The scoped preference key.
     */
    function makeKeyUniqueToGroup(key: string): string {
        if (config.options?.groupIdKey) {
            return `${config.options.groupIdKey}-${key}`;
        }

        return key;
    }

    /**
     * Called when the grid is requesting the row data be loaded.
     */
    async function loadGridData(): Promise<GridDataBag> {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (!result.isSuccess || !result.data) {
            throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
        }

        return result.data;
    }

    /**
     * Gets the registrations a member was added through, which the server leaves off the row entirely when
     * there are none.
     *
     * @param row The row to read.
     *
     * @returns The registrations, or an empty array.
     */
    function getRegistrations(row: Record<string, unknown>): ListItemBag[] {
        return (row.registrations as ListItemBag[] | null) ?? [];
    }

    /**
     * Splits a member's registrations into one filter value each, so the Registration column filter offers
     * each registration on its own rather than every combination of them.
     *
     * @param row The row being filtered.
     *
     * @returns One item per registration the member was added through.
     */
    function getRegistrationFilterValues(row: Record<string, unknown>): MultiValueFilterItem[] {
        return getRegistrations(row).map(registration => ({
            value: registration.text ?? "",
            rowData: { ...row, registrations: [registration] }
        }));
    }

    /**
     * Gets the names the quick search matches against, which include the legal
     * first name when it differs from the nick name.
     *
     * @param row The row being searched.
     *
     * @returns The names to match against.
     */
    function getPersonNameFilterValue(row: Record<string, unknown>): string {
        const person = row.person as PersonFieldBag | null;
        const firstName = (row.firstName as string | null) ?? "";
        const names = [person?.nickName ?? "", person?.lastName ?? ""];

        if (firstName && firstName !== person?.nickName) {
            names.push(firstName);
        }

        return names.filter(n => n).join(" ");
    }

    /**
     * Gets the CSS classes that style a row according to the member's and person's standing.
     *
     * @param row The row being rendered.
     *
     * @returns The space delimited class list for the row.
     */
    function getRowClass(row: Record<string, unknown>): string {
        const classes: string[] = [];

        if (row.isInactive === true) {
            classes.push("is-inactive");
        }

        if (row.isPersonInactive === true) {
            classes.push("is-inactive-person");
        }

        if (row.isDeceased === true) {
            classes.push("is-deceased");
        }

        return classes.join(" ");
    }

    // #endregion Functions

    // #region Event Handlers

    /**
     * Called when a row has been selected by the individual.
     *
     * @param key The key of the row that was selected.
     */
    function onSelectItem(key: string): void {
        const detailUrl = config.navigationUrls?.[NavigationUrlKey.DetailPage];

        if (detailUrl) {
            window.location.href = detailUrl.replace("((Key))", key);
        }
    }

    /**
     * Called when the Add button has been clicked by the individual.
     */
    function onAddItem(): void {
        const addUrl = config.navigationUrls?.[NavigationUrlKey.AddPage];

        if (addUrl) {
            window.location.href = addUrl;
        }
    }

    // #endregion Event Handlers

    // #region Watchers

    watch(gridSettings, async () => {
        preferences.setValue(makeKeyUniqueToGroup(PreferenceKey.FilterCampus), JSON.stringify(gridSettings.value.campus ?? null));
        preferences.setValue(makeKeyUniqueToGroup(PreferenceKey.FilterGender), JSON.stringify(gridSettings.value.genders ?? []));
        preferences.setValue(makeKeyUniqueToGroup(PreferenceKey.FilterRegistrationInstance), gridSettings.value.registrationInstance ?? "");
        preferences.setValue(makeKeyUniqueToGroup(PreferenceKey.FilterSignedDocument), gridSettings.value.signedDocument ?? "");

        await preferences.save();

        gridDataSource.value = loadGridData();
    });

    // #endregion Watchers

    gridDataSource.value = loadGridData();
</script>
