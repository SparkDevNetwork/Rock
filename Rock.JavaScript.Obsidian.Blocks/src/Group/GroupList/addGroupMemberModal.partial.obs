<template>
    <Modal v-model="isVisible"
           title="Add to Group"
           saveText="Add"
           @save="onSave">
        <NotificationBox v-if="errorMessage"
                         alertType="warning">
            {{ errorMessage }}
        </NotificationBox>

        <NotificationBox v-if="isDatasetTooLarge"
                         alertType="info">
            The group dataset is too large for a drop-down list, so the group picker is being used instead. This is a block setting that can be toggled.
        </NotificationBox>

        <div class="row">
            <div class="col-xs-12 col-md-4">
                <GroupPicker v-if="isGroupPickerMode"
                             v-model="selectedGroup"
                             label="Group"
                             rules="required"
                             :includedGroupTypeGuids="options.includedGroupTypeGuids ?? []"
                             :rootGroupGuid="options.rootGroupGuid ?? null"
                             @update:modelValue="onGroupChanged" />

                <DropDownList v-else
                              v-model="selectedGroupIdKey"
                              label="Group"
                              rules="required"
                              :enhanceForLongLists="true"
                              :items="availableGroups"
                              :loading="isLoadingGroups"
                              :showBlankItem="true"
                              blankValue=""
                              @update:modelValue="onGroupIdKeyChanged" />
            </div>
        </div>

        <NotificationBox v-if="hasSyncedRoles"
                         alertType="info"
                         heading="Synced Group!">
            The selected group uses Group Sync. Only roles that are not being synced are listed.
            Please make sure this person needs to be added manually instead of meeting the sync conditions.
        </NotificationBox>

        <div class="row">
            <div class="col-xs-12 col-md-4">
                <DropDownList v-model="selectedRoleIdKey"
                              label="Role"
                              rules="required"
                              :items="availableRoles"
                              :showBlankItem="true"
                              blankValue=""
                              :disabled="availableRoles.length === 0" />
            </div>
        </div>
    </Modal>

    <Modal v-model="isRestoreVisible"
           title="Restore Archived Record"
           saveText="Restore"
           @save="onRestoreConfirm"
           @closeModal="onRestoreCancel">
        <p>{{ restoreMessage }}</p>
        <template #customButtons>
            <RockButton btnType="default" @click="onAddWithoutRestore">Don't Restore</RockButton>
        </template>
    </Modal>
</template>

<script setup lang="ts">
    import Modal from "@Obsidian/Controls/modal.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import GroupPicker from "@Obsidian/Controls/groupPicker.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import { ref, computed, watch, PropType } from "vue";
    import { GroupListOptionsBag } from "@Obsidian/ViewModels/Blocks/Group/GroupList/groupListOptionsBag";
    import { GroupListAddGroupMemberRequestBag } from "@Obsidian/ViewModels/Blocks/Group/GroupList/groupListAddGroupMemberRequestBag";
    import { GroupListAvailableGroupsBag } from "@Obsidian/ViewModels/Blocks/Group/GroupList/groupListAvailableGroupsBag";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import { useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    /** Shape returned by the parent's AddGroupMember handler. */
    type AddGroupMemberResponse = {
        status: string;
        archivedMemberIdKey?: string;
        message?: string;
    };

    type BlockActionResultLike<T> = {
        isSuccess: boolean;
        data?: T | null;
        errorMessage?: string | null;
    };

    const props = defineProps({
        visible: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        options: {
            type: Object as PropType<GroupListOptionsBag>,
            required: true
        },

        /**
         * Parent-supplied handler that invokes the AddGroupMember block action.
         * The modal stays presentation-focused; the parent owns the action call.
         */
        onAddMember: {
            type: Function as PropType<(bag: GroupListAddGroupMemberRequestBag) => Promise<BlockActionResultLike<AddGroupMemberResponse>>>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:visible", value: boolean): void;
        (e: "added"): void;
    }>();

    const invokeBlockAction = useInvokeBlockAction();
    const isVisible = useVModelPassthrough(props, "visible", emit);

    const selectedGroup = ref<ListItemBag | null>(null);
    const selectedGroupIdKey = ref("");
    const selectedRoleIdKey = ref("");
    const availableGroups = ref<ListItemBag[]>([]);
    const isLoadingGroups = ref(false);
    let hasLoadedGroups = false;
    const availableRoles = ref<ListItemBag[]>([]);
    const hasSyncedRoles = ref(false);
    const errorMessage = ref("");

    const isRestoreVisible = ref(false);
    const restoreMessage = ref("");
    const archivedMemberIdKey = ref("");
    let pendingBag: GroupListAddGroupMemberRequestBag | null = null;

    // Whether the block is configured to use the tree group picker rather than the drop-down.
    const isConfiguredForGroupPicker = computed(() => props.options.groupPickerType === "GroupPicker");

    // Set when the drop-down's candidate dataset is too large; forces the tree picker as a fallback.
    const isDatasetTooLarge = ref(false);

    // Effective picker mode: the configured picker, or the drop-down's too-large fallback.
    const isGroupPickerMode = computed(() => isConfiguredForGroupPicker.value || isDatasetTooLarge.value);

    /**
     * Loads the groups the current person may add to, on demand when the modal first
     * opens in Dropdown mode. Deferring this keeps the (potentially large) group query
     * off the initial page render, matching the WebForms block's Add-click behavior.
     */
    async function loadAvailableGroups(): Promise<void> {
        if (hasLoadedGroups || isConfiguredForGroupPicker.value) {
            return;
        }

        isLoadingGroups.value = true;

        try {
            const result = await invokeBlockAction<GroupListAvailableGroupsBag>("GetAvailableGroups");
            if (result.isSuccess && result.data) {
                if (result.data.isDatasetTooLarge) {
                    // Too many groups for a drop-down; fall back to the tree picker.
                    isDatasetTooLarge.value = true;
                }
                else {
                    availableGroups.value = result.data.groups ?? [];
                }

                hasLoadedGroups = true;
            }
            else {
                errorMessage.value = result.errorMessage ?? "An error occurred while loading the available groups.";
            }
        }
        finally {
            isLoadingGroups.value = false;
        }
    }

    async function loadRoles(groupIdKey: string): Promise<void> {
        selectedRoleIdKey.value = "";
        availableRoles.value = [];
        hasSyncedRoles.value = false;

        if (!groupIdKey) {
            return;
        }

        const result = await invokeBlockAction<{ roles: ListItemBag[]; hasSyncedRoles: boolean }>("GetGroupRoles", { groupIdKey });
        if (result.isSuccess && result.data) {
            availableRoles.value = result.data.roles;
            hasSyncedRoles.value = result.data.hasSyncedRoles;
        }
    }

    function onGroupChanged(value: ListItemBag | ListItemBag[] | null): void {
        const group = Array.isArray(value) ? (value[0] ?? null) : value;
        loadRoles(group?.value ?? "");
    }

    function onGroupIdKeyChanged(value: string | string[]): void {
        // DropDownList's update:modelValue is typed as string | string[] for multi-select
        // support; this instance is single-select, so collapse arrays to their first entry.
        const idKey = Array.isArray(value) ? (value[0] ?? "") : value;
        loadRoles(idKey);
    }

    async function onSave(): Promise<void> {
        errorMessage.value = "";

        const groupIdKey = isGroupPickerMode.value
            ? (selectedGroup.value?.value ?? "")
            : selectedGroupIdKey.value;

        if (!groupIdKey) {
            errorMessage.value = "Please select a group.";
            return;
        }

        if (!selectedRoleIdKey.value) {
            errorMessage.value = "Please select a role.";
            return;
        }

        const bag: GroupListAddGroupMemberRequestBag = {
            groupIdKey,
            roleIdKey: selectedRoleIdKey.value,
            skipArchiveCheck: false
        };

        const result = await props.onAddMember(bag);

        if (result.isSuccess && result.data) {
            if (result.data.status === "ArchiveFound") {
                pendingBag = bag;
                archivedMemberIdKey.value = result.data.archivedMemberIdKey ?? "";
                restoreMessage.value = result.data.message ?? "An archived record was found. Do you want to restore it?";
                isVisible.value = false;
                isRestoreVisible.value = true;
                return;
            }

            resetForm();
            isVisible.value = false;
            emit("added");
        }
        else {
            errorMessage.value = result.errorMessage ?? "An error occurred while adding the group member.";
        }
    }

    async function onRestoreConfirm(): Promise<void> {
        const result = await invokeBlockAction("RestoreArchivedMember", { archivedMemberIdKey: archivedMemberIdKey.value });

        if (result.isSuccess) {
            isRestoreVisible.value = false;
            resetForm();
            emit("added");
        }
        else {
            isRestoreVisible.value = false;
            errorMessage.value = result.errorMessage ?? "An error occurred while restoring the archived member.";
            isVisible.value = true;
        }
    }

    function onRestoreCancel(): void {
        resetForm();
    }

    async function onAddWithoutRestore(): Promise<void> {
        isRestoreVisible.value = false;

        if (!pendingBag) {
            return;
        }

        const result = await props.onAddMember({ ...pendingBag, skipArchiveCheck: true });

        if (result.isSuccess) {
            resetForm();
            emit("added");
        }
        else {
            errorMessage.value = result.errorMessage ?? "An error occurred while adding the group member.";
            isVisible.value = true;
        }
    }

    // Load the dropdown's groups the first time the modal is opened in Dropdown mode.
    watch(isVisible, (visible) => {
        if (visible) {
            loadAvailableGroups();
        }
    });

    function resetForm(): void {
        selectedGroup.value = null;
        selectedGroupIdKey.value = "";
        selectedRoleIdKey.value = "";
        availableRoles.value = [];
        hasSyncedRoles.value = false;
        errorMessage.value = "";
        pendingBag = null;
    }
</script>
