<template>
    <Modal v-model="isModalOpen" title="Group Finder Settings" :saveText="saveButtonText" @save="onSave">

        <NotificationBox v-if="errorMessage" :alertType="AlertType.Warning">
            {{ errorMessage }}
        </NotificationBox>

        <LoadingIndicator v-else-if="isLoading" :delay="500" />

        <div v-else>

            <NotificationBox v-if="saveError" :alertType="AlertType.Warning">
                {{ saveError }}
            </NotificationBox>

            <ContentSectionContainer :sidebar="false">
                <ContentSection title="Group Types">
                    <ContentStack>
                        <GroupTypePicker v-model="groupTypes"
                                         label="Group Types"
                                         help="The group types whose groups the finder offers, and whose attributes the filter and card settings below are drawn from."
                                         :multiple="true"
                                         :enhanceForLongLists="true"
                                         rules="required"
                                         @update:modelValue="onGroupTypesUpdated" />
                    </ContentStack>
                </ContentSection>

                <ContentSection title="Filters">
                    <ContentStack title="Campus">
                        <CheckBox v-model="isCampusFilterHidden" label="Hide Campus Filter" />
                        <DefinedValuePicker v-model="campusTypes"
                                            label="Campus Types"
                                            help="The campus types offered by the campus filter."
                                            :definedTypeGuid="DefinedType.CampusType"
                                            :multiple="true" />
                        <DefinedValuePicker v-model="campusStatuses"
                                            label="Campus Statuses"
                                            help="The campus statuses offered by the campus filter."
                                            :definedTypeGuid="DefinedType.CampusStatus"
                                            :multiple="true" />
                    </ContentStack>

                    <ContentStack title="Where">
                        <CheckBoxList v-model="supportedMeetingStyles"
                                      label="Supported Meeting Styles"
                                      help="The meeting styles offered by the Where filter. When none are selected the Meeting Style filter is hidden."
                                      :items="meetingStyleItems" />
                        <DropDownList v-model="distanceCalculation"
                                      label="Distance Calculation"
                                      :help="distanceCalculationHelp"
                                      :items="distanceCalculationItems"
                                      :showBlankItem="false" />
                    </ContentStack>

                    <ContentStack title="When">
                        <CheckBox v-model="isDayOfWeekFilterShown" label="Display Day of Week Filter" />
                        <CheckBox v-model="isTimeOfDayFilterShown" label="Display Time of Day Filter" />
                    </ContentStack>

                    <ContentStack title="What">
                        <CheckBox v-model="isLiveSearchEnabled"
                                  label="Live Text Search"
                                  help="Renders a text field that filters groups by name as the visitor types." />
                        <CheckBoxList v-model="featuredAttributes"
                                      label="Featured Attributes"
                                      help="Attributes promoted into the What section of the filter bar as pills. Limited to Single-select, Multi-select, and Boolean field types, and cannot also be a More Filters attribute."
                                      :items="featuredItems"
                                      :repeatColumns="2" />
                    </ContentStack>

                    <ContentStack title="More Filters">
                        <CheckBoxList v-model="displayAttributeFilters"
                                      label="Display Attribute Filters"
                                      help="Attributes an individual can filter results by in the More Filters modal. Cannot also be a Featured attribute."
                                      :items="displayItems"
                                      :repeatColumns="2" />
                    </ContentStack>
                </ContentSection>

                <ContentSection title="Card and Map">
                    <ContentStack title="Card">
                        <CheckBox v-model="isImageShown" label="Show Image" />
                        <CheckBox v-model="isAverageAgeShown" label="Show Average Age" />
                        <CheckBoxList v-model="showAttributeOnCard"
                                      label="Show Attribute on Card"
                                      help="Attributes displayed on each result card, each with its icon and value."
                                      :items="availableCardAttributes"
                                      :repeatColumns="2" />
                        <CodeEditor v-model="groupCardTemplate"
                                    label="Group Card Template"
                                    help="The Lava template that renders the content of each result card. Clear it to reset to the built-in default."
                                    mode="lava" />
                    </ContentStack>

                    <ContentStack title="Map">
                        <CheckBox v-model="isMapShown"
                                  label="Show Map"
                                  help="When enabled the layout switches to a side by side arrangement of cards and a map." />
                        <ColorPicker v-model="groupMarkerColor"
                                     label="Group Marker Color"
                                     help="The color of the group markers on the map." />
                        <ColorPicker v-model="currentLocationMarkerColor"
                                     label="Current Location Marker Color"
                                     help="The color of the &quot;you are here&quot; proximity marker on the map." />
                        <DefinedValuePicker v-model="mapStyle"
                                            label="Map Style"
                                            help="The map style applied to the results map. When not set, the block's default style is used."
                                            :definedTypeGuid="DefinedType.MapStyles" />
                    </ContentStack>
                </ContentSection>

                <ContentSection title="Linked Pages">
                    <ContentStack>
                        <PagePicker v-model="registerPage"
                                    label="Register Page"
                                    help="The page a visitor is sent to when signing up for a group."
                                    :promptForPageRoute="true"
                                    :securityGrantToken="securityGrantToken" />
                    </ContentStack>
                </ContentSection>
            </ContentSectionContainer>

        </div>

    </Modal>
</template>

<script setup lang="ts">
    import { computed, ref, watch } from "vue";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import CheckBoxList from "@Obsidian/Controls/checkBoxList.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import CodeEditor from "@Obsidian/Controls/codeEditor.obs";
    import ColorPicker from "@Obsidian/Controls/colorPicker.obs";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    import ContentSectionContainer from "@Obsidian/Controls/contentSectionContainer.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import DefinedValuePicker from "@Obsidian/Controls/definedValuePicker.obs";
    import GroupTypePicker from "@Obsidian/Controls/groupTypePicker.obs";
    import LoadingIndicator from "@Obsidian/Controls/loadingIndicator.obs";
    import Modal from "@Obsidian/Controls/modal.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import PagePicker from "@Obsidian/Controls/pagePicker.obs";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { DistanceCalculationMode, DistanceCalculationModeDescription } from "@Obsidian/Enums/Group/distanceCalculationMode";
    import { MeetingStyle, MeetingStyleDescription } from "@Obsidian/Enums/Group/meetingStyle";
    import { DefinedType } from "@Obsidian/SystemGuids/definedType";
    import { getSecurityGrant, provideSecurityGrant, setCustomSettingsBoxValue, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
    import { CustomSettingsBox } from "@Obsidian/ViewModels/Blocks/customSettingsBox";
    import { GroupFinderCustomSettingsBag } from "@Obsidian/ViewModels/Blocks/Group/GroupFinder/groupFinderCustomSettingsBag";
    import { GroupFinderCustomSettingsOptionsBag } from "@Obsidian/ViewModels/Blocks/Group/GroupFinder/groupFinderCustomSettingsOptionsBag";
    import { PageRouteValueBag } from "@Obsidian/ViewModels/Rest/Controls/pageRouteValueBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    const invokeBlockAction = useInvokeBlockAction();
    const securityGrant = getSecurityGrant(null);
    const reloadBlock = useReloadBlock();

    const emit = defineEmits<{
        (e: "close"): void
    }>();

    // The full set of meeting styles the Where filter can offer, derived from the MeetingStyle enum so the
    // value (the enum name) and label (its Description) stay single-sourced with the server rather than
    // hardcoded here.
    const meetingStyleItems: ListItemBag[] = Object.entries(MeetingStyle).map(([name, value]) => ({
        value: name,
        text: MeetingStyleDescription[value]
    }));

    // The distance calculations, derived from their enum the same way. The higher modes lean on Google
    // services the panel probed when it opened; a mode whose service did not answer is disabled and labeled
    // so, rather than offered and left to fail at search time.
    const distanceCalculationItems = computed((): ListItemBag[] => {
        return Object.entries(DistanceCalculationMode).map(([name, value]) => {
            const isUnavailable = !isModeAvailable(value);

            return {
                value: name,
                text: isUnavailable
                    ? `${DistanceCalculationModeDescription[value]} · Google Maps API Not Configured Correctly`
                    : DistanceCalculationModeDescription[value],
                disabled: isUnavailable
            };
        });
    });

    // The dropdown shows labels alone, so the help carries what each option does and what it costs, which is
    // what an administrator is actually choosing between.
    const distanceCalculationHelp = computed((): string => {
        return "<div style='text-align: left;'>"
            + "How the finder handles the visitor's location and the distance shown on each card. Each option builds on the one above it."
            + "<ul style='margin: 0.35em 0 0; padding-left: 1.1em;'>"
            + "<li><strong>None</strong>: no location search, and no distance on the cards.</li>"
            + "<li><strong>Straight-Line Distance (My Current Location)</strong>: the visitor shares their location through the browser, and the cards show the direct-line distance to each group. Works with no Google configuration.</li>"
            + "<li><strong>Straight-Line Distance (Address or Zip Code)</strong>: also adds an address box, which resolves the entry through Google geocoding.</li>"
            + "<li><strong>Driving Distance</strong>: also shows drive time and driving miles for the groups on screen, at the expense of more API credits. Paging still uses straight-line distance, but each page orders by drive time.</li>"
            + "</ul>"
            + "<div style='margin-top: 0.35em;'>Each option is checked against Google when this panel opens, and any that is not configured is disabled.</div>"
            + "</div>";
    });

    // #region Values

    const errorMessage = ref("");
    // A save failure, shown within the form (not replacing it the way errorMessage does) so the admin's
    // edits stay on screen to retry.
    const saveError = ref("");
    const isLoading = ref(true);
    const isModalOpen = ref(true);

    // Group types and attributes.
    const groupTypes = ref<ListItemBag[]>([]);
    const featuredAttributes = ref<string[]>([]);
    const displayAttributeFilters = ref<string[]>([]);
    const showAttributeOnCard = ref<string[]>([]);

    // Filters.
    const isCampusFilterHidden = ref(false);
    const campusTypes = ref<ListItemBag[]>([]);
    const campusStatuses = ref<ListItemBag[]>([]);
    const distanceCalculation = ref("StraightLineCurrentLocation");
    // Whether each higher mode's Google service answered its probe when the panel opened. These drive which
    // options the dropdown disables, so they come from the options bag rather than being assumed.
    const isAddressSearchAvailable = ref(false);
    const isDrivingDistanceAvailable = ref(false);
    const supportedMeetingStyles = ref<string[]>([]);
    const isDayOfWeekFilterShown = ref(false);
    const isTimeOfDayFilterShown = ref(false);
    const isLiveSearchEnabled = ref(false);

    // Card and map.
    const isImageShown = ref(false);
    const isAverageAgeShown = ref(false);
    const isMapShown = ref(false);
    const groupMarkerColor = ref("");
    const currentLocationMarkerColor = ref("");
    const mapStyle = ref<ListItemBag | null>(null);
    const groupCardTemplate = ref("");

    // Linked pages.
    const registerPage = ref<PageRouteValueBag | null>(null);

    // Available options, rescoped whenever the selected group types change.
    const availableFeaturedAttributes = ref<ListItemBag[]>([]);
    const availableDisplayAttributes = ref<ListItemBag[]>([]);
    const availableCardAttributes = ref<ListItemBag[]>([]);

    // #endregion Values

    // #region Computed Values

    const saveButtonText = computed((): string => {
        // Show Save only when the form is actually displayed (loaded and no load error). On a load failure
        // the form is hidden behind the error, so a save would persist the component's default, empty values
        // over the block's real settings.
        return !isLoading.value && !errorMessage.value ? "Save" : "";
    });

    const securityGrantToken = computed((): string | null => {
        return securityGrant.token.value;
    });

    // Featured and More Filters are mutually exclusive: an attribute chosen in one drops out of the
    // other's list, so it can never be selected in both.
    const featuredItems = computed((): ListItemBag[] => {
        return availableFeaturedAttributes.value.filter(item => !displayAttributeFilters.value.includes(item.value ?? ""));
    });

    const displayItems = computed((): ListItemBag[] => {
        return availableDisplayAttributes.value.filter(item => !featuredAttributes.value.includes(item.value ?? ""));
    });

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Rescopes the available attribute options to the currently-selected group types, and drops any
     * selection that is no longer available under them.
     */
    async function onGroupTypesUpdated(): Promise<void> {
        const selectedGroupTypeGuids = groupTypes.value.map(gt => gt.value ?? "");

        const result = await invokeBlockAction<GroupFinderCustomSettingsOptionsBag>("GetUpdatedAttributeOptions", { selectedGroupTypeGuids });
        if (!result.isSuccess || !result.data) {
            errorMessage.value = result.errorMessage || "Unknown error while loading attributes for the selected group types.";
            return;
        }

        availableFeaturedAttributes.value = result.data.availableFeaturedAttributes ?? [];
        availableDisplayAttributes.value = result.data.availableDisplayAttributes ?? [];
        availableCardAttributes.value = result.data.availableCardAttributes ?? [];
        isAddressSearchAvailable.value = result.data.isAddressSearchAvailable;
        isDrivingDistanceAvailable.value = result.data.isDrivingDistanceAvailable;
        applyAvailabilityFallback();

        featuredAttributes.value = featuredAttributes.value.filter(v => availableFeaturedAttributes.value.some(a => a.value === v));
        displayAttributeFilters.value = displayAttributeFilters.value.filter(v => availableDisplayAttributes.value.some(a => a.value === v));
        showAttributeOnCard.value = showAttributeOnCard.value.filter(v => availableCardAttributes.value.some(a => a.value === v));
    }

    /**
     * Saves the block settings.
     */
    async function onSave(): Promise<void> {
        saveError.value = "";

        const box: CustomSettingsBox<GroupFinderCustomSettingsBag, GroupFinderCustomSettingsOptionsBag> = {};

        setCustomSettingsBoxValue(box, "groupTypes", groupTypes.value);
        setCustomSettingsBoxValue(box, "featuredAttributes", featuredAttributes.value);
        setCustomSettingsBoxValue(box, "displayAttributeFilters", displayAttributeFilters.value);
        setCustomSettingsBoxValue(box, "showAttributeOnCard", showAttributeOnCard.value);

        setCustomSettingsBoxValue(box, "isCampusFilterHidden", isCampusFilterHidden.value);
        setCustomSettingsBoxValue(box, "campusTypes", campusTypes.value);
        setCustomSettingsBoxValue(box, "campusStatuses", campusStatuses.value);
        setCustomSettingsBoxValue(box, "distanceCalculation", distanceCalculation.value);
        setCustomSettingsBoxValue(box, "supportedMeetingStyles", supportedMeetingStyles.value);
        setCustomSettingsBoxValue(box, "isDayOfWeekFilterShown", isDayOfWeekFilterShown.value);
        setCustomSettingsBoxValue(box, "isTimeOfDayFilterShown", isTimeOfDayFilterShown.value);
        setCustomSettingsBoxValue(box, "isLiveSearchEnabled", isLiveSearchEnabled.value);

        setCustomSettingsBoxValue(box, "isImageShown", isImageShown.value);
        setCustomSettingsBoxValue(box, "isAverageAgeShown", isAverageAgeShown.value);
        setCustomSettingsBoxValue(box, "isMapShown", isMapShown.value);
        setCustomSettingsBoxValue(box, "groupMarkerColor", groupMarkerColor.value);
        setCustomSettingsBoxValue(box, "currentLocationMarkerColor", currentLocationMarkerColor.value);
        setCustomSettingsBoxValue(box, "mapStyle", mapStyle.value);
        setCustomSettingsBoxValue(box, "groupCardTemplate", groupCardTemplate.value);

        setCustomSettingsBoxValue(box, "registerPage", registerPage.value);

        const result = await invokeBlockAction("SaveCustomSettings", { box });

        if (result.isSuccess) {
            isModalOpen.value = false;
            reloadBlock();
        }
        else {
            saveError.value = result.errorMessage || "Unable to save block settings.";
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Determines whether a distance-calculation mode can be chosen, given the services the panel probed.
     * None and current-location need nothing; the address and driving modes each need their probe to have answered.
     */
    function isModeAvailable(mode: number): boolean {
        if (mode === DistanceCalculationMode.StraightLineAddress) {
            return isAddressSearchAvailable.value;
        }

        if (mode === DistanceCalculationMode.Driving) {
            return isDrivingDistanceAvailable.value;
        }

        return true;
    }

    /**
     * Drops the selection to the highest available mode at or below the saved one when the saved mode's
     * service is no longer available, so the panel never opens on a disabled selection.
     */
    function applyAvailabilityFallback(): void {
        const saved = DistanceCalculationMode[distanceCalculation.value as keyof typeof DistanceCalculationMode];
        if (saved === undefined || isModeAvailable(saved)) {
            return;
        }

        const fallback = Object.entries(DistanceCalculationMode)
            .filter(([, value]) => value < saved && isModeAvailable(value))
            .sort(([, a], [, b]) => b - a)[0];

        if (fallback) {
            distanceCalculation.value = fallback[0];
        }
    }

    /**
     * Loads the current settings and available options so the panel can be displayed.
     */
    async function startLoading(): Promise<void> {
        const result = await invokeBlockAction<CustomSettingsBox<GroupFinderCustomSettingsBag, GroupFinderCustomSettingsOptionsBag>>("GetCustomSettings");

        if (result.isSuccess && result.data && result.data.settings && result.data.options) {
            const settings = result.data.settings;

            groupTypes.value = settings.groupTypes ?? [];
            featuredAttributes.value = settings.featuredAttributes ?? [];
            displayAttributeFilters.value = settings.displayAttributeFilters ?? [];
            showAttributeOnCard.value = settings.showAttributeOnCard ?? [];

            isCampusFilterHidden.value = settings.isCampusFilterHidden;
            campusTypes.value = settings.campusTypes ?? [];
            campusStatuses.value = settings.campusStatuses ?? [];
            distanceCalculation.value = settings.distanceCalculation ?? "StraightLineCurrentLocation";
            supportedMeetingStyles.value = settings.supportedMeetingStyles ?? [];
            isDayOfWeekFilterShown.value = settings.isDayOfWeekFilterShown;
            isTimeOfDayFilterShown.value = settings.isTimeOfDayFilterShown;
            isLiveSearchEnabled.value = settings.isLiveSearchEnabled;

            isImageShown.value = settings.isImageShown;
            isAverageAgeShown.value = settings.isAverageAgeShown;
            isMapShown.value = settings.isMapShown;
            groupMarkerColor.value = settings.groupMarkerColor ?? "";
            currentLocationMarkerColor.value = settings.currentLocationMarkerColor ?? "";
            mapStyle.value = settings.mapStyle ?? null;
            groupCardTemplate.value = settings.groupCardTemplate ?? "";

            registerPage.value = settings.registerPage ?? null;

            securityGrant.updateToken(result.data.securityGrantToken);
            availableFeaturedAttributes.value = result.data.options.availableFeaturedAttributes ?? [];
            availableDisplayAttributes.value = result.data.options.availableDisplayAttributes ?? [];
            availableCardAttributes.value = result.data.options.availableCardAttributes ?? [];
            isAddressSearchAvailable.value = result.data.options.isAddressSearchAvailable;
            isDrivingDistanceAvailable.value = result.data.options.isDrivingDistanceAvailable;
            applyAvailabilityFallback();
        }
        else {
            errorMessage.value = result.errorMessage || "Unknown error while loading custom settings.";
        }

        isLoading.value = false;
    }

    // #endregion Functions

    // #region Watchers

    watch(isModalOpen, () => {
        if (!isModalOpen.value) {
            emit("close");
        }
    });

    // #endregion Watchers

    provideSecurityGrant(securityGrant);

    startLoading();
</script>
