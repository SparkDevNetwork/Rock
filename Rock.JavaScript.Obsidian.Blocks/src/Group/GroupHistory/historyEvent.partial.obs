<template>
    <div class="history-event">
        <span class="history-event-icon">
            <i :class="iconCssClass"></i>
        </span>

        <div class="history-event-body">
            <div class="history-event-title">
                <template v-for="(part, index) in titleParts" :key="index">
                    <a v-if="part.url" :href="part.url" class="history-event-emphasis">{{ part.text }}</a>
                    <span v-else-if="part.isEmphasized" class="history-event-emphasis">{{ part.text }}</span>
                    <template v-else>{{ part.text }}</template>
                </template>
                <span class="history-event-time">{{ timeText }}</span>
            </div>

            <ul v-if="visibleChanges.length" class="history-event-changes">
                <li v-for="(change, index) in visibleChanges" :key="index">
                    <template v-if="change.isSensitive">
                        Changed {{ change.valueName }} <span class="history-event-change-value">(sensitive value not shown)</span>
                    </template>
                    <template v-else-if="!change.newValue">
                        Removed the {{ change.valueName }}
                    </template>
                    <template v-else>
                        {{ change.isInitialValue ? "Set" : "Changed" }} {{ change.valueName }} to
                        <span class="history-event-change-value" v-html="change.newValue"></span>
                    </template>
                </li>
            </ul>

            <a v-if="hiddenChangeCount > 0" href="#" class="history-event-more" @click.prevent="onShowAllChangesClick">
                See {{ hiddenChangeCount }} more {{ hiddenChangeCount === 1 ? "update" : "updates" }}...
            </a>

            <div v-if="avatarPersons.length" class="history-event-avatars">
                <component :is="person.memberHistoryUrl ? 'a' : 'span'"
                           v-for="(person, index) in avatarPersons"
                           :key="person.personIdKey ?? index"
                           :href="person.memberHistoryUrl || undefined"
                           class="history-event-avatar"
                           :title="person.fullName ?? ''">
                    <PersonAvatar v-if="person.photoUrl"
                                  :photoUrl="person.photoUrl"
                                  :personIdKey="person.personIdKey ?? ''"
                                  :photoSize="24"
                                  marginRight="0"
                                  :alwaysShowAvatar="true"
                                  :enableHoverInfo="!!person.personIdKey" />
                    <span v-else class="history-event-avatar-initials">{{ getInitials(person) }}</span>
                </component>
                <span v-if="extraPersonCount > 0" class="history-event-avatars-more">+{{ extraPersonCount }} more</span>
            </div>
        </div>
    </div>
</template>

<style scoped>
.history-event {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    width: 100%;
}

.history-event-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    font-size: 12px;
    color: var(--color-interface-strong);
    background-color: var(--color-interface-softer);
    border: 1px solid var(--color-interface-soft);
    border-radius: 999px;
}

.history-event-body {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
}

.history-event-title {
    font-size: var(--font-size-h5);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    color: var(--color-interface-strong);
    overflow-wrap: break-word;
}

.history-event-emphasis {
    color: var(--color-link);
}

.history-event-time {
    margin-left: 4px;
    font-size: var(--font-size-xsmall);
    font-weight: var(--font-weight-regular);
    color: var(--color-interface-medium);
    white-space: nowrap;
}

.history-event-changes {
    padding-left: 20px;
    margin: 0;
    font-size: var(--font-size-small);
    color: var(--color-interface-medium);
}

.history-event-changes li {
    overflow-wrap: break-word;
}

.history-event-change-value {
    color: var(--color-interface-strong);
}

/* Formatted field values (images, HTML attributes) must stay inside the card. */
.history-event-change-value :deep(img) {
    display: inline-block;
    max-width: 120px;
    max-height: 120px;
    vertical-align: middle;
}

.history-event-change-value :deep(p) {
    display: inline;
    margin: 0;
}

.history-event-more {
    font-size: var(--font-size-small);
}

.history-event-avatars {
    display: flex;
    align-items: center;
}

.history-event-avatar {
    display: inline-flex;
    overflow: hidden;
    text-decoration: none;
    background-color: var(--color-interface-softest);
    border: 2px solid var(--color-interface-softest);
    border-radius: 50%;
}

.history-event-avatar + .history-event-avatar {
    margin-left: -6px;
}

.history-event-avatar-initials {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    font-size: var(--font-size-xsmall);
    color: var(--color-interface-strong);
    background-color: var(--color-interface-soft);
    border-radius: 50%;
}

.history-event-avatars-more {
    margin-left: 8px;
    font-size: var(--font-size-xsmall);
    color: var(--color-interface-medium);
}
</style>

<script setup lang="ts">
    import { computed, PropType, ref } from "vue";
    import PersonAvatar from "@Obsidian/Controls/personAvatar.obs";
    import { GroupHistoryEventType } from "@Obsidian/Enums/Group/groupHistoryEventType";
    import { GroupHistoryChangeBag } from "@Obsidian/ViewModels/Blocks/Group/GroupHistory/groupHistoryChangeBag";
    import { GroupHistoryEventBag } from "@Obsidian/ViewModels/Blocks/Group/GroupHistory/groupHistoryEventBag";
    import { GroupHistoryPersonBag } from "@Obsidian/ViewModels/Blocks/Group/GroupHistory/groupHistoryPersonBag";
    import { RockDateTime } from "@Obsidian/Utility/rockDateTime";

    // #region Types

    type TitlePart = {
        text: string;
        url?: string | null;
        isEmphasized?: boolean;
    };

    // #endregion Types

    const props = defineProps({
        historyEvent: {
            type: Object as PropType<GroupHistoryEventBag>,
            required: true
        }
    });

    /** The maximum number of change bullets shown before the rest collapse behind a "See more" link. */
    const maxVisibleChanges = 9;

    /** The maximum number of avatars shown before the rest collapse into a "+N more" label. */
    const maxVisibleAvatars = 5;

    // #region Values

    const isShowingAllChanges = ref(false);

    // #endregion Values

    // #region Computed Values

    const iconCssClass = computed((): string => {
        switch (props.historyEvent.eventType) {
            case GroupHistoryEventType.GroupCreated:
                return "ti ti-users-plus";

            case GroupHistoryEventType.GroupUpdated:
            case GroupHistoryEventType.MemberUpdated:
                return "ti ti-pencil";

            case GroupHistoryEventType.MembersAdded:
                return "ti ti-user-plus";

            case GroupHistoryEventType.MembersRemoved:
                return "ti ti-user-minus";

            default:
                return "ti ti-calendar";
        }
    });

    const actorPart = computed((): TitlePart | null => {
        if (!props.historyEvent.actorName) {
            return null;
        }

        return {
            text: props.historyEvent.isActorCurrentPerson ? "You" : props.historyEvent.actorName,
            url: props.historyEvent.actorProfileUrl,
            isEmphasized: true
        };
    });

    const titleParts = computed((): TitlePart[] => {
        const event = props.historyEvent;
        const actor = actorPart.value;
        const memberCount = event.persons?.length ?? 0;
        const memberText = memberCount === 1 ? "member" : "members";
        const subject = event.persons?.[0];

        switch (event.eventType) {
            case GroupHistoryEventType.GroupCreated:
                return actor
                    ? [
                        actor,
                        { text: " created a group called " },
                        { text: event.targetText ?? "", url: event.targetUrl, isEmphasized: true }
                    ]
                    : [
                        { text: event.targetText ?? "", url: event.targetUrl, isEmphasized: true },
                        { text: " was created" }
                    ];

            case GroupHistoryEventType.GroupUpdated:
                return actor
                    ? [actor, { text: " updated the group" }]
                    : [{ text: "The group was updated" }];

            case GroupHistoryEventType.MembersAdded:
                // When the block supplies a target the member is named (as the
                // member timeline does, where the whole page is about them);
                // otherwise the members are counted, as the group timeline does.
                if (actor && event.targetText) {
                    return [
                        actor,
                        { text: " added " },
                        { text: event.targetText, url: event.targetUrl, isEmphasized: true }
                    ];
                }

                return actor
                    ? [actor, { text: ` added ${memberCount} ${memberText}` }]
                    : [
                        { text: subject?.fullName ?? "", url: subject?.memberHistoryUrl, isEmphasized: true },
                        { text: " was added to group" }
                    ];

            case GroupHistoryEventType.MembersRemoved:
                if (actor && event.targetText) {
                    return [
                        actor,
                        { text: " removed " },
                        { text: event.targetText, url: event.targetUrl, isEmphasized: true }
                    ];
                }

                return actor
                    ? [actor, { text: ` removed ${memberCount} ${memberText}` }]
                    : [
                        { text: subject?.fullName ?? "", url: subject?.memberHistoryUrl, isEmphasized: true },
                        { text: " was removed from group" }
                    ];

            case GroupHistoryEventType.MemberUpdated:
                // Several members with the identical change set are collapsed
                // into one event and phrased by count; a single member is named.
                if (memberCount > 1) {
                    return actor
                        ? [actor, { text: ` updated ${memberCount} ${memberText}` }]
                        : [{ text: `${memberCount} ${memberText} were updated` }];
                }

                return actor
                    ? [
                        actor,
                        { text: " updated " },
                        { text: event.targetText ?? "", url: event.targetUrl, isEmphasized: true }
                    ]
                    : [
                        { text: event.targetText ?? "", url: event.targetUrl, isEmphasized: true },
                        { text: " was updated" }
                    ];

            default:
                // Captions are arbitrary text (e.g. "Group Member Deleted"),
                // so the actor is appended as "by X" rather than prefixed,
                // which reads correctly for any caption shape and avoids
                // implying the actor was the subject of the event.
                return actor
                    ? [{ text: `${event.captionText ?? ""} by ` }, actor]
                    : [{ text: event.captionText ?? "" }];
        }
    });

    const timeText = computed((): string => {
        if (!props.historyEvent.eventDateTime) {
            return "";
        }

        return RockDateTime.parseISO(props.historyEvent.eventDateTime)?.toASPString("h:mmtt") ?? "";
    });

    const changes = computed((): GroupHistoryChangeBag[] => {
        return props.historyEvent.changes ?? [];
    });

    const visibleChanges = computed((): GroupHistoryChangeBag[] => {
        return isShowingAllChanges.value ? changes.value : changes.value.slice(0, maxVisibleChanges);
    });

    const hiddenChangeCount = computed((): number => {
        return isShowingAllChanges.value ? 0 : Math.max(0, changes.value.length - maxVisibleChanges);
    });

    const avatarPersons = computed((): GroupHistoryPersonBag[] => {
        return (props.historyEvent.persons ?? []).slice(0, maxVisibleAvatars);
    });

    const extraPersonCount = computed((): number => {
        return Math.max(0, (props.historyEvent.persons?.length ?? 0) - maxVisibleAvatars);
    });

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Expands the change list to show every change for this event.
     */
    function onShowAllChangesClick(): void {
        isShowingAllChanges.value = true;
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Gets up to two initials from the person's full name for the avatar
     * fallback when no photo is available.
     */
    function getInitials(person: GroupHistoryPersonBag): string {
        return (person.fullName ?? "")
            .split(" ")
            .filter(part => part.length > 0)
            .slice(0, 2)
            .map(part => part[0].toUpperCase())
            .join("");
    }

    // #endregion Functions
</script>
