<template>
    <RecipientModal v-model="internalIsOpen"
                    :recipients="recipients"
                    :title="title"
                    :disabled="disabled"
                    :disabledMessage="disabledMessage"
                    :isForBulkCommunication="isBulkCommunication"
                    :isAddShown="isAddShown"
                    :isRemoveShown="isRemoveShown"
                    :isRemoveAllShown="isRemoveAllShown"
                    :saveButtonText="saveButtonText"
                    :cancelButtonText="cancelButtonText"
                    addRecipientLabel="Person"
                    :getKey="getKey"
                    :resolveRecipient="resolveRecipient"
                    @update:recipients="onRecipientsUpdated">
        <template #header>
            <template v-if="isManualCommunicationList">
                <SectionHeader v-if="!isAddingIndividualsToRecipientListsDisabled"
                               title="Recipient List"
                               description="Below is a listing of your current recipients. You can add or remove individuals from this list before continuing." />
                <SectionHeader v-else
                               title="Recipient List"
                               description="Below is a listing of your current recipients." />
            </template>
            <NotificationBox v-else alertType="info">
                Below are the current members of the "{{ communicationListGroupName }}" List with segment filters applied. If this message is sent at a future date, it is possible that the list may change between now and then.
            </NotificationBox>
        </template>
    </RecipientModal>
</template>

<script setup lang="ts">
    import { PropType, Ref, computed } from "vue";
    import RecipientModal from "../Shared/recipientModal.partial.obs";
    import { RecipientListItem } from "../Shared/types.partial";
    import { useInvokeBlockActionHelper } from "./utils.partial";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import SectionHeader from "@Obsidian/Controls/sectionHeader.obs";
    import { CommunicationType } from "@Obsidian/Enums/Communication/communicationType";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import { CommunicationEntryWizardRecipientBag } from "@Obsidian/ViewModels/Blocks/Communication/CommunicationEntryWizard/communicationEntryWizardRecipientBag";

    // #region Types

    const props = defineProps({
        modelValue: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        communicationListGroupName: {
            type: String as PropType<string | null | undefined>
        },

        disabled: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        disabledMessage: {
            type: String as PropType<string | null | undefined>,
            required: false
        },

        getTooltipRef: {
            type: Function as PropType<(value: CommunicationEntryWizardRecipientBag | null, mode: CommunicationType) => Ref<string>>,
            default: (_: string) => ""
        },

        isAddingIndividualsToRecipientListsDisabled: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        isDeletingIndividualsFromRecipientListsDisabled: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        isBulkCommunication: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        recipients: {
            type: Object as PropType<CommunicationEntryWizardRecipientBag[]>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", newValue: boolean): void,
        (e: "update:recipients", newValue: CommunicationEntryWizardRecipientBag[]): void
    }>();

    // #endregion Types

    // #region Values

    const invokeBlockAction = useInvokeBlockActionHelper();
    const internalIsOpen = useVModelPassthrough(props, "modelValue", emit);

    // #endregion Values

    // #region Computed Values

    const isManualCommunicationList = computed<boolean>(() => !props.communicationListGroupName);

    const title = computed<string>(() => {
        if (!isManualCommunicationList.value) {
            return "Communication List Recipients";
        }

        return props.isAddingIndividualsToRecipientListsDisabled ? "View / Remove Recipients" : "Add / Remove Recipients";
    });

    const isAddShown = computed<boolean>(() => isManualCommunicationList.value && !props.isAddingIndividualsToRecipientListsDisabled);
    const isRemoveShown = computed<boolean>(() => !props.isDeletingIndividualsFromRecipientListsDisabled);
    const isRemoveAllShown = computed<boolean>(() => isManualCommunicationList.value);
    const saveButtonText = computed<string>(() => isManualCommunicationList.value ? "Save" : "OK");
    const cancelButtonText = computed<string>(() => isManualCommunicationList.value ? "Cancel" : "");

    // #endregion Computed Values

    // #region Functions

    function getKey(recipient: RecipientListItem): string {
        return (recipient as CommunicationEntryWizardRecipientBag).personAliasIdKey ?? "";
    }

    async function resolveRecipient(personAliasValue: string): Promise<RecipientListItem | null> {
        const result = await invokeBlockAction.getRecipient(personAliasValue);

        if (!result?.isSuccess || !result.data) {
            console.error("An unexpected error occurred while retrieving information about the selected person:", result?.errorMessage);
            return null;
        }

        return result.data;
    }

    // #endregion Functions

    // #region Event Handlers

    function onRecipientsUpdated(recipients: RecipientListItem[]): void {
        // In list mode the recipients are the resolved list members, not a manual list, so they are not persisted.
        if (isManualCommunicationList.value) {
            emit("update:recipients", recipients as CommunicationEntryWizardRecipientBag[]);
        }
    }

    // #endregion Event Handlers
</script>
