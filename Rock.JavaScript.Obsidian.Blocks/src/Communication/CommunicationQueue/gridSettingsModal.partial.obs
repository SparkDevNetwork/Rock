<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Modal v-model="isVisible"
           title="Settings"
           saveText="Save"
           @save="onSave">
        <SectionHeader title="Filters" />

        <div class="row">
            <div class="col-md-4">
                <CheckBox v-model="showFutureCommunications"
                          label="Show Future Communications" />
            </div>
            <div class="col-md-4">
                <CheckBox v-model="showPendingApproval"
                          label="Show Communications Pending Approval" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <CheckBoxList v-model="communicationTypes"
                              label="Communication Type"
                              :items="communicationTypeItems"
                              horizontal />
            </div>
        </div>
    </Modal>
</template>

<script setup lang="ts">
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import CheckBoxList from "@Obsidian/Controls/checkBoxList.obs";
    import Modal from "@Obsidian/Controls/modal.obs";
    import SectionHeader from "@Obsidian/Controls/sectionHeader.obs";
    import { PropType, ref, watch } from "vue";
    import { GridSettingsOptions } from "./types.partial";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import { deepEqual } from "@Obsidian/Utility/util";
    import { enumToListItemBag } from "@Obsidian/Utility/enumUtils";
    import { CommunicationTypeDescription } from "@Obsidian/Enums/Communication/communicationType";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<GridSettingsOptions>,
            required: true
        },

        visible: {
            type: Boolean as PropType<boolean>,
            required: true
        },
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: GridSettingsOptions): void;
        (e: "update:visible", value: boolean): void;
    }>();

    // #region Values

    const showFutureCommunications = ref(props.modelValue.showFutureCommunications);
    const showPendingApproval = ref(props.modelValue.showPendingApproval);
    const communicationTypes = ref(props.modelValue.communicationTypes);
    const isVisible = useVModelPassthrough(props, "visible", emit);

    const communicationTypeItems = enumToListItemBag(CommunicationTypeDescription);

    // #endregion Values

    // #region Event Handlers

    function onSave(): void {
        const value: GridSettingsOptions = {
            showFutureCommunications: showFutureCommunications.value,
            showPendingApproval: showPendingApproval.value,
            communicationTypes: communicationTypes.value
        };

        if (!deepEqual(value, props.modelValue, true)) {
            emit("update:modelValue", value);
        }

        isVisible.value = false;
    }

    // #endregion Event Handlers

    // #region Watchers

    watch(() => props.modelValue, () => {
        showFutureCommunications.value = props.modelValue.showFutureCommunications;
        showPendingApproval.value = props.modelValue.showPendingApproval;
        communicationTypes.value = props.modelValue.communicationTypes;
    });

    // #endregion Watchers
</script>
