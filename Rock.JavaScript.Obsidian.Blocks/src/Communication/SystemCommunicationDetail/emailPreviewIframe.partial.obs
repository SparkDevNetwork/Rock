<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div v-if="mode === EmailViewMode.Desktop"
         class="system-communication-detail-preview-window">
        <iframe ref="autoHeightIframe"
                class="system-communication-detail-preview-iframe"
                :srcdoc="srcdoc"
                sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"></iframe>
    </div>

    <div v-else-if="mode === EmailViewMode.Mobile"
         class="system-communication-detail-preview-device">
        <iframe class="system-communication-detail-preview-iframe"
                :srcdoc="srcdoc"
                sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"></iframe>
    </div>
</template>

<script setup lang="ts">
    import { PropType, ref } from "vue";
    import { useIframeAutoHeight } from "./utils.partial";
    import { EmailViewMode } from "./types.partial";

    defineProps({
        mode: {
            type: Number as PropType<EmailViewMode>,
            required: true
        },
        srcdoc: {
            type: String as PropType<string>,
            required: true
        }
    });

    /*
        10/16/2026 - MSE

        Both preview iframes in the template show stored system communication HTML, so they are sandboxed with
        "allow-same-origin allow-popups allow-popups-to-escape-sandbox". allow-same-origin is kept
        only so useIframeAutoHeight can read the content height. Never add allow-scripts: a
        same-origin frame that may run script can remove its own sandbox.

        Reason: Stop stored XSS through the system communication preview.
    */
    const windowTitleBarHeight = 48;

    // #region Values

    const autoHeightIframe = ref<HTMLIFrameElement | undefined>();

    // #endregion Values

    useIframeAutoHeight(autoHeightIframe, { yOffsetPx: windowTitleBarHeight });
</script>
