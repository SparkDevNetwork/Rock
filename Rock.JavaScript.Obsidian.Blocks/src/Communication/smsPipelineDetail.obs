<template>
    <NotificationBox v-if="blockError" alertType="warning" v-html="blockError" />

    <NotificationBox v-if="errorMessage" alertType="danger" v-html="errorMessage" />

    <DetailBlock v-if="!blockError && pipelineBag"
                 v-model:mode="panelMode"
                 :name="pipelineBag.name ?? ''"
                 titleIconCssClass="ti ti-device-mobile-message"
                 :entityTypeGuid="EntityType.SmsPipeline"
                 entityTypeName="SMS Pipeline"
                 :entityKey="pipelineBag.idKey ?? ''"
                 :labels="blockLabels"
                 :isAuditHidden="false"
                 :isSecurityHidden="true"
                 :isEditVisible="isEditable"
                 :isDeleteVisible="isEditable && !isNew"
                 @edit="onEdit"
                 @save="onSave"
                 @delete="onDelete"
                 @cancelEdit="onCancelEdit">
        <template #view>
            <ViewPanel :pipeline="pipelineBag" />

            <template v-if="!isNew">
                <ActionList :modelValue="pipelineBag.actions ?? []"
                            :pipelineKey="pipelineBag.idKey ?? ''"
                            :availableComponents="availableComponents"
                            :filterCategoryName="filterCategoryName"
                            @update:modelValue="onActionsUpdate" />

                <TestPanel v-if="isTestingEnabled"
                           :isTesting="isTesting"
                           :testResult="testResult"
                           @sendTest="onSendTest" />
            </template>
        </template>

        <template #edit>
            <EditPanel v-model:pipeline="pipelineBag" />
        </template>
    </DetailBlock>
</template>

<script setup lang="ts">
    import { computed, ref } from "vue";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import DetailBlock from "@Obsidian/Templates/detailBlock";
    import { DetailPanelMode } from "@Obsidian/Enums/Controls/detailPanelMode";
    import { PanelAction } from "@Obsidian/Types/Controls/panelAction";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import ActionList from "./SmsPipelineDetail/actionList.partial.obs";
    import EditPanel from "./SmsPipelineDetail/editPanel.partial.obs";
    import TestPanel from "./SmsPipelineDetail/testPanel.partial.obs";
    import ViewPanel from "./SmsPipelineDetail/viewPanel.partial.obs";
    import { NavigationUrlKey } from "./SmsPipelineDetail/types.partial";
    import { SmsActionBag } from "@Obsidian/ViewModels/Blocks/Communication/SmsPipelineDetail/smsActionBag";
    import { SmsActionComponentBag } from "@Obsidian/ViewModels/Blocks/Communication/SmsPipelineDetail/smsActionComponentBag";
    import { SmsActionTestRequestBag } from "@Obsidian/ViewModels/Blocks/Communication/SmsPipelineDetail/smsActionTestRequestBag";
    import { SmsActionTestResponseBag } from "@Obsidian/ViewModels/Blocks/Communication/SmsPipelineDetail/smsActionTestResponseBag";
    import { SmsPipelineBag } from "@Obsidian/ViewModels/Blocks/Communication/SmsPipelineDetail/smsPipelineBag";
    import { SmsPipelineDetailInitializationBox } from "@Obsidian/ViewModels/Blocks/Communication/SmsPipelineDetail/smsPipelineDetailInitializationBox";

    const config = useConfigurationValues<SmsPipelineDetailInitializationBox>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const blockError = ref(config.errorMessage ?? "");
    const errorMessage = ref("");
    const pipelineBag = ref<SmsPipelineBag | null>(cloneBag(config.pipeline));
    const lastSavedHeader = ref<SmsPipelineBag | null>(cloneBag(config.pipeline));
    const isTesting = ref(false);
    const testResult = ref<SmsActionTestResponseBag | null>(null);
    const panelMode = ref<DetailPanelMode>(pipelineBag.value?.idKey ? DetailPanelMode.View : DetailPanelMode.Add);

    // #endregion Values

    // #region Computed Values

    const availableComponents = computed((): SmsActionComponentBag[] => config.availableComponents ?? []);
    const filterCategoryName = computed((): string => config.filterCategoryName ?? "Filters");
    const isEditable = computed((): boolean => config.isEditable === true);
    const isTestingEnabled = computed((): boolean => config.isTestingEnabled === true);
    const isNew = computed((): boolean => !pipelineBag.value?.idKey);

    // Active / Inactive status labels shown in the panel header, matching the
    // standard detail-block treatment used by other detail blocks.
    const blockLabels = computed((): PanelAction[] | undefined => {
        if (panelMode.value !== DetailPanelMode.View) {
            return undefined;
        }

        if (pipelineBag.value?.isActive) {
            return [{ iconCssClass: "ti ti-bulb-filled", title: "Active", type: "success" }];
        }

        return [{ iconCssClass: "ti ti-bulb", title: "Inactive", type: "danger" }];
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onActionsUpdate(value: SmsActionBag[]): void {
        if (pipelineBag.value) {
            pipelineBag.value.actions = value;
        }
    }

    async function onSendTest(request: SmsActionTestRequestBag): Promise<void> {
        isTesting.value = true;
        testResult.value = null;

        try {
            const result = await invokeBlockAction<SmsActionTestResponseBag>("SendTestMessage", { request });

            testResult.value = result.isSuccess && result.data
                ? result.data
                : { errorMessage: result.errorMessage ?? "Unable to run the test message." };
        }
        finally {
            isTesting.value = false;
        }
    }

    async function onEdit(): Promise<boolean> {
        return true;
    }

    async function onSave(): Promise<boolean | string> {
        if (!pipelineBag.value) {
            return false;
        }

        errorMessage.value = "";

        const result = await invokeBlockAction<SmsPipelineBag | string>("Save", {
            bag: pipelineBag.value
        });

        if (!result.isSuccess) {
            errorMessage.value = result.errorMessage ?? "Unable to save the SMS pipeline.";
            return false;
        }

        if (result.statusCode === 201 && typeof result.data === "string") {
            return result.data;
        }

        if (result.data && typeof result.data === "object") {
            pipelineBag.value = result.data;
            lastSavedHeader.value = cloneBag(result.data);
        }

        return true;
    }

    async function onDelete(): Promise<false | string> {
        errorMessage.value = "";

        const result = await invokeBlockAction<string>("Delete");

        if (result.isSuccess && result.data) {
            return result.data;
        }

        errorMessage.value = result.errorMessage ?? "Unable to delete the SMS pipeline.";
        return false;
    }

    async function onCancelEdit(): Promise<boolean | string> {
        if (isNew.value) {
            return config.navigationUrls?.[NavigationUrlKey.ParentPage] ?? false;
        }

        // Revert only the header scalars; actions are managed separately in view mode.
        if (lastSavedHeader.value && pipelineBag.value) {
            pipelineBag.value = {
                ...pipelineBag.value,
                name: lastSavedHeader.value.name,
                description: lastSavedHeader.value.description,
                isActive: lastSavedHeader.value.isActive
            };
        }

        return true;
    }

    // #endregion Event Handlers

    // #region Functions

    function cloneBag(bag: SmsPipelineBag | null | undefined): SmsPipelineBag | null {
        return bag ? JSON.parse(JSON.stringify(bag)) as SmsPipelineBag : null;
    }

    // #endregion Functions
</script>
