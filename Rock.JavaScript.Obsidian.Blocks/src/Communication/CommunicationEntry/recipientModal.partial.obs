<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <RecipientModal v-model="internalIsOpen"
                    :recipients="recipients"
                    :disabled="disabled"
                    :disabledMessage="disabledMessage"
                    :isForBulkCommunication="isForBulkCommunication"
                    :isAddShown="isAddShown"
                    :isRemoveShown="isRemoveShown"
                    :isRemoveAllShown="isRemoveAllShown"
                    :saveButtonText="saveButtonText"
                    :cancelButtonText="cancelButtonText"
                    :getKey="getKey"
                    :resolveRecipient="resolveRecipient"
                    @update:recipients="onRecipientsUpdated" />
</template>

<script setup lang="ts">
    import { PropType, Ref, computed } from "vue";
    import RecipientModal from "../Shared/recipientModal.partial.obs";
    import { RecipientListItem } from "../Shared/types.partial";
    import { MediumType } from "./types.partial";
    import { useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import { CommunicationEntryRecipientBag } from "@Obsidian/ViewModels/Blocks/Communication/CommunicationEntry/communicationEntryRecipientBag";

    // #region Types

    const props = defineProps({
        modelValue: {
            type: Object as PropType<boolean>,
            required: true
        },

        disabled: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** A message to be displayed when `disabled` is `true`. */
        disabledMessage: {
            type: String as PropType<string | null | undefined>,
            required: false
        },

        getTooltipRef: {
            type: Function as PropType<(value: CommunicationEntryRecipientBag | null, mode: MediumType) => Ref<string>>,
            default: (_: string) => ""
        },

        isAddHidden: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        isForBulkCommunication: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        recipients: {
            type: Object as PropType<CommunicationEntryRecipientBag[]>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", newValue: boolean): void,
        (e: "update:recipients", newValue: CommunicationEntryRecipientBag[]): void
    }>();

    // #endregion Types

    // #region Values

    const invokeBlockAction = useInvokeBlockAction();
    const internalIsOpen = useVModelPassthrough(props, "modelValue", emit);

    // #endregion Values

    // #region Computed Values

    /*
        A disabled modal is the read-only "View List" preview of a communication list's members; an enabled
        modal is manual recipient editing. Read-only hides the editing affordances and confirms with a single OK.
    */
    const isAddShown = computed<boolean>(() => !props.isAddHidden && !props.disabled);
    const isRemoveShown = computed<boolean>(() => !props.disabled);
    const isRemoveAllShown = computed<boolean>(() => !props.disabled);
    const saveButtonText = computed<string>(() => props.disabled ? "OK" : "Save");
    const cancelButtonText = computed<string>(() => props.disabled ? "" : "Cancel");

    // #endregion Computed Values

    // #region Functions

    function getKey(recipient: RecipientListItem): string {
        return (recipient as CommunicationEntryRecipientBag).personAliasGuid;
    }

    async function resolveRecipient(personAliasValue: string): Promise<RecipientListItem | null> {
        const result = await invokeBlockAction<CommunicationEntryRecipientBag>("GetRecipient", { personAliasGuid: personAliasValue });

        if (!result?.isSuccess || !result.data) {
            console.error("An unexpected error occurred while retrieving information about the selected person:", result?.errorMessage);
            return null;
        }

        return result.data;
    }

    // #endregion Functions

    // #region Event Handlers

    function onRecipientsUpdated(recipients: RecipientListItem[]): void {
        emit("update:recipients", recipients as CommunicationEntryRecipientBag[]);
    }

    // #endregion Event Handlers
</script>
