<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div v-if="mode === 'desktop'"
         class="window">
        <iframe ref="autoHeightIframe"
                class="window-iframe"
                :srcdoc="srcdoc"
                sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"></iframe>
    </div>

    <div v-else-if="mode === 'mobile'"
         class="mobile-device">
        <iframe class="window-iframe"
                :srcdoc="srcdoc"
                sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"></iframe>
    </div>
</template>

<script setup lang="ts">
    import { PropType, ref } from "vue";
    import { useIframeAutoHeight as useAutoHeightIframe } from "./utils.partial";

    defineProps({
        mode: {
            type: String as PropType<"desktop" | "mobile">,
            required: true
        },
        srcdoc: {
            type: String as PropType<string>,
            required: true
        }
    });

    /*
        10/16/2026 - MSE

        Both preview iframes in the template show stored template HTML, so they are sandboxed with
        "allow-same-origin allow-popups allow-popups-to-escape-sandbox". allow-same-origin is kept
        only so useIframeAutoHeight can read contentDocument.body.scrollHeight. Never add
        allow-scripts: a same-origin frame that may run script can remove its own sandbox.

        Reason: Stop stored XSS through the communication template preview.
    */
    const windowTitleBarHeight = 48;

    // #region Values

    const autoHeightIframe = ref<HTMLIFrameElement | undefined>();

    // #endregion Values

    useAutoHeightIframe(autoHeightIframe, { yOffsetPx: windowTitleBarHeight });
</script>
