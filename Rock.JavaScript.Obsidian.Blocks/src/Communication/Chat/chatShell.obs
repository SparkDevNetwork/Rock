<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="chat-shell" data-testid="chat-shell" :data-phase="shell.state.phase">
        <BirthdatePrompt v-if="isPromptShown"
                         :message="birthdateMessage"
                         :isSaving="isSavingBirthdate"
                         @save="onSaveBirthdate" />

        <NotificationBox v-else-if="isRefused" :alertType="AlertType.Warning">
            {{ refusal }}
        </NotificationBox>

        <div v-else class="chat-shell-layout">
            <ChannelSidebar :rows="shell.channels.rows"
                            :activeChannelId="shell.state.activeChannelId"
                            @select="onSelect" />

            <div class="chat-shell-main">
                <ChatHeader :title="activeTitle"
                            :connection="shell.state.connection"
                            :banner="shell.state.banner"
                            :isBehind="isActiveBehind"
                            :isPushOffered="shell.state.isPushOffered"
                            @turnOnPush="onTurnOnPush" />

                <MessageFeed v-if="activeChannelId"
                             :key="activeChannelId"
                             :timeline="shell.timelines.state(activeChannelId)"
                             :pending="shell.sender.pending(activeChannelId)"
                             :personAliasGuid="personAliasGuid"
                             @seen="shell.seen"
                             @firstShown="shell.firstMessageShown"
                             @retry="onRetry"
                             @discard="shell.sender.discard"
                             @loadOlder="shell.loadOlder" />
                <div v-else class="chat-shell-empty">
                    {{ shell.state.phase === "starting" ? "Opening chat…" : "Choose a channel." }}
                </div>

                <Composer :isDisabled="!activeChannelId || !shell.state.isComposerOpen" @send="shell.send" />
            </div>
        </div>

        <ErrorToast :errors="shell.state.errors" @dismiss="shell.dismissError" />
    </div>
</template>

<style scoped>
.chat-shell {
    display: flex;
    flex-direction: column;
    min-height: 480px;
}

.chat-shell-layout {
    display: flex;
    flex: 1;
    min-height: 480px;
    border: 1px solid var(--color-interface-soft, #dfe0e1);
    border-radius: var(--rounded-small, 4px);
    overflow: hidden;
}

.chat-shell-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
}

.chat-shell-empty {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    color: var(--color-interface-medium, #6c757d);
}
</style>

<script setup lang="ts">
    import { computed, onBeforeUnmount, onMounted, ref, shallowRef, watch } from "vue";
    import { createClient } from "@Obsidian/Libs/supabase";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { ChatBirthdateResultBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatBirthdateResultBag";
    import { ChatChurchTokenBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatChurchTokenBag";
    import { ChatShellInitializationBox } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatShellInitializationBox";
    import { DatePartsPickerValueBag } from "@Obsidian/ViewModels/Controls/datePartsPickerValueBag";
    import { birthdateOutcome, isBirthdatePromptShown } from "./ChatShell/birthdate.partial";
    import BirthdatePrompt from "./ChatShell/components/birthdatePrompt.partial.obs";
    import ChannelSidebar from "./ChatShell/components/channelSidebar.partial.obs";
    import ChatHeader from "./ChatShell/components/chatHeader.partial.obs";
    import Composer from "./ChatShell/components/composer.partial.obs";
    import ErrorToast from "./ChatShell/components/errorToast.partial.obs";
    import MessageFeed from "./ChatShell/components/messageFeed.partial.obs";
    import { createChatShell, PlatformClientLike, refusalMessage, ShellOptions } from "./ChatShell/shell.partial";

    // #region Types

    /** What the push worker posts to a window of the site, in the worker's own names. */
    /* eslint-disable-next-line @typescript-eslint/naming-convention */
    type WorkerMessage = { type?: string, channel_id?: string };

    // #endregion Types

    const config = useConfigurationValues<ChatShellInitializationBox>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const personAliasGuid = ref(config.session?.personAliasGuid ?? "");

    // Replaced, not reloaded, when a birthdate lets the person in: the save answers with the
    // session a fresh page load would have had.
    const shell = shallowRef(buildShell(config.session ?? {}));

    const birthdateMessage = ref<string | null>(null);
    const isSavingBirthdate = ref(false);

    /** The cookie Rock reads at sign-out to take this browser out of push. */
    const pushCookieName = "rock_chat_push";

    let firebaseAppInstance: unknown = null;

    // #endregion Values

    // #region Computed Values

    const activeChannelId = computed((): string | null => shell.value.state.activeChannelId);

    /** The unread mentions on the app icon, from the sidebar, so reading a mention clears it. */
    const mentionBadge = computed((): number => shell.value.mentionBadge());

    /** Whether the open channel's catch-up failed and is trying again, so messages may be missing. */
    const isActiveBehind = computed((): boolean => !!activeChannelId.value && shell.value.timelines.state(activeChannelId.value).isBehind);

    const isPromptShown = computed((): boolean => isBirthdatePromptShown(shell.value.state.phase, shell.value.state.gate));

    const isRefused = computed((): boolean => shell.value.state.phase === "refused" || shell.value.state.phase === "failed");

    const refusal = computed((): string => refusalMessage(shell.value.state.phase, shell.value.state.gate));

    const activeTitle = computed((): string => {
        const row = shell.value.channels.rows.find(r => r.channel_id === shell.value.state.activeChannelId);
        if (!row) {
            return "";
        }
        return row.name || (row.dm_names ?? []).join(", ");
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onSelect(channelId: string): void {
        void shell.value.selectChannel(channelId);
    }

    function onTurnOnPush(): void {
        void shell.value.turnOnPush();
    }

    /**
     * The push worker asks whether a push's channel is on screen, so it can leave the banner out,
     * and after a tap tells this window which channel to open.
     */
    function onWorkerMessage(event: MessageEvent): void {
        const message = (event.data ?? {}) as WorkerMessage;

        if (message.type === "chat.push.is-open") {
            event.ports[0]?.postMessage({ open: !!message.channel_id && shell.value.isChannelOnScreen(message.channel_id) });
        }
        else if (message.type === "chat.push.open" && message.channel_id) {
            void shell.value.selectChannel(message.channel_id.toLowerCase());
        }
    }

    function onRetry(localId: string): void {
        void shell.value.sender.retry(localId);
    }

    async function onSaveBirthdate(birthDate: DatePartsPickerValueBag): Promise<void> {
        isSavingBirthdate.value = true;
        const result = await invokeBlockAction<ChatBirthdateResultBag>("SaveBirthdate", { birthDate });
        isSavingBirthdate.value = false;

        const outcome = birthdateOutcome({ isSuccess: result.isSuccess, statusCode: result.statusCode, data: result.data });

        if (outcome.kind === "retry") {
            birthdateMessage.value = outcome.message;
            return;
        }

        birthdateMessage.value = null;

        if (outcome.kind === "refused") {
            shell.value.state.gate = outcome.gate;
            return;
        }

        await shell.value.stop();
        personAliasGuid.value = outcome.session.personAliasGuid ?? "";
        shell.value = buildShell(outcome.session);
        void shell.value.start();
    }

    // #endregion Event Handlers

    // #region Functions

    /** Builds the shell for a session, as the page load described it or a birthdate save did. */
    function buildShell(session: ShellOptions["session"]): ReturnType<typeof createChatShell> {
        return createChatShell({
            session,
            linkedChannelId: config.channelGuid ?? null,
            mintChurchToken: async () => {
                const result = await invokeBlockAction<ChatChurchTokenBag>("MintChurchToken");
                return { isSuccess: result.isSuccess, statusCode: result.statusCode, data: result.data };
            },
            createPlatformClient: (url, key, accessToken, realtime) => createClient(url, key, { accessToken, realtime }) as unknown as PlatformClientLike,
            fetch: (url, init) => window.fetch(url, init),
            storage: safeLocalStorage(),
            pageTargets: { document, window },
            push: browserPush(),
            mark: name => {
                try {
                    performance.mark(name);
                }
                catch {
                    // Intentionally ignored: timing marks are for measurement only.
                }
            }
        });
    }

    /** This browser's web push, or undefined where it has none. */
    function browserPush(): ShellOptions["push"] {
        if (!("serviceWorker" in navigator) || !("Notification" in window) || !("PushManager" in window)) {
            return undefined;
        }

        return {
            pagePath: window.location.pathname,
            permission: () => Notification.permission,
            requestPermission: () => Notification.requestPermission(),
            // Its own folder as its scope, so it never takes the site root from a worker a
            // church's theme registers there.
            registerWorker: pagePath => navigator.serviceWorker.register(
                `/Scripts/Rock/Chat/chatPushWorker.js?page=${encodeURIComponent(pagePath)}`,
                { scope: "/Scripts/Rock/Chat/" }),
            getToken: async (web, vapidKey, registration) => {
                const firebase = await import("@Obsidian/Libs/firebase");
                return firebase.getToken(firebase.getMessaging(firebaseApp(firebase, web)), {
                    vapidKey,
                    serviceWorkerRegistration: registration as ServiceWorkerRegistration
                });
            },
            writeCookie: token => {
                const secure = window.location.protocol === "https:" ? "; Secure" : "";
                document.cookie = token
                    ? `${pushCookieName}=${encodeURIComponent(token)}; path=/; max-age=31536000; SameSite=Lax${secure}`
                    : `${pushCookieName}=; path=/; max-age=0; SameSite=Lax${secure}`;
            }
        };
    }

    /** The block's one Firebase app, made on the first token and reused for every later one. */
    function firebaseApp(firebase: typeof import("@Obsidian/Libs/firebase"), web: Record<string, unknown>): ReturnType<typeof firebase.initializeApp> {
        firebaseAppInstance ??= firebase.initializeApp(web, "rock-chat");
        return firebaseAppInstance as ReturnType<typeof firebase.initializeApp>;
    }

    /** The browser's local storage, or null where the browser blocks it. */
    function safeLocalStorage(): Storage | null {
        try {
            return window.localStorage;
        }
        catch {
            return null;
        }
    }

    // #endregion Functions

    // #region Watchers

    // From the first sidebar the page loads, a count of none included, so a badge a mention push
    // left behind is cleared once the person has read it.
    watch([mentionBadge, (): string => shell.value.state.phase], ([count, phase]) => {
        if (phase !== "ready") {
            return;
        }

        // Only where the site is installed as an app does the browser draw it; elsewhere a no-op.
        const badging = navigator as Navigator & { setAppBadge?: (count?: number) => Promise<void>, clearAppBadge?: () => Promise<void> };
        const done = count > 0 ? badging.setAppBadge?.(count) : badging.clearAppBadge?.();
        void done?.catch(() => undefined);
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(() => {
        navigator.serviceWorker?.addEventListener("message", onWorkerMessage);
        void shell.value.start();
    });

    onBeforeUnmount(() => {
        navigator.serviceWorker?.removeEventListener("message", onWorkerMessage);
        void shell.value.stop();
    });

    // #endregion Lifecycle Hooks
</script>
