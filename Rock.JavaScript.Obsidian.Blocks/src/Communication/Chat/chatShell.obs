<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div ref="rootElement"
         class="chat-shell"
         data-testid="chat-shell"
         :data-phase="shell.state.phase"
         :data-phone="isPhone ? 'true' : 'false'">
        <BirthdatePrompt v-if="isPromptShown"
                         :message="birthdateMessage"
                         :isSaving="isSavingBirthdate"
                         @save="onSaveBirthdate" />

        <NotificationBox v-else-if="isRefused" :alertType="AlertType.Warning">
            {{ refusal }}
        </NotificationBox>

        <div v-else
             class="chat-frame"
             :class="{ 'is-pane-motion-on': isPaneMotionOn }"
             data-testid="chat-frame"
             :data-pane="pane"
             :data-panel-open="panelKind ? 'true' : 'false'">
            <div class="chat-frame-side"
                 data-testid="frame-sidebar"
                 :aria-hidden="isSidebarHidden ? 'true' : undefined"
                 :inert="isSidebarHidden || undefined"
                 :style="isSidebarGone ? goneStyle : undefined">
                <ChannelSidebar :rows="shell.channels.rows"
                                :activeChannelId="shell.state.activeChannelId"
                                :isNewMessageShown="shell.isNewMessageShown"
                                :organizationName="organizationName"
                                :isPhone="isPhone"
                                @select="onSelect"
                                @newMessage="isPickerShown = true" />
            </div>

            <section class="chat-frame-main"
                     data-testid="frame-main"
                     aria-label="Conversation"
                     :data-look="look ?? undefined"
                     :aria-hidden="isConversationHidden ? 'true' : undefined"
                     :inert="isConversationHidden || undefined"
                     :style="isConversationGone ? goneStyle : undefined">
                <ChatHeader :title="activeTitle"
                            :subtitle="activeSubtitle"
                            :kind="activeKind"
                            :isPublic="activeRow?.is_public ?? false"
                            :people="activePeople"
                            :connection="shell.state.connection"
                            :banner="shell.state.banner"
                            :isUpdateRequired="shell.state.isUpdateRequired"
                            :isBehind="isActiveBehind"
                            :isPushOffered="shell.state.isPushOffered"
                            :isPhone="isPhone"
                            :isEmpty="!activeChannelId && !draft"
                            :isThreadsOffered="!!activeChannelId"
                            :isThreadsOpen="panelKind === 'threads'"
                            @threads="onThreads"
                            @turnOnPush="onTurnOnPush"
                            @back="onBack"
                            @backOnline="onBackOnline" />

                <MessageFeed v-if="activeChannelId"
                             :key="activeChannelId"
                             :timeline="shell.timelines.state(activeChannelId)"
                             :pending="shell.sender.pending(activeChannelId)"
                             :personAliasGuid="personAliasGuid"
                             :personName="personName"
                             :personPhotoUrl="personPhotoUrl"
                             :organizationName="organizationName"
                             :isChannel="activeKind === 'channel'"
                             :isDirectMessage="isActiveDirectMessage"
                             :isPhone="isPhone"
                             @seen="shell.seen"
                             @markRead="shell.markRead"
                             @firstShown="shell.firstMessageShown"
                             @retry="onRetry"
                             @discard="shell.sender.discard"
                             @loadOlder="shell.loadOlder"
                             @openThread="onOpenThread" />
                <div v-else-if="draft" class="chat-shell-empty chat-shell-draft" data-testid="dm-draft" :data-status="draft.status">
                    {{ draft.status === "starting" ? "Starting the conversation…" : "Your first message starts the conversation." }}
                    <div v-if="shell.directMessages.error" class="alert alert-warning" data-testid="dm-error">{{ shell.directMessages.error }}</div>
                </div>
                <div v-else class="chat-shell-empty">
                    {{ shell.state.phase === "starting" ? "Opening chat…" : "Choose a conversation." }}
                </div>

                <Composer v-if="activeChannelId || draft"
                          :isDisabled="isComposerDisabled"
                          :title="activeKind ? activeTitle : null"
                          :isChannel="activeKind === 'channel'"
                          :isPhone="isPhone"
                          :isLocked="!shell.state.isComposerOpen"
                          :heldText="draft?.body ?? held?.body ?? ''"
                          :heldBy="draft ?? held"
                          :isTextKeptOnSend="isTextKeptOnSend(draft)"
                          @send="shell.send"
                          @edit="shell.directMessages.edit" />
            </section>

            <!--
                The panel column, closed until a thread or a list opens in it. It holds one panel
                at a time, each drawn in the shared panel host; what it held stays while it closes,
                so the column narrows over its content rather than over nothing.
            -->
            <aside ref="panelElement"
                   class="chat-frame-panel"
                   data-testid="frame-panel"
                   :aria-hidden="isPanelHidden ? 'true' : undefined"
                   :inert="isPanelHidden || undefined"
                   :style="isPanelGone ? goneStyle : undefined">
                <div class="chat-frame-panel-inner">
                    <ThreadsPanel v-if="shownPanel === 'threads'"
                                  :tab="threadList.tab"
                                  :rows="threadList.rows"
                                  :hasMore="threadList.hasMore"
                                  :isLoading="threadList.isLoading"
                                  :isRefreshing="threadList.isRefreshing"
                                  :error="threadList.error"
                                  :rowError="threadList.rowError"
                                  :busyRootId="threadList.busyRootId"
                                  :channelId="threadList.channelId ?? activeChannelId ?? ''"
                                  :kind="activeKind ?? 'channel'"
                                  :roomTitles="roomTitles"
                                  :roomKinds="roomKinds"
                                  :publicRooms="publicRooms"
                                  :isPhone="isPhone"
                                  :personAliasGuid="personAliasGuid"
                                  @open="openThreadFromList"
                                  @tab="onThreadsTab"
                                  @refresh="onThreadsRefresh"
                                  @follow="onFollowFromList"
                                  @loadMore="onThreadsLoadMore"
                                  @close="closePanel" />

                    <ThreadDrawer v-else-if="shownPanel === 'thread' && drawnThread"
                                  :key="drawnThread.rootId"
                                  :root="drawnThread.root"
                                  :replies="drawnThread.replies"
                                  :pending="shell.sender.pending(drawnThread.channelId)"
                                  :isFollowing="drawnThread.following"
                                  :conversationTitle="roomTitles[drawnThread.channelId] ?? ''"
                                  :isChannel="threadKind === 'channel'"
                                  :isDirectMessage="threadKind === 'person'"
                                  :isPhone="isPhone"
                                  :isFromList="isThreadFromList"
                                  :personAliasGuid="personAliasGuid"
                                  :hasMore="drawnThread.hasMore"
                                  :isLoading="drawnThread.isLoading"
                                  :error="drawnThread.error"
                                  :olderError="drawnThread.olderError"
                                  :isLocked="!shell.state.isComposerOpen"
                                  :personName="personName"
                                  :personPhotoUrl="personPhotoUrl"
                                  :organizationName="organizationName"
                                  @close="closeThreadDrawer"
                                  @back="onThreadBack"
                                  @follow="onFollowThread"
                                  @send="onSendReply"
                                  @seen="shell.threads.seen"
                                  @loadOlder="onLoadOlderReplies"
                                  @retry="onRetry"
                                  @discard="shell.sender.discard" />
                </div>
            </aside>
        </div>

        <DirectMessagePicker v-model="isPickerShown"
                             :chosen="shell.directMessages.chosen"
                             :search="shell.directMessages.search"
                             :error="shell.directMessages.error"
                             @choose="shell.directMessages.choose"
                             @unchoose="shell.directMessages.unchoose"
                             @open="onOpenDirectMessage" />

        <ErrorToast :errors="shell.state.errors" :notices="notices" @dismiss="shell.dismissError" @dismissNotice="onDismissNotice" />
    </div>
</template>

<style scoped>
/*
    Fills the Full Worksurface zone it is placed in, flush, with no card around it. The height is
    the one that layout gives its zone, the window less Rock's header, 36px and any context slicer,
    written out because Rock wraps a block in a container of its own that a percentage cannot
    reach through.
*/
.chat-shell {
    position: relative;
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--top-header-height, 80px) - 36px - var(--context-slicer-height, 0px));
}

.chat-frame {
    position: relative;
    display: grid;
    flex: 1;
    grid-template-rows: minmax(0, 1fr);
    grid-template-columns: 296px minmax(0, 1fr) 0px;
    min-height: 0;
    overflow: hidden;
    background: var(--chat-surface);
    transition: grid-template-columns var(--chat-t-panel) var(--chat-ease-in);
}

/* Clipped where the browser can, so a scroll into view never moves the frame itself sideways. */
@supports (overflow: clip) {
    .chat-frame {
        overflow: clip;
    }
}

.chat-frame-side {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    min-width: 0;
    min-height: 0;
}

.chat-frame-main {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--chat-surface);
}

.chat-frame[data-panel-open="true"] {
    grid-template-columns: 296px minmax(0, 1fr) 392px;
}

.chat-frame-panel {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--chat-surface);
}

/* Its dividing line only while open, so the closed column is 0px wide and not a 1px sliver. */
.chat-frame[data-panel-open="true"] .chat-frame-panel {
    border-left: 1px solid var(--chat-line);
}

/* The content keeps its full width while the column opens around it, fading in as it slides home. */
.chat-frame-panel-inner {
    width: 392px;
    height: 100%;
    opacity: 0;
    transform: translateX(var(--chat-drawer-shift));
    transition: opacity var(--chat-t-base) var(--chat-ease-state), transform var(--chat-t-panel) var(--chat-ease-in);
}

.chat-frame[data-panel-open="true"] .chat-frame-panel-inner {
    opacity: 1;
    transform: none;
}

/* A phone: one pane fills the frame and the other waits beside it, the list a little to the left. */
.chat-shell[data-phone="true"] .chat-frame {
    display: block;
}

.chat-shell[data-phone="true"] .chat-frame-side,
.chat-shell[data-phone="true"] .chat-frame-main,
.chat-shell[data-phone="true"] .chat-frame-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

/* Only a move the person made slides; the conversation a link opens is simply there. */
.chat-shell[data-phone="true"] .chat-frame.is-pane-motion-on .chat-frame-side,
.chat-shell[data-phone="true"] .chat-frame.is-pane-motion-on .chat-frame-main,
.chat-shell[data-phone="true"] .chat-frame.is-pane-motion-on .chat-frame-panel {
    transition: transform var(--chat-t-panel) var(--chat-ease-in), opacity var(--chat-t-base) var(--chat-ease-state);
}

/* The panel is a third pane over the conversation, waiting off to the right until it opens. */
.chat-shell[data-phone="true"] .chat-frame-panel {
    z-index: 8;
    border-left: 0;
    transform: translateX(100%);
}

.chat-shell[data-phone="true"] .chat-frame[data-pane="panel"] .chat-frame-panel {
    transform: none;
}

.chat-shell[data-phone="true"] .chat-frame-panel-inner {
    width: 100%;
}

.chat-shell[data-phone="true"] .chat-frame[data-pane="conversation"] .chat-frame-side,
.chat-shell[data-phone="true"] .chat-frame[data-pane="panel"] .chat-frame-side {
    pointer-events: none;
    opacity: 0;
    transform: translateX(-24%);
}

.chat-shell[data-phone="true"] .chat-frame[data-pane="list"] .chat-frame-main {
    pointer-events: none;
    transform: translateX(100%);
}

.chat-shell-empty {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    color: var(--chat-muted);
}

.chat-shell-draft {
    flex-direction: column;
    gap: 8px;
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, onMounted, ref, shallowRef, StyleValue, watch } from "vue";
    import { createClient } from "@Obsidian/Libs/supabase";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { ChatBirthdateResultBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatBirthdateResultBag";
    import { ChatChurchTokenBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatChurchTokenBag";
    import { ChatMembershipResultBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatMembershipResultBag";
    import { ChatShellInitializationBox } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatShellInitializationBox";
    import { ChatShellSessionBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatShellSessionBag";
    import { DatePartsPickerValueBag } from "@Obsidian/ViewModels/Controls/datePartsPickerValueBag";
    import { birthdateOutcome, isBirthdatePromptShown } from "./ChatShell/birthdate.partial";
    import BirthdatePrompt from "./ChatShell/components/birthdatePrompt.partial.obs";
    import ChannelSidebar from "./ChatShell/components/channelSidebar.partial.obs";
    import ChatHeader, { HeaderRoomKind } from "./ChatShell/components/chatHeader.partial.obs";
    import Composer from "./ChatShell/components/composer.partial.obs";
    import DirectMessagePicker from "./ChatShell/components/directMessagePicker.partial.obs";
    import { DirectMessageDraft, DoorResult, isTextKeptOnSend } from "./ChatShell/composables/useDirectMessage.partial";
    import ErrorToast, { ToastNotice } from "./ChatShell/components/errorToast.partial.obs";
    import MessageFeed from "./ChatShell/components/messageFeed.partial.obs";
    import ThreadDrawer from "./ChatShell/components/threadDrawer.partial.obs";
    import ThreadsPanel from "./ChatShell/components/threadsPanel.partial.obs";
    import { followNotice, OpenThreadState, ThreadListState, ThreadListTab } from "./ChatShell/composables/useThreads.partial";
    import { FeedLayout } from "./ChatShell/feedLayout.partial";
    import { createChatShell, PlatformClientLike, refusalMessage, ShellOptions } from "./ChatShell/shell.partial";
    import { isTwoPersonDirectMessage, joinNames, roomTitle } from "./ChatShell/stores/channelStore.partial";
    import { SidebarRow } from "./ChatShell/types.partial";
    import { applyChatTheme, tokenDuration } from "./ChatShell/ui/brand.partial";

    // #region Types

    /** What the panel column can hold: the threads list, or one thread in its drawer. */
    type PanelKind = "threads" | "thread";

    /** What the push worker posts to a window of the site, in the worker's own names. */
    /* eslint-disable-next-line @typescript-eslint/naming-convention */
    type WorkerMessage = { type?: string, channel_id?: string };

    // #endregion Types

    const config = useConfigurationValues<ChatShellInitializationBox>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const personAliasGuid = ref(config.session?.personAliasGuid ?? "");

    /** The reader's own name and photo, for their messages the platform has sent no name with yet. */
    const personName = ref(fullName(config.session));
    const personPhotoUrl = ref(config.session?.personPhotoUrl ?? null);

    const organizationName = config.organizationName ?? "";

    // Replaced, not reloaded, when a birthdate lets the person in: the save answers with the
    // session a fresh page load would have had.
    const shell = shallowRef(buildShell(config.session ?? {}));

    const birthdateMessage = ref<string | null>(null);
    const isSavingBirthdate = ref(false);

    const isPickerShown = ref(false);

    /** Toasts that are not failures, such as being back online after an outage. */
    const notices = ref<ToastNotice[]>([]);

    const rootElement = ref<HTMLElement>();

    /** Below this width the block shows one pane at a time, as on a phone. */
    const phoneWidth = 760;

    /** Whether the block itself is narrower than a phone's layout allows, wherever it sits in the window. */
    const isPhone = ref(false);

    /** Set by Back on a phone, so the list shows while the conversation stays open behind it. */
    const isListChosen = ref(false);

    /** Turned on by the person's first move between panes, so the pane a page load opens does not slide in. */
    const isPaneMotionOn = ref(false);

    // A pane that has slid out of view is also hidden, once its slide is over, because the oldest
    // Safari Rock supports ignores inert and would still let Tab walk into it.
    const isSidebarGone = ref(false);
    const isConversationGone = ref(false);
    const isPanelGone = ref(true);
    const goneStyle: StyleValue = { visibility: "hidden" };

    /** The design's pane slide, used when the sheet is not on the page. */
    const fallbackPaneSlideMs = 300;

    let paneGoneTimer: number | undefined;

    /** The panel open in the right-hand column, or null while it is closed. */
    const panelKind = ref<PanelKind | null>(null);

    /** What the column draws: the open panel, kept through its close so it narrows over its content. */
    const shownPanel = ref<PanelKind | null>(null);

    const panelElement = ref<HTMLElement>();

    let panelClearTimer: number | undefined;

    /**
     * The thread the drawer draws, kept after the threads let it go so the drawer narrows over its
     * content as it closes rather than over nothing.
     */
    const drawnThread = shallowRef<OpenThreadState | null>(null);

    /** Whether the open thread came from the threads list, so its back chevron and Escape return there. */
    const isThreadFromList = ref(false);

    /** The conversation the open thread belongs to, which the drawer stays open over. */
    let threadChannelId: string | null = null;

    // The block's own width, not the window's or a container query's, since the oldest Safari Rock
    // supports has no container queries and a narrow zone of a wide window is still narrow.
    let resizeObserver: ResizeObserver | null = null;

    /** The cookie Rock reads at sign-out to take this browser out of push. */
    const pushCookieName = "rock_chat_push";

    let firebaseAppInstance: unknown = null;

    // #endregion Values

    // #region Computed Values

    const activeChannelId = computed((): string | null => shell.value.state.activeChannelId);

    /** The unread mentions on the app icon, from the sidebar, so reading a mention clears it. */
    const mentionBadge = computed((): number => shell.value.mentionBadge());

    /** Whether the open channel's catch-up failed and is trying again, so messages may be missing. */
    const isActiveBehind = computed((): boolean => !!activeChannelId.value && shell.value.timelines.state(activeChannelId.value).isBehind);

    const isPromptShown = computed((): boolean => isBirthdatePromptShown(shell.value.state.phase, shell.value.state.gate));

    const isRefused = computed((): boolean => shell.value.state.phase === "refused" || shell.value.state.phase === "failed");

    const refusal = computed((): string => refusalMessage(shell.value.state.phase, shell.value.state.gate));

    const draft = computed((): DirectMessageDraft | null => shell.value.directMessages.draft);

    /** Text Rock refused earlier, for the box of the conversation the same people now share. */
    const held = computed((): { body: string } | null => shell.value.directMessages.held);

    /**
     * Closed while a draft's first message is on its way; with nothing open there is no composer at
     * all. Read only and maintenance lock the composer instead, which says why.
     */
    const isComposerDisabled = computed((): boolean => draft.value?.status === "starting");

    /** The sidebar row of the open conversation, which carries everything the header draws. */
    const activeRow = computed((): SidebarRow | null => shell.value.channels.rows.find(r => r.channel_id === shell.value.state.activeChannelId) ?? null);

    /** A conversation with one other person, where a name over each bubble would only repeat the header. */
    const isActiveDirectMessage = computed((): boolean => !!activeRow.value && isTwoPersonDirectMessage(activeRow.value));

    /** The other people of the open direct message or draft, by the names the sidebar shows. */
    const activePeople = computed((): string[] => {
        if (draft.value) {
            return draft.value.people.map(p => `${p.nick_name} ${p.last_name}`);
        }

        return activeRow.value?.dm_names ?? [];
    });

    const activeKind = computed((): HeaderRoomKind | null => {
        if (draft.value) {
            return draft.value.people.length > 1 ? "group" : "person";
        }

        if (!activeRow.value) {
            return null;
        }

        if (activeRow.value.channel_type !== "dm") {
            return "channel";
        }

        return isActiveDirectMessage.value ? "person" : "group";
    });

    const activeTitle = computed((): string => {
        if (activeRow.value?.name) {
            return activeRow.value.name;
        }

        // A group the platform names only its first few people for says how many more there are.
        const others = draft.value ? draft.value.people.length : (activeRow.value?.dm_other_count ?? activePeople.value.length);
        return joinNames(activePeople.value, others - activePeople.value.length);
    });

    /**
     * The look the open conversation is drawn in, by its kind alone: a channel in Community's flat
     * rows, a direct message or a New message draft in Conversational's bubbles.
     */
    const look = computed((): FeedLayout | null => {
        if (!activeKind.value) {
            return null;
        }

        return activeKind.value === "channel" ? "community" : "conversational";
    });

    /** A group's head count, the one subtitle the wire carries; a channel's description and a person's campus are not on it yet. */
    const activeSubtitle = computed((): string | null => {
        if (activeKind.value !== "group") {
            return null;
        }

        // The platform counts a room's people only when it has no name, so a named group arrives
        // with 0 and has no count to show until the member count gets a field of its own.
        const others = draft.value ? draft.value.people.length : (activeRow.value?.dm_other_count ?? activePeople.value.length);
        if (others < 1) {
            return null;
        }

        // A group always holds the reader and at least one other, so the count is never singular.
        return `${others + 1} people`;
    });

    /**
     * Which pane a phone shows: the conversation once one is open, until Back asks for the list,
     * and an open panel over it.
     */
    const pane = computed((): "list" | "conversation" | "panel" => {
        if (!(activeChannelId.value || draft.value) || isListChosen.value) {
            return "list";
        }

        return panelKind.value ? "panel" : "conversation";
    });

    /** The threads list the panel draws, as the shell's threads hold it. */
    const threadList = computed((): ThreadListState => shell.value.threads.state.list);

    /** Each conversation's title by channel id, as the header writes it, for the rooms the threads list names. */
    const roomTitles = computed((): Record<string, string> => {
        const titles: Record<string, string> = {};
        for (const row of shell.value.channels.rows) {
            titles[row.channel_id] = roomTitle(row);
        }

        return titles;
    });

    /** Each conversation's kind by channel id, which picks the room's icon on the All tab. */
    const roomKinds = computed((): Record<string, HeaderRoomKind> => {
        const kinds: Record<string, HeaderRoomKind> = {};
        for (const row of shell.value.channels.rows) {
            kinds[row.channel_id] = row.channel_type !== "dm" ? "channel" : isTwoPersonDirectMessage(row) ? "person" : "group";
        }

        return kinds;
    });

    /** Whether each channel is public, which draws its hash rather than its lock on the All tab. */
    const publicRooms = computed((): Record<string, boolean> => {
        const isPublic: Record<string, boolean> = {};
        for (const row of shell.value.channels.rows) {
            isPublic[row.channel_id] = row.is_public;
        }

        return isPublic;
    });

    /** The open thread's conversation kind, which picks its look and its composer's foot. */
    const threadKind = computed((): HeaderRoomKind | null => drawnThread.value ? roomKinds.value[drawnThread.value.channelId] ?? null : null);

    const isSidebarHidden = computed((): boolean => isPhone.value && pane.value !== "list");

    const isConversationHidden = computed((): boolean => isPhone.value && pane.value !== "conversation");

    /** A closed panel is out of reach everywhere; an open one only while a phone shows another pane. */
    const isPanelHidden = computed((): boolean => !panelKind.value || (isPhone.value && pane.value !== "panel"));

    // #endregion Computed Values

    // #region Event Handlers

    async function onSelect(channelId: string): Promise<void> {
        // Choosing the conversation already open behind the list brings it back too.
        isListChosen.value = false;
        isPaneMotionOn.value = true;
        void shell.value.selectChannel(channelId);

        // The row that had focus has slid out of view and out of reach, so focus goes to what
        // slid in: the conversation's title, never its composer, which would raise the keyboard.
        if (isPhone.value) {
            await nextTick();
            rootElement.value?.querySelector<HTMLElement>("[data-testid='header-title']")?.focus();
        }
    }

    async function onBack(): Promise<void> {
        const leftChannelId = activeChannelId.value;
        isListChosen.value = true;
        isPaneMotionOn.value = true;

        // Back on a phone hides the button that had focus, so focus returns to the row of the
        // conversation just left, where the person was in the list. A New message draft has no
        // row yet, so focus goes to the New message button that opened it.
        if (isPhone.value) {
            await nextTick();
            const row = leftChannelId
                ? rootElement.value?.querySelector<HTMLElement>(`[data-testid='channel-row'][data-channel-id='${leftChannelId}']`)
                : null;
            (row ?? rootElement.value?.querySelector<HTMLElement>("[data-testid='new-message']"))?.focus();
        }
    }

    function onResize(entries: ResizeObserverEntry[]): void {
        const width = entries[entries.length - 1]?.contentRect.width;
        if (width !== undefined) {
            isPhone.value = width < phoneWidth;
        }
    }

    /** The picker closes once a conversation or a draft is open, and stays to show a failure. */
    async function onOpenDirectMessage(): Promise<void> {
        isPaneMotionOn.value = true;
        await shell.value.openDirectMessage();
        if (!shell.value.directMessages.error) {
            isPickerShown.value = false;
        }
    }

    /** Says the outage is over, once, however many times the connection came and went. */
    function onBackOnline(): void {
        if (!notices.value.some(n => n.code === "back-online")) {
            notices.value.push({ code: "back-online", text: "You're back online", icon: "check" });
        }
    }

    function onDismissNotice(notice: ToastNotice): void {
        notices.value = notices.value.filter(n => n.code !== notice.code);
    }

    /** The header's Threads opens the open conversation's threads, or closes them when they are open. */
    async function onThreads(): Promise<void> {
        if (panelKind.value === "threads") {
            closePanel();
            return;
        }

        if (!activeChannelId.value) {
            return;
        }

        // The column holds one panel at a time, so the list takes an open thread's place.
        leaveThread();
        window.clearTimeout(panelClearTimer);
        isPaneMotionOn.value = true;
        panelKind.value = "threads";
        shownPanel.value = "threads";
        void shell.value.threads.openList(activeChannelId.value);

        // Focus goes to the panel's first control, or its X or back chevron when it has none yet.
        await nextTick();
        const panel = panelElement.value;
        (panel?.querySelector<HTMLElement>("[data-autofocus]")
            ?? panel?.querySelector<HTMLElement>("[data-testid='panel-close'], [data-testid='panel-back']"))?.focus();
    }

    function onThreadsTab(tab: ThreadListTab): void {
        // A thread opened from the All tab may have moved the conversation, so the list's own
        // tab is opened for the conversation open now.
        if (tab === "channel" && activeChannelId.value && threadList.value.channelId !== activeChannelId.value) {
            void shell.value.threads.openList(activeChannelId.value, tab);
            return;
        }

        void shell.value.threads.switchTab(tab);
    }

    function onThreadsRefresh(): void {
        void shell.value.threads.refresh();
    }

    function onThreadsLoadMore(): void {
        void shell.value.threads.loadMore();
    }

    /** A follow change from a row; the toast says what changed once the platform took it, and a refusal stays on the row. */
    async function onFollowFromList(rootId: number, isFollowing: boolean): Promise<void> {
        if (!await shell.value.threads.follow(rootId, isFollowing)) {
            return;
        }

        // one follow toast at a time: a quick follow then unfollow shows only where it ended
        const notice = followNotice(isFollowing);
        notices.value = [...notices.value.filter(n => n.code !== "thread-followed" && n.code !== "thread-unfollowed"), notice];
    }

    /**
     * A row of the threads list chose its thread: its conversation opens behind the drawer, as a
     * sidebar row would open it, and the thread opens in the panel column in the list's place,
     * with a back chevron that returns to the list and the row that opened it.
     */
    function openThreadFromList(rootId: number, channelId: string): void {
        if (channelId !== activeChannelId.value) {
            void shell.value.selectChannel(channelId);
        }
        void openThreadDrawer(channelId, rootId, true);
    }

    /** A thread pill, or the "Replied to a thread" label over a reply, in the open conversation. */
    function onOpenThread(rootId: number): void {
        if (activeChannelId.value) {
            void openThreadDrawer(activeChannelId.value, rootId, false);
        }
    }

    /** Back to the threads list the thread was opened from, with focus on the row that opened it. */
    async function onThreadBack(): Promise<void> {
        const rootId = drawnThread.value?.rootId;
        leaveThread();
        panelKind.value = "threads";
        shownPanel.value = "threads";

        await nextTick();
        panelElement.value?.querySelector<HTMLElement>(`[data-testid='thread-row-open'][data-root-id='${rootId}']`)?.focus();
    }

    /** The drawer's toggle: the toast says what changed once the platform took it, as the list's does. */
    function onFollowThread(isFollowing: boolean): void {
        if (drawnThread.value) {
            void onFollowFromList(drawnThread.value.rootId, isFollowing);
        }
    }

    function onSendReply(body: string, isShownInChannel: boolean): void {
        if (drawnThread.value) {
            void shell.value.sendReply(drawnThread.value.rootId, body, isShownInChannel);
        }
    }

    function onLoadOlderReplies(): void {
        void shell.value.threads.loadOlderReplies();
    }

    function onTurnOnPush(): void {
        void shell.value.turnOnPush();
    }

    /**
     * The push worker asks whether a push's channel is on screen, so it can leave the banner out,
     * and after a tap tells this window which channel to open.
     */
    function onWorkerMessage(event: MessageEvent): void {
        const message = (event.data ?? {}) as WorkerMessage;

        if (message.type === "chat.push.is-open") {
            event.ports[0]?.postMessage({ open: !!message.channel_id && shell.value.isChannelOnScreen(message.channel_id) });
        }
        else if (message.type === "chat.push.open" && message.channel_id) {
            void shell.value.selectChannel(message.channel_id.toLowerCase());
        }
    }

    function onRetry(localId: string): void {
        void shell.value.sender.retry(localId);
    }

    async function onSaveBirthdate(birthDate: DatePartsPickerValueBag): Promise<void> {
        isSavingBirthdate.value = true;
        const result = await invokeBlockAction<ChatBirthdateResultBag>("SaveBirthdate", { birthDate });
        isSavingBirthdate.value = false;

        const outcome = birthdateOutcome({ isSuccess: result.isSuccess, statusCode: result.statusCode, data: result.data });

        if (outcome.kind === "retry") {
            birthdateMessage.value = outcome.message;
            return;
        }

        birthdateMessage.value = null;

        if (outcome.kind === "refused") {
            shell.value.state.gate = outcome.gate;
            return;
        }

        await shell.value.stop();
        personAliasGuid.value = outcome.session.personAliasGuid ?? "";
        personName.value = fullName(outcome.session);
        personPhotoUrl.value = outcome.session.personPhotoUrl ?? null;
        shell.value = buildShell(outcome.session);
        void shell.value.start();
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Closes the panel column. Focus returns to the header button that opened it, or on a phone
     * to the overflow button it was chosen from, else the conversation's title.
     */
    function closePanel(): void {
        if (!panelKind.value) {
            return;
        }

        const closed = panelKind.value;
        panelKind.value = null;
        if (closed === "threads") {
            shell.value.threads.closeList();
        }

        finishClosing();

        void nextTick(() => {
            const root = rootElement.value;
            (root?.querySelector<HTMLElement>(`[data-testid='header-${closed}']`)
                ?? root?.querySelector<HTMLElement>("[data-testid='header-more'] button")
                ?? root?.querySelector<HTMLElement>("[data-testid='header-title']"))?.focus();
        });
    }

    /**
     * Opens a thread in the drawer. One opened from the conversation replaces whatever the column
     * held; one opened from the list keeps the list to go back to.
     */
    async function openThreadDrawer(channelId: string, rootId: number, isFromList: boolean): Promise<void> {
        if (panelKind.value === "threads" && !isFromList) {
            shell.value.threads.closeList();
        }

        window.clearTimeout(panelClearTimer);
        isPaneMotionOn.value = true;
        isThreadFromList.value = isFromList;
        threadChannelId = channelId;
        panelKind.value = "thread";
        shownPanel.value = "thread";
        await shell.value.threads.openThread(channelId, rootId);
    }

    /** Lets go of the open thread, which saves where the reader got to, without moving focus. */
    function leaveThread(): void {
        if (panelKind.value === "thread") {
            panelKind.value = null;
            void shell.value.threads.closeThread();
        }
    }

    /**
     * Closes the drawer. Focus returns to the thread pill that opened it, else the root message,
     * else the conversation's title.
     */
    function closeThreadDrawer(): void {
        const rootId = drawnThread.value?.rootId;
        const wasFromList = isThreadFromList.value;
        leaveThread();
        if (wasFromList) {
            shell.value.threads.closeList();
        }
        finishClosing();

        void nextTick(() => {
            const root = rootElement.value;
            const message = root?.querySelector<HTMLElement>(`[data-testid='frame-main'] [data-message-id='${rootId}']`);
            (message?.querySelector<HTMLElement>("[data-testid='thread-summary']")
                ?? message
                ?? root?.querySelector<HTMLElement>("[data-testid='header-title']"))?.focus();
        });
    }

    /** Keeps what the column drew until it has finished narrowing, then lets it go. */
    function finishClosing(): void {
        window.clearTimeout(panelClearTimer);
        panelClearTimer = window.setTimeout(() => {
            shownPanel.value = panelKind.value ? shownPanel.value : null;
        }, panelSlideMs());
    }

    /** Builds the shell for a session, as the page load described it or a birthdate save did. */
    function buildShell(session: ShellOptions["session"]): ReturnType<typeof createChatShell> {
        return createChatShell({
            session,
            linkedChannelId: config.channelGuid ?? null,
            areSharedChannelsFilteredByCampus: config.areSharedChannelsFilteredByCampus ?? false,
            mintChurchToken: async () => {
                const result = await invokeBlockAction<ChatChurchTokenBag>("MintChurchToken");
                return { isSuccess: result.isSuccess, statusCode: result.statusCode, data: result.data };
            },
            startDirectMessage: async personAliasGuids => {
                const result = await invokeBlockAction<DoorResult>("StartDirectMessage", { personAliasGuids });
                if (result.isSuccess && result.data) {
                    return result.data;
                }

                // Rock did not answer with a door result at all, so there is no sentence of its
                // own to show and the draft stays for the person to try again.
                return {
                    code: "door.unavailable",
                    channelGuid: null,
                    isPending: false,
                    message: result.errorMessage ?? "The conversation could not be started. Try again.",
                    personAliasGuid: null
                };
            },
            joinChannel: async channelId => {
                const result = await invokeBlockAction<ChatMembershipResultBag>("JoinChannel", { channelGuid: channelId });
                if (result.isSuccess && result.data) {
                    return result.data;
                }

                // Rock did not answer with a door result, so the message fails and can be sent again.
                return { code: "door.unavailable", message: result.errorMessage ?? null, isPending: false };
            },
            createPlatformClient: (url, key, accessToken, realtime) => createClient(url, key, { accessToken, realtime }) as unknown as PlatformClientLike,
            fetch: (url, init) => window.fetch(url, init),
            storage: safeLocalStorage(),
            pageTargets: { document, window },
            push: browserPush(),
            mark: name => {
                try {
                    performance.mark(name);
                }
                catch {
                    // Intentionally ignored: timing marks are for measurement only.
                }
            }
        });
    }

    /** This browser's web push, or undefined where it has none. */
    function browserPush(): ShellOptions["push"] {
        if (!("serviceWorker" in navigator) || !("Notification" in window) || !("PushManager" in window)) {
            return undefined;
        }

        return {
            pagePath: window.location.pathname,
            permission: () => Notification.permission,
            requestPermission: () => Notification.requestPermission(),
            // Its own folder as its scope, so it never takes the site root from a worker a
            // church's theme registers there.
            registerWorker: pagePath => navigator.serviceWorker.register(
                `/Scripts/Rock/Chat/chatPushWorker.js?page=${encodeURIComponent(pagePath)}`,
                { scope: "/Scripts/Rock/Chat/" }),
            getToken: async (web, vapidKey, registration) => {
                const firebase = await import("@Obsidian/Libs/firebase");
                return firebase.getToken(firebase.getMessaging(firebaseApp(firebase, web)), {
                    vapidKey,
                    serviceWorkerRegistration: registration as ServiceWorkerRegistration
                });
            },
            writeCookie: token => {
                const secure = window.location.protocol === "https:" ? "; Secure" : "";
                // a year, a choice: the block writes it again on every load while push is on
                document.cookie = token
                    ? `${pushCookieName}=${encodeURIComponent(token)}; path=/; max-age=31536000; SameSite=Lax${secure}`
                    : `${pushCookieName}=; path=/; max-age=0; SameSite=Lax${secure}`;
            }
        };
    }

    /** The block's one Firebase app, made on the first token and reused for every later one. */
    function firebaseApp(firebase: typeof import("@Obsidian/Libs/firebase"), web: Record<string, unknown>): ReturnType<typeof firebase.initializeApp> {
        firebaseAppInstance ??= firebase.initializeApp(web, "rock-chat");
        return firebaseAppInstance as ReturnType<typeof firebase.initializeApp>;
    }

    /** The person's name as the chat shows it, from the session Rock opened. */
    function fullName(session: ChatShellSessionBag | null | undefined): string {
        return [session?.personNickName, session?.personLastName].filter(part => !!part).join(" ");
    }

    /** How long a pane slides: none for a move the person did not make, or when they ask for reduced motion. */
    function paneSlideMs(): number {
        const isReduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
        if (!isPaneMotionOn.value || isReduced || !rootElement.value) {
            return 0;
        }

        return tokenDuration(rootElement.value, "--chat-t-panel", fallbackPaneSlideMs);
    }

    /** How long the panel column takes to close, which its content stays drawn through. */
    function panelSlideMs(): number {
        const isReduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
        if (isReduced || !rootElement.value) {
            return 0;
        }

        return tokenDuration(rootElement.value, "--chat-t-panel", fallbackPaneSlideMs);
    }

    /** The browser's local storage, or null where the browser blocks it. */
    function safeLocalStorage(): Storage | null {
        try {
            return window.localStorage;
        }
        catch {
            return null;
        }
    }

    // #endregion Functions

    // #region Watchers

    // From the first sidebar the page loads, a count of none included, so a badge a mention push
    // left behind is cleared once the person has read it.
    watch([mentionBadge, (): string => shell.value.state.phase], ([count, phase]) => {
        if (phase !== "ready") {
            return;
        }

        // Only where the site is installed as an app does the browser draw it; elsewhere a no-op.
        const badging = navigator as Navigator & { setAppBadge?: (count?: number) => Promise<void>, clearAppBadge?: () => Promise<void> };
        const done = count > 0 ? badging.setAppBadge?.(count) : badging.clearAppBadge?.();
        void done?.catch(() => undefined);
    });

    // A pane coming into view is reachable at once; one leaving is hidden after it has slid away.
    watch([isSidebarHidden, isConversationHidden, isPanelHidden], () => {
        window.clearTimeout(paneGoneTimer);
        isSidebarGone.value &&= isSidebarHidden.value;
        isConversationGone.value &&= isConversationHidden.value;
        isPanelGone.value &&= isPanelHidden.value;

        const finish = (): void => {
            isSidebarGone.value = isSidebarHidden.value;
            isConversationGone.value = isConversationHidden.value;
            isPanelGone.value = isPanelHidden.value;
        };

        const slideMs = paneSlideMs();
        if (slideMs === 0) {
            finish();
        }
        else {
            paneGoneTimer = window.setTimeout(finish, slideMs);
        }
    });

    // Any conversation that opens, from a row, a push or a new message, comes forward on a phone.
    watch([activeChannelId, draft], () => {
        isListChosen.value = false;
    });

    // The drawer keeps the thread it last drew, so a closing drawer still has its content.
    watch(() => shell.value.threads.state.thread, thread => {
        if (thread) {
            drawnThread.value = thread;
        }
    });

    // A thread belongs to its own conversation, so another conversation or a draft closes it. A
    // thread opened from the list switches to its conversation first, which keeps it open.
    watch([activeChannelId, draft], ([channelId, openDraft]) => {
        if (panelKind.value === "thread" && (openDraft || channelId !== threadChannelId)) {
            leaveThread();
            finishClosing();
        }
    });

    // The threads list follows the open conversation; a draft has no threads, so it closes.
    watch(activeChannelId, channelId => {
        if (panelKind.value !== "threads") {
            return;
        }

        if (channelId) {
            void shell.value.threads.openList(channelId);
        }
        else {
            closePanel();
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(() => {
        // Once per load: the church color and whether the page's Rock theme can follow the system into dark.
        if (rootElement.value) {
            applyChatTheme(rootElement.value);

            if (typeof ResizeObserver !== "undefined") {
                resizeObserver = new ResizeObserver(onResize);
                resizeObserver.observe(rootElement.value);
            }
        }

        navigator.serviceWorker?.addEventListener("message", onWorkerMessage);
        void shell.value.start();
    });

    onBeforeUnmount(() => {
        resizeObserver?.disconnect();
        window.clearTimeout(paneGoneTimer);
        window.clearTimeout(panelClearTimer);
        navigator.serviceWorker?.removeEventListener("message", onWorkerMessage);
        void shell.value.stop();
    });

    // #endregion Lifecycle Hooks
</script>
