<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div ref="rootElement"
         class="chat-shell"
         data-testid="chat-shell"
         :data-phase="shell.state.phase"
         :data-phone="isPhone ? 'true' : 'false'">
        <!--
            The page's one announcement of its start, mounted empty so each change is heard: outside
            the frame, so it outlives the frame's swap for a refusal's notice, and outside every veil,
            inert and busy part of the page, which a screen reader would not read or would hold back.
        -->
        <span class="chat-sr-only" role="status" aria-live="polite" data-testid="start-status">{{ startAnnouncement }}</span>

        <BirthdatePrompt v-if="isPromptShown"
                         :message="birthdateMessage"
                         :isSaving="isSavingBirthdate"
                         @save="onSaveBirthdate" />

        <NotificationBox v-else-if="isRefused" :alertType="AlertType.Warning">
            {{ refusal }}
        </NotificationBox>

        <div v-else
             :key="shellBuild"
             class="chat-frame"
             :class="{ 'is-pane-motion-on': isPaneMotionOn }"
             data-testid="chat-frame"
             :data-pane="pane"
             :data-panel-open="panelKind ? 'true' : 'false'"
             :data-sidebar="sidebarFold ?? undefined"
             @focusin="onFrameFocusIn"
             @focusout="onFrameFocusOut">
            <div ref="sidebarElement"
                 class="chat-frame-side"
                 data-testid="frame-sidebar"
                 :aria-hidden="isSidebarHidden ? 'true' : undefined"
                 :inert="isSidebarHidden || undefined"
                 :style="isSidebarGone ? goneStyle : undefined">
                <ChannelSidebar :rows="shell.channels.listed"
                                :activeChannelId="shell.state.activeChannelId"
                                :isNewMessageShown="shell.isNewMessageShown"
                                :isNewMessageInert="shell.state.phase === 'starting'"
                                :loadState="shell.channels.loadState"
                                :isBrowseOpen="mainView === 'directory'"
                                :isNewMessageOpen="mainView === 'newdm'"
                                :isVeiled="!shell.reveal.state.isSidebarRevealed"
                                :personCampusName="personCampusName"
                                :isStatusShown="shell.state.isStatusShown"
                                :statusChoice="statusChoice"
                                :statusClosedReason="statusClosedReason"
                                :isStatusRetrying="isStatusRetrying"
                                :isActivityOffered="shell.state.phase === 'ready'"
                                :isActivityOpen="panelKind === 'activity'"
                                :hasMentionDot="shell.mentions.state.hasDot"
                                :isOver="sidebarFold === 'over'"
                                @activity="onListPanel('activity')"
                                @hide="onSidebarAway"
                                @select="onSelect"
                                @status="onStatusChoice"
                                @newMessage="openMainView('newdm')"
                                @browse="openMainView('directory')"
                                @settings="isSettingsOpen = true"
                                @retry="shell.channels.retryLoad">
                    <template #veil>
                        <PageVeil region="sidebar"
                                  :isRevealed="shell.reveal.state.isSidebarRevealed"
                                  :isMarksShown="shell.reveal.state.isSkeletonShown"
                                  :kind="shell.reveal.state.kind"
                                  :statusLine="isPhone ? startStatus : null" />
                    </template>
                </ChannelSidebar>
            </div>

            <section ref="mainElement"
                     class="chat-frame-main"
                     data-testid="frame-main"
                     aria-label="Conversation"
                     :data-look="look ?? undefined"
                     :aria-hidden="isMainInert ? 'true' : undefined"
                     :inert="isMainInert || undefined"
                     :aria-busy="shell.reveal.state.isMainRevealed ? undefined : 'true'"
                     :style="isConversationGone ? goneStyle : undefined">
                <!-- The first load's veil: the column's frame from mount, until the first screen is ready. -->
                <PageVeil region="main"
                          :isRevealed="shell.reveal.state.isMainRevealed"
                          :isMarksShown="shell.reveal.state.isSkeletonShown"
                          :kind="shell.reveal.state.kind"
                          :statusLine="isPhone ? null : startStatus" />
                <!--
                    The conversation stays laid out under a full view, so its place in the feed
                    survives, and is out of reach until the view closes. Drawn as no box of its own,
                    so the column lays its parts out as before.
                -->
                <div class="chat-frame-under"
                     :class="{ 'is-revealing': isRevealing }"
                     data-testid="frame-conversation"
                     @animationend="onRevealAnimationEnd"
                     @animationcancel="onRevealAnimationEnd"
                     @dragover="onConversationDragOver"
                     @drop="onConversationDrop"
                     :aria-hidden="mainView ? 'true' : undefined"
                     :inert="!!mainView || !shell.reveal.state.isMainRevealed || undefined">
                    <ChatHeader :title="activeTitle"
                                :subtitle="activeSubtitle"
                                :facts="activeFacts"
                                :kind="activeKind"
                                :isPublic="activeRow?.is_public ?? false"
                                :iconUrl="activeRow?.icon_url ?? activeFacts?.icon_url ?? null"
                                :people="activePeople"
                                :otherCount="activeRow?.dm_other_count ?? null"
                                :connection="shell.state.connection"
                                :banner="shell.state.banner"
                                :isUpdateRequired="shell.state.isUpdateRequired"
                                :isBehind="isActiveBehind"
                                :isPushOffered="shell.state.isPushOffered"
                                :isPrefsOffered="!!activeRow?.is_member"
                                :notifyMode="activeRow?.notify_mode ?? null"
                                :isStarred="!!activeRow?.is_favorite"
                                :isEmpty="!activeChannelId"
                                :isThreadsOffered="!!activeChannelId"
                                :isMembersOffered="isMembersOffered"
                                :isMembersOpen="panelKind === 'members'"
                                :isThreadsOpen="panelKind === 'threads'"
                                :isSidebarFolded="sidebarFold === 'folded'"
                                @threads="onListPanel('threads')"
                                @members="onListPanel('members')"
                                @sidebar="onSidebarOver"
                                @membersIntent="activeChannelId && shell.members.readAhead(activeChannelId)"
                                @turnOnPush="onTurnOnPush"
                                @notify="onRoomChoice({ kind: 'notify', mode: $event })"
                                @star="onRoomChoice({ kind: 'star' })"
                                @back="onBack"
                                @backOnline="onBackOnline"
                                @details="isDetailsOpen = true" />

                    <MessageFeed v-if="activeChannelId"
                                 :key="activeChannelId"
                                 :timeline="shell.timelines.state(activeChannelId)"
                                 :pending="shell.sender.pending(activeChannelId)"
                                 :isPersonLeader="activeRow?.is_leader ?? false"
                                 :readCursor="activeRow?.read_cursor ?? null"
                                 :isChannel="activeKind === 'channel'"
                                 :isDirectMessage="isActiveDirectMessage"
                                 :isEntering="isFeedEntering"
                                 :isCovered="!!mainView"
                                 :isPreviewing="!!activeRow && !activeRow.is_member"
                                 :isJoinRefused="shell.rooms.joinOf(activeChannelId).kind === 'refused'"
                                 :facts="activeKind === 'channel' ? activeFacts : null"
                                 :campuses="campuses"
                                 :notifyMode="activeRow?.notify_mode ?? null"
                                 :editingId="editingIdIn(activeChannelId)"
                                 :editError="editErrorIn(activeChannelId)"
                                 :isEditSaving="isEditSavingIn(activeChannelId)"
                                 :landOnId="landingMessageId"
                                 :reactionHost="reactionHost"
                                 :typing="conversationTyping"
                                 :typingPlace="conversationQuoteKey"
                                 :loadOlder="shell.loadOlder"
                                 @seen="shell.seen"
                                 @markRead="shell.markRead"
                                 @firstShown="shell.firstMessageShown"
                                 @openThread="onOpenThread"
                                 @jump="onJump($event, false)"
                                 @messageAction="onMessageAction($event, null)"
                                 @retry="onRetry"
                                 @discard="shell.sender.discard" />
                    <!-- With the first sidebar failed there is nothing to choose; the sidebar says why. -->
                    <div v-else class="chat-shell-empty" data-testid="main-empty" :aria-busy="shell.state.isOpening ? 'true' : undefined">
                        {{ shell.state.isOpening || shell.channels.loadState === "failed" ? "" : "Choose a conversation." }}
                    </div>

                    <!--
                        The notices' place: a line of no height on the composer's top edge, which
                        they stand 14px above, so nothing covers the conversation's first lines.
                    -->
                    <div v-if="!isPhone && !mainView" class="chat-notice-place">
                        <ErrorToast :errors="shell.state.errors" :notices="notices" @dismiss="shell.dismissError" @dismissNotice="onDismissNotice" />
                    </div>

                    <!-- A channel the person is previewing has the join bar in the composer's place. -->
                    <JoinBar v-if="isJoinBarShown && activeChannelId"
                             ref="joinBar"
                             :name="activeTitle"
                             :state="shell.rooms.joinOf(activeChannelId)"
                             @join="onJoin"
                             @browse="openMainView('directory')" />

                    <Composer v-else-if="activeChannelId"
                              :class="{ 'is-entering': isComposerEntering }"
                              :title="activeKind ? activeTitle : null"
                              :isChannel="activeKind === 'channel'"
                              :isLocked="!shell.state.isComposerOpen"
                              :lockedReason="lockedReason(activeRow, shell.state.service)"
                              :maxLength="activeRow?.max_length ?? 0"
                              :text="conversationDraft?.text ?? ''"
                              :mentions="conversationDraft?.mentions ?? []"
                              :quote="conversationQuote"
                              :isQuoteOwn="isOwnQuote(conversationQuote)"
                              :emojiSource="emojiSource"
                              :mentionSource="mentionSourceFor(activeRow)"
                              :conversationKey="activeChannelId"
                              :sendFailure="conversationFailure"
                              :lastFailure="shell.sender.lastFailure()"
                              :tray="conversationTray"
                              :busyPerson="activePair"
                              @retryFailed="onRetryFailed(conversationSends)"
                              @discardFailed="onDiscardFailed(conversationSends)"
                              @mentionQuery="onMentionQuery(activeRow, $event)"
                              @focus="onComposerFocus(activeRow, 'conversation')"
                              @blur="onComposerBlur"
                              @send="shell.send"
                              @update:text="onDraftText(conversationQuoteKey, $event)"
                              @mention="onDraftMention(conversationQuoteKey, $event)"
                              @editLast="onEditLast"
                              @cancelQuote="onCancelQuote(conversationQuoteKey)"
                              @emojiPickerOpen="onEmojiPickerOpen"
                              @emojiChosen="onEmojiChosen"
                              @overLimit="onOverLimit"
                              @animationend="onComposerAnimationEnd" />
                </div>

                <!-- A full view in the conversation's place, rising in as a conversation switch does. -->
                <div v-if="mainView" ref="mainViewElement" class="chat-main-view" data-testid="main-view" :data-kind="mainView">
                    <ChannelDirectory v-if="mainView === 'directory'"
                                      :directory="shell.rooms.state.directory"
                                      :joins="shell.rooms.state.joins"
                                      :campuses="campuses"
                                      :personCampusGuid="personCampusGuid"
                                      @back="onBack"
                                      @close="closeMainView"
                                      @query="shell.rooms.setQuery"
                                      @clearQuery="shell.rooms.clearQuery"
                                      @campus="shell.rooms.setCampus"
                                      @show="shell.rooms.setShow"
                                      @clearFilters="shell.rooms.clearFilters"
                                      @loadMore="shell.rooms.loadMore"
                                      @retry="shell.rooms.retry"
                                      @join="shell.rooms.join"
                                      @open="openFromMainView" />

                    <!-- Its first message is drawn as a direct message is, whatever the conversation under it. -->
                    <NewMessage v-else-if="mainView === 'newdm'"
                                data-look="conversational"
                                :maxOthers="shell.state.limits.dm_max_others"
                                :chosen="shell.directMessages.chosen"
                                :search="shell.directMessages.search"
                                :lookup="shell.directMessages.lookup"
                                :foundTitle="foundTitle"
                                :recent="shell.directMessages.recent"
                                :campuses="campuses"
                                :draft="draft"
                                :error="shell.directMessages.error"
                                :refused="shell.directMessages.refused"
                                :isServiceLocked="!shell.state.isComposerOpen"
                                :lockedReason="lockedReason(null, shell.state.service)"
                                :emojiSource="emojiSource"
                                @back="onBack"
                                @close="closeMainView"
                                @choose="shell.directMessages.choose"
                                @unchoose="shell.directMessages.unchoose"
                                @open="openFromMainView"
                                @send="onSendFirst"
                                @edit="shell.directMessages.edit"
                                @retry="onSendFirst(draft?.body ?? '')"
                                @discard="shell.directMessages.discardFailed"
                                @emojiPickerOpen="onEmojiPickerOpen"
                                @emojiChosen="onEmojiChosen">
                        <!-- The conversation found, drawn as its own feed draws it, with nothing to act on. -->
                        <template #history>
                            <MessageFeed v-if="foundTimeline"
                                         :key="shell.directMessages.lookup.channelId ?? ''"
                                         :timeline="foundTimeline"
                                         :readCursor="foundRow?.read_cursor ?? null"
                                         :pending="[]"
                                         :isDirectMessage="foundRow ? foundRow.room_kind === 'person' : shell.directMessages.chosen.length === 1"
                                         isPreviewing />
                        </template>
                    </NewMessage>
                </div>

                <!-- Over a full view, which has no composer, at the column's foot; centred on the column, so a panel open beside it never pulls a notice off it. -->
                <ErrorToast v-if="!isPhone && mainView" :errors="shell.state.errors" :notices="notices" @dismiss="shell.dismissError" @dismissNotice="onDismissNotice" />
            </section>

            <!-- Under the sidebar laid over the conversation, the shade that puts it away, as a sheet's does. -->
            <Scrim :isShown="sidebarFold === 'over'" @dismiss="onSidebarAway" />

            <!--
                The panel column, closed until a thread or a list opens in it. It holds one panel
                at a time, each drawn in the shared panel host; what it held stays while it closes,
                so the column narrows over its content rather than over nothing.
            -->
            <aside ref="panelElement"
                   class="chat-frame-panel"
                   data-testid="frame-panel"
                   :aria-hidden="isPanelInert ? 'true' : undefined"
                   :inert="isPanelInert || undefined"
                   :style="isPanelGone ? goneStyle : undefined">
                <div class="chat-frame-panel-inner">
                    <!--
                        Activity's tabs, Mentions and Threads across conversations, are the column's:
                        one Segmented over the place each of its lists keeps under its title, so the
                        pill slides from one list to the next and focus stays on the tab chosen.
                        Drawn for the column's life and out of reach while Activity is not shown, so
                        the crossfade below is the one place a panel leaves. Drawn first, as where
                        the keyboard starts.
                    -->
                    <div class="chat-frame-activity"
                         :class="{ 'is-shown': shownPanel === 'activity' }"
                         :aria-hidden="shownPanel === 'activity' ? undefined : 'true'"
                         :inert="shownPanel !== 'activity' || undefined">
                        <Segmented :options="activityTabs" :modelValue="activityTab" optionTestId="activity-tab" hasAutofocus aria-label="Activity" @update:modelValue="onActivityTab($event as ActivityTab)" />
                    </div>

                    <!-- One panel gives way to the next in one crossfade, the old laid over the new and out of reach. -->
                    <Transition name="chat-panel-swap" @beforeLeave="onPanelLeave">
                        <ThreadsPanel v-if="shownList === 'threads'"
                                      :key="shownPanel ?? undefined"
                                      :tab="threadList.tab"
                                      :rows="threadList.rows"
                                      :hasMore="threadList.hasMore"
                                      :isLoading="threadList.isLoading"
                                      :isRefreshing="threadList.isRefreshing"
                                      :error="threadList.error"
                                      :followError="listFollowError"
                                      :channelId="threadList.channelId ?? activeChannelId ?? ''"
                                      :kind="activeKind ?? 'channel'"
                                      :roomTitles="roomTitles"
                                      :roomKinds="roomKinds"
                                      :publicRooms="publicRooms"
                                      :loadMore="loadMoreThreads"
                                      @open="openThreadFromList"
                                      @tab="onThreadsTab"
                                      @refresh="onThreadsRefresh"
                                      @follow="onFollowFromList"
                                      @close="closePanel">
                            <template v-if="shownPanel === 'activity'" #top>
                                <div class="chat-frame-activity-place" aria-hidden="true"></div>
                            </template>
                        </ThreadsPanel>

                        <MentionsPanel v-else-if="shownList === 'mentions'"
                                       v-bind="shell.mentions.state.inbox"
                                       :roomTitles="roomTitles"
                                       :roomKinds="roomKinds"
                                       :publicRooms="publicRooms"
                                       @jump="onMentionOpen"
                                       @openThread="(_rootId, _channelId, messageId) => onMentionOpen(messageId)"
                                       @refresh="shell.mentions.refreshInbox"
                                       @loadOlder="shell.mentions.loadOlder"
                                       @close="closePanel">
                            <template #top>
                                <div class="chat-frame-activity-place" aria-hidden="true"></div>
                            </template>
                        </MentionsPanel>

                        <MembersPanel v-else-if="shownList === 'members'"
                                      v-bind="membersView"
                                      @query="shell.members.setQuery"
                                      :loadMore="shell.members.loadMore"
                                      @retry="shell.members.retry"
                                      @retrySearch="shell.members.retrySearch"
                                      @message="onMemberMessage"
                                      @person="onMemberPerson"
                                      @addPeople="openAddPeople(shell.members.state.channelId ?? '')"
                                      @remove="shell.members.askRemove"
                                      @dismissRemoval="shell.members.dismissRemoval"
                                      @close="closePanel" />

                        <ThreadDrawer v-else-if="shownList === 'thread' && drawnThread"
                                      :key="drawnThread.rootId"
                                      :root="drawnThread.root"
                                      :replies="drawnThread.replies"
                                      :pending="shell.sender.pending(drawnThread.channelId)"
                                      :isFollowing="drawnThread.following"
                                      :followError="drawerFollowError"
                                      :conversationTitle="roomTitles[drawnThread.channelId] ?? ''"
                                      :isChannel="threadKind === 'channel'"
                                      :isDirectMessage="threadKind === 'person'"
                                      :isFromList="threadOrigin !== null"
                                      :listTitle="threadOrigin === 'activity' && activityTab === 'mentions' ? 'Mentions' : 'Threads'"
                                      :hasMore="drawnThread.hasMore"
                                      :isLoading="drawnThread.isLoading"
                                      :error="drawnThread.error"
                                      :olderError="drawnThread.olderError"
                                      :landOnId="landingReplyId"
                                      :isPersonLeader="threadRow?.is_leader ?? false"
                                      :isPreviewing="isPreviewingRoom(drawnThread.channelId)"
                                      :editingId="editingIdIn(drawnThread.channelId)"
                                      :editError="editErrorIn(drawnThread.channelId)"
                                      :isEditSaving="isEditSavingIn(drawnThread.channelId)"
                                      :reactionHost="reactionHost"
                                      :typing="threadTyping"
                                      :typingPlace="threadQuoteKey"
                                      @close="closeThreadDrawer"
                                      @back="onThreadBack"
                                      @follow="onFollowThread"
                                      @seen="shell.threads.seen"
                                      @loadOlder="onLoadOlderReplies"
                                      @retry="onRetry"
                                      @discard="shell.sender.discard"
                                      @jump="onJump($event, true)"
                                      @messageAction="onMessageAction($event, drawnThread.rootId)">
                            <template #composer>
                                <Composer isThread
                                          :title="roomTitles[drawnThread.channelId] ?? ''"
                                          :isChannel="threadKind === 'channel'"
                                          :isLocked="!shell.state.isComposerOpen"
                                          :lockedReason="lockedReason(threadRow, shell.state.service)"
                                          :maxLength="threadRow?.max_length ?? 0"
                                          :text="threadDraft?.text ?? ''"
                                          :mentions="threadDraft?.mentions ?? []"
                                          :isAlsoSent="threadDraft?.isAlsoSent ?? false"
                                          :quote="threadQuote"
                                          :isQuoteOwn="isOwnQuote(threadQuote)"
                                          :emojiSource="emojiSource"
                                          :mentionSource="mentionSourceFor(threadRow)"
                                          :conversationKey="threadComposerKey"
                                          :sendFailure="threadFailure"
                                          :lastFailure="shell.sender.lastFailure()"
                                          :tray="trayOf(drawnThread.channelId, drawnThread.rootId)"
                                          :busyPerson="threadPair"
                                          @send="onSendReply"
                                          @retryFailed="onRetryFailed(threadSends)"
                                          @discardFailed="onDiscardFailed(threadSends)"
                                          @update:text="onDraftText(threadQuoteKey, $event)"
                                          @update:isAlsoSent="onDraftAlsoSent(threadQuoteKey, $event)"
                                          @mention="onDraftMention(threadQuoteKey, $event)"
                                          @editLast="onEditLastReply"
                                          @cancelQuote="onCancelQuote(threadQuoteKey)"
                                          @emojiPickerOpen="onEmojiPickerOpen"
                                          @emojiChosen="onEmojiChosen"
                                          @mentionQuery="onMentionQuery(threadRow, $event)"
                                          @focus="onComposerFocus(threadRow, 'thread')"
                                          @blur="onComposerBlur"
                                          @overLimit="onOverLimit" />
                            </template>
                        </ThreadDrawer>
                    </Transition>
                </div>
            </aside>

            <Dialog :isOpen="!!confirmingDelete"
                    title="Delete this message?"
                    :body="deleteBody"
                    confirmLabel="Delete"
                    isDestructive
                    @close="onCancelDelete"
                    @confirm="onConfirmDelete">
                <template v-if="confirmingDelete" #preview>
                    <MessageBody :text="confirmingDelete.message.body ?? ''"
                                 :pieces="confirmingDelete.message.pieces ?? null" />
                </template>
            </Dialog>

            <!-- Blocking a person, asked from their card or one of their messages; unblocking needs no confirmation. -->
            <Dialog :isOpen="!!shell.blocks.state.confirming"
                    :title="blockTitle"
                    :body="blockSentence"
                    confirmLabel="Block"
                    isDestructive
                    :returnFocus="blockReturnTarget"
                    @close="onCancelBlock"
                    @confirm="onConfirmBlock" />

            <!-- Changing who is in the room, asked from the members panel and drawn over the frame. -->
            <RemoveMember v-bind="removeView" @close="shell.members.cancelRemove" @confirm="shell.members.remove" @query="shell.members.setSuccessorQuery" />
            <AddPeople v-bind="addView" @close="shell.members.closeAdd" @query="shell.members.setAddQuery" @retry="shell.members.retryAdd" @add="shell.members.add" />

            <!-- The reaction picker, one at a time, placed beside what opened it and drawn in the chat's root. -->
            <EmojiPicker v-if="reactionPicker"
                         :key="reactionPicker.key"
                         mode="react"
                         :startsOn="reactionPicker.startsOn"
                         :offered="reactionPicker.offered"
                         :source="emojiSource"
                         :mine="pickerMine"
                         :anchor="reactionPicker.anchor"
                         :opener="reactionPicker.opener"
                         @react="onPickerReact"
                         @close="closeReactionPicker" />

            <!-- The profile card, one at a time, beside the author or chip that asked, once its person is read. -->
            <ProfileCard v-if="shell.rooms.state.card?.person"
                         :key="cardOpenCount"
                         :person="shell.rooms.state.card.person"
                         :campuses="campuses"
                         :badges="shell.channels.badges"
                         :anchor="cardAnchor"
                         :rock="shell.rooms.state.card.rock"
                         :isLavaConfigured="isProfileLavaConfigured"
                         :showsOwnDetails="shell.prefs.state.me.show_profile_details"
                         :ownDetailsNote="shell.prefs.state.meNotes.profile_details ?? null"
                         @close="shell.rooms.closeCard"
                         @message="onCardMessage"
                         :isBlockBusy="!!shell.blocks.state.busy[shell.rooms.state.card.person.person_alias_guid.toLowerCase()]"
                         @settings="onCardSettings"
                         @toggleDetails="onCardToggleDetails"
                         @block="onCardBlock"
                         @unblock="onCardUnblock" />

            <!-- Kept mounted while the room's facts are held, so closing plays the dialog's exit. -->
            <ConversationDetails v-if="activeChannelId && activeFacts && activeKind"
                                 :key="activeChannelId"
                                 :isOpen="isDetailsOpen"
                                 :kind="activeKind"
                                 :title="activeTitle"
                                 :facts="activeFacts"
                                 :groupName="activeRow?.name ?? null"
                                 :canRename="shell.rooms.canRenameOf(activeChannelId)"
                                 :nameMaxLength="shell.state.limits.dm_name_max_length"
                                 :campuses="campuses"
                                 :leave="shell.rooms.leaveOf(activeChannelId)"
                                 :rename="shell.rooms.renameOf(activeChannelId)"
                                 :canSeeRoster="activeRow?.can_mention ?? false"
                                 :notifyMode="activeRow?.notify_mode ?? null"
                                 :isStarred="!!activeRow?.is_favorite"
                                 :isHidden="!!activeRow?.hidden"
                                 :prefsNotes="shell.prefs.roomOf(activeChannelId).notes"
                                 @close="closeDetails"
                                 @members="onDetailsMembers"
                                 @leave="onLeave"
                                 @rename="onRename"
                                 @notify="onRoomChoice({ kind: 'notify', mode: $event, isFromMenu: false })"
                                 @star="onRoomChoice({ kind: 'star', isStarred: $event, isFromMenu: false })"
                                 @hide="onRoomChoice({ kind: 'hide', isHidden: $event })" />

            <!-- The person's own settings, kept mounted so closing plays the dialog's exit. -->
            <ChatSettings :isOpen="isSettingsOpen"
                          :personAliasGuid="personAliasGuid"
                          :personName="personName"
                          :personPhotoUrl="personPhotoUrl"
                          :campusName="personCampusName"
                          :organizationName="organizationName"
                          :me="shell.prefs.state.me"
                          :statusChoice="statusChoice"
                          :statusClosedReason="statusClosedReason"
                          :isStatusRetrying="isStatusRetrying"
                          :notes="shell.prefs.state.meNotes"
                          :push="shell.state.push"
                          :blocked="shell.blocks.state"
                          @close="closeSettings"
                          @unblock="onSettingsUnblock"
                          @retryBlocked="shell.blocks.load"
                          @toggle="shell.prefs.setSwitch"
                          @status="onStatusChoice"
                          @pushOn="onTurnOnPush"
                          @pushOff="shell.turnOffPush" />
        </div>

        <!-- A phone shows one pane at a time, so its toasts sit over the whole block; so do those of a block with no frame. -->
        <ErrorToast v-if="isPhone || isPromptShown || isRefused" :errors="shell.state.errors" :notices="notices" @dismiss="shell.dismissError" @dismissNotice="onDismissNotice" />
    </div>
</template>

<style scoped>
/*
    The height is the room Rock's header and the context slicer leave on a Full Worksurface page,
    written out because Rock wraps a block in containers a percentage cannot reach through. The
    page's own padding and empty rows are taken away in the chat's sheet, so nothing else remains
    to subtract.
*/
.chat-shell {
    position: relative;
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--top-header-height, 80px) - var(--context-slicer-height, 0px));
}

.chat-frame {
    position: relative;
    display: grid;
    flex: 1;
    grid-template-rows: minmax(0, 1fr);
    grid-template-columns: var(--chat-w-side) minmax(0, 1fr) 0px;
    min-height: 0;
    overflow: hidden;
    background: var(--chat-surface);
    transition: grid-template-columns var(--chat-t-panel) var(--chat-ease-in);
}

/* Clipped where the browser can, so a scroll into view never moves the frame itself sideways. */
@supports (overflow: clip) {
    .chat-frame {
        overflow: clip;
    }
}

.chat-frame-side {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    min-width: 0;
    min-height: 0;
}

.chat-frame-main {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--chat-surface);
}

.chat-frame[data-panel-open="true"] {
    grid-template-columns: var(--chat-w-side) minmax(0, 1fr) var(--chat-w-panel);
}

/*
    A window too narrow for three columns folds the sidebar away while a panel is open: its column
    closes and the sidebar waits off to the left, faded, laid over the conversation when the
    header's sidebar button opens it. It slides by the sheet's whole-size distance, which reduced
    motion takes to nothing, so there it only fades.
*/
.chat-frame[data-sidebar] {
    grid-template-columns: 0px minmax(0, 1fr) var(--chat-w-panel);
}

.chat-frame[data-sidebar] .chat-frame-side {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: var(--chat-z-panel);
    width: var(--chat-w-side);
    background: var(--chat-sidebar);
    opacity: 0;
    transform: translateX(calc(-1 * var(--chat-rise-sheet)));
    transition: transform var(--chat-t-panel) var(--chat-ease-in), opacity var(--chat-t-base) var(--chat-ease-state);
}

/* Over the shade that sets it apart from the conversation, as a sheet stands over its own. */
.chat-frame[data-sidebar="over"] .chat-frame-side {
    z-index: var(--chat-z-sheet);
    box-shadow: var(--chat-shadow-pop);
    opacity: 1;
    transform: none;
}

/*
    Activity's tabs under its lists' title, where a list's own tabs sat: laid over the place each
    list keeps for them, under the panel's 64px header, and over the crossfade, so they stay put
    as the list under them changes. The place is the Segmented's height with this padding, so the
    two always agree.
*/
.chat-frame-activity,
.chat-frame-activity-place {
    box-sizing: content-box;
    flex: none;
    height: 38px;
    padding: 10px 14px 4px;
}

.chat-shell[data-phone="true"] .chat-frame-activity,
.chat-shell[data-phone="true"] .chat-frame-activity-place {
    height: 46px;
}

/* Placed by its own sides, and faded in and out over the swap, as the lists under it crossfade. */
.chat-frame-panel-inner > .chat-frame-activity {
    position: absolute;
    top: 64px;
    right: 0;
    left: 0;
    z-index: var(--chat-z-raised);
    opacity: 0;
    transition: opacity var(--chat-d-swap) var(--chat-ease-state);
}

.chat-frame-panel-inner > .chat-frame-activity.is-shown {
    opacity: 1;
}

/* One panel gives way to the next: the old fades out laid over the new as it fades in. */
.chat-panel-swap-enter-active,
.chat-panel-swap-leave-active {
    transition: opacity var(--chat-d-swap) var(--chat-ease-state);
}

.chat-panel-swap-leave-active {
    position: absolute;
    inset: 0;
}

.chat-panel-swap-enter-from,
.chat-panel-swap-leave-to {
    opacity: 0;
}

.chat-frame-panel {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--chat-surface);
}

/* Clipped where the browser can, so focus put inside the column as it opens from 0px never scrolls it. */
@supports (overflow: clip) {
    .chat-frame-panel {
        overflow: clip;
    }
}

/* Its dividing line only while open, so the closed column is 0px wide and not a 1px sliver. */
.chat-frame[data-panel-open="true"] .chat-frame-panel {
    border-left: 1px solid var(--chat-line);
}

/* The content keeps its full width while the column opens around it, fading in as it slides home. */
.chat-frame-panel-inner {
    position: relative;
    width: var(--chat-w-panel);
    height: 100%;
    opacity: 0;
    transform: translateX(var(--chat-rise));
    transition: opacity var(--chat-t-base) var(--chat-ease-state), transform var(--chat-t-panel) var(--chat-ease-in);
}

.chat-frame[data-panel-open="true"] .chat-frame-panel-inner {
    opacity: 1;
    transform: none;
}

/* A phone: one pane fills the frame and the other waits beside it, the list a little to the left. */
.chat-shell[data-phone="true"] .chat-frame {
    display: block;
}

.chat-shell[data-phone="true"] .chat-frame-side,
.chat-shell[data-phone="true"] .chat-frame-main,
.chat-shell[data-phone="true"] .chat-frame-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

/* Only a move the person made slides; the conversation a link opens is simply there. */
.chat-shell[data-phone="true"] .chat-frame.is-pane-motion-on .chat-frame-side,
.chat-shell[data-phone="true"] .chat-frame.is-pane-motion-on .chat-frame-main,
.chat-shell[data-phone="true"] .chat-frame.is-pane-motion-on .chat-frame-panel {
    transition: transform var(--chat-t-panel) var(--chat-ease-in), opacity var(--chat-t-base) var(--chat-ease-state);
}

/* The panel is a third pane over the conversation, waiting off to the right until it opens. */
.chat-shell[data-phone="true"] .chat-frame-panel {
    z-index: var(--chat-z-panel);
    border-left: 0;
    transform: translateX(100%);
}

.chat-shell[data-phone="true"] .chat-frame[data-pane="panel"] .chat-frame-panel {
    transform: none;
}

.chat-shell[data-phone="true"] .chat-frame-panel-inner {
    width: 100%;
}

.chat-shell[data-phone="true"] .chat-frame[data-pane="conversation"] .chat-frame-side,
.chat-shell[data-phone="true"] .chat-frame[data-pane="panel"] .chat-frame-side {
    pointer-events: none;
    opacity: 0;
    transform: translateX(-24%);
}

.chat-shell[data-phone="true"] .chat-frame[data-pane="list"] .chat-frame-main {
    pointer-events: none;
    transform: translateX(100%);
}

/* No box of its own: the header, the feed and the composer stay the column's own flex items. */
.chat-frame-under {
    display: contents;
}

.chat-notice-place {
    position: relative;
    flex: none;
    height: 0;
    z-index: var(--chat-z-notice);
}

/*
    The first screen's reveal: the column's parts fade in as the veil fades out. The feed's rise
    is the feed's own, played when the column is revealed, so nothing here animates the feed
    itself: a second animation on it would restart its own when this one ended.
*/
.chat-frame-under.is-revealing > * {
    animation: chat-reveal-in var(--chat-d-reveal) var(--chat-ease-in) both;
}

/* A full view over the conversation, which stays laid out and inert underneath. */
.chat-main-view {
    position: absolute;
    inset: 0;
    z-index: var(--chat-z-view);
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--chat-surface);
    animation: chat-enter var(--chat-d-view) var(--chat-ease-in);
}

/* After a join settles, the composer takes the join bar's place, rising in as a message does. */
.chat-composer.is-entering {
    animation: chat-enter var(--chat-t-msg) var(--chat-ease-in);
}

.chat-shell-empty {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    color: var(--chat-muted);
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, onMounted, provide, ref, shallowRef, watch } from "vue";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { ChatBirthdateResultBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatBirthdateResultBag";
    import { ChatShellInitializationBox } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatShellInitializationBox";
    import { ChatShellSessionBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatShellSessionBag";
    import { DatePartsPickerValueBag } from "@Obsidian/ViewModels/Controls/datePartsPickerValueBag";
    import { birthdateOutcome, isBirthdatePromptShown } from "./ChatShell/birthdate.partial";
    import { createBrowserShellBuilder } from "./ChatShell/browserShell.partial";
    import BirthdatePrompt from "./ChatShell/components/birthdatePrompt.partial.obs";
    import ChannelDirectory from "./ChatShell/components/channelDirectory.partial.obs";
    import ChannelSidebar from "./ChatShell/components/channelSidebar.partial.obs";
    import PageVeil from "./ChatShell/components/pageVeil.partial.obs";
    import ChatHeader from "./ChatShell/components/chatHeader.partial.obs";
    import ChatSettings from "./ChatShell/components/chatSettings.partial.obs";
    import Composer from "./ChatShell/components/composer.partial.obs";
    import ConversationDetails from "./ChatShell/components/conversationDetails.partial.obs";
    import { DirectMessageDraft } from "./ChatShell/composables/useDirectMessage.partial";
    import EmojiPicker from "./ChatShell/components/emojiPicker.partial.obs";
    import MentionsPanel from "./ChatShell/components/mentionsPanel.partial.obs";
    import MembersPanel from "./ChatShell/components/membersPanel.partial.obs";
    import { StatusChoice } from "./ChatShell/composables/usePrefs.partial";
    import AddPeople from "./ChatShell/components/addPeople.partial.obs";
    import RemoveMember from "./ChatShell/components/removeMember.partial.obs";
    import ErrorToast, { ToastNotice } from "./ChatShell/components/errorToast.partial.obs";
    import JoinBar from "./ChatShell/components/joinBar.partial.obs";
    import MessageBody from "./ChatShell/components/messageBody.partial.obs";
    import MessageFeed from "./ChatShell/components/messageFeed.partial.obs";
    import NewMessage from "./ChatShell/components/newMessage.partial.obs";
    import ProfileCard from "./ChatShell/components/profileCard.partial.obs";
    import ThreadDrawer from "./ChatShell/components/threadDrawer.partial.obs";
    import ThreadsPanel from "./ChatShell/components/threadsPanel.partial.obs";
    import { attachmentViewsKey } from "./ChatShell/composables/useAttachments.partial";
    import { gifsKey } from "./ChatShell/composables/useGifs.partial";
    import { presenceStatusKey } from "./ChatShell/composables/usePresenceStatus.partial";
    import { problemReportKey } from "./ChatShell/problemReport.partial";
    import { messageMotionKey } from "./ChatShell/messageMotion.partial";
    import { pageRevealKey } from "./ChatShell/pageLoad.partial";
    import { ActivityTab, useFrameView } from "./ChatShell/composables/useFrameView.partial";
    import { useReactionPicker } from "./ChatShell/composables/useReactionPicker.partial";
    import { useComposers } from "./ChatShell/composables/useComposers.partial";
    import { useOverlaysView } from "./ChatShell/composables/useOverlaysView.partial";
    import { lockedReason } from "./ChatShell/composables/useSend.partial";
    import { refusalMessage, startWaitMessage } from "./ChatShell/shellSession.partial";
    import { blockSentence } from "./ChatShell/composables/useBlocks.partial";
    import { ChatCampusBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatCampusBag";
    import { applyChatTheme } from "./ChatShell/ui/brand.partial";
    import { provideChatSession } from "./ChatShell/chatSession.partial";
    import { Announcer, provideAnnouncer } from "./ChatShell/ui/announcer.partial";
    import Dialog from "./ChatShell/ui/dialog.partial.obs";
    import Scrim from "./ChatShell/ui/scrim.partial.obs";
    import Segmented, { SegmentedOption } from "./ChatShell/ui/segmented.partial.obs";

    // #region Types

    /** What the push worker posts to a window of the site, in the worker's own names. */
    /* eslint-disable-next-line @typescript-eslint/naming-convention */
    type WorkerMessage = { type?: string, channel_id?: string, root_id?: string, message_id?: string };

    // #endregion Types

    const config = useConfigurationValues<ChatShellInitializationBox>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const personAliasGuid = ref(config.session?.personAliasGuid ?? "");

    /** The reader's own name and photo, for their messages the platform has sent no name with yet. */
    const personName = ref(fullName(config.session));
    const personPhotoUrl = ref(config.session?.personPhotoUrl ?? null);

    const organizationName = config.organizationName ?? "";

    /** The church's campuses, which name every campus a room or a person carries. */
    const campuses: ChatCampusBag[] = config.campuses ?? [];

    /** The person's own campus, which the church's campus note in Browse channels names. */
    const personCampusGuid = ref(config.session?.personCampusGuid ?? null);

    /** Whether the church has a profile card template, whose lines a card reserves while Rock renders it. */
    const isProfileLavaConfigured = ref(config.session?.isProfileLavaConfigured === true);

    /** The chat's one voice, once provided below; the shell's rooms and settings speak in it. */
    let announcer: Announcer | null = null;

    const buildShell = createBrowserShellBuilder({
        linkedChannelId: config.channelGuid ?? null,
        areSharedChannelsFilteredByCampus: config.areSharedChannelsFilteredByCampus ?? false,
        isSignInPersisted: config.isSignInPersisted ?? false,
        notify: showNotice,
        // Provided below with the chat's root; nothing is said before the shell has started.
        announce: (text, politeness) => announcer?.announce(text, politeness),
        invokeBlockAction,
        // Called only after the frame below is set up, so the landings they reach are there.
        mentionViews: {
            landInConversation: (channelId, messageId) => landInConversation(channelId, messageId),
            openThread: (channelId, rootId, messageId) => openThreadFromMentions(channelId, rootId, messageId)
        }
    });

    // Replaced, not reloaded, when a birthdate lets the person in: the save answers with the
    // session a fresh page load would have had.
    const shell = shallowRef(buildShell(config.session ?? {}));

    // Which build of the shell the frame is drawn from. A new session draws a new frame, so every
    // row and view takes its place in the new record of what happened, never the stopped one's.
    const shellBuild = ref(0);

    // Every photo and face joins the first screen's reveal: it reads when the page releases and
    // reports what it is still decoding through this. The shell is rebuilt after a birthdate
    // answer, so the reveal is read through it each time.
    provide(pageRevealKey, {
        get state() {
            return shell.value.reveal.state;
        },
        holdFace: decoded => shell.value.reveal.holdFace(decoded)
    });

    // Every row's files read the session's local copies and links through this, which follows the
    // shell when it is built again, so a row never holds a session that has gone.
    provide(attachmentViewsKey, {
        previewOf: id => shell.value.attachments.previewOf(id),
        links: {
            subscribe: items => shell.value.attachments.links.subscribe(items),
            linkOf: item => shell.value.attachments.links.linkOf(item),
            isFresh: item => shell.value.attachments.links.isFresh(item),
            fresh: item => shell.value.attachments.links.fresh(item)
        }
    });

    // Every composer's GIF search, which follows the shell when it is built again in the same way.
    provide(gifsKey, {
        isOn: () => shell.value.gifs.isOn(),
        search: (query, page, signal) => shell.value.gifs.search(query, page, signal),
        covers: () => shell.value.gifs.covers(),
        turnOff: () => shell.value.gifs.turnOff()
    });

    // Every row and view reads what happened to its messages through this, from whichever shell is
    // current, so a row drawn after the shell is built again never reads a record that has stopped.
    // Read only: the shell's own stores are what record.
    provide(messageMotionKey, {
        now: () => shell.value.motion.now(),
        of: key => shell.value.motion.of(key),
        typingOf: place => shell.value.motion.typingOf(place),
        versionOf: place => shell.value.motion.versionOf(place),
        scope: () => shell.value.motion.scope()
    });

    // Every face that draws a status reads it here, from whichever shell is current. A face
    // registers its people with the shell it mounted under; the frame is drawn again for a new
    // shell, so no face outlives the store it registered with. Read only: presence alone writes it.
    provide(presenceStatusKey, {
        statusOf: guid => shell.value.presence.status.statusOf(guid),
        register: (people, rank) => shell.value.presence.status.register(people, rank),
        now: () => shell.value.presence.status.now()
    });

    // A message type or block drawn by its fallback is told to the platform, through whichever shell is current.
    provide(problemReportKey, {
        report: (kind, code, count, detail) => shell.value.problems.report(kind, code, count, detail)
    });

    const birthdateMessage = ref<string | null>(null);
    const isSavingBirthdate = ref(false);

    /** Focus that went with a room closing under it, owed to the next conversation that opens. */
    let isFocusOwed = false;

    /** Toasts that are not failures, such as being back online after an outage. */
    const notices = ref<ToastNotice[]>([]);

    const rootElement = ref<HTMLElement>();

    // The block's own width, not the window's or a container query's, since the oldest Safari Rock
    // supports has no container queries and a narrow zone of a wide window is still narrow.
    let resizeObserver: ResizeObserver | null = null;

    /**
     * Whether the open conversation replaced another, so its feed rises into view. The first one
     * the page draws rises only as its first page is drawn, which the feed decides.
     */
    const isFeedEntering = ref(false);

    /** Whether the composer is rising into the join bar's place after a join settled. */
    const isComposerEntering = ref(false);

    /** The join bar in the composer's place, whose focus goes to the composer once a join settles. */
    const joinBar = ref<InstanceType<typeof JoinBar>>();

    /** The one reaction picker open at a time, and what every message row and emoji picker reads of the reactions. */
    const { reactionPicker, reactionHost, emojiSource, pickerMine, openReactionPicker, closeReactionPicker, onPickerReact } = useReactionPicker(shell, organizationName);

    // #endregion Values

    // #region Computed Values

    const activeChannelId = computed((): string | null => shell.value.state.activeChannelId);

    const draft = computed((): DirectMessageDraft | null => shell.value.directMessages.draft);

    // Created here rather than with the values, since it reads the open conversation above.
    const frame = useFrameView({
        shell,
        activeChannelId,
        rootElement,
        linkedReply: config.channelGuid && config.threadRootId
            ? { channelId: config.channelGuid.toLowerCase(), rootId: config.threadRootId, messageId: config.messageId ?? null }
            : null,
        campuses,
        showNotice
    });

    const {
        isPhone, isPaneMotionOn, pane, isSidebarHidden, isMainInert, isPanelHidden, isPanelInert, isSidebarGone, isConversationGone, isPanelGone, goneStyle,
        panelKind, shownPanel, shownList, activityTab, sidebarFold, isMembersOffered, panelElement, sidebarElement, mainElement, mainViewElement, drawnThread, threadOrigin, focusStop,
        onResize, onFocusIn, onFocusOut, onSelect, onBack, onListPanel, onActivityTab, onPanelLeave, onSidebarOver, onSidebarAway, onThreadsTab, openThreadFromList, onOpenThread, onThreadBack, onMentionOpen,
        openThreadFromMentions, openFromTap, closeThreadDrawer, closePanel,
        mainView, openMainView, closeMainView, openFromMainView, openAddPeople,
        landingReplyId, landingMessageId, onJump, landInConversation,
        membersView, removeView, addView,
        threadList, drawerFollowError, listFollowError, onThreadsRefresh, loadMoreThreads, onFollowFromList, onFollowThread, onLoadOlderReplies
    } = frame;

    /** Activity's two lists, in the Segmented over whichever is shown. */
    const activityTabs: SegmentedOption[] = [{ value: "mentions", label: "Mentions" }, { value: "threads", label: "Threads" }];

    // One computed per fact of the open room, handed to every composable below that reads it.
    const {
        activeRow, activeFacts, activeKind, isJoinBarShown, isActiveDirectMessage, activePeople, activePair, activeTitle, look, activeSubtitle, isActiveBehind,
        roomTitles, roomKinds, publicRooms, threadRow, threadKind, threadPair, foundTitle, foundRow, foundTimeline, isPreviewingRoom
    } = frame.rooms;

    /**
     * Why her status cannot be set now, in the banner's words, while the church is read only and a
     * choice could only be refused; null under maintenance, where a choice waits and is sent again.
     */
    const statusClosedReason = computed((): string | null => lockedReason(null, shell.value.state.service));

    /**
     * Her status as her settings show it, held as one value that moves only when they do, since the
     * sidebar and Chat settings take it as a prop and a new value on every render of the block
     * would draw the whole sidebar again with each send, notice and thread change.
     */
    const statusChoice = computed((): StatusChoice => shell.value.prefs.shownStatus());

    /** Whether her status choice keeps failing to save, which the menus she chooses it from and the Status line say. */
    const isStatusRetrying = computed((): boolean => shell.value.prefs.isStatusRetrying());

    /** The count on the app icon, from the sidebar, so reading what it counts clears it. */
    const appBadge = computed((): number => shell.value.appBadge());

    const isPromptShown = computed((): boolean => isBirthdatePromptShown(shell.value.state.phase, shell.value.state.gate));

    const isRefused = computed((): boolean => shell.value.state.phase === "refused" || shell.value.state.phase === "failed");

    const refusal = computed((): string => refusalMessage(shell.value.state.phase, shell.value.state.gate));

    /**
     * What a start still waiting says, drawn on the one veil in view: the column's on a wide block,
     * the list's on a phone, whose column is not on screen at first.
     */
    const startStatus = computed((): string | null => {
        const stage = shell.value.state.startWait;
        return stage ? startWaitMessage(stage) : null;
    });

    /**
     * What the page says to a screen reader about its start: each stage once while it waits, a
     * refusal's sentence once, and nothing once chat is ready, as a load that lands says nothing.
     */
    const startAnnouncement = computed((): string => {
        if (shell.value.state.phase === "starting") {
            return startStatus.value ?? "";
        }
        return isRefused.value && !isPromptShown.value ? refusal.value : "";
    });

    /** The person's own campus by its name, for the sidebar's foot and Chat settings. */
    const personCampusName = computed((): string | null => {
        const id = personCampusGuid.value?.toLowerCase();
        return id ? campuses.find(campus => campus.guid.toLowerCase() === id)?.name ?? null : null;
    });

    /**
     * Everything drawn over the frame: the dialogs, the card, and the message actions' quotes,
     * editor and confirms, with where a message's bar and menu send their actions.
     */
    const {
        isDetailsOpen, isSettingsOpen, cardAnchor, cardOpenCount, onCardMessage, onLeave, onRename, closeDetails, onRoomChoice,
        onCardToggleDetails, onCardBlock, onCardUnblock, onSettingsUnblock, onCardSettings, closeSettings, onMemberMessage, onMemberPerson, onDetailsMembers,
        conversationQuoteKey, threadQuoteKey, conversationQuote, threadQuote, confirmingDelete, deleteBody, isOwnQuote,
        editingIdIn, editErrorIn, isEditSavingIn, onEditLast, onEditLastReply, onCancelQuote, onMessageAction, onCancelDelete, onConfirmDelete,
        blockTitle, blockReturnTarget, onCancelBlock, onConfirmBlock
    } = useOverlaysView({ shell, activeChannelId, personAliasGuid, rootElement, frame, openReactionPicker, closeReactionPicker });

    const {
        conversationTray, conversationDraft, threadDraft, conversationSends, conversationFailure, threadSends, threadFailure, threadComposerKey, conversationTyping, threadTyping,
        onMentionQuery, onComposerFocus, onComposerBlur, onDraftText, onDraftAlsoSent, onDraftMention, onConversationDragOver, onConversationDrop,
        onSendReply, onEmojiPickerOpen, onEmojiChosen, onRetry, onRetryFailed, onDiscardFailed, trayOf, mentionSourceFor
    } = useComposers({ shell, activeChannelId, activeRow, isJoinBarShown, drawnThread, panelKind, isPanelHidden, conversationQuoteKey, threadQuoteKey });

    // What the whole session shares, read by any part however deep: whether the chat is at a
    // phone's width, who is signed in (replaced when a birthdate answer lets a new session in), the
    // church, and the emoji and mention sources.
    provideChatSession({
        isPhone,
        me: computed(() => ({ personAliasGuid: personAliasGuid.value, name: personName.value, photoUrl: personPhotoUrl.value })),
        church: { name: organizationName },
        emojiSource,
        mentionSource: mentionSourceFor
    });

    // The chat's one voice for a screen reader, speaking from its root; the shell's rooms and
    // settings speak in it too.
    announcer = provideAnnouncer(rootElement);

    // #endregion Computed Values

    // #region Event Handlers

    /** New message's send: to the conversation found, or the first message of a new one. */
    function onSendFirst(body: string): void {
        isPaneMotionOn.value = true;
        void shell.value.directMessages.sendFirst(body);
    }

    function onJoin(): void {
        if (activeChannelId.value) {
            void shell.value.rooms.join(activeChannelId.value);
        }
    }

    /**
     * The column's reveal is under way until its fade ends or is cancelled. It also ends with the
     * room it revealed, so no later room's parts take the reveal's fade in place of their own
     * rise, whatever the browser fired.
     */
    const isRevealing = ref(false);

    watch(() => shell.value.reveal.state.isMainRevealed, isRevealed => {
        if (isRevealed) {
            isRevealing.value = true;
        }
    });

    watch(activeChannelId, () => {
        isRevealing.value = false;
    });

    /** A reveal animation has ended or been cancelled; a row's own animation ending inside the column says nothing about it. */
    function onRevealAnimationEnd(event: AnimationEvent): void {
        if (event.animationName === "chat-reveal-in") {
            isRevealing.value = false;
        }
    }

    /** The composer's own rise has ended; a strip inside it ending says nothing about the composer. */
    function onComposerAnimationEnd(event: AnimationEvent): void {
        if (event.target === event.currentTarget) {
            isComposerEntering.value = false;
        }
    }

    /**
     * Focus that leaves New message or a room's details for nowhere, as a control that locks or
     * goes away drops it, is owed to the next conversation that opens; focus the person puts
     * anywhere in the chat pays it.
     */
    function onFrameFocusOut(event: FocusEvent): void {
        const target = event.target as Element | null;
        if (event.relatedTarget === null && target && isInViewOrDetails(target)) {
            isFocusOwed = true;
        }

        onFocusOut(event);
    }

    /** Focus the person puts anywhere in the chat pays what is owed, and the frame notes the column it is in. */
    function onFrameFocusIn(event: FocusEvent): void {
        isFocusOwed = false;
        onFocusIn(event);
    }

    /** Says the outage is over, once, however many times the connection came and went. */
    function onBackOnline(): void {
        if (!notices.value.some(n => n.code === "back-online")) {
            notices.value.push({ code: "back-online", text: "You're back online", icon: "check" });
        }
    }

    /** Shows a toast, one per code, the newest kept, so a second copy or delete restarts its toast. */
    function showNotice(notice: ToastNotice): void {
        notices.value = [...notices.value.filter(n => n.code !== notice.code), notice];
    }

    function onDismissNotice(notice: ToastNotice): void {
        notices.value = notices.value.filter(n => n.code !== notice.code);
    }

    function onTurnOnPush(): void {
        void shell.value.turnOnPush();
    }

    /** A choice in her status menu, from the sidebar's foot or the Chat settings group. */
    function onStatusChoice(choice: StatusChoice): void {
        void shell.value.prefs.setStatus(choice);
    }

    /** A send over the room's limit was held back: the toast names the limit. */
    function onOverLimit(maxLength: number): void {
        showNotice({ code: "over-limit", text: `This message is over the ${maxLength.toLocaleString()} character limit.`, icon: "alert" });
    }

    /**
     * The push worker asks whether a push's channel is on screen, so it can leave the banner out,
     * and after a tap tells this window which channel to open. A reply's push names its root: the
     * ask is then about the thread alone, since a reply kept to its thread is seen only in the
     * drawer, and the tap opens the thread at the reply over its conversation.
     */
    function onWorkerMessage(event: MessageEvent): void {
        const message = (event.data ?? {}) as WorkerMessage;
        const rootId = messageIdOf(message.root_id);

        if (message.type === "chat.push.is-open") {
            const isOpen = rootId !== null
                ? shell.value.isThreadOnScreen(rootId)
                : !!message.channel_id && shell.value.isChannelOnScreen(message.channel_id);
            event.ports[0]?.postMessage({ open: isOpen });
        }
        else if (message.type === "chat.push.open" && message.channel_id) {
            openFromTap(message.channel_id.toLowerCase(), rootId, messageIdOf(message.message_id));
        }
    }

    async function onSaveBirthdate(birthDate: DatePartsPickerValueBag): Promise<void> {
        isSavingBirthdate.value = true;
        const result = await invokeBlockAction<ChatBirthdateResultBag>("SaveBirthdate", { birthDate });
        isSavingBirthdate.value = false;

        const outcome = birthdateOutcome({ isSuccess: result.isSuccess, statusCode: result.statusCode, data: result.data });

        if (outcome.kind === "retry") {
            birthdateMessage.value = outcome.message;
            return;
        }

        birthdateMessage.value = null;

        if (outcome.kind === "refused") {
            shell.value.state.gate = outcome.gate;
            return;
        }

        await shell.value.stop();
        personAliasGuid.value = outcome.session.personAliasGuid ?? "";
        personName.value = fullName(outcome.session);
        personPhotoUrl.value = outcome.session.personPhotoUrl ?? null;
        personCampusGuid.value = outcome.session.personCampusGuid ?? null;
        isProfileLavaConfigured.value = outcome.session.isProfileLavaConfigured === true;
        shell.value = buildShell(outcome.session);
        shellBuild.value++;
        void shell.value.start();
    }

    // #endregion Event Handlers

    // #region Functions

    /** Whether an element is inside a full view in the conversation's place or the room's details. */
    function isInViewOrDetails(element: Element): boolean {
        return !!mainViewElement.value?.contains(element) || !!element.closest("[role='dialog']")?.querySelector("[data-focus-stop='details-identity']");
    }

    /** A message id the worker posted as a string, or null when it is not one. */
    function messageIdOf(value: string | undefined): number | null {
        const id = Number(value);
        return value && Number.isSafeInteger(id) && id > 0 ? id : null;
    }

    /** The person's name as the chat shows it, from the session Rock opened. */
    function fullName(session: ChatShellSessionBag | null | undefined): string {
        return [session?.personNickName, session?.personLastName].filter(part => !!part).join(" ");
    }

    // #endregion Functions

    // #region Watchers

    // Before the new feed mounts, which reads it once.
    watch(activeChannelId, (now, before) => {
        isFeedEntering.value = !!now && !!before && now !== before;
    });

    // The join bar gives way to the composer in the same channel once the join settles, and the
    // composer rises into its place; one opened another way is simply there. Focus in the bar
    // goes with it to the composer, or on a phone, where a focused composer would raise the
    // keyboard unasked, to the conversation's title; focus anywhere else is the person's and stays.
    watch([isJoinBarShown, activeChannelId], ([isShown, channelId], [wasShown, wasChannelId]) => {
        isComposerEntering.value = wasShown && !isShown && channelId === wasChannelId;
        const bar: Element | undefined = joinBar.value?.$el;
        if (!isComposerEntering.value || !bar?.contains(document.activeElement)) {
            return;
        }

        void nextTick(() => focusStop(["composer", "header"], { within: "main" }));
    });

    // From the first sidebar the page loads, a count of none included, so a badge a mention push
    // left behind is cleared once the person has read it.
    watch([appBadge, (): string => shell.value.state.phase], ([count, phase]) => {
        if (phase !== "ready") {
            return;
        }

        // Only where the site is installed as an app does the browser draw it; elsewhere a no-op.
        const badging = navigator as Navigator & { setAppBadge?: (count?: number) => Promise<void>, clearAppBadge?: () => Promise<void> };
        const done = count > 0 ? badging.setAppBadge?.(count) : badging.clearAppBadge?.();
        void done?.catch(() => undefined);
    });

    // A conversation that opens in place of what had focus, New message after its first message
    // or the details of a room just left, would leave focus on the page as those go: it moves to
    // the composer of what opened, or on a phone, where that would raise the keyboard, its title.
    // Read before the screen changes, while what had focus is still there. A leave's own sync can
    // close the room before its door answers and opens the next, so focus that went with the
    // closing is owed to the next conversation that opens, unless the person has put it somewhere.
    watch(activeChannelId, (now, before) => {
        const active = document.activeElement;
        const root = rootElement.value;
        const isFocusGoing = now !== before && !!active && !!root?.contains(active) && isInViewOrDetails(active);
        if (!now) {
            isFocusOwed = isFocusOwed || isFocusGoing;
            return;
        }

        const isFocusLost = !active || active === document.body;
        const isOwed = isFocusOwed && isFocusLost;
        isFocusOwed = false;
        if (!isFocusGoing && !isOwed) {
            return;
        }

        void nextTick(() => focusStop(["composer", "header"], { within: "main" }));
    });

    // The details go with the room's row when a reload no longer lists it, which a leave's own
    // sync can bring before its door answers; focus they held is owed to what opens next.
    watch(() => !!(activeChannelId.value && activeFacts.value && activeKind.value), (isShown, wasShown) => {
        const active = document.activeElement;
        if (wasShown && !isShown && !!active && isInViewOrDetails(active)) {
            isFocusOwed = true;
        }
    });

    // The panel column keeps drawing a closing drawer while it narrows, so a picker opened from
    // the drawer would float over it, beside a message going away; the drawer's closing closes it.
    watch(panelKind, () => {
        const anchor = reactionPicker.value?.anchor;
        if (anchor && panelElement.value?.contains(anchor)) {
            closeReactionPicker();
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(() => {
        // Once per load: the church color and whether the page's Rock theme can follow the system into dark.
        if (rootElement.value) {
            applyChatTheme(rootElement.value);

            if (typeof ResizeObserver !== "undefined") {
                resizeObserver = new ResizeObserver(onResize);
                resizeObserver.observe(rootElement.value);
            }
        }

        navigator.serviceWorker?.addEventListener("message", onWorkerMessage);
        void shell.value.start();
    });

    onBeforeUnmount(() => {
        resizeObserver?.disconnect();
        navigator.serviceWorker?.removeEventListener("message", onWorkerMessage);
        void shell.value.stop();
    });

    // #endregion Lifecycle Hooks
</script>
