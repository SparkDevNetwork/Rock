<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div ref="rootElement"
         class="chat-shell"
         data-testid="chat-shell"
         :data-phase="shell.state.phase"
         :data-phone="isPhone ? 'true' : 'false'">
        <BirthdatePrompt v-if="isPromptShown"
                         :message="birthdateMessage"
                         :isSaving="isSavingBirthdate"
                         @save="onSaveBirthdate" />

        <NotificationBox v-else-if="isRefused" :alertType="AlertType.Warning">
            {{ refusal }}
        </NotificationBox>

        <div v-else
             class="chat-frame"
             :class="{ 'is-pane-motion-on': isPaneMotionOn }"
             data-testid="chat-frame"
             :data-pane="pane"
             :data-panel-open="panelKind ? 'true' : 'false'">
            <div class="chat-frame-side"
                 data-testid="frame-sidebar"
                 :aria-hidden="isSidebarHidden ? 'true' : undefined"
                 :inert="isSidebarHidden || undefined"
                 :style="isSidebarGone ? goneStyle : undefined">
                <ChannelSidebar :rows="shell.channels.rows"
                                :activeChannelId="shell.state.activeChannelId"
                                :isNewMessageShown="shell.isNewMessageShown"
                                :organizationName="organizationName"
                                :isPhone="isPhone"
                                :isBrowseOpen="mainView === 'directory'"
                                :isNewMessageOpen="mainView === 'newdm'"
                                @select="onSelect"
                                @newMessage="openMainView('newdm')"
                                @browse="openMainView('directory')" />
            </div>

            <section class="chat-frame-main"
                     data-testid="frame-main"
                     aria-label="Conversation"
                     :data-look="look ?? undefined"
                     :aria-hidden="isConversationHidden ? 'true' : undefined"
                     :inert="isConversationHidden || undefined"
                     :style="isConversationGone ? goneStyle : undefined">
                <!--
                    The conversation stays laid out under a full view, so its place in the feed
                    survives, and is out of reach until the view closes. Drawn as no box of its own,
                    so the column lays its parts out as before.
                -->
                <div class="chat-frame-under"
                     data-testid="frame-conversation"
                     :aria-hidden="mainView ? 'true' : undefined"
                     :inert="!!mainView || undefined">
                    <ChatHeader :title="activeTitle"
                                :subtitle="activeSubtitle"
                                :facts="activeFacts"
                                :campuses="campuses"
                                :kind="activeKind"
                                :isPublic="activeRow?.is_public ?? false"
                                :people="activePeople"
                                :connection="shell.state.connection"
                                :banner="shell.state.banner"
                                :isUpdateRequired="shell.state.isUpdateRequired"
                                :isBehind="isActiveBehind"
                                :isPushOffered="shell.state.isPushOffered"
                                :isPhone="isPhone"
                                :isEmpty="!activeChannelId"
                                :isThreadsOffered="!!activeChannelId"
                                :isThreadsOpen="panelKind === 'threads'"
                                :isMentionsOffered="shell.state.phase === 'ready'"
                                :isMentionsOpen="panelKind === 'mentions'"
                                :hasMentionDot="shell.mentions.state.hasDot"
                                @threads="onListPanel('threads')"
                                @mentions="onListPanel('mentions')"
                                @turnOnPush="onTurnOnPush"
                                @back="onBack"
                                @backOnline="onBackOnline"
                                @details="isDetailsOpen = true" />

                    <MessageFeed v-if="activeChannelId"
                                 :key="activeChannelId"
                                 :timeline="shell.timelines.state(activeChannelId)"
                                 :pending="shell.sender.pending(activeChannelId)"
                                 :sentKeys="shell.sender.sentKeys"
                                 :personAliasGuid="personAliasGuid"
                                 :personName="personName"
                                 :personPhotoUrl="personPhotoUrl"
                                 :organizationName="organizationName"
                                 :isChannel="activeKind === 'channel'"
                                 :isDirectMessage="isActiveDirectMessage"
                                 :isPhone="isPhone"
                                 :isEntering="isFeedEntering"
                                 :isPreviewing="!!activeRow && !activeRow.is_member"
                                 :isJoinRefused="shell.rooms.joinOf(activeChannelId).kind === 'refused'"
                                 :facts="activeKind === 'channel' ? activeFacts : null"
                                 :campuses="campuses"
                                 :notifyMode="activeRow?.notify_mode ?? null"
                                 :editingId="editingIdIn(activeChannelId)"
                                 :editError="editErrorIn(activeChannelId)"
                                 :isEditSaving="isEditSavingIn(activeChannelId)"
                                 :landOnId="landingMessageId"
                                 :reactionHost="reactionHost"
                                 @seen="shell.seen"
                                 @markRead="shell.markRead"
                                 @firstShown="shell.firstMessageShown"
                                 @retry="onRetry"
                                 @discard="shell.sender.discard"
                                 @loadOlder="shell.loadOlder"
                                 @openThread="onOpenThread"
                                 @jump="onJump($event, false)"
                                 @messageAction="onMessageAction($event, null)" />
                    <div v-else class="chat-shell-empty">
                        {{ shell.state.phase === "starting" ? "Opening chat…" : "Choose a conversation." }}
                    </div>

                    <!-- A channel the person is previewing has the join bar in the composer's place. -->
                    <JoinBar v-if="isJoinBarShown && activeChannelId"
                             :name="activeTitle"
                             :state="shell.rooms.joinOf(activeChannelId)"
                             :announcement="shell.rooms.state.announcement"
                             :isPhone="isPhone"
                             @join="onJoin"
                             @browse="openMainView('directory')" />

                    <Composer v-else-if="activeChannelId"
                              :class="{ 'is-entering': isComposerEntering }"
                              :title="activeKind ? activeTitle : null"
                              :isChannel="activeKind === 'channel'"
                              :isPhone="isPhone"
                              :isLocked="!shell.state.isComposerOpen"
                              :heldText="held?.body ?? ''"
                              :heldBy="held"
                              :quote="conversationQuote"
                              :isQuoteOwn="isOwnQuote(conversationQuote)"
                              :emojiSource="emojiSource"
                              :mentionSource="mentionSourceFor(activeRow)"
                              :conversationKey="activeChannelId"
                              @mentionQuery="onMentionQuery(activeRow, $event)"
                              @send="shell.send"
                              @editLast="onEditLast"
                              @cancelQuote="onCancelQuote(conversationQuoteKey)"
                              @emojiPickerOpen="onEmojiPickerOpen"
                              @emojiChosen="onEmojiChosen"
                              @animationend="onComposerAnimationEnd" />
                </div>

                <!-- A full view in the conversation's place, rising in as a conversation switch does. -->
                <div v-if="mainView" class="chat-main-view" data-testid="main-view" :data-kind="mainView">
                    <ChannelDirectory v-if="mainView === 'directory'"
                                      :directory="shell.rooms.state.directory"
                                      :joins="shell.rooms.state.joins"
                                      :announcement="shell.rooms.state.announcement"
                                      :campuses="campuses"
                                      :personCampusGuid="personCampusGuid"
                                      :organizationName="organizationName"
                                      :isPhone="isPhone"
                                      @back="onBack"
                                      @close="closeMainView"
                                      @query="shell.rooms.setQuery"
                                      @clearQuery="shell.rooms.clearQuery"
                                      @campus="shell.rooms.setCampus"
                                      @show="shell.rooms.setShow"
                                      @clearFilters="shell.rooms.clearFilters"
                                      @loadMore="shell.rooms.loadMore"
                                      @retry="shell.rooms.retry"
                                      @join="shell.rooms.join"
                                      @open="openFromMainView" />

                    <!-- Its first message is drawn as a direct message is, whatever the conversation under it. -->
                    <NewMessage v-else-if="mainView === 'newdm'"
                                data-look="conversational"
                                :chosen="shell.directMessages.chosen"
                                :search="shell.directMessages.search"
                                :lookup="shell.directMessages.lookup"
                                :foundTitle="foundTitle"
                                :draft="draft"
                                :error="shell.directMessages.error"
                                :refused="shell.directMessages.refused"
                                :isPhone="isPhone"
                                :emojiSource="emojiSource"
                                @back="onBack"
                                @close="closeMainView"
                                @choose="shell.directMessages.choose"
                                @unchoose="shell.directMessages.unchoose"
                                @open="openFromMainView"
                                @send="onSendFirst"
                                @edit="shell.directMessages.edit"
                                @retry="onSendFirst(draft?.body ?? '')"
                                @discard="shell.directMessages.discardFailed"
                                @emojiPickerOpen="onEmojiPickerOpen"
                                @emojiChosen="onEmojiChosen" />
                </div>

                <!-- Centred over the conversation it reports on, so a panel open beside it never pulls a toast off it. -->
                <ErrorToast v-if="!isPhone" :errors="shell.state.errors" :notices="notices" @dismiss="shell.dismissError" @dismissNotice="onDismissNotice" />
            </section>

            <!--
                The panel column, closed until a thread or a list opens in it. It holds one panel
                at a time, each drawn in the shared panel host; what it held stays while it closes,
                so the column narrows over its content rather than over nothing.
            -->
            <aside ref="panelElement"
                   class="chat-frame-panel"
                   data-testid="frame-panel"
                   :aria-hidden="isPanelHidden ? 'true' : undefined"
                   :inert="isPanelHidden || undefined"
                   :style="isPanelGone ? goneStyle : undefined">
                <div class="chat-frame-panel-inner">
                    <ThreadsPanel v-if="shownPanel === 'threads'"
                                  :tab="threadList.tab"
                                  :rows="threadList.rows"
                                  :hasMore="threadList.hasMore"
                                  :isLoading="threadList.isLoading"
                                  :isRefreshing="threadList.isRefreshing"
                                  :error="threadList.error"
                                  :rowError="threadList.rowError"
                                  :busyRootId="threadList.busyRootId"
                                  :channelId="threadList.channelId ?? activeChannelId ?? ''"
                                  :kind="activeKind ?? 'channel'"
                                  :roomTitles="roomTitles"
                                  :roomKinds="roomKinds"
                                  :publicRooms="publicRooms"
                                  :isPhone="isPhone"
                                  :personAliasGuid="personAliasGuid"
                                  @open="openThreadFromList"
                                  @tab="onThreadsTab"
                                  @refresh="onThreadsRefresh"
                                  @follow="onFollowFromList"
                                  @loadMore="onThreadsLoadMore"
                                  @close="closePanel" />

                    <MentionsPanel v-else-if="shownPanel === 'mentions'"
                                   v-bind="shell.mentions.state.inbox"
                                   :roomTitles="roomTitles"
                                   :roomKinds="roomKinds"
                                   :publicRooms="publicRooms"
                                   :isPhone="isPhone"
                                   :personAliasGuid="personAliasGuid"
                                   @jump="onMentionOpen"
                                   @openThread="(_rootId, _channelId, messageId) => onMentionOpen(messageId)"
                                   @refresh="shell.mentions.refreshInbox"
                                   @loadOlder="shell.mentions.loadOlder"
                                   @close="closePanel" />

                    <ThreadDrawer v-else-if="shownPanel === 'thread' && drawnThread"
                                  :key="drawnThread.rootId"
                                  :root="drawnThread.root"
                                  :replies="drawnThread.replies"
                                  :pending="shell.sender.pending(drawnThread.channelId)"
                                  :sentKeys="shell.sender.sentKeys"
                                  :isFollowing="drawnThread.following"
                                  :conversationTitle="roomTitles[drawnThread.channelId] ?? ''"
                                  :isChannel="threadKind === 'channel'"
                                  :isDirectMessage="threadKind === 'person'"
                                  :isPhone="isPhone"
                                  :isFromList="threadOrigin !== null"
                                  :listTitle="threadOrigin === 'mentions' ? 'Mentions' : 'Threads'"
                                  :personAliasGuid="personAliasGuid"
                                  :hasMore="drawnThread.hasMore"
                                  :isLoading="drawnThread.isLoading"
                                  :error="drawnThread.error"
                                  :olderError="drawnThread.olderError"
                                  :landOnId="landingReplyId"
                                  :isLocked="!shell.state.isComposerOpen"
                                  :personName="personName"
                                  :personPhotoUrl="personPhotoUrl"
                                  :organizationName="organizationName"
                                  :quote="threadQuote"
                                  :isQuoteOwn="isOwnQuote(threadQuote)"
                                  :isPreviewing="isPreviewingRoom(drawnThread.channelId)"
                                  :editingId="editingIdIn(drawnThread.channelId)"
                                  :editError="editErrorIn(drawnThread.channelId)"
                                  :isEditSaving="isEditSavingIn(drawnThread.channelId)"
                                  :reactionHost="reactionHost"
                                  :emojiSource="emojiSource"
                                  :mentionSource="mentionSourceFor(threadRow)"
                                  @mentionQuery="onMentionQuery(threadRow, $event)"
                                  @close="closeThreadDrawer"
                                  @back="onThreadBack"
                                  @follow="onFollowThread"
                                  @send="onSendReply"
                                  @seen="shell.threads.seen"
                                  @loadOlder="onLoadOlderReplies"
                                  @retry="onRetry"
                                  @discard="shell.sender.discard"
                                  @cancelQuote="onCancelQuote(threadQuoteKey)"
                                  @editLast="onEditLastReply"
                                  @jump="onJump($event, true)"
                                  @messageAction="onMessageAction($event, drawnThread.rootId)"
                                  @emojiPickerOpen="onEmojiPickerOpen"
                                  @emojiChosen="onEmojiChosen" />
                </div>
            </aside>

            <Dialog :isOpen="!!confirmingDelete"
                    title="Delete this message?"
                    :body="deleteBody"
                    confirmLabel="Delete"
                    isDestructive
                    @close="onCancelDelete"
                    @confirm="onConfirmDelete">
                <template v-if="confirmingDelete" #preview>
                    <MessageBody :text="confirmingDelete.message.body ?? ''"
                                 :pieces="confirmingDelete.message.pieces ?? null"
                                 :personAliasGuid="personAliasGuid" />
                </template>
            </Dialog>

            <!-- The reaction picker, one at a time, placed beside what opened it and drawn in the chat's root. -->
            <EmojiPicker v-if="reactionPicker"
                         :key="reactionPicker.key"
                         mode="react"
                         :source="emojiSource"
                         :mine="pickerMine"
                         :anchor="reactionPicker.anchor"
                         :opener="reactionPicker.opener"
                         @react="onPickerReact"
                         @close="closeReactionPicker" />

            <!-- The profile card, one at a time, beside the author or chip that asked, once its person is read. -->
            <ProfileCard v-if="shell.rooms.state.card?.person"
                         :key="cardOpenCount"
                         :person="shell.rooms.state.card.person"
                         :campuses="campuses"
                         :anchor="cardAnchor"
                         @close="shell.rooms.closeCard"
                         @message="onCardMessage" />

            <!-- Kept mounted while the room's facts are held, so closing plays the dialog's exit. -->
            <ConversationDetails v-if="activeChannelId && activeFacts && activeKind"
                                 :key="activeChannelId"
                                 :isOpen="isDetailsOpen"
                                 :kind="activeKind"
                                 :title="activeTitle"
                                 :facts="activeFacts"
                                 :groupName="activeRow?.name ?? null"
                                 :campuses="campuses"
                                 :organizationName="organizationName"
                                 :personName="personName"
                                 :personPhotoUrl="personPhotoUrl"
                                 :leave="shell.rooms.leaveOf(activeChannelId)"
                                 :rename="shell.rooms.renameOf(activeChannelId)"
                                 :isPhone="isPhone"
                                 @close="closeDetails"
                                 @leave="onLeave"
                                 @rename="onRename" />
        </div>

        <!-- A phone shows one pane at a time, so its toasts sit over the whole block; so do those of a block with no frame. -->
        <ErrorToast v-if="isPhone || isPromptShown || isRefused" :errors="shell.state.errors" :notices="notices" @dismiss="shell.dismissError" @dismissNotice="onDismissNotice" />
    </div>
</template>

<style scoped>
/*
    Fills the Full Worksurface zone it is placed in, flush, with no card around it. The height is
    the room that page leaves under Rock's header, written out because Rock wraps a block in a
    container of its own that a percentage cannot reach through. The layout's own panel height
    takes 36px for the rest and is 29px too tall in the RockNextGen theme, which scrolls the page:
    the work surface pads 16px above and below, the empty Feature zone's grid column stands 1px
    tall, and the main content area the layout means to hide is shown by the theme's more specific
    rule with a 16px margin above and below. Both spacings are the theme's medium spacing.
*/
.chat-shell {
    position: relative;
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--top-header-height, 80px) - 4 * var(--spacing-medium, 16px) - 1px - var(--context-slicer-height, 0px));
}

.chat-frame {
    position: relative;
    display: grid;
    flex: 1;
    grid-template-rows: minmax(0, 1fr);
    grid-template-columns: 296px minmax(0, 1fr) 0px;
    min-height: 0;
    overflow: hidden;
    background: var(--chat-surface);
    transition: grid-template-columns var(--chat-t-panel) var(--chat-ease-in);
}

/* Clipped where the browser can, so a scroll into view never moves the frame itself sideways. */
@supports (overflow: clip) {
    .chat-frame {
        overflow: clip;
    }
}

.chat-frame-side {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    min-width: 0;
    min-height: 0;
}

.chat-frame-main {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--chat-surface);
}

.chat-frame[data-panel-open="true"] {
    grid-template-columns: 296px minmax(0, 1fr) 392px;
}

.chat-frame-panel {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--chat-surface);
}

/* Its dividing line only while open, so the closed column is 0px wide and not a 1px sliver. */
.chat-frame[data-panel-open="true"] .chat-frame-panel {
    border-left: 1px solid var(--chat-line);
}

/* The content keeps its full width while the column opens around it, fading in as it slides home. */
.chat-frame-panel-inner {
    width: 392px;
    height: 100%;
    opacity: 0;
    transform: translateX(var(--chat-drawer-shift));
    transition: opacity var(--chat-t-base) var(--chat-ease-state), transform var(--chat-t-panel) var(--chat-ease-in);
}

.chat-frame[data-panel-open="true"] .chat-frame-panel-inner {
    opacity: 1;
    transform: none;
}

/* A phone: one pane fills the frame and the other waits beside it, the list a little to the left. */
.chat-shell[data-phone="true"] .chat-frame {
    display: block;
}

.chat-shell[data-phone="true"] .chat-frame-side,
.chat-shell[data-phone="true"] .chat-frame-main,
.chat-shell[data-phone="true"] .chat-frame-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

/* Only a move the person made slides; the conversation a link opens is simply there. */
.chat-shell[data-phone="true"] .chat-frame.is-pane-motion-on .chat-frame-side,
.chat-shell[data-phone="true"] .chat-frame.is-pane-motion-on .chat-frame-main,
.chat-shell[data-phone="true"] .chat-frame.is-pane-motion-on .chat-frame-panel {
    transition: transform var(--chat-t-panel) var(--chat-ease-in), opacity var(--chat-t-base) var(--chat-ease-state);
}

/* The panel is a third pane over the conversation, waiting off to the right until it opens. */
.chat-shell[data-phone="true"] .chat-frame-panel {
    z-index: 8;
    border-left: 0;
    transform: translateX(100%);
}

.chat-shell[data-phone="true"] .chat-frame[data-pane="panel"] .chat-frame-panel {
    transform: none;
}

.chat-shell[data-phone="true"] .chat-frame-panel-inner {
    width: 100%;
}

.chat-shell[data-phone="true"] .chat-frame[data-pane="conversation"] .chat-frame-side,
.chat-shell[data-phone="true"] .chat-frame[data-pane="panel"] .chat-frame-side {
    pointer-events: none;
    opacity: 0;
    transform: translateX(-24%);
}

.chat-shell[data-phone="true"] .chat-frame[data-pane="list"] .chat-frame-main {
    pointer-events: none;
    transform: translateX(100%);
}

/* No box of its own: the header, the feed and the composer stay the column's own flex items. */
.chat-frame-under {
    display: contents;
}

/* A full view over the conversation, which stays laid out and inert underneath. */
.chat-main-view {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--chat-surface);
    animation: chat-view-in var(--chat-d-view) var(--chat-ease-in);
}

@keyframes chat-view-in {
    from {
        opacity: 0;
        transform: translateY(6px);
    }
}

/* After a join settles, the composer takes the join bar's place, rising in as a message does. */
.chat-composer.is-entering {
    animation: chat-composer-enter var(--chat-t-msg) var(--chat-ease-in);
}

@keyframes chat-composer-enter {
    from {
        opacity: 0;
        transform: translateY(6px);
    }
}

/* Reduced motion: the composer only fades back in. */
@media (prefers-reduced-motion: reduce) {
    .chat-composer.is-entering {
        animation-name: chat-crossfade;
    }
}

.chat-shell-empty {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    color: var(--chat-muted);
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, onMounted, ref, shallowRef, watch } from "vue";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { ChatBirthdateResultBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatBirthdateResultBag";
    import { ChatShellInitializationBox } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatShellInitializationBox";
    import { ChatShellSessionBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatShellSessionBag";
    import { DatePartsPickerValueBag } from "@Obsidian/ViewModels/Controls/datePartsPickerValueBag";
    import { birthdateOutcome, isBirthdatePromptShown } from "./ChatShell/birthdate.partial";
    import { createBrowserShellBuilder } from "./ChatShell/browserShell.partial";
    import BirthdatePrompt from "./ChatShell/components/birthdatePrompt.partial.obs";
    import ChannelDirectory from "./ChatShell/components/channelDirectory.partial.obs";
    import ChannelSidebar from "./ChatShell/components/channelSidebar.partial.obs";
    import ChatHeader, { HeaderRoomKind } from "./ChatShell/components/chatHeader.partial.obs";
    import Composer from "./ChatShell/components/composer.partial.obs";
    import ConversationDetails from "./ChatShell/components/conversationDetails.partial.obs";
    import { DirectMessageDraft } from "./ChatShell/composables/useDirectMessage.partial";
    import EmojiPicker from "./ChatShell/components/emojiPicker.partial.obs";
    import { MentionPickerSource } from "./ChatShell/components/mentionPicker.partial.obs";
    import MentionsPanel from "./ChatShell/components/mentionsPanel.partial.obs";
    import ErrorToast, { ToastNotice } from "./ChatShell/components/errorToast.partial.obs";
    import JoinBar from "./ChatShell/components/joinBar.partial.obs";
    import MessageBody from "./ChatShell/components/messageBody.partial.obs";
    import MessageFeed from "./ChatShell/components/messageFeed.partial.obs";
    import NewMessage from "./ChatShell/components/newMessage.partial.obs";
    import ProfileCard from "./ChatShell/components/profileCard.partial.obs";
    import ThreadDrawer from "./ChatShell/components/threadDrawer.partial.obs";
    import ThreadsPanel from "./ChatShell/components/threadsPanel.partial.obs";
    import { MessageActionRequest, MessageActionsState, quoteKey } from "./ChatShell/composables/useMessageActions.partial";
    import { useFrame } from "./ChatShell/composables/useFrame.partial";
    import { useReactionPicker } from "./ChatShell/composables/useReactionPicker.partial";
    import { useJump } from "./ChatShell/composables/useJump.partial";
    import { followNotice, ThreadListState, ThreadListTab } from "./ChatShell/composables/useThreads.partial";
    import { FeedLayout, isOwnMessage } from "./ChatShell/feedLayout.partial";
    import { refusalMessage } from "./ChatShell/shell.partial";
    import { isTwoPersonDirectMessage, joinNames, roomTitle } from "./ChatShell/stores/channelStore.partial";
    import { ChannelFacts, ChatError, PersonProfile, SidebarRow, TimelineMessage } from "./ChatShell/types.partial";
    import { ChatCampusBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatCampusBag";
    import { applyChatTheme } from "./ChatShell/ui/brand.partial";
    import Dialog from "./ChatShell/ui/dialog.partial.obs";

    // #region Types

    /** What the push worker posts to a window of the site, in the worker's own names. */
    /* eslint-disable-next-line @typescript-eslint/naming-convention */
    type WorkerMessage = { type?: string, channel_id?: string, root_id?: string, message_id?: string };

    // #endregion Types

    const config = useConfigurationValues<ChatShellInitializationBox>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const personAliasGuid = ref(config.session?.personAliasGuid ?? "");

    /** The reader's own name and photo, for their messages the platform has sent no name with yet. */
    const personName = ref(fullName(config.session));
    const personPhotoUrl = ref(config.session?.personPhotoUrl ?? null);

    const organizationName = config.organizationName ?? "";

    /** The church's campuses, which name every campus a room or a person carries. */
    const campuses: ChatCampusBag[] = config.campuses ?? [];

    /** The person's own campus, which the church's campus note in Browse channels names. */
    const personCampusGuid = ref(config.session?.personCampusGuid ?? null);

    const buildShell = createBrowserShellBuilder({
        linkedChannelId: config.channelGuid ?? null,
        areSharedChannelsFilteredByCampus: config.areSharedChannelsFilteredByCampus ?? false,
        // one toast per code, the newest kept, so a second copy or delete restarts its toast
        notify: notice => {
            notices.value = [...notices.value.filter(n => n.code !== notice.code), notice];
        },
        invokeBlockAction,
        // Called only after the frame below is set up, so the landings they reach are there.
        mentionViews: {
            land: messageId => landOnMention(messageId),
            openThread: (channelId, rootId, messageId) => openThreadFromMentions(channelId, rootId, messageId)
        }
    });

    // Replaced, not reloaded, when a birthdate lets the person in: the save answers with the
    // session a fresh page load would have had.
    const shell = shallowRef(buildShell(config.session ?? {}));

    const birthdateMessage = ref<string | null>(null);
    const isSavingBirthdate = ref(false);

    /** Whether the open conversation's details dialog is open. */
    const isDetailsOpen = ref(false);

    /** What asked for the profile card, which it is placed beside, and a count that draws each card afresh. */
    const cardAnchor = shallowRef<HTMLElement | null>(null);
    const cardOpenCount = ref(0);

    /** Toasts that are not failures, such as being back online after an outage. */
    const notices = ref<ToastNotice[]>([]);

    const rootElement = ref<HTMLElement>();

    // The block's own width, not the window's or a container query's, since the oldest Safari Rock
    // supports has no container queries and a narrow zone of a wide window is still narrow.
    let resizeObserver: ResizeObserver | null = null;

    /**
     * Whether the open conversation replaced another, so its feed rises into view. The first one
     * the page draws is simply there.
     */
    const isFeedEntering = ref(false);

    /** Whether the composer is rising into the join bar's place after a join settled. */
    const isComposerEntering = ref(false);

    /** The one reaction picker open at a time, and what every message row and emoji picker reads of the reactions. */
    const { reactionPicker, reactionHost, emojiSource, pickerMine, openReactionPicker, closeReactionPicker, onPickerReact } = useReactionPicker(shell, organizationName);

    // #endregion Values

    // #region Computed Values

    const activeChannelId = computed((): string | null => shell.value.state.activeChannelId);

    const draft = computed((): DirectMessageDraft | null => shell.value.directMessages.draft);

    // Created here rather than with the values, since they read the open conversation above. The
    // frame's landing is the jump's, made just after it, so the frame reaches it only once called.
    const {
        isPhone, isPaneMotionOn, pane, isSidebarHidden, isConversationHidden, isPanelHidden, isSidebarGone, isConversationGone, isPanelGone, goneStyle,
        panelKind, shownPanel, panelElement, drawnThread, threadOrigin, threadOpenCount,
        onResize, onSelect, onBack, onListPanel, openThreadFromList, onOpenThread, onThreadBack, onMentionOpen,
        openThreadFromMentions, openFromTap, openThreadDrawer, closeThreadDrawer, closePanel,
        mainView, openMainView, closeMainView, openFromMainView
    } = useFrame({
        shell,
        activeChannelId,
        rootElement,
        linkedReply: config.channelGuid && config.threadRootId
            ? { channelId: config.channelGuid.toLowerCase(), rootId: config.threadRootId, messageId: config.messageId ?? null }
            : null,
        landOnReply: (landing, origin) => landOnReply(landing, origin),
        forgetReplyLanding: () => {
            landingReplyId.value = null;
        }
    });

    const { landingReplyId, landingMessageId, landOnReply, onJump } = useJump({
        shell,
        activeChannelId,
        isPhone,
        threadOpenCount,
        openThreadDrawer,
        closeThreadDrawer
    });

    /** The unread mentions on the app icon, from the sidebar, so reading a mention clears it. */
    const mentionBadge = computed((): number => shell.value.mentionBadge());

    /** Whether the open channel's catch-up failed and is trying again, so messages may be missing. */
    const isActiveBehind = computed((): boolean => !!activeChannelId.value && shell.value.timelines.state(activeChannelId.value).isBehind);

    const isPromptShown = computed((): boolean => isBirthdatePromptShown(shell.value.state.phase, shell.value.state.gate));

    const isRefused = computed((): boolean => shell.value.state.phase === "refused" || shell.value.state.phase === "failed");

    const refusal = computed((): string => refusalMessage(shell.value.state.phase, shell.value.state.gate));

    /** Text Rock refused earlier, for the box of the conversation the same people now share. */
    const held = computed((): { body: string } | null => shell.value.directMessages.held);

    /** The sidebar row of the open conversation, which carries everything the header draws. */
    const activeRow = computed((): SidebarRow | null => shell.value.channels.rows.find(r => r.channel_id === shell.value.state.activeChannelId) ?? null);

    /** What chat_get_channel last answered about the open conversation, or null before it lands. */
    const activeFacts = computed((): ChannelFacts | null => activeChannelId.value ? shell.value.rooms.factsOf(activeChannelId.value) : null);

    /**
     * Whether the open channel is one the person is not in, where the join bar stands in the
     * composer's place. A join stays here while pending, until the sidebar shows them a member.
     */
    const isJoinBarShown = computed((): boolean => activeKind.value === "channel" && !!activeRow.value && !activeRow.value.is_member);

    /** A conversation with one other person, where a name over each bubble would only repeat the header. */
    const isActiveDirectMessage = computed((): boolean => !!activeRow.value && isTwoPersonDirectMessage(activeRow.value));

    /** The other people of the open direct message, by the names the sidebar shows. */
    const activePeople = computed((): string[] => activeRow.value?.dm_names ?? []);

    const activeKind = computed((): HeaderRoomKind | null => {
        if (!activeRow.value) {
            return null;
        }

        if (activeRow.value.channel_type !== "dm") {
            return "channel";
        }

        return isActiveDirectMessage.value ? "person" : "group";
    });

    const activeTitle = computed((): string => {
        if (activeRow.value?.name) {
            return activeRow.value.name;
        }

        // A group the platform names only its first few people for says how many more there are.
        const others = activeRow.value?.dm_other_count ?? activePeople.value.length;
        return joinNames(activePeople.value, others - activePeople.value.length);
    });

    /**
     * The look the open conversation is drawn in, by its kind alone: a channel in Community's flat
     * rows, a direct message in Conversational's bubbles.
     */
    const look = computed((): FeedLayout | null => {
        if (!activeKind.value) {
            return null;
        }

        return activeKind.value === "channel" ? "community" : "conversational";
    });

    /**
     * The header's line until the room's facts are read, which the header then takes its subtitle
     * from: an unnamed group's head count.
     */
    const activeSubtitle = computed((): string | null => {
        if (activeKind.value !== "group") {
            return null;
        }

        // The platform counts a room's people only when it has no name, so a named group arrives
        // with 0 and has no count to show until the member count gets a field of its own.
        const others = activeRow.value?.dm_other_count ?? activePeople.value.length;
        if (others < 1) {
            return null;
        }

        // A group always holds the reader and at least one other, so the count is never singular.
        return `${others + 1} people`;
    });

    /** The threads list the panel draws, as the shell's threads hold it. */
    const threadList = computed((): ThreadListState => shell.value.threads.state.list);

    /** Each conversation's title by channel id, as the header writes it, for the rooms the threads list names. */
    const roomTitles = computed((): Record<string, string> => {
        const titles: Record<string, string> = {};
        for (const row of shell.value.channels.rows) {
            titles[row.channel_id] = roomTitle(row);
        }

        return titles;
    });

    /** Each conversation's kind by channel id, which picks the room's icon on the All tab. */
    const roomKinds = computed((): Record<string, HeaderRoomKind> => {
        const kinds: Record<string, HeaderRoomKind> = {};
        for (const row of shell.value.channels.rows) {
            kinds[row.channel_id] = row.channel_type !== "dm" ? "channel" : isTwoPersonDirectMessage(row) ? "person" : "group";
        }

        return kinds;
    });

    /** Whether each channel is public, which draws its hash rather than its lock on the All tab. */
    const publicRooms = computed((): Record<string, boolean> => {
        const isPublic: Record<string, boolean> = {};
        for (const row of shell.value.channels.rows) {
            isPublic[row.channel_id] = row.is_public;
        }

        return isPublic;
    });

    /** The sidebar row of the open thread's conversation, which says whether its composer offers the @ picker. */
    const threadRow = computed((): SidebarRow | null => drawnThread.value ? shell.value.channels.rows.find(r => r.channel_id === drawnThread.value?.channelId) ?? null : null);

    /** The open thread's conversation kind, which picks its look and its composer's foot. */
    const threadKind = computed((): HeaderRoomKind | null => drawnThread.value ? roomKinds.value[drawnThread.value.channelId] ?? null : null);

    /** Where the conversation composer's quote waits. */
    const conversationQuoteKey = computed((): string | null => activeChannelId.value ? quoteKey(activeChannelId.value) : null);

    /** Where the open thread's quote waits, apart from its conversation's. */
    const threadQuoteKey = computed((): string | null => drawnThread.value ? quoteKey(drawnThread.value.channelId, drawnThread.value.rootId) : null);

    const conversationQuote = computed((): TimelineMessage | null => quoteAt(conversationQuoteKey.value));

    const threadQuote = computed((): TimelineMessage | null => quoteAt(threadQuoteKey.value));

    /** The message the delete confirm is open for, or null. */
    const confirmingDelete = computed((): MessageActionsState["confirmingDelete"] => shell.value.messageActions.state.confirmingDelete);

    /** Where the deleted message is removed from: a channel by its name, written with no "#", or this conversation. */
    const deleteBody = computed((): string => {
        const channelId = confirmingDelete.value?.channelId;
        const where = channelId && roomKinds.value[channelId] === "channel" ? roomTitles.value[channelId] : "this conversation";
        return `It will be removed for everyone in ${where}. You can't undo this.`;
    });

    /**
     * The title New message's found strip names: the conversation's as the sidebar writes it, or
     * the people chosen when it is not in the sidebar.
     */
    const foundTitle = computed((): string | null => {
        const { lookup, chosen } = shell.value.directMessages;
        if (!lookup.channelId) {
            return null;
        }

        return roomTitles.value[lookup.channelId] ?? joinNames(chosen.map(person => `${person.nick_name} ${person.last_name}`), 0);
    });

    // #endregion Computed Values

    // #region Event Handlers

    /** New message's send: to the conversation found, or the first message of a new one. */
    function onSendFirst(body: string): void {
        isPaneMotionOn.value = true;
        void shell.value.directMessages.sendFirst(body);
    }

    /**
     * The card's Message: the conversation the two already have, else New message with the person
     * chosen. The card goes first, so it never stands over what opens.
     */
    function onCardMessage(person: PersonProfile): void {
        shell.value.rooms.closeCard();
        if (person.dm_channel_id) {
            void openFromMainView(person.dm_channel_id);
            return;
        }

        void openMainView("newdm", [{ person_alias_guid: person.person_alias_guid, nick_name: person.nick_name, last_name: person.last_name, avatar_url: person.avatar_url }]);
    }

    function onLeave(): void {
        if (activeChannelId.value) {
            void shell.value.rooms.leave(activeChannelId.value);
        }
    }

    function onRename(name: string): void {
        if (activeChannelId.value) {
            void shell.value.rooms.rename(activeChannelId.value, name);
        }
    }

    /**
     * Closes the details dialog. Focus goes to the title button, since the phone's overflow item
     * that may have opened it has left with its menu.
     */
    function closeDetails(): void {
        isDetailsOpen.value = false;
        void nextTick(() => rootElement.value?.querySelector<HTMLElement>("[data-testid='frame-main'] [data-testid='header-details']")?.focus());
    }

    function onJoin(): void {
        if (activeChannelId.value) {
            void shell.value.rooms.join(activeChannelId.value);
        }
    }

    /** The composer's own rise has ended; a strip inside it ending says nothing about the composer. */
    function onComposerAnimationEnd(event: AnimationEvent): void {
        if (event.target === event.currentTarget) {
            isComposerEntering.value = false;
        }
    }

    /** Says the outage is over, once, however many times the connection came and went. */
    function onBackOnline(): void {
        if (!notices.value.some(n => n.code === "back-online")) {
            notices.value.push({ code: "back-online", text: "You're back online", icon: "check" });
        }
    }

    function onDismissNotice(notice: ToastNotice): void {
        notices.value = notices.value.filter(n => n.code !== notice.code);
    }

    function onThreadsTab(tab: ThreadListTab): void {
        // A thread opened from the All tab may have moved the conversation, so the list's own
        // tab is opened for the conversation open now.
        if (tab === "channel" && activeChannelId.value && threadList.value.channelId !== activeChannelId.value) {
            void shell.value.threads.openList(activeChannelId.value, tab);
            return;
        }

        void shell.value.threads.switchTab(tab);
    }

    function onThreadsRefresh(): void {
        void shell.value.threads.refresh();
    }

    function onThreadsLoadMore(): void {
        void shell.value.threads.loadMore();
    }

    /** A follow change from a row; the toast says what changed once the platform took it, and a refusal stays on the row. */
    async function onFollowFromList(rootId: number, isFollowing: boolean): Promise<void> {
        if (!await shell.value.threads.follow(rootId, isFollowing)) {
            return;
        }

        // one follow toast at a time: a quick follow then unfollow shows only where it ended
        const notice = followNotice(isFollowing);
        notices.value = [...notices.value.filter(n => n.code !== "thread-followed" && n.code !== "thread-unfollowed"), notice];
    }

    /** A composer's @ query, searched among the people of the conversation it is in; null closes the search. */
    function onMentionQuery(row: SidebarRow | null, query: string | null): void {
        if (row && query !== null) {
            shell.value.mentions.search(row, query);
        }
        else {
            shell.value.mentions.closeSearch();
        }
    }

    /** The drawer's toggle: the toast says what changed once the platform took it, as the list's does. */
    function onFollowThread(isFollowing: boolean): void {
        if (drawnThread.value) {
            void onFollowFromList(drawnThread.value.rootId, isFollowing);
        }
    }

    function onSendReply(body: string, isShownInChannel: boolean): void {
        if (drawnThread.value) {
            void shell.value.sendReply(drawnThread.value.rootId, body, isShownInChannel);
        }
    }

    function onLoadOlderReplies(): void {
        void shell.value.threads.loadOlderReplies();
    }

    function onTurnOnPush(): void {
        void shell.value.turnOnPush();
    }

    /**
     * The push worker asks whether a push's channel is on screen, so it can leave the banner out,
     * and after a tap tells this window which channel to open. A reply's push names its root: the
     * ask is then about the thread alone, since a reply kept to its thread is seen only in the
     * drawer, and the tap opens the thread at the reply over its conversation.
     */
    function onWorkerMessage(event: MessageEvent): void {
        const message = (event.data ?? {}) as WorkerMessage;
        const rootId = messageIdOf(message.root_id);

        if (message.type === "chat.push.is-open") {
            const isOpen = rootId !== null
                ? shell.value.isThreadOnScreen(rootId)
                : !!message.channel_id && shell.value.isChannelOnScreen(message.channel_id);
            event.ports[0]?.postMessage({ open: isOpen });
        }
        else if (message.type === "chat.push.open" && message.channel_id) {
            openFromTap(message.channel_id.toLowerCase(), rootId, messageIdOf(message.message_id));
        }
    }

    /** Up in the empty conversation composer: the newest message the person could edit opens in place. */
    function onEditLast(): void {
        if (activeChannelId.value) {
            shell.value.messageActions.startEditNewest(activeChannelId.value);
        }
    }

    /** Up in the empty thread composer: the newest of the person's replies in that thread opens in place. */
    function onEditLastReply(): void {
        const thread = drawnThread.value;
        if (thread) {
            shell.value.messageActions.startEditNewest(thread.channelId, thread.rootId);
        }
    }

    function onCancelQuote(key: string | null): void {
        if (key) {
            shell.value.messageActions.cancelQuote(key);
        }
    }

    /**
     * A message's bar or menu asked for an action, in the conversation or, with its root, the open
     * thread. A quote waits in the composer of the place it was asked in, which takes focus.
     */
    function onMessageAction(request: MessageActionRequest, rootId: number | null): void {
        const channelId = rootId === null ? activeChannelId.value : drawnThread.value?.channelId ?? null;
        if (!channelId) {
            if (request.kind === "server") {
                request.onSettled?.();
            }
            return;
        }

        const actions = shell.value.messageActions;
        switch (request.kind) {
            case "quote":
                actions.startQuote(quoteKey(channelId, rootId), request.message);
                focusComposerIn(rootId);
                break;

            case "edit":
                actions.startEdit(channelId, request.message.id);
                break;

            // A closed editor hands focus back to the composer it was opened beside, so typing
            // carries on there; a refused save keeps the editor and its focus.
            case "saveEdit":
                void actions.saveEdit(request.body).then(isSaved => {
                    if (isSaved) {
                        focusComposerIn(rootId);
                    }
                });
                break;

            case "cancelEdit":
                actions.cancelEdit();
                focusComposerIn(rootId);
                break;

            case "copy":
                void actions.copy(request.message);
                break;

            case "delete":
                actions.askDelete(channelId, request.message);
                break;

            case "server":
                void actions.runAction(channelId, request.message.id, request.action).finally(() => request.onSettled?.());
                break;

            case "react":
                void shell.value.reactions.toggleCode(channelId, request.message.id, request.code);
                break;

            case "openPicker":
                openReactionPicker(channelId, request.message, request.anchor, request.opener);
                break;

            // the person is read for the room the author or chip was pressed in
            case "person":
                cardAnchor.value = request.anchor;
                cardOpenCount.value++;
                shell.value.rooms.openCard(request.personAliasGuid, channelId);
                break;
        }
    }

    /** A composer's picker opened: its categories are fetched once for the page. */
    function onEmojiPickerOpen(): void {
        void shell.value.reactions.loadCatalog();
    }

    function onEmojiChosen(code: string): void {
        shell.value.reactions.recordRecent(code);
    }

    function onCancelDelete(): void {
        const messageId = confirmingDelete.value?.message.id ?? null;
        shell.value.messageActions.cancelDelete();
        refocusMessage(messageId);
    }

    function onConfirmDelete(): void {
        const messageId = confirmingDelete.value?.message.id ?? null;
        void shell.value.messageActions.confirmDelete();
        refocusMessage(messageId);
    }

    function onRetry(localId: string): void {
        void shell.value.sender.retry(localId);
    }

    async function onSaveBirthdate(birthDate: DatePartsPickerValueBag): Promise<void> {
        isSavingBirthdate.value = true;
        const result = await invokeBlockAction<ChatBirthdateResultBag>("SaveBirthdate", { birthDate });
        isSavingBirthdate.value = false;

        const outcome = birthdateOutcome({ isSuccess: result.isSuccess, statusCode: result.statusCode, data: result.data });

        if (outcome.kind === "retry") {
            birthdateMessage.value = outcome.message;
            return;
        }

        birthdateMessage.value = null;

        if (outcome.kind === "refused") {
            shell.value.state.gate = outcome.gate;
            return;
        }

        await shell.value.stop();
        personAliasGuid.value = outcome.session.personAliasGuid ?? "";
        personName.value = fullName(outcome.session);
        personPhotoUrl.value = outcome.session.personPhotoUrl ?? null;
        personCampusGuid.value = outcome.session.personCampusGuid ?? null;
        shell.value = buildShell(outcome.session);
        void shell.value.start();
    }

    // #endregion Event Handlers

    // #region Functions

    /** The message open in the editor when it belongs to a conversation, else null. */
    function editingIdIn(channelId: string | null): number | null {
        const editing = shell.value.messageActions.state.editing;
        return editing && editing.channelId === channelId ? editing.messageId : null;
    }

    /** The refusal the open editor's last save met, when the editor belongs to a conversation. */
    function editErrorIn(channelId: string | null): ChatError | null {
        const editing = shell.value.messageActions.state.editing;
        return editing && editing.channelId === channelId ? editing.error : null;
    }

    /** Whether the open editor's save is out, when the editor belongs to a conversation. */
    function isEditSavingIn(channelId: string | null): boolean {
        const editing = shell.value.messageActions.state.editing;
        return !!editing && editing.channelId === channelId && editing.isSaving;
    }

    /** Focuses the composer of the conversation, or of the thread drawer for a root, once it is drawn. */
    function focusComposerIn(rootId: number | null): void {
        void nextTick(() => {
            const place = rootId === null ? rootElement.value?.querySelector("[data-testid='frame-main']") : panelElement.value;
            place?.querySelector<HTMLElement>("[data-testid='composer-input']")?.focus();
        });
    }

    /** Whether the person is reading a channel they have not joined, where they cannot act on its messages. */
    function isPreviewingRoom(channelId: string): boolean {
        const row = shell.value.channels.rows.find(r => r.channel_id === channelId);
        return !!row && !row.is_member;
    }

    /**
     * The dialog gives focus back to the More button that opened it, but that button leaves with its
     * bar, at once when focus moved into the dialog, or once a mouse's pointer has gone from the
     * message, so focus goes to the message itself instead. Focus on the dialog's own buttons or on
     * a message's bar is not kept: the dialog stays on the page while it fades out, the bar may
     * leave a moment later, and either leaving would drop focus to the page.
     */
    function refocusMessage(messageId: number | null): void {
        void nextTick(() => {
            const root = rootElement.value;
            const active = document.activeElement;
            const isFocusKept = !!active && root?.contains(active) && !active.closest("[role='dialog'], [role='toolbar']");
            if (messageId === null || !root || isFocusKept) {
                return;
            }

            root.querySelector<HTMLElement>(`[data-message-id='${messageId}'], [data-reply-id='${messageId}']`)?.focus({ preventScroll: true });
        });
    }

    /**
     * What a composer's @ picker lists in a conversation: the people found for the newest query,
     * and @all where the room's right and the query offer it; with no room, none.
     */
    function mentionSourceFor(row: SidebarRow | null): MentionPickerSource | null {
        const picker = shell.value.mentions.state.picker;
        return row
            ? { canMention: row.can_mention, people: picker.people, isAllOffered: picker.isAllOffered, isAwaitingAnswer: picker.isAwaitingAnswer, isAwaitingFirstAnswer: picker.isAwaitingFirstAnswer }
            : null;
    }

    /** Lands on a mention in the open conversation, again even when it was the last landed on. */
    function landOnMention(messageId: number): void {
        landingMessageId.value = null;
        void nextTick(() => {
            landingMessageId.value = messageId;
        });
    }

    /** The message quoted under a key, if any. */
    function quoteAt(key: string | null): TimelineMessage | null {
        return key ? shell.value.messageActions.state.quotes[key] ?? null : null;
    }

    /** Whether a quote is the person's own, under any of their aliases when the page said so. */
    function isOwnQuote(quote: TimelineMessage | null): boolean {
        return !!quote && isOwnMessage(quote, personAliasGuid.value);
    }

    /** A message id the worker posted as a string, or null when it is not one. */
    function messageIdOf(value: string | undefined): number | null {
        const id = Number(value);
        return value && Number.isSafeInteger(id) && id > 0 ? id : null;
    }

    /** The person's name as the chat shows it, from the session Rock opened. */
    function fullName(session: ChatShellSessionBag | null | undefined): string {
        return [session?.personNickName, session?.personLastName].filter(part => !!part).join(" ");
    }

    // #endregion Functions

    // #region Watchers

    // Before the new feed mounts, which reads it once.
    watch(activeChannelId, (now, before) => {
        isFeedEntering.value = !!now && !!before && now !== before;
    });

    // The join bar gives way to the composer in the same channel once the join settles, and the
    // composer rises into its place; one opened another way is simply there. Focus in the bar
    // goes with it to the composer, or on a phone, where a focused composer would raise the
    // keyboard unasked, to the conversation's title; focus anywhere else is the person's and stays.
    watch([isJoinBarShown, activeChannelId], ([isShown, channelId], [wasShown, wasChannelId]) => {
        isComposerEntering.value = wasShown && !isShown && channelId === wasChannelId;
        const bar = rootElement.value?.querySelector("[data-testid='frame-main'] [data-testid='join-bar']");
        if (!isComposerEntering.value || !bar?.contains(document.activeElement)) {
            return;
        }

        void nextTick(() => {
            const main = rootElement.value?.querySelector("[data-testid='frame-main']");
            main?.querySelector<HTMLElement>(isPhone.value ? "[data-header-focus]" : "[data-testid='composer-input']")?.focus();
        });
    });

    // From the first sidebar the page loads, a count of none included, so a badge a mention push
    // left behind is cleared once the person has read it.
    watch([mentionBadge, (): string => shell.value.state.phase], ([count, phase]) => {
        if (phase !== "ready") {
            return;
        }

        // Only where the site is installed as an app does the browser draw it; elsewhere a no-op.
        const badging = navigator as Navigator & { setAppBadge?: (count?: number) => Promise<void>, clearAppBadge?: () => Promise<void> };
        const done = count > 0 ? badging.setAppBadge?.(count) : badging.clearAppBadge?.();
        void done?.catch(() => undefined);
    });

    // A picker or a card belongs to a message on screen, so another conversation or a full view
    // over it closes them; so are the details, which belong to the conversation.
    watch([activeChannelId, mainView], () => {
        closeReactionPicker();
        if (shell.value.rooms.state.card) {
            shell.value.rooms.closeCard();
        }
        isDetailsOpen.value = false;
    });

    // Once the person has left, the room's details have nothing left to show.
    watch(() => activeChannelId.value ? shell.value.rooms.leaveOf(activeChannelId.value).kind : null, kind => {
        if (kind === "left" && isDetailsOpen.value) {
            closeDetails();
        }
    });

    // The panel column keeps drawing a closing drawer while it narrows, so a picker opened from
    // the drawer would float over it, beside a message going away; the drawer's closing closes it.
    watch(panelKind, () => {
        const anchor = reactionPicker.value?.anchor;
        if (anchor && panelElement.value?.contains(anchor)) {
            closeReactionPicker();
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(() => {
        // Once per load: the church color and whether the page's Rock theme can follow the system into dark.
        if (rootElement.value) {
            applyChatTheme(rootElement.value);

            if (typeof ResizeObserver !== "undefined") {
                resizeObserver = new ResizeObserver(onResize);
                resizeObserver.observe(rootElement.value);
            }
        }

        navigator.serviceWorker?.addEventListener("message", onWorkerMessage);
        void shell.value.start();
    });

    onBeforeUnmount(() => {
        resizeObserver?.disconnect();
        navigator.serviceWorker?.removeEventListener("message", onWorkerMessage);
        void shell.value.stop();
    });

    // #endregion Lifecycle Hooks
</script>
