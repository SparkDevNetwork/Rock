<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <PanelHost title="Members"
               :subtitle="subtitle"
               :isPhone="isPhone"
               :entranceKeys="entranceKeys"
               @close="emit('close')">
        <template v-if="!refusal" #top>
            <div class="chat-mb-top">
                <label class="chat-mb-search">
                    <Icon name="search" size="sm" />
                    <input ref="filterElement"
                           type="search"
                           placeholder="Filter members"
                           aria-label="Filter members"
                           autocomplete="off"
                           spellcheck="false"
                           data-testid="members-filter"
                           :value="query"
                           :data-autofocus="isPhone ? undefined : ''"
                           @input="onInput"
                           @keydown="onFilterKeydown" />
                    <button v-if="query"
                            type="button"
                            class="chat-mb-clear"
                            aria-label="Clear filter"
                            data-testid="members-clear"
                            @click="onClear">
                        <Icon name="x" size="xs" />
                    </button>
                </label>
            </div>
        </template>

        <div ref="listElement"
             data-testid="members-panel"
             :class="{ 'is-instant': hover.isInstant.value }"
             :aria-busy="isLoading ? 'true' : 'false'"
             @pointerover="onPointerOver"
             @pointerleave="onPointerLeave">
            <div v-if="refusal === 'not_member'" class="chat-mb-state" data-testid="members-state" data-state="not_member">
                <span class="chat-mb-state-ic" aria-hidden="true"><Icon name="users" /></span>
                <h4>Join to see who's here</h4>
                <p>Members of {{ channelName }} can see its member list.</p>
            </div>

            <div v-else-if="refusal === 'no_roster_right'" class="chat-mb-state" data-testid="members-state" data-state="no_roster_right">
                <span class="chat-mb-state-ic" aria-hidden="true"><Icon name="eye-off" /></span>
                <h4>Only leaders can see who's here</h4>
                <p>{{ channelName }} keeps its member list private. You can still message people you know.</p>
            </div>

            <div v-else-if="error" class="chat-mb-state" data-testid="members-state" data-state="error">
                <span class="chat-mb-state-ic" aria-hidden="true"><Icon name="wifi-off" /></span>
                <h4>Couldn't load members</h4>
                <p>Check your connection, then try again.</p>
                <button type="button" class="chat-ls-btn" data-testid="members-retry" @click="emit('retry')"><Icon name="refresh" size="xs" />Try again</button>
            </div>

            <div v-else-if="isLoading" class="chat-mb-list">
                <span class="chat-sr-only">Loading members</span>
                <div v-for="width in skeletonWidths" :key="width" class="chat-mb-skel" aria-hidden="true" data-testid="member-skeleton">
                    <i class="chat-skeleton chat-mb-skel-c"></i>
                    <span class="chat-mb-skel-l"><i class="chat-skeleton" :style="{ width: `${width}%` }"></i><i class="chat-skeleton"></i></span>
                </div>
            </div>

            <div v-else class="chat-mb-list">
                <p v-if="searchStatus === 'failed'" class="chat-mb-hint is-error" data-testid="members-hint">
                    <Icon name="alert" size="xs" />Couldn't search right now.
                    <button type="button" class="chat-mb-link" data-testid="members-search-retry" @click="emit('retrySearch')">Try again</button>
                </p>
                <p v-else-if="searchStatus" class="chat-mb-hint" role="status" data-testid="members-hint">
                    <template v-if="searchStatus === 'searching'"><span class="chat-spinner" aria-hidden="true"></span>Searching everyone in {{ channelName }}</template>
                    <template v-else><Icon name="search" size="xs" />{{ foundLine }}</template>
                </p>

                <section v-for="section in sections" :key="section.title" :aria-label="section.title">
                    <h4 class="chat-mb-sec" data-testid="members-section">{{ section.title }}<span v-if="section.count !== null" data-testid="members-section-count">{{ section.count }}</span></h4>
                    <!-- A removed row collapses as it leaves. -->
                    <TransitionGroup tag="ul"
                                     class="chat-mb-rows"
                                     :class="{ 'is-phone': isPhone }"
                                     role="list"
                                     leave-active-class="is-leaving"
                                     @beforeLeave="onRowBeforeLeave">
                        <li v-for="row in section.rows"
                            :key="row.guid"
                            class="chat-mb-row chat-enter"
                            :class="{ 'is-busy': row.isRemoving, 'is-hot': hover.isShown.value && hover.shownKey.value === row.guid }"
                            :data-hot-id="row.guid"
                            :style="{ '--chat-enter-i': entranceOrder.get(row.guid) }"
                            data-testid="member-row">
                            <button type="button"
                                    class="chat-mb-who"
                                    data-testid="member-who"
                                    :data-person="row.guid"
                                    :aria-label="row.label"
                                    @click="emit('person', row.guid)">
                                <Avatar :people="[{ name: row.name, photoUrl: row.photoUrl }]" :size="36" />
                                <span class="chat-mb-txt">
                                    <span class="chat-mb-name">
                                        <b>{{ row.name }}</b>
                                        <span v-if="row.isSelf" class="chat-mb-you" data-testid="member-you">(you)</span>
                                        <span v-if="row.isLeader" class="chat-pill" data-testid="member-leader">Leader</span>
                                    </span>
                                </span>
                            </button>
                            <!-- Drawn on every row, empty where there is nothing to do, so each row ends with its inset. -->
                            <span class="chat-mb-acts">
                                <span v-if="row.isRemoving" class="chat-mb-busy" role="status" data-testid="member-removing"><span class="chat-spinner" aria-hidden="true"></span>Removing</span>
                                <template v-else>
                                    <button v-if="row.canMessage"
                                            type="button"
                                            class="chat-mb-msg"
                                            data-testid="member-message"
                                            :aria-label="`Message ${row.name}`"
                                            @click="emit('message', row.guid)">
                                        <Icon name="message" size="xs" />Message
                                    </button>
                                    <Menu v-if="row.menu"
                                          icon="dots"
                                          :label="`More for ${row.name}`"
                                          :items="row.menu.items"
                                          :note="row.menu.note"
                                          :anchorAttrs="{ class: 'chat-mb-more', 'data-testid': 'member-more', 'data-person': row.guid }"
                                          @select="onMenuSelect(row.guid, $event)" />
                                </template>
                            </span>
                            <div v-if="row.refusal" class="chat-mb-err" role="alert" data-testid="member-refusal">
                                <Icon name="alert" size="xs" />
                                <span>{{ row.refusal }}</span>
                                <button type="button"
                                        class="chat-mb-err-x"
                                        aria-label="Dismiss"
                                        data-testid="member-refusal-dismiss"
                                        @click="onDismiss(row.guid)">
                                    <Icon name="x" size="xs" />
                                </button>
                            </div>
                        </li>
                    </TransitionGroup>
                </section>

                <div v-if="isNoneShown" class="chat-mb-none" data-testid="members-none">No one in {{ channelName }} matches &ldquo;{{ query.trim() }}&rdquo;.</div>

                <div v-if="isMoreShown" class="chat-mb-more">
                    <span v-if="moreError" class="chat-mb-more-err" data-testid="members-more-error"><Icon name="alert" size="xs" />Couldn't load more.</span>
                    <button type="button"
                            class="chat-ls-btn"
                            data-testid="members-more"
                            :aria-busy="isLoadingMore ? 'true' : undefined"
                            :aria-disabled="isLoadingMore ? 'true' : undefined"
                            @click="onLoadMore">
                        <template v-if="isLoadingMore"><span class="chat-spinner" aria-hidden="true"></span>Loading</template>
                        <template v-else-if="moreError">Try again</template>
                        <template v-else>Load more</template>
                    </button>
                </div>
                <div v-else-if="isEndShown" class="chat-mb-end" data-testid="members-end">That's everyone.</div>
            </div>

            <span class="chat-sr-only" aria-live="polite">{{ announcement }}</span>
        </div>

        <!--
            Pinned under the list, so it is reachable however far the list scrolls, and drawn from
            the first frame, the roster loading or not. Until Rock says whether the reader may add,
            its place is held empty, so the button arriving moves nothing. A full group keeps it
            focusable but disabled, its reason said under it and read with it.
        -->
        <template v-if="isAddShown || isAddHeld" #foot>
            <div class="chat-mb-foot" :class="{ 'is-reserved': isAddHeld }" data-testid="members-foot">
                <div v-if="isAddHeld" class="chat-mb-add is-place" aria-hidden="true"></div>
                <button v-else
                        type="button"
                        class="chat-mb-add"
                        data-testid="members-add"
                        :aria-disabled="isGroupFull ? 'true' : undefined"
                        :aria-describedby="isGroupFull ? fullHintId : undefined"
                        @click="onAdd">
                    <Icon name="user-plus" size="sm" />Add people
                </button>
                <p v-if="isGroupFull" :id="fullHintId" class="chat-mb-foot-hint" data-testid="members-add-full">Full, {{ groupCapacity }} of {{ groupCapacity }}</p>
            </div>
        </template>
    </PanelHost>
</template>

<style scoped>
/* Ported from the design's members panel; the small outlined button, the skeleton and the spinner are the sheet's. */
.chat-mb-top {
    flex: none;
    padding: 12px 14px 6px;
}

.chat-mb-clear {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    margin-right: -6px;
    color: var(--chat-text-2);
    background: var(--chat-press);
    border: 0;
    border-radius: 50%;
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-mb-clear:hover {
    color: var(--chat-text);
    background: color-mix(in srgb, var(--chat-text) 16%, transparent);
}

.chat-mb-list {
    padding: 2px 8px 0;
}

.chat-mb-sec {
    display: flex;
    gap: 6px;
    align-items: center;
    margin: 14px 10px 4px;
    font-size: 11px;
    font-weight: 700;
    color: var(--chat-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
}

.chat-mb-sec span {
    padding: 0 6px;
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-full);
}

.chat-mb-rows {
    padding: 0;
    margin: 0;
    list-style: none;
}

.chat-mb-row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    border-radius: var(--chat-r-lg);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-mb-row:hover,
.chat-mb-row:focus-within {
    background: var(--chat-hover);
}

.chat-mb-who {
    display: flex;
    flex: 1;
    gap: 10px;
    align-items: center;
    min-width: 0;
    padding: 6px 8px;
    color: inherit;
    text-align: left;
    background: none;
    border: 0;
    border-radius: var(--chat-r-lg);
}

.chat-mb-who :deep(.chat-av) {
    transition: box-shadow var(--chat-t-fast) var(--chat-ease-state);
}

.chat-mb-who:hover :deep(.chat-av) {
    box-shadow: 0 0 0 2px var(--chat-surface), 0 0 0 3.5px var(--chat-line-strong);
}

.chat-mb-txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
}

.chat-mb-name {
    display: flex;
    gap: 6px;
    align-items: center;
    min-width: 0;
    font-size: 14px;
    color: var(--chat-text);
}

.chat-mb-name b {
    min-width: 0;
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-mb-name .chat-pill {
    flex: none;
}

.chat-mb-you {
    flex: none;
    font-size: 13px;
    color: var(--chat-muted);
}

/*
    A row's actions show on the row the pointer rests on, or on focus, and always where there is no
    hover, as on a phone. They fade in and out as the pointer arrives and leaves, but pass from row
    to row at once, which the panel marks as is-instant.
*/
.chat-mb-acts {
    display: flex;
    gap: 2px;
    align-items: center;
    padding-right: 6px;
    opacity: 0;
    transition: opacity var(--chat-t-fast) var(--chat-ease-state);
}

.is-instant .chat-mb-acts {
    transition: none;
}

.chat-mb-row.is-hot .chat-mb-acts,
.chat-mb-row:focus-within .chat-mb-acts,
.chat-mb-row.is-busy .chat-mb-acts,
.chat-mb-row:has([aria-expanded="true"]) .chat-mb-acts,
.chat-mb-rows.is-phone .chat-mb-acts {
    opacity: 1;
}

.chat-mb-acts :deep(.chat-mb-more) {
    width: 30px;
    height: 30px;
}

.chat-mb-busy {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    padding: 0 8px;
    font-size: 12.5px;
    color: var(--chat-muted);
}

.chat-mb-busy .chat-spinner {
    width: 12px;
    height: 12px;
}

/* A row the door is working on dims and takes no presses until it answers. */
.chat-mb-row.is-busy .chat-mb-who {
    pointer-events: none;
    opacity: .55;
}

.chat-mb-err {
    display: flex;
    flex-basis: 100%;
    gap: 7px;
    align-items: flex-start;
    padding: 7px 6px 7px 10px;
    margin: 0 8px 8px 54px;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--chat-danger-ink);
    background: var(--chat-danger-soft);
    border-radius: var(--chat-r-md);
    animation: chat-mb-in var(--chat-t-base) var(--chat-ease-in) both;
}

/* A row's refusal rises in from half the message rise. */
@keyframes chat-mb-in {
    from {
        opacity: 0;
        transform: translateY(calc(var(--chat-rise) * .5));
    }
}

.chat-mb-err > .chat-ic {
    flex: none;
    margin-top: 2px;
}

.chat-mb-err span {
    flex: 1;
    min-width: 0;
}

.chat-mb-err-x {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    border-radius: 50%;
}

.chat-mb-err-x:hover {
    background: color-mix(in srgb, var(--chat-danger) 12%, transparent);
}

/* A removed row collapses, from the height measured as it starts to leave. */
.chat-mb-row.is-leaving {
    overflow: hidden;
    animation: chat-mb-collapse var(--chat-d-row-collapse) var(--chat-ease-out) forwards;
}

@keyframes chat-mb-collapse {
    from {
        height: var(--chat-mb-row-h);
        opacity: 1;
    }

    to {
        height: 0;
        opacity: 0;
    }
}

/* The foot under the list: one outlined button the width of the panel, as the design's members panel. */
.chat-mb-foot {
    flex: none;
    padding: 10px 14px 12px;
    border-top: 1px solid var(--chat-line);
}

.chat-mb-add {
    display: flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 36px;
    padding: 0 14px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--chat-text);
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), border-color var(--chat-t-fast) var(--chat-ease-state);
}

/* The button's place while Rock has not answered: its box, drawn as nothing, under no line yet. */
.chat-mb-foot.is-reserved {
    border-top-color: transparent;
}

.chat-mb-add.is-place {
    visibility: hidden;
}

.chat-mb-add .chat-ic {
    color: var(--chat-brand-ink);
}

.chat-mb-add:hover:not([aria-disabled="true"]) {
    background: var(--chat-hover);
    border-color: var(--chat-icon);
}

.chat-mb-add[aria-disabled="true"] {
    cursor: default;
    color: var(--chat-muted);
    opacity: .6;
}

.chat-mb-add[aria-disabled="true"] .chat-ic {
    color: var(--chat-icon);
}

.chat-mb-foot-hint {
    margin: 6px 0 0;
    font-size: 12px;
    color: var(--chat-muted);
    text-align: center;
}

@media (hover: none) {
    .chat-mb-acts {
        opacity: 1;
    }
}

.chat-mb-msg {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    height: 28px;
    padding: 0 11px 0 9px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--chat-text-2);
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
    border-radius: var(--chat-r-full);
    transition: border-color var(--chat-t-fast) var(--chat-ease-state), color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-mb-msg:hover {
    color: var(--chat-text);
    border-color: var(--chat-icon);
}

.chat-mb-hint {
    display: flex;
    gap: 6px;
    align-items: center;
    margin: 8px 10px 0;
    font-size: 12px;
    color: var(--chat-muted);
}

.chat-mb-hint .chat-spinner {
    width: 11px;
    height: 11px;
    border-width: 1.6px;
}

.chat-mb-hint.is-error {
    color: var(--chat-danger-ink);
}

.chat-mb-link {
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--chat-brand-ink);
    background: none;
    border: 0;
}

.chat-mb-none {
    margin: 18px 10px 4px;
    font-size: 13px;
    color: var(--chat-muted);
    text-align: center;
}

.chat-mb-more {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: center;
    padding: 14px 8px 4px;
}

.chat-mb-more .chat-ls-btn[aria-busy="true"] {
    color: var(--chat-muted);
}

.chat-mb-more-err {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-size: 12.5px;
    color: var(--chat-danger-ink);
}

.chat-mb-end {
    padding: 16px 0 4px;
    font-size: 12px;
    color: var(--chat-muted);
    text-align: center;
}

.chat-mb-state {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    padding: 56px 32px 24px;
    text-align: center;
}

.chat-mb-state-ic {
    --chat-ic-size: 22px;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 8px;
    color: var(--chat-icon);
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: 16px;
}

.chat-mb-state h4 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--chat-text);
}

.chat-mb-state p {
    max-width: 30ch;
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--chat-muted);
}

.chat-mb-state .chat-ls-btn {
    margin-top: 12px;
}

.chat-mb-skel {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 8px;
}

.chat-mb-skel i {
    display: block;
    border-radius: var(--chat-r-full);
}

.chat-mb-skel-c {
    flex: none;
    width: 36px;
    height: 36px;
}

.chat-mb-skel-l {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 7px;
}

.chat-mb-skel-l i:first-child {
    height: 10px;
}

.chat-mb-skel-l i:last-child {
    width: 32%;
    height: 8px;
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, PropType, ref, watch } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import Avatar from "../ui/avatar.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import Menu, { MenuItem } from "../ui/menu.partial.obs";
    import PanelHost from "../ui/panelHost.partial.obs";
    import { MemberRemoval } from "../composables/useMembers.partial";
    import { useHoverIntent } from "../composables/useHoverIntent.partial";
    import { ChatError, RosterMember } from "../types.partial";

    // #region Types

    /** One row as it is drawn and read. */
    type DrawnMember = {
        guid: string;
        name: string;
        photoUrl: string | null;
        isSelf: boolean;
        isLeader: boolean;
        canMessage: boolean;
        label: string;

        /** The row's More menu, for someone who may manage the room, or null. */
        menu: { items: MenuItem[], note: string } | null;
        isRemoving: boolean;

        /** The door's refusal under the row, or null. */
        refusal: string | null;
    };

    /** One heading and its rows. */
    type DrawnSection = {
        title: string;

        /** The rows' count, only once the loaded rows prove it; else null. */
        count: number | null;
        rows: DrawnMember[];
    };

    // #endregion Types

    const props = defineProps({
        /** The room's name as the header shows it, a channel's written with no "#". */
        channelName: {
            type: String,
            required: true
        },

        /** How many are in the room, from its facts once read; null until then, which names the room alone. */
        memberCount: {
            type: Number as PropType<number | null>,
            default: null
        },

        /** A channel lists its leaders first; a group conversation lists everyone together. */
        isChannel: {
            type: Boolean,
            default: true
        },

        /** The rows to list: the loaded roster, or under a query what the search shows. */
        members: {
            type: Array as PropType<RosterMember[]>,
            required: true
        },

        /** Whether more people wait after the last row, for the roster or under a query its search. */
        hasMore: {
            type: Boolean,
            default: false
        },

        /** The first page is on its way. */
        isLoading: {
            type: Boolean,
            default: false
        },

        /** A later page is on its way. */
        isLoadingMore: {
            type: Boolean,
            default: false
        },

        /** Why the first page failed, other than a refusal, or null. */
        error: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** Why the last later page failed, or null. */
        moreError: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** Why the platform will not list the room for the reader, or null. */
        refusal: {
            type: String as PropType<"not_member" | "no_roster_right" | null>,
            default: null
        },

        /** The filter as typed. */
        query: {
            type: String,
            default: ""
        },

        /** Where the search of the whole room is, or null with no query. */
        searchStatus: {
            type: String as PropType<"searching" | "answered" | "failed" | null>,
            default: null
        },

        /** The reader, whose own row says "(you)" and offers no Message. */
        personAliasGuid: {
            type: String,
            default: ""
        },

        /** Whether the chat is in its one-pane phone layout, where a row's actions always show. */
        isPhone: {
            type: Boolean,
            default: false
        },

        /** Whether Rock lets the reader add and remove people here. */
        canManageMembers: {
            type: Boolean,
            default: false
        },

        /** Whether Rock has yet to say if the reader may add here, nothing being held for the room. */
        isAddPending: {
            type: Boolean,
            default: false
        },

        /** Whether the reader is a Chat Administrator, the only one who may remove a channel's leader. */
        isChatAdministrator: {
            type: Boolean,
            default: false
        },

        /** Each row's removal while the door works or after it refused, by person. */
        removals: {
            type: Object as PropType<Record<string, MemberRemoval>>,
            default: () => ({})
        }
    });

    const emit = defineEmits<{
        (e: "query", text: string): void;
        (e: "loadMore"): void;
        (e: "retry"): void;
        (e: "retrySearch"): void;
        (e: "message", personAliasGuid: string): void;
        (e: "person", personAliasGuid: string): void;
        (e: "close"): void;
        (e: "addPeople"): void;
        (e: "remove", personAliasGuid: string): void;
        (e: "dismissRemoval", personAliasGuid: string): void;
    }>();

    // #region Values

    const skeletonWidths = [58, 44, 66, 50, 40, 62, 48];

    const listElement = ref<HTMLElement>();
    const filterElement = ref<HTMLInputElement>();

    // A row's actions show as the message action bar does: faded in once the pointer rests on a
    // row, passing from row to row at once, faded out a moment after the pointer leaves them.
    const hover = useHoverIntent<string>(() => listElement.value);

    const announcement = ref("");

    /** How many rows were drawn when a later page was asked for, until it lands. */
    let moreFrom: number | null = null;

    /** The row each removal started from, and the row after it, which takes focus once it leaves. */
    const leaving = new Map<string, string | null>();

    /** A group holds at most nine people, so a full one takes nobody more. */
    const groupCapacity = 9;

    const fullHintId = `chat-mb-full-${newGuid()}`;

    // #endregion Values

    // #region Computed Values

    const isQuery = computed((): boolean => props.query.trim() !== "");

    /** The room by name and its head count: a channel's members, a group's people. */
    const subtitle = computed((): string => {
        const count = props.memberCount;
        if (count === null) {
            return props.channelName;
        }

        const noun = props.isChannel ? (count === 1 ? "member" : "members") : (count === 1 ? "person" : "people");
        return `${props.channelName} · ${count.toLocaleString()} ${noun}`;
    });

    const sections = computed((): DrawnSection[] => {
        const rows = props.members.map(drawMember);
        // A heading's count is drawn only when the loaded rows prove it, since the roster carries
        // no total; under a query the rows are a search's, so no heading counts the room.
        const isAll = !props.hasMore && !isQuery.value;
        if (!props.isChannel) {
            return rows.length ? [{ title: "In this conversation", count: isAll ? rows.length : null, rows }] : [];
        }

        const leaders = rows.filter(r => r.isLeader);
        const rest = rows.filter(r => !r.isLeader);
        const drawn: DrawnSection[] = [];
        if (leaders.length) {
            // The roster lists leaders first, so a member row loaded means every leader is.
            const isLeadersAll = !isQuery.value && (!props.hasMore || rest.length > 0);
            drawn.push({ title: "Leaders", count: isLeadersAll ? leaders.length : null, rows: leaders });
        }
        if (rest.length) {
            drawn.push({ title: "Members", count: isAll ? rest.length : null, rows: rest });
        }
        return drawn;
    });

    /** The rows in the order drawn, Leaders then Members, for the panel's entrance; none while the first page loads. */
    const entranceKeys = computed((): string[] | null => props.isLoading ? null : sections.value.flatMap(section => section.rows.map(row => row.guid)));

    /** Each row's turn in the entrance. */
    const entranceOrder = computed((): Map<string, number> => new Map((entranceKeys.value ?? []).map((guid, index) => [guid, index])));

    const foundLine = computed((): string => {
        const count = props.members.length;
        return count ? `${count} ${count === 1 ? "person" : "people"} in ${props.channelName}` : `Searched everyone in ${props.channelName}`;
    });

    const isNoneShown = computed((): boolean => isQuery.value && props.searchStatus === "answered" && props.members.length === 0);

    /** Browsing pages on while more wait; a search pages on only once its own answer filled a page. */
    const isMoreShown = computed((): boolean => props.hasMore && (!isQuery.value || props.searchStatus === "answered"));

    const isEndShown = computed((): boolean => props.isChannel && !isQuery.value && !props.hasMore);

    const isGroupFull = computed((): boolean => !props.isChannel && (props.memberCount ?? 0) >= groupCapacity);

    /** Offered where Rock lets the reader add, unless the list itself is refused or failed. */
    const isAddShown = computed((): boolean => props.canManageMembers && !props.refusal && !props.error);

    /** Add people's place, held while Rock has not answered, unless the list itself is refused or failed. */
    const isAddHeld = computed((): boolean => !isAddShown.value && props.isAddPending && !props.refusal && !props.error);

    // #endregion Computed Values

    // #region Event Handlers

    function onInput(event: Event): void {
        emit("query", (event.target as HTMLInputElement).value);
    }

    /** Escape clears a query before it closes the panel. */
    function onFilterKeydown(event: KeyboardEvent): void {
        if (event.key === "Escape" && props.query) {
            event.preventDefault();
            emit("query", "");
        }
    }

    function onClear(): void {
        emit("query", "");
        filterElement.value?.focus();
    }

    function onMenuSelect(personAliasGuid: string, key: string): void {
        if (key === "profile") {
            emit("person", personAliasGuid);
        }
        else if (key === "message") {
            emit("message", personAliasGuid);
        }
        else if (key === "remove") {
            emit("remove", personAliasGuid);
        }
    }

    /** A dismissed refusal gives focus back to its row, or to the row after a stale one that leaves. */
    function onDismiss(personAliasGuid: string): void {
        leaving.set(personAliasGuid, nextRowOf(personAliasGuid));
        emit("dismissRemoval", personAliasGuid);
        void nextTick(() => {
            if (props.members.some(member => member.person_alias_guid === personAliasGuid)) {
                leaving.delete(personAliasGuid);
                whoOf(personAliasGuid)?.focus({ preventScroll: true });
            }
        });
    }

    /** A leaving row's height is measured as it starts, so its collapse runs from its own height. */
    function onRowBeforeLeave(element: Element): void {
        const row = element as HTMLElement;
        row.style.setProperty("--chat-mb-row-h", `${row.offsetHeight}px`);
    }

    /** A full group's button is reached and heard, but asks for nothing. */
    function onAdd(): void {
        if (!isGroupFull.value) {
            emit("addPeople");
        }
    }

    function onLoadMore(): void {
        // the page already on its way answers for this press too
        if (!props.isLoadingMore) {
            emit("loadMore");
        }
    }

    /** The pointer reached a row, or a gap between them. */
    function onPointerOver(event: PointerEvent): void {
        if (event.pointerType === "touch") {
            return;
        }

        hover.follow(event.target instanceof Element ? event.target.closest<HTMLElement>("[data-hot-id]")?.dataset.hotId ?? null : null);
    }

    function onPointerLeave(): void {
        hover.follow(null);
    }

    // #endregion Event Handlers

    // #region Functions

    function drawMember(member: RosterMember): DrawnMember {
        const name = `${member.nick_name ?? ""} ${member.last_name ?? ""}`.trim() || "Someone";
        const isSelf = member.person_alias_guid.toLowerCase() === props.personAliasGuid.toLowerCase();
        const isLeader = props.isChannel && member.is_leader;
        const parts = [name, isSelf ? "you" : "", isLeader ? "leader" : ""].filter(p => !!p);

        const canMessage = member.can_message && !isSelf;
        const removal = props.removals[member.person_alias_guid];

        return {
            guid: member.person_alias_guid,
            name,
            photoUrl: member.avatar_url,
            isSelf,
            isLeader,
            canMessage,
            label: `${parts.join(", ")}. View profile`,
            menu: isSelf || !props.canManageMembers ? null : menuOf(isLeader, canMessage),
            isRemoving: removal?.kind === "removing",
            refusal: removal?.kind === "refused" ? removal.text : null
        };
    }

    /**
     * A row's More menu: the profile, Message where the person can be messaged, then Remove, or
     * for a channel's leader seen by someone who is not a Chat Administrator, why there is none.
     */
    function menuOf(isLeader: boolean, canMessage: boolean): { items: MenuItem[], note: string } {
        const items: MenuItem[] = [{ key: "profile", label: "View profile", icon: "users" }];
        if (canMessage) {
            items.push({ key: "message", label: "Message", icon: "message" });
        }

        if (isLeader && !props.isChatAdministrator) {
            return { items, note: "Only Chat Administrators can remove a leader" };
        }

        const room = props.isChannel ? props.channelName : "this conversation";
        items.push({ key: "remove", label: `Remove from ${room}`, icon: "user-minus", isDanger: true, isSeparatorBefore: true });
        return { items, note: "" };
    }

    /** The row drawn after a person's, else the one before it, else none. */
    function nextRowOf(personAliasGuid: string): string | null {
        const order = sections.value.flatMap(section => section.rows.map(row => row.guid));
        const at = order.indexOf(personAliasGuid);
        return at < 0 ? null : order[at + 1] ?? order[at - 1] ?? null;
    }

    function whoOf(personAliasGuid: string): HTMLElement | null {
        return listElement.value?.querySelector<HTMLElement>(`[data-testid='member-who'][data-person='${personAliasGuid}']`) ?? null;
    }

    // #endregion Functions

    // #region Watchers

    watch(() => props.isLoadingMore, isLoadingMore => {
        if (isLoadingMore) {
            moreFrom = props.members.length;
        }
    });

    // A later page's first row takes focus when the person asked from Load more, so the keyboard
    // carries on where the list grew.
    watch(() => props.isLoadingMore, async (isLoadingMore, wasLoadingMore) => {
        const from = moreFrom;
        if (!wasLoadingMore || isLoadingMore || from === null) {
            return;
        }

        moreFrom = null;
        const added = props.members.slice(from);
        if (props.moreError || added.length === 0) {
            return;
        }

        const active = document.activeElement;
        const wasOnMore = !active || active === document.body || !!active.closest("[data-testid='members-more']");
        announcement.value = `${added.length} more ${added.length === 1 ? "member" : "members"} loaded`;
        await nextTick();
        if (wasOnMore) {
            listElement.value?.querySelector<HTMLElement>(`[data-testid='member-who'][data-person='${added[0].person_alias_guid}']`)?.focus({ preventScroll: true });
        }
    });

    // A row the door starts removing remembers the row after it; a refused one keeps focus on itself.
    // Snapshot each kind because the roster mutates this dictionary's entries in place. Read after
    // the render: an entry changed in place can reach this watcher before the members prop does,
    // and a row just dropped with its entry would look still present and lose its focus intent.
    watch(() => Object.fromEntries(Object.entries(props.removals).map(([guid, removal]) => [guid, removal.kind])), (removals, was) => {
        // A removal can return to the leader dialog without losing its row. Its old focus
        // intent must not survive into a later search that happens to exclude that person.
        for (const guid of Array.from(leaving.keys())) {
            if (!removals[guid] && props.members.some(member => member.person_alias_guid === guid)) {
                leaving.delete(guid);
            }
        }

        for (const [guid, kind] of Object.entries(removals)) {
            if (kind === "removing" && was?.[guid] !== "removing") {
                leaving.set(guid, nextRowOf(guid));
            }
            else if (kind === "refused" && was?.[guid] === "removing") {
                leaving.delete(guid);
                void nextTick(() => whoOf(guid)?.focus({ preventScroll: true }));
            }
        }
    }, { flush: "post" });

    // Once a removed row leaves, focus moves on to the row after it, or the filter when none is left.
    watch(() => props.members, members => {
        const shown = new Set(members.map(member => member.person_alias_guid));
        const gone = Array.from(leaving.keys()).filter(guid => !shown.has(guid));
        if (gone.length === 0) {
            return;
        }

        const next = leaving.get(gone[0]) ?? null;
        gone.forEach(guid => leaving.delete(guid));
        ((next ? whoOf(next) : null) ?? filterElement.value)?.focus({ preventScroll: true });
    }, { flush: "post" });

    // A screen reader hears what the first page brought.
    watch(() => props.isLoading, (isLoading, wasLoading) => {
        if (wasLoading && !isLoading && !props.error && !props.refusal) {
            const count = props.members.length;
            announcement.value = props.hasMore ? `First ${count} members loaded` : `${count} ${count === 1 ? "member" : "members"}`;
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onBeforeUnmount(hover.stop);

    // #endregion Lifecycle Hooks
</script>
