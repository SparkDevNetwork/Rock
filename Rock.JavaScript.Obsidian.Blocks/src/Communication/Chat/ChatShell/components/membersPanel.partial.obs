<script setup lang="ts">
    import { computed, nextTick, PropType, ref, watch } from "vue";
    import Avatar from "../ui/avatar.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import Menu, { MenuItem } from "../ui/menu.partial.obs";
    import PanelHost from "../ui/panelHost.partial.obs";
    import { MemberRemoval } from "../composables/useMembers.partial";
    import { ChatError, RosterMember } from "../types.partial";

    // #region Types

    /** One row as it is drawn and read. */
    type DrawnMember = {
        guid: string;
        name: string;
        photoUrl: string | null;
        isSelf: boolean;
        isLeader: boolean;
        campus: string;
        canMessage: boolean;
        label: string;

        /** The row's More menu, for someone who may manage the room, or null. */
        menu: { items: MenuItem[], note: string } | null;
        isRemoving: boolean;

        /** The door's refusal under the row, or null. */
        refusal: string | null;
    };

    /** One heading and its rows. */
    type DrawnSection = {
        title: string;

        /** The rows' count, only once the loaded rows prove it; else null. */
        count: number | null;
        rows: DrawnMember[];
    };

    // #endregion Types

    const props = defineProps({
        /** The room's name as the header shows it, a channel's written with no "#". */
        channelName: {
            type: String,
            required: true
        },

        /** How many are in the room, from its facts once read; null until then, which names the room alone. */
        memberCount: {
            type: Number as PropType<number | null>,
            default: null
        },

        /** A channel lists its leaders first; a group conversation lists everyone together. */
        isChannel: {
            type: Boolean,
            default: true
        },

        /** The rows to list: the loaded roster, or under a query what the search shows. */
        members: {
            type: Array as PropType<RosterMember[]>,
            required: true
        },

        /** Whether more people wait after the last row, for the roster or under a query its search. */
        hasMore: {
            type: Boolean,
            default: false
        },

        /** The first page is on its way. */
        isLoading: {
            type: Boolean,
            default: false
        },

        /** A later page is on its way. */
        isLoadingMore: {
            type: Boolean,
            default: false
        },

        /** Why the first page failed, other than a refusal, or null. */
        error: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** Why the last later page failed, or null. */
        moreError: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** Why the platform will not list the room for the reader, or null. */
        refusal: {
            type: String as PropType<"not_member" | "no_roster_right" | null>,
            default: null
        },

        /** The filter as typed. */
        query: {
            type: String,
            default: ""
        },

        /** Where the search of the whole room is, or null with no query. */
        searchStatus: {
            type: String as PropType<"searching" | "answered" | "failed" | null>,
            default: null
        },

        /** The reader, whose own row says "(you)" and offers no Message. */
        personAliasGuid: {
            type: String,
            default: ""
        },

        /** The church's campus names by guid in lower case, from the init box. */
        campusNames: {
            type: Object as PropType<Record<string, string>>,
            default: () => ({})
        },

        /** Whether the chat is in its one-pane phone layout, where a row's actions always show. */
        isPhone: {
            type: Boolean,
            default: false
        },

        /** Whether Rock lets the reader add and remove people here. */
        canManageMembers: {
            type: Boolean,
            default: false
        },

        /** Whether the reader is a Chat Administrator, the only one who may remove a channel's leader. */
        isChatAdministrator: {
            type: Boolean,
            default: false
        },

        /** Each row's removal while the door works or after it refused, by person. */
        removals: {
            type: Object as PropType<Record<string, MemberRemoval>>,
            default: () => ({})
        }
    });

    const emit = defineEmits<{
        (e: "query", text: string): void;
        (e: "loadMore"): void;
        (e: "retry"): void;
        (e: "retrySearch"): void;
        (e: "message", personAliasGuid: string): void;
        (e: "person", personAliasGuid: string): void;
        (e: "close"): void;
        (e: "addPeople"): void;
        (e: "remove", personAliasGuid: string): void;
        (e: "dismissRemoval", personAliasGuid: string): void;
    }>();

    // #region Values

    const skeletonWidths = [58, 44, 66, 50, 40, 62, 48];

    const listElement = ref<HTMLElement>();
    const filterElement = ref<HTMLInputElement>();

    /** The people a later page brought, who rise in. */
    const freshIds = ref(new Set<string>());

    const announcement = ref("");

    /** How many rows were drawn when a later page was asked for, until it lands. */
    let moreFrom: number | null = null;

    /** The row each removal started from, and the row after it, which takes focus once it leaves. */
    const leaving = new Map<string, string | null>();

    /** A group holds at most nine people, so a full one takes nobody more. */
    const groupCapacity = 9;

    // #endregion Values

    // #region Computed Values

    const isQuery = computed((): boolean => props.query.trim() !== "");

    /** The room by name and its head count: a channel's members, a group's people. */
    const subtitle = computed((): string => {
        const count = props.memberCount;
        if (count === null) {
            return props.channelName;
        }

        const noun = props.isChannel ? (count === 1 ? "member" : "members") : (count === 1 ? "person" : "people");
        return `${props.channelName} · ${count.toLocaleString()} ${noun}`;
    });

    const sections = computed((): DrawnSection[] => {
        const rows = props.members.map(drawMember);
        // A heading's count is drawn only when the loaded rows prove it, since the roster carries
        // no total; under a query the rows are a search's, so no heading counts the room.
        const isAll = !props.hasMore && !isQuery.value;
        if (!props.isChannel) {
            return rows.length ? [{ title: "In this conversation", count: isAll ? rows.length : null, rows }] : [];
        }

        const leaders = rows.filter(r => r.isLeader);
        const rest = rows.filter(r => !r.isLeader);
        const drawn: DrawnSection[] = [];
        if (leaders.length) {
            // The roster lists leaders first, so a member row loaded means every leader is.
            const isLeadersAll = !isQuery.value && (!props.hasMore || rest.length > 0);
            drawn.push({ title: "Leaders", count: isLeadersAll ? leaders.length : null, rows: leaders });
        }
        if (rest.length) {
            drawn.push({ title: "Members", count: isAll ? rest.length : null, rows: rest });
        }
        return drawn;
    });

    const foundLine = computed((): string => {
        const count = props.members.length;
        return count ? `${count} ${count === 1 ? "person" : "people"} in ${props.channelName}` : `Searched everyone in ${props.channelName}`;
    });

    const isNoneShown = computed((): boolean => isQuery.value && props.searchStatus === "answered" && props.members.length === 0);

    /** Browsing pages on while more wait; a search pages on only once its own answer filled a page. */
    const isMoreShown = computed((): boolean => props.hasMore && (!isQuery.value || props.searchStatus === "answered"));

    const isEndShown = computed((): boolean => props.isChannel && !isQuery.value && !props.hasMore);

    const isGroupFull = computed((): boolean => !props.isChannel && (props.memberCount ?? 0) >= groupCapacity);

    // #endregion Computed Values

    // #region Event Handlers

    function onInput(event: Event): void {
        emit("query", (event.target as HTMLInputElement).value);
    }

    /** Escape clears a query before it closes the panel. */
    function onFilterKeydown(event: KeyboardEvent): void {
        if (event.key === "Escape" && props.query) {
            event.preventDefault();
            emit("query", "");
        }
    }

    function onClear(): void {
        emit("query", "");
        filterElement.value?.focus();
    }

    function onMenuSelect(personAliasGuid: string, key: string): void {
        if (key === "profile") {
            emit("person", personAliasGuid);
        }
        else if (key === "message") {
            emit("message", personAliasGuid);
        }
        else if (key === "remove") {
            emit("remove", personAliasGuid);
        }
    }

    /** A dismissed refusal gives focus back to its row, or to the row after a stale one that leaves. */
    function onDismiss(personAliasGuid: string): void {
        leaving.set(personAliasGuid, nextRowOf(personAliasGuid));
        emit("dismissRemoval", personAliasGuid);
        void nextTick(() => {
            if (props.members.some(member => member.person_alias_guid === personAliasGuid)) {
                leaving.delete(personAliasGuid);
                whoOf(personAliasGuid)?.focus({ preventScroll: true });
            }
        });
    }

    /** A leaving row's height is measured as it starts, so its collapse runs from its own height. */
    function onRowBeforeLeave(element: Element): void {
        const row = element as HTMLElement;
        row.style.setProperty("--chat-mb-row-h", `${row.offsetHeight}px`);
    }

    function onLoadMore(): void {
        // the page already on its way answers for this press too
        if (!props.isLoadingMore) {
            emit("loadMore");
        }
    }

    // #endregion Event Handlers

    // #region Functions

    function drawMember(member: RosterMember): DrawnMember {
        const name = `${member.nick_name ?? ""} ${member.last_name ?? ""}`.trim() || "Someone";
        const isSelf = member.person_alias_guid.toLowerCase() === props.personAliasGuid.toLowerCase();
        const isLeader = props.isChannel && member.is_leader;
        const campusId = member.details?.campus_id;
        const campus = campusId ? props.campusNames[campusId.toLowerCase()] ?? "" : "";
        const parts = [name, isSelf ? "you" : "", isLeader ? "leader" : "", campus].filter(p => !!p);

        const canMessage = member.can_message && !isSelf;
        const removal = props.removals[member.person_alias_guid];

        return {
            guid: member.person_alias_guid,
            name,
            photoUrl: member.avatar_url,
            isSelf,
            isLeader,
            campus,
            canMessage,
            label: `${parts.join(", ")}. View profile`,
            menu: isSelf || !props.canManageMembers ? null : menuOf(isLeader, canMessage),
            isRemoving: removal?.kind === "removing",
            refusal: removal?.kind === "refused" ? removal.text : null
        };
    }

    /**
     * A row's More menu: the profile, Message where the person can be messaged, then Remove, or
     * for a channel's leader seen by someone who is not a Chat Administrator, why there is none.
     */
    function menuOf(isLeader: boolean, canMessage: boolean): { items: MenuItem[], note: string } {
        const items: MenuItem[] = [{ key: "profile", label: "View profile", icon: "users" }];
        if (canMessage) {
            items.push({ key: "message", label: "Message", icon: "message" });
        }

        if (isLeader && !props.isChatAdministrator) {
            return { items, note: "Only Chat Administrators can remove a leader" };
        }

        const room = props.isChannel ? props.channelName : "this conversation";
        items.push({ key: "remove", label: `Remove from ${room}`, icon: "user-minus", isDanger: true, isSeparatorBefore: true });
        return { items, note: "" };
    }

    /** The row drawn after a person's, else the one before it, else none. */
    function nextRowOf(personAliasGuid: string): string | null {
        const order = sections.value.flatMap(section => section.rows.map(row => row.guid));
        const at = order.indexOf(personAliasGuid);
        return at < 0 ? null : order[at + 1] ?? order[at - 1] ?? null;
    }

    function whoOf(personAliasGuid: string): HTMLElement | null {
        return listElement.value?.querySelector<HTMLElement>(`[data-testid='member-who'][data-person='${personAliasGuid}']`) ?? null;
    }

    // #endregion Functions

    // #region Watchers

    watch(() => props.isLoadingMore, isLoadingMore => {
        if (isLoadingMore) {
            moreFrom = props.members.length;
        }
    });

    // A later page's rows rise in, and its first row takes focus when the person asked from Load
    // more, so the keyboard carries on where the list grew.
    watch(() => props.isLoadingMore, async (isLoadingMore, wasLoadingMore) => {
        const from = moreFrom;
        if (!wasLoadingMore || isLoadingMore || from === null) {
            return;
        }

        moreFrom = null;
        const added = props.members.slice(from);
        if (props.moreError || added.length === 0) {
            return;
        }

        const active = document.activeElement;
        const wasOnMore = !active || active === document.body || !!active.closest("[data-testid='members-more']");
        freshIds.value = new Set(added.map(m => m.person_alias_guid));
        announcement.value = `${added.length} more ${added.length === 1 ? "member" : "members"} loaded`;
        await nextTick();
        if (wasOnMore) {
            listElement.value?.querySelector<HTMLElement>(`[data-testid='member-who'][data-person='${added[0].person_alias_guid}']`)?.focus({ preventScroll: true });
        }
    });

    // A row the door starts removing remembers the row after it; a refused one keeps focus on itself.
    watch(() => props.removals, (removals, was) => {
        for (const [guid, removal] of Object.entries(removals)) {
            if (removal.kind === "removing" && was?.[guid]?.kind !== "removing") {
                leaving.set(guid, nextRowOf(guid));
            }
            else if (removal.kind === "refused" && was?.[guid]?.kind === "removing") {
                leaving.delete(guid);
                void nextTick(() => whoOf(guid)?.focus({ preventScroll: true }));
            }
        }
    });

    // Once a removed row leaves, focus moves on to the row after it, or the filter when none is left.
    watch(() => props.members, members => {
        const shown = new Set(members.map(member => member.person_alias_guid));
        const gone = Array.from(leaving.keys()).filter(guid => !shown.has(guid));
        if (gone.length === 0) {
            return;
        }

        const next = leaving.get(gone[0]) ?? null;
        gone.forEach(guid => leaving.delete(guid));
        ((next ? whoOf(next) : null) ?? filterElement.value)?.focus({ preventScroll: true });
    }, { flush: "post" });

    // A screen reader hears what the first page brought.
    watch(() => props.isLoading, (isLoading, wasLoading) => {
        if (wasLoading && !isLoading && !props.error && !props.refusal) {
            const count = props.members.length;
            announcement.value = props.hasMore ? `First ${count} members loaded` : `${count} ${count === 1 ? "member" : "members"}`;
        }
    });

    // #endregion Watchers
</script>
