    background: none;
    border: 0;
    border-radius: var(--chat-r-lg);
}

.chat-mb-who :deep(.chat-av) {
    transition: box-shadow var(--chat-t-fast) var(--chat-ease-state);
}

.chat-mb-who:hover :deep(.chat-av) {
    box-shadow: 0 0 0 2px var(--chat-surface), 0 0 0 3.5px var(--chat-line-strong);
}

.chat-mb-txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
}

.chat-mb-name {
    display: flex;
    gap: 6px;
    align-items: center;
    min-width: 0;
    font-size: 14px;
    color: var(--chat-text);
}

.chat-mb-name b {
    min-width: 0;
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-mb-name .chat-pill {
    flex: none;
}

.chat-mb-you {
    flex: none;
    font-size: 13px;
    color: var(--chat-muted);
}

.chat-mb-sub {
    overflow: hidden;
    font-size: 12.5px;
    color: var(--chat-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* A row's actions show on hover or focus, and always where there is no hover, as on a phone. */
.chat-mb-acts {
    display: flex;
    gap: 2px;
    align-items: center;
    padding-right: 6px;
    opacity: 0;
    transition: opacity var(--chat-t-fast) var(--chat-ease-state);
}

.chat-mb-row:hover .chat-mb-acts,
.chat-mb-row:focus-within .chat-mb-acts,
.chat-mb-row.is-busy .chat-mb-acts,
.chat-mb-row:has([aria-expanded="true"]) .chat-mb-acts,
.chat-mb-rows.is-phone .chat-mb-acts {
    opacity: 1;
}

.chat-mb-acts :deep(.chat-mb-more) {
    width: 30px;
    height: 30px;
}

.chat-mb-busy {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    padding: 0 8px;
    font-size: 12.5px;
    color: var(--chat-muted);
}

.chat-mb-busy .chat-spinner {
    width: 12px;
    height: 12px;
}

/* A row the door is working on dims and takes no presses until it answers. */
.chat-mb-row.is-busy .chat-mb-who {
    pointer-events: none;
    opacity: .55;
}

.chat-mb-err {
    display: flex;
    flex-basis: 100%;
    gap: 7px;
    align-items: flex-start;
    padding: 7px 6px 7px 10px;
    margin: 0 8px 8px 54px;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--chat-danger-ink);
    background: var(--chat-danger-soft);
    border-radius: var(--chat-r-md);
    animation: chat-mb-in var(--chat-t-base) var(--chat-ease-in) both;
}

.chat-mb-err > .chat-ic {
    flex: none;
    margin-top: 2px;
}

.chat-mb-err span {
    flex: 1;
    min-width: 0;
}

.chat-mb-err-x {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    border-radius: 50%;
}

.chat-mb-err-x:hover {
    background: color-mix(in srgb, var(--chat-danger) 12%, transparent);
}

/* A removed row collapses, from the height measured as it starts to leave. */
.chat-mb-row.is-leaving {
    overflow: hidden;
    animation: chat-mb-collapse var(--chat-d-row-collapse) var(--chat-ease-out) forwards;
}

@keyframes chat-mb-collapse {
    from {
        height: var(--chat-mb-row-h);
        opacity: 1;
    }

    to {
        height: 0;
        opacity: 0;
    }
}

.chat-mb-add {
    display: flex;
    gap: 10px;
    align-items: center;
    width: 100%;
    padding: 6px 8px;
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--chat-text-2);
    text-align: left;
    background: none;
    border: 0;
    border-radius: var(--chat-r-lg);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-mb-add:hover {
    color: var(--chat-text);
    background: var(--chat-hover);
}

.chat-mb-add-ic {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--chat-brand-ink);
    border: 1.5px dashed var(--chat-line-strong);
    border-radius: 50%;
    transition: border-color var(--chat-t-fast) var(--chat-ease-state), background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-mb-add:hover .chat-mb-add-ic {
    background: var(--chat-brand-wash);
    border-color: color-mix(in srgb, var(--chat-brand) 60%, var(--chat-line));
}

.chat-mb-add.is-full {
    cursor: default;
    color: var(--chat-muted);
}

.chat-mb-add.is-full:hover {
    background: none;
}

.chat-mb-add.is-full .chat-mb-add-ic {
    color: var(--chat-icon);
    opacity: .6;
}

.chat-mb-add-t {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
}

.chat-mb-add-t span {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--chat-muted);
}

@media (hover: none) {
    .chat-mb-acts {
        opacity: 1;
    }
}

.chat-mb-msg {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    height: 28px;
    padding: 0 11px 0 9px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--chat-text-2);
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
    border-radius: var(--chat-r-full);
    transition: border-color var(--chat-t-fast) var(--chat-ease-state), color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-mb-msg:hover {
    color: var(--chat-text);
    border-color: var(--chat-icon);
}

.chat-mb-hint {
    display: flex;
    gap: 6px;
    align-items: center;
    margin: 8px 10px 0;
    font-size: 12px;
    color: var(--chat-muted);
}

.chat-mb-hint .chat-spinner {
    width: 11px;
    height: 11px;
    border-width: 1.6px;
}

.chat-mb-hint.is-error {
    color: var(--chat-danger-ink);
}

.chat-mb-link {
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--chat-brand-ink);
    background: none;
    border: 0;
}

.chat-mb-none {
    margin: 18px 10px 4px;
    font-size: 13px;
    color: var(--chat-muted);
    text-align: center;
}

.chat-mb-more {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: center;
    padding: 14px 8px 4px;
}

.chat-mb-more .chat-ls-btn[aria-busy="true"] {
    color: var(--chat-muted);
}

.chat-mb-more-err {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-size: 12.5px;
    color: var(--chat-danger-ink);
}

.chat-mb-end {
    padding: 16px 0 4px;
    font-size: 12px;
    color: var(--chat-muted);
    text-align: center;
}

.chat-mb-state {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    padding: 56px 32px 24px;
    text-align: center;
}

.chat-mb-state-ic {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 8px;
    color: var(--chat-icon);
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: 16px;
}

.chat-mb-state-ic :deep(.chat-ic) {
    width: 22px;
    height: 22px;
}

.chat-mb-state h4 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--chat-text);
}

.chat-mb-state p {
    max-width: 30ch;
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--chat-muted);
}

.chat-mb-state .chat-ls-btn {
    margin-top: 12px;
}

.chat-mb-skel {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 8px;
}

.chat-mb-skel i {
    display: block;
    border-radius: var(--chat-r-full);
}

.chat-mb-skel-c {
    flex: none;
    width: 36px;
    height: 36px;
}

.chat-mb-skel-l {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 7px;
}

