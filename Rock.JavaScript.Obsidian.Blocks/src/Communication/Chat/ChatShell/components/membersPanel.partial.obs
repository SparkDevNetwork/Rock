    font-size: 11px;
    font-weight: 700;
    color: var(--chat-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
}

.chat-mb-sec span {
    padding: 0 6px;
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-full);
}

.chat-mb-rows {
    padding: 0;
    margin: 0;
    list-style: none;
}

.chat-mb-row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    border-radius: var(--chat-r-lg);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-mb-row:hover,
.chat-mb-row:focus-within {
    background: var(--chat-hover);
}

/* Rows a fetch brought rise in from half the message rise. */
.chat-mb-row.is-in {
    animation: chat-mb-in var(--chat-t-msg) var(--chat-ease-in) both;
}

@keyframes chat-mb-in {
    from {
        opacity: 0;
        transform: translateY(calc(var(--chat-rise) * .5));
    }
}

.chat-mb-who {
    display: flex;
    flex: 1;
    gap: 10px;
    align-items: center;
    min-width: 0;
