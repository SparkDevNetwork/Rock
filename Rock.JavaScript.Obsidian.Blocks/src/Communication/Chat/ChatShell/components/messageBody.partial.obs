<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="chat-message-body" data-testid="message-body">
        <template v-for="(row, rowIndex) in rows" :key="rowIndex">
            <hr v-if="row.kind === 'divider'" class="chat-block-divider" data-testid="block-divider" />
            <div v-else-if="row.kind === 'image'" class="chat-block-image" data-testid="block-image">
                <img :src="row.url" :alt="row.alt" />
            </div>
            <div v-else :class="row.cssClass" :data-testid="row.testId">
                <template v-for="(piece, pieceIndex) in row.pieces" :key="pieceIndex">
                    <a v-if="piece.kind === 'link'" class="chat-lnk" :href="piece.url" target="_blank" rel="noopener noreferrer nofollow">{{ piece.text }}</a>
                    <span v-else-if="piece.kind === 'mention'" :class="{ 'chat-mn-wrap': !!piece.trail }"><span
                          class="chat-mn"
                          :class="[`is-${piece.mention}`, { 'is-punctuated': !!piece.trail }]"
                          data-testid="piece-mention"
                          :data-mention="piece.mention"
                          :aria-label="piece.label"><span v-if="piece.mention === 'all'" class="chat-mn-glyph" aria-hidden="true"><Icon name="users" size="xs" /></span><span v-else
                          class="chat-av chat-mn-av"
                          :data-initial="piece.initial"
                          :style="{ '--chat-av-hue': piece.hue }"
                          aria-hidden="true"></span><span v-if="piece.mention !== 'all'" class="chat-sr-only">@</span><span class="chat-mn-name">{{ piece.name }}</span></span>{{ piece.trail }}</span>
                    <span v-else-if="piece.kind === 'emoji'" class="chat-emoji" data-testid="piece-emoji" :title="piece.label">{{ piece.text }}</span>
                    <img v-else-if="piece.kind === 'image'" class="chat-emoji-image" :src="piece.url" :alt="piece.label" :title="piece.label" />
                    <template v-else>{{ piece.text }}</template>
                </template>
            </div>
        </template>
    </div>
</template>

<style scoped>
/*
    A word breaks only where it is wider than the line. break-word, unlike anywhere, still counts
    the longest word in the body's narrowest width, so a bubble sized to its text never shrinks to
    a letter a line.
*/
.chat-message-body {
    white-space: pre-wrap;
    overflow-wrap: break-word;
}

/*
    An inline block on the text's baseline, so its 1px top and bottom padding count toward the
    line: a line holding a chip is that much taller, as a pill needs room above and below its text.
*/
.chat-mn {
    display: inline-block;
    padding: 1px 6px 1px 2px;
    font-weight: 600;
    color: var(--chat-brand-ink);
    white-space: nowrap;
    background: var(--chat-mn-bg);
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-mn:hover {
    background: var(--chat-mn-bg-hover);
}

.chat-mn.is-you {
    color: var(--chat-text);
    background: var(--chat-mn-me-bg);
}

.chat-mn.is-all {
    color: var(--chat-info-ink);
    background: var(--chat-mn-all-bg);
}

/* Punctuation right after a chip stays on its line, and the chip's end padding gives way to it. */
.chat-mn-wrap {
    white-space: nowrap;
}

.chat-mn.is-punctuated {
    padding-right: 3px;
    margin-right: -1px;
}

/*
    A one-letter face in the sheet's avatar colors, its letter drawn by the style so the chip's
    text stays the mention as written. Its bottom sits 4px below the name's baseline: an inline
    block that clips takes its bottom edge as its baseline, where a grid would take its letter's.
*/
.chat-mn-av {
    display: inline-block;
    width: 18px;
    height: 18px;
    margin-right: 4px;
    font-size: 10px;
    line-height: 18px;
    text-align: center;
    vertical-align: -4px;
}

.chat-mn-av::before {
    content: attr(data-initial);
}

/* The room's mark, 16px with a 10px glyph centred by its top padding, sunk like the faces. */
.chat-mn-glyph {
    display: inline-block;
    width: 16px;
    height: 16px;
    padding-top: 3px;
    margin-right: 4px;
    overflow: hidden;
    line-height: 0;
    color: var(--chat-on-info);
    text-align: center;
    vertical-align: -4px;
    background: var(--chat-info);
    border-radius: 50%;
}

.chat-mn-glyph :deep(.chat-ic) {
    width: 10px;
    height: 10px;
    stroke-width: 2.4;
}

.chat-lnk {
    color: var(--chat-brand-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
}

.chat-emoji-image {
    height: 1.25em;
    vertical-align: text-bottom;
}

.chat-block-context {
    font-size: 12px;
    color: var(--chat-muted);
}

.chat-block-divider {
    margin: 6px 0;
}

.chat-block-image img {
    max-width: 100%;
    border-radius: 6px;
}
</style>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import Icon from "../ui/icon.partial.obs";
    import { avatarHue } from "../ui/brand.partial";

    // #region Types

    /** A piece as this client draws it, reduced to the kinds it knows. */
    type DrawnPiece = {
        kind: "text" | "mention" | "link" | "emoji" | "image";
        text: string;
        url?: string;
        label?: string;

        /** A mention's chip: someone else, the reader, or the whole room. */
        mention?: "person" | "you" | "all";

        /** Punctuation that follows a chip with no space, kept on the chip's line. */
        trail?: string;
        name?: string;
        initial?: string;
        hue?: string;
    };

    /** One line of the body: the body's own pieces, or one block. */
    type DrawnRow = {
        kind: "pieces" | "divider" | "image";
        pieces?: DrawnPiece[];
        cssClass?: string;
        testId?: string;
        url?: string;
        alt?: string;
    };

    // #endregion Types

    const props = defineProps({
        /** The body as text, or the sentence shown in place of a deleted or hidden message. */
        text: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The body's pieces as the server built them, or null for a plain body. */
        pieces: {
            type: Array as PropType<unknown[] | null>,
            default: null
        },

        /** The message's blocks, drawn in place of the body when present. */
        blocks: {
            type: Array as PropType<unknown[] | null>,
            default: null
        },

        /** The reader's alias guid, so a mention of them draws as the "you" chip. */
        personAliasGuid: {
            type: String as PropType<string>,
            default: ""
        }
    });

    // #region Computed Values

    /**
     * What is drawn. The server's pieces and blocks are read as untrusted shapes: a kind this
     * client was not built with is drawn by the text the server put beside it, so a released
     * client still shows what later platforms send.
     */
    const rows = computed((): DrawnRow[] => {
        if (Array.isArray(props.blocks) && props.blocks.length > 0) {
            return props.blocks.map(blockRow);
        }

        return [{ kind: "pieces", cssClass: "chat-body-text", pieces: drawnPieces(props.pieces, props.text) }];
    });

    // #endregion Computed Values

    // #region Functions

    /** Whether an address may be opened as a link: only the web, never script or another scheme. */
    function isWebAddress(value: unknown): value is string {
        return typeof value === "string" && /^https?:\/\/./i.test(value);
    }

    /** Whether an address may be loaded as an image: only https, so a page never mixes content. */
    function isSecureAddress(value: unknown): value is string {
        return typeof value === "string" && /^https:\/\/./i.test(value);
    }

    function asRecord(value: unknown): Record<string, unknown> | null {
        return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Record<string, unknown> : null;
    }

    function textOf(value: unknown): string {
        return typeof value === "string" ? value : "";
    }

    /** One server piece as drawn. A link or image this client does not trust is drawn as its text. */
    function drawnPiece(value: unknown): DrawnPiece | null {
        const piece = asRecord(value);
        if (!piece) {
            return null;
        }

        const text = textOf(piece.text);
        if (piece.type === "mention") {
            return mentionPiece(piece, text);
        }

        if (piece.type === "link" && isWebAddress(piece.url)) {
            return { kind: "link", text: linkText(text), url: piece.url };
        }

        if (piece.type === "emoji") {
            const label = textOf(piece.label) || text;
            if (typeof piece.emoji === "string" && piece.emoji) {
                return { kind: "emoji", text: piece.emoji, label };
            }

            if (isSecureAddress(piece.image_url)) {
                return { kind: "image", text, url: piece.image_url, label };
            }
        }

        return { kind: "text", text };
    }

    /**
     * A mention as a chip. Only the server makes a mention piece, after it admitted the person,
     * so a chip is never drawn from anything typed; who it names decides its look.
     */
    function mentionPiece(piece: Record<string, unknown>, text: string): DrawnPiece {
        const name = text.replace(/^@/, "");
        const guid = textOf(piece.person_alias_guid).toLowerCase();

        // The room's chip reads "@all" on screen; a person's chip shows the name, its "@" spoken only.
        if (piece.all === true || (!guid && name.toLowerCase() === "all")) {
            return { kind: "mention", text, mention: "all", name: "@all", label: "@all, everyone in this channel" };
        }

        const isReader = !!guid && guid === props.personAliasGuid.toLowerCase();
        return {
            kind: "mention",
            text,
            mention: isReader ? "you" : "person",
            name,
            label: isReader ? `@${name}, you` : undefined,
            initial: Array.from(name.trim())[0]?.toUpperCase() ?? "",
            hue: String(avatarHue(name))
        };
    }

    /**
     * A link reads as its address without the scheme, as "cedarhill.church/hike"; the scheme says
     * nothing a reader needs, and the link still opens the full address.
     */
    function linkText(text: string): string {
        return text.replace(/^https?:\/\//i, "") || text;
    }

    /** The pieces to draw, or the text as one piece when the server sent none. */
    function drawnPieces(pieces: unknown, text: string | null): DrawnPiece[] {
        if (Array.isArray(pieces) && pieces.length > 0) {
            return withChipPunctuation(pieces.map(drawnPiece).filter((piece): piece is DrawnPiece => piece !== null));
        }

        return text ? [{ kind: "text", text }] : [];
    }

    /** Moves the punctuation that follows a chip onto the chip, so the two never break apart. */
    function withChipPunctuation(pieces: DrawnPiece[]): DrawnPiece[] {
        const out: DrawnPiece[] = [];
        for (const piece of pieces) {
            const previous = out[out.length - 1];
            const trail = piece.kind === "text" ? /^[.,!?;:)]+/.exec(piece.text)?.[0] : undefined;

            if (trail && previous?.kind === "mention" && !previous.trail) {
                out[out.length - 1] = { ...previous, trail };
                const rest = piece.text.slice(trail.length);
                if (rest) {
                    out.push({ ...piece, text: rest });
                }
                continue;
            }

            out.push(piece);
        }
        return out;
    }

    /** One block as drawn: a kind this client knows, else its fallback text. */
    function blockRow(value: unknown): DrawnRow {
        const block = asRecord(value) ?? {};

        if (block.type === "text" || block.type === "context") {
            return {
                kind: "pieces",
                cssClass: `chat-block-${block.type}`,
                testId: `block-${block.type}`,
                pieces: drawnPieces(block.pieces, textOf(block.text))
            };
        }

        if (block.type === "divider") {
            return { kind: "divider" };
        }

        if (block.type === "image" && isSecureAddress(block.url)) {
            return { kind: "image", url: block.url, alt: textOf(block.alt) };
        }

        return {
            kind: "pieces",
            cssClass: "chat-block-fallback",
            testId: "block-fallback",
            pieces: drawnPieces(null, textOf(asRecord(block.fallback)?.text))
        };
    }

    // #endregion Functions
</script>
