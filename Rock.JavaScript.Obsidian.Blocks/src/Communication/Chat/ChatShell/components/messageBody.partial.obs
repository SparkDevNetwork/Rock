<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="chat-message-body" :class="{ 'is-inline': isInline }" data-testid="message-body">
        <template v-for="(row, rowIndex) in rows" :key="rowIndex">
            <hr v-if="row.kind === 'divider'" class="chat-block-divider" data-testid="block-divider" />
            <div v-else-if="row.kind === 'image'" class="chat-block-image" data-testid="block-image">
                <img :src="row.url" :alt="row.alt" />
            </div>
            <div v-else-if="row.kind === 'buttons'" class="chat-block-buttons" data-testid="block-buttons">
                <!-- Busy keeps its label beside the spinner; only a button that cannot run fades. -->
                <Button v-for="(button, buttonIndex) in row.buttons"
                        :key="buttonIndex"
                        size="sm"
                        data-testid="block-button"
                        :disabled="!button.isRunnable || busyKeys.has(`${rowIndex}:${buttonIndex}`)"
                        :busy="busyKeys.has(`${rowIndex}:${buttonIndex}`)"
                        @click="onButton(`${rowIndex}:${buttonIndex}`, button)">{{ button.label }}</Button>
            </div>
            <div v-else :class="row.cssClass" :data-testid="row.testId">
                <template v-for="(piece, pieceIndex) in row.pieces" :key="pieceIndex">
                    <a v-if="piece.kind === 'link'" class="chat-lnk" :href="piece.url" target="_blank" rel="noopener noreferrer nofollow">{{ piece.text }}</a>
                    <span v-else-if="piece.kind === 'mention'" :class="{ 'chat-mn-wrap': !!piece.trail }"><component
                          :is="isOpenable(piece) ? 'button' : 'span'"
                          :type="isOpenable(piece) ? 'button' : undefined"
                          class="chat-mn"
                          :class="[`is-${piece.mention}`, { 'is-punctuated': !!piece.trail }]"
                          :data-testid="piece.isPending ? 'piece-mention-pending' : 'piece-mention'"
                          :data-mention="piece.isPending ? undefined : piece.mention"
                          :aria-label="piece.label"
                          @click="isOpenable(piece) && onPerson(piece, $event)"><span v-if="piece.mention === 'all'" class="chat-mn-glyph chat-all-mark" aria-hidden="true"><Icon name="users" size="xs" /></span><span v-else
                          class="chat-av chat-mn-av"
                          :data-initial="piece.photoUrl ? undefined : piece.initial"
                          :style="{ '--chat-av-hue': piece.hue }"
                          aria-hidden="true"><img v-if="piece.photoUrl" v-reveal="reveal" class="chat-av-photo" :src="piece.photoUrl" alt="" /></span><span class="chat-sr-only">@</span><span class="chat-mn-name">{{ piece.name }}</span></component>{{ piece.trail }}</span>
                    <span v-else-if="piece.kind === 'emoji'" class="chat-emoji" data-testid="piece-emoji" role="img" :aria-label="piece.label" @mouseenter="onEmojiEnter($event, piece.label)" @mouseleave="bodyTip.onPointerLeave">{{ piece.text }}</span>
                    <img v-else-if="piece.kind === 'image'" class="chat-emoji-image" :src="piece.url" :alt="piece.label" @mouseenter="onEmojiEnter($event, piece.label)" @mouseleave="bodyTip.onPointerLeave" />
                    <template v-else>{{ piece.text }}</template>
                </template>
            </div>
        </template>
        <Tip :tip="bodyTip">{{ tipText }}</Tip>
    </div>
</template>

<style scoped>
/*
    A word breaks only where it is wider than the line. break-word, unlike anywhere, still counts
    the longest word in the body's narrowest width, so a bubble sized to its text never shrinks to
    a letter a line.
*/
.chat-message-body {
    white-space: pre-wrap;
    overflow-wrap: break-word;
}

/* Inline, the text runs on in its holder's line; a block, an image or a row of buttons, still stands on its own. */
.chat-message-body.is-inline,
.chat-message-body.is-inline .chat-body-text {
    display: inline;
}

/* The mention chip's look is in the sheet, shared with the editor. */

/*
    A chip that opens a person keeps the chip's look; only the button's own face is taken away. Its
    line is the sheet's, which a button would otherwise have from the browser.
*/
button.chat-mn {
    font-family: inherit;
    font-size: inherit;
    text-align: inherit;
    cursor: pointer;
    border: 0;
}

.chat-lnk {
    color: var(--chat-brand-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
}

.chat-emoji-image {
    height: 1.25em;
    vertical-align: text-bottom;
}

.chat-block-context {
    font-size: var(--chat-fs-small);
    color: var(--chat-muted);
}

.chat-block-divider {
    margin: 6px 0;
}

.chat-block-image img {
    max-width: 100%;
    border-radius: var(--chat-r-inset);
}

/* A block's buttons: a wrapping row of small line buttons under the block before it. */
.chat-block-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    white-space: normal;
}

.chat-block-buttons:not(:first-child) {
    margin-top: 8px;
}
</style>

<script setup lang="ts">
    import { computed, inject, PropType, ref, watch } from "vue";
    import Button from "../ui/button.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import { avatarHue } from "../ui/brand.partial";
    import { useImageReveal, vReveal } from "../ui/imageReveal.partial";
    import { isActionCall } from "../composables/useMessageActions.partial";
    import { isRoomMention } from "../heldMessage.partial";
    import { useChatSession } from "../chatSession.partial";
    import { problemReportKey } from "../problemReport.partial";
    import Tip from "../ui/tip.partial.obs";
    import { useTooltip } from "../ui/tooltip.partial";
    import { MessageAction } from "../types.partial";

    // #region Types

    /** A piece as this client draws it, reduced to the kinds it knows. */
    type DrawnPiece = {
        kind: "text" | "mention" | "link" | "emoji" | "image";
        text: string;
        url?: string;
        label?: string;

        /** A mention's chip: someone else, the reader, or the whole room. */
        mention?: "person" | "you" | "all";

        /** Punctuation that follows a chip with no space, kept on the chip's line. */
        trail?: string;
        name?: string;
        initial?: string;
        hue?: string;

        /** A person's photo, drawn in the chip's face in place of their initial; null for none. */
        photoUrl?: string | null;

        /** A person's chip: the alias it names, as the server sent it. */
        guid?: string;

        /**
         * A chip picked into a send the platform has not stored: drawn in the chip's box so the
         * answer moves nothing, but inert, since the platform has not admitted the mention yet.
         */
        isPending?: boolean;
    };

    /** A block's button, and whether the client may call the action it names. */
    type DrawnButton = MessageAction & { isRunnable: boolean };

    /** One line of the body: the body's own pieces, or one block. */
    type DrawnRow = {
        kind: "pieces" | "divider" | "image" | "buttons";
        pieces?: DrawnPiece[];
        buttons?: DrawnButton[];
        cssClass?: string;
        testId?: string;
        url?: string;
        alt?: string;

        /** The type of a block drawn by its fallback, as the server sent it. */
        fallbackType?: string;
    };

    // #endregion Types

    const props = defineProps({
        /** The body as text, or the sentence shown in place of a deleted or hidden message. */
        text: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The body's pieces as the server built them, or null for a plain body. */
        pieces: {
            type: Array as PropType<unknown[] | null>,
            default: null
        },

        /** The message's blocks, drawn in place of the body when present. */
        blocks: {
            type: Array as PropType<unknown[] | null>,
            default: null
        },

        /** A direct message or group, whose @all chip says "conversation" rather than "channel". */
        isConversation: {
            type: Boolean,
            default: false
        },

        /** Whether the body runs inline in its holder's line, so what the holder writes after it rides at its end. */
        isInline: {
            type: Boolean,
            default: false
        },

        /** Runs a block button's action and shows its sentence, settling once the call has answered. */
        runAction: {
            type: Function as PropType<(button: MessageAction) => Promise<void>>,
            default: null
        },

        /**
         * Draws a person's chip as a button that asks for their card. Off where the body sits in a
         * row that is itself a button, as in the mentions and threads lists, since a button inside
         * a button is no control at all.
         */
        isPersonOpenable: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "person", personAliasGuid: string, anchor: HTMLElement): void;
    }>();

    // #region Values

    const session = useChatSession();

    // The mention chips' photos are faces, so they arrive with the others drawn in the same frame.
    const reveal = useImageReveal({ isShared: true });

    // Absent where nothing provides it, as a body drawn outside the shell.
    const problems = inject(problemReportKey, null);

    /** The buttons whose action is out, by block and button index, each held until it answers. */
    const busyKeys = ref(new Set<string>());

    // An emoji's name shows in the chat's tip, not the browser's title: one tip per body, moved to
    // the emoji under the pointer, as the bar's quick reactions share theirs, so a long feed draws
    // no tip per emoji. A screen reader hears each emoji's own label.
    const tipAnchor = ref<HTMLElement>();
    const tipText = ref("");
    const bodyTip = useTooltip(tipAnchor);

    // #endregion Values

    // #region Computed Values

    /**
     * What is drawn. The server's pieces and blocks are read as untrusted shapes: a kind this
     * client was not built with is drawn by the text the server put beside it, so a released
     * client still shows what later platforms send.
     */
    const rows = computed((): DrawnRow[] => {
        if (Array.isArray(props.blocks) && props.blocks.length > 0) {
            return props.blocks.map(blockRow);
        }

        return [{ kind: "pieces", cssClass: "chat-body-text", pieces: drawnPieces(props.pieces, props.text) }];
    });

    // #endregion Computed Values

    // #region Event Handlers

    /** Runs a button's action once at a time: a second press while it is out does nothing. */
    async function onButton(key: string, button: DrawnButton): Promise<void> {
        if (!button.isRunnable || !props.runAction || busyKeys.value.has(key)) {
            return;
        }

        busyKeys.value = new Set([...busyKeys.value, key]);
        try {
            await props.runAction({ id: button.id, label: button.label, call: button.call });
        }
        finally {
            const next = new Set(busyKeys.value);
            next.delete(key);
            busyKeys.value = next;
        }
    }

    /** Asks for the person a chip names, with the chip, so the card opens beside it. */
    function onPerson(piece: DrawnPiece, event: MouseEvent): void {
        emit("person", piece.guid ?? "", event.currentTarget as HTMLElement);
    }

    /** The body's one tip moves to the emoji under the pointer and names it; an emoji with no name has no tip. */
    function onEmojiEnter(event: MouseEvent, label: string | undefined): void {
        if (!label) {
            return;
        }

        tipAnchor.value = event.currentTarget as HTMLElement;
        tipText.value = label;
        bodyTip.onPointerEnter();
    }

    // #endregion Event Handlers

    // #region Functions

    /** Whether a chip opens a card: a person's, the reader's own included; @all names no one. */
    function isOpenable(piece: DrawnPiece): boolean {
        return props.isPersonOpenable && !piece.isPending && piece.mention !== "all" && !!piece.guid;
    }

    /** Whether an address may be opened as a link: only the web, never script or another scheme. */
    function isWebAddress(value: unknown): value is string {
        return typeof value === "string" && /^https?:\/\/./i.test(value);
    }

    /** Whether an address may be loaded as an image: only https, so a page never mixes content. */
    function isSecureAddress(value: unknown): value is string {
        return typeof value === "string" && /^https:\/\/./i.test(value);
    }

    function asRecord(value: unknown): Record<string, unknown> | null {
        return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Record<string, unknown> : null;
    }

    function textOf(value: unknown): string {
        return typeof value === "string" ? value : "";
    }

    /** One server piece as drawn. A link or image this client does not trust is drawn as its text. */
    function drawnPiece(value: unknown): DrawnPiece | null {
        const piece = asRecord(value);
        if (!piece) {
            return null;
        }

        const text = textOf(piece.text);
        if (piece.type === "mention") {
            return mentionPiece(piece, text);
        }

        // the person's own send not stored yet: the chip's look, opening no one and claiming no admission
        if (piece.type === "pending-mention") {
            return { ...mentionPiece(piece, text), isPending: true, guid: undefined };
        }

        if (piece.type === "link" && isWebAddress(piece.url)) {
            return { kind: "link", text: linkText(text), url: piece.url };
        }

        if (piece.type === "emoji") {
            const label = textOf(piece.label) || text;
            if (typeof piece.emoji === "string" && piece.emoji) {
                return { kind: "emoji", text: piece.emoji, label };
            }

            if (isSecureAddress(piece.image_url)) {
                return { kind: "image", text, url: piece.image_url, label };
            }
        }

        return { kind: "text", text };
    }

    /**
     * A mention as a chip. Only the server makes a mention piece, after it admitted the person,
     * so a chip is never drawn from anything typed; who it names decides its look.
     */
    function mentionPiece(piece: Record<string, unknown>, text: string): DrawnPiece {
        const name = text.replace(/^@/, "");
        const guid = textOf(piece.person_alias_guid).toLowerCase();

        // Every chip shows its name and speaks its "@" only, the room's "all" as a person's name.
        if (isRoomMention(piece)) {
            return { kind: "mention", text, mention: "all", name: "all", label: `@all, everyone in this ${props.isConversation ? "conversation" : "channel"}` };
        }

        // a mention of the signed-in reader draws as the "you" chip
        const isReader = !!guid && guid === session.me.value.personAliasGuid.toLowerCase();
        return {
            kind: "mention",
            text,
            mention: isReader ? "you" : "person",
            name,
            label: isReader ? `@${name}, you` : undefined,
            initial: Array.from(name.trim())[0]?.toUpperCase() ?? "",
            hue: String(avatarHue(name)),
            photoUrl: textOf(piece.avatar_url) || null,
            guid: textOf(piece.person_alias_guid)
        };
    }

    /**
     * A link reads as its address without the scheme, as "cedarhill.church/hike"; the scheme says
     * nothing a reader needs, and the link still opens the full address.
     */
    function linkText(text: string): string {
        return text.replace(/^https?:\/\//i, "") || text;
    }

    /** The pieces to draw, or the text as one piece when the server sent none. */
    function drawnPieces(pieces: unknown, text: string | null): DrawnPiece[] {
        if (Array.isArray(pieces) && pieces.length > 0) {
            return withChipPunctuation(pieces.map(drawnPiece).filter((piece): piece is DrawnPiece => piece !== null));
        }

        return text ? [{ kind: "text", text }] : [];
    }

    /** Moves the punctuation that follows a chip onto the chip, so the two never break apart. */
    function withChipPunctuation(pieces: DrawnPiece[]): DrawnPiece[] {
        const out: DrawnPiece[] = [];
        for (const piece of pieces) {
            const previous = out[out.length - 1];
            const trail = piece.kind === "text" ? /^[.,!?;:)]+/.exec(piece.text)?.[0] : undefined;

            if (trail && previous?.kind === "mention" && !previous.trail) {
                out[out.length - 1] = { ...previous, trail };
                const rest = piece.text.slice(trail.length);
                if (rest) {
                    out.push({ ...piece, text: rest });
                }
                continue;
            }

            out.push(piece);
        }
        return out;
    }

    /** One block as drawn: a kind this client knows, else its fallback text. */
    function blockRow(value: unknown): DrawnRow {
        const block = asRecord(value) ?? {};

        if (block.type === "text" || block.type === "context") {
            return {
                kind: "pieces",
                cssClass: `chat-block-${block.type}`,
                testId: `block-${block.type}`,
                pieces: drawnPieces(block.pieces, textOf(block.text))
            };
        }

        if (block.type === "divider") {
            return { kind: "divider" };
        }

        if (block.type === "image" && isSecureAddress(block.url)) {
            return { kind: "image", url: block.url, alt: textOf(block.alt) };
        }

        // A button names the action it runs; one naming a function the client may not call is
        // drawn, so the block reads as sent, but never pressable.
        if (block.type === "buttons" && Array.isArray(block.buttons) && block.buttons.length > 0) {
            return {
                kind: "buttons",
                buttons: block.buttons.map(value => {
                    const button = asRecord(value) ?? {};
                    return { id: textOf(button.id), label: textOf(button.label), call: textOf(button.call), isRunnable: isActionCall(button.call) };
                })
            };
        }

        return {
            kind: "pieces",
            cssClass: "chat-block-fallback",
            testId: "block-fallback",
            pieces: drawnPieces(null, textOf(asRecord(block.fallback)?.text)),
            fallbackType: textOf(block.type)
        };
    }

    // #endregion Functions

    // #region Watchers

    // The platform learns which blocks its released clients draw by their fallback, by type alone;
    // the report keeps each to once a page load, so a body drawn again is not counted again.
    watch(rows, drawn => {
        for (const row of drawn) {
            if (row.fallbackType !== undefined) {
                problems?.report("block", row.fallbackType);
            }
        }
    }, { immediate: true });

    // #endregion Watchers
</script>
