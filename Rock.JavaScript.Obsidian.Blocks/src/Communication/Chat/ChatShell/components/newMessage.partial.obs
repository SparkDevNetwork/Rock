<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div ref="viewElement"
         class="chat-nd"
         :class="{ 'is-phone': isPhone }"
         role="region"
         :aria-labelledby="titleId"
         data-testid="new-message-view">
        <header class="chat-nd-hdr">
            <IconButton v-if="isPhone"
                        class="chat-nd-back"
                        icon="left"
                        label="Back to conversations"
                        data-testid="nd-back"
                        @click="emit('back')" />
            <span class="chat-nd-hdr-ic" aria-hidden="true"><Icon name="compose" /></span>
            <div class="chat-nd-hdr-title">
                <b :id="titleId" data-testid="nd-title">New message</b>
                <span class="chat-nd-hdr-sub" data-testid="nd-subtitle">{{ subtitle }}</span>
            </div>
            <div class="chat-nd-hdr-actions">
                <IconButton v-if="!isPhone"
                            icon="x"
                            label="Close New message"
                            tooltip="Close"
                            data-testid="nd-close"
                            @click="emit('close')" />
            </div>
        </header>

        <div class="chat-nd-to">
            <PeoplePicker ref="pickerElement"
                          :chosen="chosen"
                          :query="query"
                          :results="results"
                          :isSearching="isSearching"
                          :searchError="searchError"
                          :max="maxOthers"
                          :isDisabled="isLocked"
                          label="To:"
                          placeholder="Type a name"
                          :isAutofocus="isFieldFocusedFirst"
                          isMatchMarked
                          :noneText="noneText"
                          :note="note"
                          :campusNames="campusNames"
                          prefix="nd"
                          labelTestId="nd-to-label"
                          inputTestId="nd-to-input"
                          listTestId="nd-suggestions"
                          @input="onInput"
                          @choose="onChoose"
                          @unchoose="unchoose"
                          @submit="onSubmit"
                          @noMatch="onNoMatch"
                          @tab="onTab"
                          @escape="onEscape"
                          @announce="announce" />
        </div>

        <div class="chat-nd-body">
            <div v-if="chosen.length === 0" class="chat-nd-scroll">
                <div class="chat-nd-start is-empty" data-testid="nd-empty">
                    <span class="chat-nd-empty-ic" aria-hidden="true"><Icon name="compose" /></span>
                    <b>Start a conversation</b>
                    <p>Choose one person for a private conversation, or up to {{ maxOthers }} for a group. You can message people who accept messages from everyone, and people in your private groups.</p>
                </div>
            </div>

            <!-- While the lookup is out nothing is guessed: a quiet line only once it is slow. -->
            <div v-else-if="!isAnswered" class="chat-nd-scroll" aria-busy="true">
                <div v-if="lookup.isSlow" class="chat-nd-look" data-testid="nd-looking"><span class="chat-spinner"></span>Looking for your conversation…</div>
            </div>

            <template v-else>
                <div v-if="isFound" class="chat-nd-found" role="status" data-testid="nd-found">
                    <Avatar v-if="chosen.length === 1" :people="faces.slice(0, 1)" :size="36" />
                    <GroupFace v-else :people="faces" :size="36" />
                    <span class="chat-nd-found-t">
                        <b>You already have this conversation</b>
                        <span>{{ foundTitle }}. What you send goes there.</span>
                    </span>
                    <button type="button" class="chat-nd-btn" data-testid="nd-open" @click="emit('open', lookup.channelId as string)">Open</button>
                </div>

                <!--
                    The conversation found, as a read-only look at its newest messages: acting on a
                    message happens in the conversation itself, so the look is out of reach.
                -->
                <div v-if="isFound && recent && recent.length > 0" class="chat-nd-hist" inert data-testid="nd-history">
                    <slot name="history" />
                </div>

                <div v-else class="chat-nd-scroll">
                    <p v-if="isFound && recent && recent.length === 0" class="chat-nd-none" data-testid="nd-history-empty">No messages yet.</p>

                    <div v-if="!isFound" class="chat-nd-start" data-testid="nd-start">
                        <Avatar v-if="chosen.length === 1" :people="faces.slice(0, 1)" :size="56" />
                        <GroupFace v-else :people="faces" :size="56" />
                        <b data-testid="nd-start-title">{{ startTitle }}</b>
                        <p v-if="chosen.length === 1">This is the start of your conversation with <strong>{{ chosen[0].nick_name }}</strong>. Only the two of you can see it.</p>
                        <p v-else>This is the start of a group conversation. Only the {{ chosen.length + 1 }} people here can see it.</p>
                    </div>

                    <!-- The first message on its way, in the Conversational look its conversation will have. -->
                    <div v-if="pendingPhase" class="chat-nd-pend" data-testid="nd-pending">
                        <div class="chat-nd-bubble">{{ pendingText }}</div>
                        <!-- Not sent where Sending… was; what to do about it waits over the composer. -->
                        <div class="chat-nd-meta" :class="{ 'is-failed': pendingPhase === 'failed' }" data-testid="nd-phase">
                            <template v-if="pendingPhase === 'failed'"><span class="chat-fail-mark"><Icon name="bang" size="xs" /></span>Not sent</template>
                            <template v-else-if="pendingPhase === 'asking'"><span class="chat-spinner"></span>Starting your conversation…</template>
                            <template v-else-if="pendingPhase === 'waiting'"><Icon name="clock" size="xs" />Still setting it up…</template>
                            <template v-else><Icon name="clock" size="xs" />Sending…</template>
                        </div>
                    </div>
                </div>

                <div v-if="refusedText" class="chat-nd-refused-wrap">
                    <div class="chat-nd-refused" role="alert" data-testid="nd-refused">
                        <Icon name="alert" size="sm" />
                        <span class="chat-nd-refused-t">{{ refusedText }}</span>
                        <button v-if="refused"
                                type="button"
                                class="chat-nd-btn"
                                data-testid="nd-refused-remove"
                                @click="emit('unchoose', refused.person.person_alias_guid)">
                            Remove {{ refused.person.nick_name }}
                        </button>
                    </div>
                </div>

                <!-- The conversation's own composer; its key hint gives way to this view's hint below it. -->
                <Composer class="chat-nd-comp"
                          :title="isFound ? foundTitle : startTitle"
                          :isPhone="isPhone"
                          :isDisabled="isLocked"
                          :isLocked="isServiceLocked"
                          :lockedReason="lockedReason"
                          :text="boxText"
                          :isTextKeptOnSend="isTextKeptOnSend(draft)"
                          :emojiSource="emojiSource"
                          conversationKey="new-message"
                          :sendFailure="pendingPhase === 'failed' ? draftFailure : null"
                          :lastFailure="draftNews"
                          @retryFailed="emit('retry')"
                          @discardFailed="emit('discard')"
                          @vue:mounted="onComposerMounted"
                          @send="onSend"
                          @update:text="onText"
                          @emojiPickerOpen="emit('emojiPickerOpen')"
                          @emojiChosen="emit('emojiChosen', $event)" />
                <div class="chat-nd-foot">
                    <span class="chat-nd-hint" data-testid="nd-hint">
                        <template v-if="isLocked">You can send more once the conversation starts.</template>
                        <template v-else-if="isFound"><kbd>Enter</kbd> sends to your conversation with {{ foundTitle }}</template>
                        <template v-else>Your first message starts the conversation.</template>
                    </span>
                </div>
            </template>
        </div>

        <!-- Keyed by count, so the same words are read twice. -->
        <span class="chat-sr-only" aria-live="polite" data-testid="nd-announcement"><span v-if="announcement" :key="announcement.count">{{ announcement.text }}</span></span>
    </div>
</template>

<style scoped>
/* New message, in the conversation's place as Browse channels is: its header, the To field, then the body. */
.chat-nd {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    background: var(--chat-surface);
}

/* The conversation header's own frame, as Browse channels draws it, so the rules align across the columns. */
.chat-nd-hdr {
    display: flex;
    flex: none;
    gap: 12px;
    align-items: center;
    height: 64px;
    padding: 0 12px 0 20px;
    background: var(--chat-surface);
    border-bottom: 1px solid var(--chat-line);
}

.chat-nd.is-phone .chat-nd-hdr {
    padding-left: 12px;
}

.chat-nd-hdr :deep(.chat-nd-back) {
    margin-left: -8px;
}

.chat-nd-hdr-ic {
    --chat-ic-size: 19px;
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-hdr-ic);
}

.chat-nd-hdr-title {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
}

.chat-nd-hdr-title b {
    overflow: hidden;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chat-nd-hdr-sub {
    overflow: hidden;
    font-size: 12.5px;
    color: var(--chat-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* Close's place; kept on a phone, where Back stands in for Close, so the title keeps the same room. */
.chat-nd-hdr-actions {
    display: flex;
    gap: 2px;
    align-items: center;
    margin-left: auto;
}

/* Above the body, so the suggestions it drops over the start block stay on top. */
.chat-nd-to {
    position: relative;
    z-index: 4;
    flex: none;
    width: 100%;
    max-width: 780px;
    padding: 14px 24px 8px;
    margin: 0 auto;
}

.chat-nd.is-phone .chat-nd-to {
    padding-right: 12px;
    padding-left: 12px;
}

.chat-nd-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
}

.chat-nd-scroll {
    flex: 1;
    min-height: 0;
    padding: 4px 0 14px;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: thin;
}

/* The found conversation's feed fills the body as a conversation's does. */
.chat-nd-hist {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
}

.chat-nd-none {
    margin: 24px 0 0;
    font-size: 12.5px;
    color: var(--chat-muted);
    text-align: center;
}

.chat-nd-start {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    padding: 36px 24px 12px;
    text-align: center;
    animation: chat-nd-strip-in var(--chat-t-msg) var(--chat-ease-in);
}

.chat-nd-start.is-empty {
    padding-top: 56px;
}

.chat-nd-start b {
    margin-top: 6px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -.01em;
    text-wrap: balance;
}

.chat-nd-start p {
    max-width: 46ch;
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--chat-muted);
}

.chat-nd-start p strong {
    font-weight: 600;
    color: var(--chat-text-2);
}

.chat-nd-empty-ic {
    --chat-ic-size: 26px;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-dialog);
}

.chat-nd-look {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    font-size: 13px;
    color: var(--chat-muted);
}

.chat-nd-look .chat-spinner {
    width: 13px;
    height: 13px;
}

/* Centred on the 780px column with a 24px gutter, as the To field above it; a group's mark is ringed in its color. */
.chat-nd-found {
    --chat-av-ring: var(--chat-sidebar);

    display: flex;
    flex: none;
    gap: 12px;
    align-items: center;
    max-width: 732px;
    padding: 10px 10px 10px 12px;
    margin: 6px max(24px, calc(50% - 366px)) 4px;
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-lg);
    animation: chat-nd-strip-in var(--chat-t-base) var(--chat-ease-in);
}

.chat-nd.is-phone .chat-nd-found {
    margin-right: 12px;
    margin-left: 12px;
}

.chat-nd-found-t {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
}

.chat-nd-found-t b {
    font-size: 14px;
}

.chat-nd-found-t span {
    font-size: 12.5px;
    color: var(--chat-muted);
}

/* The design's small line button, as Browse channels draws it. */
.chat-nd-btn {
    display: inline-flex;
    flex: none;
    gap: 5px;
    align-items: center;
    justify-content: center;
    height: 28px;
    padding: 0 11px;
    font: inherit;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--chat-text);
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
    border-radius: var(--chat-r-full);
    transition: border-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-nd-btn:hover {
    border-color: var(--chat-icon);
}

/* The pending message: the person's own bubble at the right, its phase under it, set as the feed sets its own messages. */
.chat-nd-pend {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: 14px 20px 0 64px;
}

.chat-nd.is-phone .chat-nd-pend {
    padding-right: 12px;
    padding-left: 44px;
}

.chat-nd-bubble {
    min-width: 0;
    max-width: 100%;
    padding: 6px 13px 7px;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--chat-text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-bubble);
    box-shadow: inset 0 0 0 1px var(--chat-own-hairline);
}

.chat-nd-meta {
    display: flex;
    gap: 6px;
    align-items: center;
    min-height: 16px;
    padding: 1px 12px 0;
    margin-top: 2px;
    font-size: 11.5px;
    color: var(--chat-muted);
}

.chat-nd-meta.is-failed {
    gap: 4px;
    font-weight: 700;
    color: var(--chat-danger-ink);
}

.chat-nd-meta .chat-spinner {
    width: 10px;
    height: 10px;
    border-width: 1.5px;
}

/* The refusal sits at the top of the composer, inside its gutter. */
.chat-nd-refused-wrap {
    flex: none;
    padding: 0 20px 6px;
}

.chat-nd.is-phone .chat-nd-refused-wrap {
    padding-right: 10px;
    padding-left: 10px;
}

.chat-nd-refused {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 8px 8px 8px 12px;
    font-size: 13px;
    color: var(--chat-text);
    background: var(--chat-danger-soft);
    border-radius: var(--chat-r-pop);
    animation: chat-nd-strip-in var(--chat-t-base) var(--chat-ease-in);
}

.chat-nd-refused :deep(.chat-ic) {
    flex: none;
    color: var(--chat-danger-ink);
}

.chat-nd-refused-t {
    flex: 1;
    min-width: 0;
}

/* This view's hint takes the place of the composer's own, in the same foot under the box. */
.chat-nd-comp :deep(.chat-composer-foot) {
    display: none;
}

.chat-nd .chat-nd-comp.chat-composer {
    padding-bottom: 0;
}

.chat-nd-foot {
    display: flex;
    flex: none;
    gap: 10px;
    align-items: center;
    min-height: 16px;
    padding: 6px 34px 14px;
    font-size: 11.5px;
    color: var(--chat-muted);
}

.chat-nd.is-phone .chat-nd-foot {
    padding-right: 26px;
    padding-left: 26px;
}

/* A phone has no room for the key hint under the box. */
.chat-nd.is-phone .chat-nd-hint {
    display: none;
}

/* Rock's theme draws a kbd as a dark key cap; here it is only the key's name in a heavier weight. */
.chat-nd-hint kbd {
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--chat-text-2);
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
}

@keyframes chat-nd-strip-in {
    from {
        opacity: 0;
        transform: translateY(6px);
    }
}

@media (prefers-reduced-motion: reduce) {
    .chat-nd-start,
    .chat-nd-found {
        animation: none;
    }
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, PropType, ref, watch } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { ChatCampusBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatCampusBag";
    import Composer from "./composer.partial.obs";
    import { PickerSource } from "./emojiPicker.partial.obs";
    import { DirectMessageDraft, DirectMessageLookup, DraftPhase, isTextKeptOnSend, PersonRow } from "../composables/useDirectMessage.partial";
    import { SendFailure, SendFailureNews } from "../composables/useSend.partial";
    import { startedTitle } from "../stores/channelStore.partial";
    import { TimelineMessage } from "../types.partial";
    import Avatar, { AvatarPerson } from "../ui/avatar.partial.obs";
    import GroupFace from "../ui/groupFace.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import PeoplePicker from "../ui/peoplePicker.partial.obs";

    const props = defineProps({
        /** Whether the latest service settings prevent sending, even before a room exists. */
        isServiceLocked: {
            type: Boolean,
            default: false
        },

        /** The service's posting sentence, or null for the composer's maintenance sentence. */
        lockedReason: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The most people a conversation holds besides the person starting it, as the platform sets it. */
        maxOthers: {
            type: Number,
            required: true
        },

        /** The people chosen so far, in the order they were chosen. */
        chosen: {
            type: Array as PropType<PersonRow[]>,
            required: true
        },

        /** The people search: the platform lists only people the person may message. */
        search: {
            type: Function as PropType<(query: string) => Promise<PersonRow[]>>,
            required: true
        },

        /** The conversation the people chosen already have, as last looked up. */
        lookup: {
            type: Object as PropType<DirectMessageLookup>,
            required: true
        },

        /**
         * The found conversation's last few messages, oldest first, which the history slot draws;
         * null while they are read, or when the read failed.
         */
        recent: {
            type: Array as PropType<TimelineMessage[] | null>,
            default: null
        },

        /** The found conversation's title as the sidebar draws it, or null. */
        foundTitle: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The draft for new people, holding the box's text and the first message's phase. */
        draft: {
            type: Object as PropType<DirectMessageDraft | null>,
            default: null
        },

        /** The sentence for the last thing that failed, or null. */
        error: {
            type: String as PropType<string | null>,
            default: null
        },

        /** A refusal about one of the people chosen, which offers to take them out. */
        refused: {
            type: Object as PropType<{ person: PersonRow, text: string } | null>,
            default: null
        },

        /** The church's campuses, which name the campus under each person found. */
        campuses: {
            type: Array as PropType<ChatCampusBag[]>,
            default: () => []
        },

        /** What the composer's emoji picker draws, or null for none. */
        emojiSource: {
            type: Object as PropType<PickerSource | null>,
            default: null
        },

        isPhone: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "back"): void,
        (e: "close"): void,
        (e: "choose", person: PersonRow): void,
        (e: "unchoose", personAliasGuid: string): void,
        /** Open the conversation the people chosen already have. */
        (e: "open", channelId: string): void,
        /** The message: to the conversation found, or the first of a new one. */
        (e: "send", body: string): void,
        (e: "edit", body: string): void,
        /** Send the failed first message again. */
        (e: "retry"): void,
        /** Drop the failed first message. */
        (e: "discard"): void,
        (e: "emojiPickerOpen"): void,
        (e: "emojiChosen", code: string): void
    }>();

    // #region Values

    const titleId = `chat-nd-title-${newGuid()}`;

    /**
     * How long typing must pause before the search goes out, an estimate. A search per keystroke
     * would cost the platform a query for every letter of every name typed.
     */
    const searchPauseMs = 250;

    const viewElement = ref<HTMLElement>();
    const pickerElement = ref<InstanceType<typeof PeoplePicker>>();

    const query = ref("");

    /** The last answer for the text typed, or null while none has come for it. */
    const results = ref<PersonRow[] | null>(null);

    /** Why the last search for the text typed failed, in the platform's words, or null. */
    const searchError = ref<string | null>(null);

    /** Whether the pause is running or its search has not answered. */
    const isSearching = ref(false);

    /** "No one to message for …", shown in the note until the text changes. */
    const noOneText = ref<string | null>(null);

    /** The text of the message sent, which the pending message draws while the box moves on. */
    const sentText = ref<string | null>(null);

    /**
     * The box's text. It takes the draft's text whenever the draft or its text changes, so a new
     * empty draft does not show what was typed for other people, and keeps what is typed between.
     */
    const boxText = ref("");

    /** The newest sentence for screen readers, counted so the same words are read twice. */
    const announcement = ref<{ text: string, count: number } | null>(null);

    /**
     * Opened with people already chosen, the message is the next thing to write, so focus goes
     * to it once the lookup answers; opened empty, the To field takes the view's first focus.
     */
    const isFieldFocusedFirst = props.chosen.length === 0;
    let isEditorFocusOwed = !isFieldFocusedFirst;

    let searchTimer: ReturnType<typeof setTimeout> | null = null;

    /**
     * What each phase of the first message on its way says to a screen reader, as its line under
     * the message reads. A failure is said by the composer's strip that offers its choices.
     */
    const phaseWords: Record<Exclude<NonNullable<DraftPhase>, "failed">, string> = {
        asking: "Starting your conversation…",
        waiting: "Still setting it up…",
        trying: "Sending…"
    };

    /** The first message's one key to its strip, which has no row of the sender's. */
    const draftKey = "first-message";

    /** The first message failed with nothing more said: one message, which can be tried again. */
    const draftFailure: SendFailure = { count: 1, reason: null, canRetry: true, localIds: [draftKey] };

    /** How many times the first message has failed, so each failure is said as it happens. */
    const failedCount = ref(0);

    /** Counts the text typed, so an answer for text the person has since changed is dropped. */
    let searchCount = 0;

    // #endregion Values

    // #region Computed Values

    const isLocked = computed((): boolean => props.draft?.status === "starting");

    /** The first message's latest failure, the news its strip says aloud. */
    const draftNews = computed((): SendFailureNews | null => failedCount.value > 0 ? { localId: draftKey, count: failedCount.value } : null);

    const isFound = computed((): boolean => props.lookup.status === "found");

    /** Whether the lookup has said what the people chosen have, which the composer waits for. */
    const isAnswered = computed((): boolean => props.lookup.status === "found" || props.lookup.status === "new");

    const subtitle = computed((): string => {
        if (props.chosen.length === 0) {
            return `Choose up to ${props.maxOthers} people`;
        }

        if (isFound.value) {
            return "You already have this conversation";
        }

        return props.chosen.length === 1 ? "New conversation" : `New group of ${props.chosen.length + 1} people`;
    });

    /** The title the sidebar will give the new conversation, so the name never changes as it starts. */
    const startTitle = computed((): string => startedTitle(props.chosen));

    /** The people chosen, the one face or the group's mark the found strip and the start draw. */
    const faces = computed((): AvatarPerson[] => props.chosen.map(faceOf));

    /** The church's campus names by guid in lower case, which name the campus under each person found. */
    const campusNames = computed((): Record<string, string> => Object.fromEntries(props.campuses
        .filter(campus => campus.guid)
        .map(campus => [campus.guid!.toLowerCase(), campus.name ?? ""])));

    const noneText = computed((): string => `No one found for “${query.value.trim()}”. Can't find someone? They may not accept messages from everyone.`);

    const note = computed((): string => {
        if (noOneText.value) {
            return noOneText.value;
        }

        const count = props.chosen.length;
        if (count >= props.maxOthers) {
            return `${props.maxOthers} people is the most for one conversation. Press Tab to write your message.`;
        }

        return count >= 6 ? `${count} of ${props.maxOthers} people` : "";
    });

    const pendingPhase = computed(() => props.draft?.phase ?? null);

    const pendingText = computed((): string => sentText.value ?? props.draft?.body ?? "");

    /** While the first message is out or failed its text is on the pending message, so the box is empty. */
    const heldText = computed((): string => pendingPhase.value ? "" : props.draft?.body ?? "");

    const refusedText = computed((): string | null => props.refused?.text ?? props.error);

    // #endregion Computed Values

    // #region Event Handlers

    /** The name typed: its search goes out once typing pauses. */
    function onInput(typed: string): void {
        query.value = typed;
        noOneText.value = null;
        cancelSearch();
        const thisSearch = ++searchCount;
        const text = query.value.trim();

        if (text === "") {
            results.value = null;
            searchError.value = null;
            isSearching.value = false;
            return;
        }

        isSearching.value = true;
        searchTimer = setTimeout(async () => {
            searchTimer = null;
            let rows: PersonRow[] = [];
            let failure: string | null = null;
            try {
                rows = await props.search(text);
            }
            catch (error) {
                failure = error instanceof Error && error.message ? error.message : "People could not be searched. Try again.";
            }
            if (thisSearch !== searchCount) {
                return;
            }

            // A failed search says so in the list it would have filled, until the next answer;
            // the picker says what an answer found, or picks from it for an Enter that waited.
            isSearching.value = false;
            searchError.value = failure;
            results.value = rows;
            if (failure) {
                announce(failure);
            }
        }, searchPauseMs);
    }

    /** Enter on an empty To field moves to the message, or at the cap says it is reached. */
    function onSubmit(): void {
        if (props.chosen.length >= props.maxOthers) {
            // The note already says how to move on; focus stays so it is read.
            announce(`${props.maxOthers} people is the most for one conversation.`);
        }
        else if (props.chosen.length > 0) {
            focusEditor();
        }
    }

    /** Enter on a name no one matched: the note says so until the text changes. */
    function onNoMatch(text: string): void {
        noOneText.value = `No one to message for “${text}”`;
        announce(`No one to message for ${text}`);
    }

    /** The next field is the message, not the emoji button that sits before it. */
    function onTab(event: KeyboardEvent): void {
        if (!event.shiftKey && props.chosen.length > 0 && editorElement()) {
            event.preventDefault();
            focusEditor();
        }
    }

    /** Escape with the list closed and no one chosen closes the view, stopped so nothing behind it closes too. */
    function onEscape(event: KeyboardEvent): void {
        if (props.chosen.length === 0) {
            event.stopPropagation();
            emit("close");
        }
    }

    function onComposerMounted(): void {
        if (isEditorFocusOwed) {
            isEditorFocusOwed = false;
            // A phone's keyboard would cover the start block the person has not read yet, and a
            // person already typing in the To field keeps their place there.
            nextTick(() => {
                if (!props.isPhone && !pickerElement.value?.hasFocus()) {
                    focusEditor();
                }
            });
        }
    }

    /**
     * The box's text changed. While the first message is starting the box is locked and clears as
     * its text moves onto the pending message, so that clearing is no edit of the person's: taken
     * as one, it would empty the draft and a refusal would have no text to put back.
     */
    function onText(body: string): void {
        boxText.value = body;
        if (!isLocked.value) {
            emit("edit", body);
        }
    }

    function onSend(body: string): void {
        sentText.value = isFound.value ? null : body;
        emit("send", body);
    }

    // #endregion Event Handlers

    // #region Functions

    function nameOf(person: PersonRow): string {
        return `${person.nick_name} ${person.last_name}`;
    }

    function faceOf(person: PersonRow): AvatarPerson {
        return { name: nameOf(person), photoUrl: person.avatar_url };
    }

    /** A person picked: the name and its search are cleared for the next. */
    function onChoose(person: PersonRow): void {
        cancelSearch();
        searchCount++;
        query.value = "";
        results.value = null;
        searchError.value = null;
        isSearching.value = false;
        // Counted before the choice goes out, since the owner may add the person to the same list
        // before this reads it again.
        const count = props.chosen.length + 1;
        emit("choose", person);
        const full = count >= props.maxOthers ? ` ${props.maxOthers} people is the most for one conversation. Press Tab to write your message.` : "";
        announce(`Added ${nameOf(person)}. ${count} ${count === 1 ? "person" : "people"} chosen.${full}`);
    }

    /** Takes a person back out, saying who, since their chip goes without a word. */
    function unchoose(person: PersonRow): void {
        emit("unchoose", person.person_alias_guid);
        announce(`Removed ${nameOf(person)}.`);
    }

    function editorElement(): HTMLElement | null {
        return viewElement.value?.querySelector<HTMLElement>("[data-testid='composer-input']") ?? null;
    }

    function focusEditor(): void {
        editorElement()?.focus();
    }

    function announce(text: string): void {
        announcement.value = { text, count: (announcement.value?.count ?? 0) + 1 };
    }

    function cancelSearch(): void {
        if (searchTimer !== null) {
            clearTimeout(searchTimer);
            searchTimer = null;
        }
    }

    // #endregion Functions

    // #region Watchers

    watch([heldText, () => props.draft], () => {
        boxText.value = heldText.value;
    }, { immediate: true });

    // A first message that is over, sent or refused, takes its text off the pending message; a
    // refusal puts it back in the box through the draft. Each phase it moves to is told, since it
    // is drawn under a message the person is not looking at.
    watch(pendingPhase, phase => {
        if (!phase) {
            sentText.value = null;
            return;
        }

        if (phase === "failed") {
            failedCount.value++;
        }
        else {
            announce(phaseWords[phase]);
        }
    });

    // A chip's remove button goes with its chip, and a browser drops focus from it to the page, so
    // focus moves to the field to carry on typing; focus somewhere else is left where it is.
    watch(() => props.chosen.length, async (count, before) => {
        const active = document.activeElement;
        if (count >= before || isLocked.value || (active && active !== document.body && !viewElement.value?.contains(active))) {
            return;
        }

        await nextTick();
        pickerElement.value?.focus();
    });

    // #endregion Watchers

    onBeforeUnmount(cancelSearch);
</script>
