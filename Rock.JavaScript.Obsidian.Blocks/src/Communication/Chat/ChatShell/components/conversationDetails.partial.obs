<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Dialog :isOpen="isOpen"
            :title="kind === 'channel' ? 'Channel details' : 'Conversation details'"
            isPanel
            :isPhone="isPhone"
            @close="emit('close')">
        <template #tools>
            <IconButton icon="x" label="Close" data-testid="details-close" @click="emit('close')" />
        </template>

        <div class="chat-rd-id" data-testid="details-identity">
            <ChannelMark v-if="kind === 'channel'" class="chat-rd-mark" data-testid="details-mark" :isPublic="facts.is_public" :imageUrl="facts.icon_url" />
            <Avatar v-else-if="kind === 'person'" :people="[otherFace]" :size="44" />
            <GroupFace v-else class="chat-rd-group" :people="groupFaces" :count="facts.member_count - 1" :size="44" />

            <span class="chat-rd-main">
                <b class="chat-rd-name" data-testid="details-name">{{ title }}</b>
                <span class="chat-rd-meta">
                    <!-- The dots between the parts are drawn for the eye; a screen reader hears commas. -->
                    <template v-for="(item, index) in metaItems" :key="item">
                        <span v-if="index > 0" class="chat-sr-only">, </span>
                        <span class="chat-rd-meta-item" data-testid="details-meta-item">{{ item }}</span>
                    </template>
                </span>
            </span>
        </div>

        <template v-if="kind === 'channel'">
            <p v-if="description" class="chat-rd-desc" data-testid="details-description">{{ description }}</p>

            <!-- Members is a way to the members panel for whoever may see who is here; a plain count for anyone else. -->
            <SettingGroup data-testid="details-facts">
                <SettingRow icon="users"
                            title="Members"
                            :isButton="canSeeRoster"
                            data-testid="details-members"
                            @click="canSeeRoster && emit('members')">
                    <span class="chat-rd-value">{{ facts.member_count.toLocaleString() }}<Icon v-if="canSeeRoster" name="right" size="xs" /></span>
                </SettingRow>
                <SettingRow v-if="leaders.length > 0" icon="star" title="Led by" data-testid="details-leaders">
                    <span class="chat-rd-value is-leaders">
                        <span class="chat-rd-pile"><Avatar :people="leaders" :size="20" /></span>
                        <span>{{ leaders.map(leader => leader.name).join(", ") }}</span>
                    </span>
                </SettingRow>
            </SettingGroup>
        </template>

        <SettingGroup v-else-if="kind === 'group'"
                      label="People"
                      ariaLabel="People in this conversation"
                      isList
                      data-testid="details-people">
            <SettingRow v-for="chip in groupChips" :key="chip.key" role="listitem" data-testid="details-person">
                <template #text>
                    <span class="chat-rd-person"><Avatar :people="[chip]" :size="24" /><span>{{ chip.label }}</span></span>
                </template>
            </SettingRow>
        </SettingGroup>

        <SettingGroup v-if="canRename" class="chat-rn-grp" label="Conversation name" :labelFor="renameId">
            <div class="chat-rn">
                <input :id="renameId"
                       ref="renameElement"
                       v-model="draftName"
                       class="chat-rn-in chat-field-input"
                       data-testid="rename-input"
                       :maxlength="nameMaxLength"
                       autocomplete="off"
                       :placeholder="namesPlaceholder"
                       :readonly="rename.kind === 'saving'"
                       :aria-describedby="`${renameId}-help ${renameId}-note`"
                       @input="isEditedSinceAnswer = true"
                       @keydown.enter.prevent="onRename" />
                <button type="button"
                        class="chat-rd-btn is-brand is-sm"
                        data-testid="rename-save"
                        :disabled="!canSaveName"
                        @click="onRename">Save</button>
            </div>
        </SettingGroup>
        <template v-if="canRename">
            <!-- A failed rename keeps the name typed, so Save beside it is its Try again. -->
            <SettingNote v-if="renameNote" :id="`${renameId}-note`" class="chat-rd-note" :note="renameNote" data-testid="rename-note" @retry="onRenameRetry" />
            <SettingNote v-else-if="countText" :id="`${renameId}-note`" class="chat-rd-note" :note="{ kind: 'info', text: countText }" data-testid="rename-count" />
            <p :id="`${renameId}-help`" class="chat-rd-cap" data-testid="rename-help">Everyone here sees it. Blank shows everyone's names.</p>
        </template>

        <SettingGroup v-if="!facts.is_member && kind === 'channel'">
            <SettingRow icon="info" data-testid="details-callout">
                <template #text><span>Join {{ title }} to choose its notifications and keep it in your sidebar.</span></template>
            </SettingRow>
        </SettingGroup>

        <template v-if="facts.is_member">
            <!-- The person's own settings for the room, each saved at once. -->
            <SettingGroup label="Notifications" isBare data-testid="details-notify">
                <template #default="{ labelId }">
                    <div class="chat-seg"
                         role="radiogroup"
                         :aria-labelledby="labelId"
                         :aria-describedby="prefsNotes.notify ? `${renameId}-notify-err` : undefined"
                         @keydown="onNotifyKeydown">
                        <button v-for="option in notifyOptions"
                                :key="option.value"
                                ref="notifyElements"
                                type="button"
                                class="chat-seg-opt"
                                role="radio"
                                :aria-checked="option.value === notifyMode ? 'true' : 'false'"
                                :tabindex="option.value === shownNotifyMode ? 0 : -1"
                                :data-autofocus="option.value === shownNotifyMode ? '' : undefined"
                                data-testid="notify-option"
                                :data-value="option.value"
                                :aria-describedby="`${renameId}-notify-${option.value}`"
                                @click="onNotify(option.value)">
                            <!-- Described by its mode's own line below, read as the arrows reach it, since arrowing chooses and saves at once. -->
                            <Icon :name="option.icon" size="sm" />{{ option.label }}
                        </button>
                    </div>
                    <span v-for="option in notifyOptions" :id="`${renameId}-notify-${option.value}`" :key="option.value" class="chat-sr-only">{{ option.caption }}</span>
                    <p class="chat-rd-cap" data-testid="notify-caption">{{ notifyCaption }}</p>
                    <SettingNote v-if="prefsNotes.notify"
                                 :id="`${renameId}-notify-err`"
                                 class="chat-rd-note"
                                 :note="prefsNotes.notify"
                                 data-testid="notify-error"
                                 @retry="onNotifyRetry" />
                </template>
            </SettingGroup>

            <SettingGroup label="Sidebar" data-testid="details-sidebar">
                <SettingSwitch name="star"
                               icon="star"
                               title="Star"
                               :isOn="isStarred"
                               :note="prefsNotes.star ?? null"
                               @toggle="emit('star', $event)" />
                <SettingSwitch name="hide"
                               icon="eye-off"
                               title="Hide"
                               description="Until there's a new message"
                               :isOn="isHidden"
                               :note="prefsNotes.hide ?? null"
                               @toggle="emit('hide', $event)" />
            </SettingGroup>

            <SettingGroup v-if="facts.can_leave" data-testid="details-leave-group">
                <div v-if="isConfirmingLeave"
                     class="chat-leave-box"
                     role="group"
                     :aria-labelledby="`${renameId}-leave`"
                     data-testid="leave-confirm"
                     @keydown.esc.stop.prevent="onLeaveCancel">
                    <template v-if="leaveError">
                        <p :id="`${renameId}-leave`" class="chat-set-err" data-testid="leave-error"><Icon name="alert" size="xs" /><span>{{ leaveError }}</span></p>
                    </template>
                    <template v-else>
                        <b :id="`${renameId}-leave`" data-testid="leave-question">Leave {{ title }}?</b>
                        <p data-testid="leave-body">{{ leaveBody }}</p>
                    </template>
                    <!-- Held while leaving, not disabled, since a disabled button drops the focus it holds to the page. -->
                    <div class="chat-rd-actions">
                        <button ref="leaveCancelElement"
                                type="button"
                                class="chat-rd-btn is-line"
                                data-testid="leave-cancel"
                                :aria-disabled="isLeaving ? 'true' : undefined"
                                @click="onLeaveCancel">{{ leaveError ? "OK" : "Cancel" }}</button>
                        <button v-if="!leaveError"
                                type="button"
                                class="chat-rd-btn is-danger"
                                data-testid="leave-go"
                                :aria-disabled="isLeaving ? 'true' : undefined"
                                @click="onLeaveGo">
                            <template v-if="isLeaving"><span class="chat-spinner"></span>Leaving</template>
                            <template v-else>Leave</template>
                        </button>
                    </div>
                </div>
                <SettingRow v-else
                            ref="leaveRow"
                            icon="door"
                            :title="kind === 'channel' ? 'Leave channel' : 'Leave conversation'"
                            isButton
                            isDanger
                            data-testid="details-leave"
                            @click="onLeaveAsk" />
            </SettingGroup>

            <SettingGroup v-else>
                <SettingRow icon="info" data-testid="details-callout">
                    <template #text><span>{{ cannotLeaveText }}</span></template>
                </SettingRow>
            </SettingGroup>
        </template>

        <span class="chat-sr-only" aria-live="polite" data-testid="details-announcement">
            <!-- The news said while the dialog is open, the rooms' or the settings', keyed so the same words are read twice. -->
            <span v-if="said && !said.isAssertive" :key="said.key">{{ said.text }}</span>
        </span>
        <span class="chat-sr-only" aria-live="assertive" data-testid="details-alert"><span v-if="said && said.isAssertive" :key="said.key">{{ said.text }}</span></span>
    </Dialog>
</template>

<style scoped>
.chat-rd-id {
    display: flex;
    gap: 12px;
    align-items: center;
}

.chat-rd-mark {
    --chat-ic-size: 22px;
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-lg);
}

/* The leaders' faces in a pile, ringed by the sheet in the group's own color. */
.chat-rd-pile {
    display: inline-flex;
    flex: none;
}

/* A group's mark, its faces ringed in the dialog's color. */
.chat-rd-group {
    --chat-av-ring: var(--chat-raised);
}

.chat-rd-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.chat-rd-name {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -.01em;
    overflow-wrap: anywhere;
}

.chat-rd-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: 12.5px;
    color: var(--chat-muted);
}

/* The facts joined by 3px dots, as the channel's intro joins them. */
.chat-rd-meta-item ~ .chat-rd-meta-item::before {
    display: inline-block;
    width: 3px;
    height: 3px;
    margin: 0 7px;
    vertical-align: middle;
    content: "";
    background: currentColor;
    border-radius: 50%;
    opacity: .55;
}

.chat-rd-desc {
    margin: 10px 0 0;
    font-size: 13.5px;
    color: var(--chat-text-2);
    overflow-wrap: anywhere;
}

/* A row's value at its end, such as the member count or the leaders' names, quieter than its label. */
.chat-rd-value {
    display: inline-flex;
    flex: none;
    gap: 6px;
    align-items: center;
    max-width: 60%;
    font-size: 13px;
    color: var(--chat-muted);
}

.chat-rd-value.is-leaders > span:last-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-rd-person {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    min-width: 0;
}

/* The line under a control: what the chosen mode means, or what a group's name does. */
.chat-rd-cap {
    margin: 6px 0 0 2px;
    font-size: 12.5px;
    color: var(--chat-muted);
}

/* Notifications: All, Mentions and Off as one segmented control, the chosen one raised. */
.chat-seg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    padding: 3px;
    background: var(--chat-tab-track);
    border-radius: var(--chat-r-lg);
}

.chat-seg-opt {
    display: flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 32px;
    padding: 0 6px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    color: var(--chat-muted);
    background: transparent;
    border: 0;
    border-radius: var(--chat-r-md);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), color var(--chat-t-fast) var(--chat-ease-state), box-shadow var(--chat-t-fast) var(--chat-ease-state);
}

/* A phone's settings sheet gives each segment a larger target. */
.chat-modal.is-sheet .chat-seg-opt {
    height: 40px;
}

.chat-seg-opt:hover:not([aria-checked="true"]) {
    color: var(--chat-text-2);
}

.chat-seg-opt[aria-checked="true"] {
    color: var(--chat-text);
    background: var(--chat-raised);
    box-shadow: var(--chat-shadow-thumb);
}

.chat-seg-opt[aria-checked="true"] :deep(.chat-ic) {
    color: var(--chat-brand-ink);
}

.chat-seg-opt:focus-visible {
    outline-offset: 0;
}

/* The dialog's small buttons: outlined, in the church's color, or in danger. */
.chat-rd-btn {
    display: inline-flex;
    flex: none;
    gap: 6px;
    align-items: center;
    height: 30px;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--chat-text);
    background: transparent;
    border: 0;
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), border-color var(--chat-t-fast) var(--chat-ease-state), color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-rd-btn .chat-spinner {
    width: 12px;
    height: 12px;
}

.chat-rd-btn.is-line {
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
}

.chat-rd-btn.is-line:hover:not(:disabled, [aria-disabled="true"]) {
    border-color: var(--chat-icon);
}

.chat-rd-btn.is-brand {
    color: var(--chat-on-brand);
    background: var(--chat-brand-fill);
}

.chat-rd-btn.is-danger {
    color: var(--chat-on-danger);
    background: var(--chat-danger);
}

.chat-rd-btn.is-danger:hover:not(:disabled, [aria-disabled="true"]) {
    background: var(--chat-danger-hover);
}

/* The small button, as Rename's Save. */
.chat-rd-btn.is-sm {
    gap: 5px;
    height: 28px;
    padding: 0 11px;
    font-size: 12.5px;
}

.chat-rd-btn:disabled,
.chat-rd-btn[aria-disabled="true"] {
    cursor: default;
    opacity: .5;
}

/* The name field fills its row of the group, Save at its end, the row as tall as the group's others. */
.chat-rn {
    display: flex;
    gap: 8px;
    align-items: center;
    min-height: var(--chat-sg-row-min);
    padding: 6px 6px 6px 14px;
}

/* Under .chat-rn so the size out-weighs the shared field's font: inherit, not by load order. */
.chat-rn .chat-rn-in {
    height: 32px;
    font-size: 13.5px;
}

/* A note under a control outside a row: a refusal, or the name's character count. */
.chat-rd-note {
    margin: 6px 0 0 2px;
    font-size: 12.5px;
}

.chat-set-err :deep(.chat-ic) {
    flex: none;
    margin-top: 2px;
}

/* The leave confirm, asked in the Leave row's place in danger's soft color. */
.chat-leave-box {
    padding: 14px 16px;
    background: var(--chat-danger-soft);
    animation: chat-rd-in var(--chat-t-base) var(--chat-ease-in);
}

.chat-leave-box b {
    font-size: 14.5px;
}

.chat-leave-box p {
    margin: 4px 0 12px;
    font-size: 13px;
    color: var(--chat-text-2);
}

.chat-leave-box .chat-rd-btn {
    height: 34px;
}

.chat-set-err {
    display: flex;
    gap: 6px;
    align-items: flex-start;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--chat-danger-ink);
}

/* Stated here too, since the box's own paragraph color would otherwise win over the sentence's danger. */
.chat-leave-box .chat-set-err {
    margin: 0 0 12px;
    color: var(--chat-danger-ink);
}

.chat-rd-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}

@keyframes chat-rd-in {
    from {
        opacity: 0;
        transform: translateY(2px);
    }
}

/* Reduced motion: the leave box only fades in. */
@media (prefers-reduced-motion: reduce) {
    .chat-leave-box {
        animation-name: chat-rd-fade-in;
    }
}

@keyframes chat-rd-fade-in {
    from {
        opacity: 0;
    }
}
</style>

<script setup lang="ts">
    import { computed, nextTick, PropType, ref, watch } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { ChatCampusBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatCampusBag";
    import { failureNote } from "../composables/saveRule.partial";
    import { NotifyMode, notifyOptionsFor, PrefsState, RoomPrefs } from "../composables/usePrefs.partial";
    import { LeaveState, RenameState, RoomAnnouncement } from "../composables/useRooms.partial";
    import { failedWords, finalWords, offlineWords } from "../errors.partial";
    import { ChannelFacts, ChannelLeader } from "../types.partial";
    import Avatar, { AvatarPerson } from "../ui/avatar.partial.obs";
    import ChannelMark from "../ui/channelMark.partial.obs";
    import { peopleCountWords } from "../ui/face.partial";
    import GroupFace from "../ui/groupFace.partial.obs";
    import Dialog from "../ui/dialog.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import SettingGroup from "../ui/settingGroup.partial.obs";
    import SettingNote, { Note } from "../ui/settingNote.partial.obs";
    import SettingRow from "../ui/settingRow.partial.obs";
    import SettingSwitch from "../ui/settingSwitch.partial.obs";
    import { HeaderRoomKind } from "./chatHeader.partial.obs";

    const props = defineProps({
        /** Whether the dialog is shown; kept mounted and closed, it plays its exit and gives focus back. */
        isOpen: {
            type: Boolean,
            default: true
        },

        /** What the room is, which decides its identity, its Leave words and whether it can be named. */
        kind: {
            type: String as PropType<HeaderRoomKind>,
            required: true
        },

        /** The room's title as the sidebar and header show it, with no "#". */
        title: {
            type: String,
            required: true
        },

        /** What chat_get_channel answered about the room. */
        facts: {
            type: Object as PropType<ChannelFacts>,
            required: true
        },

        /** A group's own name, or null when it shows its members' names. */
        groupName: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether Rock lets the person rename this room, as its members door answered when the details opened. */
        canRename: {
            type: Boolean,
            default: false
        },

        /** The longest name a conversation carries, as the platform sets it. */
        nameMaxLength: {
            type: Number,
            required: true
        },

        /** The church's campuses, which name the room's or the person's campus. */
        campuses: {
            type: Array as PropType<ChatCampusBag[]>,
            default: () => []
        },

        /** The church's name, which the leave confirm says the group is at. */
        organizationName: {
            type: String,
            default: ""
        },

        /** The person's own name and photo, for their chip in a group. */
        personName: {
            type: String,
            default: ""
        },

        personPhotoUrl: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Where this room's Leave is, as the rooms keep it. */
        leave: {
            type: Object as PropType<LeaveState>,
            required: true
        },

        /** Where this group's Rename is, as the rooms keep it. */
        rename: {
            type: Object as PropType<RenameState>,
            required: true
        },

        /** Whether the reader may see who is in the room, which makes its member count a way to the members panel. */
        canSeeRoster: {
            type: Boolean,
            default: false
        },

        /** The rooms' newest sentence for screen readers; only one said while the dialog is open is read here. */
        announcement: {
            type: Object as PropType<RoomAnnouncement | null>,
            default: null
        },

        isPhone: {
            type: Boolean,
            default: false
        },

        /** The room's notify mode for the person, as their sidebar row holds it. */
        notifyMode: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether the room is in the person's Starred, and whether they hid it from this screen. */
        isStarred: {
            type: Boolean,
            default: false
        },

        isHidden: {
            type: Boolean,
            default: false
        },

        /** The note under each of the room's settings: what a change means, or a failed save's. */
        prefsNotes: {
            type: Object as PropType<RoomPrefs["notes"]>,
            default: () => ({})
        },

        /** The settings' newest sentence for screen readers. */
        prefsAnnouncement: {
            type: Object as PropType<PrefsState["announcement"]>,
            default: null
        }
    });

    const emit = defineEmits<{
        /** The close button, Escape or the scrim. */
        (e: "close"): void;

        /** The member count, which opens the members panel. */
        (e: "members"): void;
        /** A notify mode was chosen other than the room's own. */
        (e: "notify", mode: NotifyMode): void;

        /** The Star or Hide switch, with the value it asks for. */
        (e: "star", isStarred: boolean): void;
        (e: "hide", isHidden: boolean): void;

        /** Leave was confirmed. */
        (e: "leave"): void;

        /** Save or Enter with a changed name, trimmed; blank goes back to everyone's names. */
        (e: "rename", name: string): void;
    }>();

    // #region Values

    /** Ties the name field to its label and notes, and the leave box to its question, once per dialog. */
    const renameId = `chat-rd-${newGuid()}`;

    const draftName = ref(props.groupName ?? "");

    /**
     * Whether the name was typed in since the door last answered, which replaces the answer's
     * note with the count, as a fresh edit makes the old answer stale.
     */
    const isEditedSinceAnswer = ref(false);

    const isConfirmingLeave = ref(false);

    /** Whether Leave was asked in this confirm, so an answer to an earlier ask is never shown in it. */
    const hasAskedLeave = ref(false);

    /** The Leave row, whose own element takes focus back when the confirm is cancelled. */
    const leaveRow = ref<{ $el: HTMLElement } | null>(null);
    const leaveCancelElement = ref<HTMLButtonElement>();
    const renameElement = ref<HTMLInputElement>();

    /** The rooms' announcement count as the dialog opened, so only news said since is read here. */
    const announcedBefore = ref(props.isOpen ? props.announcement?.count ?? 0 : Number.POSITIVE_INFINITY);

    /** The newest sentence said while the dialog is open, the rooms' or the settings'. */
    const said = ref<{ text: string, isAssertive: boolean, key: string } | null>(null);

    const notifyElements = ref<HTMLButtonElement[]>([]);

    /** The count shows from this many characters short of the most a name may hold. */
    const countShortOf = 10;

    const leaveFailed = failedWords("Couldn't leave.");
    const renameFailed = failedWords("Couldn't save the name.");

    // #endregion Values

    // #region Computed Values

    const otherFace = computed((): AvatarPerson => {
        const other = props.facts.people[0];
        return { name: other ? fullName(other) || props.title : props.title, photoUrl: other?.avatar_url ?? null };
    });

    const groupFaces = computed((): AvatarPerson[] => props.facts.people.map(person => ({ name: fullName(person), photoUrl: person.avatar_url })));

    /** The line under the name: what kind of room it is and where, each part joined by a dot. */
    const metaItems = computed((): string[] => {
        const facts = props.facts;

        if (props.kind === "channel") {
            const campus = campusName(facts.campus_id);
            return [facts.is_public ? "Public" : "Private", ...(campus ? [campus] : []), ...(facts.group_type_name ? [facts.group_type_name] : [])];
        }

        // A person's campus is on their card, not here.
        if (props.kind === "person") {
            return ["Direct message"];
        }

        return [peopleCountWords(facts.member_count), "Group message"];
    });

    /** The description as a sentence, or null to leave it out. */
    const description = computed((): string | null => {
        const text = props.facts.description?.trim() ?? "";
        if (!text) {
            return null;
        }

        return /[.!?]$/.test(text) ? text : `${text}.`;
    });

    /** Up to three listed leaders, as the channel's intro names them. */
    const leaders = computed((): AvatarPerson[] => props.facts.leaders.slice(0, 3).map(leader => ({ name: fullName(leader), photoUrl: leader.avatar_url })));

    /** Everyone in a group, the person first and marked as them. */
    const groupChips = computed((): Array<AvatarPerson & { key: string, label: string }> => [
        { key: "you", name: props.personName, photoUrl: props.personPhotoUrl, label: `${props.personName} (you)` },
        ...props.facts.people.map(person => ({ key: person.person_alias_guid, name: fullName(person), photoUrl: person.avatar_url, label: fullName(person) }))
    ]);

    /** The members' first names, which is what a blank name shows. */
    const namesPlaceholder = computed((): string => props.facts.people.map(person => person.nick_name ?? "").filter(name => name !== "").join(", "));

    const canSaveName = computed((): boolean => props.rename.kind !== "saving" && draftName.value.trim() !== (props.groupName ?? ""));

    /**
     * Why the rename failed, under the field until the name is typed in again, with Try again
     * asking the same name once more where another try can pass. A saved name says nothing: the
     * title shows it.
     */
    const renameNote = computed((): Note | null => {
        if (isEditedSinceAnswer.value) {
            return null;
        }

        switch (props.rename.kind) {
            // Rock's door decided, so the same name would be refused again; Save asks for another.
            case "refused":
                return failureNote(finalWords(props.rename.text), onRename);

            case "offline":
                return failureNote(offlineWords, onRename);

            case "failed":
                return failureNote(renameFailed, onRename);

            default:
                return null;
        }
    });

    /** The three modes, in words chosen by the room's kind. */
    const notifyOptions = computed(() => notifyOptionsFor(props.kind));

    /** The mode Tab lands on: the room's own, or the first where it has none. */
    const shownNotifyMode = computed((): string => notifyOptions.value.some(option => option.value === props.notifyMode) ? props.notifyMode ?? "all" : "all");

    /** The one line under the control, saying what only the mode Tab lands on means. */
    const notifyCaption = computed((): string => notifyOptions.value.find(option => option.value === shownNotifyMode.value)?.caption ?? "");

    /** The rooms' newest sentence, once it is one said since the dialog opened. */
    const shownAnnouncement = computed((): RoomAnnouncement | null => props.announcement && props.announcement.count > announcedBefore.value ? props.announcement : null);

    const countText = computed((): string | null => draftName.value.length >= props.nameMaxLength - countShortOf ? `${draftName.value.length} of ${props.nameMaxLength} characters` : null);

    /** The leave as this confirm sees it: idle until it asks, so an earlier answer is never shown. */
    const shownLeave = computed((): LeaveState => hasAskedLeave.value ? props.leave : { kind: "idle" });

    const isLeaving = computed((): boolean => shownLeave.value.kind === "leaving");

    /** What stopped the leave, in the door's own words, in the question's place. */
    const leaveError = computed((): string | null => {
        const state = shownLeave.value;
        if (state.kind === "refused") {
            return state.text;
        }

        if (state.kind === "failed") {
            return leaveFailed.alone;
        }

        return state.kind === "offline" ? offlineWords.alone : null;
    });

    /** What leaving means for this room: a public channel can be joined again, a private one or a group cannot. */
    const leaveBody = computed((): string => {
        if (props.kind === "group") {
            return "The others will see that you left. To come back, someone in the conversation will need to add you.";
        }

        const leaving = `You'll stop getting its messages and leave the group at ${props.organizationName}.`;
        return props.facts.is_public ? `${leaving} You can join again from Browse channels.` : `${leaving} To come back, a leader will need to add you.`;
    });

    const cannotLeaveText = computed((): string => props.kind === "channel"
        ? "This channel can't be left. Turn notifications off instead."
        : "A conversation between two people can't be left. Hide it instead.");

    // #endregion Computed Values

    // #region Functions

    /** A person's name as the chat shows it. */
    function fullName(person: ChannelLeader): string {
        return `${person.nick_name ?? ""} ${person.last_name ?? ""}`.trim();
    }

    function campusName(campusId: string | null | undefined): string | null {
        const id = campusId?.toLowerCase();
        return id ? props.campuses.find(campus => campus.guid.toLowerCase() === id)?.name ?? null : null;
    }

    // #endregion Functions

    // #region Event Handlers

    function onNotify(mode: NotifyMode): void {
        if (mode !== props.notifyMode) {
            emit("notify", mode);
        }
    }

    /** Try again takes its button away, so the mode it chose again takes focus. */
    async function onNotifyRetry(): Promise<void> {
        await nextTick();
        notifyElements.value.find(element => element.getAttribute("aria-checked") === "true")?.focus();
    }

    /** The arrows move between the modes and choose as they go, wrapping round, as a radio group does. */
    function onNotifyKeydown(event: KeyboardEvent): void {
        const step = event.key === "ArrowDown" || event.key === "ArrowRight" ? 1 : event.key === "ArrowUp" || event.key === "ArrowLeft" ? -1 : 0;
        const at = notifyElements.value.indexOf(event.target as HTMLButtonElement);
        if (step === 0 || at < 0) {
            return;
        }

        event.preventDefault();
        const next = (at + step + notifyOptions.value.length) % notifyOptions.value.length;
        notifyElements.value[next]?.focus();
        onNotify(notifyOptions.value[next].value);
    }

    /** Try again takes its button away, so the name it asked again takes focus. */
    async function onRenameRetry(): Promise<void> {
        await nextTick();
        renameElement.value?.focus();
    }

    function onRename(): void {
        if (canSaveName.value) {
            emit("rename", draftName.value.trim());
        }
    }

    async function onLeaveAsk(): Promise<void> {
        hasAskedLeave.value = false;
        isConfirmingLeave.value = true;
        await nextTick();
        // Cancel first, so Enter never leaves by accident.
        leaveCancelElement.value?.focus();
    }

    async function onLeaveCancel(): Promise<void> {
        if (isLeaving.value) {
            return;
        }

        isConfirmingLeave.value = false;
        await nextTick();
        leaveRow.value?.$el.focus();
    }

    function onLeaveGo(): void {
        if (isLeaving.value) {
            return;
        }

        hasAskedLeave.value = true;
        emit("leave");
    }

    // #endregion Event Handlers

    // #region Watchers

    // A refusal takes the question's place with OK, which takes focus so the sentence is not missed.
    watch(leaveError, async error => {
        if (error && isConfirmingLeave.value) {
            await nextTick();
            leaveCancelElement.value?.focus();
        }
    });

    // A save that goes back to idle has landed, so the field holds the name as it was saved.
    watch(() => props.rename.kind, (kind, was) => {
        isEditedSinceAnswer.value = false;
        if (kind === "idle" && was === "saving") {
            draftName.value = draftName.value.trim();
        }
    });

    // The rooms' news and the settings' are read in the one live region, the newest last.
    watch(shownAnnouncement, announcement => {
        if (announcement) {
            said.value = { text: announcement.text, isAssertive: announcement.isAssertive, key: `room-${announcement.count}` };
        }
    });

    watch(() => props.prefsAnnouncement, announcement => {
        if (announcement && props.isOpen) {
            said.value = { text: announcement.text, isAssertive: announcement.isAssertive, key: `prefs-${announcement.count}` };
        }
    });

    // Each opening reads only the news said from then on.
    watch(() => props.isOpen, isOpen => {
        announcedBefore.value = isOpen ? props.announcement?.count ?? 0 : Number.POSITIVE_INFINITY;
        said.value = null;
    });

    // A name changed elsewhere, or saved here and read back, is what the field now holds.
    watch(() => props.groupName, name => {
        draftName.value = name ?? "";
    });

    // #endregion Watchers

</script>
