<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Transition name="chat-veil" @beforeLeave="onBeforeLeave">
        <div v-if="!isRevealed"
             class="chat-veil"
             :class="`is-${region}`"
             data-testid="page-veil"
             :data-region="region"
             :data-look="kind">
            <!--
                The first load's stand-in for a region: opaque over it until the region is revealed, so
                the frame is at its final layout from mount and the real content crossfades in under
                it. The marks wait (the caller's) so a quick load never flashes them. The region under
                it is out of reach until then, and once revealed the leaving veil takes no input, so no
                click or key is ever lost between the two.
            -->
            <span class="chat-sr-only">{{ region === "sidebar" ? "Loading conversations" : "Loading the conversation" }}</span>

            <template v-if="region === 'sidebar'">
                <!-- A phone's start that is waiting says so above the rows, wrapping rather than cut. -->
                <div v-if="statusLine" class="chat-veil-status is-list" aria-hidden="true" data-testid="veil-status">
                    <Dot class="chat-veil-dot" tone="info" pulse />
                    <span :key="statusLine" class="chat-veil-status-words">{{ statusLine }}</span>
                </div>
                <!-- The list's own sections, so nothing changes shape when it arrives: channels, then direct messages. -->
                <div v-if="isMarksShown" class="chat-veil-marks" aria-hidden="true" data-testid="veil-marks">
                    <div class="chat-veil-sec" data-testid="veil-section">
                        <h3 class="chat-veil-heading chat-section-label chat-list-heading" data-testid="veil-heading">Channels</h3>
                        <Skeleton v-for="width in channelWidths" :key="width" shape="channel" :widths="[width]" />
                    </div>
                    <div class="chat-veil-sec" data-testid="veil-section">
                        <h3 class="chat-veil-heading chat-section-label chat-list-heading" data-testid="veil-heading">Direct messages</h3>
                        <Skeleton v-for="width in personWidths" :key="width" shape="person" :widths="[width, 32]" />
                    </div>
                </div>
            </template>

            <template v-else>
                <!-- The header's rule and the composer's box are the frame's own, so they stand from mount. -->
                <div class="chat-veil-header" aria-hidden="true" data-testid="veil-header">
                    <!-- A start that is waiting says so in the second line's place, where "Reconnecting…" sits once chat has started. -->
                    <Skeleton v-if="isMarksShown" shape="header" :isTile="kind === 'channel'" :widths="kind === 'channel' && !statusLine ? [22, 40] : [22]">
                        <span v-if="statusLine" class="chat-veil-status" aria-hidden="true" data-testid="veil-status">
                            <Dot class="chat-veil-dot" tone="info" pulse />
                            <span :key="statusLine" class="chat-veil-status-words">{{ statusLine }}</span>
                        </span>
                    </Skeleton>
                </div>

                <div class="chat-veil-feed" aria-hidden="true">
                    <template v-if="isMarksShown">
                        <!-- Every other row shorter, so the column reads as messages rather than stripes. -->
                        <template v-if="kind === 'channel'">
                            <Skeleton v-for="index in 5" :key="index" shape="group" :widths="index % 2 === 0 ? [46, 30] : [64, 40]" data-testid="veil-row" />
                        </template>
                        <template v-else>
                            <Skeleton v-for="index in 5" :key="index" shape="bubble" :isOwn="index % 3 === 0" :widths="[index % 2 === 0 ? 100 : 72]" data-testid="veil-row" />
                        </template>
                    </template>
                </div>

                <div class="chat-veil-composer" aria-hidden="true"></div>
            </template>
        </div>
    </Transition>
</template>

<style scoped>
.chat-veil {
    position: absolute;
    inset: 0;
    z-index: var(--chat-z-veil);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--chat-surface);
    cursor: progress;
}

/* The list's own ground, since the veil lies over rows that sit on it. */
.chat-veil.is-sidebar {
    padding: 4px 8px 12px;
    background: var(--chat-sidebar);
}

/*
    A section's heading, the list's own heading box in the list's place, so the words stand still
    when the list takes over from the veil. The list's heading line is as tall as its 26px add
    button, the words centred in it, so the veil's padding takes the button's place.
*/
.chat-veil-heading {
    padding: 19px 8px 9px 10px;
}

.chat-veil-header {
    display: flex;
    flex: none;
    gap: 12px;
    align-items: center;
    height: 64px;
    padding: 0 12px 0 20px;
    border-bottom: 1px solid var(--chat-line);
}

/*
    The start's status line, in the header's second line type. It wraps rather than ellipsizes, so
    "let your church know" is never cut on a narrow column or a phone; its words change in place.
*/
.chat-veil-status {
    font-size: var(--chat-fs-ui);
    line-height: 17px;
    color: var(--chat-muted);
    animation: chat-reveal-in var(--chat-t-base) var(--chat-ease-in) both;
}

.chat-veil-status.is-list {
    flex: none;
    padding: 8px;
}

/* The dot before the words, on their line. */
.chat-veil-dot {
    margin-right: 6px;
    vertical-align: 1px;
}

.chat-veil-status-words {
    animation: chat-fade-in var(--chat-t-fast) var(--chat-ease-in) both;
}

.chat-veil-feed {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 18px;
    justify-content: flex-end;
    min-height: 0;
    padding: 28px 0 38px;
    overflow: hidden;
}

/* The composer's box, which the real one takes over: same margins, same rule. */
.chat-veil-composer {
    flex: none;
    height: 52px;
    margin: 0 20px 14px;
    background: var(--chat-surface);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-field);
    box-shadow: var(--chat-shadow-composer);
}

/* The veil goes as the content under it comes in. */
.chat-veil-leave-active {
    transition: opacity var(--chat-d-skel-out) var(--chat-ease-out);
}

.chat-veil-leave-to {
    opacity: 0;
}
</style>

<script setup lang="ts">
    import { RoomLook } from "../pageLoad.partial";
    import Dot from "../ui/dot.partial.obs";
    import Skeleton from "../ui/skeleton.partial.obs";

    defineProps<{
        /** The part of the frame this stands in for. */
        region: "sidebar" | "main";

        /** Whether the region has been revealed, which takes the veil away. */
        isRevealed: boolean;

        /** Whether the marks are drawn: from the first paint until both regions reveal. */
        isMarksShown: boolean;

        /** The room the column's marks are shaped for. */
        kind: RoomLook;

        /**
         * What a start still signing in says, drawn for the eye only, or null for nothing; the
         * frame gives it to the one veil in view and says it to a screen reader itself.
         */
        statusLine?: string | null;
    }>();

    /** The widths of the list's rows, varied so a column of them reads as names rather than stripes. */
    const channelWidths = [58, 44, 66];
    const personWidths = [50, 40, 62, 48];

    /**
     * The region is revealed and the veil fades out over it: inert from that moment, to pointer
     * and focus alike, so the first click on what it uncovers reaches it rather than the veil.
     */
    function onBeforeLeave(element: Element): void {
        element.setAttribute("inert", "");
    }

</script>
