<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <form class="chat-composer" @submit.prevent="onSubmit">
        <textarea v-model="text"
                  class="form-control chat-composer-input"
                  rows="2"
                  placeholder="Write a message"
                  data-testid="composer-input"
                  :disabled="isDisabled"
                  @keydown="onKeydown"></textarea>
        <button type="submit"
                class="btn btn-primary"
                data-testid="composer-send"
                :disabled="isDisabled || text.trim() === ''">
            Send
        </button>
    </form>
</template>

<style scoped>
.chat-composer {
    display: flex;
    gap: 8px;
    align-items: flex-end;
    padding: 8px 12px;
    border-top: 1px solid var(--color-interface-soft, #dfe0e1);
}

.chat-composer-input {
    flex: 1;
    resize: none;
}
</style>

<script setup lang="ts">
    import { PropType, ref, watch } from "vue";
    import { textAfterSend } from "../composables/useSend.partial";

    const props = defineProps({
        isDisabled: {
            type: Boolean,
            default: false
        },

        /**
         * Text the shell holds for the person, put back in the box whenever it changes. A draft's
         * first message has no row in a feed to keep it on, so the draft holds it here instead.
         */
        heldText: {
            type: String,
            default: ""
        },

        /**
         * What holds the text, such as the draft on screen. The box takes the held text again
         * whenever this changes, even when the text is the same, so a new empty draft does not
         * open showing what was typed in a channel.
         */
        heldBy: {
            type: Object as PropType<object | null>,
            default: null
        },

        /**
         * Whether the box keeps its text when it hands it over. A draft's first message Rock
         * refuses has no row in a feed to keep it on, and the same text refused twice leaves the
         * held text unchanged, so only the box itself can keep it.
         */
        isTextKeptOnSend: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "send", body: string): void;
        (e: "edit", body: string): void
    }>();

    // #region Values

    const text = ref("");

    // #endregion Values

    // #region Event Handlers

    /**
     * Hands the text to the shell and clears the box, unless it is kept. A send that fails keeps
     * its text on its own row in the feed with a retry, so clearing there loses nothing.
     */
    function onSubmit(): void {
        if (text.value.trim() === "") {
            return;
        }

        emit("send", text.value);
        text.value = textAfterSend(text.value, props.isTextKeptOnSend);
    }

    /** Enter sends; Shift and Enter starts a new line. */
    function onKeydown(event: KeyboardEvent): void {
        if (event.key === "Enter" && !event.shiftKey && !event.isComposing) {
            event.preventDefault();
            onSubmit();
        }
    }

    // #endregion Event Handlers

    // #region Watchers

    watch([() => props.heldText, () => props.heldBy], ([held]) => {
        text.value = held;
    });

    // The shell keeps a failed draft's text when the person leaves it, so it is told what the
    // box holds now, not only what was last sent.
    watch(text, value => {
        emit("edit", value);
    });

    // #endregion Watchers
</script>
