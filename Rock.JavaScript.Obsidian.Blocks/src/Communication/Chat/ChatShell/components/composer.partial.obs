<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="chat-composer" :class="{ 'is-channel': isChannel, 'is-thread': isThread, 'is-phone': isPhone }" @dragover="onDragOver" @drop="onDrop">
        <!--
            The person's failed sends here, each marked Not sent on its message: what happened, the
            reason and the choices, by the box they type in. Over a locked box too, so a send that
            cannot go can still be deleted; Try again waits for the box to open. Its going gives
            back the space it held smoothly, so the feed above does not jump. Keyed by the place,
            so moving to another one takes the strip with it rather than playing its exit there.
        -->
        <Transition name="chat-strip" :key="conversationKey">
            <div v-if="sendFailure" ref="stripElement" class="chat-composer-failed-wrap">
                <div class="chat-composer-failed" data-testid="composer-failed">
                    <span class="chat-composer-failed-text">
                        <span class="chat-fail-mark"><Icon name="bang" size="xs" /></span>
                        <b data-testid="composer-failed-lead">{{ failedLead }}</b>
                        <span v-if="failedReason" class="chat-composer-failed-reason" data-testid="composer-failed-reason">{{ failedReason }}</span>
                    </span>
                    <span class="chat-composer-failed-acts">
                        <button v-if="isRetryOffered"
                                type="button"
                                class="chat-ls-btn is-retry"
                                data-testid="composer-failed-retry"
                                @click="onRetryFailed"><Icon name="refresh" size="xs" />Try again</button>
                        <button type="button"
                                class="chat-ls-btn"
                                data-testid="composer-failed-discard"
                                @click="onDiscardFailed"><Icon name="trash" size="xs" />{{ sendFailure.count > 1 ? "Delete all" : "Delete" }}</button>
                    </span>
                </div>
            </div>
        </Transition>

        <!-- A failure said once as it happens; keyed, so the same words are read again for the next one. -->
        <span class="chat-sr-only" aria-live="assertive" data-testid="composer-failed-announcement"><span v-if="failedAnnouncement" :key="failedAnnouncement.count">{{ failedAnnouncement.text }}</span></span>

        <!-- A paused service, or a room the person cannot post in, in the server's own words. -->
        <div v-if="isClosed" ref="lockedElement" class="chat-composer-locked" tabindex="-1" data-testid="composer-locked">
            <Icon name="lock" />
            <span>{{ lockedReason || "Sending is paused for maintenance." }}</span>
        </div>

        <template v-else>
            <!-- The files waiting to go with the next send, each uploading as it was picked. -->
            <Attachments v-if="tray" :tray="tray" />
            <span v-if="isTextAsked" class="chat-composer-note" data-testid="composer-text-required">An announcement needs a message with its files.</span>

            <div v-if="quote" class="chat-composer-quote" data-testid="composer-quote">
                <Icon name="reply" size="sm" />
                <span class="chat-composer-quote-main">
                    <b>{{ quoteTitle }}</b>
                    <span data-testid="composer-quote-preview">{{ quotePreview }}</span>
                </span>
                <IconButton icon="x" icon-size="sm" label="Cancel quote" @click="emit('cancelQuote')" />
            </div>

            <form ref="boxElement" class="chat-composer-box" @submit.prevent="onSubmit" @focusin="onBoxFocusIn" @focusout="onBoxFocusOut" @paste.capture="onPaste">
                <IconButton ref="emojiButton"
                            icon="smile"
                            label="Add emoji"
                            tooltip="Emoji"
                            aria-haspopup="dialog"
                            :aria-expanded="isEmojiOpen ? 'true' : 'false'"
                            :isTooltipDisabled="isEmojiOpen"
                            :disabled="isDisabled"
                            data-testid="composer-emoji"
                            @click="onEmojiClick" />
                <template v-if="tray">
                    <IconButton icon="paperclip"
                                label="Attach files"
                                tooltip="Attach"
                                :disabled="isDisabled"
                                data-testid="composer-attach"
                                @click="fileInput?.click()" />
                    <input ref="fileInput"
                           type="file"
                           multiple
                           class="chat-sr-only"
                           tabindex="-1"
                           aria-hidden="true"
                           data-testid="composer-file-input"
                           @change="onFilesPicked" />
                </template>
                <ChipEditor ref="editor"
                            :text="text"
                            :pieces="mentions"
                            class="chat-composer-input"
                            :placeholder="placeholder"
                            :isDisabled="isDisabled"
                            :isConversation="!isChannel"
                            :people="mentionSource?.people ?? []"
                            :conversationKey="conversationKey"
                            data-testid="composer-input"
                            @update:text="emit('update:text', $event)"
                            @mention="emit('mention', $event)"
                            @send="onSubmit"
                            @upWhenEmpty="emit('editLast')"
                            @mentionQuery="onMentionQuery" />
                <button type="submit"
                        class="chat-composer-send"
                        :class="{ 'is-ready': isReady }"
                        aria-label="Send"
                        data-testid="composer-send"
                        :disabled="isDisabled || !isReady">
                    <Icon name="arrow-up" />
                </button>
            </form>

            <div class="chat-composer-foot">
                <!-- The label names the switch and passes a press on its words to it. -->
                <label v-if="isThread" class="chat-composer-also" data-testid="composer-also">
                    <Switch size="sm" :isOn="isAlsoSent" @click="isAlsoSent = !isAlsoSent" />
                    <span>Also send to <b v-if="alsoName">{{ alsoName }}</b><template v-else>the conversation</template></span>
                </label>
                <span v-else-if="!isPhone" class="chat-composer-hint" data-testid="composer-hint"><kbd>Enter</kbd> to send, <kbd>Shift + Enter</kbd> for a new line</span>
                <span class="chat-composer-count" data-testid="composer-count" :data-tone="count?.tone">{{ count?.text ?? "" }}</span>
            </div>

            <!-- The picker in insert mode, mounted only while open, so it fetches and focuses as it opens. -->
            <EmojiPicker v-if="isEmojiOpen && emojiSource"
                         mode="insert"
                         :source="emojiSource"
                         :anchor="emojiAnchor"
                         @insert="onEmojiInsert"
                         @close="onEmojiClose" />

            <!-- The @ picker, mounted only while the caret ends an @ query, so each opening plays its way in. -->
            <MentionPicker v-if="isMentionOpen && mentionSource"
                           :target="editorElement"
                           :anchor="boxElement ?? null"
                           :people="mentionSource.canMention ? mentionSource.people : []"
                           :isAllOffered="mentionSource.isAllOffered"
                           :isAwaitingAnswer="mentionSource.canMention && mentionSource.isAwaitingAnswer === true"
                           :isAwaitingFirstAnswer="mentionSource.canMention && mentionSource.isAwaitingFirstAnswer === true"
                           :isConversation="!isChannel"
                           @choose="onMentionChoose"
                           @close="isMentionDismissed = true" />
        </template>
    </div>
</template>

<style scoped>
.chat-composer {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 6px;
    padding: 0 20px 14px;
}

/* A thread's composer sits tighter in the narrower panel; a phone's padding, after it, wins there too. */
.chat-composer.is-thread {
    padding: 0 14px 12px;
}

.chat-composer.is-phone {
    padding: 0 10px 10px;
}

/*
 * The strip's holder, one grid row that gives the strip's height back as it leaves; the bottom
 * margin takes back the column's gap with it.
 */
.chat-composer-failed-wrap {
    display: grid;
    grid-template-rows: 1fr;
}

.chat-composer-failed-wrap > .chat-composer-failed {
    min-height: 0;
}

.chat-strip-leave-active {
    overflow: hidden;
    transition: grid-template-rows var(--chat-t-base) var(--chat-ease-out), margin-bottom var(--chat-t-base) var(--chat-ease-out), opacity var(--chat-t-fast) var(--chat-ease-out);
}

.chat-strip-leave-to {
    grid-template-rows: 0fr;
    margin-bottom: -6px;
    opacity: 0;
}

/* The failed sends' strip: a soft danger card over the box, rising into place as it appears. */
.chat-composer-failed {
    --chat-fail-mark-s: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
    padding: 8px 8px 8px 12px;
    background: var(--chat-danger-soft);
    border-radius: var(--chat-r-lg);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--chat-danger) 28%, transparent);
    animation: chat-strip-in var(--chat-t-base) var(--chat-ease-in);
}

/* The mark beside the first line, the reason under it; a long reason wraps in its own column. */
.chat-composer-failed-text {
    display: grid;
    flex: 1 1 200px;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 9px;
    align-items: center;
    min-width: 0;
    font-size: 13px;
    line-height: 1.35;
}

.chat-composer-failed-text b {
    font-weight: 700;
    color: var(--chat-danger-ink);
}

.chat-composer-failed-reason {
    grid-column: 2;
    font-size: 12.5px;
    color: var(--chat-text-2);
}

/* At a narrow width the buttons wrap under the words, still at the strip's end. */
.chat-composer-failed-acts {
    display: inline-flex;
    flex: none;
    gap: 6px;
    margin-left: auto;
}

/* Try again is the way forward, in the danger ink; Delete stays the plain outline. */
.chat-composer-failed-acts .chat-ls-btn.is-retry {
    color: var(--chat-danger-ink);
}

/* The message being quoted, above the box, rising into place as it appears. */
.chat-composer-quote {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 8px 8px 8px 12px;
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-quote-top) var(--chat-r-quote-top) var(--chat-r-quote-bottom) var(--chat-r-quote-bottom);
    animation: chat-strip-in var(--chat-t-base) var(--chat-ease-in);
}

/* A channel's look is squarer, matching its box. */
.chat-composer.is-channel .chat-composer-quote {
    border-radius: var(--chat-r-lg) var(--chat-r-lg) var(--chat-r-sm) var(--chat-r-sm);
}

@keyframes chat-strip-in {
    from {
        opacity: 0;
        transform: translateY(6px);
    }
}

.chat-composer-quote > :deep(.chat-ic) {
    color: var(--chat-brand-ink);
}

.chat-composer-quote-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
}

.chat-composer-quote-main b {
    font-size: 12.5px;
}

.chat-composer-quote-main span {
    overflow: hidden;
    font-size: 12.5px;
    color: var(--chat-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* The box draws the focus for the text inside it, a ring and a soft glow in the church color. */
.chat-composer-box {
    display: flex;
    gap: 6px;
    align-items: flex-end;
    padding: 6px;
    margin: 0;
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
    border-radius: var(--chat-r-composer);
    box-shadow: var(--chat-shadow-composer);
    transition: border-color var(--chat-t-fast) var(--chat-ease-state), box-shadow var(--chat-t-base) var(--chat-ease-state);
}

/* A channel's look is squarer, matching its flat rows. */
.chat-composer.is-channel .chat-composer-box {
    border-radius: var(--chat-r-lg);
}

.chat-composer-box:focus-within {
    border-color: var(--chat-composer-line);
    box-shadow: 0 0 0 3px var(--chat-brand-ring), 0 6px 18px -10px var(--chat-composer-glow);
}

/* The editor carries its own line, padding and cap; a disabled box, while a draft starts, reads as resting. */
.chat-composer-input[aria-disabled="true"] {
    color: var(--chat-muted);
    cursor: default;
}

.chat-composer-send {
    display: grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    color: var(--chat-icon);
    background: var(--chat-hover);
    border: 0;
    border-radius: 50%;
    transition: background-color var(--chat-t-base) var(--chat-ease-state), color var(--chat-t-base) var(--chat-ease-state), transform var(--chat-t-fast) var(--chat-ease-in);
}

.chat-composer-send.is-ready {
    color: var(--chat-on-brand);
    background: var(--chat-brand-fill);
}

.chat-composer-send.is-ready:hover {
    transform: translateY(-1px);
}

.chat-composer-send.is-ready:active {
    transform: scale(.94);
}

.chat-composer-foot {
    display: flex;
    gap: 10px;
    align-items: center;
    min-height: 16px;
    padding: 0 14px;
    font-size: 11.5px;
    color: var(--chat-muted);
}

/* Rock's theme draws a kbd as a dark key cap; here it is only the key's name in a heavier weight. */
.chat-composer-hint kbd {
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--chat-text-2);
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
}

.chat-composer-also {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    color: var(--chat-text-2);
    cursor: pointer;
}

.chat-composer-also b {
    font-weight: 600;
    color: var(--chat-text);
}

/* Why files alone cannot go here, over the box. */
.chat-composer-note {
    padding: 0 14px;
    font-size: 12px;
    color: var(--chat-warning-ink);
}

/* The countdown in the last 500 characters of the limit, at the foot's end. */
.chat-composer-count {
    margin-left: auto;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
}

.chat-composer-count[data-tone="warn"] {
    color: var(--chat-warning-ink);
}

.chat-composer-count[data-tone="over"] {
    color: var(--chat-danger-ink);
}

.chat-composer-locked {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 12px 16px;
    font-size: 13.5px;
    color: var(--chat-muted);
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-bar);
}

/* Focus lands here only from the strip's buttons, to say why the box is not there. */
.chat-composer-locked:focus {
    outline: 0;
}

.chat-composer-locked :deep(.chat-ic) {
    color: var(--chat-icon);
}

/* Reduced motion: the send button does not lift or press, and the strips only fade in. */
@media (prefers-reduced-motion: reduce) {
    .chat-composer-send.is-ready:hover,
    .chat-composer-send.is-ready:active {
        transform: none;
    }

    .chat-composer-quote,
    .chat-composer-failed {
        animation-name: chat-crossfade;
    }

    /* The strip only fades as it goes, and gives its space back once gone. */
    .chat-strip-leave-active {
        transition: opacity var(--chat-t-fast) var(--chat-ease-out);
    }

    .chat-strip-leave-to {
        grid-template-rows: 1fr;
        margin-bottom: 0;
    }
}
</style>

<script setup lang="ts">
    import { computed, nextTick, PropType, ref, watch } from "vue";
    import Attachments from "./attachments.partial.obs";
    import EmojiPicker, { PickerSource } from "./emojiPicker.partial.obs";
    import MentionPicker, { MentionPickerSource } from "./mentionPicker.partial.obs";
    import { AttachmentTray, isTrayReady } from "../composables/useAttachments.partial";
    import { canMakeSendKey, SendFailure, SendFailureNews, textAfterSend } from "../composables/useSend.partial";
    import { DisplayPiece, TimelineMessage } from "../types.partial";
    import ChipEditor from "../ui/chipEditor.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import Switch from "../ui/switch.partial.obs";

    const props = defineProps({
        isDisabled: {
            type: Boolean,
            default: false
        },

        /**
         * The open conversation's name as the header shows it, for the placeholder: a channel's
         * name, plain, or the other people of a direct message.
         */
        title: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether the open conversation is a channel, which draws the squarer box of its look. */
        isChannel: {
            type: Boolean,
            default: false
        },

        /** Whether the chat is in its phone layout, which has tighter padding and no key hint. */
        isPhone: {
            type: Boolean,
            default: false
        },

        /** Whether the service is read only or in maintenance, so the box gives way to a locked bar. */
        isLocked: {
            type: Boolean,
            default: false
        },

        /**
         * The server's sentence for why the person cannot post here, which gives the box way to a
         * locked bar saying it; null where they can.
         */
        lockedReason: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The longest message the room takes, in characters, counted down in its last 500; 0 for no limit. */
        maxLength: {
            type: Number,
            default: 0
        },

        /**
         * The box's wire text, a mention written as its token, as its owner keeps it for the place
         * the box types into; each change comes back as update:text.
         */
        text: {
            type: String,
            default: ""
        },

        /** A mention piece for each chip the text holds, with the name and photo the chip is drawn with. */
        mentions: {
            type: Array as PropType<DisplayPiece[]>,
            default: () => []
        },

        /**
         * Whether the box keeps its text when it hands it over. A draft's first message Rock
         * refuses has no row in a feed to keep it on, and the same text refused twice leaves the
         * held text unchanged, so only the box itself can keep it.
         */
        isTextKeptOnSend: {
            type: Boolean,
            default: false
        },

        /**
         * Whether the box answers a thread: it asks for a reply and its foot offers to send the
         * reply to the conversation too, in place of the key hint.
         */
        isThread: {
            type: Boolean,
            default: false
        },

        /** The message being quoted into the next send, drawn in a strip above the box. */
        quote: {
            type: Object as PropType<TimelineMessage | null>,
            default: null
        },

        /** Whether the quoted message is the person's own, which the strip calls "yourself". */
        isQuoteOwn: {
            type: Boolean,
            default: false
        },

        /** What the emoji picker draws: the favorites, the catalog once fetched, the recents and the church's name. */
        emojiSource: {
            type: Object as PropType<PickerSource | null>,
            default: null
        },

        /**
         * What the @ picker lists for the query told by mentionQuery. Null, or a source that may
         * neither list people nor offer @all, offers no picker, and an @ stays the text it is.
         */
        mentionSource: {
            type: Object as PropType<MentionPickerSource | null>,
            default: null
        },

        /** Which conversation the box types into, since one box is kept as the person moves between them. */
        conversationKey: {
            type: String as PropType<string | null>,
            default: null
        },

        /** What the person's failed sends in the place the box types into come to, or null while none failed. */
        sendFailure: {
            type: Object as PropType<SendFailure | null>,
            default: null
        },

        /**
         * The latest send to fail anywhere, which the strip says aloud when it holds that send: a
         * failure is said once, as it happens, by the one strip that holds it then.
         */
        lastFailure: {
            type: Object as PropType<SendFailureNews | null>,
            default: null
        },

        /**
         * The files waiting to go with the next send from this box, uploading as they are picked;
         * null where files cannot go, which offers no way to attach one.
         */
        tray: {
            type: Object as PropType<AttachmentTray | null>,
            default: null
        },

        /** Whether a send here must carry text, as an announcement must: files alone do not go. */
        isTextRequired: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        /** The text, and for a thread's reply whether it is also sent to the conversation. */
        (e: "send", body: string, isAlsoSent?: boolean): void;
        /** The box's text changed, a send's emptying included. */
        (e: "update:text", text: string): void;
        /** A chip was drawn in the box, with the name and photo it shows. */
        (e: "mention", piece: DisplayPiece): void;
        /** Up in an empty box: the person asks to edit their newest message. */
        (e: "editLast"): void;
        (e: "cancelQuote"): void;
        /** The picker opened, so the shell can fetch the catalog it draws. */
        (e: "emojiPickerOpen"): void;
        /** An emoji went into the box, for the recently used. */
        (e: "emojiChosen", code: string): void;
        /** The @ query at the caret whenever it changes, for the shell's search; null for none. */
        (e: "mentionQuery", query: string | null): void;
        /** Focus came into the box from outside it, so the shell can ready what typing here needs. */
        (e: "focus"): void;
        /** Focus left the box, so the shell knows its text is no longer being typed. */
        (e: "blur"): void;
        /** A send over the room's limit was held back; the block says why, naming the limit. */
        (e: "overLimit", maxLength: number): void;
        /** Try again on the failed sends here: every one that can be tried again. */
        (e: "retryFailed"): void;
        /** Delete on the failed sends here: every one of them. */
        (e: "discardFailed"): void
    }>();

    // #region Values

    /** A thread reply's choice to show it in the conversation too, cleared with each send. */
    const isAlsoSent = ref(false);

    const editor = ref<InstanceType<typeof ChipEditor>>();
    const emojiButton = ref<InstanceType<typeof IconButton>>();

    const isEmojiOpen = ref(false);

    const boxElement = ref<HTMLFormElement>();
    const fileInput = ref<HTMLInputElement>();
    const stripElement = ref<HTMLElement>();
    const lockedElement = ref<HTMLElement>();

    /** The @ query the caret ends, or null when it ends none. */
    const mentionQuery = ref<string | null>(null);

    /** Escape or a press elsewhere closed the picker; the next change in the box may open it again. */
    const isMentionDismissed = ref(false);

    /** The counter shows from this many characters short of the limit. */
    const countdownFrom = 500;

    /** The last failure said aloud, counted so the same words are read again for the next one. */
    const failedAnnouncement = ref<{ text: string, count: number } | null>(null);

    // #endregion Values

    // #region Computed Values

    const placeholder = computed((): string => {
        if (props.isThread) {
            return "Reply in thread";
        }

        return props.title ? `Message ${props.title}` : "";
    });

    /** A channel is named, plain, as everywhere else; a direct message's people are "the conversation", so null. */
    const alsoName = computed((): string | null => props.isChannel && props.title ? props.title : null);

    const quoteTitle = computed((): string => {
        if (props.isQuoteOwn) {
            return "Quoting yourself";
        }

        const name = [props.quote?.sender_nick_name, props.quote?.sender_last_name].filter(part => !!part).join(" ");
        return name ? `Quoting ${name}` : "Quoting a message";
    });

    /** The quoted text on one line, a mention as the person's name as the body draws it, never its token. */
    const quotePreview = computed((): string => {
        const quote = props.quote;
        if (!quote) {
            return "";
        }

        const text = quote.pieces?.length ? quote.pieces.map(piece => piece.text).join("") : quote.body ?? "";
        return text.replace(/\s+/g, " ").trim();
    });

    /** Whether the locked bar stands in the box's place, so nothing can be sent from here. */
    const isClosed = computed((): boolean => props.isLocked || !!props.lockedReason);

    /** Whether the strip offers Try again: one of its sends can pass, and the box is open to send it. */
    const isRetryOffered = computed((): boolean => !!props.sendFailure?.canRetry && !isClosed.value);

    /** Why, in the words for beside Try again where the strip offers it, so the two never both ask. */
    const failedReason = computed((): string | null => {
        const reason = props.sendFailure?.reason;
        if (!reason) {
            return null;
        }

        return isRetryOffered.value ? reason.besideRetry : reason.alone;
    });

    /** The strip's first line: one message, or how many. */
    const failedLead = computed((): string => {
        const count = props.sendFailure?.count ?? 0;
        return count > 1 ? `${count} messages weren't sent` : "Your message wasn't sent";
    });

    /** The text's length as the platform counts it, by code point, so an emoji is one. */
    const length = computed((): number => Array.from(props.text).length);

    /** How the counter reads near and past the limit, or null while it has nothing to say. */
    const count = computed((): { text: string, tone: "warn" | "over" } | null => {
        if (props.maxLength <= 0) {
            return null;
        }

        const left = props.maxLength - length.value;
        if (left >= countdownFrom) {
            return null;
        }

        return left < 0 ? { text: `${(-left).toLocaleString()} over the limit`, tone: "over" } : { text: `${left.toLocaleString()} left`, tone: "warn" };
    });

    /** Whether files wait in the tray. */
    const hasFiles = computed((): boolean => (props.tray?.files.length ?? 0) > 0);

    /** Whether the text is blank, files waiting, and the place takes no files alone, which the box says. */
    const isTextAsked = computed((): boolean => props.isTextRequired && hasFiles.value && props.text.trim() === "");

    /**
     * Whether there is something to send, which turns the send button to the church's fill: text,
     * or files alone where they may go; and every file waiting is up, since the send names them.
     */
    const isReady = computed((): boolean => {
        if (hasFiles.value && !isTrayReady(props.tray as AttachmentTray)) {
            return false;
        }

        return props.text.trim() !== "" || (hasFiles.value && !props.isTextRequired);
    });

    /** The emoji button, which the picker is placed above and hands focus back to. */
    const emojiAnchor = computed((): HTMLElement | null => emojiButton.value?.buttonElement ?? null);

    /** The editor's element, which the @ picker takes as its combobox. */
    const editorElement = computed((): HTMLElement | null => editor.value?.editorElement ?? null);

    const isMentionOpen = computed((): boolean => {
        const source = props.mentionSource;
        const isOffered = !!source && (source.canMention || source.isAllOffered);
        return isOffered && mentionQuery.value !== null && !isMentionDismissed.value && !props.isDisabled;
    });

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Hands the text to the shell and asks the box's owner to clear it, unless it is kept. A send that fails keeps
     * its text on its own row in the feed with a retry, so clearing there loses nothing; a browser
     * that cannot make a send key makes no row, so the box keeps the text instead.
     */
    function onSubmit(): void {
        if (!isReady.value) {
            return;
        }

        // The send would be refused, so the text stays in the box to be cut, and the block says why.
        if (props.maxLength > 0 && length.value > props.maxLength) {
            emit("overLimit", props.maxLength);
            return;
        }

        const body = props.text;
        if (props.isThread) {
            emit("send", body, isAlsoSent.value);
        }
        else {
            emit("send", body);
        }
        emit("update:text", textAfterSend(body, props.isTextKeptOnSend || !canMakeSendKey()));
        isAlsoSent.value = false;
    }

    /**
     * Try again and Delete each take the strip's buttons away, as the sends go back to sending or
     * go, so focus goes on rather than being lost with them: to the box, which says when it takes
     * no typing yet; else to what is left of the strip; else to the lock's line in the box's place.
     */
    async function moveFocusOn(): Promise<void> {
        await nextTick();
        if (editor.value) {
            editor.value.focus();
            return;
        }

        const left = stripElement.value?.querySelector<HTMLButtonElement>("button");
        (left ?? lockedElement.value)?.focus();
    }

    function onRetryFailed(): void {
        emit("retryFailed");
        void moveFocusOn();
    }

    function onDiscardFailed(): void {
        emit("discardFailed");
        void moveFocusOn();
    }

    /** Files chosen in the browser's picker go into the tray; the picker is cleared so the same file can be chosen again. */
    function onFilesPicked(): void {
        const input = fileInput.value;
        if (props.tray && input?.files?.length) {
            props.tray.add(Array.from(input.files));
        }
        if (input) {
            input.value = "";
        }
    }

    /** A drag carrying files may be dropped here, where files can go. */
    function onDragOver(event: DragEvent): void {
        if (props.tray && !isClosed.value && event.dataTransfer?.types?.includes("Files")) {
            event.preventDefault();
        }
    }

    /** Files dropped on the composer go into the tray rather than the browser opening them. */
    function onDrop(event: DragEvent): void {
        const files = event.dataTransfer?.files;
        if (!props.tray || isClosed.value || !files?.length) {
            return;
        }

        event.preventDefault();
        props.tray.add(Array.from(files));
    }

    /**
     * Pasted files, a copied photo above all, go into the tray. Taken before the editor sees the
     * paste, which would otherwise keep only its text.
     */
    function onPaste(event: ClipboardEvent): void {
        const files = event.clipboardData?.files;
        if (!props.tray || !files?.length) {
            return;
        }

        event.preventDefault();
        event.stopPropagation();
        props.tray.add(Array.from(files));
    }

    /** The emoji button opens the picker, or closes it when it is already open. */
    function onEmojiClick(): void {
        if (isEmojiOpen.value || !props.emojiSource) {
            isEmojiOpen.value = false;
            return;
        }

        isEmojiOpen.value = true;
        emit("emojiPickerOpen");
    }

    /**
     * Puts the chosen emoji in the box where the person was typing. The editor kept that caret
     * when the picker took focus, so the emoji lands there and not at the end.
     */
    function onEmojiInsert(insertText: string, code: string): void {
        editor.value?.insertText(insertText);
        emit("emojiChosen", code);
    }

    /**
     * The picker went. Closed by a choice or by Escape, it handed focus back to the button, and
     * the person carries on typing in the box; closed by a press elsewhere, focus stays there.
     */
    function onEmojiClose(): void {
        isEmojiOpen.value = false;
        if (emojiAnchor.value && document.activeElement === emojiAnchor.value) {
            editor.value?.focus();
        }
    }

    /** Focus came into the box; a move between its own parts is not news to the shell. */
    function onBoxFocusIn(event: FocusEvent): void {
        if (!boxElement.value?.contains(event.relatedTarget as Node | null)) {
            emit("focus");
        }
    }

    /** Focus left the box, not for another of its own parts. */
    function onBoxFocusOut(event: FocusEvent): void {
        if (!boxElement.value?.contains(event.relatedTarget as Node | null)) {
            emit("blur");
        }
    }

    /**
     * The editor's @ query after a change. Each change may reopen a picker the person closed, as
     * typing on does; the shell hears only a query that differs, so it searches once for each.
     */
    function onMentionQuery(query: string | null): void {
        isMentionDismissed.value = false;
        if (query !== mentionQuery.value) {
            mentionQuery.value = query;
            emit("mentionQuery", query);
        }
    }

    /** A row was chosen: its chip and a space replace the @ query, which closes the picker. */
    function onMentionChoose(token: string, name: string, photoUrl: string | null): void {
        editor.value?.insertMention(token, name, photoUrl);
    }

    // #endregion Event Handlers

    // #region Watchers

    // A failure is said as it happens, by the strip holding it then. One already there when the
    // box opens, comes back to a room or takes it over from the thread's strip was said when it
    // happened, or in a place not on screen, so moving between places says nothing.
    watch(() => props.lastFailure?.count, () => {
        const failure = props.sendFailure;
        const news = props.lastFailure;
        if (failure && news && failure.localIds.includes(news.localId)) {
            const text = failedReason.value ? `${failedLead.value}. ${failedReason.value}` : `${failedLead.value}.`;
            failedAnnouncement.value = { text, count: (failedAnnouncement.value?.count ?? 0) + 1 };
        }
    });

    // What was said in one place is not left to be read in the next.
    watch(() => [props.sendFailure === null, props.conversationKey] as const, ([isNone, key], [, previousKey]) => {
        if (isNone || key !== previousKey) {
            failedAnnouncement.value = null;
        }
    });

    // #endregion Watchers
</script>
