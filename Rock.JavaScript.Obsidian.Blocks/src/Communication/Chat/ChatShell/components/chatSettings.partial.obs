<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Dialog :isOpen="isOpen"
            title="Chat settings"
            isSettings
            :isPhone="isPhone"
            @close="emit('close')">
        <template #tools>
            <IconButton icon="x" label="Close" data-testid="settings-close" @click="emit('close')" />
        </template>

        <div class="chat-ms-id">
            <Avatar :people="[{ name: personName, photoUrl: personPhotoUrl }]" :size="44" />
            <span class="chat-ms-main">
                <b class="chat-ms-name" data-testid="settings-name">{{ personName }}</b>
                <span class="chat-ms-meta" data-testid="settings-meta">
                    <!-- The dot between the parts is drawn for the eye; a screen reader hears a comma. -->
                    <template v-for="(item, index) in metaItems" :key="item">
                        <span v-if="index > 0" class="chat-sr-only">, </span>
                        <span class="chat-ms-meta-item" data-testid="settings-meta-item">{{ item }}</span>
                    </template>
                </span>
            </span>
        </div>

        <SettingGroup label="Privacy" data-testid="settings-privacy">
            <SettingSwitch name="profile_details"
                           icon="id-card"
                           :title="meTitles.profile_details"
                           description="Adds your email, mobile phone and badges to your card."
                           :isOn="me.show_profile_details"
                           :note="notes.profile_details ?? null"
                           @toggle="onToggle('profile_details', $event)" />
            <SettingSwitch name="open_dm"
                           icon="message"
                           :title="meTitles.open_dm"
                           description="Off: only people in a private channel with you"
                           :isOn="me.is_open_dm_allowed"
                           :note="notes.open_dm ?? null"
                           @toggle="onToggle('open_dm', $event)" />
        </SettingGroup>

        <SettingGroup label="Notifications" data-testid="settings-notifications">
            <SettingRow icon="monitor"
                        title="This browser"
                        :sub="pushRow.sub"
                        :data-state="push"
                        data-testid="push-row">
                <span v-if="pushRow.status" class="chat-push-status" :data-state="push" data-testid="push-status">{{ pushRow.status }}</span>
                <button v-if="push === 'offered' || push === 'asking'"
                        type="button"
                        class="chat-ms-btn is-brand"
                        aria-label="Turn on notifications for this browser"
                        :disabled="push === 'asking'"
                        data-autofocus
                        @click="emit('pushOn')">
                    <span v-if="push === 'asking'" class="chat-spinner"></span>Turn on
                </button>
                <button v-else-if="push === 'on'"
                        type="button"
                        class="chat-ms-btn is-line"
                        aria-label="Turn off notifications for this browser"
                        @click="emit('pushOff')">Turn off</button>
            </SettingRow>
            <SettingSwitch name="reaction_push"
                           icon="smile"
                           :title="meTitles.reaction_push"
                           :description="push === 'on' ? null : 'Sent to your other devices'"
                           :isOn="me.reaction_push"
                           :note="notes.reaction_push ?? null"
                           @toggle="onToggle('reaction_push', $event)" />
        </SettingGroup>
        <p class="chat-ms-foot" data-testid="settings-foot">Each conversation sets its own, from its name at the top.</p>

        <!-- The settings' news said while the dialog is open, keyed by count so the same words are
             read twice; a save that failed is said at once. -->
        <span class="chat-sr-only" aria-live="polite" data-testid="settings-announcement"><span v-if="shownAnnouncement && !shownAnnouncement.isAssertive" :key="shownAnnouncement.count">{{ shownAnnouncement.text }}</span></span>
        <span class="chat-sr-only" aria-live="assertive" data-testid="settings-alert"><span v-if="shownAnnouncement?.isAssertive" :key="shownAnnouncement.count">{{ shownAnnouncement.text }}</span></span>
    </Dialog>
</template>

<style scoped>
.chat-ms-id {
    display: flex;
    gap: 12px;
    align-items: center;
}

.chat-ms-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.chat-ms-name {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -.01em;
    overflow-wrap: anywhere;
}

.chat-ms-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: 12.5px;
    color: var(--chat-muted);
}

/* The facts joined by 3px dots, as the details dialog joins them. */
.chat-ms-meta-item ~ .chat-ms-meta-item::before {
    display: inline-block;
    width: 3px;
    height: 3px;
    margin: 0 7px;
    vertical-align: middle;
    content: "";
    background: currentColor;
    border-radius: 50%;
    opacity: .55;
}

.chat-ms-foot {
    margin: 14px 0 0 2px;
    font-size: 12px;
    color: var(--chat-muted);
}

/* This browser's state in words beside a dot: success when on, warning when blocked. */
.chat-push-status {
    display: inline-flex;
    flex: none;
    gap: 5px;
    align-items: center;
    font-size: 12.5px;
    color: var(--chat-muted);
    white-space: nowrap;
}

.chat-push-status::before {
    width: 7px;
    height: 7px;
    content: "";
    background: var(--chat-line-strong);
    border-radius: 50%;
}

.chat-push-status[data-state="on"]::before {
    background: var(--chat-success);
}

.chat-push-status[data-state="blocked"]::before {
    background: var(--chat-warning);
}

/* The small buttons: in the church's color, or outlined. */
.chat-ms-btn {
    display: inline-flex;
    flex: none;
    gap: 5px;
    align-items: center;
    height: 28px;
    padding: 0 10px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--chat-text);
    background: transparent;
    border: 0;
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), border-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-ms-btn.is-brand {
    color: var(--chat-on-brand);
    background: var(--chat-brand-fill);
}

.chat-ms-btn.is-brand:hover:not(:disabled) {
    background: color-mix(in srgb, var(--chat-brand-fill) 88%, var(--chat-shade));
}

.chat-ms-btn.is-line {
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
}

.chat-ms-btn.is-line:hover {
    border-color: var(--chat-icon);
}

.chat-ms-btn:disabled {
    cursor: default;
    opacity: .55;
}

.chat-ms-btn .chat-spinner {
    width: 12px;
    height: 12px;
}
</style>

<script setup lang="ts">
    import { computed, PropType, ref, watch } from "vue";
    import { MeKey, MeSettings, meTitles, PrefsState, SettingNote } from "../composables/usePrefs.partial";
    import { PushState } from "../composables/usePush.partial";
    import Avatar from "../ui/avatar.partial.obs";
    import Dialog from "../ui/dialog.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import SettingGroup from "../ui/settingGroup.partial.obs";
    import SettingRow from "../ui/settingRow.partial.obs";
    import SettingSwitch from "../ui/settingSwitch.partial.obs";

    const props = defineProps({
        /** Whether the dialog is shown; kept mounted and closed, it plays its exit and gives focus back. */
        isOpen: {
            type: Boolean,
            default: false
        },

        personName: {
            type: String,
            default: ""
        },

        personPhotoUrl: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The person's campus by its name, or null where they have none the church lists. */
        campusName: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The church's name, which the person's name and photo come from. */
        organizationName: {
            type: String,
            default: ""
        },

        /** The person's own switches as they stand. */
        me: {
            type: Object as PropType<MeSettings>,
            required: true
        },

        /** The note under each switch: only a failed save's, since one that lands shows nothing more. */
        notes: {
            type: Object as PropType<Partial<Record<MeKey, SettingNote>>>,
            default: () => ({})
        },

        /** The settings' newest sentence for screen readers; only one said while open is read. */
        announcement: {
            type: Object as PropType<PrefsState["announcement"]>,
            default: null
        },

        /** This browser's push. */
        push: {
            type: String as PropType<PushState>,
            default: "unavailable"
        },

        isPhone: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        /** The close button, Escape or the scrim. */
        (e: "close"): void;

        /** A switch was pressed: its key and the value it asks for. */
        (e: "toggle", key: MeKey, value: boolean): void;

        /** Turn on or Turn off for this browser. */
        (e: "pushOn"): void;
        (e: "pushOff"): void;
    }>();

    // #region Values

    /** The settings' announcement count as the dialog opened, so only news said since is read. */
    const announcedBefore = ref(props.isOpen ? props.announcement?.count ?? 0 : Number.POSITIVE_INFINITY);

    // #endregion Values

    // #region Computed Values

    /** The campus, then where the person's name and photo come from. */
    const metaItems = computed((): string[] => [
        ...(props.campusName ? [props.campusName] : []),
        `From your ${props.organizationName} profile`
    ]);

    /**
     * What the browser row says in each of push's states: the state in words beside its dot, and a
     * line under the label only where the person has something to do.
     */
    const pushRow = computed((): { status: string | null, sub: string | null } => {
        switch (props.push) {
            case "offered":
                return { status: "Off", sub: null };

            case "asking":
                return { status: null, sub: "Choose Allow in your browser" };

            case "on":
                return { status: "On", sub: null };

            case "blocked":
                return { status: "Blocked", sub: "Allow it in browser settings, then reload" };

            default:
                return { status: "Not available", sub: `Not set up for ${props.organizationName} yet` };
        }
    });

    const shownAnnouncement = computed((): PrefsState["announcement"] => props.announcement && props.announcement.count > announcedBefore.value ? props.announcement : null);

    // #endregion Computed Values

    // #region Event Handlers

    function onToggle(key: MeKey, value: boolean): void {
        emit("toggle", key, value);
    }

    // #endregion Event Handlers

    // #region Watchers

    // Each opening reads only the news said from then on.
    watch(() => props.isOpen, isOpen => {
        announcedBefore.value = isOpen ? props.announcement?.count ?? 0 : Number.POSITIVE_INFINITY;
    });

    // #endregion Watchers

</script>
