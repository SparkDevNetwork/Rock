<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Dialog :isOpen="isOpen"
            title="Chat settings"
            isPanel
            placement="top"
            sheet="phone"
            @close="emit('close')">
        <template #tools>
            <IconButton icon="x" label="Close" data-testid="settings-close" @click="emit('close')" />
        </template>

        <div class="chat-ms-id">
            <Avatar :people="[{ name: personName, photoUrl: personPhotoUrl }]" :size="44" :status="ownStatus" own />
            <span class="chat-ms-main">
                <b class="chat-ms-name" data-testid="settings-name">{{ personName }}</b>
                <span v-if="campusName" class="chat-ms-meta" data-testid="settings-meta">{{ campusName }}</span>
            </span>
        </div>

        <SettingGroup label="Status" data-testid="settings-status">
            <SettingRow icon="clock" :title="statusLine" :note="statusNote" data-testid="status-row">
                <StatusMenu trigger="change"
                            :choice="statusChoice"
                            :closedReason="statusClosedReason"
                            :isRetrying="isStatusRetrying"
                            @choose="emit('status', $event)"
                            @turn="isStatusOpen = true" />
            </SettingRow>
        </SettingGroup>

        <SettingGroup label="Privacy" data-testid="settings-privacy">
            <SettingSwitch name="profile_details"
                           icon="id-card"
                           :title="meTitles.profile_details"
                           description="Shows your email, mobile phone and badges on your card"
                           :isOn="me.show_profile_details"
                           :note="notes.profile_details ?? null"
                           @toggle="onToggle('profile_details', $event)" />
            <SettingSwitch name="open_dm"
                           icon="message"
                           :title="meTitles.open_dm"
                           description="When off, only people in a private channel with you"
                           :isOn="me.is_open_dm_allowed"
                           :note="notes.open_dm ?? null"
                           @toggle="onToggle('open_dm', $event)" />
            <SettingRow icon="ban"
                        title="Blocked people"
                        :value="blockedCount"
                        isLink
                        data-testid="blocked-people"
                        @click="isBlockedOpen = true" />
        </SettingGroup>

        <SettingGroup label="Notifications" data-testid="settings-notifications">
            <SettingRow icon="monitor"
                        title="This browser"
                        :sub="pushRow.sub"
                        :data-state="push"
                        data-testid="push-row">
                <span v-if="pushRow.status" class="chat-push-status" :data-state="push" data-testid="push-status">{{ pushRow.status }}</span>
                <Button v-if="push === 'offered' || isPushTurningOn"
                        kind="brand"
                        size="sm"
                        :busy="isPushTurningOn"
                        aria-label="Turn on notifications for this browser"
                        data-autofocus
                        @click="emit('pushOn')">Turn on</Button>
                <Button v-else-if="push === 'on'"
                        size="sm"
                        aria-label="Turn off notifications for this browser"
                        @click="emit('pushOff')">Turn off</Button>
            </SettingRow>
            <SettingSwitch name="reaction_push"
                           icon="smile"
                           :title="meTitles.reaction_push"
                           :isOn="me.reaction_push"
                           :note="notes.reaction_push ?? null"
                           @toggle="onToggle('reaction_push', $event)" />
        </SettingGroup>

        <template #pages>
            <SurfacePage :isOpen="isStatusOpen" title="Status" @back="isStatusOpen = false">
                <StatusMenu trigger="page"
                            :choice="statusChoice"
                            :closedReason="statusClosedReason"
                            :isRetrying="isStatusRetrying"
                            @choose="onStatusChosen" />
            </SurfacePage>
            <SurfacePage :isOpen="isBlockedOpen" title="Blocked people" @back="isBlockedOpen = false">
                <EmptyState v-if="blocked.listState === 'failed'"
                            tone="error"
                            title="Couldn't load the people you blocked."
                            actionLabel="Try again"
                            data-testid="blocked-failed"
                            @action="emit('retryBlocked')" />
                <SettingGroup v-else-if="blocked.listState !== 'loaded'" ariaLabel="Blocked people" aria-busy="true" data-testid="blocked-loading">
                    <Skeleton v-for="n in 3" :key="n" shape="person" />
                </SettingGroup>
                <EmptyState v-else-if="shownBlocked.length === 0"
                            ref="blockedEmpty"
                            title="No one blocked"
                            tabindex="-1"
                            data-testid="blocked-empty" />
                <SettingGroup v-else ref="blockedList" ariaLabel="Blocked people" isList data-testid="blocked-list">
                    <SettingRow v-for="person in shownBlocked"
                                :key="keyOf(person)"
                                :title="askingGuid === keyOf(person) ? askTitle(person) : blockedName(person)"
                                :sub="askingGuid === keyOf(person) ? unblockSentence : null"
                                :note="blocked.notes[keyOf(person)] ?? null"
                                :isAsking="askingGuid === keyOf(person)"
                                :data-person="keyOf(person)"
                                data-testid="blocked-row"
                                @keydown.esc="onRowEscape($event, person)">
                        <template #lead>
                            <Avatar :people="[personFace(person)]" :size="32" />
                        </template>
                        <template v-if="askingGuid === keyOf(person)">
                            <Button size="sm" data-focus-stop="blocked-ask-no" data-testid="blocked-ask-no" @click="onAskCancel(person)">Cancel</Button>
                            <Button kind="brand" size="sm" data-testid="blocked-ask-yes" @click="onUnblock(person)">Unblock</Button>
                        </template>
                        <Button v-else
                                size="sm"
                                :busy="!!blocked.busy[keyOf(person)]"
                                :aria-label="`Unblock ${blockedName(person)}`"
                                data-focus-stop="blocked-unblock"
                                data-testid="blocked-unblock"
                                @click="onAsk(person)">Unblock</Button>
                    </SettingRow>
                </SettingGroup>
            </SurfacePage>
        </template>
    </Dialog>
</template>

<style scoped>
/* Her own face's badge, ringed in the dialog's fill. */
.chat-ms-id {
    --chat-av-ring: var(--chat-raised);
    --chat-av-ring-over: transparent;

    display: flex;
    gap: 12px;
    align-items: center;
}

.chat-ms-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.chat-ms-name {
    font-size: var(--chat-fs-title);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -.01em;
    overflow-wrap: anywhere;
}

.chat-ms-meta {
    font-size: var(--chat-fs-ui);
    color: var(--chat-muted);
}

/* This browser's state in words beside a dot: success when on, warning when blocked. */
.chat-push-status {
    display: inline-flex;
    flex: none;
    gap: 5px;
    align-items: center;
    font-size: var(--chat-fs-ui);
    color: var(--chat-muted);
    white-space: nowrap;
}

.chat-push-status::before {
    width: 7px;
    height: 7px;
    content: "";
    background: var(--chat-line-strong);
    border-radius: var(--chat-r-full);
}

.chat-push-status[data-state="on"]::before {
    background: var(--chat-success);
}

.chat-push-status[data-state="blocked"]::before {
    background: var(--chat-warning);
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, PropType, ref, watch } from "vue";
    import { busyEndOf, MeKey, MeSettings, meTitles, StatusChoice } from "../composables/usePrefs.partial";
    import { longestTimerMs, nextMidnight } from "../feedLayout.partial";
    import { BlocksState, unnamedBlocked } from "../composables/useBlocks.partial";
    import { useFaceStatus, useStatusClock } from "../composables/usePresenceStatus.partial";
    import { ChatPerson } from "../types.partial";
    import { ownStatusWords, personFace, personName as nameOf } from "../ui/face.partial";
    import { PushState } from "../composables/usePush.partial";
    import { useAnnouncer } from "../ui/announcer.partial";
    import Avatar from "../ui/avatar.partial.obs";
    import Button from "../ui/button.partial.obs";
    import Dialog from "../ui/dialog.partial.obs";
    import EmptyState from "../ui/emptyState.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import SettingGroup from "../ui/settingGroup.partial.obs";
    import { Note } from "../ui/settingNote.partial.obs";
    import SettingRow from "../ui/settingRow.partial.obs";
    import SettingSwitch from "../ui/settingSwitch.partial.obs";
    import Skeleton from "../ui/skeleton.partial.obs";
    import SurfacePage from "../ui/surfacePage.partial.obs";
    import StatusMenu from "./statusMenu.partial.obs";
    import { statusRetryingWords } from "../composables/statusTabs.partial";

    const props = defineProps({
        /** Whether the dialog is shown; kept mounted and closed, it plays its exit and gives focus back. */
        isOpen: {
            type: Boolean,
            default: false
        },

        /** The person's primary alias, whose own face the identity draws. */
        personAliasGuid: {
            type: String,
            default: ""
        },

        personName: {
            type: String,
            default: ""
        },

        personPhotoUrl: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The person's campus by its name, or null where they have none the church lists. */
        campusName: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The person's own switches as they stand. */
        me: {
            type: Object as PropType<MeSettings>,
            required: true
        },

        /** Her status as her settings show it, which the Status group says and its menu checks. */
        statusChoice: {
            type: Object as PropType<StatusChoice>,
            default: () => ({ busy_until: null, appear_offline: false })
        },

        /** Why her status cannot be set now, the banner's words while the church is read only; null while it can. */
        statusClosedReason: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether her status choice has failed to save and is being asked again, which the Status group says. */
        isStatusRetrying: {
            type: Boolean,
            default: false
        },

        /** The note under each switch: only a failed save's, since one that lands shows nothing more. */
        notes: {
            type: Object as PropType<Partial<Record<MeKey, Note>>>,
            default: () => ({})
        },

        /** This browser's push. */
        push: {
            type: String as PropType<PushState>,
            default: "unavailable"
        },

        /** The people the person blocked, read as the dialog opens. */
        blocked: {
            type: Object as PropType<Pick<BlocksState, "people" | "listState" | "busy" | "notes">>,
            default: () => ({ people: [], listState: "idle", busy: {}, notes: {} })
        }
    });

    const emit = defineEmits<{
        /** The close button, Escape or the scrim. */
        (e: "close"): void;

        /** A switch was pressed: its key and the value it asks for. */
        (e: "toggle", key: MeKey, value: boolean): void;

        /** Turn on or Turn off for this browser. */
        (e: "pushOn"): void;
        (e: "pushOff"): void;

        /** Unblock on a blocked person's row, once the row has asked and had its yes; and Try again on a list that failed to load. */
        (e: "unblock", person: ChatPerson): void;
        (e: "retryBlocked"): void;

        /** A choice in the Status group's menu, for the block to save. */
        (e: "status", choice: StatusChoice): void;
    }>();

    // Anchored at the top, so a note coming or going below a row moves only the dialog's foot.
    // Blocked people is a page the one dialog turns to and back from, where Unblock asks in the
    // person's row, naming what changes, and only its yes unblocks.

    // #region Values

    /** The list of blocked people, whose rows focus moves along as one leaves. */
    const blockedList = ref<InstanceType<typeof SettingGroup>>();

    /** The empty page, which focus lands on once the last person is unblocked. */
    const blockedEmpty = ref<InstanceType<typeof EmptyState>>();

    /** Whether the dialog is turned to the Blocked people page. */
    const isBlockedOpen = ref(false);

    /** Whether the sheet is turned to the Status page, as Change turns it on a phone. */
    const isStatusOpen = ref(false);

    /** The one row asking whether to unblock its person, by alias guid in lower case; null for none. */
    const askingGuid = ref<string | null>(null);

    /** What the row's question names as the change, the one that surprises people. */
    const unblockSentence = "They can message you, and you'll see their messages.";

    /** The viewer's clock as the status line last read it, moved on when the line's words would change. */
    const statusNow = ref(Date.now());

    /** The one timer that moves it, set while the dialog is open and the line has a change ahead. */
    let statusTimer: ReturnType<typeof setTimeout> | null = null;

    /** The rows whose Unblock was pressed, in the order pressed, each until it leaves the list or is refused. */
    const unblocking = ref<Array<{ guid: string, name: string }>>([]);

    /** The chat's one voice, which speaks from inside the dialog while it is open. */
    const { announce } = useAnnouncer();

    const statusOf = useFaceStatus(() => props.personAliasGuid ? [props.personAliasGuid] : [], 0);

    /** The server's time, which her Busy's end is read by, as her face reads it. */
    const serverNow = useStatusClock();

    /** How far the server's clock is ahead of the page's, which the line's clock and timer are kept by. */
    const clockOffset = (): number => serverNow() - Date.now();

    // #endregion Values

    // #region Computed Values

    const ownStatus = computed(() => props.personAliasGuid ? statusOf(props.personAliasGuid) : null);

    /** Whether a Turn on is on its way, the browser's box up or not: Turn on is held, with its spinner. */
    const isPushTurningOn = computed((): boolean => props.push === "asking" || props.push === "turning_on");

    /**
     * What the browser row says in each of push's states: the state in words beside its dot, and a
     * line under the label only where the person has something to do or would wonder why.
     */
    const pushRow = computed((): { status: string | null, sub: string | null } => {
        switch (props.push) {
            case "offered":
                return { status: "Off", sub: null };

            case "asking":
                return { status: null, sub: "Choose Allow in your browser" };

            // the spinner on Turn on says it is on its way
            case "turning_on":
                return { status: null, sub: null };

            case "on":
                return { status: "On", sub: null };

            case "blocked":
                return { status: "Blocked", sub: "Allow it in browser settings, then reload" };

            // Says why, and asks nothing: a phone-number sign-in has no Keep me logged in box.
            case "not_kept":
                return { status: "Off", sub: "Your sign-in here ends when the browser closes" };

            // the reason it is not set up is nothing the person can act on
            default:
                return { status: "Not available", sub: null };
        }
    });

    /**
     * Her status in her own words, in a group of its own right under her face, whose badge it
     * changes, and kept with online status off, since a Busy still pauses her notifications. It
     * says what she chose rather than what her activity draws: Automatic,
     * a Busy saying what it does to her, or Appear offline. A Busy whose end has passed is
     * Automatic again, by the line's own clock, which moves it on at the end.
     */
    const statusLine = computed((): string => {
        const now = new Date(statusNow.value);
        const end = busyEndOf(props.statusChoice, statusNow.value + clockOffset());
        if (props.statusChoice.appear_offline) {
            return ownStatusWords("hidden", null, now);
        }
        if (end === null) {
            return "Automatic";
        }
        return ownStatusWords("busy", end === Infinity ? null : new Date(end), now);
    });

    /**
     * Under the line, while her choice keeps failing to save: the line says what she chose, as her
     * faces show it, and this that it is not saved yet. No Try again, since it is already asked
     * again on its own; it goes once the save lands or is refused.
     */
    const statusNote = computed((): Note | null => props.isStatusRetrying ? { kind: "error", text: statusRetryingWords } : null);

    /**
     * When the line's words next change by the clock alone: her Busy's end, or before it the
     * viewer's next midnight while the end lies on a later day, since "tomorrow, 8:00 AM" reads
     * "8:00 AM" from then. Null while nothing ahead changes them.
     */
    const statusChangesAt = computed((): number | null => {
        const end = busyEndOf(props.statusChoice, statusNow.value + clockOffset());
        if (end === null || end === Infinity) {
            return null;
        }
        // the end on the page's clock, which the line's timer waits by
        return Math.min(end - clockOffset(), nextMidnight(new Date(statusNow.value)));
    });

    /** The rows of blocked people, once the list is read and holds anyone. */
    const shownBlocked = computed((): ChatPerson[] => props.blocked.listState === "loaded" ? props.blocked.people : []);

    /** The Privacy row's value: how many are blocked, None, or nothing before the list is read. */
    const blockedCount = computed((): string | null => {
        if (props.blocked.listState !== "loaded") {
            return null;
        }
        return props.blocked.people.length > 0 ? props.blocked.people.length.toLocaleString() : "None";
    });

    // #endregion Computed Values

    // #region Event Handlers

    /** A blocked person's name, or words for one the church no longer lists, who has none. */
    function blockedName(person: ChatPerson): string {
        return nameOf(person) || unnamedBlocked;
    }

    /** The row's question, by the first name it knows: "Unblock Sam?". */
    function askTitle(person: ChatPerson): string {
        const called = person.nick_name || `${unnamedBlocked.charAt(0).toLowerCase()}${unnamedBlocked.slice(1)}`;
        return `Unblock ${called}?`;
    }

    function keyOf(person: ChatPerson): string {
        return person.person_alias_guid.toLowerCase();
    }

    /** A control in a person's row by its focus mark, focused once the row is drawn as it now stands. */
    function focusInRow(guid: string, stop: string): void {
        void nextTick(() => {
            const list = blockedList.value?.$el as HTMLElement | undefined;
            list?.querySelector<HTMLElement>(`[data-person='${guid}'] [data-focus-stop='${stop}']`)?.focus();
        });
    }

    /** Unblock asks in the row first, on Cancel, so a stray Enter keeps them blocked; one row asks at a time. */
    function onAsk(person: ChatPerson): void {
        askingGuid.value = keyOf(person);
        focusInRow(keyOf(person), "blocked-ask-no");
    }

    function onAskCancel(person: ChatPerson): void {
        askingGuid.value = null;
        focusInRow(keyOf(person), "blocked-unblock");
    }

    /** Escape in an asking row answers no; anywhere else it is the dialog's, which goes back. */
    function onRowEscape(event: KeyboardEvent, person: ChatPerson): void {
        if (askingGuid.value === keyOf(person)) {
            event.stopPropagation();
            onAskCancel(person);
        }
    }

    /** The row's yes: the unblock is asked, the row's Unblock held with focus until it lands or is refused. */
    function onUnblock(person: ChatPerson): void {
        const guid = keyOf(person);
        askingGuid.value = null;
        unblocking.value = [...unblocking.value.filter(pressed => pressed.guid !== guid), { guid, name: blockedName(person) }];
        emit("unblock", person);
        focusInRow(guid, "blocked-unblock");
    }

    /** A choice on the Status page is told to the block, and the sheet turns back to Change, as a menu closes on a choice. */
    function onStatusChosen(choice: StatusChoice): void {
        emit("status", choice);
        isStatusOpen.value = false;
    }

    function onToggle(key: MeKey, value: boolean): void {
        emit("toggle", key, value);
    }

    // #endregion Event Handlers

    // #region Watchers

    // Each opening starts on the dialog's own page, with no unblock out.
    watch(() => props.isOpen, () => {
        unblocking.value = [];
        isBlockedOpen.value = false;
        isStatusOpen.value = false;
    });

    // Leaving the page drops its question.
    watch(isBlockedOpen, () => {
        askingGuid.value = null;
    });

    // An unblock that lands takes its row, and the button focused with it, out of the list: it is
    // said, and focus goes to the row that took its place, else the one before, else the empty line,
    // so a keyboard stays in the group. Unblocks out at once are each said as they land, and focus
    // moves only when it went with a row, so one landing never pulls it off a row still there. A
    // refusal leaves the row with its note, and focus on it.
    watch(() => [shownBlocked.value, unblocking.value.map(pressed => props.blocked.notes[pressed.guid])] as const, (_now, before) => {
        const shown = new Set(shownBlocked.value.map(person => person.person_alias_guid.toLowerCase()));
        const landed = unblocking.value.filter(pressed => !shown.has(pressed.guid));
        const waiting = unblocking.value.filter(pressed => shown.has(pressed.guid) && !props.blocked.notes[pressed.guid]);
        // set only when one has settled, since setting it asks this again
        if (waiting.length !== unblocking.value.length) {
            unblocking.value = waiting;
        }
        if (landed.length === 0) {
            return;
        }

        announce(landed.map(pressed => `Unblocked ${pressed.name}`).join(". "));
        // Focus on a row that went, gone or still fading by the Leave motion, moves on; anywhere else it stays.
        const gone = new Set(landed.map(pressed => pressed.guid));
        const rowOf = (element: Element | null): string => element?.closest<HTMLElement>("[data-person]")?.dataset.person ?? "";
        const active = document.activeElement;
        if (active && active !== document.body && active.isConnected && !gone.has(rowOf(active))) {
            return;
        }

        // where the row pressed last stood, among the rows still listed
        const previous = (before?.[0] ?? []).map(person => person.person_alias_guid.toLowerCase());
        const last = previous.indexOf(landed[landed.length - 1].guid);
        const index = previous.slice(0, Math.max(0, last)).filter(guid => shown.has(guid)).length;
        const list = blockedList.value?.$el as HTMLElement | undefined;
        const buttons = Array.from(list?.querySelectorAll<HTMLElement>("[data-focus-stop='blocked-unblock']") ?? []).filter(button => !gone.has(rowOf(button)));
        const next = buttons[Math.min(index, buttons.length - 1)] ?? blockedEmpty.value?.$el as HTMLElement | undefined;
        next?.focus();
    }, { flush: "post" });

    // The status line keeps time only while it is seen, waking once at its next change.
    watch([() => props.isOpen, statusChangesAt], ([isOpen, changesAt]) => {
        if (statusTimer !== null) {
            clearTimeout(statusTimer);
            statusTimer = null;
        }
        if (!isOpen) {
            return;
        }
        // reopened after a while, the line reads the clock now before it waits
        statusNow.value = Date.now();
        if (changesAt === null) {
            return;
        }
        statusTimer = setTimeout(() => {
            statusTimer = null;
            // never short of the change, so a timer that fires a touch early still moves the line on
            statusNow.value = Math.max(Date.now(), changesAt);
        }, Math.min(longestTimerMs, Math.max(0, changesAt - Date.now())));
    }, { immediate: true });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onBeforeUnmount(() => {
        if (statusTimer !== null) {
            clearTimeout(statusTimer);
        }
    });

    // #endregion Lifecycle Hooks

</script>
