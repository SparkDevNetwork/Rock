<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Dialog :isOpen="isOpen"
            title="Chat settings"
            isPanel
            :isPhone="isPhone"
            @close="emit('close')">
        <template #tools>
            <IconButton icon="x" label="Close" data-testid="settings-close" @click="emit('close')" />
        </template>

        <div class="chat-ms-id">
            <Avatar :people="[{ name: personName, photoUrl: personPhotoUrl }]" :size="44" :status="ownStatus" own />
            <span class="chat-ms-main">
                <b class="chat-ms-name" data-testid="settings-name">{{ personName }}</b>
                <span class="chat-ms-meta" data-testid="settings-meta">
                    <!-- The dot between the parts is drawn for the eye; a screen reader hears a comma. -->
                    <template v-for="(item, index) in metaItems" :key="item">
                        <span v-if="index > 0" class="chat-sr-only">, </span>
                        <span class="chat-ms-meta-item" data-testid="settings-meta-item">{{ item }}</span>
                    </template>
                </span>
            </span>
        </div>

        <SettingGroup label="Status" data-testid="settings-status">
            <SettingRow icon="clock" title="Your status" :sub="statusLine" data-testid="status-row">
                <StatusMenu trigger="change"
                            :choice="statusChoice"
                            :closedReason="statusClosedReason"
                            :isPhone="isPhone"
                            @choose="emit('status', $event)" />
            </SettingRow>
        </SettingGroup>

        <SettingGroup label="Privacy" data-testid="settings-privacy">
            <SettingSwitch name="profile_details"
                           icon="id-card"
                           :title="meTitles.profile_details"
                           description="Adds your email, mobile phone and badges to your card."
                           :isOn="me.show_profile_details"
                           :note="notes.profile_details ?? null"
                           @toggle="onToggle('profile_details', $event)" />
            <SettingSwitch name="open_dm"
                           icon="message"
                           :title="meTitles.open_dm"
                           description="Off: only people in a private channel with you"
                           :isOn="me.is_open_dm_allowed"
                           :note="notes.open_dm ?? null"
                           @toggle="onToggle('open_dm', $event)" />
        </SettingGroup>

        <SettingGroup label="Notifications" data-testid="settings-notifications">
            <SettingRow icon="monitor"
                        title="This browser"
                        :sub="pushRow.sub"
                        :data-state="push"
                        data-testid="push-row">
                <span v-if="pushRow.status" class="chat-push-status" :data-state="push" data-testid="push-status">{{ pushRow.status }}</span>
                <button v-if="push === 'offered' || push === 'asking'"
                        type="button"
                        class="chat-ms-btn is-brand"
                        aria-label="Turn on notifications for this browser"
                        :disabled="push === 'asking'"
                        data-autofocus
                        @click="emit('pushOn')">
                    <span v-if="push === 'asking'" class="chat-spinner"></span>Turn on
                </button>
                <button v-else-if="push === 'on'"
                        type="button"
                        class="chat-ms-btn is-line"
                        aria-label="Turn off notifications for this browser"
                        @click="emit('pushOff')">Turn off</button>
            </SettingRow>
            <SettingSwitch name="reaction_push"
                           icon="smile"
                           :title="meTitles.reaction_push"
                           :description="push === 'on' ? null : 'Sent to your other devices'"
                           :isOn="me.reaction_push"
                           :note="notes.reaction_push ?? null"
                           @toggle="onToggle('reaction_push', $event)" />
        </SettingGroup>
        <p class="chat-ms-foot" data-testid="settings-foot">Each conversation sets its own, from its name at the top.</p>

        <SettingGroup ref="blockedGroup" label="Blocked people" data-testid="settings-blocked">
            <SettingRow v-if="blocked.listState === 'failed'" sub="Couldn't load the people you blocked." data-testid="blocked-failed">
                <button type="button" class="chat-ms-btn is-line" @click="emit('retryBlocked')">Try again</button>
            </SettingRow>
            <SettingRow v-else-if="blocked.listState !== 'loaded'" aria-busy="true" data-testid="blocked-loading">
                <template #text>
                    <i class="chat-skeleton chat-ms-sk" aria-hidden="true"></i>
                </template>
            </SettingRow>
            <SettingRow v-else-if="blocked.people.length === 0" sub="You haven't blocked anyone." tabindex="-1" data-testid="blocked-empty" />
            <SettingRow v-for="person in shownBlocked"
                        :key="person.person_alias_guid"
                        :title="blockedName(person)"
                        :note="blocked.notes[person.person_alias_guid.toLowerCase()] ?? null"
                        data-testid="blocked-row">
                <template #lead>
                    <Avatar :people="[personFace(person)]" :size="28" />
                </template>
                <button type="button"
                        class="chat-ms-btn is-line"
                        :aria-label="`Unblock ${blockedName(person)}`"
                        :disabled="!!blocked.busy[person.person_alias_guid.toLowerCase()]"
                        data-testid="blocked-unblock"
                        @click="onUnblock(person)">Unblock</button>
            </SettingRow>
        </SettingGroup>

        <span class="chat-sr-only" aria-live="polite" data-testid="settings-announcement">
            <!-- The settings' news said while the dialog is open, keyed by count so the same words
                 are read twice; a save that failed is said at once. -->
            <span v-if="shownAnnouncement && !shownAnnouncement.isAssertive" :key="shownAnnouncement.count">{{ shownAnnouncement.text }}</span>
            <span v-if="unblockedSaid" :key="`unblocked-${unblockedSaid.count}`">{{ unblockedSaid.text }}</span>
        </span>
        <span class="chat-sr-only" aria-live="assertive" data-testid="settings-alert"><span v-if="shownAnnouncement?.isAssertive" :key="shownAnnouncement.count">{{ shownAnnouncement.text }}</span></span>
    </Dialog>
</template>

<style scoped>
/* Her own face's badge, ringed in the dialog's fill. */
.chat-ms-id {
    --chat-av-ring: var(--chat-raised);
    --chat-av-ring-over: transparent;

    display: flex;
    gap: 12px;
    align-items: center;
}

.chat-ms-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.chat-ms-name {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -.01em;
    overflow-wrap: anywhere;
}

.chat-ms-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: 12.5px;
    color: var(--chat-muted);
}

/* The facts joined by 3px dots, as the details dialog joins them. */
.chat-ms-meta-item ~ .chat-ms-meta-item::before {
    display: inline-block;
    width: 3px;
    height: 3px;
    margin: 0 7px;
    vertical-align: middle;
    content: "";
    background: currentColor;
    border-radius: 50%;
    opacity: .55;
}

/* The list's one bar while it loads, a name's length, so the rows that land do not jump. */
.chat-ms-sk {
    display: block;
    width: 45%;
    height: 12px;
    border-radius: var(--chat-r-full);
}

.chat-ms-foot {
    margin: 14px 0 0 2px;
    font-size: 12px;
    color: var(--chat-muted);
}

/* This browser's state in words beside a dot: success when on, warning when blocked. */
.chat-push-status {
    display: inline-flex;
    flex: none;
    gap: 5px;
    align-items: center;
    font-size: 12.5px;
    color: var(--chat-muted);
    white-space: nowrap;
}

.chat-push-status::before {
    width: 7px;
    height: 7px;
    content: "";
    background: var(--chat-line-strong);
    border-radius: 50%;
}

.chat-push-status[data-state="on"]::before {
    background: var(--chat-success);
}

.chat-push-status[data-state="blocked"]::before {
    background: var(--chat-warning);
}

/* The small buttons: in the church's color, or outlined. */
.chat-ms-btn {
    display: inline-flex;
    flex: none;
    gap: 5px;
    align-items: center;
    height: 28px;
    padding: 0 10px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--chat-text);
    background: transparent;
    border: 0;
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), border-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-ms-btn.is-brand {
    color: var(--chat-on-brand);
    background: var(--chat-brand-fill);
}

.chat-ms-btn.is-brand:hover:not(:disabled) {
    background: color-mix(in srgb, var(--chat-brand-fill) 88%, var(--chat-shade));
}

.chat-ms-btn.is-line {
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
}

.chat-ms-btn.is-line:hover {
    border-color: var(--chat-icon);
}

.chat-ms-btn:disabled {
    cursor: default;
    opacity: .55;
}

.chat-ms-btn .chat-spinner {
    width: 12px;
    height: 12px;
}
</style>

<script setup lang="ts">
    import { computed, onBeforeUnmount, PropType, ref, watch } from "vue";
    import { busyEndOf, MeKey, MeSettings, meTitles, PrefsState, StatusChoice } from "../composables/usePrefs.partial";
    import { startOfDay } from "../feedLayout.partial";
    import { BlocksState, unnamedBlocked } from "../composables/useBlocks.partial";
    import { useFaceStatus, useStatusClock } from "../composables/usePresenceStatus.partial";
    import { ChatPerson } from "../types.partial";
    import { ownStatusWords, personFace, personName as nameOf } from "../ui/face.partial";
    import { PushState } from "../composables/usePush.partial";
    import Avatar from "../ui/avatar.partial.obs";
    import Dialog from "../ui/dialog.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import SettingGroup from "../ui/settingGroup.partial.obs";
    import { Note } from "../ui/settingNote.partial.obs";
    import SettingRow from "../ui/settingRow.partial.obs";
    import SettingSwitch from "../ui/settingSwitch.partial.obs";
    import StatusMenu from "./statusMenu.partial.obs";

    const props = defineProps({
        /** Whether the dialog is shown; kept mounted and closed, it plays its exit and gives focus back. */
        isOpen: {
            type: Boolean,
            default: false
        },

        /** The person's primary alias, whose own face the identity draws. */
        personAliasGuid: {
            type: String,
            default: ""
        },

        personName: {
            type: String,
            default: ""
        },

        personPhotoUrl: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The person's campus by its name, or null where they have none the church lists. */
        campusName: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The church's name, which the person's name and photo come from. */
        organizationName: {
            type: String,
            default: ""
        },

        /** The person's own switches as they stand. */
        me: {
            type: Object as PropType<MeSettings>,
            required: true
        },

        /** Her status as her settings show it, which the Status group says and its menu checks. */
        statusChoice: {
            type: Object as PropType<StatusChoice>,
            default: () => ({ busy_until: null, appear_offline: false })
        },

        /** Why her status cannot be set now, the banner's words while the church is read only; null while it can. */
        statusClosedReason: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The note under each switch: only a failed save's, since one that lands shows nothing more. */
        notes: {
            type: Object as PropType<Partial<Record<MeKey, Note>>>,
            default: () => ({})
        },

        /** The settings' newest sentence for screen readers; only one said while open is read. */
        announcement: {
            type: Object as PropType<PrefsState["announcement"]>,
            default: null
        },

        /** This browser's push. */
        push: {
            type: String as PropType<PushState>,
            default: "unavailable"
        },

        isPhone: {
            type: Boolean,
            default: false
        },

        /** The people the person blocked, read as the dialog opens. */
        blocked: {
            type: Object as PropType<Pick<BlocksState, "people" | "listState" | "busy" | "notes">>,
            default: () => ({ people: [], listState: "idle", busy: {}, notes: {} })
        }
    });

    const emit = defineEmits<{
        /** The close button, Escape or the scrim. */
        (e: "close"): void;

        /** A switch was pressed: its key and the value it asks for. */
        (e: "toggle", key: MeKey, value: boolean): void;

        /** Turn on or Turn off for this browser. */
        (e: "pushOn"): void;
        (e: "pushOff"): void;

        /** Unblock on a blocked person's row, which needs no confirmation; and Try again on a list that failed to load. */
        (e: "unblock", person: ChatPerson): void;
        (e: "retryBlocked"): void;

        /** A choice in the Status group's menu, for the block to save. */
        (e: "status", choice: StatusChoice): void;
    }>();

    // #region Values

    /** The settings' announcement count as the dialog opened, so only news said since is read. */
    const announcedBefore = ref(props.isOpen ? props.announcement?.count ?? 0 : Number.POSITIVE_INFINITY);

    /** The Blocked people group, whose rows focus moves along as one leaves. */
    const blockedGroup = ref<InstanceType<typeof SettingGroup>>();

    /** The viewer's clock as the status line last read it, moved on when the line's words would change. */
    const statusNow = ref(Date.now());

    /** The one timer that moves it, set while the dialog is open and the line has a change ahead. */
    let statusTimer: ReturnType<typeof setTimeout> | null = null;

    /** The longest a browser timer waits; a later change is waited for in steps. */
    const longestTimerMs = 2_147_483_647;

    /** The rows whose Unblock was pressed, in the order pressed, each until it leaves the list or is refused. */
    const unblocking = ref<Array<{ guid: string, name: string }>>([]);

    /** The last unblock that landed, said in the dialog's own words, keyed so the same words are read twice. */
    const unblockedSaid = ref<{ text: string, count: number } | null>(null);

    const statusOf = useFaceStatus(() => props.personAliasGuid ? [props.personAliasGuid] : [], 0);

    /** The server's time, which her Busy's end is read by, as her face reads it. */
    const serverNow = useStatusClock();

    /** How far the server's clock is ahead of the page's, which the line's clock and timer are kept by. */
    const clockOffset = (): number => serverNow() - Date.now();

    // #endregion Values

    // #region Computed Values

    const ownStatus = computed(() => props.personAliasGuid ? statusOf(props.personAliasGuid) : null);

    /** The campus, then where the person's name and photo come from. */
    const metaItems = computed((): string[] => [
        ...(props.campusName ? [props.campusName] : []),
        `From your ${props.organizationName} profile`
    ]);

    /**
     * What the browser row says in each of push's states: the state in words beside its dot, and a
     * line under the label only where the person has something to do.
     */
    const pushRow = computed((): { status: string | null, sub: string | null } => {
        switch (props.push) {
            case "offered":
                return { status: "Off", sub: null };

            case "asking":
                return { status: null, sub: "Choose Allow in your browser" };

            case "on":
                return { status: "On", sub: null };

            case "blocked":
                return { status: "Blocked", sub: "Allow it in browser settings, then reload" };

            default:
                return { status: "Not available", sub: `Not set up for ${props.organizationName} yet` };
        }
    });

    /**
     * Her status in her own words, in a group of its own right under her face, whose badge it
     * changes, and kept with online status off, since a Busy still pauses her notifications. It
     * says what she chose rather than what her activity draws: Automatic,
     * a Busy saying what it does to her, or Appear offline. A Busy whose end has passed is
     * Automatic again, by the line's own clock, which moves it on at the end.
     */
    const statusLine = computed((): string => {
        const now = new Date(statusNow.value);
        const end = busyEndOf(props.statusChoice, statusNow.value + clockOffset());
        if (props.statusChoice.appear_offline) {
            return ownStatusWords("hidden", null, now);
        }
        if (end === null) {
            return "Automatic";
        }
        return ownStatusWords("busy", end === Infinity ? null : new Date(end), now);
    });

    /**
     * When the line's words next change by the clock alone: her Busy's end, or before it the
     * viewer's next midnight while the end lies on a later day, since "tomorrow, 8:00 AM" reads
     * "8:00 AM" from then. Null while nothing ahead changes them.
     */
    const statusChangesAt = computed((): number | null => {
        const end = busyEndOf(props.statusChoice, statusNow.value + clockOffset());
        if (end === null || end === Infinity) {
            return null;
        }
        const today = startOfDay(new Date(statusNow.value));
        // the next day's start by the calendar, not 24 hours on, so a daylight saving change holds
        const midnight = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1).getTime();
        // the end on the page's clock, which the line's timer waits by
        return Math.min(end - clockOffset(), midnight);
    });

    /** The rows of blocked people, once the list is read and holds anyone. */
    const shownBlocked = computed((): ChatPerson[] => props.blocked.listState === "loaded" ? props.blocked.people : []);

    const shownAnnouncement = computed((): PrefsState["announcement"] => props.announcement && props.announcement.count > announcedBefore.value ? props.announcement : null);

    // #endregion Computed Values

    // #region Event Handlers

    /** A blocked person's name, or words for one the church no longer lists, who has none. */
    function blockedName(person: ChatPerson): string {
        return nameOf(person) || unnamedBlocked;
    }

    function onUnblock(person: ChatPerson): void {
        const guid = person.person_alias_guid.toLowerCase();
        unblocking.value = [...unblocking.value.filter(pressed => pressed.guid !== guid), { guid, name: blockedName(person) }];
        emit("unblock", person);
    }

    function onToggle(key: MeKey, value: boolean): void {
        emit("toggle", key, value);
    }

    // #endregion Event Handlers

    // #region Watchers

    // Each opening reads only the news said from then on.
    watch(() => props.isOpen, isOpen => {
        announcedBefore.value = isOpen ? props.announcement?.count ?? 0 : Number.POSITIVE_INFINITY;
        unblocking.value = [];
        unblockedSaid.value = null;
    });

    // An unblock that lands takes its row, and the button focused with it, out of the list: it is
    // said, and focus goes to the row that took its place, else the one before, else the empty line,
    // so a keyboard stays in the group. Unblocks out at once are each said as they land, and focus
    // moves only when it went with a row, so one landing never pulls it off a row still there. A
    // refusal leaves the row with its note, and focus on it.
    watch(() => [shownBlocked.value, unblocking.value.map(pressed => props.blocked.notes[pressed.guid])] as const, (_now, before) => {
        const shown = new Set(shownBlocked.value.map(person => person.person_alias_guid.toLowerCase()));
        const landed = unblocking.value.filter(pressed => !shown.has(pressed.guid));
        const waiting = unblocking.value.filter(pressed => shown.has(pressed.guid) && !props.blocked.notes[pressed.guid]);
        // set only when one has settled, since setting it asks this again
        if (waiting.length !== unblocking.value.length) {
            unblocking.value = waiting;
        }
        if (landed.length === 0) {
            return;
        }

        unblockedSaid.value = { text: landed.map(pressed => `Unblocked ${pressed.name}`).join(". "), count: (unblockedSaid.value?.count ?? 0) + 1 };
        const active = document.activeElement;
        if (active && active !== document.body && active.isConnected) {
            return;
        }

        // where the row pressed last stood, among the rows still listed
        const previous = (before?.[0] ?? []).map(person => person.person_alias_guid.toLowerCase());
        const last = previous.indexOf(landed[landed.length - 1].guid);
        const index = previous.slice(0, Math.max(0, last)).filter(guid => shown.has(guid)).length;
        const group = blockedGroup.value?.$el as HTMLElement | undefined;
        const buttons = group?.querySelectorAll<HTMLElement>("[data-testid='blocked-unblock']") ?? [];
        const next = buttons[Math.min(index, buttons.length - 1)] ?? group?.querySelector<HTMLElement>("[data-testid='blocked-empty']");
        next?.focus();
    }, { flush: "post" });

    // The status line keeps time only while it is seen, waking once at its next change.
    watch([() => props.isOpen, statusChangesAt], ([isOpen, changesAt]) => {
        if (statusTimer !== null) {
            clearTimeout(statusTimer);
            statusTimer = null;
        }
        if (!isOpen) {
            return;
        }
        // reopened after a while, the line reads the clock now before it waits
        statusNow.value = Date.now();
        if (changesAt === null) {
            return;
        }
        statusTimer = setTimeout(() => {
            statusTimer = null;
            // never short of the change, so a timer that fires a touch early still moves the line on
            statusNow.value = Math.max(Date.now(), changesAt);
        }, Math.min(longestTimerMs, Math.max(0, changesAt - Date.now())));
    }, { immediate: true });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onBeforeUnmount(() => {
        if (statusTimer !== null) {
            clearTimeout(statusTimer);
        }
    });

    // #endregion Lifecycle Hooks

</script>
