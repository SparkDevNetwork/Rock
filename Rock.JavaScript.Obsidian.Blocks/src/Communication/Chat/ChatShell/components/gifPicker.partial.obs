<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <!--
        A sheet on a phone is the dialog itself; beside the "+" the popover is. On a touch screen
        the surface takes focus, as focus in the search would raise the keyboard over the GIFs.
    -->
    <Popover :popover="pop"
             label="Add a GIF"
             :role="pop.isSheet.value ? '' : 'dialog'"
             sheetHeight="picker"
             tabindex="-1"
             :data-autofocus="isTouch ? '' : undefined"
             data-testid="gif-picker"
             @keydown="onKeydown">
        <div class="chat-picker chat-gif" :class="{ 'is-sheet': pop.isSheet.value }">
            <div class="chat-gif-head">
                <Field ref="searchField"
                       leadingIcon="search"
                       placeholder="Search KLIPY"
                       clearable
                       clearLabel="Clear search"
                       autocomplete="off"
                       spellcheck="false"
                       aria-label="Search KLIPY for a GIF"
                       :data-autofocus="isTouch ? undefined : ''"
                       :aria-controls="bodyId"
                       :modelValue="search.query"
                       @update:modelValue="onSearchInput"
                       @clear="onClear"
                       @keydown="onSearchKeydown" />
            </div>

            <div :id="bodyId"
                 ref="bodyElement"
                 class="chat-gif-body"
                 :aria-busy="search.status === 'loading' ? 'true' : undefined"
                 @scroll="onBodyScroll">
                <template v-if="search.status === 'idle'">
                    <p class="chat-gif-label">Try a search</p>
                    <div class="chat-gif-chips">
                        <Pill v-for="word in gifSuggestions"
                              :key="word"
                              data-testid="gif-suggestion"
                              @click="onSuggestion(word)">{{ word }}</Pill>
                    </div>
                </template>

                <div v-else-if="search.status === 'loading'" class="chat-gif-masonry" data-testid="gif-loading" aria-hidden="true">
                    <div v-for="column in loadingColumns" :key="column[0]" class="chat-gif-column">
                        <span v-for="shape in column" :key="shape" class="chat-gif-tile is-loading" :style="{ aspectRatio: shape }"></span>
                    </div>
                </div>

                <div v-else-if="search.status === 'results'" class="chat-gif-masonry">
                    <div v-for="(column, columnIndex) in columns" :key="columnIndex" class="chat-gif-column" data-testid="gif-column">
                        <button v-for="tile in column"
                                :key="tile.item.slug"
                                type="button"
                                class="chat-gif-tile"
                                :class="{ 'is-loading': !loaded.has(tile.item.slug) }"
                                data-testid="gif-tile"
                                :data-slug="tile.item.slug"
                                :data-index="tile.index"
                                :aria-label="tile.item.title || 'GIF'"
                                :tabindex="tile.index === stop ? 0 : -1"
                                :style="tileStyle(tile.item)"
                                @click="pick(tile.item)">
                            <img :src="tile.item.preview.url"
                                 alt=""
                                 referrerpolicy="no-referrer"
                                 decoding="async"
                                 @load="onTileLoad(tile.item.slug)" />
                        </button>
                    </div>
                </div>

                <EmptyState v-else-if="search.status === 'empty'"
                            title="No GIFs found"
                            text="Try another word, like Thanks or Amen."
                            data-testid="gif-empty" />

                <!-- A busy search says KLIPY's own sentence; any other failure says why in general. -->
                <EmptyState v-else
                            tone="error"
                            :title="search.status === 'busy' ? search.busyText ?? '' : failedTitle"
                            :text="search.status === 'busy' ? '' : 'Check your connection, then try again.'"
                            actionLabel="Try again"
                            actionIcon="refresh"
                            :actionAttrs="{ 'data-testid': 'gif-retry' }"
                            data-testid="gif-error"
                            @action="search.retry()" />
            </div>

            <div class="chat-gif-foot" data-testid="gif-foot">Powered by <b>KLIPY</b></div>
        </div>
    </Popover>
</template>

<style scoped>
/* The picker's frame inside the popover, the emoji picker's size: its parts in a column, cut to the popover's corners. */
.chat-picker {
    display: flex;
    flex-direction: column;
    width: 328px;
    max-width: calc(100vw - 16px);
    max-height: 380px;
    overflow: hidden;
    border-radius: inherit;
}

/* In a sheet it fills the sheet's height instead. */
.chat-picker.is-sheet {
    flex: 1;
    width: auto;
    max-width: none;
    min-height: 0;
    max-height: none;
}

.chat-gif-head {
    flex: none;
    padding: 10px 10px 6px;
}

.chat-gif.is-sheet .chat-gif-head {
    padding: 6px 12px 8px;
}

/* One height for every state, so the picker does not change size under the pointer as it searches. */
.chat-gif-body {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    height: 300px;
    padding: 2px 10px 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
}

.chat-gif.is-sheet .chat-gif-body {
    height: auto;
    padding: 2px 12px 8px;
}

.chat-gif-label {
    padding: 6px 2px 8px;
    margin: 0;
    font-size: var(--chat-fs-badge);
    font-weight: 700;
    line-height: 13px;
    color: var(--chat-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
}

.chat-gif-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

/* Two columns, each GIF whole at its own shape, the next one going in the shorter column. */
.chat-gif-masonry {
    display: flex;
    gap: 4px;
    align-items: flex-start;
}

.chat-gif-column {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
}

/* KLIPY's blurred stand-in fills the tile while its preview loads, pulsing until it does. */
.chat-gif-tile {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    background-color: var(--chat-bubble);
    background-position: center;
    background-size: cover;
    border: 0;
    border-radius: var(--chat-r-control);
}

.chat-gif-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--chat-t-base) var(--chat-ease-state);
}

.chat-gif-tile.is-loading {
    animation: var(--chat-loop-stop, chat-skeleton-pulse) var(--chat-d-skeleton) var(--chat-ease-state) infinite alternate;
}

.chat-gif-tile.is-loading img {
    opacity: 0;
}

/* A hovered or focused tile takes the grid's ring, drawn over the GIF. */
.chat-gif-tile::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    border-radius: inherit;
    transition: box-shadow var(--chat-t-fast) var(--chat-ease-state);
}

.chat-gif-tile:hover::after,
.chat-gif-tile:focus-visible::after {
    box-shadow: inset 0 0 0 2px var(--chat-brand-fill), inset 0 0 0 4px var(--chat-brand-ring);
}

.chat-gif-tile:focus-visible {
    outline: none;
}

/* KLIPY named at the foot, as its terms ask. */
.chat-gif-foot {
    display: flex;
    flex: none;
    gap: 4px;
    align-items: center;
    justify-content: flex-end;
    height: 28px;
    padding: 0 12px;
    font-size: var(--chat-fs-badge);
    color: var(--chat-muted);
    background: var(--chat-sidebar);
    border-top: 1px solid var(--chat-line);
}

.chat-gif.is-sheet .chat-gif-foot {
    height: 34px;
    padding-bottom: 6px;
}

.chat-gif-foot b {
    font-weight: 800;
    color: var(--chat-text-2);
    letter-spacing: .04em;
}
</style>

<script setup lang="ts">
    import { computed, getCurrentInstance, nextTick, onBeforeUnmount, onMounted, PropType, reactive, ref, watch } from "vue";
    import { useChatSession } from "../chatSession.partial";
    import Field from "../ui/field.partial.obs";
    import { useAnnouncer } from "../ui/announcer.partial";
    import EmptyState from "../ui/emptyState.partial.obs";
    import Pill from "../ui/pill.partial.obs";
    import { usePopover } from "../ui/popover.partial";
    import Popover from "../ui/popoverSurface.partial.obs";
    import { isHoverless } from "../ui/viewport.partial";
    import { createGifSearch, Gifs, gifSuggestions, masonry, MasonryTile, nextInMasonry } from "../composables/useGifs.partial";
    import { GifResult } from "../types.partial";

    const props = defineProps({
        /** The session's GIF search. */
        gifs: {
            type: Object as PropType<Gifs>,
            required: true
        },

        /** What opened the picker, which it is placed above and hands focus back to. */
        anchor: {
            type: Object as PropType<HTMLElement | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        /** A GIF was chosen, for the composer to stage. */
        (e: "pick", result: GifResult): void;
        (e: "close"): void;
    }>();

    // #region Values

    /** How near the body's end a scroll asks the next page, in pixels. */
    const loadMoreWithinPx = 200;

    /** What a failed search says, drawn and heard alike. */
    const failedTitle = "GIFs can't load right now";

    /** The shapes the loading tiles take, two columns of GIF-like sizes, so the wait looks like what comes. */
    const loadingColumns = [["16 / 9", "1 / 1", "4 / 3"], ["3 / 4", "16 / 10", "1 / 1"]];

    /** Names this picker's body, so its search can say what it controls. */
    const bodyId = `chat-gif-body-${getCurrentInstance()?.uid ?? 0}`;

    /** Above the "+" at its start, or a sheet of the picker's height while the chat is a phone's width. */
    const session = useChatSession();
    const pop = usePopover(computed(() => props.anchor ?? undefined), ref<HTMLElement>(), {
        placement: "top-start",
        isSheet: () => session.isPhone.value,
        returnTo: () => props.anchor
    });

    /** Whether the screen is touch only, where the surface rather than the search takes focus as it opens. */
    const isTouch = isHoverless();

    const searchField = ref<InstanceType<typeof Field>>();

    /** The search's input, which the picker opens on and returns to. */
    const searchElement = computed((): HTMLInputElement | undefined => searchField.value?.inputElement);
    const bodyElement = ref<HTMLElement>();

    /** The search this picker holds while it is open. */
    const search = createGifSearch(props.gifs);

    /** The GIFs whose preview has loaded, which stop showing the blurred stand-in. */
    const loaded = reactive(new Set<string>());

    /** The tile the arrows move from and Tab lands on, by its place in KLIPY's order. */
    const stop = ref(0);

    // #endregion Values

    // #region Computed Values

    const columns = computed((): MasonryTile[][] => masonry(search.items));

    /** What a screen reader hears as a search settles. */
    const liveLine = computed((): string => {
        if (search.status === "results") {
            return `${search.items.length} ${search.items.length === 1 ? "GIF" : "GIFs"}`;
        }

        switch (search.status) {
            case "empty":
                return "No GIFs found";
            case "busy":
                return search.busyText ?? "";
            case "error":
                return failedTitle;
            default:
                return "";
        }
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onSearchInput(query: string): void {
        stop.value = 0;
        search.setQuery(query);
    }

    /** Enter searches at once; Down goes to the first GIF. */
    function onSearchKeydown(event: KeyboardEvent): void {
        if (event.key === "Enter") {
            event.preventDefault();
            search.setQuery((event.target as HTMLInputElement).value, true);
        }
        else if (event.key === "ArrowDown" && search.status === "results") {
            event.preventDefault();
            focusTile(0);
        }
    }

    /** The arrows move between GIFs by the columns, Up from the top goes back to the search, and Enter picks. */
    function onKeydown(event: KeyboardEvent): void {
        const target = event.target as HTMLElement;
        const index = Number(target.dataset?.index);
        if (!target.classList?.contains("chat-gif-tile") || Number.isNaN(index)) {
            return;
        }

        if (event.key === "Enter" || event.key === " ") {
            // Handled here so the choice does not depend on the browser turning a key into a click.
            event.preventDefault();
            pick(search.items[index]);
            return;
        }

        if (!event.key.startsWith("Arrow")) {
            return;
        }

        event.preventDefault();
        const next = nextInMasonry(columns.value, index, event.key);
        if (next !== null) {
            focusTile(next);
        }
        else if (event.key === "ArrowUp") {
            searchElement.value?.focus();
        }
    }

    function onSuggestion(word: string): void {
        stop.value = 0;
        search.setQuery(word, true);
    }

    /** The field has emptied the query and kept focus in the search. */
    function onClear(): void {
        search.setQuery("");
    }

    function onTileLoad(slug: string): void {
        loaded.add(slug);
    }

    /** Near the end of what is drawn, the next page is asked. */
    function onBodyScroll(): void {
        const body = bodyElement.value;
        if (body && body.scrollTop + body.clientHeight >= body.scrollHeight - loadMoreWithinPx) {
            search.loadMore();
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /** A tile's shape before its preview loads, and KLIPY's blurred stand-in behind it. */
    function tileStyle(item: GifResult): Record<string, string> {
        const width = item.preview.width || item.width || 1;
        const height = item.preview.height || item.height || 1;
        return {
            aspectRatio: `${width} / ${height}`,
            ...(item.blur ? { backgroundImage: `url("${item.blur}")` } : {})
        };
    }

    /** Moves the arrows' stop to a tile and focus with it, scrolled just into view. */
    async function focusTile(index: number): Promise<void> {
        stop.value = index;
        await nextTick();
        const element = bodyElement.value?.querySelector<HTMLElement>(`[data-index="${index}"]`);
        element?.focus({ preventScroll: true });
        element?.scrollIntoView?.({ block: "nearest" });
    }

    function pick(item: GifResult | undefined): void {
        if (!item || !pop.isOpen.value) {
            return;
        }

        emit("pick", item);
        pop.close({ isFocusReturned: true });
    }

    // #endregion Functions

    // #region Lifecycle Hooks

    // Focus goes to the search, unless the screen is touch only, where it would raise the keyboard
    // over the GIFs; the surface takes it there and Escape still reaches it.
    onMounted(async () => {
        if (await pop.open()) {
            (isTouch ? pop.floating.value : searchElement.value)?.focus({ preventScroll: true });
        }
    });

    // What a search came to is said as it settles, from inside the sheet while it is one.
    const { announce } = useAnnouncer();
    watch(liveLine, line => {
        if (line) {
            announce(line);
        }
    });

    // However it closes, the search ends as the picker starts to leave, so a pause that runs out or
    // an answer that comes in during the way out writes nothing, and the host hears it at once.
    watch(pop.isOpen, isOpen => {
        if (!isOpen) {
            search.stop();
            emit("close");
        }
    });

    onBeforeUnmount(() => {
        search.stop();
    });

    // #endregion Lifecycle Hooks
</script>
