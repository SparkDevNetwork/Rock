<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Popover :popover="pop"
             label="Add a GIF"
             :role="pop.isSheet.value ? '' : 'dialog'"
             sheetHeight="picker"
             tabindex="-1"
             :data-autofocus="isTouch ? '' : undefined"
             data-testid="gif-picker"
             @keydown="onKeydown">
        <div class="chat-picker chat-gif" :class="{ 'is-sheet': pop.isSheet.value }">
            <!--
                A sheet on a phone is the dialog itself; beside the "+" the popover is. On a touch
                screen the surface takes focus, as focus in the search would raise the keyboard over the GIFs.
            -->
            <div class="chat-gif-head">
                <Field ref="searchField"
                       leadingIcon="search"
                       placeholder="Search KLIPY"
                       clearable
                       clearLabel="Clear search"
                       autocomplete="off"
                       spellcheck="false"
                       aria-label="Search KLIPY for a GIF"
                       :data-autofocus="isTouch ? undefined : ''"
                       :aria-controls="bodyId"
                       :modelValue="search.query"
                       @update:modelValue="onSearchInput"
                       @clear="onClear"
                       @keydown="onSearchKeydown" />
            </div>

            <div :id="bodyId"
                 ref="bodyElement"
                 class="chat-gif-body"
                 :aria-busy="search.status === 'loading' ? 'true' : undefined">
                <!--
                    Before anything is typed, the platform's topic words as tiles in the results'
                    grid: each its cover with the word on a plate, and a tile runs its word's search.
                -->
                <div v-if="view === 'topics'" class="chat-gif-masonry">
                    <div v-for="(column, columnIndex) in topicColumns" :key="columnIndex" class="chat-gif-column" data-testid="gif-topic-column">
                        <button v-for="tile in column"
                                :key="tile.item.word"
                                type="button"
                                class="chat-gif-tile"
                                data-testid="gif-topic"
                                :data-index="tile.index"
                                :aria-label="`Search ${tile.item.word}`"
                                :tabindex="tile.index === stop ? 0 : -1"
                                :style="{ aspectRatio: `1 / ${tile.height}` }"
                                @click="onTopic(tile.item.word)">
                            <img v-if="tile.item.still"
                                 :src="tile.item.still"
                                 alt=""
                                 referrerpolicy="no-referrer"
                                 decoding="async" />
                            <span class="chat-gif-plate" data-testid="gif-topic-plate">{{ tile.item.word }}</span>
                        </button>
                    </div>
                </div>

                <div v-else-if="view === 'loading'" class="chat-gif-masonry" data-testid="gif-loading" aria-hidden="true">
                    <div v-for="column in loadingColumns" :key="column[0]" class="chat-gif-column">
                        <span v-for="shape in column" :key="shape" class="chat-gif-tile is-loading" :style="{ aspectRatio: shape }"></span>
                    </div>
                </div>

                <div v-else-if="view === 'results'" class="chat-gif-masonry">
                    <div v-for="(column, columnIndex) in columns" :key="columnIndex" class="chat-gif-column" data-testid="gif-column">
                        <button v-for="tile in column"
                                :key="tile.item.slug"
                                type="button"
                                class="chat-gif-tile"
                                :class="{ 'is-loading': !loaded.has(tile.item.slug) }"
                                data-testid="gif-tile"
                                :data-slug="tile.item.slug"
                                :data-index="tile.index"
                                :aria-label="tile.item.title || 'GIF'"
                                :tabindex="tile.index === stop ? 0 : -1"
                                :style="tileStyle(tile.item)"
                                @click="pick(tile.item)">
                            <img :src="tile.item.preview.url"
                                 alt=""
                                 referrerpolicy="no-referrer"
                                 decoding="async"
                                 @load="onTileLoad(tile.item.slug)" />
                        </button>
                    </div>
                </div>

                <EmptyState v-else-if="view === 'empty'"
                            title="No GIFs found"
                            text="Try another word, like Thanks or Amen."
                            data-testid="gif-empty" />

                <!--
                    A busy search says KLIPY's own sentence; any other failure, a search's or the
                    topics', says why in general, and Try again asks the same again.
                -->
                <EmptyState v-else
                            tone="error"
                            :title="view === 'busy' ? search.busyText ?? '' : failedTitle"
                            :text="view === 'busy' ? '' : 'Check your connection, then try again.'"
                            actionLabel="Try again"
                            actionIcon="refresh"
                            :actionAttrs="{ 'data-testid': 'gif-retry' }"
                            data-testid="gif-error"
                            @action="onRetry" />

                <!-- The end of the GIFs, which asks the next page as it comes into view. -->
                <span v-if="search.status === 'results'" ref="endElement" class="chat-gif-end" aria-hidden="true"></span>
            </div>

            <div class="chat-gif-foot" data-testid="gif-foot">Powered by <b>KLIPY</b></div>
        </div>
    </Popover>
</template>

<style scoped>
.chat-gif-head {
    flex: none;
    padding: 10px 10px 6px;
}

.chat-gif.is-sheet .chat-gif-head {
    padding: 6px 12px 8px;
}

/* One height for every state, so the picker does not change size under the pointer as it searches. */
.chat-gif-body {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    height: 300px;
    padding: 2px 10px 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
}

.chat-gif.is-sheet .chat-gif-body {
    height: auto;
    padding: 2px 12px 8px;
}

/*
    Two columns, each GIF whole at its own shape, the next one going in the shorter column. Each
    view comes in by the sheet's enter, a rise the token sheet turns to a fade under reduced motion.
*/
.chat-gif-masonry {
    display: flex;
    gap: 4px;
    align-items: flex-start;
    animation: chat-enter var(--chat-t-base) var(--chat-ease-in);
}

.chat-gif-column {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
}

/* KLIPY's blurred stand-in fills the tile while its preview loads, pulsing until it does. */
.chat-gif-tile {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    background-color: var(--chat-bubble);
    background-position: center;
    background-size: cover;
    border: 0;
    border-radius: var(--chat-r-control);
}

.chat-gif-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--chat-t-base) var(--chat-ease-state);
}

.chat-gif-tile.is-loading {
    animation: var(--chat-loop-stop, chat-skeleton-pulse) var(--chat-d-skeleton) var(--chat-ease-state) infinite alternate;
}

.chat-gif-tile.is-loading img {
    opacity: 0;
}

/* A hovered or focused tile takes the grid's ring, drawn over the GIF. */
.chat-gif-tile::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    border-radius: inherit;
    transition: box-shadow var(--chat-t-fast) var(--chat-ease-state);
}

.chat-gif-tile:hover::after,
.chat-gif-tile:focus-visible::after {
    box-shadow: inset 0 0 0 2px var(--chat-brand-fill), inset 0 0 0 4px var(--chat-brand-ring);
}

.chat-gif-tile:focus-visible {
    outline: none;
}

/*
    A topic's word on a solid plate at its tile's foot, the veil every badge over a photo or a GIF
    takes, so the word reads on any cover; a word with no cover is the plate on the tile's ground.
*/
.chat-gif-plate {
    position: absolute;
    bottom: 6px;
    left: 6px;
    z-index: 1;
    max-width: calc(100% - 12px);
    padding: 4px 8px;
    overflow: hidden;
    font-size: var(--chat-fs-ui);
    font-weight: 600;
    line-height: 1.2;
    color: var(--chat-media-fg);
    text-overflow: ellipsis;
    white-space: nowrap;
    background: var(--chat-media-scrim);
    border-radius: var(--chat-r-control);
}

/* Where the GIFs end, a line the paging watches for. */
.chat-gif-end {
    display: block;
    height: 1px;
}

/* KLIPY named at the foot, as its terms ask. */
.chat-gif-foot {
    display: flex;
    flex: none;
    gap: 4px;
    align-items: center;
    justify-content: flex-end;
    height: 28px;
    padding: 0 12px;
    font-size: var(--chat-fs-badge);
    color: var(--chat-muted);
    background: var(--chat-sidebar);
    border-top: 1px solid var(--chat-line);
}

.chat-gif.is-sheet .chat-gif-foot {
    height: 34px;
    padding-bottom: 6px;
}

.chat-gif-foot b {
    font-weight: 800;
    color: var(--chat-text-2);
    letter-spacing: .04em;
}
</style>

<script setup lang="ts">
    import { computed, getCurrentInstance, nextTick, onBeforeUnmount, onMounted, PropType, reactive, ref, watch } from "vue";
    import { useChatSession } from "../chatSession.partial";
    import Field from "../ui/field.partial.obs";
    import { useAnnouncer } from "../ui/announcer.partial";
    import EmptyState from "../ui/emptyState.partial.obs";
    import { usePopover } from "../ui/popover.partial";
    import Popover from "../ui/popoverSurface.partial.obs";
    import { isHoverless } from "../ui/viewport.partial";
    import { usePagingTrigger } from "../composables/usePagingTrigger.partial";
    import { createGifSearch, GifCover, gifHeight, Gifs, masonry, MasonryTile, nextInMasonry } from "../composables/useGifs.partial";
    import { GifResult } from "../types.partial";

    const props = defineProps({
        /** The session's GIF search. */
        gifs: {
            type: Object as PropType<Gifs>,
            required: true
        },

        /** What opened the picker, which it is placed above and hands focus back to. */
        anchor: {
            type: Object as PropType<HTMLElement | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        /** A GIF was chosen, for the composer to stage. */
        (e: "pick", result: GifResult): void;
        (e: "close"): void;
    }>();

    // #region Values

    /** What a failed search says, drawn and heard alike. */
    const failedTitle = "GIFs can't load right now";

    /** The shapes the loading tiles take, two columns of GIF-like sizes, so the wait looks like what comes. */
    const loadingColumns = [["16 / 9", "1 / 1", "4 / 3"], ["3 / 4", "16 / 10", "1 / 1"]];

    /** Names this picker's body, so its search can say what it controls. */
    const bodyId = `chat-gif-body-${getCurrentInstance()?.uid ?? 0}`;

    /** Above the "+" at its start, or a sheet of the picker's height while the chat is a phone's width. */
    const session = useChatSession();
    const pop = usePopover(computed(() => props.anchor ?? undefined), ref<HTMLElement>(), {
        placement: "top-start",
        isSheet: () => session.isPhone.value,
        returnTo: () => props.anchor
    });

    /** Whether the screen is touch only, where the surface rather than the search takes focus as it opens. */
    const isTouch = isHoverless();

    const searchField = ref<InstanceType<typeof Field>>();

    /** The search's input, which the picker opens on and returns to. */
    const searchElement = computed((): HTMLInputElement | undefined => searchField.value?.inputElement);
    const bodyElement = ref<HTMLElement>();
    const endElement = ref<HTMLElement>();

    /** The search this picker holds while it is open. */
    const search = createGifSearch(props.gifs);

    /** The GIFs whose preview has loaded, which stop showing the blurred stand-in. */
    const loaded = reactive(new Set<string>());

    /** The tile the arrows move from and Tab lands on, by its place in KLIPY's order. */
    const stop = ref(0);

    /** The topic words and their covers once they come, or whether asking for them failed. */
    const topics = ref<GifCover[] | null>(null);
    const isTopicsFailed = ref(false);

    // #endregion Values

    // #region Computed Values

    const columns = computed((): MasonryTile[][] => masonry(search.items, gifHeight));

    /**
     * The topics in the results' grid. A tile keeps its cover's shape, held between 5:3 and 1:1.1
     * so every word's plate sits on enough picture; a word with no cover is 5:3.
     */
    const topicColumns = computed((): MasonryTile<GifCover>[][] => masonry(topics.value ?? [], cover => cover.width > 0 ? Math.min(1.1, Math.max(0.6, cover.height / cover.width)) : 0.6));

    /** What the body shows: the topics before anything is typed, else where the search stands. */
    const view = computed((): "topics" | "loading" | "results" | "empty" | "error" | "busy" => {
        if (search.status !== "idle") {
            return search.status;
        }

        if (isTopicsFailed.value) {
            return "error";
        }

        return topics.value ? "topics" : "loading";
    });

    /** The tiles the arrows move through in the view shown. */
    const shownColumns = computed((): MasonryTile<unknown>[][] => view.value === "topics" ? topicColumns.value : columns.value);

    /**
     * What a screen reader hears as the body settles, read from what is drawn, so a failure is
     * heard alike whether the search or the topics failed.
     */
    const liveLine = computed((): string => {
        switch (view.value) {
            case "results":
                return `${search.items.length} ${search.items.length === 1 ? "GIF" : "GIFs"}`;
            case "empty":
                return "No GIFs found";
            case "busy":
                return search.busyText ?? "";
            case "error":
                return failedTitle;
            default:
                return "";
        }
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onSearchInput(query: string): void {
        stop.value = 0;
        search.setQuery(query);
    }

    /** Enter searches at once; Down goes into the body, to the first tile, or to Try again on a failure. */
    function onSearchKeydown(event: KeyboardEvent): void {
        if (event.key === "Enter") {
            event.preventDefault();
            search.setQuery((event.target as HTMLInputElement).value, true);
        }
        else if (event.key === "ArrowDown" && (view.value === "results" || view.value === "topics")) {
            event.preventDefault();
            focusTile(0);
        }
        else if (event.key === "ArrowDown" && (view.value === "error" || view.value === "busy")) {
            event.preventDefault();
            bodyElement.value?.querySelector<HTMLElement>("button")?.focus();
        }
    }

    /** The arrows move between tiles by the columns, Up from the top goes back to the search, and Enter picks or searches. */
    function onKeydown(event: KeyboardEvent): void {
        const target = event.target as HTMLElement;
        const index = Number(target.dataset?.index);
        if (!target.classList?.contains("chat-gif-tile") || Number.isNaN(index)) {
            return;
        }

        if (event.key === "Enter" || event.key === " ") {
            // Handled here so the choice does not depend on the browser turning a key into a click.
            event.preventDefault();
            if (view.value === "topics") {
                onTopic(topics.value?.[index]?.word ?? "");
            }
            else {
                pick(search.items[index]);
            }
            return;
        }

        if (!event.key.startsWith("Arrow")) {
            return;
        }

        event.preventDefault();
        const next = nextInMasonry(shownColumns.value, index, event.key);
        if (next !== null) {
            focusTile(next);
        }
        else if (event.key === "ArrowUp") {
            searchElement.value?.focus();
        }
    }

    function onTopic(word: string): void {
        if (!word) {
            return;
        }

        stop.value = 0;
        search.setQuery(word, true);
    }

    /** Try again on a failure: the search's, or the topics' while nothing is typed. */
    function onRetry(): void {
        if (search.status === "idle") {
            void loadTopics();
        }
        else {
            search.retry();
        }
    }

    /** The field has emptied the query and kept focus in the search, and the topics come back. */
    function onClear(): void {
        stop.value = 0;
        search.setQuery("");
    }

    function onTileLoad(slug: string): void {
        loaded.add(slug);
    }

    // #endregion Event Handlers

    // #region Functions

    /** Asks for the topics, which the session keeps once they come, so a later open asks nothing. */
    async function loadTopics(): Promise<void> {
        isTopicsFailed.value = false;
        const answer = await props.gifs.covers();
        if (answer.ok) {
            topics.value = answer.words;
        }
        else {
            isTopicsFailed.value = true;
        }
    }

    /** A tile's shape before its preview loads, and KLIPY's blurred stand-in behind it. */
    function tileStyle(item: GifResult): Record<string, string> {
        const width = item.preview.width || item.width || 1;
        const height = item.preview.height || item.height || 1;
        return {
            aspectRatio: `${width} / ${height}`,
            ...(item.blur ? { backgroundImage: `url("${item.blur}")` } : {})
        };
    }

    /** Moves the arrows' stop to a tile and focus with it, scrolled just into view. */
    async function focusTile(index: number): Promise<void> {
        stop.value = index;
        await nextTick();
        const element = bodyElement.value?.querySelector<HTMLElement>(`[data-index="${index}"]`);
        element?.focus({ preventScroll: true });
        element?.scrollIntoView?.({ block: "nearest" });
    }

    function pick(item: GifResult | undefined): void {
        if (!item || !pop.isOpen.value) {
            return;
        }

        emit("pick", item);
        pop.close({ isFocusReturned: true });
    }

    // #endregion Functions

    // #region Lifecycle Hooks

    // Focus goes to the search, unless the screen is touch only, where it would raise the keyboard
    // over the GIFs; the surface takes it there and Escape still reaches it.
    onMounted(async () => {
        void loadTopics();
        if (await pop.open()) {
            (isTouch ? pop.floating.value : searchElement.value)?.focus({ preventScroll: true });
        }
    });

    // What a search came to is said as it settles, from inside the sheet while it is one.
    const { announce } = useAnnouncer();
    watch(liveLine, line => {
        if (line) {
            announce(line);
        }
    });

    // However it closes, the search ends as the picker starts to leave, so a pause that runs out or
    // an answer that comes in during the way out writes nothing, and the host hears it at once.
    watch(pop.isOpen, isOpen => {
        if (!isOpen) {
            search.stop();
            emit("close");
        }
    });

    onBeforeUnmount(() => {
        search.stop();
    });

    // #endregion Lifecycle Hooks

    // The next page is asked 200px before the end of the GIFs scrolls into view, while one is left and none is out.
    usePagingTrigger(endElement, () => search.loadMore(), {
        enabled: () => search.status === "results" && search.hasNext && !search.isLoadingMore,
        root: () => bodyElement.value ?? null,
        margin: "0px 0px 200px 0px"
    });
</script>
