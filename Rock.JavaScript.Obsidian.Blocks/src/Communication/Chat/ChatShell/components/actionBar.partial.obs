<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Transition name="chat-tools" :css="!isInstant">
        <div v-if="isDrawn"
             ref="barElement"
             class="chat-tools"
             :class="placementClasses"
             role="toolbar"
             aria-orientation="horizontal"
             :aria-label="toolbarLabel"
             data-testid="action-bar"
             @keydown="onKeydown"
             @focusin="onFocusIn">
            <div class="chat-tools-react" role="group" aria-label="Quick reactions">
                <button v-for="favorite in quickReactions"
                        :key="favorite.code"
                        type="button"
                        class="chat-tool is-glyph"
                        :tabindex="tabIndexOf(`react ${favorite.code}`)"
                        :aria-pressed="isMine(favorite.code) ? 'true' : 'false'"
                        :aria-label="`${isMine(favorite.code) ? 'Remove your' : 'React with'} ${favorite.label}`"
                        @mouseenter="onQuickEnter($event, favorite.label)"
                        @mouseleave="onPointerLeave"
                        @pointerdown="onPointerDown"
                        @focus="onQuickFocus($event, favorite.label)"
                        @blur="onBlur"
                        @click="onReact(favorite.code)">
                    <img v-if="!favorite.emoji && favorite.image_url" class="chat-tool-glyph" :src="favorite.image_url" alt="" />
                    <span v-else class="chat-tool-glyph" aria-hidden="true">{{ favorite.emoji }}</span>
                </button>
                <IconButton ref="addTool"
                            class="chat-tool is-add"
                            icon="smile-plus"
                            label="More reactions"
                            tooltip="Add reaction"
                            aria-haspopup="dialog"
                            :isTooltipDisabled="isPickerOpen"
                            :tabindex="tabIndexOf('add')"
                            @click="onOpenPicker" />
            </div>
            <span v-if="!isNarrow" class="chat-tools-sep" aria-hidden="true" data-testid="action-bar-separator"></span>
            <IconButton v-if="!isInThread"
                        class="chat-tool"
                        icon="thread"
                        label="Reply in thread"
                        :tabindex="tabIndexOf('reply')"
                        @click="onReplyInThread" />
            <IconButton class="chat-tool"
                        icon="reply"
                        label="Quote"
                        :tabindex="tabIndexOf('quote')"
                        @click="onQuote" />
            <Menu icon="dots"
                  label="More actions"
                  :items="menuItems"
                  :anchorAttrs="{ class: 'chat-tool', tabindex: tabIndexOf('more'), tooltip: 'More' }"
                  @select="onMenuSelect"
                  @openChange="onMenuOpenChange" />

            <!-- One tip for the quick reactions, moved to whichever the pointer rests on. -->
            <Teleport :to="tipHost ?? 'body'" :disabled="!tipHost">
                <div v-if="isTipShown" ref="tipElement" class="chat-tip" role="tooltip" :style="floatingStyles">{{ tipText }}</div>
            </Teleport>
        </div>
    </Transition>
</template>

<style scoped>
/*
    Docked at the bubble's outer top corner: another person's bar starts 44px in from the bubble's
    right edge, the reader's own ends 44px in from its left, each moved to the bubble's own edge
    when the column has no room, and dropped lower when the bubble is near the column's top.
*/
.chat-tools {
    position: absolute;
    top: -24px;
    z-index: 6;
    display: flex;
    gap: 2px;
    align-items: center;
    height: 34px;
    padding: 3px;
    white-space: nowrap;
    background: var(--chat-raised);
    border-radius: var(--chat-r-tools);
    box-shadow: var(--chat-shadow-bar);
}

.chat-tools:not(.is-own) {
    right: auto;
    left: max(0px, calc(100% - 44px));
}

.chat-tools.is-own {
    right: max(0px, calc(100% - 44px));
    left: auto;
}

.chat-tools.is-flush:not(.is-own) {
    right: 0;
    left: auto;
}

.chat-tools.is-flush.is-own {
    right: auto;
    left: 0;
}

.chat-tools.is-low {
    top: -6px;
}

/* Community docks it on the row's top right, inside the row near the top or under the New divider. */
.chat-tools.is-community,
.chat-tools.is-community.is-own {
    top: -18px;
    right: 14px;
    left: auto;
}

.chat-tools.is-community.is-low {
    top: 0;
}

.chat-tools.is-community.is-in-thread {
    right: 10px;
}

.chat-tools.is-community.is-narrow {
    right: 8px;
}

/* Pads the bar's hit area, so the pointer moving onto it from the message never falls into a gap. */
.chat-tools::before {
    position: absolute;
    inset: -6px -6px -14px;
    content: "";
    border-radius: inherit;
}

.chat-tools :deep(.chat-tool) {
    position: relative;
    width: 28px;
    height: 28px;
    color: var(--chat-icon);
    border-radius: var(--chat-r-tool);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), color var(--chat-t-fast) var(--chat-ease-state), box-shadow var(--chat-t-fast) var(--chat-ease-state);
}

.chat-tools :deep(.chat-tool .chat-ic) {
    width: 16px;
    height: 16px;
}

.chat-tools :deep(.chat-tool:hover) {
    color: var(--chat-text);
    background: var(--chat-hover);
}

.chat-tools :deep(.chat-tool:active) {
    background: var(--chat-press);
}

/* More keeps its plain look while its menu is open; the bar staying put already says which it is. */
.chat-tools :deep(.chat-tool[aria-expanded="true"]) {
    color: var(--chat-text);
    background: var(--chat-hover);
}

.chat-tools-react {
    display: flex;
    gap: 2px;
    align-items: center;
}

.chat-tools :deep(.chat-tool.is-add .chat-ic) {
    width: 18px;
    height: 18px;
}

/* A quick reaction is a wider tool around its glyph, and only the glyph moves: it grows on hover and gives on a press. */
.chat-tools .chat-tool.is-glyph {
    display: grid;
    place-items: center;
    width: 32px;
    padding: 0;
    font-size: 19px;
    line-height: 1;
    background: transparent;
    border: 0;
    border-radius: var(--chat-r-tool);
}

.chat-tool-glyph {
    display: block;
    transition: transform var(--chat-d-glyph) var(--chat-ease-spring);
}

/* A church's image emoji is held to the glyph's box. */
img.chat-tool-glyph {
    width: 19px;
    height: 19px;
    object-fit: contain;
}

.chat-tool.is-glyph:hover .chat-tool-glyph {
    transform: scale(1.15);
}

.chat-tool.is-glyph:active .chat-tool-glyph {
    transform: scale(.92);
    transition-duration: var(--chat-d-glyph-press);
}

.chat-tools .chat-tool.is-glyph[aria-pressed="true"] {
    background: var(--chat-brand-tint);
    box-shadow: inset 0 0 0 1px var(--chat-brand-line);
}

.chat-tools-sep {
    flex: none;
    width: 1px;
    height: 16px;
    margin: 0 4px;
    background: var(--chat-line);
}

/*
    The ring hugs the tool on the bar's own fill. The oldest Safari Rock supports has no
    :focus-visible, so every focus rings there, and a browser that can tell a click's focus apart
    takes the ring back from it.
*/
.chat-tools :deep(.chat-tool:focus) {
    outline: none;
    box-shadow: 0 0 0 2px var(--chat-raised), 0 0 0 4px var(--chat-brand-ring);
}

@supports selector(:focus-visible) {
    .chat-tools :deep(.chat-tool:focus:not(:focus-visible)) {
        box-shadow: none;
    }
}

/*
    A pressed quick reaction draws its ring with the same shadow the focus ring uses, so the two
    are drawn together, the focus ring outside the pressed one, and a click's focus keeps only the
    pressed ring.
*/
.chat-tools .chat-tool.is-glyph[aria-pressed="true"]:focus {
    box-shadow: inset 0 0 0 1px var(--chat-brand-line), 0 0 0 2px var(--chat-raised), 0 0 0 4px var(--chat-brand-ring);
}

@supports selector(:focus-visible) {
    .chat-tools .chat-tool.is-glyph[aria-pressed="true"]:focus:not(:focus-visible) {
        box-shadow: inset 0 0 0 1px var(--chat-brand-line);
    }
}

/*
    Shows by fading in and rising 3px home; hides by fading out faster, out of the pointer's way.
    Moving from message to message plays neither, since the same bar is only moved. Animations
    rather than transitions, so each starts the moment the rest or the grace runs out: a transition
    waits two frames for its starting class to be swapped, and the bar came late.
*/
.chat-tools-enter-active {
    animation: chat-tools-fade-in var(--chat-d-tools-show) linear, chat-tools-rise-in var(--chat-d-tools-move) var(--chat-ease-in);
}

.chat-tools-leave-active {
    pointer-events: none;
    animation: chat-tools-fade-out var(--chat-d-tools-hide) linear forwards, chat-tools-sink-out var(--chat-d-tools-move) var(--chat-ease-in) forwards;
}

@media (prefers-reduced-motion: reduce) {
    .chat-tool-glyph,
    .chat-tool.is-glyph:hover .chat-tool-glyph,
    .chat-tool.is-glyph:active .chat-tool-glyph {
        transition: none;
        transform: none;
    }

    /* No fade either: the bar is there or not. */
    .chat-tools-enter-active,
    .chat-tools-leave-active {
        animation: none;
    }
}

@keyframes chat-tools-fade-in {
    from {
        opacity: 0;
    }
}

@keyframes chat-tools-rise-in {
    from {
        transform: translateY(3px);
    }
}

@keyframes chat-tools-fade-out {
    to {
        opacity: 0;
    }
}

@keyframes chat-tools-sink-out {
    to {
        transform: translateY(3px);
    }
}
</style>

<script setup lang="ts">
    import { computed, getCurrentInstance, nextTick, onBeforeUnmount, onMounted, PropType, ref, watch } from "vue";
    import Menu, { MenuItem } from "../ui/menu.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import { overlayHostOf, useTooltip } from "../ui/tooltip.partial";
    import { isActionCall, isEditableMessage, MessageAction } from "../composables/useMessageActions.partial";
    import { timeLabel } from "../feedLayout.partial";
    import { ReactionFavorite, TimelineMessage } from "../types.partial";

    // #region Types

    /** The bar's tools, in the order the keyboard walks them: "react <code>" for a quick reaction. */
    type Tool = `react ${string}` | "add" | "reply" | "quote" | "more";

    // #endregion Types

    const props = defineProps({
        /**
         * The stored message the column docks the bar on, carrying the actions the server listed on
         * it; null while it is on none. Its row lends the bar a dock only while the message can be
         * acted on, so the bar draws for any message it is given.
         */
        message: {
            type: Object as PropType<TimelineMessage | null>,
            default: null
        },

        isOwn: {
            type: Boolean,
            default: false
        },

        /** Inside the thread drawer, where Reply in thread has no place. */
        isInThread: {
            type: Boolean,
            default: false
        },

        /** The column shows its one bar on this message: the pointer rested here, or a keyboard reached it. */
        isShown: {
            type: Boolean,
            default: false
        },

        /** The column showed or hid the bar without a fade, as a scroll does. */
        isInstant: {
            type: Boolean,
            default: false
        },

        /** Drawn on a channel's flat row, at its top right, rather than on a bubble's corner. */
        isCommunity: {
            type: Boolean,
            default: false
        },

        /** The name the row shows for the sender, which the toolbar's name reads. */
        senderName: {
            type: String as PropType<string>,
            default: ""
        },

        /** The church's favorites, in order; the first three are the quick reactions. */
        favorites: {
            type: Array as PropType<ReactionFavorite[]>,
            default: () => []
        },

        /**
         * What the open picker is placed beside. While that is this bar's More reactions, the bar
         * stays; another copy of the same message, in the thread beside it, does not.
         */
        pickerAnchor: {
            type: Object as PropType<HTMLElement | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        (e: "replyInThread", messageId: number): void;
        (e: "quote", message: TimelineMessage): void;
        (e: "edit", message: TimelineMessage): void;
        (e: "copy", message: TimelineMessage): void;
        (e: "delete", message: TimelineMessage): void;
        (e: "serverAction", action: MessageAction): void;
        (e: "react", message: TimelineMessage, code: string): void;
        (e: "openPicker", message: TimelineMessage, anchor: HTMLElement): void;
        (e: "holdChange", isHeld: boolean): void;
    }>();

    // #region Values

    /** A column this narrow or less keeps one quick reaction and takes the bar closer to its edge. */
    const narrowColumnPx = 560;

    /** A bubble or row this close to its column's top keeps its bar lower, inside the column. */
    const nearTopPx = 30;

    const instance = getCurrentInstance();

    const barElement = ref<HTMLElement>();

    const isMenuOpen = ref(false);

    /** The tool the arrows last moved to; the first tool holds the tab stop until they move. */
    const activeTool = ref<Tool | null>(null);

    const addTool = ref<InstanceType<typeof IconButton>>();

    const isFlush = ref(false);
    const isLow = ref(false);
    const isNarrow = ref(false);

    /** The quick reaction the one tip names, moved to whichever the pointer rests on or a key reaches. */
    const tipAnchor = ref<HTMLElement>();
    const tipText = ref("");

    /** The chat's root, which the tip is drawn in; null where the bar is drawn alone. */
    const tipHost = ref<HTMLElement | null>(null);

    const { tipElement, isTipShown, floatingStyles, hideTip, onPointerEnter, onPointerLeave, onPointerDown, onFocus, onBlur } = useTooltip(tipAnchor);

    // #endregion Values

    // #region Computed Values

    /** The picker is up beside this bar's More reactions. */
    const isPickerOpen = computed((): boolean => !!props.pickerAnchor && !!barElement.value?.contains(props.pickerAnchor));

    /**
     * A menu or a picker open from the bar keeps it, wherever the pointer went. A keyboard's focus
     * inside it keeps it too, which its column reads from the focus events that reach it.
     */
    const isHeld = computed((): boolean => isMenuOpen.value || isPickerOpen.value);

    const isDrawn = computed((): boolean => !!props.message && (props.isShown || isHeld.value));

    /** The first three favorites, or the first alone where the column is narrow. */
    const quickReactions = computed((): ReactionFavorite[] => props.favorites.slice(0, isNarrow.value ? 1 : 3));

    const tools = computed((): Tool[] => [
        ...quickReactions.value.map((favorite): Tool => `react ${favorite.code}`),
        "add",
        ...(props.isInThread ? [] : ["reply" as const]),
        "quote",
        "more"
    ]);

    /** The tool holding the toolbar's one tab stop: where the arrows left it, while it is still drawn. */
    const stopTool = computed((): Tool => activeTool.value && tools.value.includes(activeTool.value) ? activeTool.value : tools.value[0]);

    const toolbarLabel = computed((): string => {
        const message = props.message;
        if (!message) {
            return "";
        }

        const name = props.senderName || [message.sender_nick_name, message.sender_last_name].filter(part => !!part).join(" ") || "Someone";
        const whose = props.isOwn ? "your" : `${name}'s`;
        return `Actions for ${whose} message, ${timeLabel(new Date(message.created_at))}`;
    });

    /** Edit for the person's own message, Copy, the server's actions as a group, then Delete for their own. */
    const menuItems = computed((): MenuItem[] => {
        const message = props.message;
        const items: MenuItem[] = [];
        if (!message) {
            return items;
        }

        if (props.isOwn && isEditableMessage(message)) {
            items.push({ key: "edit", label: "Edit message", icon: "pencil", hint: "Up" });
        }

        items.push({ key: "copy", label: "Copy text", icon: "copy" });

        // Each by its place in the list, since an action's id is the server's and may be anything.
        // One whose call is not a chat action is still drawn, as the server listed it, but cannot run.
        (message.actions ?? []).forEach((action, index) => {
            items.push({ key: `action ${index}`, label: action.label, icon: "bolt", isSeparatorBefore: index === 0, isDisabled: !isActionCall(action.call) });
        });

        if (props.isOwn) {
            items.push({ key: "delete", label: "Delete message", icon: "trash", isDanger: true, isSeparatorBefore: true });
        }

        return items;
    });

    const placementClasses = computed((): Record<string, boolean> => ({
        "is-own": props.isOwn,
        "is-community": props.isCommunity,
        "is-in-thread": props.isInThread,
        "is-flush": isFlush.value,
        "is-low": isLow.value,
        "is-narrow": isNarrow.value
    }));

    // #endregion Computed Values

    // #region Event Handlers

    function onReplyInThread(): void {
        if (props.message) {
            emit("replyInThread", props.message.id);
        }
    }

    function onQuote(): void {
        if (props.message) {
            emit("quote", props.message);
        }
    }

    function onMenuSelect(key: string): void {
        const message = props.message;
        if (!message) {
            return;
        }

        // Each named on its own, since one emit cannot take a key that may be any of the three.
        if (key === "edit") {
            emit("edit", message);
            return;
        }

        if (key === "copy") {
            emit("copy", message);
            return;
        }

        if (key === "delete") {
            emit("delete", message);
            return;
        }

        const action = (message.actions ?? [])[Number(key.replace("action ", ""))];
        if (action) {
            emit("serverAction", action);
        }
    }

    function onMenuOpenChange(isOpen: boolean): void {
        isMenuOpen.value = isOpen;
    }

    function onReact(code: string): void {
        hideTip();
        if (props.message) {
            emit("react", props.message, code);
        }
    }

    function onOpenPicker(): void {
        const anchor = addTool.value?.buttonElement;
        if (props.message && anchor) {
            emit("openPicker", props.message, anchor);
        }
    }

    function onQuickEnter(event: MouseEvent, label: string): void {
        tipAnchor.value = event.currentTarget as HTMLElement;
        tipText.value = label;
        onPointerEnter();
    }

    function onQuickFocus(event: FocusEvent, label: string): void {
        tipAnchor.value = event.currentTarget as HTMLElement;
        tipText.value = label;
        onFocus();
    }

    /** The toolbar's arrows: Left and Right step between the tools and wrap, Home and End go to either end. */
    function onKeydown(event: KeyboardEvent): void {
        const elements = toolElements();
        const index = elements.indexOf(event.target as HTMLElement);

        // A key inside the open menu is the menu's own.
        if (index < 0) {
            return;
        }

        let next: number;
        if (event.key === "ArrowRight") {
            next = (index + 1) % elements.length;
        }
        else if (event.key === "ArrowLeft") {
            next = (index - 1 + elements.length) % elements.length;
        }
        else if (event.key === "Home") {
            next = 0;
        }
        else if (event.key === "End") {
            next = elements.length - 1;
        }
        else {
            return;
        }

        event.preventDefault();
        activeTool.value = tools.value[next];
        elements[next].focus();
    }

    /** A tool reached by Tab or a click holds the tab stop, so Tab back into the bar returns to it. */
    function onFocusIn(event: FocusEvent): void {
        const index = toolElements().indexOf(event.target as HTMLElement);
        if (index >= 0) {
            activeTool.value = tools.value[index];
        }
    }

    // #endregion Event Handlers

    // #region Functions

    function tabIndexOf(tool: Tool): number {
        return tool === stopTool.value ? 0 : -1;
    }

    /** Whether the reader reacted to the message with an emoji, which presses its quick reaction. */
    function isMine(code: string): boolean {
        return !!props.message?.reactions?.some(reaction => reaction.code === code && reaction.mine);
    }

    /** The tools as drawn, the bar's own buttons only, never an item of the menu inside it. */
    function toolElements(): HTMLElement[] {
        return Array.from(barElement.value?.querySelectorAll<HTMLElement>(":scope > .chat-tools-react > button, :scope > button") ?? []);
    }

    /** The element the bar is drawn in, read while it is hidden too, from where its placeholder is. */
    function hostElement(): Element | null {
        const placeholder = instance?.proxy?.$el as Node | null | undefined;
        return placeholder?.parentElement ?? null;
    }

    /**
     * Places the bar for the room around its message. A bubble's bar moves to the bubble's own edge
     * when the column has no room past it, and both looks drop it lower near the column's top, where
     * the feed's edge would cut it; a channel's row also keeps it inside the row under the New
     * divider, off the divider's label.
     */
    async function place(): Promise<void> {
        // The row's dock draws no box of its own, so the bar is placed against what holds the dock.
        const bar = barElement.value;
        const host = bar?.parentElement?.parentElement;
        const scroller = host?.closest<HTMLElement>("[data-chat-scroller]");
        if (!bar || !host || !scroller) {
            return;
        }

        // A narrow column drops two quick reactions, so the bar is measured once it has.
        const isNarrowNow = scroller.getBoundingClientRect().width <= narrowColumnPx;
        if (isNarrowNow !== isNarrow.value) {
            isNarrow.value = isNarrowNow;
            await nextTick();
        }

        const box = scroller.getBoundingClientRect();
        const anchor = host.getBoundingClientRect();

        if (props.isCommunity) {
            const group = host.parentElement;
            const before = group && group.firstElementChild === host ? group.previousElementSibling : null;
            isFlush.value = false;
            isLow.value = !!before?.classList.contains("chat-new-divider") || anchor.top - box.top < nearTopPx;
            return;
        }

        const room = props.isOwn ? anchor.left + 44 - box.left : box.right - (anchor.right - 44);
        isFlush.value = room < bar.offsetWidth + 8;
        isLow.value = anchor.top - box.top < nearTopPx;
    }

    // #endregion Functions

    // #region Watchers

    // The column moves the one bar from message to message, or takes it off one that can no longer
    // be acted on, deleted or opened in the editor: the arrows start again from the first tool, the
    // tip of the last message's quick reaction goes, and a menu left open there holds nothing.
    watch(() => props.message?.id, () => {
        activeTool.value = null;
        isMenuOpen.value = false;
        hideTip();
    });

    // Placed each time it shows or moves to another message, since the message may have moved since
    // the last; and as it is first drawn, since the column draws it shown in the dock it first shows in.
    watch([isDrawn, () => props.message?.id], async ([isShown]) => {
        if (isShown) {
            await nextTick();
            await place();
        }
    }, { immediate: true });

    // The column keeps the bar where it is while something holds it.
    watch(isHeld, isHolding => {
        emit("holdChange", isHolding);
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(() => {
        tipHost.value = overlayHostOf(hostElement());
    });

    // A bar taken away while held, its column gone, lets the column go.
    onBeforeUnmount(() => {
        if (isHeld.value) {
            emit("holdChange", false);
        }
    });

    // #endregion Lifecycle Hooks
</script>
