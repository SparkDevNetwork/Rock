<template>
    <span></span>
</template>

<script setup lang="ts">
    // A message's action bar. An empty stand-in with the planned props and no behaviour yet, so
    // the tests written against it fail on what they assert.
    import { PropType } from "vue";
    import { PendingMessage, TimelineMessage } from "../types.partial";

    defineProps({
        message: {
            type: Object as PropType<TimelineMessage | null>,
            default: null
        },

        pending: {
            type: Object as PropType<PendingMessage | null>,
            default: null
        },

        isOwn: {
            type: Boolean,
            default: false
        },

        isInThread: {
            type: Boolean,
            default: false
        },

        isPreviewing: {
            type: Boolean,
            default: false
        },

        isEditing: {
            type: Boolean,
            default: false
        },

        isPointerInside: {
            type: Boolean,
            default: false
        }
    });
</script>
