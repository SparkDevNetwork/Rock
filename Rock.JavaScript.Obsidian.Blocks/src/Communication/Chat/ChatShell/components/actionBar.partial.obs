<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <span ref="guard"
          class="chat-box-guard"
          :tabindex="boxMessage && !pop.isSheet.value ? 0 : -1"
          data-testid="action-bar-guard"
          @focus="onGuardFocus"></span>
    <Teleport :to="overlayHost ?? 'body'" :disabled="!overlayHost">
        <div class="chat-box-layer">
            <!-- A plain element between the teleport and the fade: Vue 3.3 throws on a fading child of a teleport nested in the dock's teleport as its column moves or goes. -->
            <Transition name="chat-tools" :css="!isInstant">
            <div v-if="isDrawn && !pop.isSheet.value"
                 ref="boxElement"
                 class="chat-box"
                 :role="layer === 'bar' ? undefined : 'dialog'"
                 :aria-label="layer === 'bar' ? undefined : 'Add reaction'"
                 :data-layer="layer"
                 :data-hot-id="boxMessage?.id"
                 data-testid="message-box"
                 :style="pop.floatingStyles.value"
                 @pointerover="onBoxPointerOver"
                 @pointerleave="onBoxPointerLeave"
                 @focusin="onBoxFocusIn"
                 @focusout="onBoxFocusOut"
                 @keydown="onKeydown">
                <div v-if="layer === 'bar'"
                     ref="barElement"
                     class="chat-tools"
                     role="toolbar"
                     aria-orientation="horizontal"
                     :aria-label="toolbarLabel"
                     data-testid="action-bar">
                    <div class="chat-tools-react" role="group" aria-label="Quick reactions">
                        <IconButton v-for="favorite in quickReactions"
                                    :key="favorite.code"
                                    class="chat-tool-quick"
                                    :label="`${isMine(favorite.code) ? 'Remove your' : 'React with'} ${favorite.label}`"
                                    :tooltip="favorite.label"
                                    :tabindex="tabIndexOf(`react ${favorite.code}`)"
                                    :aria-pressed="isMine(favorite.code) ? 'true' : 'false'"
                                    @click="onReact(favorite.code)">
                            <span class="chat-tool-face" :class="{ 'is-mine': isMine(favorite.code) }" aria-hidden="true">
                                <img v-if="!favorite.emoji && favorite.image_url" class="chat-tool-glyph" :src="favorite.image_url" alt="" />
                                <span v-else class="chat-tool-glyph">{{ favorite.emoji }}</span>
                            </span>
                        </IconButton>
                        <IconButton icon="smile-plus"
                                    label="More reactions"
                                    tooltip="Add reaction"
                                    aria-haspopup="dialog"
                                    :tabindex="tabIndexOf('add')"
                                    @click="onOpenPicker" />
                    </div>
                    <span v-if="form === 'full'" class="chat-tools-sep" aria-hidden="true" data-testid="action-bar-separator"></span>
                    <IconButton v-if="!isInThread"
                                icon="thread"
                                label="Reply in thread"
                                :tabindex="tabIndexOf('reply')"
                                @click="onReplyInThread" />
                    <IconButton icon="quote"
                                label="Quote"
                                :tabindex="tabIndexOf('quote')"
                                @click="onQuote" />
                    <Menu icon="dots"
                          label="More actions"
                          :items="menuItems"
                          :anchorAttrs="{ tabindex: tabIndexOf('more'), tooltip: 'More' }"
                          @select="onMenuSelect"
                          @openChange="onMenuOpenChange" />
                </div>
                <EmojiPicker v-else
                             mode="react"
                             :startsOn="layer === 'tray' ? 'tray' : 'full'"
                             :offered="held?.offered ?? []"
                             :source="bars?.emojiSource.value ?? emptySource"
                             :mine="bars?.pickerMine.value ?? []"
                             :isKeyboardOpened="held?.isKeyboard ?? false"
                             @react="onChoose"
                             @showAll="bars?.showAllEmoji()" />
            </div>
            </Transition>
        </div>
    </Teleport>

    <Popover v-if="pop.isSheet.value" :popover="pop" label="Add reaction" sheetHeight="picker">
        <EmojiPicker v-if="held"
                     mode="react"
                     startsOn="full"
                     :source="bars?.emojiSource.value ?? emptySource"
                     :mine="bars?.pickerMine.value ?? []"
                     :isKeyboardOpened="held.isKeyboard"
                     @react="onChoose" />
    </Popover>
</template>

<style scoped>
/*
    The box's place in its message's row: no size, so the row lays out as if it were not there; it
    holds the keyboard's way into the box, drawn in the chat's root, and back out to the row.
*/
.chat-box-guard {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
}

/* No box of its own; it only stands between the teleport and the fade. */
.chat-box-layer {
    display: contents;
}

/*
    One outlined surface for the bar, the tray and the picker, the popover family's look: one
    hairline and a soft shadow. Fixed in the chat's root beside its message, so the column's edges
    never cut it.
*/
.chat-box {
    z-index: var(--chat-z-popover);
    white-space: nowrap;
    background: var(--chat-raised);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-surface);
    box-shadow: var(--chat-shadow-float);
}

/* Pads the box's hit area, so the pointer moving onto it from the message never falls into a gap. */
.chat-box::before {
    position: absolute;
    inset: -6px;
    z-index: -1;
    content: "";
}

/* Each tool one shared icon button at its one size; the bar is that size and its padding. */
.chat-tools {
    display: flex;
    gap: 2px;
    align-items: center;
    padding: 2px;
}

.chat-tools-react {
    display: flex;
    gap: 2px;
    align-items: center;
}

/* A quick reaction's glyph fills its button, so the reader's own takes the button's whole face. */
.chat-tool-face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: var(--chat-emoji-tool);
    line-height: 1;
    border-radius: inherit;
}

.chat-tool-face.is-mine {
    background: var(--chat-brand-tint);
    box-shadow: inset 0 0 0 1px var(--chat-brand-line);
}

.chat-tool-glyph {
    display: block;
    transition: transform var(--chat-d-glyph) var(--chat-ease-spring);
}

/* A church's image emoji is held to the glyph's box. */
img.chat-tool-glyph {
    width: var(--chat-emoji-tool);
    height: var(--chat-emoji-tool);
    object-fit: contain;
}

/* Only the glyph moves: it grows on hover and gives on a press. */
.chat-tool-quick:hover .chat-tool-glyph {
    transform: scale(var(--chat-glyph-grow));
}

.chat-tool-quick:active .chat-tool-glyph {
    transform: scale(var(--chat-press-deep));
    transition-duration: var(--chat-d-glyph-press);
}

.chat-tools-sep {
    flex: none;
    width: 1px;
    height: 16px;
    margin: 0 4px;
    background: var(--chat-line);
}

/*
    Shows by fading in and rising home by the small rise; hides by fading out faster, out of the pointer's way.
    Moving from message to message plays neither, since the same box is only moved. Animations
    rather than transitions, so each starts the moment the rest or the grace runs out: a transition
    waits two frames for its starting class to be swapped, and the box came late.
*/
.chat-tools-enter-active {
    --chat-slide-from: var(--chat-rise-sm);
    animation: chat-slide-in var(--chat-d-tools-move) var(--chat-ease-in), chat-fade-in var(--chat-d-tools-show) linear;
}

.chat-tools-leave-active {
    --chat-slide-to: var(--chat-rise-sm);
    pointer-events: none;
    animation: chat-slide-out var(--chat-d-tools-move) var(--chat-ease-in) forwards, chat-fade-out var(--chat-d-tools-hide) linear forwards;
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, onMounted, PropType, ref, watch } from "vue";
    import Menu, { MenuItem } from "../ui/menu.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import Popover from "../ui/popoverSurface.partial.obs";
    import { boundaryInsetPx, PopoverPlacement, tabPastEnd, usePopover } from "../ui/popover.partial";
    import { overlayHostOf } from "../ui/tooltip.partial";
    import EmojiPicker, { PickerSource } from "./emojiPicker.partial.obs";
    import { useChatSession } from "../chatSession.partial";
    import { useActionBars, useColumnActionBar } from "../composables/useActionBar.partial";
    import { isActionCall, isEditableMessage, isSenderBlockable, MessageAction } from "../composables/useMessageActions.partial";
    import { timeLabel } from "../feedLayout.partial";
    import { BoxLayer, ReactionFavorite, TimelineMessage } from "../types.partial";

    // A message's one box: its actions as a bar, the quick tray Add reaction turns it into, and the
    // emoji picker All emoji grows it into. Its place in the row is a guard of no size, which keeps
    // the keyboard's way in and out and what it is placed beside; the box itself is drawn in the
    // chat's root. Each step focuses what it draws; leaving the tray or the picker gives the bar
    // back, focus on Add reaction. On a phone the box is the picker alone, a sheet, as every picker
    // there is.

    defineOptions({ inheritAttrs: false });

    // #region Types

    /** The bar's tools, in the order the keyboard walks them: "react <code>" for a quick reaction. */
    type Tool = `react ${string}` | "add" | "reply" | "quote" | "more";

    /**
     * How much the bar draws: three quick reactions and the separator, the first alone, or the
     * tools alone, the widest that fits beside its bubble; a narrow column never draws all three.
     */
    type Form = "full" | "one" | "bare";

    /** Where a bubble's box stands: beside the bubble, or over its top at its own edge, under it where the column's top leaves no room. */
    type Side = "beside" | "over";

    // #endregion Types

    const props = defineProps({
        /**
         * The stored message the column docks the box on, carrying the actions the server listed on
         * it; null while it is on none. Its row lends the box a dock only while the message can be
         * acted on, so the bar draws for any message it is given.
         */
        message: {
            type: Object as PropType<TimelineMessage | null>,
            default: null
        },

        isOwn: {
            type: Boolean,
            default: false
        },

        /** Inside the thread drawer, where Reply in thread has no place. */
        isInThread: {
            type: Boolean,
            default: false
        },

        /** The column shows its one box on this message: the pointer rested here, or a keyboard reached it. */
        isShown: {
            type: Boolean,
            default: false
        },

        /** The column showed or hid the box without a fade, as a scroll does. */
        isInstant: {
            type: Boolean,
            default: false
        },

        /** Placed on a channel's flat row, at its top right, rather than beside a bubble. */
        isCommunity: {
            type: Boolean,
            default: false
        },

        /** The name the row shows for the sender, which the toolbar's name reads. */
        senderName: {
            type: String as PropType<string>,
            default: ""
        },

        /** The church's favorites, in order; the first three are the quick reactions. */
        favorites: {
            type: Array as PropType<ReactionFavorite[]>,
            default: () => []
        }
    });

    const emit = defineEmits<{
        (e: "replyInThread", message: TimelineMessage): void;
        (e: "quote", message: TimelineMessage): void;
        (e: "edit", message: TimelineMessage): void;
        (e: "copy", message: TimelineMessage): void;
        (e: "delete", message: TimelineMessage): void;
        (e: "block", message: TimelineMessage): void;
        (e: "serverAction", action: MessageAction): void;
        (e: "react", message: TimelineMessage, code: string): void;
        (e: "openPicker", message: TimelineMessage, anchor: HTMLElement, opening: { offered: string[] }): void;
        (e: "holdChange", isHeld: boolean): void;
    }>();

    // #region Values

    /** A column this narrow or less keeps one quick reaction. */
    const narrowColumnPx = 560;

    /** The forms, widest first, and how many quick reactions each draws. */
    const forms: Form[] = ["full", "one", "bare"];
    const quickCounts: Record<Form, number> = { full: 3, one: 1, bare: 0 };

    /** How far the box stands off the bubble beside it, and over or under it. */
    const besideGapPx = 6;
    const overGapPx = 4;

    /**
     * A channel's box: lifted over its row's top so it straddles the edge and covers the least of
     * the words, in from the row's end, and how far inside the row it moves where the column's top
     * leaves no room for the lift.
     */
    const channelLiftPx = 18;
    const channelEndInsetPx = 14;
    const insideGapPx = 4;

    /**
     * A channel row whose top is less than this under the column's inset has its box inside it,
     * so the box over the feed's first rows never presses on the feed's top edge.
     */
    const channelInsideBelowPx = 30;

    /** What a box drawn alone, outside any block, would pick from: nothing. */
    const emptySource: PickerSource = { favorites: [], catalog: null, recents: [], churchName: "" };

    const column = useColumnActionBar();
    const bars = useActionBars();
    const session = useChatSession();

    const guard = ref<HTMLElement>();
    const boxElement = ref<HTMLElement>();
    const barElement = ref<HTMLElement>();

    const isMenuOpen = ref(false);

    /** The tool the arrows last moved to; the first tool holds the tab stop until they move. */
    const activeTool = ref<Tool | null>(null);

    const form = ref<Form>("full");
    const side = ref<Side>("beside");

    /** Counts the fittings, so one overtaken while it waits for the box to redraw stops there. */
    let fitting = 0;

    /** The chat's root, which the box is drawn in; null where it is drawn alone, in place. */
    const overlayHost = ref<HTMLElement | null>(null);

    /** The block's grown box while it is this column's; read as the box is placed, so set before it. */
    const held = computed(() => {
        const box = bars?.held.value ?? null;
        return box && box.column === bars?.kindOf(guard.value) ? box : null;
    });

    /**
     * The control outside the box its grown form stands at, as the smile-plus under a message's
     * chips, which the person pressed and is looking at, or the bubble, whose dock beside it holds
     * the box's place rather than the bubble itself; null where the box grew from its own place in
     * the row, as the bar's Add reaction asks, or from the row that holds that place.
     */
    const control = computed((): HTMLElement | null => {
        const anchor = held.value?.anchor ?? null;
        return anchor && guard.value && !anchor.contains(guard.value) ? anchor : null;
    });

    /**
     * The box's floating: beside the bubble, away from the face, its top on the bubble's top; over
     * the bubble's top at its own edge, or under the bubble, only where the column has no room
     * beside for even the tools alone. A channel's at its row's top right, from the edge where its
     * top goes. Grown by a control outside it, at that control instead. Kept inside its column. It
     * is open, on the block's stack of floating layers, only while it is the tray or the picker:
     * Escape, a press elsewhere or Tab past its end then give the bar back.
     */
    const pop = usePopover(guard, boxElement, {
        placement: placementOf,
        offset: () => control.value ? overGapPx : props.isCommunity ? 0 : side.value === "beside" ? besideGapPx : overGapPx,
        fallbackPlacements: fallbacksOf,
        virtualAnchor: anchorBox,
        boundary: columnElement,
        isSheet: () => session.isPhone.value,
        returnTo: returnTarget,
        alsoInside: () => held.value?.opener
    });

    // #endregion Values

    // #region Computed Values

    const layer = computed((): BoxLayer => held.value?.layer ?? "bar");

    /** The message the box is on: the grown box's, else the one its column docks it on. */
    const boxMessage = computed((): { id: number } | null => held.value ? { id: held.value.messageId } : props.message);

    /**
     * A menu or the tray open from the box keeps it, wherever the pointer went. A keyboard's focus
     * inside it keeps it too, which its column reads from the focus events that reach it.
     */
    const isHeld = computed((): boolean => isMenuOpen.value || !!held.value);

    const isDrawn = computed((): boolean => !!held.value || (!!props.message && (props.isShown || isMenuOpen.value)));

    /** The favorites the bar's form has room for, first first. */
    const quickReactions = computed((): ReactionFavorite[] => props.favorites.slice(0, quickCounts[form.value]));

    const tools = computed((): Tool[] => [
        ...quickReactions.value.map((favorite): Tool => `react ${favorite.code}`),
        "add",
        ...(props.isInThread ? [] : ["reply" as const]),
        "quote",
        "more"
    ]);

    /** The tool holding the toolbar's one tab stop: where the arrows left it, while it is still drawn. */
    const stopTool = computed((): Tool => activeTool.value && tools.value.includes(activeTool.value) ? activeTool.value : tools.value[0]);

    const toolbarLabel = computed((): string => {
        const message = props.message;
        if (!message) {
            return "";
        }

        const name = props.senderName || [message.sender_nick_name, message.sender_last_name].filter(part => !!part).join(" ") || "Someone";
        const whose = props.isOwn ? "your" : `${name}'s`;
        return `Actions for ${whose} message, ${timeLabel(new Date(message.created_at))}`;
    });

    /** Edit for the person's own message, Copy, the server's actions as a group, then Delete for their own. */
    const menuItems = computed((): MenuItem[] => {
        const message = props.message;
        const items: MenuItem[] = [];
        if (!message) {
            return items;
        }

        if (props.isOwn && isEditableMessage(message)) {
            items.push({ key: "edit", label: "Edit message", icon: "pencil", hint: "Up" });
        }

        items.push({ key: "copy", label: "Copy text", icon: "copy" });

        // Each by its place in the list, since an action's id is the server's and may be anything.
        // One whose call is not a chat action is still drawn, as the server listed it, but cannot run.
        (message.actions ?? []).forEach((action, index) => {
            items.push({ key: `action ${index}`, label: action.label, icon: "bolt", isSeparatorBefore: index === 0, isDisabled: !isActionCall(action.call) });
        });

        if (props.isOwn) {
            items.push({ key: "delete", label: "Delete message", icon: "trash", isDanger: true, isSeparatorBefore: true });
        }

        if (isSenderBlockable(message, props.isOwn)) {
            items.push({ key: "block", label: "Block", icon: "ban", isSeparatorBefore: true });
        }

        return items;
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onReplyInThread(): void {
        if (props.message) {
            emit("replyInThread", props.message);
        }
    }

    function onQuote(): void {
        if (props.message) {
            emit("quote", props.message);
        }
    }

    function onMenuSelect(key: string): void {
        const message = props.message;
        if (!message) {
            return;
        }

        // Each named on its own, since one emit cannot take a key that may be any of the three.
        if (key === "edit") {
            emit("edit", message);
            return;
        }

        if (key === "copy") {
            emit("copy", message);
            return;
        }

        if (key === "delete") {
            emit("delete", message);
            return;
        }

        if (key === "block") {
            emit("block", message);
            return;
        }

        const action = (message.actions ?? [])[Number(key.replace("action ", ""))];
        if (action) {
            emit("serverAction", action);
        }
    }

    function onMenuOpenChange(isOpen: boolean): void {
        isMenuOpen.value = isOpen;
    }

    /** A quick reaction keeps the bar up, so a second can follow the first. */
    function onReact(code: string): void {
        if (props.message) {
            emit("react", props.message, code);
        }
    }

    /**
     * Add reaction turns the box into the tray, past the quick reactions the bar already shows. It
     * asks from the box's place in the row, which is what the box stays placed beside.
     */
    function onOpenPicker(): void {
        if (props.message && guard.value) {
            emit("openPicker", props.message, guard.value, { offered: quickReactions.value.map(favorite => favorite.code) });
        }
    }

    /**
     * A choice in the tray or the picker reacts and gives the bar back, focus on what opened the
     * box. The reaction redraws its message's chips in the patch it causes, which can take the
     * chip that opened the box away, so the box closes once that patch is drawn and gives focus to
     * what is there then.
     */
    async function onChoose(code: string): Promise<void> {
        bars?.onPickerReact(code);
        await nextTick();
        pop.close({ isFocusReturned: true });
    }

    /**
     * Tab reaching the box's place in the row goes on into the box, unless it is leaving the box.
     * A box hidden there is shown by its column as the focus reaches its message, and focus goes
     * in once it is drawn.
     */
    function onGuardFocus(event: FocusEvent): void {
        const from = event.relatedTarget;
        if (from instanceof Node && boxElement.value?.contains(from)) {
            return;
        }

        stopElement()?.focus({ preventScroll: true });
    }

    /** The pointer on the box is on its message, as the box marks itself with its message's. */
    function onBoxPointerOver(event: PointerEvent): void {
        column?.onPointerOver(event);
    }

    function onBoxPointerLeave(): void {
        column?.onPointerLeave();
    }

    function onBoxFocusOut(event: FocusEvent): void {
        column?.onFocusOut(event);
    }

    /** A tool reached by Tab or a click holds the tab stop, so Tab back into the bar returns to it. */
    function onBoxFocusIn(event: FocusEvent): void {
        const index = toolElements().indexOf(event.target as HTMLElement);
        if (index >= 0) {
            activeTool.value = tools.value[index];
        }

        column?.onFocusIn(event);
    }

    /**
     * The toolbar's arrows: Left and Right step between the tools and wrap, Home and End go to
     * either end. Tab past the bar's ends goes to its place in the row and on from there, as if
     * the box were drawn in the row.
     */
    function onKeydown(event: KeyboardEvent): void {
        const elements = toolElements();
        const index = elements.indexOf(event.target as HTMLElement);

        // A key inside the open menu, the tray or the picker is theirs.
        if (index < 0) {
            return;
        }

        // The bar is one tab stop, so Tab leaves it from whichever tool holds the stop.
        if (tabPastEnd(event, elements.filter(element => element.tabIndex >= 0), () => guard.value?.focus({ preventScroll: true }))) {
            return;
        }

        let next: number;
        if (event.key === "ArrowRight") {
            next = (index + 1) % elements.length;
        }
        else if (event.key === "ArrowLeft") {
            next = (index - 1 + elements.length) % elements.length;
        }
        else if (event.key === "Home") {
            next = 0;
        }
        else if (event.key === "End") {
            next = elements.length - 1;
        }
        else {
            return;
        }

        event.preventDefault();
        activeTool.value = tools.value[next];
        elements[next].focus();
    }

    // #endregion Event Handlers

    // #region Functions

    function tabIndexOf(tool: Tool): number {
        return tool === stopTool.value ? 0 : -1;
    }

    /** Whether the reader reacted to the message with an emoji, which presses its quick reaction. */
    function isMine(code: string): boolean {
        return !!props.message?.reactions?.some(reaction => reaction.code === code && reaction.mine);
    }

    /** The tools as drawn, the bar's own buttons only, never an item of the menu inside it. */
    function toolElements(): HTMLElement[] {
        return Array.from(barElement.value?.querySelectorAll<HTMLElement>(":scope > .chat-tools-react > button, :scope > button") ?? []);
    }

    /** The bar's tab stop, or the first thing to focus in the tray or picker. */
    function stopElement(): HTMLElement | null {
        return toolElements().find(element => element.tabIndex === 0) ?? boxElement.value?.querySelector<HTMLElement>("button, input") ?? null;
    }

    /** What the box's place in the row is placed against: the bubble, or a channel's row; the dock itself draws no box. */
    function hostElement(): HTMLElement | null {
        return guard.value?.parentElement?.parentElement ?? null;
    }

    /**
     * What the box is placed against: the control that grew it while that control is drawn, else
     * its message, the box going by the message's bubble or row where the control has gone, as a
     * chip row another person's change takes away; a channel's bar hangs from its row's edge.
     */
    function anchorBox(): DOMRect | null {
        const at = control.value;
        if (at?.isConnected) {
            return at.getBoundingClientRect();
        }

        return props.isCommunity && !at ? channelEdge() : hostElement()?.getBoundingClientRect() ?? null;
    }

    /** A control under a message stands at the message's start, but under the reader's own bubble at its end. */
    function controlEdge(vertical: "top" | "bottom"): PopoverPlacement {
        return props.isOwn && !props.isCommunity ? `${vertical}-end` : `${vertical}-start`;
    }

    /** The scrolling column the box's message is in, which the box is kept inside. */
    function columnElement(): HTMLElement | null {
        return guard.value?.closest<HTMLElement>("[data-chat-scroller]") ?? null;
    }

    /** A bubble's box stands at the bubble's edge away from the face, over or under it. */
    function edgeOf(vertical: "top" | "bottom"): PopoverPlacement {
        return props.isOwn ? `${vertical}-start` : `${vertical}-end`;
    }

    /**
     * Where a channel's box has its top right corner: lifted over its row's top, in from the row's
     * end; inside the row, under its top, where the lift would cross the column's inset. A line of
     * no height, so the bar, the tray and the picker all hang from it and grow down from it.
     */
    function channelEdge(): DOMRect | null {
        const row = hostElement()?.getBoundingClientRect();
        if (!row) {
            return null;
        }

        const column = columnElement()?.getBoundingClientRect();
        const isNearTop = !!column && row.top - (column.top + boundaryInsetPx) < channelInsideBelowPx;
        const top = isNearTop ? row.top + insideGapPx : row.top - channelLiftPx;
        const right = row.right - channelEndInsetPx;
        return { x: row.left, y: top, left: row.left, top, right, bottom: top, width: right - row.left, height: 0, toJSON: () => ({}) } as DOMRect;
    }

    function placementOf(): PopoverPlacement {
        if (control.value) {
            return controlEdge("top");
        }

        if (props.isCommunity) {
            return "bottom-end";
        }

        if (side.value === "over") {
            return edgeOf("top");
        }

        return props.isOwn ? "left-start" : "right-start";
    }

    /**
     * Where the box goes when its placement has no room. A channel's bar stays at its row's top,
     * and a bar fitted beside its bubble stays there; over the bubble it goes under it where the
     * column's top leaves no room. The tray and the picker, grown from the bar, grow up from where
     * a channel's bar stood, or up beside a bubble's rather than down, else over or under the
     * bubble, as room allows. Grown at a control, under it where there is no room over it.
     */
    function fallbacksOf(): PopoverPlacement[] {
        if (control.value) {
            return [controlEdge("bottom")];
        }

        if (props.isCommunity) {
            return layer.value === "bar" ? [] : ["top-end"];
        }

        if (side.value === "over") {
            return [edgeOf("bottom")];
        }

        if (layer.value === "bar") {
            return [];
        }

        return [props.isOwn ? "left-end" : "right-end", edgeOf("top"), edgeOf("bottom")];
    }

    /** Draws the bar in a form and waits for it to be drawn, so it can be measured. */
    async function drawForm(next: Form): Promise<void> {
        if (form.value !== next) {
            form.value = next;
            await nextTick();
        }
    }

    /** Whether a fitting is still the latest, on the box it began on, read after each wait. */
    function isFitting(run: number, box: HTMLElement): boolean {
        return run === fitting && boxElement.value === box;
    }

    /**
     * Fits the bar to the room around its message, all before the browser paints: a bubble's bar
     * takes the widest form that fits beside the bubble inside its column, measured as drawn; where
     * none fits it stands over the bubble's top in the column's form. A column of 560px or less,
     * the thread drawer or a feed squeezed by a panel, keeps one quick reaction at most. The tray
     * and the picker keep the side their bar stood on.
     */
    async function fit(): Promise<void> {
        const box = boxElement.value;
        const host = hostElement();
        const column = columnElement();
        if (!box || !host || !column) {
            return;
        }

        const run = ++fitting;
        const bounds = column.getBoundingClientRect();
        const widest: Form = bounds.width <= narrowColumnPx ? "one" : "full";

        if (props.isCommunity || layer.value !== "bar") {
            await drawForm(widest);
            if (isFitting(run, box)) {
                await pop.place();
            }
            return;
        }

        side.value = "beside";
        const anchor = host.getBoundingClientRect();
        const room = (props.isOwn ? anchor.left - bounds.left : bounds.right - anchor.right) - boundaryInsetPx - besideGapPx;
        for (const candidate of forms.slice(forms.indexOf(widest))) {
            await drawForm(candidate);
            if (!isFitting(run, box)) {
                return;
            }

            if (box.offsetWidth <= room) {
                await pop.place();
                return;
            }
        }

        await drawForm(widest);
        if (isFitting(run, box)) {
            side.value = "over";
            await pop.place();
        }
    }

    /**
     * Where focus goes as the tray or the picker gives the bar back: the control outside the box
     * that opened it, as a chip's smile-plus; on a phone, the message's row; else the bar's Add
     * reaction, drawn again by then.
     */
    function returnTarget(): HTMLElement | null {
        const opener = held.value?.opener ?? lastOpener;
        if (opener && opener !== guard.value && opener.isConnected && !boxElement.value?.contains(opener)) {
            return opener;
        }

        if (pop.isSheet.value) {
            return guard.value?.closest<HTMLElement>("[data-message-id]") ?? null;
        }

        return toolElements().find(element => element.getAttribute("aria-label") === "More reactions") ?? null;
    }

    /** The opener of the grown box just closed, which the focus given back after the patch still reads. */
    let lastOpener: HTMLElement | null = null;

    /**
     * Reveals a box that changed size from its old edges out, placed once at its new size: a clip
     * rather than a height, so it is never placed again mid-grow. Its edges glide over the block's
     * one move, which reduced motion takes to nothing, so there the new size is simply there.
     */
    function reveal(box: HTMLElement, before: DOMRect): void {
        const after = box.getBoundingClientRect();
        const duration = parseFloat(getComputedStyle(box).getPropertyValue("--chat-d-move"));
        if (typeof box.animate !== "function" || !duration) {
            return;
        }

        const inset = [before.top - after.top, after.right - before.right, after.bottom - before.bottom, before.left - after.left].map(side => `${Math.max(0, side)}px`).join(" ");
        box.animate([{ clipPath: `inset(${inset})` }, { clipPath: "inset(0)" }], { duration, easing: getComputedStyle(box).getPropertyValue("--chat-ease-in").trim() || "ease-out" });
    }

    // #endregion Functions

    // #region Watchers

    // The column moves the one box from message to message, or takes it off one that can no longer
    // be acted on, deleted or opened in the editor: the arrows start again from the first tool,
    // and a menu left open there holds nothing.
    watch(() => props.message?.id, () => {
        activeTool.value = null;
        isMenuOpen.value = false;
    });

    // Fitted each time it shows or moves to another message, since the message may have moved
    // since the last; first fitted as it is mounted, since a column draws it shown in its first dock.
    watch([isDrawn, () => props.message?.id], ([isShown]) => {
        if (isShown) {
            void fit();
        }
    }, { flush: "post" });

    // Grown, the box is on the stack of floating layers; given back, it leaves it. The block's
    // grown box changing to another of this column's messages is a fresh opening.
    watch(held, (box, previous) => {
        if (box && previous && box.key !== previous.key) {
            pop.close();
        }

        if (box) {
            void pop.open();
        }
        else if (previous) {
            lastOpener = previous.opener;
            pop.close();
        }
    });

    // Escape, a press elsewhere or Tab past its end close the grown box; the block hears it.
    watch(pop.isOpen, isOpen => {
        if (!isOpen && held.value) {
            lastOpener = held.value.opener;
            bars?.closeReactionPicker();
        }
    });

    // Each swap is placed at its new size before it paints, and only once that place is drawn
    // revealed from the old edges; measured sooner, a box keeping its far edge, beside the reader's
    // own bubble or a channel row's end, would reveal from the wrong side and jump. The bar given
    // back is fitted to its message again. A box that moved, to the control that grew it or from
    // there back to the bar's place, shares no edges with where it was, so it is simply there.
    watch([layer, control], async ([next, at], [, wasAt]) => {
        const box = boxElement.value;
        const before = box?.getBoundingClientRect();
        await nextTick();
        if (next === "bar") {
            await fit();
        }
        else {
            await pop.place();
        }

        if (box && before && box === boxElement.value && at === wasAt) {
            reveal(box, before);
        }
    });

    /** Lets go of the open menu's mark on its message. */
    let releaseMenuHold: (() => void) | null = null;

    // The menu open marks its message held, as the tray does, so the message's who-reacted card
    // stays shut while the menu is over it; the mark moves or goes with the menu.
    watch([isMenuOpen, () => props.message?.id], ([isOpen, id]) => {
        releaseMenuHold?.();
        releaseMenuHold = isOpen && id !== undefined && guard.value && bars ? bars.holdMessage(id, guard.value) : null;
    });

    // The column keeps the box where it is while something holds it.
    watch(isHeld, isHolding => {
        emit("holdChange", isHolding);
    });

    // The column reads the pointer and focus on the box as on its message.
    watch(boxElement, element => {
        if (column) {
            column.box.value = element;
        }
    });

    // A keyboard on the box's place while the box was hidden there: its column shows the box as
    // focus reaches the message, and focus goes on into the box as soon as it is drawn.
    watch(boxElement, element => {
        if (element && guard.value && document.activeElement === guard.value) {
            stopElement()?.focus({ preventScroll: true });
        }
    }, { flush: "post" });

    // #endregion Watchers

    // #region Lifecycle Hooks

    // The root is found once, from where the box's place is first drawn: in its column, inside the chat.
    onMounted(() => {
        overlayHost.value = overlayHostOf(guard.value);
        if (isDrawn.value) {
            void nextTick(fit);
        }
    });

    // A box taken away while held, its column gone, lets the column go.
    onBeforeUnmount(() => {
        releaseMenuHold?.();
        if (isHeld.value) {
            emit("holdChange", false);
        }
    });

    // #endregion Lifecycle Hooks
</script>
