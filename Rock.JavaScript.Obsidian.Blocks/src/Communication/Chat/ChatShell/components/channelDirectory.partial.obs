}

.chat-fd-hdr-sub {
    overflow: hidden;
    font-size: var(--chat-fs-ui);
    color: var(--chat-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chat-fd-tools {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 780px;
    padding: 16px 24px 4px;
    margin: 0 auto;
}

.chat-fd-search {
    display: flex;
    gap: 10px;
    align-items: center;
    height: 44px;
    padding: 0 8px 0 14px;
    color: var(--chat-muted);
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
    border-radius: var(--chat-r-field);
}

.chat-fd-search input {
    height: 100%;
    font-size: var(--chat-fs-title);
}

.chat-fd-busy {
    display: inline-grid;
    place-items: center;
    width: 22px;
    color: var(--chat-muted);
}

.chat-fd-busy .chat-spinner {
    width: 13px;
    height: 13px;
}

.chat-fd-filters {
    display: flex;
    gap: 10px;
    align-items: center;
    min-width: 0;
}

/* The chips scroll sideways rather than wrap; the padding keeps a focus ring inside the clip. */
.chat-fd-chips {
    display: flex;
    gap: 6px;
    min-width: 0;
    padding: 3px;
    margin: -3px;
    overflow-x: auto;
    scrollbar-width: none;
}

.chat-fd-chips::-webkit-scrollbar {
    display: none;
}

/* The end where the row cuts chips off fades, so a phone shows there is more to scroll to. */
.chat-fd-chips.is-cut-end {
    -webkit-mask-image: linear-gradient(to right, var(--chat-mask-solid) calc(100% - 32px), transparent);
    mask-image: linear-gradient(to right, var(--chat-mask-solid) calc(100% - 32px), transparent);
}

.chat-fd-chips.is-cut-start {
    -webkit-mask-image: linear-gradient(to left, var(--chat-mask-solid) calc(100% - 32px), transparent);
    mask-image: linear-gradient(to left, var(--chat-mask-solid) calc(100% - 32px), transparent);
}

.chat-fd-chips.is-cut-start.is-cut-end {
    -webkit-mask-image: linear-gradient(to right, transparent, var(--chat-mask-solid) 32px, var(--chat-mask-solid) calc(100% - 32px), transparent);
    mask-image: linear-gradient(to right, transparent, var(--chat-mask-solid) 32px, var(--chat-mask-solid) calc(100% - 32px), transparent);
}

.chat-fd-note {
    display: flex;
    flex: 1;
    gap: 8px;
    align-items: center;
    min-width: 0;
    padding: 7px 12px;
    font-size: var(--chat-fs-ui);
    color: var(--chat-text-2);
    background: var(--chat-info-soft);
    border-radius: var(--chat-r-control);
    animation: chat-enter var(--chat-t-base) var(--chat-ease-in);
}

.chat-fd-note-ic {
    color: var(--chat-info-ink);
}

.chat-fd-note b {
    font-weight: 600;
    color: var(--chat-text);
}

/* A hairline under the tools once rows pass beneath them. */
.chat-fd-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    border-top: 1px solid transparent;
    transition: border-color var(--chat-t-fast) var(--chat-ease-state);
    scrollbar-width: thin;
    scrollbar-gutter: stable;
}

.chat-fd-scroll.is-scrolled {
    border-top-color: var(--chat-line);
}

.chat-fd-wrap {
    max-width: 780px;
    padding: 6px 12px 28px;
    margin: 0 auto;
}

.chat-fd-count {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: space-between;
    padding: 4px 12px 8px;
    font-size: var(--chat-fs-ui);
    font-weight: 600;
    color: var(--chat-muted);
}

/* All and Not joined keep their own width at the count's end. */
.chat-fd-show {
    flex: none;
}

.chat-fd-list {
    padding: 0;
    margin: 0;
    list-style: none;
}

.chat-fd-row {
    position: relative;
    display: flex;
    align-items: center;
    border-radius: var(--chat-r-row);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

/* A rule between rows from the text's edge, hidden beside a row under the pointer or focus. */
.chat-fd-row + .chat-fd-row::before {
    position: absolute;
    top: 0;
    right: 14px;
    left: 66px;
    height: 1px;
    content: "";
    background: var(--chat-line);
    transition: opacity var(--chat-t-fast) var(--chat-ease-state);
}

.chat-fd-row:hover,
.chat-fd-row:focus-within {
    background: var(--chat-hover);
}

/* The row previewed, in the wash a chosen list row has everywhere. */
.chat-fd-row.is-current,
.chat-fd-row.is-current:hover {
    background: var(--chat-brand-wash);
}

.chat-fd-row.is-current::before,
.chat-fd-row.is-current + .chat-fd-row::before {
    opacity: 0;
}

.chat-fd-row:hover::before,
.chat-fd-row:hover + .chat-fd-row::before,
.chat-fd-row:focus-within::before,
.chat-fd-row:focus-within + .chat-fd-row::before {
    opacity: 0;
}

.chat-fd-open {
    display: flex;
    flex: 1;
    gap: 14px;
    align-items: flex-start;
    min-width: 0;
    padding: 13px 8px 13px 12px;
    font: inherit;
    color: inherit;
    text-align: left;
    background: none;
    border: 0;
    border-radius: var(--chat-r-row);
}

.chat-fd-open:focus-visible {
    outline-offset: -2px;
}

/* The channel's mark as the sidebar draws it, its photo or its letter tile, in the row's 40px box. */
.chat-fd-ic {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    overflow: hidden;
    border-radius: var(--chat-r-surface);
}

.chat-fd-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding-top: 1px;
}

.chat-fd-name {
    font-size: var(--chat-fs-body);
    font-weight: 650;
    line-height: 1.3;
    color: var(--chat-text);
    overflow-wrap: anywhere;
}

.chat-fd-desc {
    overflow: hidden;
    font-size: var(--chat-fs-ui);
    color: var(--chat-text-2);
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* A phone's narrower gutters, and a tighter row so the name keeps its room beside Join. */
.chat-fd.is-phone .chat-fd-tools {
    padding-right: 12px;
    padding-left: 12px;
}

.chat-fd.is-phone .chat-fd-wrap {
    padding-right: 4px;
    padding-left: 4px;
}

.chat-fd.is-phone .chat-fd-filters {
    flex-wrap: wrap;
}

.chat-fd.is-phone .chat-fd-open {
    gap: 12px;
    padding-left: 10px;
}

/* A phone has the width for one line of a description only if it gives up two. */
.chat-fd.is-phone .chat-fd-desc {
    display: -webkit-box;
    white-space: normal;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.chat-fd-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: var(--chat-fs-small);
    color: var(--chat-muted);
}

.chat-fd-meta > span + span::before {
    display: inline-block;
    width: 3px;
    height: 3px;
    margin: 0 7px;
    vertical-align: middle;
    content: "";
    background: currentColor;
    border-radius: var(--chat-r-full);
    opacity: .55;
}

/* A room the person is in: its check at the row's end, popping in once, in the church color, as a join lands. */
.chat-fd-joined {
    display: inline-flex;
    flex: none;
    align-self: center;
    color: var(--chat-brand-ink);
}

.chat-fd-joined.is-fresh {
    animation: chat-spring var(--chat-d-spring) var(--chat-ease-spring);
}

/* The same box as a real row (13px padding, 40px icon, name, description and meta lines), so nothing jumps on load. */
.chat-fd-sk {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    min-height: 86px;
    padding: 13px 12px;
}

.chat-fd-sk > span {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 9px;
    padding-top: 4px;
}

.chat-fd-sk i {
    display: block;
    height: 11px;
    border-radius: var(--chat-r-inset);
}

.chat-fd-sk i.is-meta {
    height: 9px;
}

.chat-fd-sk i.is-icon {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: var(--chat-r-surface);
}
</style>

<script setup lang="ts">
    import { computed, onBeforeUnmount, onMounted, PropType, ref, watch } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { ChatCampusBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatCampusBag";
    import { useAnnouncer } from "../ui/announcer.partial";
    import Button from "../ui/button.partial.obs";
    import ChannelMark from "../ui/channelMark.partial.obs";
    import EmptyState from "../ui/emptyState.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import MatchText from "../ui/matchText.partial.obs";
    import Pill from "../ui/pill.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import LoadMoreRow from "../ui/loadMoreRow.partial.obs";
    import Segmented, { SegmentedOption } from "../ui/segmented.partial.obs";
    import JoinBar from "./joinBar.partial.obs";
    import { messageOrOffline } from "../errors.partial";
    import { useListKeys } from "../composables/useListKeys.partial";
    import { useChatSession } from "../chatSession.partial";
    import { DirectoryCampus, DirectoryShow, DirectoryState, JoinState, LeaveState } from "../composables/useRooms.partial";

    // #region Types

    /** One campus chip: what it asks for and what it says. */
    type Chip = {
        key: string;
        label: string;
        campus: DirectoryCampus;
    };

    /** A channel as Browse lists it, worked out once per answer. */
    type ListedChannel = {
        id: string;
        name: string;
        description: string | null;

        /** The channel's own photo, or null for its letter tile. */
        iconUrl: string | null;
        meta: string[];
        isMember: boolean;
        join: JoinState;
        label: string;
    };

    /** What an empty answer says, and its one way out. */
    type EmptyAnswer = {
        title: string;
        text: string;
        button: string;
        act: () => void;
    };

    // #endregion Types

    const props = defineProps({
        /** Browse channels as the rooms hold it. */
        directory: {
            type: Object as PropType<DirectoryState>,
            required: true
        },

        /** Each room's Join by its id; a room not here is idle. */
        joins: {
            type: Object as PropType<Record<string, JoinState>>,
            default: () => ({})
        },

        /** Each room's Leave by its id, for the preview's footer; a room not here is idle. */
        leaves: {
            type: Object as PropType<Record<string, LeaveState>>,
            default: () => ({})
        },

        /** The room whose preview is shown, as the frame holds it; null for none. */
        previewId: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The church's campuses, for the chips and for naming each room's campus. */
        campuses: {
            type: Array as PropType<ChatCampusBag[]>,
            default: () => []
        },

        /** The person's own campus, which the church's campus note names. */
        personCampusGuid: {
            type: String as PropType<string | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        (e: "back"): void,
        (e: "close"): void,
        (e: "query", query: string): void,
        (e: "clearQuery"): void,
        (e: "campus", campus: DirectoryCampus): void,
        (e: "show", show: DirectoryShow): void,
        (e: "clearFilters"): void,
        (e: "loadMore"): void,
        (e: "retry"): void,
        (e: "join", channelId: string): void,
        (e: "open", channelId: string): void,
        (e: "leave", channelId: string): void,
        (e: "preview", channelId: string | null): void
    }>();

    // #region Values

    const titleId = `chat-fd-title-${newGuid()}`;
    const resultsId = `chat-fd-results-${newGuid()}`;

    const viewElement = ref<HTMLElement>();
    const searchInput = ref<HTMLInputElement>();
    const scrollElement = ref<HTMLElement>();
    const chipsElement = ref<HTMLElement>();

    /**
     * The view's width at which the preview fits beside the list: the list's 400px column and a
     * preview wide enough for a feed's rows. Narrower, the preview lies over the list.
     */
    const splitWidth = 1000;

    /** Whether the view is wide enough for the preview beside the list, as last laid out. */
    const isSplit = ref(false);

    /** Whether the campus chips run past the row's start or end, which fades that edge. */
    const isChipsCutStart = ref(false);
    const isChipsCutEnd = ref(false);

    /** Whether rows have passed under the tools, which draws the hairline. */
    const isScrolled = ref(false);

    /** The skeleton rows' widths, as the design draws them, so five rows do not look stamped out. */
    const skeletonWidths = [62, 48, 70, 54, 40];

    const idle: JoinState = { kind: "idle" };
    const idleLeave: LeaveState = { kind: "idle" };

    const announcer = useAnnouncer();

    /** Drawn at a phone's width: Back in Close's place, and narrower gutters; the church names the list. */
    const { isPhone, church } = useChatSession();

    // The list is one tab stop, Up and Down between its rows; Enter on a row shows its preview.
    const listKeys = useListKeys(() => drawnRows.value.map(row => row.id), { onPick: choose });

    // #endregion Values

    // #region Computed Values

    const ownCampusName = computed((): string => campusNameOf(props.personCampusGuid) ?? "your campus");

    const chips = computed((): Chip[] => [
        { key: "all", label: "All campuses", campus: { kind: "all" } },
        ...props.campuses.map(campus => ({ key: campus.guid, label: campus.name ?? "", campus: { kind: "campus", campusId: campus.guid } as DirectoryCampus })),
        { key: "whole-church", label: "Whole church", campus: { kind: "wholeChurch" } }
    ]);

    const countText = computed((): string => {
        const total = props.directory.total;
        const count = total.toLocaleString();
        if (props.directory.query.trim()) {
            return `${count} ${total === 1 ? "channel matches" : "channels match"}`;
        }

        return `${count} ${total === 1 ? "channel" : "channels"}`;
    });

    const drawnRows = computed((): ListedChannel[] => {
        return props.directory.rows.map(row => {
            const name = row.name ?? "";
            const join = props.joins[row.channel_id] ?? idle;
            // A join the door and the platform agree on shows as one before the row's own flag
            // turns, and a leave the door made before the row is read again.
            const isMember = join.kind === "joined" || (row.is_member && props.leaves[row.channel_id]?.kind !== "left");
            // Its campus and how many are in it: Rock's group type names nothing a person picks a
            // channel by. A platform from before the count sends none, and the campus stands alone.
            const meta = [campusNameOf(row.campus_id) ?? "Whole church"];
            if (row.member_count !== undefined) {
                meta.push(`${row.member_count.toLocaleString()} ${row.member_count === 1 ? "member" : "members"}`);
            }

            return {
                id: row.channel_id,
                name,
                description: row.description?.trim() || null,
                iconUrl: row.icon_url,
                meta,
                isMember,
                join,
                label: `${name}${isMember ? ", joined" : ""}, ${meta.join(", ")}. Preview channel`
            };
        });
    });

    /** The row previewed, while the list holds it. */
    const previewRow = computed((): ListedChannel | null => drawnRows.value.find(row => row.id === props.previewId) ?? null);

    /** Whether the preview lies over the list, which is then out of reach. */
    const isCovered = computed((): boolean => !!previewRow.value && !isSplit.value);

    /** All, or only the rooms the person is not in. */
    const showOptions: SegmentedOption[] = [
        { value: "all", label: "All" },
        { value: "notJoined", label: "Not joined" }
    ];

    /** Why the first page did not come, in words. */
    const loadFailure = computed((): string => props.directory.error ? messageOrOffline(props.directory.error, "Couldn't load channels. Check your connection and try again.") : "");

    /** Why the next page did not come, in words. */
    const moreFailure = computed((): string => props.directory.moreError ? messageOrOffline(props.directory.moreError, "Couldn't load more channels. Check your connection and try again.") : "");

    /** The empty state the answer draws, past the one with nothing public at all. */
    const empty = computed((): EmptyAnswer | null => {
        const query = props.directory.query.trim();
        const campus = props.directory.campus;

        switch (props.directory.emptyKind) {
            case "query":
                return {
                    title: `No channels match “${query}”`,
                    text: "Search looks at channel names. Private groups don't show here; a leader can add you.",
                    button: "Clear search",
                    act: onClearSearch
                };

            case "filters": {
                const looking = [
                    campus.kind === "wholeChurch" ? "the whole church" : campus.kind === "campus" ? campusNameOf(campus.campusId) ?? "" : "",
                    props.directory.show === "notJoined" ? "channels you haven't joined" : ""
                ].filter(part => part !== "");

                return {
                    title: `No channels match “${query}”`,
                    text: `You're only looking at ${looking.join(", and ")}. Clear the filters to search every public channel.`,
                    button: "Clear filters",
                    act: () => emit("clearFilters")
                };
            }

            case "allJoined":
                return {
                    title: "You're in every channel here",
                    text: `Nothing left to join${campus.kind !== "all" ? " for this campus" : ""}.`,
                    button: "Show all",
                    act: () => emit("show", "all")
                };

            case "campus":
                return {
                    title: "No channels for this campus yet",
                    text: "Try another campus, or the whole church.",
                    button: "All campuses",
                    act: () => emit("campus", { kind: "all" })
                };

            default:
                return null;
        }
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onInput(event: Event): void {
        emit("query", (event.target as HTMLInputElement).value);
    }

    /** Clears the search, keeping focus in the field so typing carries on. */
    function onClearSearch(): void {
        emit("clearQuery");
        searchInput.value?.focus();
    }

    /** Join, unless the door is already out: held by aria-disabled, so the press arrives and is dropped here. */
    function onJoin(channelId: string, join: JoinState): void {
        if (join.kind !== "joining" && join.kind !== "refused") {
            emit("join", channelId);
        }
    }

    /** Shows a row's preview, unless it is the one shown. */
    function choose(channelId: string): void {
        if (channelId !== props.previewId) {
            emit("preview", channelId);
        }
    }

    /** Beside the list, the preview follows the row the keys move to; over it, only a press opens it. */
    function onRowFocus(channelId: string): void {
        if (isSplit.value) {
            choose(channelId);
        }
    }

    /** The next page; the rooms say through the directory when it is out, in or failed. */
    function onLoadMore(): void {
        emit("loadMore");
    }

    /** Reads whether the preview fits beside the list, as the view is laid out and resized. */
    function measureView(): void {
        isSplit.value = !isPhone.value && (viewElement.value?.clientWidth ?? 0) >= splitWidth;
    }

    /** Reads where the chip row cuts its chips off, as it scrolls or changes width. */
    function measureChips(): void {
        const row = chipsElement.value;
        isChipsCutStart.value = !!row && row.scrollLeft > 1;
        isChipsCutEnd.value = !!row && row.scrollLeft + row.clientWidth < row.scrollWidth - 1;
    }

    function onScroll(): void {
        const scroller = scrollElement.value;
        if (!scroller) {
            return;
        }

        isScrolled.value = scroller.scrollTop > 2;
    }

    /**
     * Down from the search to the first row, and Up from the first row back to the search; the
     * list's own keys move between rows. Escape closes a preview lying over the list, else clears
     * a search that holds words, else closes the view; it stops here so nothing behind the view
     * closes with it.
     */
    function onKeydown(event: KeyboardEvent): void {
        const target = event.target as HTMLElement;
        const rows = Array.from(viewElement.value?.querySelectorAll<HTMLElement>(".chat-fd-open") ?? []);

        if (event.key === "Escape") {
            event.stopPropagation();
            if (isCovered.value) {
                emit("preview", null);
                return;
            }

            if (target === searchInput.value && props.directory.query) {
                emit("clearQuery");
                return;
            }

            emit("close");
            return;
        }

        if (target === searchInput.value && event.key === "ArrowDown" && rows.length > 0) {
            event.preventDefault();
            rows[0].focus();
        }
        else if (target === rows[0] && event.key === "ArrowUp") {
            event.preventDefault();
            searchInput.value?.focus();
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /** A campus by name, from the church's list, or null for none or one it no longer lists. */
    function campusNameOf(campusId: string | null | undefined): string | null {
        const id = campusId?.toLowerCase();
        return id ? props.campuses.find(campus => campus.guid.toLowerCase() === id)?.name ?? null : null;
    }

    function isChipPressed(campus: DirectoryCampus): boolean {
        const chosen = props.directory.campus;
        return chosen.kind === campus.kind && (chosen.kind !== "campus" || (campus.kind === "campus" && chosen.campusId === campus.campusId));
    }

    // #endregion Functions

    // #region Watchers

    // A page that did not come is said as it is drawn, since the reader's place is elsewhere.
    watch([loadFailure, moreFailure], ([load, more], [loadBefore, moreBefore]) => {
        const words = load && load !== loadBefore ? load : more && more !== moreBefore ? more : "";
        if (words) {
            announcer.announce(words);
        }
    });

    // Beside the list there is always a preview: the first row's while none is chosen, or once a
    // search or a filter leaves the chosen one out of the list.
    watch([isSplit, () => drawnRows.value.map(row => row.id)], ([split, ids]) => {
        if (split && ids.length > 0 && !ids.includes(props.previewId ?? "")) {
            emit("preview", ids[0]);
        }
    });

    // The chip row's cut is read as the row is drawn and each time its width changes, since a
    // narrower window cuts chips that fit before; a browser's observer reads it once on start.
    const chipsObserver = typeof ResizeObserver !== "undefined" ? new ResizeObserver(measureChips) : null;

    // The view's width is read the same way, once on start and as the window or the panels change it.
    const viewObserver = typeof ResizeObserver !== "undefined" ? new ResizeObserver(measureView) : null;

    watch(chipsElement, (element, before) => {
        if (before) {
            chipsObserver?.unobserve(before);
        }
        if (element) {
            chipsObserver?.observe(element);
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(() => {
        if (viewElement.value) {
            viewObserver?.observe(viewElement.value);
        }
    });

    onBeforeUnmount(() => {
        chipsObserver?.disconnect();
        viewObserver?.disconnect();
    });

    // #endregion Lifecycle Hooks
</script>
