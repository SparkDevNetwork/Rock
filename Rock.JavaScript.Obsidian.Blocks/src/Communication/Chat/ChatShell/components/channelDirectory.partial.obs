<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div ref="viewElement"
         class="chat-fd"
         :class="{ 'is-phone': isPhone, 'is-split': isSplit }"
         role="region"
         :aria-labelledby="titleId"
         data-testid="channel-directory"
         @keydown="onKeydown">
        <!-- The list and its head, out of reach while a preview lies over them in a narrow view. -->
        <div class="chat-fd-under" data-testid="directory-list-pane" :inert="isCovered || undefined">
            <header class="chat-fd-hdr">
                <IconButton v-if="isPhone"
                            class="chat-fd-back"
                            icon="left"
                            label="Back to conversations"
                            data-testid="directory-back"
                            @click="emit('back')" />
                <span class="chat-fd-hdr-ic" aria-hidden="true"><Icon name="hash" /></span>
                <div class="chat-fd-hdr-title">
                    <b :id="titleId" data-testid="directory-title">Browse channels</b>
                    <span class="chat-fd-hdr-sub" data-testid="directory-subtitle">Public channels at {{ church.name }}</span>
                </div>
                <IconButton v-if="!isPhone"
                            icon="x"
                            label="Close Browse channels"
                            tooltip="Close"
                            data-testid="directory-close"
                            @click="emit('close')" />
            </header>

            <div class="chat-fd-col">
                <div class="chat-fd-tools">
                    <div class="chat-fd-search chat-field">
                        <Icon name="search" size="sm" />
                        <input ref="searchInput"
                               class="chat-field-input"
                               type="search"
                               placeholder="Search channels by name"
                               aria-label="Search channels"
                               autocomplete="off"
                               spellcheck="false"
                               :aria-controls="resultsId"
                               :value="directory.query"
                               data-autofocus
                               data-testid="directory-search"
                               @input="onInput" />
                        <!-- Only words typed wait in the field; a filter asked again with none waits in the rows it keeps drawn. -->
                        <span v-if="directory.isSearching && directory.query.trim() !== ''" class="chat-fd-busy" data-testid="directory-search-busy"><span class="chat-spinner"></span></span>
                        <IconButton v-if="directory.query"
                                    icon="x"
                                    size="sm"
                                    label="Clear search"
                                    data-testid="directory-search-clear"
                                    @click="onClearSearch" />
                    </div>

                    <div class="chat-fd-filters">
                        <div v-if="directory.isCampusLimited" class="chat-fd-note" data-testid="directory-campus-note">
                            <Icon class="chat-fd-note-ic" name="info" size="sm" />
                            <span>Showing channels for <b>{{ ownCampusName }}</b> and the whole church.</span>
                        </div>
                        <div v-else-if="campuses.length > 0"
                             ref="chipsElement"
                             class="chat-fd-chips"
                             :class="{ 'is-cut-start': isChipsCutStart, 'is-cut-end': isChipsCutEnd }"
                             role="group"
                             aria-label="Campus"
                             data-testid="directory-chips"
                             @scroll="measureChips">
                            <Pill v-for="chip in chips"
                                  :key="chip.key"
                                  data-testid="directory-chip"
                                  :data-campus="chip.key"
                                  :selected="isChipPressed(chip.campus)"
                                  @click="emit('campus', chip.campus)">
                                {{ chip.label }}
                            </Pill>
                        </div>
                    </div>
                </div>

                <div ref="scrollElement"
                     class="chat-fd-scroll"
                     :class="{ 'is-scrolled': isScrolled }"
                     data-chat-scroller
                     data-testid="directory-scroll"
                     @scroll="onScroll">
                    <div :id="resultsId" class="chat-fd-wrap" data-testid="directory-results" :aria-busy="directory.isLoading ? 'true' : 'false'">
                        <template v-if="directory.isLoading">
                            <div class="chat-fd-count"><span data-testid="directory-count">Loading channels…</span></div>
                            <ul class="chat-fd-list" aria-hidden="true">
                                <li v-for="(width, index) in skeletonWidths" :key="index" class="chat-fd-sk" data-testid="directory-skeleton-row">
                                    <i class="chat-skeleton is-icon"></i>
                                    <span>
                                        <i class="chat-skeleton" :style="{ width: `${width * .45}%` }"></i>
                                        <i class="chat-skeleton" :style="{ width: `${width}%` }"></i>
                                        <i class="chat-skeleton is-meta" :style="{ width: `${width * .6}%` }"></i>
                                    </span>
                                </li>
                            </ul>
                        </template>

                        <EmptyState v-else-if="directory.error"
                                    tone="error"
                                    :title="loadFailure"
                                    actionLabel="Try again"
                                    :actionAttrs="{ 'data-testid': 'directory-retry' }"
                                    data-testid="directory-error"
                                    @action="emit('retry')" />

                        <EmptyState v-else-if="directory.emptyKind === 'none'"
                                    title="No channels to browse yet"
                                    :text="`When ${church.name || 'your church'} opens channels to everyone, they'll show up here.`"
                                    data-testid="directory-empty"
                                    data-kind="none" />

                        <template v-else>
                            <div class="chat-fd-count">
                                <span data-testid="directory-count">{{ countText }}</span>
                                <Segmented class="chat-fd-show"
                                           :options="showOptions"
                                           :modelValue="directory.show"
                                           aria-label="Show"
                                           optionTestId="directory-show-option"
                                           data-testid="directory-show"
                                           @update:modelValue="emit('show', $event as DirectoryShow)" />
                            </div>

                            <EmptyState v-if="empty"
                                        :title="empty.title"
                                        :text="empty.text"
                                        :actionLabel="empty.button"
                                        :actionAttrs="{ 'data-testid': 'directory-empty-action' }"
                                        data-testid="directory-empty"
                                        :data-kind="directory.emptyKind"
                                        @action="empty.act" />

                            <!-- One tab stop for the list; a row shows its preview, which in a wide view follows the arrows. -->
                            <ul v-else class="chat-fd-list" aria-label="Channels" data-testid="directory-list">
                                <li v-for="row in drawnRows"
                                    :key="row.id"
                                    class="chat-fd-row"
                                    :class="{ 'is-member': row.isMember, 'is-current': row.id === previewRow?.id }"
                                    data-testid="directory-row"
                                    :data-channel-id="row.id"
                                    :data-member="row.isMember ? 'true' : 'false'">
                                    <button :ref="listKeys.itemRef(row.id)"
                                            type="button"
                                            class="chat-fd-open"
                                            data-testid="directory-row-open"
                                            :aria-label="row.label"
                                            :aria-current="row.id === previewRow?.id ? 'true' : undefined"
                                            v-bind="listKeys.itemAttrs(row.id)"
                                            @focus="onRowFocus(row.id)"
                                            @click="choose(row.id)">
                                        <ChannelMark class="chat-fd-ic" isPublic :imageUrl="row.iconUrl" :tileName="row.name" />
                                        <span class="chat-fd-main">
                                            <span class="chat-fd-name" data-testid="directory-row-name"><MatchText :text="row.name" :query="directory.query" /></span>
                                            <span v-if="row.description" class="chat-fd-desc" data-testid="directory-row-desc">{{ row.description }}</span>
                                            <span class="chat-fd-meta" data-testid="directory-row-meta">
                                                <span v-for="part in row.meta" :key="part">{{ part }}</span>
                                            </span>
                                        </span>
                                        <span v-if="row.isMember"
                                              class="chat-fd-joined"
                                              :class="{ 'is-fresh': row.join.kind === 'joined' && row.join.isFresh }"
                                              title="Joined"
                                              data-testid="directory-row-joined"><Icon name="check" size="sm" /></span>
                                    </button>
                                </li>
                            </ul>

                            <LoadMoreRow v-if="!empty && directory.hasMore"
                                         name="directory"
                                         label="Load more channels"
                                         :load="onLoadMore"
                                         :isLoading="directory.isLoadingMore"
                                         :isFailed="!!directory.moreError"
                                         :failure="moreFailure" />
                        </template>
                    </div>
                </div>
            </div>
        </div>

        <!--
            The chosen channel, beside the list in a wide view and over it otherwise: its summary
            pinned at the top, its own feed, read only, filling the rest and the only part that
            scrolls, then the join bar as its footer.
        -->
        <section v-if="previewRow"
                 class="chat-fd-preview"
                 :class="{ 'is-over': !isSplit }"
                 :aria-label="`Preview of ${previewRow.name}`"
                 data-testid="directory-preview"
                 :data-channel-id="previewRow.id">
            <header v-if="!isSplit" class="chat-fd-hdr" data-testid="directory-preview-head">
                <IconButton class="chat-fd-back"
                            icon="left"
                            label="Back to Browse channels"
                            data-testid="directory-preview-back"
                            @click="emit('preview', null)" />
                <div class="chat-fd-hdr-title">
                    <b>{{ previewRow.name }}</b>
                    <span class="chat-fd-hdr-sub">{{ previewRow.meta.join(" · ") }}</span>
                </div>
            </header>

            <div class="chat-fd-pv-top" data-testid="directory-preview-summary">
                <div class="chat-fd-pv-head">
                    <ChannelMark class="chat-fd-pv-ic" isPublic :imageUrl="previewRow.iconUrl" :tileName="previewRow.name" />
                    <span class="chat-fd-pv-title">
                        <b data-testid="directory-preview-name">{{ previewRow.name }}</b>
                        <span class="chat-fd-meta" data-testid="directory-preview-meta">
                            <span v-for="part in previewRow.meta" :key="part">{{ part }}</span>
                        </span>
                    </span>
                </div>
                <p v-if="previewRow.description" class="chat-fd-pv-desc" data-testid="directory-preview-desc">{{ previewRow.description }}</p>
            </div>

            <div class="chat-fd-pv-feed" data-testid="directory-preview-feed">
                <slot name="feed" :channelId="previewRow.id"></slot>
            </div>

            <JoinBar place="preview"
                     :name="previewRow.name"
                     :state="previewRow.join"
                     :isMember="previewRow.isMember"
                     :leave="leaves[previewRow.id] ?? idleLeave"
                     @join="onJoin(previewRow!.id, previewRow!.join)"
                     @open="emit('open', previewRow!.id)"
                     @leave="emit('leave', previewRow!.id)" />
        </section>
    </div>
</template>

<style scoped>
/*
    Browse channels, in the conversation's place: its header, then the list (the tools and the rooms
    scrolling under them). A wide view sets the chosen channel's preview beside the list, under the
    header; a narrow one lays the preview over the whole view.
*/
.chat-fd {
    position: relative;
    display: grid;
    flex: 1;
    grid-template-rows: auto minmax(0, 1fr);
    grid-template-columns: minmax(0, 1fr);
    min-height: 0;
    background: var(--chat-surface);
}

.chat-fd.is-split {
    grid-template-columns: 400px minmax(0, 1fr);
}

/* The header and the list are the grid's own cells; this only holds them out of reach together. */
.chat-fd-under {
    display: contents;
}

.chat-fd-under > .chat-fd-hdr {
    grid-column: 1 / -1;
}

.chat-fd-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.chat-fd.is-split .chat-fd-col {
    border-right: 1px solid var(--chat-line);
}

.chat-fd.is-split .chat-fd-tools {
    padding: 14px 16px 4px;
}

.chat-fd.is-split .chat-fd-wrap {
    padding: 6px 8px 16px;
}

.chat-fd.is-split .chat-fd-open {
    gap: 12px;
    padding: 10px;
}

/* The preview: its summary, its feed, which alone scrolls, and its footer. */
.chat-fd-preview {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--chat-surface);
}

/* Over the list, its own screen: the whole view, rising in as a view does. */
.chat-fd-preview.is-over {
    position: absolute;
    inset: 0;
    z-index: 1;
    animation: chat-enter var(--chat-t-base) var(--chat-ease-in);
}

.chat-fd-pv-top {
    flex: none;
    padding: 24px 28px 18px;
    border-bottom: 1px solid var(--chat-line);
}

.chat-fd.is-phone .chat-fd-pv-top {
    padding: 16px 16px 14px;
}

.chat-fd-pv-head {
    display: flex;
    gap: 14px;
    align-items: center;
    min-width: 0;
}

/* The channel's mark as its row draws it, at the summary's size. */
.chat-fd-pv-ic {
    display: grid;
    flex: none;
    place-items: center;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: var(--chat-r-surface);
}

.chat-fd-pv-title {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.chat-fd-pv-title b {
    font-size: var(--chat-fs-title);
    font-weight: 700;
    line-height: 1.3;
    color: var(--chat-text);
    overflow-wrap: anywhere;
}

.chat-fd-pv-desc {
    max-width: 60ch;
    margin: 12px 0 0;
    font-size: var(--chat-fs-body);
    line-height: 1.45;
    color: var(--chat-text-2);
}

.chat-fd-pv-feed {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
}

/* The conversation header's own frame, so the rules align across the columns. */
.chat-fd-hdr {
    display: flex;
    flex: none;
    gap: 12px;
    align-items: center;
    height: 64px;
    padding: 0 12px 0 20px;
    background: var(--chat-surface);
    border-bottom: 1px solid var(--chat-line);
}

.chat-fd.is-phone .chat-fd-hdr {
    padding-left: 12px;
}

/* Back's hover disc stands out past the header's gutter, so its glyph lines up with the title's edge. */
.chat-fd-hdr .chat-fd-back {
    margin-left: -8px;
}

.chat-fd-hdr-ic {
    --chat-ic-size: 19px;
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-surface);
}

.chat-fd-hdr-title {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
}

.chat-fd-hdr-title b {
