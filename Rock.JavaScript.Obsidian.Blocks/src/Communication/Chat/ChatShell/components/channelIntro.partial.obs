<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <section class="chat-intro" :class="{ 'is-phone': isPhone }" data-testid="channel-intro" :aria-labelledby="titleId">
        <span class="chat-intro-mark" data-testid="intro-mark" aria-hidden="true">
            <Icon :name="facts.is_public ? 'hash' : 'lock'" />
        </span>

        <h2 :id="titleId" data-testid="intro-title">{{ name }}</h2>

        <div class="chat-intro-meta" data-testid="intro-meta">
            <span>{{ facts.is_public ? "Public" : "Private" }}</span>
            <span data-testid="intro-members">{{ memberText }}</span>
            <span v-if="campusName">{{ campusName }}</span>
        </div>

        <!-- Cut at two lines by its style only, so a screen reader reads it whole; details shows it all. -->
        <p v-if="description" class="chat-intro-desc" data-testid="intro-description">{{ description }}</p>

        <p v-if="note" class="chat-intro-line" data-testid="intro-note">{{ note }}</p>

        <p v-if="isEmpty" class="chat-intro-line" data-testid="intro-foot">
            {{ canPostOnceIn && !isJoinRefused ? "No messages yet. Be the first to say hello." : "Nothing has been posted yet." }}
        </p>
    </section>
</template>

<style scoped>
/* A quiet start of the channel, centered over the feed; the header carries its actions and leaders. */
.chat-intro {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    padding: 26px 32px 16px;
    text-align: center;
}

.chat-intro.is-phone {
    padding: 22px 16px 14px;
}

.chat-intro-mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-intro);
}

.chat-intro-mark :deep(.chat-ic) {
    width: 20px;
    height: 20px;
}

/* Rock's theme styles every heading, so this one states its whole face. */
.chat-intro h2 {
    max-width: 100%;
    margin: 4px 0 0;
    font-family: inherit;
    font-size: 15.5px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--chat-text);
    text-wrap: balance;
    overflow-wrap: anywhere;
}

.chat-intro-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    font-size: 12.5px;
    color: var(--chat-muted);
}

.chat-intro-meta > span {
    display: inline-flex;
    align-items: center;
}

/* The facts joined by 3px dots. */
.chat-intro-meta > span + span::before {
    width: 3px;
    height: 3px;
    margin: 0 7px;
    content: "";
    background: currentColor;
    border-radius: 50%;
    opacity: .55;
}

/* Two lines at most; the header's subtitle and the details dialog carry the rest. */
.chat-intro-desc {
    display: -webkit-box;
    max-width: 52ch;
    margin: 0;
    overflow: hidden;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--chat-muted);
    overflow-wrap: anywhere;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
}

/* Why the person cannot post, or an empty room's word: one muted line each. */
.chat-intro-line {
    max-width: 52ch;
    margin: 0;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--chat-muted);
}
</style>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { ChatCampusBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatCampusBag";
    import Icon from "../ui/icon.partial.obs";
    import { ChannelFacts } from "../types.partial";

    const props = defineProps({
        /** What chat_get_channel answered about the room. */
        facts: {
            type: Object as PropType<ChannelFacts>,
            required: true
        },

        /** The church's campuses, which name the room's campus. */
        campuses: {
            type: Array as PropType<ChatCampusBag[]>,
            default: () => []
        },

        /** The person's notify mode for the room, which the posting note says how they hear of posts by. */
        notifyMode: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether the room has no messages at all, which draws the foot. */
        isEmpty: {
            type: Boolean,
            default: false
        },

        /** Whether the door refused the person's join, so they cannot post here even once in. */
        isJoinRefused: {
            type: Boolean,
            default: false
        },

        isPhone: {
            type: Boolean,
            default: false
        }
    });

    // #region Values

    /** Names the section by its heading, once per intro. */
    const titleId = `chat-intro-${newGuid()}`;

    /** What each notify mode means for a room the person reads but does not post in. */
    const notifySentences: Record<string, string> = {
        all: "You're notified of every post.",
        mentions: "You're notified only when you're mentioned.",
        silent: "Notifications are off for this channel."
    };

    /** The one reason to be unable to post that the join bar already says, so the note leaves it out. */
    const joinRequiredCode = "authz.join_required";

    // #endregion Values

    // #region Computed Values

    /** The room's name as Rock writes it, with no "#". */
    const name = computed((): string => props.facts.name?.trim() || "this channel");

    const campusName = computed((): string | null => {
        const campusId = props.facts.campus_id?.toLowerCase();
        return campusId ? props.campuses.find(campus => campus.guid.toLowerCase() === campusId)?.name ?? null : null;
    });

    const memberText = computed((): string => {
        const count = props.facts.member_count;
        return `${count.toLocaleString()} ${count === 1 ? "member" : "members"}`;
    });

    /** The room's description as a sentence, or nothing: the quiet line already says Public or Private. */
    const description = computed((): string | null => {
        const text = props.facts.description?.trim() ?? "";
        if (!text) {
            return null;
        }

        return /[.!?]$/.test(text) ? text : `${text}.`;
    });

    /**
     * Whether the person may post, or would once in: a person previewing the room need only join,
     * so the empty foot still asks them to say hello and no note says why they cannot.
     */
    const canPostOnceIn = computed((): boolean => props.facts.can_post || props.facts.can_post_code === joinRequiredCode);

    /**
     * Why the person cannot post, in the server's words, then how they hear of what is posted.
     * Not for a person who need only join, which the join bar in the composer's place says.
     */
    const note = computed((): string | null => {
        if (canPostOnceIn.value) {
            return null;
        }

        const text = [props.facts.can_post_reason?.trim() ?? "", notifySentences[props.notifyMode ?? ""] ?? ""].filter(part => part !== "").join(" ");
        return text || null;
    });

    // #endregion Computed Values
</script>
