<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div v-if="isRowDrawn()"
         class="chat-reacts"
         :class="{ 'is-community': isCommunity }"
         data-testid="message-reactions">
        <!--
            The row under a message: the thread pill first, then the chips, then the add chip.
            Kept inside the row, since a comment beside it would make a fragment root and the
            message row's placement rules reach a child only through its single root element.
        -->
        <slot />
        <template v-if="isChipsDrawn">
            <button v-for="(reaction, index) in reactions"
                    :key="reaction.code"
                    type="button"
                    class="chat-rx"
                    :class="{ 'is-popping': popping.has(reaction.code) }"
                    data-testid="reaction-chip"
                    :data-code="reaction.code"
                    :aria-pressed="reaction.mine ? 'true' : 'false'"
                    :aria-label="chipLabel(reaction)"
                    :aria-describedby="`${uid}-who-${index}`"
                    :aria-expanded="isCardOn(reaction.code) ? 'true' : 'false'"
                    :aria-controls="isCardOn(reaction.code) ? `${uid}-card` : undefined"
                    :aria-disabled="isPreviewing ? 'true' : undefined"
                    @pointerenter="onChipEnter($event, reaction)"
                    @pointerleave="onPointerLeave"
                    @pointerdown="onChipPointerDown($event, reaction.code)"
                    @pointermove="onChipPointerMove"
                    @pointerup="cancelLongPress"
                    @pointercancel="cancelLongPress"
                    @contextmenu="onChipContextMenu"
                    @focus="onChipFocus($event, reaction)"
                    @blur="onBlur"
                    @keydown="onAnchorKeydown"
                    @click="onChipClick(reaction.code)"
                    @animationend.self="onPopEnd(reaction.code)">
                <img v-if="reaction.image_url" class="chat-rx-e is-image" :src="reaction.image_url" alt="" />
                <span v-else class="chat-rx-e" aria-hidden="true">{{ reaction.emoji }}</span>
                <!-- Keyed by the count, so each change remounts it and the roll plays again. -->
                <span :key="reaction.count"
                      class="chat-rx-n"
                      :class="{ 'is-rolling': rolling.has(reaction.code) }"
                      data-testid="reaction-count"
                      aria-hidden="true"
                      @animationend="onRollEnd(reaction.code)">{{ reaction.count }}</span>
            </button>
            <!-- Who reacted with each chip in one sentence, the chip's description to a screen reader. -->
            <span v-for="(reaction, index) in reactions"
                  :id="`${uid}-who-${index}`"
                  :key="`who-${reaction.code}`"
                  class="chat-sr-only">{{ whoReactedLine(reaction, reader) }}</span>
            <button v-if="isAddDrawn"
                    ref="addElement"
                    type="button"
                    class="chat-rx is-add"
                    data-testid="reaction-add"
                    aria-label="Add reaction"
                    aria-haspopup="dialog"
                    @click="onAddClick">
                <Icon name="smile-plus" size="sm" />
            </button>
            <!--
                Out of the chips, since a chip lifted on hover is a transformed box and would hold a
                fixed card to its own width; drawn in the chat's root, where the feed's faded edges
                cannot fade or cut it, and in the row where there is no root. The full list's dialog
                covers that root, which is the chat's frame.
            -->
            <Teleport :to="tipHost ?? 'body'" :disabled="!tipHost">
                <div v-if="isTipShown && tipReaction"
                     :id="`${uid}-card`"
                     ref="tipElement"
                     class="chat-rx-card-place"
                     :style="floatingStyles"
                     @pointerenter="onTipPointerEnter"
                     @pointerleave="onTipPointerLeave"
                     @focusout="onTipFocusOut"
                     @keydown="onTipKeydown">
                    <ReactionCard :reaction="tipReaction" :reader="reader" @seeAll="onSeeAll" />
                </div>
            </Teleport>
            <Teleport v-if="listCode !== null || isListMounted" :to="listHost ?? 'body'" :disabled="!listHost">
                <ReactorsList :isOpen="listCode !== null"
                              :reactions="reactions"
                              :code="listOpenedOn"
                              :reader="reader"
                              :listReactors="listReactors"
                              :isPhone="isPhone"
                              @close="listCode = null" />
            </Teleport>
        </template>
    </div>
</template>

<style scoped>
/*
    The row's place under the bubble, its overlap and its mirroring for the reader's own are the
    message row's, which knows the bubble; this part draws what sits in the row.
*/
.chat-rx {
    position: relative;
    display: inline-flex;
    gap: 4px;
    align-items: center;
    height: 26px;
    margin: 0;
    padding: 0 8px 0 6px;
    font-size: 12.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--chat-text-2);
    cursor: pointer;
    background: var(--chat-raised);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), border-color var(--chat-t-fast) var(--chat-ease-state), transform var(--chat-t-fast) var(--chat-ease-in);
}

.chat-rx:hover {
    border-color: var(--chat-line-strong);
    transform: translateY(-1px);
}

.chat-rx[aria-pressed="true"] {
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-color: var(--chat-reaction-mine-line);
}

/*
    A person previewing the room sees who reacted but cannot press, so a press draws nothing. The
    chip stays enabled to the pointer and the keyboard, which is how its card is reached.
*/
.chat-rx[aria-disabled="true"] {
    cursor: default;
}

.chat-rx[aria-disabled="true"]:hover {
    border-color: var(--chat-line);
    transform: none;
}

.chat-rx[aria-disabled="true"][aria-pressed="true"]:hover {
    border-color: var(--chat-reaction-mine-line);
}

/* A long press opens who reacted, so the phone's own callout and selection stay out of it. */
.chat-rx {
    user-select: none;
    -webkit-touch-callout: none;
}

/* The card's place in the chat's root, over the feed and its bars. */
.chat-rx-card-place {
    z-index: 1060;
}

.chat-rx-e {
    font-size: 15px;
    line-height: 1;
}

/* A church's image emoji is held to the glyph's box, so a chip is the same height either way. */
.chat-rx-e.is-image {
    width: 15px;
    height: 15px;
    object-fit: contain;
}

.chat-rx-n {
    display: inline-block;
    min-width: 1ch;
}

/* Your new reaction pops from small, springing past full size, the one place a chip moves on its own. */
.chat-rx.is-popping {
    animation: chat-rx-pop var(--chat-t-base) var(--chat-ease-spring);
}

@keyframes chat-rx-pop {
    from {
        opacity: .2;
        transform: scale(var(--chat-react-from));
    }
}

/* Your reaction joining others' rolls the count up into place. */
.chat-rx-n.is-rolling {
    animation: chat-rx-roll var(--chat-d-roll) var(--chat-ease-in);
}

@keyframes chat-rx-roll {
    from {
        opacity: 0;
        transform: translateY(70%);
    }
}

/*
    The add chip sits out of flow beside the last chip, so showing it moves nothing. It shows while
    the message is hovered or holds focus, and for the reader's own it sits on the mirrored side.
*/
.chat-rx.is-add {
    position: absolute;
    top: 0;
    left: calc(100% + 4px);
    padding: 0 7px;
    color: var(--chat-icon);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--chat-t-fast) var(--chat-ease-state), color var(--chat-t-fast) var(--chat-ease-state), border-color var(--chat-t-fast) var(--chat-ease-state), transform var(--chat-t-fast) var(--chat-ease-in);
}

.is-own .chat-rx.is-add {
    right: calc(100% + 4px);
    left: auto;
}

.chat-msg:hover .chat-rx.is-add,
.chat-msg:focus-within .chat-rx.is-add,
.chat-rx.is-add:focus {
    pointer-events: auto;
    opacity: 1;
}

.chat-rx.is-add:hover {
    color: var(--chat-text);
}

/* A channel's flat look: a smaller chip, the add chip in the row's flow. */
.is-community .chat-rx {
    height: 24px;
}

.is-community .chat-rx.is-add {
    position: static;
}

/* Reduced motion: no lift, the pop held at full size by the sheet so it is a short fade, the roll a fade over its own time. */
@media (prefers-reduced-motion: reduce) {
    .chat-rx:hover {
        transform: none;
    }

    .chat-rx.is-popping {
        animation-duration: var(--chat-t-fast);
    }

    .chat-rx-n.is-rolling {
        animation-name: chat-rx-roll-fade;
    }
}

/* The roll with its movement taken out, over its own time, for reduced motion. */
@keyframes chat-rx-roll-fade {
    from {
        opacity: 0;
    }
}
</style>

<script setup lang="ts">
    import { computed, onBeforeUnmount, PropType, ref, useSlots, watch } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import Icon from "../ui/icon.partial.obs";
    import ReactionCard from "./reactionCard.partial.obs";
    import ReactorsList from "./reactorsList.partial.obs";
    import { tokenDuration } from "../ui/brand.partial";
    import { preloadPhotos } from "../ui/face.partial";
    import { focusQuietly, overlayHostOf, useTooltip } from "../ui/tooltip.partial";
    import { ReactionReader, whoReactedLine } from "../composables/useReactions.partial";
    import { Reaction, ReactorsCursor, ReactorsPage, TimelineMessage } from "../types.partial";

    const props = defineProps({
        /** The message, which carries its reactions in the order they are drawn, each with its newest three. */
        message: {
            type: Object as PropType<TimelineMessage>,
            required: true
        },

        /** A room the person has not joined: the chips are drawn and show who reacted, but cannot be pressed. */
        isPreviewing: {
            type: Boolean,
            default: false
        },

        /** A channel's flat look. */
        isCommunity: {
            type: Boolean,
            default: false
        },

        /** A phone, where the action sheet reacts, there is no add chip, and the full list is a sheet. */
        isPhone: {
            type: Boolean,
            default: false
        },

        /** The reader, whom a chip's card names "You". */
        reader: {
            type: Object as PropType<ReactionReader>,
            required: true
        },

        /** A page of who reacted to the message, with one emoji or, for null, every emoji. */
        listReactors: {
            type: Function as PropType<(code: string | null, after: ReactorsCursor | null) => Promise<ReactorsPage | null>>,
            required: true
        },

        /** Whether a chip's card is kept away for now, as while the picker covers the message. */
        isCardDisabled: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "toggle", code: string): void,
        (e: "openPicker", anchor: HTMLElement): void
    }>();

    const slots = useSlots();

    // #region Values

    const uid = `chat-rx-${newGuid()}`;

    /** How far, in pixels, a finger may move before a press stops being a long press. */
    const longPressSlopPx = 8;

    const addElement = ref<HTMLButtonElement>();

    /** The chip the card belongs to: one card for the row, moved to whichever chip the pointer rests on. */
    const tipAnchor = ref<HTMLElement>();
    const tipCode = ref<string | null>(null);

    /** The chat's root, which the card is drawn in; null where the row is drawn alone. */
    const tipHost = computed(() => overlayHostOf(tipAnchor.value));

    /** The emoji the full list is open on, null while it is closed; it stays mounted once opened so it can leave. */
    const listCode = ref<string | null>(null);
    const listOpenedOn = ref("");
    const isListMounted = ref(false);
    const listHost = ref<HTMLElement | null>(null);

    /** A touch held on a chip, which opens the full list once it has been held long enough. */
    let longPress: { timer: number, x: number, y: number } | null = null;

    /** Set once a long press opened the list, so the click its release makes does not also toggle. */
    let isClickSwallowed = false;

    // Chips animate only on a change seen here, never as a page draws them.
    const popping = ref(new Set<string>());
    const rolling = ref(new Set<string>());

    // A reaction card shows sooner than a tip, as people skim a row of chips, and holds See all.
    const {
        tipElement, isTipShown, floatingStyles, hideTip, onPointerEnter, onPointerLeave, onPointerDown, onFocus, onBlur,
        onAnchorKeydown, onTipPointerEnter, onTipPointerLeave, onTipFocusOut, onTipKeydown
    } = useTooltip(tipAnchor, () => props.isCardDisabled || listCode.value !== null, { token: "--chat-d-tip-delay-rx", fallbackMs: 350 }, true);

    // #endregion Values

    // #region Computed Values

    /** A tombstone, whether deleted or withheld, has nothing to react to. */
    const isTomb = computed((): boolean => !!props.message.deleted_at
        || props.message.visibility === "hidden"
        || props.message.visibility === "removed");

    const isChipsDrawn = computed((): boolean => props.message.message_type !== "system" && !isTomb.value);

    const reactions = computed((): Reaction[] => props.message.reactions ?? []);

    // The add chip only follows chips; a message with none is reacted to from its action bar.
    const isAddDrawn = computed((): boolean => !props.isPreviewing && !props.isPhone && reactions.value.length > 0);

    const tipReaction = computed((): Reaction | null => reactions.value.find(reaction => reaction.code === tipCode.value) ?? null);

    // #endregion Computed Values

    // #region Event Handlers

    /** A pointer that can hover rests on a chip; a finger cannot, and holds a chip instead. */
    function onChipEnter(event: PointerEvent, reaction: Reaction): void {
        if (event.pointerType === "touch") {
            return;
        }

        aimCard(event.currentTarget as HTMLElement, reaction);
        onPointerEnter();
    }

    function onChipFocus(event: FocusEvent, reaction: Reaction): void {
        aimCard(event.currentTarget as HTMLElement, reaction);
        onFocus();
    }

    function onChipPointerDown(event: PointerEvent, code: string): void {
        onPointerDown();
        cancelLongPress();
        isClickSwallowed = false;

        if (event.pointerType === "mouse") {
            return;
        }

        const chip = event.currentTarget as HTMLElement;
        const holdMs = tokenDuration(chip, "--chat-d-long-press", 450);
        longPress = {
            x: event.clientX,
            y: event.clientY,
            timer: window.setTimeout(() => {
                longPress = null;
                isClickSwallowed = true;

                // The list gives focus back to the chip it opened from, so the chip holds it first,
                // quietly, as See all does: not the composer, which would raise a phone's keyboard.
                focusQuietly(chip);
                openList(code, chip);
            }, holdMs)
        };
    }

    function onChipPointerMove(event: PointerEvent): void {
        if (longPress && Math.hypot(event.clientX - longPress.x, event.clientY - longPress.y) > longPressSlopPx) {
            cancelLongPress();
        }
    }

    /** A held chip opens the list, never the phone's own menu. */
    function onChipContextMenu(event: Event): void {
        if (longPress || isClickSwallowed) {
            event.preventDefault();
        }
    }

    function onChipClick(code: string): void {
        hideTip();

        // The release of a long press that opened the list is not a press of the chip.
        if (isClickSwallowed) {
            isClickSwallowed = false;
            return;
        }

        // A previewer's chip says it cannot be pressed; this holds a press to that.
        if (props.isPreviewing) {
            return;
        }

        emit("toggle", code);
    }

    /** See all on the card: the list opens on the card's chip, which focus comes back to. */
    function onSeeAll(): void {
        const chip = tipAnchor.value;
        const code = tipCode.value;
        hideTip();

        if (chip && code) {
            focusQuietly(chip);
            openList(code, chip);
        }
    }

    function onAddClick(): void {
        if (addElement.value) {
            emit("openPicker", addElement.value);
        }
    }

    function onPopEnd(code: string): void {
        popping.value = withoutCode(popping.value, code);
    }

    function onRollEnd(code: string): void {
        rolling.value = withoutCode(rolling.value, code);
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Puts the one card on a chip, and starts fetching the faces it will draw, so they are in by
     * the time the pointer has rested.
     */
    function aimCard(chip: HTMLElement, reaction: Reaction): void {
        tipAnchor.value = chip;
        tipCode.value = reaction.code;
        preloadPhotos([props.reader.photoUrl, ...(reaction.reactors ?? []).map(reactor => reactor.avatar_url)]);
    }

    /** Whether the card shows on this chip, which then says so. */
    function isCardOn(code: string): boolean {
        return isTipShown.value && tipCode.value === code && !!tipReaction.value;
    }

    function openList(code: string, chip: HTMLElement): void {
        hideTip();
        listHost.value = overlayHostOf(chip);
        listOpenedOn.value = code;
        isListMounted.value = true;
        listCode.value = code;
    }

    function cancelLongPress(): void {
        if (longPress) {
            window.clearTimeout(longPress.timer);
            longPress = null;
        }
    }

    /**
     * A thread pill alone keeps the row, so a tombstone's thread can still be opened. Read on each
     * draw rather than held, since whether the row is handed a pill is not something Vue tracks.
     */
    function isRowDrawn(): boolean {
        return !!slots.default || (isChipsDrawn.value && reactions.value.length > 0);
    }

    /**
     * The chip in one sentence, since the glyph and count are drawn for the eye. A person who
     * cannot press is not told what a press would do.
     */
    function chipLabel(reaction: Reaction): string {
        const base = `${reaction.label}, ${reaction.count}`;

        if (props.isPreviewing) {
            return base;
        }

        return reaction.mine ? `${base}, including you. Remove yours` : `${base}. Add yours`;
    }

    function withoutCode(set: Set<string>, code: string): Set<string> {
        const next = new Set(set);
        next.delete(code);
        return next;
    }

    // #endregion Functions

    // #region Watchers

    // A chip taken away under its card, or the picker opening over it, takes the card with it.
    watch(() => !tipReaction.value || props.isCardDisabled, isGone => {
        if (isGone && isTipShown.value) {
            hideTip();
        }
    });

    /*
        Only the reader's own change moves a chip, as the design draws it: a chip the reader just
        added pops in, and the reader joining others rolls the count. Others' changes and the
        reader taking one away change the number in place.
    */
    watch(() => reactions.value.map(({ code, count, mine }) => ({ code, count, mine })), (next, previous) => {
        // Compared with the values last drawn: the page changes a chip in place, so the chip
        // itself already holds its new count and mark by the time this runs.
        const before = new Map(previous.map(reaction => [reaction.code, reaction]));

        for (const reaction of next) {
            const old = before.get(reaction.code);

            if (!old && reaction.mine) {
                popping.value = new Set(popping.value).add(reaction.code);
            }
            else if (old && reaction.mine && !old.mine && reaction.count > old.count) {
                rolling.value = new Set(rolling.value).add(reaction.code);
            }
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    // A chip held as its row goes, as when the feed switches room, opens nothing on a row that is gone.
    onBeforeUnmount(cancelLongPress);

    // #endregion Lifecycle Hooks
</script>
