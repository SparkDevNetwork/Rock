<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <ListPanel :title="heading || 'Mentions'"
               :subtitle="heading ? null : 'Where people @mentioned you'"
               name="mentions"
               itemName="mention"
               :entranceKeys="entranceKeys"
               :isLoading="isLoading"
               :isRefreshing="isRefreshing"
               :error="error ? messageOrOffline(error, offlineRefresh) : null"
               :skeletonCount="4"
               :isEmpty="rows.length === 0"
               emptyIcon="at"
               emptyTitle="No mentions yet"
               emptyText="When someone @mentions you or uses @all, it shows up here so you can jump straight to it."
               :loadedSentence="loadedSentence"
               upToDateSentence="Mentions are up to date"
               :bodyAttrs="{ 'data-testid': 'mentions-panel' }"
               @refresh="emit('refresh')"
               @close="emit('close')">
        <!-- What the panel holding the inbox puts over it, as Activity's two lists. -->
        <template v-if="$slots.top" #top>
            <slot name="top"></slot>
        </template>

        <span :id="`${uid}-hint`" class="chat-sr-only">Up and down arrows move between mentions.</span>
        <div ref="listElement">
            <section v-for="day in days" :key="day.label" :aria-label="day.label">
                <h3 class="chat-ls-day" data-testid="mentions-day">{{ day.label }}</h3>
                <!--
                    Each mention is a list row named by its button alone, so what it draws is for
                    the eye: its links and chips are never reached. The row just opened is the
                    list's selected one.
                -->
                <ul class="chat-ls-list" :class="{ 'is-phone': isPhone }">
                    <ListRow v-for="drawn in day.rows"
                             :key="drawn.messageId"
                             as="li"
                             class="chat-ls-row chat-enter"
                             :class="{ 'is-new': drawn.isNew, 'is-current': drawn.isCurrent }"
                             data-testid="mention-row"
                             interactive
                             :selected="drawn.isCurrent"
                             :label="drawn.label"
                             :hitAttrs="{
                                 'data-testid': 'mention-row-open',
                                 'data-focus-stop': 'mentions-row',
                                 'data-message-id': drawn.messageId,
                                 'aria-describedby': `${uid}-hint`,
                                 'data-autofocus': drawn.isCurrent ? '' : undefined,
                                 ...listKeys.itemAttrs(drawn.messageId)
                             }"
                             :hitRef="listKeys.itemRef(drawn.messageId)"
                             @press="onOpen(drawn)">
                        <template #lead>
                            <span class="chat-ls-face">
                                <Dot v-if="drawn.isNew" class="chat-ls-new" data-testid="mention-row-new" />
                                <span class="chat-ls-avw"><Avatar :people="[drawn.author]" :size="32" /></span>
                            </span>
                        </template>
                        <div class="chat-ls-head">
                            <b>{{ drawn.who }}</b>
                            <span class="chat-ls-sub">
                                <Icon v-if="drawn.roomIcon" :name="drawn.roomIcon" size="xs" />
                                <span>{{ drawn.room }}</span>
                            </span>
                        </div>
                        <template #meta>
                            <time class="chat-ls-t">{{ drawn.time }}</time>
                        </template>
                        <template #detail>
                            <div class="chat-ls-text">
                                <MessageBody :text="drawn.text" :pieces="drawn.pieces" :blocks="drawn.blocks" :isConversation="drawn.isConversation" />
                            </div>
                            <span v-if="drawn.rootId !== null" class="chat-ls-inthread" data-testid="mention-row-thread"><Icon name="thread" size="xs" />Reply in a thread</span>
                        </template>
                    </ListRow>
                </ul>
            </section>
        </div>

        <LoadMoreRow v-if="hasMore"
                     ref="moreRow"
                     name="mentions"
                     label="Load older mentions"
                     :load="loadOlder"
                     :isLoading="isLoadingOlder"
                     :isFailed="!!olderError"
                     :failure="olderError ? messageOrOffline(olderError, offlineOlder) : ''" />
    </ListPanel>
</template>

<style scoped>
/* The list's frame and states are the list panel's, and its row the list row; what is here is the inbox's own. */

/*
    The face starts on the list row's lead edge, as in every panel, so faces never shift from one
    panel to the next. The New dot sits in the row's edge beside it, centred on it, 3px clear.
*/
.chat-ls-face {
    position: relative;
}

.chat-ls-new {
    position: absolute;
    top: calc(50% - 4px);
    left: -11px;
}

.chat-ls-row.is-new .chat-ls-head b {
    font-weight: 700;
}

/* Three lines here rather than the list's two: a mention is read for what it asks of the reader. */
.chat-ls-row .chat-ls-text {
    -webkit-line-clamp: 3;
}

/* A chip takes the list's line here, as in the threads list, so it never makes its line taller. */
.chat-ls-text :deep(.chat-mn) {
    line-height: inherit;
}

/*
    Where the mention is, in quiet words with the thread's mark: the whole row is the button, so
    this is never drawn as one. A flex box as wide as its content rather than an inline one: alone
    on its line, an inline box would sit on the line's own strut and stand clear of the row's foot
    by a fraction of a pixel.
*/
.chat-ls-inthread {
    display: flex;
    width: fit-content;
    gap: 4px;
    align-items: center;
    margin-top: 4px;
    font-size: var(--chat-fs-small);
    color: var(--chat-muted);
}

/* Day headings stay in view while their rows scroll under them, the rows faintly showing through. */
.chat-ls-day {
    position: sticky;
    top: -4px;
    z-index: var(--chat-z-sticky);
    padding: 12px 18px 6px;
    margin: 0;
    font-size: var(--chat-fs-small);
    font-weight: 700;
    color: var(--chat-muted);
    letter-spacing: .01em;
    background: var(--chat-surface);
    background: color-mix(in srgb, var(--chat-surface) 92%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
}

</style>

<script setup lang="ts">
    import { computed, PropType, ref, watch } from "vue";
    import Avatar, { AvatarPerson } from "../ui/avatar.partial.obs";
    import Dot from "../ui/dot.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import ListPanel from "../ui/listPanel.partial.obs";
    import ListRow from "../ui/listRow.partial.obs";
    import LoadMoreRow from "../ui/loadMoreRow.partial.obs";
    import { newGuid } from "@Obsidian/Utility/guid";
    import MessageBody from "./messageBody.partial.obs";
    import { messageOrOffline } from "../errors.partial";
    import { dayLabel, timeLabel } from "../feedLayout.partial";
    import { messageDisplay } from "../heldMessage.partial";
    import { ChatError, DisplayPiece, MentionRow, MessageBlock, RoomKind, TimelineMessage } from "../types.partial";
    import { useListKeys } from "../composables/useListKeys.partial";
    import { useAnnouncer } from "../ui/announcer.partial";
    import { useChatSession } from "../chatSession.partial";

    // #region Types

    /** One row as it is drawn and read. */
    type DrawnMention = {
        messageId: number;
        channelId: string;

        /** The thread a reply lives in, or null for a message in the conversation. */
        rootId: number | null;
        who: string;
        author: AvatarPerson;
        room: string;
        roomIcon: string | null;
        time: string;
        text: string | null;
        pieces: DisplayPiece[] | null;
        blocks: MessageBlock[] | null;

        /** A direct message or group, whose @all chip says "conversation". */
        isConversation: boolean;
        isNew: boolean;
        isCurrent: boolean;
        label: string;
    };

    /** The rows of one day, under its heading. */
    type DrawnDay = {
        label: string;
        rows: DrawnMention[];
    };

    // #endregion Types

    const props = defineProps({
        /**
         * The name of the panel holding the list, as Activity, which titles it alone over its
         * switch; empty for the list's own title and line.
         */
        heading: {
            type: String as PropType<string>,
            default: ""
        },

        /** The inbox's rows as chat_list_mentions answers them, newest first. */
        rows: {
            type: Array as PropType<MentionRow[]>,
            required: true
        },

        /** Whether older mentions wait after the last row. */
        hasMore: {
            type: Boolean,
            default: false
        },

        /** The first page is on its way with nothing of it on screen yet. */
        isLoading: {
            type: Boolean,
            default: false
        },

        /** The rows on screen are being fetched again. */
        isRefreshing: {
            type: Boolean,
            default: false
        },

        /** An older page is on its way. */
        isLoadingOlder: {
            type: Boolean,
            default: false
        },

        /** Why the last open or refresh failed, or null. */
        error: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** Why the last older page failed, or null. */
        olderError: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** The messages newer than the last visit and not opened here, marked New. */
        newIds: {
            type: Array as PropType<number[]>,
            default: () => []
        },

        /** The message whose row was just opened. */
        currentId: {
            type: Number as PropType<number | null>,
            default: null
        },

        /** Each conversation's title by channel id, as the header shows it. */
        roomTitles: {
            type: Object as PropType<Record<string, string>>,
            default: () => ({})
        },

        /** Each conversation's kind by channel id, for the room's icon; a room missing here draws no icon. */
        roomKinds: {
            type: Object as PropType<Record<string, RoomKind>>,
            default: () => ({})
        },

        /** Whether each channel is open to anyone who may join, which draws a hash rather than a lock. */
        publicRooms: {
            type: Object as PropType<Record<string, boolean>>,
            default: () => ({})
        }
    });

    const emit = defineEmits<{
        (e: "jump", messageId: number, channelId: string): void;
        (e: "openThread", rootId: number, channelId: string, messageId: number): void;
        (e: "refresh"): void;
        (e: "loadOlder"): void;
        (e: "close"): void;
    }>();

    // #region Values

    /** Ties the rows to their hint, unique per panel drawn. */
    const uid = `chat-ls-${newGuid()}`;

    const offlineRefresh = "Couldn't refresh. You're offline, so this list may be out of date.";
    const offlineOlder = "Couldn't load older mentions. You're offline.";

    // The reader, whose mention leading a row's words is left off; on a phone the list's own spacing.
    const { isPhone, me } = useChatSession();
    const { announce } = useAnnouncer();

    // The list is one tab stop, and the arrows move between rows across the day headings.
    const listKeys = useListKeys(() => days.value.flatMap(day => day.rows.map(row => row.messageId)));

    const listElement = ref<HTMLElement>();
    const moreRow = ref<InstanceType<typeof LoadMoreRow>>();

    /** How many rows were drawn when an older page was asked for, until it lands or is dropped. */
    let olderFrom: number | null = null;

    // #endregion Values

    // #region Computed Values

    const days = computed((): DrawnDay[] => {
        const now = new Date();
        const drawn: DrawnDay[] = [];
        props.rows.forEach(row => {
            const label = dayOf(row.message.created_at, now);
            let day = drawn[drawn.length - 1];
            if (day?.label !== label) {
                day = { label, rows: [] };
                drawn.push(day);
            }

            day.rows.push(drawRow(row, now));
        });

        return drawn;
    });

    /** What a screen reader hears as the first page lands: how many, and how many of them are new. */
    const loadedSentence = computed((): string => {
        const count = props.rows.length;
        const newCount = props.newIds.length;
        return `${count} ${count === 1 ? "mention" : "mentions"}${newCount > 0 ? `, ${newCount} new` : ""}`;
    });

    /** The inbox's rows for the panel's entrance, none while its first page loads or a refresh is out, so the refresh enters again. */
    const entranceKeys = computed((): string[] | null => props.isLoading || props.isRefreshing ? null : props.rows.map(row => String(row.message.id)));

    // #endregion Computed Values

    // #region Event Handlers

    /** The next older page, which the inbox says is out through isLoadingOlder until it lands. */
    function loadOlder(): void {
        emit("loadOlder");
    }

    /** A reply opens its thread at the reply; anything else lands on the message in its conversation. */
    function onOpen(row: DrawnMention): void {
        if (row.rootId !== null) {
            emit("openThread", row.rootId, row.channelId, row.messageId);
        }
        else {
            emit("jump", row.messageId, row.channelId);
        }
    }

    // #endregion Event Handlers

    // #region Functions

    function fullName(nickName: string | null | undefined, lastName: string | null | undefined): string {
        return `${nickName ?? ""} ${lastName ?? ""}`.trim();
    }

    function dateOf(at: string | null | undefined): Date | null {
        const date = at ? new Date(at) : null;
        return date && !isNaN(date.getTime()) ? date : null;
    }

    /** The heading of the day a mention was made, as the feed's divider names it. */
    function dayOf(at: string, now: Date): string {
        const date = dateOf(at);
        return date ? dayLabel(date, now) : "";
    }

    /** "9:41 AM" today, else the day, as the label's sentence reads it. */
    function spokenWhen(at: string, now: Date): string {
        const date = dateOf(at);
        if (!date) {
            return "";
        }

        const day = dayLabel(date, now);
        return day === "Today" ? timeLabel(date) : day === "Yesterday" ? "yesterday" : day;
    }

    /** The message as a sentence: its text, or the sentence shown in its place, ending in a stop. */
    function spokenText(message: TimelineMessage): string {
        const display = messageDisplay(message);
        let text = display.text ?? "";
        if ((display.kind === "message" || display.kind === "system") && Array.isArray(message.pieces) && message.pieces.length > 0) {
            text = message.pieces.map(p => p.text).join("");
        }

        text = text.replace(/\s+/g, " ").trim();
        return /[.!?…]$/.test(text) ? text : `${text}.`;
    }

    /**
     * The pieces a row draws: a mention of the reader leading the words is left off, since every
     * row here is one, and the words after it start with a capital. A mention that is the whole
     * message stays, so a row never draws empty.
     */
    function withoutLeadingReader(pieces: DisplayPiece[] | null): DisplayPiece[] | null {
        const first = pieces?.[0];
        const reader = me.value.personAliasGuid.toLowerCase();
        const isReader = first?.type === "mention" && typeof first.person_alias_guid === "string" && !!reader && first.person_alias_guid.toLowerCase() === reader;
        if (!pieces || !isReader) {
            return pieces;
        }

        const rest = pieces.slice(1);
        const lead = rest[0];
        if (lead?.type === "text") {
            const text = lead.text.replace(/^[\s,:;]+/, "").replace(/^\p{Ll}/u, letter => letter.toUpperCase());
            rest.splice(0, 1, ...(text ? [{ ...lead, text }] : []));
        }

        return rest.length > 0 ? rest : pieces;
    }

    function drawRow(row: MentionRow, now: Date): DrawnMention {
        const message = row.message;
        const display = messageDisplay(message);
        const isShown = display.kind === "message" || display.kind === "system";
        const name = fullName(message.sender_nick_name, message.sender_last_name);
        const who = name || "Someone";
        const room = props.roomTitles[row.channel_id] ?? "";
        const roomKind = props.roomKinds[row.channel_id];
        const isCurrent = props.currentId === message.id;
        const isNew = !isCurrent && props.newIds.includes(message.id);
        const date = dateOf(message.created_at);

        // A two-person conversation is titled by the other person, who wrote the mention, so it is
        // named as the reader's conversation rather than as "Sam Ortiz in Sam Ortiz".
        const where = roomKind === "person" ? "your conversation" : room;
        const thread = row.parent_id !== null ? ", in a thread" : "";
        const label = `${isNew ? "New. " : ""}${who} in ${where}${thread}, ${spokenWhen(message.created_at, now)}: ${spokenText(message)} ${row.parent_id !== null ? "Open thread" : "Go to message"}`;

        return {
            messageId: message.id,
            channelId: row.channel_id,
            rootId: row.parent_id,
            who,
            // a face with no name is the blank face, never initials drawn from a word standing in for one
            author: { name, photoUrl: message.sender_avatar_url ?? null },
            room,
            roomIcon: roomKind === "channel" ? (props.publicRooms[row.channel_id] ? "hash" : "lock") : roomKind === "group" ? "users" : roomKind === "person" ? "message" : null,
            time: date ? timeLabel(date) : "",
            text: display.text,
            pieces: isShown ? withoutLeadingReader(message.pieces ?? null) : null,
            blocks: isShown ? message.blocks ?? null : null,
            isConversation: roomKind === "person" || roomKind === "group",
            isNew,
            isCurrent,
            label
        };
    }

    // #endregion Functions

    // #region Watchers

    /** Whether the older page in flight was asked from the load-more row while it held focus. */
    let isOlderFromRow = false;

    watch(() => props.isLoadingOlder, isLoadingOlder => {
        if (isLoadingOlder) {
            olderFrom = props.rows.length;
            isOlderFromRow = !!moreRow.value?.hasFocus();
        }
    });

    // An older page asked from the row's button gives its first row focus, so the keyboard carries
    // on where the list grew; one asked by scrolling leaves focus where it is.
    watch(() => props.isLoadingOlder, (isLoadingOlder, wasLoadingOlder) => {
        const from = olderFrom;
        if (!wasLoadingOlder || isLoadingOlder || from === null) {
            return;
        }

        olderFrom = null;
        if (props.olderError) {
            announce(messageOrOffline(props.olderError, offlineOlder));
            return;
        }

        // A refresh took the page's place, so nothing was added after the rows it asked from.
        const first = props.rows[from];
        const added = props.rows.length - from;
        if (first) {
            announce(`${added} older ${added === 1 ? "mention" : "mentions"} loaded`);
            if (isOlderFromRow) {
                listKeys.current.value = first.message.id;
                listElement.value?.querySelector<HTMLElement>(`[data-focus-stop='mentions-row'][data-message-id='${first.message.id}']`)?.focus({ preventScroll: true });
            }
        }
    }, { flush: "post" });

    // #endregion Watchers
</script>
