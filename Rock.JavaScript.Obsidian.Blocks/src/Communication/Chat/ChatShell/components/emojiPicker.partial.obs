<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Teleport :to="overlayHost ?? 'body'" :disabled="!overlayHost">
        <div ref="pickerElement"
             :key="step"
             class="chat-picker"
             :class="{ 'is-tray': step === 'tray', 'is-leaving': isClosing }"
             role="dialog"
             :aria-label="mode === 'react' ? 'Add reaction' : 'Add emoji'"
             tabindex="-1"
             :style="pickerStyles"
             @keydown="onKeydown"
             @focusout="onFocusOut">
            <!--
                Moved out to the chat's root when it has one, since a feed's faded edges would fade or cut
                a picker drawn inside it; left in place where there is no root, as when a part is drawn alone.
                Drawn afresh for each step, so the full picker pops in where the tray was.
            -->
            <div v-if="step === 'tray'" class="chat-picker-tray" role="toolbar" aria-label="Quick reactions" aria-orientation="horizontal">
                <button v-for="(item, index) in trayItems"
                        :key="item.code"
                        type="button"
                        class="chat-picker-cell"
                        :tabindex="index === trayStop ? 0 : -1"
                        :data-code="item.code"
                        :aria-label="cellLabel(item)"
                        :aria-pressed="isMine(item) ? 'true' : undefined"
                        @click="choose(item)">
                    <img v-if="!item.emoji && item.image_url" class="chat-picker-glyph" :src="item.image_url" alt="" />
                    <span v-else class="chat-picker-glyph" aria-hidden="true">{{ item.emoji }}</span>
                </button>
                <span class="chat-picker-tray-sep" aria-hidden="true"></span>
                <button type="button"
                        class="chat-picker-tray-more"
                        aria-label="All emoji"
                        title="All emoji"
                        :tabindex="trayStop === trayItems.length ? 0 : -1"
                        @click="showAll">
                    <Icon name="plus" size="sm" />
                </button>
            </div>

            <template v-else>
                <div class="chat-picker-head">
                    <label class="chat-picker-search chat-field">
                        <Icon name="search" size="sm" />
                        <input ref="searchElement"
                               class="chat-field-input"
                               type="text"
                               placeholder="Search emoji"
                               autocomplete="off"
                               spellcheck="false"
                               aria-label="Search emoji"
                               :aria-controls="gridId"
                               :value="query"
                               @input="onSearchInput"
                               @keydown="onSearchKeydown" />
                    </label>
                </div>

                <div class="chat-picker-tabs" role="tablist" aria-label="Emoji categories" :hidden="isSearching">
                    <button v-for="tab in tabs"
                            :key="tab.id"
                            type="button"
                            role="tab"
                            :aria-label="tab.label"
                            :title="tab.label"
                            :aria-selected="tab.id === selectedTab ? 'true' : 'false'"
                            :aria-controls="gridId"
                            :tabindex="tab.id === tabStop ? 0 : -1"
                            @click="onTabClick(tab.id)">
                        <Icon v-if="tab.id === recentId" name="clock" size="sm" />
                        <span v-else class="chat-picker-tab-glyph" aria-hidden="true">{{ tab.glyph }}</span>
                    </button>
                </div>

                <div :id="gridId"
                     ref="bodyElement"
                     class="chat-picker-body"
                     role="grid"
                     aria-label="Emoji"
                     :aria-busy="drawnSection === null ? 'true' : undefined"
                     @mouseover="onCellHover"
                     @focusin="onCellHover">
                    <div v-if="drawnSection && drawnSection.rows.length > 0"
                         :key="drawnSection.id"
                         class="chat-picker-section"
                         role="rowgroup"
                         :aria-label="drawnSection.label">
                        <div class="chat-picker-label" role="presentation">{{ drawnSection.label }}</div>
                        <div class="chat-picker-grid">
                            <div v-for="(row, rowIndex) in drawnSection.rows" :key="rowIndex" class="chat-picker-row" role="row">
                                <button v-for="cell in row"
                                        :key="cell.key"
                                        type="button"
                                        role="gridcell"
                                        class="chat-picker-cell"
                                        :class="{ 'is-first': cell.key === firstResultKey }"
                                        :tabindex="cell.key === stopKey ? 0 : -1"
                                        :data-code="cell.item.code"
                                        :data-key="cell.key"
                                        :aria-label="cellLabel(cell.item)"
                                        :aria-pressed="isMine(cell.item) ? 'true' : undefined"
                                        @click="choose(cell.item)">
                                    <img v-if="!cell.item.emoji && cell.item.image_url" class="chat-picker-glyph" :src="cell.item.image_url" alt="" />
                                    <span v-else class="chat-picker-glyph" aria-hidden="true">{{ cell.item.emoji }}</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- A category's place while the catalog loads; the recents and the favorites need none. -->
                    <div v-if="drawnSection === null" class="chat-picker-loading" aria-hidden="true">
                        <div class="chat-skeleton chat-picker-loading-label"></div>
                        <div class="chat-picker-grid">
                            <div v-for="index in 16" :key="index" class="chat-skeleton chat-picker-loading-cell"></div>
                        </div>
                    </div>

                    <div v-if="isSearching && searchTotal === 0" class="chat-picker-empty" data-testid="emoji-empty">No emoji match “{{ query.trim() }}”</div>
                    <div v-if="searchTotal > searchLimit" class="chat-picker-more" data-testid="emoji-more">Showing the first {{ searchLimit }}. Keep typing to narrow it down.</div>
                </div>

                <div class="chat-picker-foot" data-testid="emoji-preview">
                    <template v-if="preview">
                        <img v-if="!preview.emoji && preview.image_url" class="chat-picker-prev" :src="preview.image_url" alt="" />
                        <span v-else class="chat-picker-prev" aria-hidden="true">{{ preview.emoji }}</span>
                        <span class="chat-picker-name">
                            {{ capitalized(preview.label) }}{{ isMine(preview) ? " (yours)" : "" }}
                            <span>:{{ preview.code }}:</span>
                        </span>
                    </template>
                    <span v-else class="chat-picker-name">
                        {{ mode === "react" ? "Pick a reaction" : "Pick an emoji" }}
                        <span>Hover or arrow to preview</span>
                    </span>
                </div>

                <div class="chat-sr-only" aria-live="polite" data-testid="emoji-live">{{ liveLine }}</div>
            </template>
        </div>
    </Teleport>
</template>

<style scoped>
/* Fixed, so the chat's clipped frame cannot cut the picker near its edge. */
.chat-picker {
    z-index: 1050;
    display: flex;
    flex-direction: column;
    width: 328px;
    max-width: calc(100vw - 16px);
    max-height: 380px;
    overflow: hidden;
    background: var(--chat-raised);
    border-radius: var(--chat-r-pop);
    outline: none;
    box-shadow: var(--chat-shadow-pop);
    animation: chat-picker-in var(--chat-t-base) var(--chat-ease-in);
}

/* The tray is a pill as wide as its glyphs, the bar's quick reactions grown to eight. */
.chat-picker.is-tray {
    width: auto;
    border-radius: var(--chat-r-full);
}

/* Leaves half as far and faster than it came, and takes no press on its way out. */
.chat-picker.is-leaving {
    pointer-events: none;
    animation: chat-picker-out var(--chat-t-fast) var(--chat-ease-out) forwards;
}

.chat-picker [hidden] {
    display: none !important;
}

.chat-picker-tray {
    display: flex;
    gap: 2px;
    align-items: center;
    padding: 4px;
}

.chat-picker-tray-sep {
    flex: none;
    width: 1px;
    height: 20px;
    margin: 0 3px;
    background: var(--chat-line);
}

.chat-picker-tray-more {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    color: var(--chat-icon);
    cursor: pointer;
    background: var(--chat-sidebar);
    border: 0;
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-picker-tray-more:hover {
    color: var(--chat-text);
    background: var(--chat-hover);
}

.chat-picker-tray-more:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--chat-brand-ring);
}

.chat-picker-head {
    flex: none;
    padding: 10px 10px 4px;
}

.chat-picker-search {
    display: flex;
    gap: 8px;
    align-items: center;
    height: 34px;
    padding: 0 10px;
    margin: 0;
    font-weight: 400;
    color: var(--chat-muted);
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: 10px;
}

/*
    One section at a time in a body of one height, so a short category does not shrink the picker
    under the pointer; it stops at its own ends, so a scroll past the last row never scrolls the feed.
*/
.chat-picker-body {
    position: relative;
    flex: 1 1 228px;
    min-height: 0;
    height: 228px;
    padding: 0 9px 8px 10px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
}

.chat-picker-label {
    padding: 8px 4px 4px;
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    line-height: 13px;
    color: var(--chat-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
}

.chat-picker-grid {
    display: grid;
    grid-template-columns: repeat(8, 36px);
    gap: 2px;
}

/* A row is there for a screen reader; the section's grid lays its cells out as one. */
.chat-picker-row {
    display: contents;
}

.chat-picker-cell {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    background: none;
    border: 0;
    border-radius: var(--chat-r-md);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), box-shadow var(--chat-t-fast) var(--chat-ease-state);
}

/* The tray's glyphs are round, as the pill they sit in. */
.chat-picker-tray .chat-picker-cell {
    border-radius: var(--chat-r-full);
}

.chat-picker-glyph {
    display: block;
    transition: transform var(--chat-d-glyph) var(--chat-ease-spring);
}

img.chat-picker-glyph {
    width: 22px;
    height: 22px;
    object-fit: contain;
}

.chat-picker-cell:hover {
    background: var(--chat-hover);
}

.chat-picker-cell:hover .chat-picker-glyph,
.chat-picker-cell:focus-visible .chat-picker-glyph {
    transform: scale(1.15);
}

.chat-picker-cell:active .chat-picker-glyph {
    transform: scale(.92);
    transition-duration: var(--chat-d-glyph-press);
}

/* The keyboard's cell, and the first search result, which Enter takes. */
.chat-picker-cell:focus-visible,
.chat-picker-cell.is-first {
    background: var(--chat-hover);
    outline: none;
    box-shadow: inset 0 0 0 2px var(--chat-brand-ring);
}

/* The reader's own reaction: choosing it takes it back. */
.chat-picker-cell[aria-pressed="true"] {
    background: var(--chat-brand-tint);
    box-shadow: inset 0 0 0 1px var(--chat-brand-line);
}

.chat-picker-cell[aria-pressed="true"]:focus-visible {
    box-shadow: inset 0 0 0 2px var(--chat-brand-ring), inset 0 0 0 1px var(--chat-brand-line);
}

.chat-picker-loading-label {
    width: 96px;
    height: 11px;
    margin: 9px 4px 6px;
}

.chat-picker-loading-cell {
    width: 36px;
    height: 36px;
}

.chat-picker-empty {
    padding: 28px 10px;
    font-size: 13px;
    color: var(--chat-muted);
    text-align: center;
}

.chat-picker-more {
    padding: 10px 4px 2px;
    font-size: 12px;
    color: var(--chat-muted);
    text-align: center;
}

/* Above the one section they choose, as a tab strip sits over what it switches. */
.chat-picker-tabs {
    display: flex;
    flex: none;
    gap: 2px;
    align-items: center;
    justify-content: space-between;
    height: 36px;
    padding: 0 8px;
    margin-top: 6px;
    border-bottom: 1px solid var(--chat-line);
}

.chat-picker-tabs button {
    position: relative;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    color: var(--chat-icon);
    cursor: pointer;
    background: none;
    border: 0;
    border-radius: var(--chat-r-sm);
    opacity: .75;
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

/* The category glyphs sit quiet in grey until hovered or chosen, so the row reads as chrome. */
.chat-picker-tab-glyph {
    font-size: 16px;
    line-height: 1;
    opacity: .62;
    filter: grayscale(1);
    transition: filter var(--chat-t-fast) var(--chat-ease-state), opacity var(--chat-t-fast) var(--chat-ease-state);
}

.chat-picker-tabs button:hover,
.chat-picker-tabs button[aria-selected="true"] {
    opacity: 1;
}

.chat-picker-tabs button:hover {
    color: var(--chat-text);
    background: var(--chat-hover);
}

.chat-picker-tabs button:hover .chat-picker-tab-glyph,
.chat-picker-tabs button[aria-selected="true"] .chat-picker-tab-glyph {
    opacity: 1;
    filter: none;
}

.chat-picker-tabs button[aria-selected="true"] {
    color: var(--chat-brand-ink);
}

/* On the strip's rule, under the chosen tab. */
.chat-picker-tabs button[aria-selected="true"]::after {
    position: absolute;
    right: 7px;
    bottom: -5px;
    left: 7px;
    height: 2px;
    content: "";
    background: var(--chat-brand);
    border-radius: 2px;
}

.chat-picker-tabs button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--chat-brand-ring);
}

.chat-picker-foot {
    display: flex;
    flex: none;
    gap: 10px;
    align-items: center;
    height: 44px;
    padding: 0 12px;
    background: var(--chat-sidebar);
    border-top: 1px solid var(--chat-line);
}

.chat-picker-prev {
    flex: none;
    width: 30px;
    font-size: 28px;
    line-height: 1;
    text-align: center;
}

img.chat-picker-prev {
    height: 28px;
    object-fit: contain;
}

.chat-picker-name {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--chat-text-2);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-picker-name span {
    overflow: hidden;
    font-size: 12px;
    font-weight: 400;
    color: var(--chat-muted);
    text-overflow: ellipsis;
}

/* On a touch screen nothing hovers, so there is nothing to preview. */
@media (hover: none) {
    .chat-picker-foot {
        display: none;
    }
}

/* A phone too narrow for eight glyphs at 36px keeps the eight, a little smaller. */
@media (max-width: 380px) {
    .chat-picker-tray .chat-picker-cell,
    .chat-picker-tray-more {
        width: 32px;
        height: 32px;
    }
}

/* Reduced motion: no glyph scaling. The pop's distance and scale are already off in the tokens. */
@media (prefers-reduced-motion: reduce) {
    .chat-picker-glyph {
        transition: none;
        transform: none !important;
    }
}

/* From just toward what opened it and a touch small; toward is down when the picker sits above. */
@keyframes chat-picker-in {
    from {
        opacity: 0;
        transform: translateY(calc(var(--chat-pop-toward, 1) * var(--chat-rise) * .6)) scale(var(--chat-pop-scale));
    }
}

@keyframes chat-picker-out {
    to {
        opacity: 0;
        transform: translateY(calc(var(--chat-pop-toward, 1) * var(--chat-rise) * .3)) scale(var(--chat-pop-scale));
    }
}
</style>

<script setup lang="ts">
    import { computed, getCurrentInstance, nextTick, onBeforeUnmount, onMounted, PropType, ref } from "vue";
    import { autoUpdate, flip, offset, shift, useFloating } from "@Obsidian/Libs/floating-ui";
    import Icon from "../ui/icon.partial.obs";
    import { tokenDuration } from "../ui/brand.partial";
    import { overlayHostOf } from "../ui/tooltip.partial";
    import { CatalogEmoji, EmojiGlyph } from "../types.partial";

    // #region Types

    /**
     * One emoji the picker can draw: a favorite as the bootstrap lists it, or a catalog row with its
     * category and search words. The glyph is the server's, or an image where the church has its own.
     */
    export type PickerEmoji = EmojiGlyph & Partial<Pick<CatalogEmoji, "category" | "keywords">>;

    /** What the picker draws from: favorites at once, the catalog once fetched, recents by code. */
    export type PickerSource = {
        favorites: PickerEmoji[];

        /** The church's offered emoji in picker order; null while it is still on its way. */
        catalog: PickerEmoji[] | null;

        /** Codes, newest first. */
        recents: string[];
        churchName: string;
    };

    /**
     * Where the picker opens: the quick tray of eight, the full picker one press past it, or the
     * full picker straight away, for a control that has already offered the quick reactions.
     */
    export type PickerStep = "tray" | "full";

    /**
     * How a control opens the reaction picker: where it starts, the tray unless told, and the quick
     * reactions the control already shows beside it, which the tray leaves out so nothing is
     * offered twice.
     */
    export type PickerOpening = { startsOn?: PickerStep, offered?: string[] };

    /** One drawn cell. The key tells a glyph in two sections apart, as favorites and a category. */
    type Cell = { key: string, item: PickerEmoji };

    type Section = { id: string, label: string, rows: Cell[][] };

    // #endregion Types

    const props = defineProps({
        mode: {
            type: String as PropType<"react" | "insert">,
            default: "react"
        },

        /** Where the picker opens. The tray is for reacting; inserting always opens the full picker. */
        startsOn: {
            type: String as PropType<PickerStep>,
            default: "full"
        },

        /** The quick reactions the control that opened the tray already shows, which the tray leaves out. */
        offered: {
            type: Array as PropType<string[]>,
            default: () => []
        },

        source: {
            type: Object as PropType<PickerSource>,
            required: true
        },

        /** The codes the reader reacted with, marked in react mode only. */
        mine: {
            type: Array as PropType<string[]>,
            default: () => []
        },

        /** What the picker is placed beside, and what opened it unless an opener is given. */
        anchor: {
            type: Object as PropType<HTMLElement | null>,
            default: null
        },

        /**
         * What opened the picker when it is not what the picker is placed beside, as a message's
         * add chip that a choice can take away: given focus back on a close by key or choice, or
         * the message's row once it has gone.
         */
        opener: {
            type: Object as PropType<HTMLElement | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        (e: "react", code: string): void;
        (e: "insert", text: string, code: string): void;
        (e: "close"): void;
    }>();

    // #region Values

    /** The categories in the catalog's order, named and marked as the design draws their tabs. */
    const categories = [
        { id: "smileys", label: "Smileys", glyph: "😀" },
        { id: "people", label: "People and gestures", glyph: "👋" },
        { id: "symbols", label: "Hearts and symbols", glyph: "❤️" },
        { id: "nature", label: "Nature", glyph: "🌻" },
        { id: "food", label: "Food and drink", glyph: "🍎" },
        { id: "activities", label: "Activities and celebrations", glyph: "🎉" },
        { id: "travel", label: "Travel and places", glyph: "✈️" },
        { id: "objects", label: "Objects", glyph: "💡" }
    ];

    const recentId = "recent";
    const favoritesId = "favorites";
    const resultsId = "results";
    const recentLimit = 8;
    const rowLength = 8;

    /** The tray's glyphs, a row a reader can scan at once. */
    const trayLength = 8;

    /**
     * How many search results are drawn: ten rows, about a category's worth. A letter or two can
     * match most of the catalog, and drawing every match would be the whole catalog's paint again.
     */
    const searchLimit = rowLength * 10;

    /** The way out's length when the sheet is not on the page, the sheet's own fast motion. */
    const fallbackOutMs = 120;

    /**
     * How long past the way out's length a close still waits on it: the animation starts a frame
     * after the close is asked for, so at its length it is still playing.
     */
    const outGraceMs = 50;

    /** Names this picker's grid, so its search and tabs can say which grid they control. */
    const gridId = `chat-picker-grid-${getCurrentInstance()?.uid ?? 0}`;

    const pickerElement = ref<HTMLElement>();
    const searchElement = ref<HTMLInputElement>();
    const bodyElement = ref<HTMLElement>();

    /** The step on screen; inserting has no tray, since the composer's button offers no quick reactions. */
    const step = ref<PickerStep>(props.mode === "react" ? props.startsOn : "full");

    /** The tray's one tab stop, by place; the last place is All emoji. */
    const trayStop = ref(0);

    const query = ref("");

    /** The grid's one tab stop, by cell key; null means the first cell. */
    const chosenStop = ref<string | null>(null);

    /** The section drawn; the favorites at first, as the design opens on them. */
    const selectedTab = ref(favoritesId);

    /** The tablist's one tab stop, which follows the selection until the arrows take it. */
    const tabStop = ref(favoritesId);

    /** The glyph named in the foot: the one hovered or focused, or a search's first result. */
    const preview = ref<PickerEmoji | null>(null);

    /** Set once the picker is on its way out, so nothing chosen or pressed after counts twice. */
    const isClosing = ref(false);

    /** Watches for what opened the picker leaving the page, which nothing else would tell it. */
    let anchorObserver: MutationObserver | null = null;

    /** The chat's root, which the picker is drawn in; null where it is drawn alone. */
    const overlayHost = computed(() => overlayHostOf(props.anchor));

    const anchorElement = computed(() => props.anchor ?? undefined);

    // Above what opened it, at the side of the message it belongs to: a bubble of the reader's own
    // sits on the right, so its picker ends there. Placed by left and top, since a transform here
    // would override the pop's own and the picker would only fade.
    //
    // Only the side flips, below when there is no room above. The alignment is kept and the picker
    // is slid along inside the window instead, 8px clear of its edge, as the design places every
    // popover: flipping the alignment would throw a picker near the window's edge to the far side
    // of its anchor, away from the message it belongs to.
    const { floatingStyles, placement, x } = useFloating(anchorElement, pickerElement, {
        placement: props.anchor?.closest(".chat-msg.is-conversational.is-own") ? "top-end" : "top-start",
        strategy: "fixed",
        transform: false,
        middleware: [offset(8), flip({ crossAxis: false, flipAlignment: false }), shift({ padding: 8 })],
        whileElementsMounted: autoUpdate
    });

    // #endregion Values

    // #region Computed Values

    /** Every emoji the picker knows by code: the catalog's rows, the favorites where it has none. */
    const byCode = computed((): Map<string, PickerEmoji> => {
        const map = new Map<string, PickerEmoji>();
        for (const item of props.source.favorites) {
            map.set(item.code, item);
        }

        // The catalog's row wins, since it carries the keywords a favorite is searched by.
        for (const item of props.source.catalog ?? []) {
            map.set(item.code, item);
        }

        return map;
    });

    /**
     * The recents the picker can draw, newest first. A code it does not know is left out, not drawn
     * blank: one since retired, or one from the catalog before the catalog has come.
     */
    const recents = computed((): PickerEmoji[] => props.source.recents.slice(0, recentLimit)
        .map(code => byCode.value.get(code))
        .filter((item): item is PickerEmoji => !!item));

    const favoriteItems = computed((): PickerEmoji[] => props.source.favorites.map(item => byCode.value.get(item.code) ?? item));

    /**
     * The tray: the reader's recents, then the church's favorites, each once, eight in all, past
     * the quick reactions already shown beside what opened it.
     */
    const trayItems = computed((): PickerEmoji[] => {
        return eachOnce([...recents.value, ...favoriteItems.value])
            .filter(item => !props.offered.includes(item.code))
            .slice(0, trayLength);
    });

    const favoritesLabel = computed(() => `${props.source.churchName} favorites`);

    /** A tab per section: Recently used while there are any, the favorites, and every category. */
    const tabs = computed((): Array<{ id: string, label: string, glyph: string }> => [
        ...(recents.value.length > 0 ? [{ id: recentId, label: "Recently used", glyph: "" }] : []),
        { id: favoritesId, label: favoritesLabel.value, glyph: "⭐" },
        ...categories
    ]);

    /** A section's emoji by its tab, in order; null for a category while the catalog is on its way. */
    function sectionItems(id: string): PickerEmoji[] | null {
        if (id === recentId) {
            return recents.value;
        }

        if (id === favoritesId) {
            return favoriteItems.value;
        }

        const catalog = props.source.catalog;
        return catalog ? catalog.filter(item => item.category === id) : null;
    }

    const isSearching = computed(() => terms.value.length > 0);

    /** The search's words, as the person might type a code: colons and underscores read as spaces. */
    const terms = computed((): string[] => {
        const text = query.value.toLowerCase().replace(/[:_]/g, " ").trim();
        return text ? text.split(/\s+/) : [];
    });

    /**
     * Every match of the search across the sections in their order, each glyph once, where it is
     * first held, so the arrows never pass the same glyph twice.
     */
    const matches = computed((): PickerEmoji[] => {
        if (!isSearching.value) {
            return [];
        }

        return eachOnce(tabs.value.flatMap(tab => sectionItems(tab.id) ?? []).filter(isMatch));
    });

    const searchTotal = computed(() => matches.value.length);

    /**
     * The one section drawn: the search's first results, or the chosen tab's emoji. Null while a
     * category waits on the catalog. Only this section's cells are ever in the page, so opening,
     * hovering and scrolling cost one section's paint, not the catalog's.
     */
    const drawnSection = computed((): Section | null => {
        const id = isSearching.value ? resultsId : selectedTab.value;
        const items = isSearching.value ? matches.value.slice(0, searchLimit) : sectionItems(id);
        if (!items) {
            return null;
        }

        // Rows are cut here rather than left to the grid's wrapping, since the arrows move by
        // row and column and the page lays nothing out that script could read cheaply.
        const rows: Cell[][] = [];
        for (let i = 0; i < items.length; i += rowLength) {
            rows.push(items.slice(i, i + rowLength).map(item => ({ key: `${id}:${item.code}`, item })));
        }

        const label = isSearching.value ? "Search results" : tabs.value.find(tab => tab.id === id)?.label ?? "";
        return { id, label, rows };
    });

    /** Every drawn row, which is what the arrows move through. */
    const rows = computed((): Cell[][] => drawnSection.value?.rows ?? []);

    /** Every drawn cell in order, the same order as they stand in the page. */
    const results = computed((): Cell[] => rows.value.flat());

    /**
     * The grid's one tab stop: the cell the arrows last left it on while that cell is still drawn,
     * else the first, so a search or a tab that takes the cell away never leaves the grid unreachable.
     */
    const stopKey = computed((): string | null => {
        const chosen = chosenStop.value;
        return chosen && results.value.some(cell => cell.key === chosen) ? chosen : results.value[0]?.key ?? null;
    });

    /** The first search result, marked as the one Enter takes. */
    const firstResultKey = computed(() => isSearching.value ? results.value[0]?.key ?? null : null);

    const liveLine = computed((): string => {
        if (!isSearching.value) {
            return "";
        }

        const count = searchTotal.value;
        if (count === 0) {
            return "No emoji match";
        }

        return `${count} ${count === 1 ? "result" : "results"}`;
    });

    /**
     * The placement, with the pop grown from what opened it: from its middle along the picker's
     * nearest edge, and moving toward it, so a picker flipped below grows down from above.
     */
    const pickerStyles = computed((): Record<string, string> => {
        const isAbove = placement.value.startsWith("top");
        const anchorBox = props.anchor?.getBoundingClientRect();
        const width = pickerElement.value?.offsetWidth ?? 0;

        // Measured from where the picker landed, after any slide along the window, so the pop
        // still grows out of the anchor; clamped to the picker, as an anchor can sit past its end.
        const middle = anchorBox ? anchorBox.left + anchorBox.width / 2 - (x.value ?? 0) : width / 2;
        return {
            ...floatingStyles.value,
            transformOrigin: `${Math.max(0, Math.min(width, middle))}px ${isAbove ? "100%" : "0"}`,
            "--chat-pop-toward": isAbove ? "1" : "-1"
        };
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onSearchInput(event: Event): void {
        query.value = (event.target as HTMLInputElement).value;
        chosenStop.value = null;
        if (bodyElement.value) {
            bodyElement.value.scrollTop = 0;
        }

        preview.value = isSearching.value ? results.value[0]?.item ?? null : null;
    }

    /**
     * Enter takes the first result; Down enters the grid where its tab stop is. Tab goes on in the
     * page's order, to the tabs, then the grid, or straight to the first result while the tabs are
     * hidden by a search.
     */
    function onSearchKeydown(event: KeyboardEvent): void {
        const first = results.value[0];
        if (event.key === "Enter") {
            event.preventDefault();
            if (first) {
                choose(first.item);
            }
        }
        else if (event.key === "ArrowDown" && first) {
            event.preventDefault();

            // While searching, the first result, which Enter would take; otherwise the cell the
            // reader last left the grid on, so Down returns them to their place.
            const stop = isSearching.value ? first : results.value.find(cell => cell.key === stopKey.value);
            focusCell(stop ?? first);
        }
    }

    function onKeydown(event: KeyboardEvent): void {
        if (event.key === "Escape") {
            event.preventDefault();

            // The picker's own Escape, so a panel under it does not close on the same key.
            event.stopPropagation();
            close(true);
            return;
        }

        // One handler for the dialog, sent on by what has focus, since the tray, the tabs and the
        // grid move by different keys and the search has its own.
        const target = event.target as HTMLElement;
        if (target.closest("[role='toolbar']")) {
            onTrayKeydown(event, target);
        }
        else if (target.getAttribute("role") === "tab") {
            onTabKeydown(event, target);
        }
        else if (target.getAttribute("role") === "gridcell") {
            onGridKeydown(event, target);
        }
    }

    /** Left, Right, Home and End move along the tray, its glyphs then All emoji. */
    function onTrayKeydown(event: KeyboardEvent, target: HTMLElement): void {
        const all = Array.from(pickerElement.value?.querySelectorAll<HTMLElement>("[role='toolbar'] button") ?? []);
        const index = all.indexOf(target);
        const next = ({ ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: all.length - 1 } as Record<string, number>)[event.key];
        if (next === undefined || !all[next]) {
            return;
        }

        event.preventDefault();
        trayStop.value = next;
        all[next].focus();
    }

    /** Left, Right, Home and End move between the tabs; choosing one is a press. */
    function onTabKeydown(event: KeyboardEvent, target: HTMLElement): void {
        const all = Array.from(pickerElement.value?.querySelectorAll<HTMLElement>("[role='tab']") ?? []);
        const index = all.indexOf(target);
        const next = ({ ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: all.length - 1 } as Record<string, number>)[event.key];
        if (next === undefined || !all[next]) {
            return;
        }

        // Focus moves without choosing, so passing over the tabs draws nothing; Enter or Space
        // presses the tab, which chooses it.
        event.preventDefault();
        tabStop.value = tabs.value[next].id;
        all[next].focus();
    }

    /**
     * The arrows move in two dimensions, a column kept and a short row's last cell taken; Home and
     * End go to the section's ends, Page Up and Down draw the section before or after, and Up from
     * the top row goes back to the search. Typing a letter goes to the search, where it lands.
     */
    function onGridKeydown(event: KeyboardEvent, target: HTMLElement): void {
        const all = results.value;
        const index = all.findIndex(cell => cell.key === target.dataset.key);
        if (index < 0) {
            return;
        }

        const rowIndex = Math.floor(index / rowLength);
        const column = index % rowLength;

        // Up and Down keep the column; a short last row gives its last cell instead, so Down from
        // a far column still moves a row rather than stopping above the short one.
        const inRow = (row: Cell[] | undefined): Cell | undefined => row?.[Math.min(column, row.length - 1)];

        let next: Cell | undefined;
        switch (event.key) {
            case "ArrowRight":
                next = all[index + 1];
                break;
            case "ArrowLeft":
                next = all[index - 1];
                break;
            case "ArrowDown":
                next = inRow(rows.value[rowIndex + 1]);
                break;
            case "ArrowUp":
                if (rowIndex === 0) {
                    event.preventDefault();
                    searchElement.value?.focus();
                    return;
                }
                next = inRow(rows.value[rowIndex - 1]);
                break;
            case "Home":
                next = all[0];
                break;
            case "End":
                next = all[all.length - 1];
                break;
            case "PageDown":
            case "PageUp":
                event.preventDefault();
                void turnSection(event.key === "PageDown" ? 1 : -1);
                return;
            default:
                // Focus moves before the key's own default runs, so the letter is typed into the
                // search. Space presses the cell, and a key held with a modifier is a shortcut.
                if (event.key.length === 1 && event.key !== " " && !event.ctrlKey && !event.metaKey && !event.altKey) {
                    searchElement.value?.focus();
                }
                return;
        }

        // The arrows would scroll the body as well; the move scrolls only as far as the cell needs.
        event.preventDefault();
        focusCell(next);
    }

    /** One listener on the grid for hover and focus alike, rather than one per cell. */
    function onCellHover(event: Event): void {
        const key = (event.target as HTMLElement).closest?.<HTMLElement>("[role='gridcell']")?.dataset.key;
        const cell = key ? results.value.find(c => c.key === key) : undefined;
        if (cell) {
            preview.value = cell.item;
        }
    }

    /** A tab draws its section, clearing a search first so the section is what is drawn. */
    function onTabClick(id: string): void {
        if (query.value) {
            query.value = "";
            preview.value = null;
        }

        showSection(id);
    }

    /** All emoji: the full picker in the tray's place, the search focused as on any open. */
    async function showAll(): Promise<void> {
        step.value = "full";
        await nextTick();
        focusOnOpen();
    }

    /** Focus leaving the picker for somewhere else on the page closes it, as Tab past its end does. */
    function onFocusOut(event: FocusEvent): void {
        // No next element means focus went nowhere on the page, as when the window lost it or the
        // tray gave way to the full picker, and the reader is still in the picker.
        const next = event.relatedTarget as Node | null;
        if (next && !pickerElement.value?.contains(next) && !isOfOpener(next)) {
            close(false);
        }
    }

    /** A press outside the picker and what opened it closes it, leaving focus where the press put it. */
    function onDocumentPointerDown(event: Event): void {
        // A press on what opened the picker is left to that control, which closes it by its click.
        const target = event.target as Node;
        if (pickerElement.value?.contains(target) || isOfOpener(target)) {
            return;
        }

        close(false);
    }

    // #endregion Event Handlers

    // #region Functions

    /** The emoji in order with each code kept where it first stands, as a favorite also in its category. */
    function eachOnce(items: PickerEmoji[]): PickerEmoji[] {
        const seen = new Set<string>();
        return items.filter(item => {
            if (seen.has(item.code)) {
                return false;
            }

            seen.add(item.code);
            return true;
        });
    }

    /**
     * Whether every word typed is found in the emoji's name, its keywords or its code. A word may
     * match within another, so "pra" finds folded hands by its keyword pray while it is typed.
     */
    function isMatch(item: PickerEmoji): boolean {
        const words = `${item.label} ${(item.keywords ?? []).join(" ")} ${item.code.replace(/_/g, " ")}`.toLowerCase();
        return terms.value.every(term => words.includes(term));
    }

    function isMine(item: PickerEmoji): boolean {
        // Inserting into a message marks nothing, since the reader's reactions are no part of it.
        return props.mode === "react" && props.mine.includes(item.code);
    }

    function capitalized(text: string): string {
        return text.charAt(0).toUpperCase() + text.slice(1);
    }

    function cellLabel(item: PickerEmoji): string {
        return capitalized(item.label) + (isMine(item) ? ", you reacted" : "");
    }

    /** Draws a tab's section from its top, the tab selected and the grid's stop back on its first cell. */
    function showSection(id: string): void {
        selectedTab.value = id;
        tabStop.value = id;
        chosenStop.value = null;
        if (bodyElement.value) {
            bodyElement.value.scrollTop = 0;
        }
    }

    /** Page Down and Up: the section after or before, focus on its first emoji once it is drawn. */
    async function turnSection(by: number): Promise<void> {
        if (isSearching.value) {
            return;
        }

        const index = tabs.value.findIndex(tab => tab.id === selectedTab.value);
        const next = tabs.value[index + by];
        if (!next) {
            return;
        }

        showSection(next.id);
        await nextTick();
        focusCell(results.value[0]);
    }

    /** The drawn button of a cell, found by its key. */
    function cellElement(cell: Cell): HTMLElement | null {
        return bodyElement.value?.querySelector<HTMLElement>(`[data-key="${cell.key}"]`) ?? null;
    }

    /** Moves the grid's tab stop to a cell and focus with it, scrolled just into view. */
    function focusCell(cell: Cell | undefined): void {
        if (!cell) {
            return;
        }

        chosenStop.value = cell.key;
        const element = cellElement(cell);

        // Focus alone would scroll the cell to wherever the browser likes; nearest moves the body
        // only as far as the cell needs.
        element?.focus({ preventScroll: true });
        element?.scrollIntoView?.({ block: "nearest" });
        preview.value = cell.item;
    }

    function choose(item: PickerEmoji): void {
        if (isClosing.value) {
            return;
        }

        if (props.mode === "react") {
            emit("react", item.code);
        }
        else {
            // An image emoji has no character to put in the text, so it goes in as the code the
            // message draws it from.
            emit("insert", item.emoji ?? `:${item.code}:`, item.code);
        }

        close(true);
    }

    /**
     * Closes, with focus back on what opened it when the close came from the picker itself. The
     * picker plays its own way out before saying so, since the host removes it on the word and a
     * removed element cannot animate; where nothing animates, the word goes at once. A browser
     * holds an animation in a hidden tab until the tab is shown again, so the word also goes once
     * the way out's length has passed, whichever comes first.
     */
    async function close(isFocusReturned: boolean): Promise<void> {
        if (isClosing.value) {
            return;
        }

        isClosing.value = true;
        if (isFocusReturned) {
            returnFocus();
        }

        await nextTick();

        // A choice can take the opener away as the page redraws, and the focus it held with it.
        if (isFocusReturned && props.opener?.isConnected === false) {
            returnFocus();
        }

        const picker = pickerElement.value;
        const animations = picker?.getAnimations?.() ?? [];
        if (picker && animations.length > 0) {
            const outMs = tokenDuration(picker, "--chat-t-fast", fallbackOutMs) + outGraceMs;
            await Promise.race([
                Promise.allSettled(animations.map(animation => animation.finished)),
                new Promise(resolve => window.setTimeout(resolve, outMs))
            ]);
        }

        emit("close");
    }

    /** Whether a node is what the picker is placed beside or what opened it. */
    function isOfOpener(node: Node): boolean {
        return !!props.anchor?.contains(node) || !!props.opener?.contains(node);
    }

    /** Gives focus back to what opened the picker, or to its message's row once that has gone. */
    function returnFocus(): void {
        const opener = props.opener ?? props.anchor;
        const target = opener?.isConnected === false ? props.anchor?.closest<HTMLElement>(".chat-msg") : opener;
        target?.focus({ preventScroll: true });
    }

    /**
     * Closes at once when what it is placed beside has left the page, as when its row is redrawn or its
     * drawer goes: placed beside a detached element the picker would float at the window's corner.
     */
    function onAnchorGone(): void {
        if (isClosing.value || props.anchor?.isConnected !== false) {
            return;
        }

        isClosing.value = true;
        emit("close");
    }

    /**
     * Focus for the step on screen: the tray's first glyph, or the full picker's search. On a touch
     * screen the dialog itself takes it, as focus in the search would raise the keyboard over the
     * grid, and Escape and the arrows still reach it.
     */
    function focusOnOpen(): void {
        const isTouch = window.matchMedia?.("(hover: none)").matches ?? false;
        const first = step.value === "tray" ? pickerElement.value?.querySelector<HTMLElement>("[role='toolbar'] button") : searchElement.value;
        (isTouch ? pickerElement.value : first)?.focus({ preventScroll: true });
    }

    // #endregion Functions

    // #region Lifecycle Hooks

    onMounted(async () => {
        document.addEventListener("pointerdown", onDocumentPointerDown, true);

        // Only a removal anywhere on the page can take the anchor away, so that is all it watches.
        if (props.anchor && typeof MutationObserver !== "undefined") {
            anchorObserver = new MutationObserver(onAnchorGone);
            anchorObserver.observe(document.body, { childList: true, subtree: true });
        }

        await nextTick();
        focusOnOpen();
    });

    onBeforeUnmount(() => {
        document.removeEventListener("pointerdown", onDocumentPointerDown, true);
        anchorObserver?.disconnect();
    });

    // #endregion Lifecycle Hooks
</script>
