<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Teleport :to="overlayHost ?? 'body'" :disabled="!overlayHost">
        <div ref="cardElement"
             class="chat-pc"
             :class="{ 'is-leaving': isClosing }"
             role="dialog"
             :aria-label="`Profile, ${fullName}`"
             tabindex="-1"
             data-testid="profile-card"
             :style="cardStyles"
             @keydown="onKeydown"
             @focusout="onFocusOut">
            <!--
                Moved out to the chat's root when it has one, since a feed's faded edges would fade or cut
                a card drawn inside it; left in place where there is no root, as when a part is drawn alone.
            -->
            <div class="chat-pc-id" data-testid="profile-identity">
                <Avatar :people="[{ name: fullName, photoUrl: person.avatar_url }]" :size="56" />
                <div class="chat-pc-who">
                    <div class="chat-pc-name">
                        <b data-testid="profile-name">{{ fullName }}</b>
                        <span v-if="person.is_leader" class="chat-pill" data-testid="profile-leader">Leader</span>
                        <span v-if="person.is_self" class="chat-pc-you" data-testid="profile-you">You</span>
                    </div>
                    <div v-if="campusName" class="chat-pc-line" data-testid="profile-campus"><Icon name="pin" size="xs" />{{ campusName }}</div>
                </div>
            </div>

            <!-- The person's own card is the way to their settings, the switch for these details first. -->
            <div v-if="person.is_self" class="chat-pc-acts" data-testid="profile-actions">
                <div class="chat-pc-set">
                    <SettingSwitch name="profile_details"
                                   icon="id-card"
                                   :title="meTitles.profile_details"
                                   :description="ownDetailsLine"
                                   :isOn="showsOwnDetails"
                                   :note="ownDetailsNote"
                                   @toggle="emit('toggleDetails', $event)" />
                </div>
                <button type="button"
                        class="chat-pc-btn is-line"
                        data-testid="profile-settings"
                        @click="emit('settings')"><Icon name="settings" size="xs" />Chat settings</button>
            </div>
            <div v-else class="chat-pc-acts" data-testid="profile-actions">
                <button v-if="person.can_message"
                        type="button"
                        class="chat-pc-btn"
                        data-testid="profile-message"
                        @click="emit('message', person)"><Icon name="message" size="xs" />Message</button>
                <div v-else class="chat-pc-muted" data-testid="profile-cannot-message">
                    <Icon name="mail" size="xs" />
                    <span><b>Direct messages aren't available with {{ person.nick_name }}.</b> You can still mention them in a channel you share.</span>
                </div>
            </div>

            <!--
                Below the action, so Rock answering late only lengthens the card's foot. Rock's rows are
                reserved at their own heights while it answers, and its answer fades in over them.
            -->
            <div v-if="isDetailsShown"
                 class="chat-pc-details"
                 :aria-busy="isRockLoading ? 'true' : undefined"
                 data-testid="profile-details">
                <div v-if="isRockLoading" class="chat-pc-contact" aria-hidden="true">
                    <div v-for="width in contactSkeletonWidths" :key="width" class="chat-pc-skr" data-testid="profile-contact-skeleton">
                        <i class="chat-skeleton chat-pc-sk-ic"></i><i class="chat-skeleton chat-pc-sk-bar" :style="{ width }"></i>
                    </div>
                </div>
                <div v-else-if="rockDetails && (rockDetails.email || rockDetails.mobilePhone)" class="chat-pc-contact" data-testid="profile-contact">
                    <a v-if="rockDetails.email"
                       :href="mailtoOf(rockDetails.email)"
                       :class="{ 'is-arriving': wasRockLoading }"
                       data-testid="profile-email"><Icon name="mail" size="sm" /><span>{{ rockDetails.email }}</span></a>
                    <a v-if="rockDetails.mobilePhone && rockDetails.mobilePhoneUri"
                       :href="rockDetails.mobilePhoneUri"
                       :class="{ 'is-arriving': wasRockLoading }"
                       data-testid="profile-phone"><Icon name="phone" size="sm" /><span>{{ rockDetails.mobilePhone }}</span></a>
                </div>

                <ul v-if="shownBadges.length > 0" class="chat-pc-badges" aria-label="Badges" data-testid="profile-badges">
                    <li v-for="badge in shownBadges"
                        :key="badge.key"
                        :class="{ 'is-toned': badge.isToned }"
                        :style="badge.colors"
                        data-testid="profile-badge"><i v-if="badge.iconCss" :class="badge.iconCss" aria-hidden="true"></i>{{ badge.name }}</li>
                </ul>

                <div v-if="isRockLoading && isLavaConfigured" class="chat-pc-skl" aria-hidden="true" data-testid="profile-lava-skeleton">
                    <i class="chat-skeleton is-head"></i><i class="chat-skeleton is-long"></i><i class="chat-skeleton is-short"></i>
                </div>
                <!-- Rock's own output, already cut to an allowlist of tags and addresses on the server. -->
                <div v-else-if="rockDetails?.lavaHtml"
                     class="chat-pc-lava"
                     :class="{ 'is-arriving': wasRockLoading }"
                     role="region"
                     tabindex="0"
                     :aria-label="`More about ${person.nick_name}`"
                     data-testid="profile-lava"
                     v-html="rockDetails.lavaHtml"></div>
            </div>
            <p v-else-if="!person.is_self" class="chat-pc-note" data-testid="profile-note"><Icon name="eye-off" size="xs" />{{ person.nick_name }} keeps profile details private.</p>
        </div>
    </Teleport>
</template>

<style scoped>
/* Fixed, so the chat's clipped frame cannot cut a card near its edge. */
.chat-pc {
    z-index: 1050;
    width: 300px;
    max-width: calc(100vw - 16px);
    padding: 16px 16px 14px;
    overflow: hidden;
    color: var(--chat-text);
    background: var(--chat-raised);
    border-radius: var(--chat-r-xl);
    outline: none;
    box-shadow: var(--chat-shadow-pop);
    animation: chat-pc-in var(--chat-t-base) var(--chat-ease-in);
}

/* Leaves half as far and faster than it came, and takes no press on its way out. */
.chat-pc.is-leaving {
    pointer-events: none;
    animation: chat-pc-out var(--chat-t-fast) var(--chat-ease-out) forwards;
}

/* The face beside the name and campus, the first thing read. */
.chat-pc-id {
    display: flex;
    gap: 12px;
    align-items: center;
}

.chat-pc-who {
    flex: 1;
    min-width: 0;
}

.chat-pc-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
}

.chat-pc-name b {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -.01em;
}

.chat-pc-you {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-wash);
    border-radius: var(--chat-r-full);
}

.chat-pc-line {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-top: 4px;
    font-size: 13px;
    color: var(--chat-text-2);
}

.chat-pc-line :deep(.chat-ic) {
    color: var(--chat-icon);
}

/* The details under a rule: Rock's contact rows, the badges, the church's template. */
.chat-pc-details {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 12px;
    margin-top: 14px;
    border-top: 1px solid var(--chat-line);
}

.chat-pc-contact {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

/* A row's own height is the skeleton's, so Rock's answer lands without moving anything below it. */
.chat-pc-contact a {
    display: flex;
    gap: 9px;
    align-items: center;
    min-height: 28px;
    padding: 0 8px;
    margin: 0 -8px;
    font-size: 13px;
    color: var(--chat-text);
    text-decoration: none;
    border-radius: var(--chat-r-sm);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-pc-contact a:hover {
    background: var(--chat-hover);
}

.chat-pc-contact a :deep(.chat-ic) {
    flex: none;
    color: var(--chat-icon);
}

.chat-pc-contact a span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-pc-skr {
    display: flex;
    gap: 9px;
    align-items: center;
    height: 28px;
}

.chat-pc-sk-ic {
    flex: none;
    width: 15px;
    height: 15px;
    border-radius: var(--chat-r-xs);
}

.chat-pc-sk-bar {
    height: 10px;
}

.chat-pc-skl {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.chat-pc-skl i {
    height: 10px;
}

.chat-pc-skl .is-head {
    width: 30%;
    height: 8px;
}

.chat-pc-skl .is-long {
    width: 88%;
}

.chat-pc-skl .is-short {
    width: 72%;
}

/*
    The church's template: its own words in the card's type, capped in height and scrolling inside
    past that. Contained, so nothing it draws can reach outside the card, however it is classed.
*/
.chat-pc-lava {
    max-height: 160px;
    overflow-y: auto;
    overscroll-behavior: contain;
    font-size: 13px;
    line-height: 1.45;
    color: var(--chat-text-2);
    contain: layout paint;
}

.chat-pc-lava :deep(:is(p, ul, ol, h1, h2, h3, h4, h5, h6)) {
    margin: 0 0 4px;
}

.chat-pc-lava :deep(:is(ul, ol)) {
    padding-left: 18px;
}

.chat-pc-lava :deep(:is(h1, h2, h3, h4, h5, h6)) {
    font-size: 13px;
    font-weight: 700;
    color: var(--chat-text);
}

.chat-pc-lava :deep(:is(b, strong)) {
    font-weight: 600;
    color: var(--chat-text);
}

.chat-pc-lava :deep(a) {
    color: var(--chat-brand-ink);
}

.chat-pc-lava :deep(img) {
    max-width: 100%;
    height: auto;
}

/* Rock's answer landing on rows the card already reserved. */
.is-arriving {
    animation: chat-crossfade var(--chat-t-fast) var(--chat-ease-state);
}

/* The person's badges, each a pill in its badge's colors or the plain pill where it has none. */
.chat-pc-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
}

.chat-pc-badges li {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    height: 24px;
    padding: 0 9px 0 7px;
    font-size: 12px;
    font-weight: 600;
    color: var(--chat-text-2);
    background: var(--chat-pill-bg);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-full);
}

.chat-pc-badges li i {
    font-size: 11px;
    color: var(--chat-icon);
}

/*
    The church's pale fill over the card and its dark ink on the icon and edge, each mixed by the
    theme's measure so a dark card still reads; a badge with only a fill takes the text's color.
*/
.chat-pc-badges li.is-toned {
    --chat-badge-tone: color-mix(in srgb, var(--chat-badge-fg, var(--chat-text-2)) var(--chat-badge-ink-mix), var(--chat-badge-bg));
    background: color-mix(in srgb, var(--chat-badge-bg) var(--chat-badge-fill-mix), var(--chat-raised));
    border-color: color-mix(in srgb, var(--chat-badge-tone) 22%, var(--chat-line));
}

.chat-pc-badges li.is-toned i {
    color: var(--chat-badge-tone);
}

.chat-pc-note {
    display: flex;
    gap: 6px;
    align-items: center;
    margin: 10px 0 0;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--chat-muted);
}

.chat-pc-acts {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
}

/* The person's own switch for these details, boxed as a setting. */
.chat-pc-set {
    overflow: hidden;
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-md);
}

.chat-pc-btn {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 34px;
    padding: 0 14px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    color: var(--chat-on-brand);
    background: var(--chat-brand-fill);
    border: 0;
    border-radius: var(--chat-r-full);
    transition: box-shadow var(--chat-t-fast) var(--chat-ease-state);
}

.chat-pc-btn:hover {
    box-shadow: inset 0 0 0 999px var(--chat-press);
}

/* The outlined button, as the person's own card's Chat settings. */
.chat-pc-btn.is-line {
    color: var(--chat-text);
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
}

.chat-pc-btn.is-line:hover {
    border-color: var(--chat-icon);
    box-shadow: none;
}

.chat-pc-btn.is-line :deep(.chat-ic) {
    color: var(--chat-icon);
}

.chat-pc-muted {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    padding: 9px 11px;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--chat-muted);
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-md);
}

.chat-pc-muted > :deep(.chat-ic) {
    margin-top: 2px;
    color: var(--chat-icon);
}

.chat-pc-muted b {
    display: block;
    font-weight: 600;
    color: var(--chat-text-2);
}

/* Enters from just toward what opened it and a touch small, as every popover does. */
@keyframes chat-pc-in {
    from {
        opacity: 0;
        transform: translateY(calc(var(--chat-pop-toward, -1) * var(--chat-rise) * .6)) scale(var(--chat-pop-scale));
    }
}

@keyframes chat-pc-out {
    to {
        opacity: 0;
        transform: translateY(calc(var(--chat-pop-toward, -1) * var(--chat-rise) * .3)) scale(var(--chat-pop-scale));
    }
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, onMounted, PropType, ref, watch } from "vue";
    import { autoUpdate, flip, offset, shift, useFloating } from "@Obsidian/Libs/floating-ui";
    import { ChatCampusBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatCampusBag";
    import { ChatProfileDetailsBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatProfileDetailsBag";
    import Avatar from "../ui/avatar.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import { Note } from "../ui/settingNote.partial.obs";
    import SettingSwitch from "../ui/settingSwitch.partial.obs";
    import { tokenDuration } from "../ui/brand.partial";
    import { overlayHostOf } from "../ui/tooltip.partial";
    import { meTitles } from "../composables/usePrefs.partial";
    import { ProfileRockState } from "../composables/useRooms.partial";
    import { ChatBadge, PersonProfile } from "../types.partial";

    const props = defineProps({
        /** The person as chat_get_person answered for the room the card was opened from. */
        person: {
            type: Object as PropType<PersonProfile>,
            required: true
        },

        /** The church's campuses from the init box, to name the person's campus by. */
        campuses: {
            type: Array as PropType<ChatCampusBag[]>,
            default: () => []
        },

        /** The church's badges from the bootstrap, which name and color the person's badge keys. */
        badges: {
            type: Array as PropType<ChatBadge[]>,
            default: () => []
        },

        /** The name, face or chip the card opens beside; drawn in place where there is none. */
        anchor: {
            type: Object as PropType<HTMLElement | null>,
            default: null
        },

        /** Rock's half of the card, its contact details and the church's template, as Rock answered. */
        rock: {
            type: Object as PropType<ProfileRockState>,
            default: (): ProfileRockState => ({ kind: "failed" })
        },

        /** Whether the church has a profile card template, so its lines are reserved while Rock answers. */
        isLavaConfigured: {
            type: Boolean,
            default: false
        },

        /** On the person's own card, whether they show their details now, as their switch last chose. */
        showsOwnDetails: {
            type: Boolean,
            default: false
        },

        /** On the person's own card, why their switch's last save failed, with Try again. */
        ownDetailsNote: {
            type: Object as PropType<Note | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        (e: "close"): void;
        (e: "message", person: PersonProfile): void;
        /** The person's own card's Chat settings. */
        (e: "settings"): void;
        /** The person's own switch for their details, and the value it asks for. */
        (e: "toggleDetails", value: boolean): void;
    }>();

    // #region Values

    const cardElement = ref<HTMLElement>();
    const isClosing = ref(false);

    /** The two contact rows' bars, reserved while Rock answers, each a different length as text would be. */
    const contactSkeletonWidths = ["62%", "40%"];

    /**
     * Whether this card has shown Rock's rows reserved, so its answer fades in over them; a card
     * drawn with the answer already here draws it plainly, once.
     */
    const wasRockLoading = ref(props.rock.kind === "loading");

    /** The chat's root, which the card is drawn in; null where the card is drawn alone. */
    const overlayHost = ref<HTMLElement | null>(overlayHostOf(props.anchor));

    /**
     * What had focus as the card opened, which Escape gives it back to. Read before the card takes
     * focus; the anchor stands in should that have been nothing.
     */
    const opener = (document.activeElement instanceof HTMLElement && document.activeElement !== document.body
        ? document.activeElement
        : null) ?? props.anchor;

    /** The way out's length where the sheet is not on the page, and how long past it a close still waits. */
    const fallbackOutMs = 120;
    const outGraceMs = 50;

    /**
     * Opened from the right-hand panel, the card stands beside the panel at the opener's height
     * rather than over the list; it falls back below the opener where the panel leaves no room.
     */
    const panel = props.anchor?.closest<HTMLElement>(".chat-panel") ?? null;
    const besideGap = 10;
    const anchor = props.anchor;
    const reference = panel && anchor
        ? {
            getBoundingClientRect: (): DOMRect => {
                const openerRect = anchor.getBoundingClientRect();
                const left = panel.getBoundingClientRect().left;
                // A phone's panel fills the frame, leaving no room beside it, so the card is placed
                // from the opener itself, as any other card is.
                if (left - besideGap - (cardElement.value?.offsetWidth ?? 0) < 8) {
                    return openerRect;
                }

                const top = openerRect.top - 12;
                return { x: left, y: top, left, top, right: left, bottom: top, width: 0, height: 0, toJSON: () => ({}) } as DOMRect;
            },
            contextElement: anchor
        }
        : anchor;

    // Placed by left and top, since a transform here would override the pop's own and the card
    // would only fade. It flips to whichever side the window has room on, then is kept 8px inside
    // the chat's frame both ways, overlapping its opener rather than leaving the chat.
    const frame = props.anchor?.closest<HTMLElement>(".chat-frame") ?? null;
    const { floatingStyles, placement, y: cardTop } = useFloating(ref(reference), cardElement, {
        placement: panel ? "left-start" : "bottom-start",
        strategy: "fixed",
        transform: false,
        middleware: [
            offset(({ placement: side }) => side.startsWith("left") ? besideGap : 8),
            flip({ fallbackPlacements: ["bottom-start", "top-start"] }),
            shift({ padding: 8, crossAxis: true, ...(frame ? { boundary: frame } : {}) })
        ],
        whileElementsMounted: autoUpdate
    });

    // #endregion Values

    // #region Computed Values

    const fullName = computed((): string => [props.person.nick_name, props.person.last_name].filter(part => !!part).join(" "));

    /** The campus by its name, whatever the person's setting, while the church still lists it. */
    const campusName = computed((): string => {
        const id = props.person.campus_id?.toLowerCase();
        return id ? props.campuses.find(campus => campus.guid?.toLowerCase() === id)?.name ?? "" : "";
    });

    /**
     * Whether the details block shows: on the person's own card as their switch stands, so it
     * follows the switch at once; on anyone else's as the platform answered.
     */
    const isDetailsShown = computed((): boolean => props.person.is_self ? props.showsOwnDetails : props.person.details !== null);

    const isRockLoading = computed((): boolean => props.rock.kind === "loading");

    /** What Rock answered for a person it shows, or null where it has nothing to show. */
    const rockDetails = computed((): ChatProfileDetailsBag | null => props.rock.kind === "answered" && props.rock.details.isShown ? props.rock.details : null);

    /** The line under the person's own switch: what others see either way. */
    const ownDetailsLine = computed((): string => props.showsOwnDetails ? "Others see what's below" : "Name, photo and campus only");

    /**
     * The person's badges in the church's order, only when they show their details; a key the
     * church's list does not know is dropped, as one retired since the person's list was synced.
     */
    const shownBadges = computed((): Array<{ key: string, name: string, iconCss: string, isToned: boolean, colors: Record<string, string> }> => {
        const keys = new Set(props.person.details?.badge_keys ?? []);
        return props.badges
            .filter(badge => keys.has(badge.badge_key))
            .sort((a, b) => a.sort_order - b.sort_order)
            .map(badge => {
                const colors: Record<string, string> = {};
                if (badge.bg_color) {
                    colors["--chat-badge-bg"] = badge.bg_color;
                }
                if (badge.fg_color) {
                    colors["--chat-badge-fg"] = badge.fg_color;
                }

                return { key: badge.badge_key, name: badge.name, iconCss: badge.icon_css?.trim() ?? "", isToned: !!badge.bg_color, colors };
            });
    });

    /**
     * The placement, and the pop grown toward what opened it. Beside
     * the panel the opener is to the side, so the card grows from its edge at the opener's middle
     * and does not rise; above or below it, it comes in from just toward the opener.
     */
    const cardStyles = computed((): Record<string, string> => {
        const side = placement.value.startsWith("left");
        const anchorRect = side ? props.anchor?.getBoundingClientRect() : undefined;
        const originY = anchorRect ? Math.max(0, anchorRect.top + anchorRect.height / 2 - cardTop.value) : 0;

        return {
            ...(props.anchor ? floatingStyles.value : {}),
            "--chat-pop-toward": side ? "0" : placement.value.startsWith("top") ? "1" : "-1",
            transformOrigin: side ? `100% ${originY}px` : placement.value.startsWith("top") ? "0 100%" : "0 0"
        };
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onKeydown(event: KeyboardEvent): void {
        if (event.key === "Escape") {
            event.preventDefault();
            event.stopPropagation();
            void close(true);
        }
    }

    /**
     * Focus leaving for somewhere outside the card, as Tab past its last control takes it, closes
     * the card, leaving focus there; the card is not modal, so it does not hold Tab inside.
     * Focus leaving the window says nothing about the card.
     */
    function onFocusOut(event: FocusEvent): void {
        const next = event.relatedTarget;
        if (next instanceof Node && !cardElement.value?.contains(next)) {
            void close(false);
        }
    }

    /**
     * Escape closes the card wherever focus is, as on the page after a press that put focus
     * nowhere. Taken first, so nothing behind the card closes with it; inside, the card's own
     * handler has it.
     */
    function onDocumentKeydown(event: KeyboardEvent): void {
        if (event.key === "Escape" && !cardElement.value?.contains(event.target as Node)) {
            event.preventDefault();
            event.stopPropagation();
            void close(true);
        }
    }

    /** A press anywhere outside the card closes it, leaving focus where the press put it. */
    function onDocumentPress(event: Event): void {
        const target = event.target as Node;

        // A press on what opened the card is left to that control, which closes it by its click.
        if (cardElement.value?.contains(target) || props.anchor?.contains(target)) {
            return;
        }

        void close(false);
    }

    // #endregion Event Handlers

    // #region Functions

    /** A mail link for an address, every part but the @ escaped so nothing in it adds to the link. */
    function mailtoOf(email: string): string {
        return `mailto:${encodeURIComponent(email).replace(/%40/g, "@")}`;
    }

    /**
     * Plays the way out, then asks to be removed, since a removed element cannot animate; where
     * nothing animates the word goes at once, and a hidden tab that holds the animation still lets
     * it go once the way out's length has passed.
     */
    async function close(isFocusReturned: boolean): Promise<void> {
        if (isClosing.value) {
            return;
        }

        isClosing.value = true;
        props.anchor?.removeAttribute("aria-expanded");
        if (isFocusReturned) {
            opener?.focus({ preventScroll: true });
        }

        await nextTick();

        const card = cardElement.value;
        const animations = card?.getAnimations?.() ?? [];
        if (card && animations.length > 0) {
            const outMs = tokenDuration(card, "--chat-t-fast", fallbackOutMs) + outGraceMs;
            await Promise.race([
                Promise.allSettled(animations.map(animation => animation.finished)),
                new Promise(resolve => window.setTimeout(resolve, outMs))
            ]);
        }

        emit("close");
    }

    // #endregion Functions

    // #region Watchers

    watch(() => props.rock.kind, kind => {
        if (kind === "loading") {
            wasRockLoading.value = true;
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(async () => {
        // What opened the card reads as expanded while it is open, which keeps a member row's
        // actions showing beside it as when the row is hovered.
        props.anchor?.setAttribute("aria-expanded", "true");
        // mousedown rather than click, so a press that starts a text selection elsewhere still closes it.
        document.addEventListener("mousedown", onDocumentPress, true);
        document.addEventListener("keydown", onDocumentKeydown, true);
        await nextTick();
        cardElement.value?.focus({ preventScroll: true });
    });

    onBeforeUnmount(() => {
        props.anchor?.removeAttribute("aria-expanded");
        document.removeEventListener("mousedown", onDocumentPress, true);
        document.removeEventListener("keydown", onDocumentKeydown, true);
    });

    // #endregion Lifecycle Hooks
</script>
