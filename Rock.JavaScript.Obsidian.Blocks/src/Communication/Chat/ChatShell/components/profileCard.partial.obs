<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Teleport :to="overlayHost ?? 'body'" :disabled="!overlayHost">
        <div ref="cardElement"
             class="chat-pc"
             :class="{ 'is-leaving': isClosing }"
             role="dialog"
             :aria-label="`Profile, ${fullName}`"
             tabindex="-1"
             data-testid="profile-card"
             :style="cardStyles"
             @focusout="onFocusOut">
            <!--
                Moved out to the chat's root when it has one, since a feed's faded edges would fade or cut
                a card drawn inside it; left in place where there is no root, as when a part is drawn alone.
            -->
            <div class="chat-pc-id" data-testid="profile-identity">
                <!-- Its badge holds no tip: the line beside it says the words. -->
                <Avatar :key="alias" :people="[{ name: fullName, photoUrl: person.avatar_url }]" :size="56" :status="cardStatus" :own="person.is_self" :hasStatusTip="false" />
                <div class="chat-pc-who">
                    <!-- No pill: a leader shows under the Members panel's Leaders heading, and a card that is the reader's own says so by its Chat settings. -->
                    <b class="chat-pc-name" data-testid="profile-name">{{ fullName }}</b>
                    <!-- Their status first, in words, since a phone has no tooltip; the dot between is drawn for the eye and a screen reader hears a comma. -->
                    <div v-if="campusName || cardWords" class="chat-pc-line" data-testid="profile-line">
                        <span v-if="cardWords" class="chat-pc-status" data-testid="profile-status">{{ cardWords }}</span>
                        <span v-if="cardWords && campusName" class="chat-sr-only">, </span>
                        <span v-if="campusName" class="chat-pc-campus" data-testid="profile-campus"><Icon class="chat-pc-ic" name="pin" size="xs" /><span class="chat-pc-place">{{ campusName }}</span></span>
                    </div>
                </div>
            </div>

            <!--
                One row: the way to the person, Details for their full profile at the same width, and a
                square More for Block. Their own card leads to Chat settings, where their details' switch
                is; a blocked person's card says so and keeps only the More that undoes it.
            -->
            <div class="chat-pc-acts" data-testid="profile-actions">
                <div v-if="person.is_blocked" class="chat-pc-muted" data-testid="profile-blocked">
                    <Icon class="chat-pc-ic" name="ban" size="xs" />
                    <span><b>You blocked {{ person.nick_name }}.</b> You won't see their messages, and they can't message you.</span>
                </div>
                <div v-else-if="!person.is_self && !person.can_message" class="chat-pc-muted" data-testid="profile-cannot-message">
                    <Icon class="chat-pc-ic" name="mail" size="xs" />
                    <span><b>Direct messages aren't available with {{ person.nick_name }}.</b> You can still mention them in a channel you share.</span>
                </div>

                <div class="chat-pc-row">
                    <span v-if="person.is_self" class="chat-pc-wide">
                        <Button block
                                icon="settings"
                                data-testid="profile-settings"
                                @click="emit('settings')">Chat settings</Button>
                    </span>
                    <span v-else-if="person.can_message" class="chat-pc-wide">
                        <Button kind="brand"
                                block
                                icon="message"
                                data-testid="profile-message"
                                @click="emit('message', person)">Message</Button>
                    </span>
                    <span v-if="!person.is_blocked" class="chat-pc-wide">
                        <Button block
                                data-testid="profile-details-open"
                                @click="emit('details', person)">Details</Button>
                    </span>
                    <Menu v-if="!person.is_self"
                          icon="dots"
                          label="More"
                          :items="moreItems"
                          :anchorAttrs="{ isOutlined: true, 'data-testid': 'profile-more' }"
                          @select="onMoreSelect"
                          @openChange="isMoreOpen = $event" />
                </div>
            </div>
        </div>
    </Teleport>
</template>

<style scoped>
/* Fixed, so the chat's clipped frame cannot cut a card near its edge. */
.chat-pc {
    z-index: var(--chat-z-popover);
    width: 300px;
    max-width: calc(100vw - 16px);
    padding: 16px;
    overflow: hidden;
    color: var(--chat-text);
    background: var(--chat-raised);
    border-radius: var(--chat-r-surface);
    outline: none;
    box-shadow: var(--chat-shadow-pop);
    animation: chat-pop-in var(--chat-t-base) var(--chat-ease-in);
}

/* Leaves half as far and faster than it came, and takes no press on its way out. */
.chat-pc.is-leaving {
    pointer-events: none;
    animation: chat-pop-out var(--chat-t-fast) var(--chat-ease-out) forwards;
}

/* The face beside the name and campus, the first thing read; its badge rings in the card's fill. */
.chat-pc-id {
    --chat-av-ring: var(--chat-raised);
    --chat-av-ring-over: transparent;

    display: flex;
    gap: 12px;
    align-items: center;
}

.chat-pc-who {
    flex: 1;
    min-width: 0;
}

.chat-pc-name {
    display: block;
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: var(--chat-fs-title);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -.01em;
}

/*
    One line, never two columns: the words are what a phone reads the end of a Busy from, so they
    keep their width and the campus gives way first; past the whole line the words are cut too, the
    badge's tooltip and a screen reader still having them whole.
*/
.chat-pc-line {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-top: 4px;
    overflow: hidden;
    font-size: var(--chat-fs-ui);
    color: var(--chat-text-2);
    white-space: nowrap;
}

.chat-pc-ic {
    flex: none;
    color: var(--chat-icon);
}

.chat-pc-status {
    flex: none;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
}

.chat-pc-campus {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    min-width: 0;
}

.chat-pc-place {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* The status and the campus joined by a dot, as the details' facts are. */
.chat-pc-status + .chat-sr-only + .chat-pc-campus::before {
    display: inline-block;
    flex: none;
    width: 3px;
    height: 3px;
    content: "";
    background: var(--chat-muted);
    border-radius: var(--chat-r-full);
}

.chat-pc-acts {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 14px;
}

/* The wide buttons share the row equally, however long their words; the More keeps its square at the end. */
.chat-pc-row {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}

.chat-pc-wide {
    flex: 1 1 0;
    min-width: 0;
}

.chat-pc-muted {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    padding: 9px 11px;
    font-size: var(--chat-fs-ui);
    line-height: 1.4;
    color: var(--chat-muted);
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-control);
}

.chat-pc-muted > .chat-pc-ic {
    margin-top: 2px;
}

.chat-pc-muted b {
    display: block;
    font-weight: 600;
    color: var(--chat-text-2);
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, onMounted, PropType, ref, watch } from "vue";
    import { ChatCampusBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatCampusBag";
    import Avatar from "../ui/avatar.partial.obs";
    import Button from "../ui/button.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import Menu, { MenuItem } from "../ui/menu.partial.obs";
    import { tokenDuration } from "../ui/brand.partial";
    import { cardStatusWords, shownStatus } from "../ui/face.partial";
    import { usePopover } from "../ui/popover.partial";
    import { overlayHostOf } from "../ui/tooltip.partial";
    import { PersonProfile } from "../types.partial";
    import { useFaceStatus } from "../composables/usePresenceStatus.partial";

    const props = defineProps({
        /** The person as chat_get_person answered for the room the card was opened from. */
        person: {
            type: Object as PropType<PersonProfile>,
            required: true
        },

        /** The church's campuses from the init box, to name the person's campus by. */
        campuses: {
            type: Array as PropType<ChatCampusBag[]>,
            default: () => []
        },

        /** A block or unblock of this person is out, so its item waits for it. */
        isBlockBusy: {
            type: Boolean,
            default: false
        },

        /** The name, face or chip the card opens from; drawn in place where there is none. */
        anchor: {
            type: Object as PropType<HTMLElement | null>,
            default: null
        },

        /** The face of the panel's row the card opens from, which the card's own face lines up with. */
        face: {
            type: Object as PropType<HTMLElement | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        (e: "close"): void;
        (e: "message", person: PersonProfile): void;
        /** The person's own card's Chat settings. */
        (e: "settings"): void;
        /** The person's full profile, in the side panel. */
        (e: "details", person: PersonProfile): void;
        /** Block, which a confirmation asks first, and Unblock, which needs none. */
        (e: "block", person: PersonProfile): void;
        (e: "unblock", person: PersonProfile): void;
    }>();

    // #region Values

    /**
     * The person shown, by primary alias, which keys the face: a card that moves to another person
     * in place draws another face, so the new person's badge and photo are drawn as state.
     */
    const alias = computed((): string => props.person.person_alias_guid.toLowerCase());

    const statusOf = useFaceStatus(() => [alias.value], 1);

    /** What the card draws of the person's status: her own face on her own card, her Appear offline included. */
    const cardStatus = computed(() => shownStatus(statusOf(alias.value), props.person.is_self));

    /** The campus line's words, the same on her own card as on everyone else's but for Appear offline. */
    const cardWords = computed((): string | null => cardStatus.value ? cardStatusWords(cardStatus.value, new Date()) : null);

    const cardElement = ref<HTMLElement>();
    const isClosing = ref(false);

    /** The More menu is open, so focus moving into it, drawn apart at the chat's root, is still the card's. */
    const isMoreOpen = ref(false);

    /** The chat's root, which the card is drawn in; null where the card is drawn alone. */
    const overlayHost = ref<HTMLElement | null>(overlayHostOf(props.anchor));

    /** The way out's length where the sheet is not on the page, and how long past it a close still waits. */
    const fallbackOutMs = 120;
    const outGraceMs = 50;

    /**
     * Opened from a message, the card stands under the whole row, its left edge on the row's face
     * column, so the person's message stays readable whether the face or the name was pressed; the
     * shared popover's flip takes it above the row where there is no room below. A row's face
     * column is the bubble layout's face or the community layout's gutter, drawn in every row of
     * the group, so a reply's card lines up as the first message's does.
     */
    const row = props.anchor?.closest<HTMLElement>("[data-message-id], [data-reply-id]") ?? null;
    const faceColumn = row?.querySelector<HTMLElement>(".chat-msg-face, .chat-cm-gutter") ?? null;

    /**
     * Opened from the right-hand panel's list, the card stands 8 px beside the panel rather than
     * over the list, its own face level with the row's; where the panel leaves no room beside it,
     * as a phone's panel that fills the frame, it opens below the opener as any other card does.
     */
    const panel = row ? null : props.anchor?.closest<HTMLElement>(".chat-panel") ?? null;
    const besideGap = 8;
    const cardWidth = 300;
    const isBeside = !!panel && panel.getBoundingClientRect().left - besideGap - cardWidth >= 8;

    const anchorElement = ref<HTMLElement | undefined>(props.anchor ?? undefined);

    /** The shared popover places the card, closes it on a press outside, Escape or Tab past its end, and gives focus back. */
    const popover = usePopover(anchorElement, cardElement, {
        placement: isBeside ? "left-start" : "bottom-start",
        offset: isBeside ? besideGap : 8,
        virtualAnchor: row ? rowBox : isBeside ? besideBox : undefined
    });

    // #endregion Values

    // #region Computed Values

    const fullName = computed((): string => [props.person.nick_name, props.person.last_name].filter(part => !!part).join(" "));

    /** The campus by its name, whatever the person's setting, while the church still lists it. */
    const campusName = computed((): string => {
        const id = props.person.campus_id?.toLowerCase();
        return id ? props.campuses.find(campus => campus.guid?.toLowerCase() === id)?.name ?? "" : "";
    });

    /** Block for anyone else, Unblock for someone blocked; held while either is out. */
    const moreItems = computed((): MenuItem[] => props.person.is_blocked
        ? [{ key: "unblock", label: "Unblock", isDisabled: props.isBlockBusy }]
        : [{ key: "block", label: "Block", icon: "ban", isDanger: true, isDisabled: props.isBlockBusy }]);

    /** Where the popover places the card and grows it from, toward what opened it; in place where nothing did. */
    const cardStyles = computed((): Record<string, string> => props.anchor ? { ...popover.floatingStyles.value, ...popover.origin.value } : popover.origin.value);

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Focus leaving for somewhere outside the card, by any way but the keys the popover answers,
     * closes the card, leaving focus there; the card is not modal, so it does not hold focus
     * inside. Focus leaving the window says nothing about the card, nor focus going into the
     * card's own More menu.
     */
    function onFocusOut(event: FocusEvent): void {
        const next = event.relatedTarget;
        if (next instanceof Node && !isMoreOpen.value && !cardElement.value?.contains(next)) {
            popover.close();
        }
    }

    function onMoreSelect(key: string): void {
        if (key === "block") {
            emit("block", props.person);
        }
        else if (key === "unblock") {
            emit("unblock", props.person);
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /** The message row from its face column's left edge to its end, which the card stands under. */
    function rowBox(): DOMRect {
        const box = (row as HTMLElement).getBoundingClientRect();
        const left = (faceColumn ?? props.anchor as HTMLElement).getBoundingClientRect().left;
        return { x: left, y: box.top, left, top: box.top, right: box.right, bottom: box.bottom, width: box.right - left, height: box.height, toJSON: () => ({}) } as DOMRect;
    }

    /**
     * A point at the panel's left edge, at the height that puts the card's face middle on the row's
     * face middle, which the card stands beside; on the opener's middle where no face was given.
     */
    function besideBox(): DOMRect {
        const left = (panel as HTMLElement).getBoundingClientRect().left;
        const face = (props.face ?? props.anchor as HTMLElement).getBoundingClientRect();
        const top = face.top + face.height / 2 - cardFaceMiddle();
        return { x: left, y: top, left, top, right: left, bottom: top, width: 0, height: 0, toJSON: () => ({}) } as DOMRect;
    }

    /**
     * How far down the card its own face's middle is, measured, since a name that runs to two
     * lines moves the face down. The card is fixed, so it is its face's offset parent, and the
     * offset ignores the card's pop-in scale.
     */
    function cardFaceMiddle(): number {
        const face = cardElement.value?.querySelector<HTMLElement>(".chat-pc-id .chat-pile");
        return face ? face.offsetTop + face.offsetHeight / 2 : 0;
    }

    /**
     * Once the popover has closed it, plays the way out, then asks to be removed, since a removed
     * element cannot animate; where nothing animates the word goes at once, and a hidden tab that
     * holds the animation still lets it go once the way out's length has passed.
     */
    async function leave(): Promise<void> {
        if (isClosing.value) {
            return;
        }

        isClosing.value = true;
        props.anchor?.removeAttribute("aria-expanded");

        await nextTick();

        const card = cardElement.value;
        const animations = card?.getAnimations?.() ?? [];
        if (card && animations.length > 0) {
            const outMs = tokenDuration(card, "--chat-t-fast", fallbackOutMs) + outGraceMs;
            await Promise.race([
                Promise.allSettled(animations.map(animation => animation.finished)),
                new Promise(resolve => window.setTimeout(resolve, outMs))
            ]);
        }

        emit("close");
    }

    // #endregion Functions

    // #region Watchers

    watch(popover.isOpen, isOpen => {
        if (!isOpen) {
            void leave();
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(async () => {
        // What opened the card reads as expanded while it is open, which keeps a member row's
        // actions showing beside it as when the row is hovered. Opened before the card takes
        // focus, so the popover gives focus back to what had it.
        props.anchor?.setAttribute("aria-expanded", "true");
        if (await popover.open()) {
            cardElement.value?.focus({ preventScroll: true });
        }
    });

    onBeforeUnmount(() => {
        props.anchor?.removeAttribute("aria-expanded");
    });

    // #endregion Lifecycle Hooks
</script>
