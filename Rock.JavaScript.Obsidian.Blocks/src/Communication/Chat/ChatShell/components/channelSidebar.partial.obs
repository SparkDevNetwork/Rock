    background: var(--chat-surface);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-org);
}

/* The ring keeps its fill on hover, as the design's ring rule outranks the plain button's. */
.chat-side-top :deep(.chat-side-new.chat-icon-btn:hover) {
    color: var(--chat-text-2);
    background: var(--chat-surface);
    border-color: var(--chat-line-strong);
}

/* A touch target of 40px on a phone. */
