<script setup lang="ts">
    import { computed, PropType, ref, watch } from "vue";
    import Avatar, { AvatarPerson } from "../ui/avatar.partial.obs";
    import ChannelMark from "../ui/channelMark.partial.obs";
    import GroupFace from "../ui/groupFace.partial.obs";
    import { personFace, rowPeople } from "../ui/face.partial";
    import Icon from "../ui/icon.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import { dayLabel, FeedLayout, timeLabel } from "../feedLayout.partial";
    import { notifyIconFor } from "../composables/usePrefs.partial";
    import { isTypedByReader, SidebarLoadState } from "../stores/channelStore.partial";
    import { SidebarRow } from "../types.partial";

    // #region Types

    /** One of the sidebar's sections and the rooms under it. */
    type Section = {
        key: "starred" | "channels" | "dms";
        title: string;
        rows: SidebarRow[];
    };

    // #endregion Types

    const props = defineProps({
        rows: {
            type: Array as PropType<SidebarRow[]>,
            required: true
        },

        activeChannelId: {
            type: String as PropType<string | null>,
            default: null
        },

        /** How many fresh sidebars the rows have come from; a change that comes with a new one is a reread, not live. */
        sidebarReads: {
            type: Number as PropType<number>,
            default: 0
        },

        isNewMessageShown: {
            type: Boolean,
            default: false
        },

        /** The person's own name, photo and campus by its name, drawn in the foot. */
        personName: {
            type: String,
            default: ""
        },

        personPhotoUrl: {
            type: String as PropType<string | null>,
            default: null
        },

        personCampusName: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether the block is drawn one pane at a time, as on a phone. */
        isPhone: {
            type: Boolean,
            default: false
        },

        /** Where the sidebar's first page stands; until it has arrived, no rows is not yet an empty list. */
        loadState: {
            type: String as PropType<SidebarLoadState>,
            default: "loaded"
        },

        /**
         * Whether Browse channels is open, which marks its row as the one shown in place of the
         * conversation under it, which is out of view until the directory closes.
         */
        isBrowseOpen: {
            type: Boolean,
            default: false
        },

        /**
         * Whether New message is open in the conversation's place, which presses its button and,
         * as Browse channels does, takes the current mark from the conversation out of view.
         */
        isNewMessageOpen: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "select", channelId: string): void,
        (e: "newMessage"): void,
        (e: "browse"): void,
        /** The foot was pressed: Chat settings. */
        (e: "settings"): void,
        /** Try again on a first sidebar that failed. */
        (e: "retry"): void
    }>();

    // #region Values

    /** What "Find a conversation" holds. */
    const query = ref("");

    /** The name line's width in each loading row, varied so the rows read as a list. */
    const skeletonWidths = [58, 44, 66, 50, 40, 62, 48];

    /** A muted room's mark, the glyph Off is drawn with everywhere. */
    const mutedIcon = notifyIconFor("silent");

    /** The rooms glowing for news: they just arrived, moved up, or took a message from someone else. */
    const flashIds = ref(new Set<string>());

    // #endregion Values

    // #region Computed Values

    /**
     * The rooms by section, filtered by the search over the names they are drawn under. Starred
     * shows only while it holds a room; a channel the person has not joined follows the ones they
     * have, as the design lists a pinned room after the person's own.
     */
    const sections = computed((): Section[] => {
        const needle = query.value.trim().toLowerCase();
        const shown = needle ? props.rows.filter(row => row.title.toLowerCase().includes(needle)) : props.rows;
        const channels = shown.filter(row => !row.is_favorite && row.room_kind === "channel");

        const list: Section[] = [];
        const starred = shown.filter(row => row.is_favorite);
        if (starred.length > 0) {
            list.push({ key: "starred", title: "Starred", rows: starred });
        }

        list.push({ key: "channels", title: "Channels", rows: [...channels.filter(row => row.is_member), ...channels.filter(row => !row.is_member)] });
        list.push({ key: "dms", title: "Direct messages", rows: shown.filter(row => !row.is_favorite && row.room_kind !== "channel") });

        return list;
    });

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * The row's own glow has ended. Bound to the row alone: the dot or badge a row gains animates
     * too, and its end bubbling up would cut the glow short.
     */
    function onFlashEnd(channelId: string): void {
        if (flashIds.value.has(channelId)) {
            const next = new Set(flashIds.value);
            next.delete(channelId);
            flashIds.value = next;
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /** A channel's row is Community's one dense line; a direct message's is Conversational's two lines. */
    function lookOf(row: SidebarRow): FeedLayout {
        return row.room_kind === "channel" ? "community" : "conversational";
    }

    /** A two-person conversation's face: the other person, or initials from its title without them. */
    function personFaceOf(row: SidebarRow): AvatarPerson {
        const people = rowPeople(row);
        return people.length > 0 ? personFace(people[0]) : { name: row.title, photoUrl: null };
    }

    function isActive(row: SidebarRow): boolean {
        return row.channel_id === props.activeChannelId;
    }

    /**
     * The room on screen is being read, so it never shows as unread; nor does a room the person
     * has not joined, which has no reading of theirs to be behind.
     */
    function isUnread(row: SidebarRow): boolean {
        return row.is_unread && row.is_member && !isActive(row);
    }

    function isMuted(row: SidebarRow): boolean {
        return row.notify_mode === "silent";
    }

    /**
     * The mentions a row counts. Only a channel counts them: a direct message is addressed to the
     * person, so its bold and its dot already say it. An @all names the reader as surely as their
     * name does, so the badge counts both; the app's icon counts by name alone.
     */
    function mentionsOf(row: SidebarRow): number {
        return row.room_kind !== "channel" || isActive(row) ? 0 : row.mention_count + row.all_mention_count;
    }

    /** The dot marks an unread direct message only; an unread channel is bold alone. */
    function isDotShown(row: SidebarRow): boolean {
        return row.room_kind !== "channel" && isUnread(row) && !isMuted(row);
    }

    function rowClasses(row: SidebarRow): Record<string, boolean> {
        return {
            "is-cs": lookOf(row) === "community",
            "is-unread": isUnread(row),
            "is-muted": isMuted(row),
            "is-mention": mentionsOf(row) > 0,
            "is-out": !row.is_member,
            "is-flash": flashIds.value.has(row.channel_id)
        };
    }

    /** A count as every count in the chat reads it, "99+" above 99. */
    function countText(count: number): string {
        return count > 99 ? "99+" : String(count);
    }

    /** Today's last message by its time, an older one by its day. */
    function timeOf(row: SidebarRow): string {
        if (!row.last_message_at) {
            return "";
        }

        const at = new Date(row.last_message_at);
        const day = dayLabel(at, new Date());
        return day === "Today" ? timeLabel(at) : day;
    }

    /** What a screen reader hears after the room's name, for the marks it cannot see. */
    function labelSuffixOf(row: SidebarRow): string {
        const mentions = mentionsOf(row);
        const parts = [
            row.is_member ? "" : "not joined",
            mentions > 0 ? `${mentions} mention${mentions === 1 ? "" : "s"}` : "",
            isUnread(row) ? "unread" : "",
            isMuted(row) ? "muted" : ""
        ].filter(part => part !== "");

        return parts.map(part => `, ${part}`).join("");
    }

    // #endregion Functions

    // #region Watchers

    // A row glows once for news: a room new to the list, but not a direct message whose last message
    // the person typed, as one they began on another device; a direct message reached live by a
    // message the person did not type (someone else's, or Rock's post in their name), moved or not,
    // as the design's incoming message glows; a channel turning starred. Every star control acts
    // on the room on screen, which never glows, so that last is a star made on another device
    // and seen when the sidebar is read again. A sidebar is read again for reasons of its own (a
    // reconnect, a membership change, a rename) and shows at once every message that landed since,
    // so what a reread changes is not news: a direct message's newer message, a channel's new
    // place, or a channel turning unread, which its bold and darker mark say anyway. A room leaving
    // or being unstarred shifts the others without any of them moving. The person's own send, an
    // edit and a walk-back after a delete are not news, nor the conversation on screen, and the
    // first list a page loads glows nothing.
    let readsSeen = props.sidebarReads;
    watch([() => props.rows.map(row => ({ id: row.channel_id, isDm: row.room_kind !== "channel", lastId: row.last_message_id, isTyped: isTypedByReader(row), isStarred: row.is_favorite })), () => props.loadState], ([rows, loadState], [previous, wasLoadState]) => {
        // the first sidebar is not news, though a previewed room may have had a row before it
        if (!previous || wasLoadState !== "loaded" || loadState !== "loaded") {
            return;
        }

        const isReread = props.sidebarReads !== readsSeen;
        const before = new Map(previous.map(row => [row.id, row]));
        const flashed = rows.filter(row => {
            // the conversation on screen is where the news is already shown, as in the design
            if (row.id === props.activeChannelId) {
                return false;
            }
            const was = before.get(row.id);
            if (!was) {
                // a direct message joins the list with its first message, no news to the one who typed it
                return !(row.isDm && row.isTyped);
            }
            if (row.isDm) {
                return !isReread && !row.isTyped && row.lastId !== null && (was.lastId === null || row.lastId > was.lastId);
            }
            return row.isStarred && !was.isStarred;
        }).map(row => row.id);

        if (flashed.length > 0) {
            flashIds.value = new Set([...flashIds.value, ...flashed]);
        }
    });

    // Taken after the glow above has judged the change, every time, so a read it skipped (the
    // page's first list) is not mistaken for a reread at the next live change.
    watch(() => props.sidebarReads, reads => {
        readsSeen = reads;
    }, { flush: "post" });

    // #endregion Watchers
</script>
