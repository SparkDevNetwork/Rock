<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="chat-side" :class="{ 'is-phone': isPhone }" data-testid="channel-sidebar">
        <!-- One row to find a conversation or start one; the page above already names the church. -->
        <div class="chat-side-top" :class="{ 'is-scrolled': isScrolled }" data-testid="sidebar-top">
            <!-- Laid over the conversation, the sidebar covers the header's button, so this one, in its place, puts it away. -->
            <IconButton v-if="isOver"
                        icon="sidebar"
                        label="Hide conversations"
                        aria-expanded="true"
                        data-testid="sidebar-hide"
                        @click="emit('hide')" />
            <Field v-model="query"
                   class="chat-side-search"
                   :size="isPhone ? 'lg' : 'md'"
                   leadingIcon="search"
                   placeholder="Search"
                   aria-label="Find a conversation"
                   autocomplete="off"
                   data-testid="sidebar-search" />
            <span class="chat-side-acts">
                <!--
                    Everything across conversations: Mentions and the Threads the person follows.
                    Drawn from the first paint, out of reach until chat is loaded, so the head
                    keeps its shape and the search never narrows as the button lands.
                -->
                <IconButton icon="inbox"
                            :inert="isActivityInert || undefined"
                            :label="hasMentionDot ? 'Activity, new mentions' : 'Activity'"
                            tooltip="Activity"
                            data-testid="sidebar-activity"
                            data-focus-stop="activity-button"
                            :aria-expanded="isActivityOpen ? 'true' : 'false'"
                            @click="emit('activity')">
                    <Dot v-if="hasMentionDot" class="chat-side-dot" ringed data-testid="sidebar-activity-dot" />
                </IconButton>
                <IconButton v-if="isNewMessageShown"
                            isOutlined
                            icon="compose"
                            label="New message"
                            data-testid="new-message"
                            data-focus-stop="new-message"
                            :inert="isNewMessageInert || undefined"
                            :aria-pressed="isNewMessageOpen ? 'true' : 'false'"
                            @click="emit('newMessage')" />
            </span>
        </div>

        <nav ref="listElement"
             class="chat-side-list"
             aria-label="Conversations"
             :aria-busy="loadState === 'loading' || isVeiled ? 'true' : undefined"
             :inert="isVeiled || undefined"
             @scroll.passive="onListScroll">
            <!--
                The first load's veil over the list, which the frame supplies. The rows under it are
                out of reach until it goes; the search and compose above are the frame's own.
            -->
            <slot name="veil" />
            <!--
                Still loading, not empty: rows of a conversation's size, so nothing jumps when they
                land. Read from the load alone, as a previewed room may hold a row before the rest.
            -->
            <div v-if="loadState === 'loading'">
                <span class="chat-sr-only">Loading conversations</span>
                <div aria-hidden="true">
                    <div class="chat-sec"><h3 data-testid="sidebar-skeleton-heading">Channels</h3></div>
                    <Skeleton v-for="width in channelSkeletonWidths" :key="`channel-${width}`" class="chat-side-skel-ch" shape="channel" :widths="[width]" data-testid="sidebar-skeleton" />
                    <div class="chat-sec"><h3 data-testid="sidebar-skeleton-heading">Direct messages</h3></div>
                    <Skeleton v-for="width in personSkeletonWidths" :key="`person-${width}`" class="chat-side-skel-dm" shape="person" :widths="[width, 32]" data-testid="sidebar-skeleton" />
                </div>
            </div>

            <EmptyState v-else-if="loadState === 'failed'"
                        tone="error"
                        title="Couldn't load your conversations"
                        actionLabel="Try again"
                        data-testid="sidebar-error"
                        @action="emit('retry')" />

            <div v-else-if="rows.length === 0" class="chat-side-empty" data-testid="sidebar-empty">
                <EmptyState title="No conversations yet" text="Message someone from your groups, or browse channels to join." />
                <div class="chat-side-empty-actions">
                    <Button v-if="isNewMessageShown" kind="brand" icon="compose" data-testid="empty-new-message" @click="emit('newMessage')">New message</Button>
                    <!-- With no New message beside it, this is the one way in, so it is the filled one. -->
                    <Button :kind="isNewMessageShown ? 'ghost' : 'brand'" data-testid="empty-browse" @click="emit('browse')">Browse channels</Button>
                </div>
            </div>

            <template v-else>
                <EmptyState v-if="isNoResults" title="No results" data-testid="sidebar-no-results" />
                <div v-for="section in sections"
                     :key="section.key"
                     data-testid="sidebar-section"
                     :data-section="section.key">
                    <div v-if="!isNoResults" class="chat-sec">
                        <h3 class="chat-section-label chat-list-heading" data-testid="section-heading">{{ section.title }}</h3>
                        <IconButton v-if="section.key === 'channels'"
                                    class="chat-sec-btn"
                                    icon="plus"
                                    iconSize="sm"
                                    label="Browse channels"
                                    data-testid="section-browse"
                                    @click="emit('browse')" />
                        <IconButton v-if="section.key === 'dms' && isNewMessageShown"
                                    class="chat-sec-btn"
                                    icon="plus"
                                    iconSize="sm"
                                    label="New message"
                                    data-testid="section-new-message"
                                    @click="emit('newMessage')" />
                    </div>

                    <!--
                        A room a message moves glides to its place by the list's one move, keeping
                        its element and its face; its bold, dot and badge say what is new. The move is
                        the list's only motion: a row leaving its section, starred or hidden, goes in
                        the same frame, so the rows under it glide into its place and no copy lingers.
                        After every channel, a room only previewed included, comes the way to the ones
                        not listed.
                    -->
                    <TransitionGroup moveClass="chat-move" :css="false">
                        <button v-for="row in section.rows"
                                :key="row.channel_id"
                                type="button"
                                class="chat-row"
                                :class="rowClasses(row)"
                                data-testid="channel-row"
                                data-focus-stop="row"
                                :data-channel-id="row.channel_id"
                                :data-layout="lookOf(row)"
                                :data-unread="isUnread(row) ? 'true' : 'false'"
                                :data-muted="isMuted(row) ? 'true' : 'false'"
                                :data-mentioned="mentionsOf(row) > 0 ? 'true' : 'false'"
                                :aria-current="isActive(row) && !isBrowseOpen && !isNewMessageOpen ? 'true' : undefined"
                                @mouseenter="onRowEnter($event, row)"
                                @mouseleave="nameTip.hideTip"
                                @focus="onRowFocus($event, row)"
                                @blur="nameTip.onBlur"
                                @click="emit('select', row.channel_id)">
                            <!-- A channel: one dense line, its icon, its name, and bold when unread. -->
                            <template v-if="lookOf(row) === 'community'">
                                <span class="chat-row-face" aria-hidden="true">
                                    <ChannelMark class="chat-ch-tile" :isPublic="row.is_public" :imageUrl="row.icon_url" :tileName="row.title" />
                                </span>
                                <span class="chat-row-title">
                                    <span class="chat-row-name" data-testid="row-name">{{ row.title }}</span>
                                    <Icon v-if="!row.is_public" name="lock" class="chat-row-lock" data-testid="row-lock" />
                                    <Icon v-if="isMuted(row)" :name="mutedIcon" class="chat-row-mute" data-testid="row-muted-icon" />
                                </span>
                            </template>

                            <!-- A direct message: the face, the name and time over the preview and the end mark. -->
                            <template v-else>
                                <span class="chat-row-face" aria-hidden="true">
                                    <Avatar v-if="row.room_kind === 'person'" :people="[personFaceOf(row)]" :size="36" :status="rowStatus(row)" />
                                    <GroupFace v-else :people="rowPeople(row).map(personFace)" :count="row.dm_other_count" />
                                </span>
                                <span class="chat-row-main">
                                    <span class="chat-row-top">
                                        <span class="chat-row-name" data-testid="row-name">{{ row.title }}</span>
                                        <!-- The person's status is heard as part of their name, before the time and the preview. -->
                                        <span v-if="row.room_kind === 'person' && rowStatus(row)" class="chat-sr-only" data-testid="row-status-words">{{ rowStatus(row)?.label }}</span>
                                        <Icon v-if="isMuted(row)" :name="mutedIcon" class="chat-row-mute" data-testid="row-muted-icon" />
                                        <span class="chat-row-time" data-testid="row-time">{{ timeOf(row) }}</span>
                                    </span>
                                    <span class="chat-row-sub">
                                        <span class="chat-row-prev" data-testid="row-preview">{{ row.preview_line }}</span>
                                        <span class="chat-row-end">
                                            <Badge v-if="mentionsOf(row) > 0" icon="at" :count="mentionsOf(row)" :tone="isMuted(row) ? 'muted' : 'brand'" data-testid="row-mention-badge" />
                                            <Dot v-else-if="isDotShown(row)" data-testid="row-dot" />
                                        </span>
                                    </span>
                                </span>
                            </template>

                            <span v-if="lookOf(row) === 'community'" class="chat-row-end">
                                <Badge v-if="mentionsOf(row) > 0" icon="at" :count="mentionsOf(row)" :tone="isMuted(row) ? 'muted' : 'brand'" data-testid="row-mention-badge" />
                                <Dot v-else-if="isDotShown(row)" data-testid="row-dot" />
                            </span>

                            <span class="chat-sr-only" data-testid="row-label-suffix">{{ labelSuffixOf(row) }}</span>
                        </button>

                        <button v-if="section.key === 'channels'"
                                key="browse"
                                type="button"
                                class="chat-row is-cs is-browse"
                                data-testid="sidebar-browse"
                                data-layout="community"
                                :aria-current="isBrowseOpen ? 'true' : undefined"
                                @click="emit('browse')">
                            <span class="chat-row-face" aria-hidden="true">
                                <span class="chat-ch-tile is-browse"><Icon name="search" size="sm" /></span>
                            </span>
                            <span class="chat-row-title"><span class="chat-row-name">Browse channels</span></span>
                        </button>
                    </TransitionGroup>
                </div>
            </template>
        </nav>

        <Teleport :to="tipHost ?? 'body'" :disabled="!tipHost">
            <div v-if="isNameTipShown"
                 ref="nameTipElement"
                 class="chat-tip"
                 role="tooltip"
                 :style="nameTip.floatingStyles.value">{{ nameTipText }}</div>
        </Teleport>

        <!--
            Who the person is, and their settings; with online status, their face sets their status.
            Drawn final from the first paint with no veil over it, so its face fades in on its own
            at the first load's reveal.
        -->
        <div class="chat-side-me" data-unveiled>
            <StatusMenu v-if="isStatusShown"
                        trigger="face"
                        :choice="statusChoice"
                        :closedReason="statusClosedReason"
                        :isRetrying="isStatusRetrying"
                        @choose="emit('status', $event)" />
            <button type="button"
                    class="chat-me-btn"
                    aria-haspopup="dialog"
                    :aria-label="`Chat settings, ${me.name}`"
                    data-testid="sidebar-me"
                    data-focus-stop="sidebar-me"
                    @click="emit('settings')">
                <Avatar v-if="!isStatusShown" :people="[{ name: me.name, photoUrl: me.photoUrl }]" :size="36" />
                <span class="chat-me-who">
                    <b data-testid="sidebar-me-name">{{ me.name }}</b>
                    <span v-if="personCampusName" data-testid="sidebar-me-campus">{{ personCampusName }}</span>
                </span>
                <span class="chat-me-gear" aria-hidden="true"><Icon name="settings" /></span>
            </button>
        </div>
    </div>
</template>

<style scoped>
/* The sidebar column, ported from the design: the search and compose in one head, then the rooms. */
.chat-side {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--chat-sidebar);
    border-right: 1px solid var(--chat-line);
}

/* On a phone the list fills the frame, so there is nothing beside it to rule off. */
.chat-side.is-phone {
    border-right: 0;
}

/*
    As tall as the conversation's header, so the two columns' tops line up. Its rule shows only once
    rows scroll under it, so a scrolled list is never cut mid-row against nothing.
*/
.chat-side-top {
    display: flex;
    flex: none;
    gap: 8px;
    align-items: center;
    height: 64px;
    padding: 0 12px;
    border-bottom: 1px solid transparent;
    transition: border-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-side-top.is-scrolled {
    border-bottom-color: var(--chat-line);
}

/* The search takes the head's width beside the compose button. */
.chat-side-search {
    flex: 1;
    min-width: 0;
}

/* Activity and the compose square are as tall as the search's field beside them, so the head reads as one row. */
.chat-side-acts {
    --chat-icon-btn-s: 36px;
    --chat-ic-size: 18px;

    display: flex;
    flex: none;
    gap: 4px;
    align-items: center;
}

/* A phone's large field, a finger's target, and the squares beside it its height. */
.is-phone .chat-side-acts {
    --chat-icon-btn-s: 44px;
}

/* A mention waiting, over Activity's corner, ringed in the head's fill so it reads apart from the icon. */
.chat-side-dot {
    position: absolute;
    top: 6px;
    right: 6px;
    pointer-events: none;
}

.chat-side-list {
    flex: 1;
    min-height: 0;
    padding: 4px 8px 12px;
    overflow-y: auto;
    scrollbar-width: thin;
}

/*
    The foot: one button for who the person is and their settings, its gear turning on hover; with
    online status, their face is a button of its own before it, whose badge is ringed in the
    sidebar's fill, so the settings button's hover starts after the face.
*/
.chat-side-me {
    --chat-av-ring: var(--chat-sidebar);

    display: flex;
    flex: none;
    gap: 2px;
    align-items: center;
    padding: 8px;
    border-top: 1px solid var(--chat-line);
}

.chat-me-btn {
    display: flex;
    flex: 1;
    gap: 10px;
    align-items: center;
    width: 100%;
    min-width: 0;
    padding: 6px 8px;
    font: inherit;
    color: var(--chat-text);
    text-align: left;
    background: transparent;
    border: 0;
    border-radius: var(--chat-r-surface);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-me-btn:hover {
    background: var(--chat-hover);
}

.chat-me-btn:active {
    background: var(--chat-press);
}

.chat-me-who {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
}

.chat-me-who b,
.chat-me-who span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chat-me-who b {
    font-size: var(--chat-fs-ui);
    font-weight: 600;
}

.chat-me-who span {
    font-size: var(--chat-fs-small);
    color: var(--chat-muted);
}

.chat-me-gear {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--chat-icon);
    border-radius: var(--chat-r-full);
    transition: color var(--chat-t-fast) var(--chat-ease-state), transform var(--chat-t-base) var(--chat-ease-in);
}

.chat-me-btn:hover .chat-me-gear {
    color: var(--chat-text);
    transform: rotate(var(--chat-turn));
}

.chat-sec {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 8px 4px 10px;
}

/* The heading's box is the sheet's list heading; its whole-pixel line is pinned here beside the rows' lines. */
.chat-sec h3 {
    line-height: 16px;
}

/* A heading's plus, smaller than the head's buttons. */
.chat-sec {
    --chat-icon-btn-s: 26px;
}

/*
    A room: a 36px column first, a direct message's face or a channel's tile centred in it, so
    every row starts on one edge. Heights and lines are whole pixels, so the badge's layer and the
    text in it land on the pixel grid.
*/
.chat-row {
    /*
        The row's fill, set by its state alone: a group's mark rings its faces in the same fill over
        the sidebar, so the ring always matches what is behind it.
    */
    --chat-row-fill: transparent;
    --chat-av-ring: var(--chat-sidebar);
    --chat-av-ring-over: var(--chat-row-fill);

    position: relative;
    display: flex;
    gap: 10px;
    align-items: center;
    width: 100%;
    height: 52px;
    padding: 0 8px;
    font: inherit;
    color: inherit;
    text-align: left;
    background: var(--chat-row-fill);
    border: 0;
    border-radius: var(--chat-r-row);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-row:hover {
    --chat-row-fill: var(--chat-hover);
}

.chat-row[aria-current="true"] {
    --chat-row-fill: var(--chat-brand-wash);
}

/* A person's face, a group's mark or a channel's tile, centred in 36px. */
.chat-row-face {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
}

.chat-row-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
}

.chat-row-top {
    display: flex;
    gap: 8px;
    align-items: center;
}

.chat-row-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: var(--chat-fs-body);
    font-weight: 450;
    line-height: 20px;
    color: var(--chat-row-name);
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chat-row-time {
    flex: none;
    font-size: var(--chat-fs-small);
    line-height: 20px;
    font-variant-numeric: tabular-nums;
    color: var(--chat-muted);
}

.chat-row-sub {
    display: flex;
    gap: 8px;
    align-items: center;
    min-width: 0;
}

.chat-row-prev {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: var(--chat-fs-ui);
    line-height: 18px;
    color: var(--chat-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* One mark per row, on the preview's line under the time: the mention badge or the dot. */
.chat-row-end {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: flex-end;
    min-width: 18px;
    height: 18px;
}

.chat-row .chat-row-mute {
    flex: none;
    align-self: center;
    width: 13px;
    height: 13px;
    color: var(--chat-icon);
}

.chat-row.is-muted .chat-row-name,
.chat-row.is-muted .chat-row-prev {
    color: var(--chat-muted);
}

/* A muted room that is unread still reads bold, its name and preview kept muted. */
.chat-row.is-unread .chat-row-name {
    font-weight: 700;
}

.chat-row.is-unread:not(.is-muted) .chat-row-name {
    color: var(--chat-text);
}

.chat-row.is-unread:not(.is-muted) .chat-row-prev {
    color: var(--chat-text-2);
}

.chat-row.is-mention .chat-row-time {
    font-weight: 600;
    color: var(--chat-brand-ink);
}

.is-phone .chat-row {
    height: 56px;
}

/* A channel's room: one line, 44px (48px on a phone), a 32px tile in the face column. */
.chat-row.is-cs {
    height: 44px;
}

.is-phone .chat-row.is-cs {
    height: 48px;
}

/*
    The tile is the channel's image, or its first letter on its own color, in a square a little
    tighter than a face's circle. The room's state never changes its color.
*/
.chat-ch-tile {
    display: grid;
    flex: none;
    place-items: center;
    box-sizing: border-box;
    width: 32px;
    height: 32px;
    overflow: hidden;
    color: var(--chat-icon);
    border-radius: var(--chat-r-control);
}

/* The name, then the private lock and the muted mark, which stay beside it however long it is. */
.chat-row-title {
    display: flex;
    flex: 1;
    gap: 4px;
    align-items: center;
    min-width: 0;
}

.chat-row-title .chat-row-name {
    flex: 0 1 auto;
}

.chat-row .chat-row-lock {
    --chat-ic-size: 12px;
    --chat-ic-stroke: 2;
    flex: none;
    color: var(--chat-icon);
}

.chat-row.is-cs .chat-row-end {
    min-width: 0;
    height: 20px;
}

.chat-row.is-cs[aria-current="true"] .chat-row-name {
    font-weight: 600;
    color: var(--chat-text);
}

.chat-row.is-cs.is-out .chat-row-name {
    color: var(--chat-muted);
}

/* Browse channels reads as a way on rather than a room: a dashed tile, its name quiet, as a room not joined is. */
.chat-row.is-browse .chat-row-name,
.chat-row.is-browse[aria-current="true"] .chat-row-name {
    font-weight: 500;
    color: var(--chat-muted);
}

.chat-ch-tile.is-browse {
    border: 1.5px dashed var(--chat-line-strong);
}

/* A loading row stands in for the row a phone draws taller, a finger's height. */
.is-phone .chat-side-skel-ch {
    height: 48px;
}

.is-phone .chat-side-skel-dm {
    height: 56px;
}

/* A new person with nothing to list yet: the words, then one filled button and one quiet one. */
.chat-side-empty {
    padding: 24px 0 16px;
}

.chat-side-empty-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
}
</style>

<script setup lang="ts">
    import { computed, onMounted, PropType, ref, watch } from "vue";
    import Avatar, { AvatarPerson } from "../ui/avatar.partial.obs";
    import StatusMenu from "./statusMenu.partial.obs";
    import Badge from "../ui/badge.partial.obs";
    import Button from "../ui/button.partial.obs";
    import ChannelMark from "../ui/channelMark.partial.obs";
    import Dot from "../ui/dot.partial.obs";
    import EmptyState from "../ui/emptyState.partial.obs";
    import Field from "../ui/field.partial.obs";
    import GroupFace from "../ui/groupFace.partial.obs";
    import { personFace, rowPeople } from "../ui/face.partial";
    import Icon from "../ui/icon.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import Skeleton from "../ui/skeleton.partial.obs";
    import { dayLabel, FeedLayout, timeLabel } from "../feedLayout.partial";
    import { notifyIconFor, StatusChoice } from "../composables/usePrefs.partial";
    import { useFaceStatus } from "../composables/usePresenceStatus.partial";
    import { SidebarLoadState } from "../stores/channelStore.partial";
    import { FaceStatus, SidebarRow } from "../types.partial";
    import { isCutShort, overlayHostOf, useTooltip } from "../ui/tooltip.partial";
    import { useChatSession } from "../chatSession.partial";

    // #region Types

    /** One of the sidebar's sections and the rooms under it. */
    type SidebarSection = {
        key: "starred" | "channels" | "dms";
        title: string;
        rows: SidebarRow[];
    };

    // #endregion Types

    const props = defineProps({
        rows: {
            type: Array as PropType<SidebarRow[]>,
            required: true
        },

        activeChannelId: {
            type: String as PropType<string | null>,
            default: null
        },

        isNewMessageShown: {
            type: Boolean,
            default: false
        },

        /**
         * Whether New message is out of reach, drawn as it always is, because chat has not signed in
         * yet and a first message could only fail; the search beside it stays live.
         */
        isNewMessageInert: {
            type: Boolean,
            default: false
        },

        /** The person's campus by its name, drawn in the foot under the session's name and face. */
        personCampusName: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether online status is on, which splits the foot: the face sets the status, the rest opens Chat settings. */
        isStatusShown: {
            type: Boolean,
            default: false
        },

        /** Her status as her settings show it, which the status menu checks. */
        statusChoice: {
            type: Object as PropType<StatusChoice>,
            default: () => ({ busy_until: null, appear_offline: false })
        },

        /** Why her status cannot be set now, the banner's words while the church is read only; null while it can. */
        statusClosedReason: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether her status choice has failed to save and is being asked again, which her face's menu says. */
        isStatusRetrying: {
            type: Boolean,
            default: false
        },

        /** Whether the first load's veil is over the list: its rows are unreachable and busy until it goes. */
        isVeiled: {
            type: Boolean,
            default: false
        },

        /** Where the sidebar's first page stands; until it has arrived, no rows is not yet an empty list. */
        loadState: {
            type: String as PropType<SidebarLoadState>,
            default: "loaded"
        },

        /**
         * Whether Browse channels is open, which marks its row as the one shown in place of the
         * conversation under it, which is out of view until the directory closes.
         */
        isBrowseOpen: {
            type: Boolean,
            default: false
        },

        /**
         * Whether New message is open in the conversation's place, which presses its button and,
         * as Browse channels does, takes the current mark from the conversation out of view.
         */
        isNewMessageOpen: {
            type: Boolean,
            default: false
        },

        /**
         * Whether Activity is out of reach, drawn as it always is, because the inbox needs the
         * person's chat to be loaded; as New message is while chat signs in.
         */
        isActivityInert: {
            type: Boolean,
            default: false
        },

        /** Whether the Activity inbox is open, which its button shows as expanded. */
        isActivityOpen: {
            type: Boolean,
            default: false
        },

        /** Whether a mention, by name or with @all, is newer than the person's last look at Activity. */
        hasMentionDot: {
            type: Boolean,
            default: false
        },

        /** Whether the sidebar is laid over the conversation in a narrow window, which its head offers to put away. */
        isOver: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "select", channelId: string): void,
        (e: "newMessage"): void,
        (e: "browse"): void,
        /** The foot was pressed: Chat settings. */
        (e: "settings"): void,
        /** A choice in the foot's status menu, for the block to save. */
        (e: "status", choice: StatusChoice): void,
        /** Try again on a first sidebar that failed. */
        (e: "retry"): void,
        /** Activity was pressed: Mentions and the Threads the person follows. */
        (e: "activity"): void,
        /** The sidebar laid over the conversation was asked to go back out of the way. */
        (e: "hide"): void
    }>();

    // #region Values

    // Whether the block is drawn one pane at a time, as on a phone; and the signed-in person, whose
    // own status the foot's face draws.
    const { isPhone, me } = useChatSession();

    /** What "Find a conversation" holds. */
    const query = ref("");

    /** The name line's width in each loading row, varied so the rows read as a list. */
    const channelSkeletonWidths = [52, 38, 60, 44];
    const personSkeletonWidths = [58, 44, 66, 50];

    const listElement = ref<HTMLElement>();

    /** Whether rows have scrolled under the head, which then rules itself off. */
    const isScrolled = ref(false);

    // One tooltip for the rows, anchored to the name the pointer or keyboard is on, shown only
    // where the column cut that name short.
    const nameAnchor = ref<HTMLElement>();
    const nameTipText = ref("");
    const nameTip = useTooltip(nameAnchor, () => !isCutShort(nameAnchor.value));
    const { tipElement: nameTipElement, isTipShown: isNameTipShown } = nameTip;

    /** The chat's root, which the tip is drawn in; null where the sidebar is drawn alone. */
    const tipHost = ref<HTMLElement | null>(null);

    /** A muted room's mark, the glyph Off is drawn with everywhere. */
    const mutedIcon = notifyIconFor("silent");

    // Every two-person row's other person, after the open conversation and any card, and before a panel's or a search's people, since these stay on screen.
    const statusOf = useFaceStatus(() => props.rows.filter(row => row.room_kind === "person").map(otherAliasOf).filter(alias => alias !== ""), 2);

    // #endregion Values

    // #region Computed Values

    /**
     * The rooms by section, filtered by the search over the names they are drawn under. Starred
     * shows only while it holds a room; a channel the person has not joined follows the ones they
     * have, as the design lists a pinned room after the person's own.
     */
    const sections = computed((): SidebarSection[] => {
        const needle = query.value.trim().toLowerCase();
        const shown = needle ? props.rows.filter(row => row.title.toLowerCase().includes(needle)) : props.rows;
        const channels = shown.filter(row => !row.is_favorite && row.room_kind === "channel");

        const list: SidebarSection[] = [];
        const starred = shown.filter(row => row.is_favorite);
        if (starred.length > 0) {
            list.push({ key: "starred", title: "Starred", rows: starred });
        }

        // Channels stays under a search, holding Browse channels as the way to one not listed;
        // Direct messages goes when the search leaves it nothing.
        list.push({ key: "channels", title: "Channels", rows: [...channels.filter(row => row.is_member), ...channels.filter(row => !row.is_member)] });
        const dms = shown.filter(row => !row.is_favorite && row.room_kind !== "channel");
        if (!needle || dms.length > 0) {
            list.push({ key: "dms", title: "Direct messages", rows: dms });
        }

        return list;
    });

    /** A search that matches nothing, which says so rather than leaving bare headings. */
    const isNoResults = computed((): boolean => query.value.trim() !== "" && sections.value.every(section => section.rows.length === 0));

    // #endregion Computed Values

    // #region Event Handlers

    function onListScroll(): void {
        isScrolled.value = (listElement.value?.scrollTop ?? 0) > 0;
    }

    /** The pointer rests on a row: its name is the tip's anchor, shown whole if the column cut it. */
    function onRowEnter(event: MouseEvent, row: SidebarRow): void {
        anchorNameTip(event.currentTarget, row);
        nameTip.onPointerEnter();
    }

    function onRowFocus(event: FocusEvent, row: SidebarRow): void {
        anchorNameTip(event.currentTarget, row);
        nameTip.onFocus();
    }

    // #endregion Event Handlers

    // #region Functions

    /** Anchors the rows' one tip to a row's name, with the name's whole words. */
    function anchorNameTip(target: EventTarget | null, row: SidebarRow): void {
        nameAnchor.value = target instanceof HTMLElement ? target.querySelector<HTMLElement>(".chat-row-name") ?? undefined : undefined;
        nameTipText.value = row.title;
    }

    /** A channel's row is Community's one dense line; a direct message's is Conversational's two lines. */
    function lookOf(row: SidebarRow): FeedLayout {
        return row.room_kind === "channel" ? "community" : "conversational";
    }

    /** A two-person conversation's other person, by primary alias; empty for a row that names none. */
    function otherAliasOf(row: SidebarRow): string {
        return rowPeople(row)[0]?.person_alias_guid ?? "";
    }

    /** What a two-person row's face draws of its other person's status. */
    function rowStatus(row: SidebarRow): FaceStatus | null {
        const alias = otherAliasOf(row);
        return alias ? statusOf(alias) : null;
    }

    /** A two-person conversation's face: the other person, or initials from its title without them. */
    function personFaceOf(row: SidebarRow): AvatarPerson {
        const people = rowPeople(row);
        return people.length > 0 ? personFace(people[0]) : { name: row.title, photoUrl: null };
    }

    function isActive(row: SidebarRow): boolean {
        return row.channel_id === props.activeChannelId;
    }

    /**
     * The room on screen is being read, so it never shows as unread; nor does a room the person
     * has not joined, which has no reading of theirs to be behind.
     */
    function isUnread(row: SidebarRow): boolean {
        return row.is_unread && row.is_member && !isActive(row);
    }

    function isMuted(row: SidebarRow): boolean {
        return row.notify_mode === "silent";
    }

    /**
     * The mentions a row counts. Only a channel counts them: a direct message is addressed to the
     * person, so its bold and its dot already say it. An @all names the reader as surely as their
     * name does, so the badge counts both; the app's icon counts by name alone.
     */
    function mentionsOf(row: SidebarRow): number {
        return row.room_kind !== "channel" || isActive(row) ? 0 : row.mention_count + row.all_mention_count;
    }

    /** The dot marks an unread direct message only; an unread channel is bold alone. */
    function isDotShown(row: SidebarRow): boolean {
        return row.room_kind !== "channel" && isUnread(row) && !isMuted(row);
    }

    function rowClasses(row: SidebarRow): Record<string, boolean> {
        return {
            "is-cs": lookOf(row) === "community",
            "is-unread": isUnread(row),
            "is-muted": isMuted(row),
            "is-mention": mentionsOf(row) > 0,
            "is-out": !row.is_member
        };
    }

    /** Today's last message by its time, an older one by its day. */
    function timeOf(row: SidebarRow): string {
        if (!row.last_message_at) {
            return "";
        }

        const at = new Date(row.last_message_at);
        const day = dayLabel(at, new Date());
        return day === "Today" ? timeLabel(at) : day;
    }

    /** What a screen reader hears after the room's name, for the marks it cannot see. */
    function labelSuffixOf(row: SidebarRow): string {
        const mentions = mentionsOf(row);
        const parts = [
            row.is_member ? "" : "not joined",
            // The lock beside a channel's name is a hidden icon, so a private channel says so here; a direct message is private by nature.
            lookOf(row) === "community" && !row.is_public ? "private" : "",
            mentions > 0 ? `${mentions} mention${mentions === 1 ? "" : "s"}` : "",
            isUnread(row) ? "unread" : "",
            isMuted(row) ? "muted" : ""
        ].filter(part => part !== "");

        return parts.map(part => `, ${part}`).join("");
    }

    // #endregion Functions

    // #region Watchers

    // #endregion Watchers

    onMounted(() => {
        tipHost.value = overlayHostOf(listElement.value);
    });
</script>
