<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="chat-side" :class="{ 'is-phone': isPhone }" data-testid="channel-sidebar">
        <!-- One row to find a conversation or start one; the page above already names the church. -->
        <div class="chat-side-top" data-testid="sidebar-top">
            <label class="chat-side-search chat-field">
                <Icon name="search" size="sm" />
                <input v-model="query"
                       class="chat-field-input"
                       type="text"
                       placeholder="Search"
                       aria-label="Find a conversation"
                       autocomplete="off"
                       data-testid="sidebar-search" />
            </label>
            <IconButton v-if="isNewMessageShown"
                        class="chat-side-new"
                        icon="compose"
                        label="New message"
                        data-testid="new-message"
                        :aria-pressed="isNewMessageOpen ? 'true' : 'false'"
                        @click="emit('newMessage')" />
        </div>

        <nav class="chat-side-list" aria-label="Conversations" :aria-busy="loadState === 'loading' ? 'true' : undefined">
            <!--
                Still loading, not empty: rows of a conversation's size, so nothing jumps when they
                land. Read from the load alone, as a previewed room may hold a row before the rest.
            -->
            <div v-if="loadState === 'loading'">
                <span class="chat-sr-only">Loading conversations</span>
                <div v-for="width in skeletonWidths" :key="width" class="chat-side-skel" aria-hidden="true" data-testid="sidebar-skeleton">
                    <i class="chat-skeleton chat-side-skel-c"></i>
                    <span class="chat-side-skel-l"><i class="chat-skeleton" :style="{ width: `${width}%` }"></i><i class="chat-skeleton"></i></span>
                </div>
            </div>

            <div v-else-if="loadState === 'failed'" class="chat-ls-err" role="status" data-testid="sidebar-error">
                <Icon name="alert" size="sm" />
                <span>Couldn't load your conversations.</span>
                <button type="button" class="chat-ls-btn" @click="emit('retry')">Try again</button>
            </div>

            <div v-else-if="rows.length === 0" class="chat-side-empty" data-testid="sidebar-empty">
                <span class="chat-side-empty-glyph" aria-hidden="true"><Icon name="message" /></span>
                <b>No conversations yet</b>
                <span>Message someone from your groups, or browse channels to join.</span>
                <div class="chat-side-empty-actions">
                    <button v-if="isNewMessageShown" type="button" class="chat-side-empty-btn is-solid" data-testid="empty-new-message" @click="emit('newMessage')">
                        <Icon name="compose" size="sm" />New message
                    </button>
                    <!-- With no New message beside it, this is the one way in, so it is the solid one. -->
                    <button type="button" class="chat-side-empty-btn" :class="isNewMessageShown ? 'is-link' : 'is-solid'" data-testid="empty-browse" @click="emit('browse')">Browse channels</button>
                </div>
            </div>

            <template v-else>
                <div v-for="section in sections"
                     :key="section.key"
                     data-testid="sidebar-section"
                     :data-section="section.key">
                    <div class="chat-sec">
                        <h3 data-testid="section-heading">{{ section.title }}</h3>
                        <IconButton v-if="section.key === 'channels'"
                                    class="chat-sec-btn"
                                    icon="plus"
                                    iconSize="sm"
                                    label="Browse channels"
                                    data-testid="section-browse"
                                    @click="emit('browse')" />
                        <IconButton v-if="section.key === 'dms' && isNewMessageShown"
                                    class="chat-sec-btn"
                                    icon="plus"
                                    iconSize="sm"
                                    label="New message"
                                    data-testid="section-new-message"
                                    @click="emit('newMessage')" />
                    </div>

                    <button v-for="row in section.rows"
                            :key="row.channel_id"
                            type="button"
                            class="chat-row"
                            :class="rowClasses(row)"
                            data-testid="channel-row"
                            :data-channel-id="row.channel_id"
                            :data-layout="lookOf(row)"
                            :data-unread="isUnread(row) ? 'true' : 'false'"
                            :data-muted="isMuted(row) ? 'true' : 'false'"
                            :data-mentioned="mentionsOf(row) > 0 ? 'true' : 'false'"
                            :aria-current="isActive(row) && !isBrowseOpen && !isNewMessageOpen ? 'true' : undefined"
                            @click="emit('select', row.channel_id)"
                            @animationend.self="onFlashEnd(row.channel_id)">
                        <!-- A channel: one dense line, its icon, its name, and bold when unread. -->
                        <template v-if="lookOf(row) === 'community'">
                            <span class="chat-row-face" aria-hidden="true">
                                <ChannelMark class="chat-ch-tile" :isPublic="row.is_public" :imageUrl="row.icon_url" :tileName="row.title" />
                            </span>
                            <span class="chat-row-title">
                                <span class="chat-row-name" data-testid="row-name">{{ row.title }}</span>
                                <Icon v-if="!row.is_public" name="lock" class="chat-row-lock" data-testid="row-lock" />
                                <Icon v-if="isMuted(row)" :name="mutedIcon" class="chat-row-mute" data-testid="row-muted-icon" />
                            </span>
                        </template>

                        <!-- A direct message: the face, the name and time over the preview and the end mark. -->
                        <template v-else>
                            <span class="chat-row-face" aria-hidden="true">
                                <Avatar v-if="row.room_kind === 'person'" :people="[personFaceOf(row)]" :size="36" />
                                <GroupFace v-else :people="rowPeople(row).map(personFace)" :count="row.dm_other_count" />
                            </span>
                            <span class="chat-row-main">
                                <span class="chat-row-top">
                                    <span class="chat-row-name" data-testid="row-name">{{ row.title }}</span>
                                    <Icon v-if="isMuted(row)" :name="mutedIcon" class="chat-row-mute" data-testid="row-muted-icon" />
                                    <span class="chat-row-time" data-testid="row-time">{{ timeOf(row) }}</span>
                                </span>
                                <span class="chat-row-sub">
                                    <span class="chat-row-prev" data-testid="row-preview">{{ row.preview_line }}</span>
                                    <span class="chat-row-end">
                                        <span v-if="mentionsOf(row) > 0" class="chat-badge" :class="{ 'is-quiet': isMuted(row) }" data-testid="row-mention-badge" aria-hidden="true">
                                            <Icon name="at" /><span>{{ countText(mentionsOf(row)) }}</span>
                                        </span>
                                        <span v-else-if="isDotShown(row)" class="chat-dot" data-testid="row-dot" aria-hidden="true"></span>
                                    </span>
                                </span>
                            </span>
                        </template>

                        <span v-if="lookOf(row) === 'community'" class="chat-row-end">
                            <span v-if="mentionsOf(row) > 0" class="chat-badge" :class="{ 'is-quiet': isMuted(row) }" data-testid="row-mention-badge" aria-hidden="true">
                                <Icon name="at" /><span>{{ countText(mentionsOf(row)) }}</span>
                            </span>
                            <span v-else-if="isDotShown(row)" class="chat-dot" data-testid="row-dot" aria-hidden="true"></span>
                        </span>

                        <span class="chat-sr-only" data-testid="row-label-suffix">{{ labelSuffixOf(row) }}</span>
                    </button>

                    <!-- After every channel, a room only previewed included: the way to the ones not listed. -->
                    <button v-if="section.key === 'channels'"
                            type="button"
                            class="chat-row is-cs is-browse"
                            data-testid="sidebar-browse"
                            data-layout="community"
                            :aria-current="isBrowseOpen ? 'true' : undefined"
                            @click="emit('browse')">
                        <span class="chat-row-face" aria-hidden="true">
                            <span class="chat-ch-tile is-browse"><Icon name="search" size="sm" /></span>
                        </span>
                        <span class="chat-row-title"><span class="chat-row-name">Browse channels</span></span>
                    </button>
                </div>
            </template>
        </nav>

        <!-- Who the person is, and their settings. -->
        <div class="chat-side-me">
            <button type="button"
                    class="chat-me-btn"
                    aria-haspopup="dialog"
                    :aria-label="`Chat settings, ${personName}`"
                    data-testid="sidebar-me"
                    @click="emit('settings')">
                <Avatar :people="[{ name: personName, photoUrl: personPhotoUrl }]" :size="36" />
                <span class="chat-me-who">
                    <b data-testid="sidebar-me-name">{{ personName }}</b>
                    <span v-if="personCampusName" data-testid="sidebar-me-campus">{{ personCampusName }}</span>
                </span>
                <span class="chat-me-gear" aria-hidden="true"><Icon name="settings" /></span>
            </button>
        </div>
    </div>
</template>

<style scoped>
