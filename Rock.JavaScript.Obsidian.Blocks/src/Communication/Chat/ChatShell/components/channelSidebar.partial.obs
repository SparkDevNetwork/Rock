*/
.chat-row {
    /*
        The row's fill, set by its state alone: a group's mark rings its faces in the same fill over
        the sidebar, so the ring always matches what is behind it.
    */
    --chat-row-fill: transparent;
    --chat-av-ring: var(--chat-sidebar);
    --chat-av-ring-over: var(--chat-row-fill);

    position: relative;
