}

.chat-row.is-muted .chat-row-name,
.chat-row.is-muted .chat-row-prev {
    color: var(--chat-muted);
}

/* A muted room that is unread still reads bold, its name and preview kept muted. */
.chat-row.is-unread .chat-row-name {
    font-weight: 700;
}

.chat-row.is-unread:not(.is-muted) .chat-row-name {
    color: var(--chat-text);
}

.chat-row.is-unread:not(.is-muted) .chat-row-prev {
    color: var(--chat-text-2);
}

.chat-row.is-mention .chat-row-time {
    font-weight: 600;
    color: var(--chat-brand-ink);
}

/*
    A room that arrives or moves up glows once in the church color and fades. The glow is the row's
    fill, so a group's ring glows with it; registered as a color so it fades, and where a browser
    cannot register it the glow steps off at the end instead.
*/
@property --chat-row-fill {
    syntax: "<color>";
    inherits: false;
    initial-value: transparent;
}

.chat-row.is-flash {
    animation: chat-row-flash var(--chat-d-row-flash) var(--chat-ease-state);
}

@keyframes chat-row-flash {
    0% {
        --chat-row-fill: var(--chat-flash);
    }

    100% {
        --chat-row-fill: transparent;
    }
}

.is-phone .chat-row {
    height: 56px;
}

/* A channel's room: one line, 44px (48px on a phone), a 32px tile in the face column. */
.chat-row.is-cs {
    height: 44px;
}

.is-phone .chat-row.is-cs {
    height: 48px;
}

/*
    The tile is the channel's image, or its first letter on its own color, in a square a little
    tighter than a face's circle. The room's state never changes its color.
*/
.chat-ch-tile {
