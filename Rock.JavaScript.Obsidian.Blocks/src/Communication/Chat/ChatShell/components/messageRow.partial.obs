<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div :ref="setRowElement"
         class="chat-msg"
         :class="rootClasses"
         :role="state === 'system' ? 'note' : 'article'"
         :aria-label="ariaLabel"
         :aria-haspopup="isSheetSurface ? 'dialog' : undefined"
         v-bind="listAttrs"
         :data-testid="pending ? 'pending-row' : 'message-row'"
         :data-status="pending ? pending.status : undefined"
         :data-state="state"
         :data-blocked-ids="state === 'blocked' ? blockedIds : undefined"
         :data-position="position"
         :data-message-id="message?.id"
         :data-hot-id="isBarOffered ? message?.id : undefined"
         @keydown.enter="onRowEnter"
         @dragstart="onDragStart"
         @animationend="onAnimationEnd">

        <!-- A system line: quiet, unattributed, centred in bubbles and in the text column in Community. -->
        <template v-if="state === 'system'">
            <span class="chat-sys-icon" aria-hidden="true"><Icon :name="systemIcon" :size="layout === 'community' ? 'sm' : 'xs'" /></span>
            <span class="chat-sys-text">
                <MessageBody :text="text" :pieces="pieces" :isConversation="!isChannel" isInline />
                <span v-if="layout === 'community'" class="chat-sys-time">{{ time }}</span>
            </span>
        </template>

        <!-- Someone the reader blocked: one quiet line for the message or a run of them, a thread under it still opened from there. -->
        <template v-else-if="state === 'blocked'">
            <span class="chat-sys-icon" aria-hidden="true"><Icon name="ban" :size="layout === 'community' ? 'sm' : 'xs'" /></span>
            <span class="chat-sys-text">
                <span data-testid="blocked-text">{{ blockedText }}</span>
                <span v-if="layout === 'community'" class="chat-sys-time">{{ time }}</span>
            </span>
            <div v-if="hasThread && message" class="chat-blocked-thread">
                <ThreadSummary :message="message" :isRowOnScreen="isThreadStartedHere" @open="onOpenOwnThread" />
            </div>
        </template>

        <!-- Community: flat rows, a head with the name on every group, the rest in the gutter's time. -->
        <MessageRowCommunity v-else-if="layout === 'community'" :view="view" :on="on" :isPersonLeader="isPersonLeader" />

        <!-- Conversational: bubbles, the name over another person's group, their face at its last. -->
        <MessageRowBubble v-else :view="view" :on="on" :isDirectMessage="isDirectMessage" :position="position" :isTypingNext="isTypingNext" :groupKey="groupKey" />

        <!--
            A touch screen's actions, from a long press on the message: the bar's and the menu's
            choices as a sheet over the whole chat. A touch screen has no hover bar, so the sheet
            carries the quick reactions, first, at a finger's size. A hold's open lands focus on
            their row, so none is ringed as if chosen; a keyboard's starts on the first. Focus comes
            back to the message on close, never to what held it before, the composer above all,
            which would raise a phone's keyboard again.
        -->
        <Sheet v-if="isSheetSurface" ref="sheet" :isOpen="isSheetOpen && !!message" label="Message actions" isFocusReturnedByOwner @dismiss="onSheetClose">
            <div class="chat-sheet-react"
                 role="group"
                 aria-label="Quick reactions"
                 tabindex="-1"
                 :data-autofocus="isSheetFromKeyboard ? undefined : ''"
                 data-testid="action-sheet-reactions">
                <button v-for="favorite in quickReactions"
                        :key="favorite.code"
                        type="button"
                        :aria-pressed="isMine(favorite.code) ? 'true' : 'false'"
                        :aria-label="`${isMine(favorite.code) ? 'Remove your' : 'React with'} ${favorite.label}`"
                        @click="onSheetReact(favorite.code)">
                    <img v-if="!favorite.emoji && favorite.image_url" class="chat-sheet-glyph" :src="favorite.image_url" alt="" />
                    <span v-else class="chat-sheet-glyph" aria-hidden="true">{{ favorite.emoji }}</span>
                </button>
                <button type="button" class="is-more" aria-label="More reactions" aria-haspopup="dialog" @click="onSheetMoreReactions">
                    <Icon name="plus" />
                </button>
            </div>
            <button v-for="item in sheetItems"
                    :key="item.key"
                    type="button"
                    class="chat-sheet-item"
                    :class="{ 'is-danger': item.isDanger }"
                    @click="chooseSheetItem(item.key)">
                <Icon :name="item.icon" />
                <span class="chat-sheet-label">{{ item.label }}</span>
            </button>
        </Sheet>
    </div>
</template>

<style scoped>
/* Every row. Arrival, the edit crossfade and the jump flash are the row's own motion. */
.chat-msg {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: var(--chat-r-control);
}

/*
    A row takes focus when a jump lands on it. A channel's row rings the whole row, inside its
    edge and rounded, over the hover tint it also takes; a direct message's rings what the person
    reads, the bubble, or a system line or card that has none. The ring is the chat's focus
    outline, written as the sheet writes it: the oldest Safari Rock supports has no :focus-visible
    and drops any rule naming it, so every focus rings, and a browser that can tell a click's focus
    apart takes the ring back from the click's.
*/
.chat-msg:focus {
    outline: none;
}

.chat-msg.is-conversational.is-system:focus-visible {
    outline: var(--chat-focus-ring);
    outline-offset: 2px;
}

.chat-msg.is-conversational.is-system:focus {
    outline: var(--chat-focus-ring);
    outline-offset: 2px;
}

@supports selector(:focus-visible) {
    .chat-msg.is-conversational.is-system:focus:not(:focus-visible) {
        outline: none;
    }

    /* A click's focus keeps the corners the row has at rest: square, or a washed row's own. */
    .chat-msg.is-community:focus:not(:focus-visible) {
        outline: none;
        border-radius: 0;
    }

    .chat-msg.is-community.is-mention-me:focus:not(:focus-visible) {
        border-radius: var(--chat-r-row);
    }
}

/*
    A message jumped to flashes the mention wash's own shape, stood in from the feed's edges and
    rounded, at the flash's strength: held for most of its length and then let go back to whatever
    the row is at rest, so a mention and a jump read as one idea. It is drawn under the words, the
    row holding its own layers only while it flashes; a bubble flashes behind itself, in its own
    sheet. Reduced motion keeps it, being a fade only. A mention of the reader heard arriving live
    greets them with the same flash, once, at its own shorter length.
*/
.chat-msg.is-community.is-greeting,
.chat-msg.is-community.is-flashing {
    isolation: isolate;
}

.chat-msg.is-community.is-greeting::before,
.chat-msg.is-community.is-flashing::before {
    position: absolute;
    inset: 1px var(--chat-cm-inset);
    z-index: -1;
    pointer-events: none;
    content: "";
    background: var(--chat-flash);
    border-radius: var(--chat-r-row);
    animation: chat-flash var(--chat-d-flash) var(--chat-ease-state) forwards;
}

.chat-msg.is-community.is-greeting::before {
    animation: chat-flash var(--chat-d-greet) var(--chat-ease-state) forwards;
}

/* A washed row already stands in by the inset, so its flash fills it; a greeting is always on one. */
.chat-msg.is-community.is-greeting::before,
.chat-msg.is-community.is-mention-me.is-flashing::before {
    inset: 0;
}

/*
    A finger held on a message: the press fill on the row's own layer, stood in from the feed's edges
    with the same space above and below, as the flash is, which it takes over while held, written
    after the flash and the greeting so it wins over both. Shown at once, with no fade, so reduced
    motion draws it the same.
*/
.chat-msg.is-pressing {
    isolation: isolate;
}

.chat-msg.is-pressing::before,
.chat-msg.is-community.is-pressing::before {
    position: absolute;
    inset: 1px var(--chat-cm-inset, 4px);
    z-index: -1;
    pointer-events: none;
    content: "";
    background: var(--chat-press);
    border-radius: var(--chat-r-row);
    animation: none;
}

/*
    A long press on a touch screen is the message's own, so the phone's callout and its text
    selection stay off the message, and the row cancels a drag lift itself (onDragStart); Copy text
    covers copying. An open editor keeps them, being where the person types.
*/
.chat-msg.is-touch:not(.is-editing) {
    -webkit-touch-callout: none;
    user-select: none;
}

/* Conversational. */
.chat-msg.is-conversational {
    align-items: flex-start;
}

.chat-msg.is-conversational.is-own {
    align-items: flex-end;
}

/*
    A message's files stand 12px before the next message of the run, the group's own gap included
    where the feed sets one, so a caption always reads with the files under it, not the next words.
*/
.chat-msg.is-conversational.has-files + .chat-msg {
    margin-top: calc(12px - var(--chat-grp-gap, 0px));
}

/*
    Community. The gutter, its gap to the text and the row's side padding are one set, shared with
    the system line, and narrower on a phone so the text keeps its width. The side padding is the
    column's to say, since a narrower column such as the thread drawer pads its rows less.
*/
.chat-msg.is-community {
    --chat-cm-gut: 36px;
    --chat-cm-gap: 12px;
    --chat-cm-pad: var(--chat-cm-column-pad, 20px);
    display: grid;
    grid-template-columns: var(--chat-cm-gut) minmax(0, 1fr);
    align-items: start;
    column-gap: var(--chat-cm-gap);
    /* The same above and below on every row, a head too; the space between people is a margin over a head row. */
    padding: var(--chat-cm-row-pad) var(--chat-cm-pad);
    border-radius: 0;
    /* How far a washed row stands in from the feed's edges. */
    --chat-cm-inset: 8px;
}

.chat-msg.is-community.is-phone {
    --chat-cm-gut: 32px;
    --chat-cm-gap: 10px;
    --chat-cm-pad: 12px;
    --chat-cm-inset: 4px;
}

/* A new person's turn: the space between people stands over the head row, outside it, where no highlight reaches. */
.chat-msg.is-community.is-head {
    margin-top: var(--chat-cm-person-gap);
}

/* The ring sits inside the row, which runs edge to edge, so the scroller does not clip it. */
.chat-msg.is-community:focus-visible {
    outline: var(--chat-focus-ring);
    outline-offset: -2px;
    border-radius: var(--chat-r-control);
}

.chat-msg.is-community:focus {
    outline: var(--chat-focus-ring);
    outline-offset: -2px;
    border-radius: var(--chat-r-control);
}

/*
    Tinted while the column's bar is on the row, not under any pointer, so one message is lit at a
    time; on a pointer screen also while focus is inside it, an open editor above all, which has no
    bar. A touch screen's tap focuses what it lands on, so there a focus inside lights nothing.
*/
.chat-msg.is-community.is-hot,
.chat-msg.is-community:not(.is-touch):focus-within {
    background-image: linear-gradient(var(--chat-hover), var(--chat-hover));
}

.is-community.is-announcement {
    background-color: var(--chat-row-announcement);
    box-shadow: inset 2px 0 0 var(--chat-brand);
}

/*
    A row that reaches the reader: a soft rounded wash stood in from the feed's edges, as a hover is,
    rather than a full-width tint with an edge, which read as a warning and ran together when
    several rows in a row named the reader. The inset comes out of the side padding, so the text
    keeps its column. Above and below, a clear 1px edge comes out of the padding and the wash is
    drawn inside it: the rows sit in a flex group, where a margin never collapses and would make
    the row taller, and the edge still parts two washed rows. Hover and focus lay over it as over
    any row.
*/
.chat-msg.is-community.is-mention-me {
    /* An @all chip that reached the reader rings itself in the church's line, standing off the wash, as the reader's own chip always does. */
    --chat-mn-ring: inset 0 0 0 1px var(--chat-mention-ring);
    margin-inline: var(--chat-cm-inset);
    padding-block: calc(var(--chat-cm-row-pad) - 1px);
    padding-inline: calc(var(--chat-cm-pad) - var(--chat-cm-inset));
    background-color: var(--chat-row-mention);
    background-clip: padding-box;
    border-block: 1px solid transparent;
    border-radius: var(--chat-r-row);
}

/* A system line. */
.chat-msg.is-system {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 10px 24px;
    font-size: var(--chat-fs-ui);
    color: var(--chat-muted);
    text-align: center;
}

/*
    A message by someone the reader blocked draws as a system line does, quiet and with no one's
    name, so it never draws the eye; a thread under it wraps onto its own line, where the row
    places the pill and the pill keeps its own width, as it does under any root.
*/
.chat-msg.is-blocked {
    flex-flow: row wrap;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 6px 24px;
    font-size: var(--chat-fs-ui);
    color: var(--chat-muted);
    text-align: center;
}

.chat-msg.is-blocked .chat-blocked-thread {
    display: flex;
    flex-basis: 100%;
    justify-content: center;
}

.chat-msg.is-community.is-blocked {
    display: grid;
    align-items: flex-start;
    justify-content: stretch;
    gap: 0 var(--chat-cm-gap);
    margin: 2px 0 0;
    padding: 3px var(--chat-cm-pad);
    font-size: var(--chat-fs-ui);
    line-height: 20px;
    text-align: left;
}

.chat-msg.is-community.is-blocked .chat-blocked-thread {
    grid-column: 2;
    justify-content: flex-start;
}

/* In Community it sits on the text column, its icon in the gutter, a little roomier than a row. */
.chat-msg.is-community.is-system {
    align-items: flex-start;
    justify-content: stretch;
    gap: 0 var(--chat-cm-gap);
    margin: 6px 0 0;
    padding: 3px var(--chat-cm-pad);
    font-size: var(--chat-fs-ui);
    line-height: 20px;
    text-align: left;
}

.chat-sys-icon {
    display: flex;
    color: var(--chat-icon);
}

/* As tall as the text's line, so a line that wraps keeps its icon beside the first line. */
.is-community .chat-sys-icon {
    align-items: center;
    justify-content: center;
    height: 20px;
}

/*
    The sheet's six reactions spread across it as 44px rounded squares, over a rule that sets them
    apart from its items. Their row is only where a tap's open lands focus, never a control, so it
    draws no ring.
*/
.chat-sheet-react {
    display: flex;
    gap: 4px;
    justify-content: space-between;
    padding: 0 2px 10px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--chat-line);
}

.chat-sheet-react:focus {
    outline: none;
}

.chat-sheet-react button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    font-size: var(--chat-emoji-tray);
    line-height: 1;
    background: var(--chat-sidebar);
    border: 0;
    border-radius: var(--chat-r-surface);
}

.chat-sheet-react button[aria-pressed="true"] {
    background: var(--chat-brand-tint);
    box-shadow: inset 0 0 0 1.5px var(--chat-reaction-mine-line);
}

.chat-sheet-react button.is-more {
    color: var(--chat-icon);
}

/* A church's image emoji is held to the glyph's box. */
img.chat-sheet-glyph {
    width: 24px;
    height: 24px;
    object-fit: contain;
}

/* Kept whole, so a wrap never leaves "AM" alone on a line. */
.chat-sys-time {
    margin-left: 8px;
    white-space: nowrap;
    font-size: var(--chat-fs-small);
    font-variant-numeric: tabular-nums;
}
</style>

<script setup lang="ts">
    import { computed, inject, PropType, proxyRefs, ref, toRaw, toRef, watch } from "vue";
    import MessageBody from "./messageBody.partial.obs";
    import MessageRowBubble from "./messageRowBubble.partial.obs";
    import MessageRowCommunity from "./messageRowCommunity.partial.obs";
    import ThreadSummary from "./threadSummary.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import Sheet from "../ui/sheet.partial.obs";
    import { isHoverless } from "../ui/viewport.partial";
    import { MessageRowHandlers, MessageRowReactionsProps, MessageRowSurface, MessageRowView, useMessageRowView } from "../composables/useMessageRowView.partial";
    import { ActionBarDock, useColumnActionBar } from "../composables/useActionBar.partial";
    import { attachmentViewsKey } from "../composables/useAttachments.partial";
    import { ListItemAttrs, useRowKeys } from "../composables/useListKeys.partial";
    import { useLongPress } from "../composables/useLongPress.partial";
    import { isEditableMessage, isSenderBlockable, MessageActionRequest, messageRowRequests } from "../composables/useMessageActions.partial";
    import { ThreadPlace, threadPlaceOf } from "../composables/useThreads.partial";
    import { ReactionHost } from "../composables/useReactions.partial";
    import { blockedRunText, FeedLayout, RowPosition } from "../feedLayout.partial";
    import { rowKey, sendKey } from "../heldMessage.partial";
    import { useRowMotion } from "../messageMotion.partial";
    import { useChatSession } from "../chatSession.partial";
    import { ChatError, PendingMessage, ReactionFavorite, ReactorsCursor, ReactorsPage, SystemKind, TimelineMessage } from "../types.partial";

    // #region Types

    /** One of the phone sheet's items: a known action by its name, a server's by its place in the list. */
    type SheetItem = { key: string, label: string, icon: string, isDanger?: boolean };

    // #endregion Types

    const props = defineProps({
        /** The stored message, or null for a send that is not stored yet. */
        message: {
            type: Object as PropType<TimelineMessage | null>,
            default: null
        },

        /** The person's own send that is not stored yet, or null for a stored message. */
        pending: {
            type: Object as PropType<PendingMessage | null>,
            default: null
        },

        isOwn: {
            type: Boolean,
            default: false
        },

        /** Whether the reader leads this conversation, for the Leader pill on their own messages. */
        isPersonLeader: {
            type: Boolean,
            default: false
        },

        /** A channel's message is a flat Community row; a direct message's is a Conversational bubble. */
        isChannel: {
            type: Boolean,
            default: false
        },

        /** The row's place in its group. */
        position: {
            type: String as PropType<RowPosition>,
            default: "single"
        },

        /** The group's sender is typing her next row after this one, so the group's time stays under this row. */
        isTypingNext: {
            type: Boolean,
            default: false
        },

        /** The key of the row's group, which its face and name line are marked by for the view's tail. */
        groupKey: {
            type: String,
            default: ""
        },

        /** A direct message names nobody over a bubble: the header already says who it is with. */
        isDirectMessage: {
            type: Boolean,
            default: false
        },

        /** The person's own send was just confirmed, so "Sent" shows for a moment. */
        isJustSent: {
            type: Boolean,
            default: false
        },

        /** A send still going has taken long enough to say "Sending…"; before that it says nothing. */
        isSendingSlow: {
            type: Boolean,
            default: false
        },

        /** The message was jumped to, so it flashes. */
        isFlashing: {
            type: Boolean,
            default: false
        },

        /** Each person's name this client holds, by alias guid in lower case, for a pending body's mentions. */
        senderNames: {
            type: Object as PropType<ReadonlyMap<string, string>>,
            default: () => new Map<string, string>()
        },

        /**
         * Drawn in the thread drawer, where the root's thread pill and a reply's "Replied to a
         * thread" label would only open the thread already on screen.
         */
        isInThread: {
            type: Boolean,
            default: false
        },

        /** A room the person has not joined, where its messages draw no bar. */
        isPreviewing: {
            type: Boolean,
            default: false
        },

        /** The message is open in the editor, which takes its bar's place. */
        isEditing: {
            type: Boolean,
            default: false
        },

        /** The refusal the editor's last save met, shown under what the person typed. */
        editError: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** The editor's save is out, so Save is held. */
        isEditSaving: {
            type: Boolean,
            default: false
        },

        /** The favorites the bar and the sheet draw, who reacted, and the message the picker is open on. */
        reactionHost: {
            type: Object as PropType<ReactionHost | null>,
            default: null
        },

        /** The run of messages by people the reader blocked that this row stands for, oldest first; its own message alone when none is named. */
        blockedRun: {
            type: Array as PropType<TimelineMessage[] | null>,
            default: null
        },

        /**
         * The row's key in its column's list, which holds the column's one tab stop. Given by the
         * column, since a folded blocked line is keyed by its first message but handed its last.
         */
        rowKey: {
            type: String,
            default: ""
        }
    });

    const emit = defineEmits<{
        (e: "openThread", place: ThreadPlace): void,
        (e: "jump", quotedMessageId: number): void,
        (e: "messageAction", request: MessageActionRequest): void,
        /** Try this one failed send again, by its key, as the strip's Try again asks for every one. */
        (e: "retry", localIds: string[]): void,
        /** Drop this one failed send, by its key. */
        (e: "discard", localId: string): void
    }>();

    // #region Values

    /** Each kind of system line's icon in Community's gutter. */
    const systemIcons: Record<SystemKind, string> = {
        joined: "door",
        left: "door",
        added: "users",
        removed: "users",
        renamed: "pencil"
    };

    const rowElement = ref<HTMLElement>();

    /** The column's list of rows, which says whether this row holds the tab stop; null for a row drawn alone. */
    const rowKeys = useRowKeys();

    /** The link or the photo a long press was on, which the sheet then offers first. */
    const heldLink = ref<HTMLAnchorElement | null>(null);
    const heldPhotoId = ref<string | null>(null);

    /** The session's links to the message's files, which Save photo asks for a fresh one; null where none are provided. */
    const attachmentViews = inject(attachmentViewsKey, null);

    /** Where the column's one bar is drawn while it is on this message. */
    const barDock = ref<HTMLElement>();

    const columnBar = useColumnActionBar();

    /** Whether the chat is in its one-pane phone layout, as the session says. */
    const session = useChatSession();

    const isSheetOpen = ref(false);

    /** The sheet was opened from the keyboard, so its focus starts on the first reaction. */
    const isSheetFromKeyboard = ref(false);
    const sheet = ref<InstanceType<typeof Sheet>>();

    /**
     * A screen with no hover, a tablet held in the hand, has no bar to show either, so it acts from
     * the sheet as a phone does. Read once: a screen does not gain a pointer while chat is open.
     */
    const isScreenHoverless = isHoverless();


    /**
     * The row's own motion, each played only for what the stores recorded happening to its message
     * since the row mounted: an edit, a delete or a hide crossfades, a thread's first reply pops its
     * pill, the reader's own reaction pops or rolls its chip. A page, a re-read or a remount that only
     * states the message again plays none of them, whatever it changes. A folded line by people
     * blocked watches its newest message, though its view claims its arrival by all of them: the line
     * shows no words to crossfade, and a root with replies always stands as a line of its own.
     */
    const { isCrossfading, isEditedNow, isThreadStartedHere, reaction, isArrivedLive } = useRowMotion(() => props.pending ? `k:${sendKey(props.pending.localId)}` : props.message ? rowKey(props.message) : null);

    // #endregion Values

    // #region Computed Values

    /** What the message shows, worked out once and lent to the look it draws in. */
    const facts = useMessageRowView(props);
    const { state, text, pieces, isAnnouncement, isJumbo, hasThread, isHead, displayName, authorGuid, time, readerMention, isReactable } = facts;

    /**
     * A mention of the reader heard arriving live greets them with the flash, once, as the row is
     * first drawn. Read once here, so a re-render never plays it again; an announcement keeps its
     * own pill and edge. A jump that lands on the row ends it for good (the watcher below): the
     * flash takes the same layer over, and its end is the jump's.
     */
    const isGreeting = ref(isArrivedLive.value && !!readerMention.value && !isAnnouncement.value && !props.isFlashing);

    /** The look the conversation's kind picks, which the row draws in. */
    const layout = computed((): FeedLayout => props.isChannel ? "community" : "conversational");

    function onRetryFailed(): void {
        if (props.pending) {
            emit("retry", [props.pending.localId]);
        }
    }

    function onDiscardFailed(): void {
        if (props.pending) {
            emit("discard", props.pending.localId);
        }
    }

    /** What a blocked row says: the run it stands for, or its one message. */
    /** The messages a blocked line stands for: its run, or the one message. */
    const blockedMessages = computed((): TimelineMessage[] => props.blockedRun ?? (props.message ? [props.message] : []));

    const blockedText = computed((): string => blockedRunText(blockedMessages.value));

    // Every id the line stands for, so what was asked on one message folded into it finds it.
    const blockedIds = computed((): string => blockedMessages.value.map(message => message.id).join(" "));

    const ariaLabel = computed((): string => {
        if (state.value === "blocked") {
            return `${blockedText.value}, ${time.value}`;
        }
        const who = props.isOwn ? "You" : displayName.value;
        const mentions = readerMention.value ? `, mentions ${readerMention.value}` : "";
        return `${who}, ${time.value}${mentions}`;
    });

    /** Chips to draw under the message. */
    const hasReactions = computed((): boolean => isReactable.value && (props.message?.reactions?.length ?? 0) > 0);

    /**
     * A system line's icon: in Community's gutter, by the kind Rock gave the line as it posted it,
     * the info mark for a line it gave none or a kind this client does not know; in bubbles,
     * always the quiet info mark.
     */
    const systemIcon = computed((): string => {
        const kind = props.message?.system_kind;
        return layout.value === "community" && kind ? systemIcons[kind] ?? "info" : "info";
    });

    /** A stored message the person reads as it is, which an action can apply to. */
    const isActionable = computed((): boolean => state.value === "message" || state.value === "sent" || state.value === "unknown");

    /** A phone, or a screen with no hover, which acts from the sheet instead of the bar. */
    const isTouchLayout = computed((): boolean => session.isPhone.value || isScreenHoverless);

    /**
     * Whether the message can be acted on now, the one rule the bar and the sheet both follow: a
     * stored message as the person reads it, not open in the editor, in a room the person has
     * joined. A tombstone, a send on its way or failed, a system line and a block post cannot be.
     */
    const canAct = computed((): boolean => !!props.message && !props.pending && isActionable.value && !props.isPreviewing && !props.isEditing);

    /** Whether the row lends the column's bar a dock: a message that can be acted on, on a pointer screen; a phone acts from a sheet instead. */
    const isBarOffered = computed((): boolean => canAct.value && !isTouchLayout.value);

    /**
     * The row's place in its column's one tab stop: Up and Down move between every message drawn,
     * other people's too, the stop held by the one last focused. A row drawn alone is focusable
     * only, as a jump does. Focus shows the bar on a pointer screen; on a touch screen Enter opens
     * the sheet.
     */
    const listAttrs = computed((): ListItemAttrs | { tabindex: number } => rowKeys && props.rowKey ? rowKeys.itemAttrs(props.rowKey) : { tabindex: -1 });

    /**
     * Whether the column's bar is shown on this row. The row's hover tint follows it rather than the
     * pointer, so a box held open on one message leaves the message under the pointer untinted. Read
     * per message, so the bar moving wakes only the row it leaves and the row it reaches.
     */
    const isBarHere = computed((): boolean => !!columnBar && !!props.message && columnBar.isOn(props.message.id));

    /** The rows that hold a sheet at all, kept while it slides away whatever the message became. */
    const isSheetSurface = computed((): boolean => !!props.message && !props.pending && isTouchLayout.value);

    /** Whether a long press opens the sheet now: as the bar would show, never on a previewed room or an open editor. */
    const isSheetOffered = computed((): boolean => isSheetSurface.value && canAct.value);

    /** The editor takes the text's place while the message is live; a delete that lands meanwhile shows its tombstone. */
    const isEditorShown = computed((): boolean => props.isEditing && !!props.message && !props.pending && isActionable.value);

    /** The first six favorites, the quick reactions a phone's sheet has room for. */
    const quickReactions = computed((): ReactionFavorite[] => (props.reactionHost?.favorites ?? []).slice(0, 6));

    /** The bar's and the menu's choices in one list, under the sheet's row of reactions. */
    const sheetItems = computed((): SheetItem[] => {
        const message = props.message;
        const list: SheetItem[] = [];
        if (!message) {
            return list;
        }

        // What the finger was on comes first: a link's own choices, or a photo's.
        if (heldLink.value) {
            list.push({ key: "openLink", label: "Open link", icon: "right" });
            list.push({ key: "copyLink", label: "Copy link", icon: "copy" });
        }
        else if (heldPhotoId.value) {
            list.push({ key: "savePhoto", label: "Save photo", icon: "download" });
        }

        if (!props.isInThread) {
            list.push({ key: "reply", label: "Reply in thread", icon: "thread" });
        }

        list.push({ key: "quote", label: "Quote", icon: "quote" });

        if (props.isOwn && isEditableMessage(message)) {
            list.push({ key: "edit", label: "Edit message", icon: "pencil" });
        }

        list.push({ key: "copy", label: "Copy text", icon: "copy" });

        // Each by its place in the list, since an action's id is the server's and may be anything.
        (message.actions ?? []).forEach((action, index) => {
            list.push({ key: `action ${index}`, label: action.label, icon: "bolt" });
        });

        if (props.isOwn) {
            list.push({ key: "delete", label: "Delete message", icon: "trash", isDanger: true });
        }

        if (isSenderBlockable(message, props.isOwn)) {
            list.push({ key: "block", label: "Block", icon: "ban" });
        }

        return list;
    });

    /** The column bar's props on this message, the same in both looks, which place it in different spots. */
    const barProps = computed((): Record<string, unknown> => ({
        message: props.message,
        isOwn: props.isOwn,
        isInThread: props.isInThread,
        isCommunity: layout.value === "community",
        senderName: displayName.value,
        favorites: props.reactionHost?.favorites ?? []
    }));

    /**
     * The reactions row's props; a previewer sees the chips and who reacted but cannot press them,
     * a touch screen has no add chip, and no chip's card shows while the picker is open on this
     * message; asked by message, so the picker opening wakes no other row.
     */
    const reactionsProps = computed((): MessageRowReactionsProps => ({
        message: props.message as TimelineMessage,
        isPreviewing: props.isPreviewing,
        reader: session.me.value,
        listReactors,
        isCardDisabled: !!props.message && !!props.reactionHost?.pickerAnchorOf(props.message.id),
        motion: reaction.value
    }));

    const rootClasses = computed((): Record<string, boolean> => ({
        [`is-${layout.value}`]: true,
        [`is-${state.value}`]: true,
        "is-own": props.isOwn,
        "is-phone": session.isPhone.value,
        "is-touch": isTouchLayout.value,
        "is-pressing": isPressing.value,
        "is-editing": isEditorShown.value,
        "is-head": isHead.value,
        "is-announcement": isAnnouncement.value,
        "is-jumbo": isJumbo.value,
        // An announcement owns its own tint and edge; one naming the reader keeps them and the words.
        "is-mention-me": !!readerMention.value && !isAnnouncement.value,
        "is-flashing": props.isFlashing,
        "is-greeting": isGreeting.value,
        "is-hot": isBarHere.value,
        "has-thread": hasThread.value,
        "has-reactions": hasReactions.value,
        "has-files": facts.files.value.length > 0 && !isEditorShown.value
    }));

    // #endregion Computed Values

    // #region Event Handlers

    /** Asks for the author's card under the whole row, from the name or face pressed. */
    function onAuthor(event: MouseEvent): void {
        if (authorGuid.value) {
            emit("messageAction", { kind: "person", personAliasGuid: authorGuid.value, anchor: event.currentTarget as HTMLElement, place: "row" });
        }
    }

    /** Asks for the card of a person a chip in the body names, at the chip pressed. */
    function onPerson(personAliasGuid: string, anchor: HTMLElement): void {
        emit("messageAction", { kind: "person", personAliasGuid, anchor, place: "opener" });
    }

    /** The thread pill under a root and the label over a reply also sent: the thread the message belongs to. */
    function onOpenOwnThread(): void {
        if (props.message) {
            emit("openThread", threadPlaceOf(props.message));
        }
    }

    /** The bar's and the sheet's choices, the chips', the editor's and a block button's, each one request. */
    const { actions: actionHandlers, reactions: reactionsHandlers, editor: editorHandlers, runBlockAction } = messageRowRequests({
        message: () => props.message,
        request: (request: MessageActionRequest) => emit("messageAction", request),
        openThread: place => emit("openThread", place),
        pickerAnchor
    });

    /**
     * What the look draws: the facts, and what the row lends it of what can be done to the
     * message and of its own motion. Made once and never replaced, so a look draws again only
     * when a member it reads changes; each member is unwrapped one level, so the look hands its
     * children the same message, files and pieces the row holds.
     */
    const lent: ReturnType<typeof useMessageRowView> & MessageRowSurface = {
        ...facts,
        isEditorShown,
        isDockLent: canAct,
        editError: toRef(props, "editError"),
        isEditSaving: toRef(props, "isEditSaving"),
        reactionsProps,
        isCrossfading,
        isEditedNow,
        isThreadStartedHere
    };
    const view: MessageRowView = proxyRefs(lent);

    /** What the look calls, each request wired here once rather than in each look. */
    const on: MessageRowHandlers = {
        author: onAuthor,
        person: onPerson,
        openThread: onOpenOwnThread,
        retry: onRetryFailed,
        discard: onDiscardFailed,
        jump: quotedMessageId => emit("jump", quotedMessageId),
        editor: editorHandlers,
        reactions: reactionsHandlers,
        runBlockAction,
        // The look's dock arrives as it mounts and goes as it unmounts, during the patch, before
        // the watcher that lends it to the bar reads it.
        setDock: element => {
            barDock.value = element instanceof HTMLElement ? element : undefined;
        }
    };

    /** A page of who reacted to this message, asked of the reactions the shell holds. */
    function listReactors(code: string | null, after: ReactorsCursor | null): Promise<ReactorsPage | null> {
        return props.message && props.reactionHost ? props.reactionHost.listReactors(props.message.id, code, after) : Promise.resolve(null);
    }

    /**
     * Where the picker is placed. The sheet's plus closes with the sheet, so a picker asked for
     * from it is placed on the message, as the bar's own button would be: at the box's own place
     * in the row, the dock, where a touch screen that is no phone grows it beside the message. A
     * phone's picker is a sheet of its own, placed on the message.
     */
    function pickerAnchor(anchor: HTMLElement): HTMLElement {
        const row = rowElement.value;
        const isInSheet = !!sheet.value?.element?.contains(anchor);
        if (!row || (row.contains(anchor) && !isInSheet)) {
            return anchor;
        }

        return (session.isPhone.value ? null : barDock.value) ?? messageAnchor() ?? row;
    }

    /**
     * The message a picker asked for from the sheet is placed on: its bubble, or the whole row in
     * a channel, which draws no bubble, so the picker clears the name and the text.
     */
    function messageAnchor(): HTMLElement | null {
        return rowElement.value?.querySelector<HTMLElement>(".chat-bubble") ?? rowElement.value ?? null;
    }


    /** The row's element, which its column's list moves focus to as well. */
    function setRowElement(element: unknown): void {
        rowElement.value = element instanceof HTMLElement ? element : undefined;
        if (rowKeys && props.rowKey) {
            rowKeys.itemRef(props.rowKey)(element);
        }
    }

    /**
     * A long press opens the sheet on a touch screen, with what the finger was on offered first. A
     * tap does what it lands on, a link, a name, a face, a photo or a chip, and nothing on text.
     */
    function onHold(target: Element): void {
        const link = target.closest<HTMLAnchorElement>("a[href]");
        const photo = target.closest<HTMLElement>("[data-attachment-id]");
        heldLink.value = link && rowElement.value?.contains(link) ? link : null;
        heldPhotoId.value = photo && rowElement.value?.contains(photo) ? photo.dataset.attachmentId ?? null : null;
        isSheetFromKeyboard.value = false;
        isSheetOpen.value = true;
    }

    /**
     * A long press on a touch screen is the message's own, so a link or photo under the finger is
     * never lifted to be dragged away; the drag starts in the part that draws it and is cancelled
     * here, where it reaches the message. An open editor keeps its drags, being where she types.
     */
    function onDragStart(event: DragEvent): void {
        if (isTouchLayout.value && !isEditorShown.value) {
            event.preventDefault();
        }
    }

    /** Enter on the message itself opens the sheet from the keyboard; on something inside it, that thing answers. */
    function onRowEnter(event: KeyboardEvent): void {
        if (!isSheetOffered.value || event.target !== rowElement.value || event.isComposing) {
            return;
        }

        event.preventDefault();
        heldLink.value = null;
        heldPhotoId.value = null;
        isSheetFromKeyboard.value = true;
        isSheetOpen.value = true;
    }

    /**
     * Save photo follows a link to the photo signed afresh, never the one drawn, which may have
     * ended while the message sat on screen. The link names the file, since a download attribute
     * is ignored on another origin.
     */
    async function savePhoto(attachmentId: string): Promise<void> {
        const item = facts.files.value.find(file => file.id === attachmentId);
        const link = item && attachmentViews ? await attachmentViews.links.fresh(item) : null;
        if (!link?.downloadUrl) {
            return;
        }

        const anchor = document.createElement("a");
        anchor.href = link.downloadUrl;
        anchor.rel = "noopener";
        anchor.click();
    }

    /** Focus comes back to the message, unless the choice made moves it on, as a quote or an edit does. */
    function onSheetClose(): void {
        isSheetOpen.value = false;
        rowElement.value?.focus({ preventScroll: true });
    }

    /** A reaction toggles the reader's own and closes the sheet. */
    function onSheetReact(code: string): void {
        const message = props.message;
        if (message) {
            onSheetClose();
            actionHandlers.react(message, code);
        }
    }

    /**
     * The plus asks for the full picker, past its quick tray, which would only offer again the
     * quick reactions the sheet has just shown. The sheet closes under it, so the picker is placed
     * on the message rather than on this button.
     */
    function onSheetMoreReactions(event: MouseEvent): void {
        const message = props.message;
        if (message) {
            // Closed first, so the picker takes focus after the row does; the sheet is drawn until
            // the next render, so the plus is still found inside it. The message itself, not the
            // props' view of it, so the host finds the very message it holds.
            const anchor = event.currentTarget as HTMLElement;
            onSheetClose();
            actionHandlers.openPicker(toRaw(message), anchor, { startsOn: "full" });
        }
    }

    /** Runs an item as the bar would and closes the sheet; its handler moves focus where it leads. */
    function chooseSheetItem(key: string): void {
        const message = props.message;
        if (!message) {
            return;
        }

        // Read before the sheet closes; the sheet keeps them as it slides away.
        const link = heldLink.value;
        const photoId = heldPhotoId.value;
        onSheetClose();
        if (key === "openLink") {
            // The anchor's own click, exactly as a tap on it.
            link?.click();
        }
        else if (key === "copyLink") {
            if (link) {
                emit("messageAction", { kind: "copy", message, text: link.href });
            }
        }
        else if (key === "savePhoto") {
            if (photoId) {
                void savePhoto(photoId);
            }
        }
        else if (key === "reply") {
            actionHandlers.replyInThread(message);
        }
        else if (key === "quote" || key === "edit" || key === "copy" || key === "delete" || key === "block") {
            actionHandlers[key](message);
        }
        else {
            const action = (message.actions ?? [])[Number(key.replace("action ", ""))];
            if (action) {
                actionHandlers.serverAction(action);
            }
        }
    }

    /** Whether the reader reacted with an emoji, which presses its reaction in the sheet. */
    function isMine(code: string): boolean {
        return !!props.message?.reactions?.some(reaction => reaction.code === code && reaction.mine);
    }

    /** The crossfade is a one-off, so the next edit can play it again. */
    function onAnimationEnd(event: AnimationEvent): void {
        if (event.animationName.includes("chat-crossfade")) {
            isCrossfading.value = false;
        }
        else if (event.animationName.includes("chat-meta-in")) {
            isEditedNow.value = false;
        }
        else if (isGreeting.value && event.animationName.includes("chat-flash")) {
            // The end still reaches the feed, which lets its jump's flash go only on the jumped-to
            // row's own end, so a greeting on another row leaves that flash be.
            isGreeting.value = false;
        }
    }

    // #endregion Event Handlers

    /** The long press that opens the sheet, on a touch screen while the message can be acted on. */
    const { isPressing } = useLongPress(rowElement, { isOn: () => isSheetOffered.value, onPress: onHold });

    // #region Watchers

    // A jump landing mid-greeting takes the greeting's layer over, so the greeting is over: it
    // never returns when the jump lets go, and the flash's end is the jump's for the feed to hear.
    watch(() => props.isFlashing, isFlashing => {
        if (isFlashing) {
            isGreeting.value = false;
        }
    });

    // The row lends the column's bar its dock while its message can be acted on, a phone's too, so
    // a picker asked for from its sheet has a column to open in; it takes it back as the message
    // stops being one or the row goes. Only a pointer's row marks itself for the bar to follow.
    watch([canAct, barDock, () => props.message?.id], ([isOffered, element, messageId], _before, onCleanup) => {
        if (!columnBar || !isOffered || !element || messageId === undefined) {
            return;
        }

        const dock: ActionBarDock = { element, props: barProps, handlers: actionHandlers };
        columnBar.offer(messageId, dock);
        onCleanup(() => columnBar.withdraw(messageId, dock));
    }, { immediate: true, flush: "post" });

    // #endregion Watchers
</script>
