<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div ref="rowElement"
         class="chat-msg"
         :class="rootClasses"
         :role="state === 'system' ? 'note' : 'article'"
         :aria-label="ariaLabel"
         tabindex="-1"
         :data-testid="pending ? 'pending-row' : 'message-row'"
         :data-status="pending ? pending.status : undefined"
         :data-state="state"
         :data-position="position"
         :data-hot-id="isBarOffered ? message?.id : undefined"
         @click="onRowClick"
         @animationend="onAnimationEnd">

        <!-- A system line: quiet, unattributed, centred in bubbles and in the text column in Community. -->
        <template v-if="state === 'system'">
            <span class="chat-sys-icon" aria-hidden="true"><Icon :name="systemIcon" :size="layout === 'community' ? 'sm' : 'xs'" /></span>
            <span class="chat-sys-text">
                <MessageBody :text="text" :pieces="pieces" :personAliasGuid="personAliasGuid" :isConversation="!isChannel" />
                <span v-if="layout === 'community'" class="chat-sys-time">{{ time }}</span>
            </span>
        </template>

        <!-- Community: flat rows, a head with the name on every group, the rest in the gutter's time. -->
        <MessageRowCommunity v-else-if="layout === 'community'" :view="view" :on="on" :isPhone="isPhone" :isPersonLeader="isPersonLeader" />

        <!-- Conversational: bubbles, the name over another person's group, their face at its last. -->
        <MessageRowBubble v-else :view="view" :on="on" :isDirectMessage="isDirectMessage" :position="position" :isFlashing="isFlashing" />

        <!-- A phone's actions, from a tap on the message; drawn over the whole chat. -->
        <ActionSheet v-if="isSheetSurface"
                     :isOpen="isSheetOpen"
                     :message="message"
                     :isOwn="isOwn"
                     :isInThread="isInThread"
                     :favorites="reactionHost?.favorites ?? []"
                     v-on="actionHandlers"
                     @close="onSheetClose" />
    </div>
</template>

<style scoped>
/* Every row. Arrival, the edit crossfade and the jump flash are the row's own motion. */
.chat-msg {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: var(--chat-r-md);
}

/*
    A row takes focus when a jump lands on it. A channel's row rings the whole row, inside its
    edge and rounded, over the hover tint it also takes; a direct message's rings what the person
    reads, the bubble, or a system line or card that has none. The ring is the chat's focus
    outline, written as the sheet writes it: the oldest Safari Rock supports has no :focus-visible
    and drops any rule naming it, so every focus rings, and a browser that can tell a click's focus
    apart takes the ring back from the click's.
*/
.chat-msg:focus {
    outline: none;
}

.chat-msg.is-conversational.is-system:focus-visible {
    outline: 2px solid var(--chat-brand-ink);
    outline-offset: 2px;
}

.chat-msg.is-conversational.is-system:focus {
    outline: 2px solid var(--chat-brand-ink);
    outline-offset: 2px;
}

@supports selector(:focus-visible) {
    .chat-msg.is-conversational.is-system:focus:not(:focus-visible) {
        outline: none;
    }

    .chat-msg.is-community:focus:not(:focus-visible) {
        outline: none;
        border-radius: var(--chat-cm-radius, 0);
    }
}

.chat-msg.is-arriving {
    animation: chat-msg-in var(--chat-t-msg) var(--chat-ease-in) both;
}

/*
    An own message grows from the corner it is anchored to: a bubble from its bottom right, by the
    sender's side; Community's full-width row from its bottom left, where its text starts, so the
    text does not slide sideways as the row scales.
*/
.chat-msg.is-conversational.is-own.is-arriving {
    transform-origin: bottom right;
}

.chat-msg.is-community.is-own.is-arriving {
    transform-origin: 0 100%;
}

/*
    A message jumped to flashes the church's wash, held for most of its length and then let go, so
    the eye finds it before it fades. A channel's row fades it out of its own background; a bubble
    fades its own. Reduced motion keeps it, being a color fade only.
*/
.chat-msg.is-community.is-flashing {
    animation: chat-cm-flash var(--chat-d-flash) var(--chat-ease-state);
}

/* Conversational. */
.chat-msg.is-conversational {
    align-items: flex-start;
}

.chat-msg.is-conversational.is-own {
    align-items: flex-end;
}

/*
    Community. The gutter, its gap to the text and the row's side padding are one set, shared with
    the system line, and narrower on a phone so the text keeps its width.
*/
.chat-msg.is-community {
    --chat-cm-gut: 36px;
    --chat-cm-gap: 12px;
    --chat-cm-pad: 20px;
    display: grid;
    grid-template-columns: var(--chat-cm-gut) minmax(0, 1fr);
    align-items: start;
    column-gap: var(--chat-cm-gap);
    padding: 2px var(--chat-cm-pad);
    border-radius: 0;
    /* How far a washed row stands in from the feed's edges. */
    --chat-cm-inset: 8px;
}

.chat-msg.is-community.is-phone {
    --chat-cm-gut: 32px;
    --chat-cm-gap: 10px;
    --chat-cm-pad: 12px;
    --chat-cm-inset: 4px;
}

.chat-msg.is-community.is-head {
    padding-top: 6px;
}

/* The ring sits inside the row, which runs edge to edge, so the scroller does not clip it. */
.chat-msg.is-community:focus-visible {
    outline: 2px solid var(--chat-brand-ink);
    outline-offset: -2px;
    border-radius: var(--chat-r-sm);
}

.chat-msg.is-community:focus {
    outline: 2px solid var(--chat-brand-ink);
    outline-offset: -2px;
    border-radius: var(--chat-r-sm);
}

.chat-msg.is-community:hover,
.chat-msg.is-community:focus-within {
    background-image: linear-gradient(var(--chat-hover), var(--chat-hover));
}

.is-community.is-announcement {
    background-color: var(--chat-row-announcement);
    box-shadow: inset 2px 0 0 var(--chat-brand);
}

/*
    A row that reaches the reader: a soft rounded wash stood in from the feed's edges, as a hover is,
    rather than a full-width tint with an edge, which read as a warning and ran together when
    several rows in a row named the reader. The inset comes out of the side padding, so the text
    keeps its column. Above and below, a clear 1px edge comes out of the padding and the wash is
    drawn inside it: the rows sit in a flex group, where a margin never collapses and would make
    the row taller, and the edge still parts two washed rows. Hover and focus lay over it as over
    any row.
*/
.chat-msg.is-community.is-mention-me {
    --chat-cm-radius: 10px;
    margin-inline: var(--chat-cm-inset);
    padding-block: 1px;
    padding-inline: calc(var(--chat-cm-pad) - var(--chat-cm-inset));
    background-color: var(--chat-row-mention);
    background-clip: padding-box;
    border-block: 1px solid transparent;
    border-radius: var(--chat-cm-radius);
}

.chat-msg.is-community.is-mention-me.is-head {
    padding-top: 5px;
}

/* The chip that reached the reader, theirs or @all, takes a thin amber ring, so it stands off the wash. */
.chat-msg.is-community.is-mention-me :deep(.chat-mn.is-you),
.chat-msg.is-community.is-mention-me :deep(.chat-mn.is-all) {
    box-shadow: 0 0 0 1px var(--chat-mention-ring);
}

/*
    The bar is docked to the row, which stands in from the feed's edge; pushed back out by the
    same inset, it holds its place against the feed, wherever its own placement puts it. Its top
    is measured from inside the row's clear 1px top edge, so it is lifted back by that pixel.
*/
.chat-msg.is-community.is-mention-me :deep(.chat-tools) {
    margin-top: -1px;
    margin-right: calc(-1 * var(--chat-cm-inset));
}

/* A system line. */
.chat-msg.is-system {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 10px 24px;
    font-size: 12.5px;
    color: var(--chat-muted);
    text-align: center;
}

/* In Community it sits on the text column, its icon in the gutter, a little roomier than a row. */
.chat-msg.is-community.is-system {
    align-items: flex-start;
    justify-content: stretch;
    gap: 0 var(--chat-cm-gap);
    margin: 6px 0 0;
    padding: 3px var(--chat-cm-pad);
    font-size: 13px;
    line-height: 20px;
    text-align: left;
}

.chat-sys-icon {
    display: flex;
    color: var(--chat-icon);
}

/* As tall as the text's line, so a line that wraps keeps its icon beside the first line. */
.is-community .chat-sys-icon {
    align-items: center;
    justify-content: center;
    height: 20px;
}

.chat-sys-text :deep(.chat-message-body),
.chat-sys-text :deep(.chat-body-text) {
    display: inline;
}

/* Kept whole, so a wrap never leaves "AM" alone on a line. */
.chat-sys-time {
    margin-left: 8px;
    white-space: nowrap;
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
}

@keyframes chat-msg-in {
    from {
        opacity: 0;
        transform: translateY(var(--chat-rise)) scale(var(--chat-msg-scale));
    }
}

/* The row's own background is where the flash ends, so no last frame is named. */
@keyframes chat-cm-flash {
    0%,
    45% {
        background-color: var(--chat-flash);
    }
}
</style>

<script setup lang="ts">
    import { computed, PropType, proxyRefs, ref, toRef, watch } from "vue";
    import ActionSheet from "./actionSheet.partial.obs";
    import MessageBody from "./messageBody.partial.obs";
    import MessageRowBubble from "./messageRowBubble.partial.obs";
    import MessageRowCommunity from "./messageRowCommunity.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import { MessageRowHandlers, MessageRowReactionsProps, MessageRowSurface, MessageRowView, useMessageRowView } from "../composables/useMessageRowView.partial";
    import { ActionBarDock, useColumnActionBar } from "../composables/useActionBar.partial";
    import { MessageActionRequest, messageRowRequests } from "../composables/useMessageActions.partial";
    import { ThreadPlace, threadPlaceOf } from "../composables/useThreads.partial";
    import { ReactionHost } from "../composables/useReactions.partial";
    import { FeedLayout, RowPosition } from "../feedLayout.partial";
    import { ChatError, PendingMessage, ReactorsCursor, ReactorsPage, SystemKind, TimelineMessage } from "../types.partial";

    const props = defineProps({
        /** The stored message, or null for a send that is not stored yet. */
        message: {
            type: Object as PropType<TimelineMessage | null>,
            default: null
        },

        /** The person's own send that is not stored yet, or null for a stored message. */
        pending: {
            type: Object as PropType<PendingMessage | null>,
            default: null
        },

        isOwn: {
            type: Boolean,
            default: false
        },

        /** The reader's alias guid, for the "you" mention chip. */
        personAliasGuid: {
            type: String as PropType<string>,
            default: ""
        },

        /** The reader's own name, for their messages the platform sent no name with. */
        personName: {
            type: String as PropType<string>,
            default: ""
        },

        /** The reader's own photo, for their face in Community. */
        personPhotoUrl: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether the reader leads this conversation, for the Leader pill on their own messages. */
        isPersonLeader: {
            type: Boolean,
            default: false
        },

        /** The church's name, the sender of a block post nobody signed. */
        organizationName: {
            type: String as PropType<string>,
            default: ""
        },

        /** A channel's message is a flat Community row; a direct message's is a Conversational bubble. */
        isChannel: {
            type: Boolean,
            default: false
        },

        /** The row's place in its group. */
        position: {
            type: String as PropType<RowPosition>,
            default: "single"
        },

        /** Whether the chat is in its one-pane phone layout, where Community's gutter and faces are smaller. */
        isPhone: {
            type: Boolean,
            default: false
        },

        /** A direct message names nobody over a bubble: the header already says who it is with. */
        isDirectMessage: {
            type: Boolean,
            default: false
        },

        /** The person's own send was just confirmed, so "Sent" shows for a moment. */
        isJustSent: {
            type: Boolean,
            default: false
        },

        /** A send still going has taken long enough to say "Sending…"; before that it says nothing. */
        isSendingSlow: {
            type: Boolean,
            default: false
        },

        /** The message arrived while the feed was open, so it rises in. */
        isArriving: {
            type: Boolean,
            default: false
        },

        /** The message was jumped to, so it flashes. */
        isFlashing: {
            type: Boolean,
            default: false
        },

        /** Each person's name this client holds, by alias guid in lower case, for a pending body's mentions. */
        senderNames: {
            type: Object as PropType<ReadonlyMap<string, string>>,
            default: () => new Map<string, string>()
        },

        /**
         * Drawn in the thread drawer, where the root's thread pill and a reply's "Replied to a
         * thread" label would only open the thread already on screen.
         */
        isInThread: {
            type: Boolean,
            default: false
        },

        /** A room the person has not joined, where its messages draw no bar. */
        isPreviewing: {
            type: Boolean,
            default: false
        },

        /** The message is open in the editor, which takes its bar's place. */
        isEditing: {
            type: Boolean,
            default: false
        },

        /** The refusal the editor's last save met, shown under what the person typed. */
        editError: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** The editor's save is out, so Save is held. */
        isEditSaving: {
            type: Boolean,
            default: false
        },

        /** The favorites the bar and the sheet draw, who reacted, and the message the picker is open on. */
        reactionHost: {
            type: Object as PropType<ReactionHost | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        (e: "openThread", place: ThreadPlace): void,
        (e: "jump", quotedMessageId: number): void,
        (e: "messageAction", request: MessageActionRequest): void,
        /** Try this one failed send again, by its key, as the strip's Try again asks for every one. */
        (e: "retry", localIds: string[]): void,
        /** Drop this one failed send, by its key. */
        (e: "discard", localId: string): void
    }>();

    // #region Values

    /** Each kind of system line's icon in Community's gutter. */
    const systemIcons: Record<SystemKind, string> = {
        joined: "door",
        left: "door",
        added: "users",
        removed: "users",
        renamed: "pencil"
    };

    const rowElement = ref<HTMLElement>();

    /** Where the column's one bar is drawn while it is on this message. */
    const barDock = ref<HTMLElement>();

    const columnBar = useColumnActionBar();

    const isCrossfading = ref(false);

    /** An edit landed while the row was on screen, so its "Edited" slides in once. */
    const isEditedNow = ref(false);

    const isSheetOpen = ref(false);

    /**
     * A screen with no hover, a tablet held in the hand, has no bar to show either, so it acts from
     * the sheet as a phone does. Read once: a screen does not gain a pointer while chat is open.
     */
    const isHoverless = typeof window !== "undefined" && typeof window.matchMedia === "function"
        && window.matchMedia("(hover: none)").matches;

    /**
     * Whether the row rises in, read once as it mounts and never again. The feed's answer changes
     * as a send is confirmed and its Sent hold ends; a class that followed it would start the rise
     * over on a row already on screen.
     */
    const isArrivalDrawn = props.isArriving;

    /**
     * Whether this row's thread started while the row was on screen: its first reply arrived
     * live. Read from the thread appearing, not from when the summary mounts, since a page opened
     * straight onto a conversation redraws its rows in the conversation's look once its kind is
     * known, and a thread that was there all along must not pop then.
     */
    const isThreadStartedHere = ref(false);

    // #endregion Values

    // #region Computed Values

    /** What the message shows, worked out once and lent to the look it draws in. */
    const facts = useMessageRowView(props);
    const { state, text, pieces, isAnnouncement, isJumbo, hasThread, isHead, displayName, authorGuid, time, readerMention, isReactable } = facts;

    /** The look the conversation's kind picks, which the row draws in. */
    const layout = computed((): FeedLayout => props.isChannel ? "community" : "conversational");

    function onRetryFailed(): void {
        if (props.pending) {
            emit("retry", [props.pending.localId]);
        }
    }

    function onDiscardFailed(): void {
        if (props.pending) {
            emit("discard", props.pending.localId);
        }
    }

    const ariaLabel = computed((): string => {
        const who = props.isOwn ? "You" : displayName.value;
        const mentions = readerMention.value ? `, mentions ${readerMention.value}` : "";
        return `${who}, ${time.value}${mentions}`;
    });

    /** Chips to draw under the message. */
    const hasReactions = computed((): boolean => isReactable.value && (props.message?.reactions?.length ?? 0) > 0);

    /**
     * A system line's icon: in Community's gutter, by the kind Rock gave the line as it posted it,
     * the info mark for a line it gave none or a kind this client does not know; in bubbles,
     * always the quiet info mark.
     */
    const systemIcon = computed((): string => {
        const kind = props.message?.system_kind;
        return layout.value === "community" && kind ? systemIcons[kind] ?? "info" : "info";
    });

    /** A stored message the person reads as it is, which an action can apply to. */
    const isActionable = computed((): boolean => state.value === "message" || state.value === "sent" || state.value === "unknown");

    /** A phone, or a screen with no hover, which acts from the sheet instead of the bar. */
    const isTouchLayout = computed((): boolean => props.isPhone || isHoverless);

    /**
     * Whether the message can be acted on now, the one rule the bar and the sheet both follow: a
     * stored message as the person reads it, not open in the editor, in a room the person has
     * joined. A tombstone, a send on its way or failed, a system line and a block post cannot be.
     */
    const canAct = computed((): boolean => !!props.message && !props.pending && isActionable.value && !props.isPreviewing && !props.isEditing);

    /** Whether the row lends the column's bar a dock: a message that can be acted on, on a pointer screen; a phone acts from a sheet instead. */
    const isBarOffered = computed((): boolean => canAct.value && !isTouchLayout.value);

    /** The rows that hold a sheet at all, kept while it slides away whatever the message became. */
    const isSheetSurface = computed((): boolean => !!props.message && !props.pending && isTouchLayout.value);

    /** Whether a tap opens the sheet now: as the bar would show, never on a previewed room or an open editor. */
    const isSheetOffered = computed((): boolean => isSheetSurface.value && canAct.value);

    /** The editor takes the text's place while the message is live; a delete that lands meanwhile shows its tombstone. */
    const isEditorShown = computed((): boolean => props.isEditing && !!props.message && !props.pending && isActionable.value);

    /** The column bar's props on this message, the same in both looks, which place it in different spots. */
    const barProps = computed((): Record<string, unknown> => ({
        message: props.message,
        isOwn: props.isOwn,
        isInThread: props.isInThread,
        isCommunity: layout.value === "community",
        senderName: displayName.value,
        favorites: props.reactionHost?.favorites ?? [],
        pickerAnchor: props.message ? props.reactionHost?.pickerAnchorOf(props.message.id) ?? null : null
    }));

    /**
     * The reactions row's props; a previewer sees the chips and who reacted but cannot press them,
     * a touch screen has no add chip, and no chip's card shows while the picker is open on this
     * message; asked by message, so the picker opening wakes no other row.
     */
    const reactionsProps = computed((): MessageRowReactionsProps => ({
        message: props.message as TimelineMessage,
        isPreviewing: props.isPreviewing,
        isPhone: isTouchLayout.value,
        reader: { personAliasGuid: props.personAliasGuid, name: props.personName, photoUrl: props.personPhotoUrl },
        listReactors,
        isCardDisabled: !!props.message && !!props.reactionHost?.pickerAnchorOf(props.message.id)
    }));

    const rootClasses = computed((): Record<string, boolean> => ({
        [`is-${layout.value}`]: true,
        [`is-${state.value}`]: true,
        "is-own": props.isOwn,
        "is-phone": props.isPhone,
        "is-head": isHead.value,
        "is-announcement": isAnnouncement.value,
        "is-jumbo": isJumbo.value,
        // An announcement owns its own tint and edge; one naming the reader keeps them and the words.
        "is-mention-me": !!readerMention.value && !isAnnouncement.value,
        "is-arriving": isArrivalDrawn,
        "is-flashing": props.isFlashing,
        "has-thread": hasThread.value,
        "has-reactions": hasReactions.value
    }));

    // #endregion Computed Values

    // #region Event Handlers

    /** Asks for the author's card beside the name or face pressed. */
    function onAuthor(event: MouseEvent): void {
        if (authorGuid.value) {
            onPerson(authorGuid.value, event.currentTarget as HTMLElement);
        }
    }

    /** Asks for a person's card, from the author or a chip in the body, beside what was pressed. */
    function onPerson(personAliasGuid: string, anchor: HTMLElement): void {
        emit("messageAction", { kind: "person", personAliasGuid, anchor });
    }

    /** The thread pill under a root and the label over a reply also sent: the thread the message belongs to. */
    function onOpenOwnThread(): void {
        if (props.message) {
            emit("openThread", threadPlaceOf(props.message));
        }
    }

    /** The bar's and the sheet's choices, the chips', the editor's and a block button's, each one request. */
    const { actions: actionHandlers, reactions: reactionsHandlers, editor: editorHandlers, runBlockAction } = messageRowRequests({
        message: () => props.message,
        request: (request: MessageActionRequest) => emit("messageAction", request),
        openThread: place => emit("openThread", place),
        pickerAnchor,
        messageAnchor
    });

    /**
     * What the look draws: the facts, and what the row lends it of what can be done to the
     * message and of its own motion. Made once and never replaced, so a look draws again only
     * when a member it reads changes; each member is unwrapped one level, so the look hands its
     * children the same message, files and pieces the row holds.
     */
    const lent: ReturnType<typeof useMessageRowView> & MessageRowSurface = {
        ...facts,
        isEditorShown,
        isBarOffered,
        editError: toRef(props, "editError"),
        isEditSaving: toRef(props, "isEditSaving"),
        reactionsProps,
        isCrossfading,
        isEditedNow,
        isThreadStartedHere
    };
    const view: MessageRowView = proxyRefs(lent);

    /** What the look calls, each request wired here once rather than in each look. */
    const on: MessageRowHandlers = {
        author: onAuthor,
        person: onPerson,
        openThread: onOpenOwnThread,
        retry: onRetryFailed,
        discard: onDiscardFailed,
        jump: quotedMessageId => emit("jump", quotedMessageId),
        editor: editorHandlers,
        reactions: reactionsHandlers,
        runBlockAction,
        // The look's dock arrives as it mounts and goes as it unmounts, during the patch, before
        // the watcher that lends it to the bar reads it.
        setDock: element => {
            barDock.value = element instanceof HTMLElement ? element : undefined;
        }
    };

    /** A page of who reacted to this message, asked of the reactions the shell holds. */
    function listReactors(code: string | null, after: ReactorsCursor | null): Promise<ReactorsPage | null> {
        return props.message && props.reactionHost ? props.reactionHost.listReactors(props.message.id, code, after) : Promise.resolve(null);
    }

    /**
     * Where the picker is placed. The sheet's plus closes with the sheet, so a picker asked for
     * from it is placed on the message, as the bar's own button would be.
     */
    function pickerAnchor(anchor: HTMLElement): HTMLElement {
        const row = rowElement.value;
        const isInSheet = !!anchor.closest(".chat-sheet");
        if (!row || (row.contains(anchor) && !isInSheet)) {
            return anchor;
        }

        return messageAnchor() ?? row;
    }

    /**
     * The message a picker asked for by a control that can go is placed on: its bubble, or the
     * whole row in a channel, which draws no bubble, so the picker clears the name and the text.
     */
    function messageAnchor(): HTMLElement | null {
        return rowElement.value?.querySelector<HTMLElement>(".chat-bubble") ?? rowElement.value ?? null;
    }


    /**
     * A tap on the message opens the sheet on a phone. A tap on something of its own, a link, a
     * button or the sheet itself where it is drawn in place, does what that thing does instead.
     */
    function onRowClick(event: MouseEvent): void {
        const target = event.target as Element | null;
        if (!isSheetOffered.value || target?.closest("button, a, input, label, [contenteditable='true'], .chat-sheet-scrim")) {
            return;
        }

        isSheetOpen.value = true;
    }

    /** Focus comes back to the message, unless the choice made moves it on, as a quote or an edit does. */
    function onSheetClose(): void {
        isSheetOpen.value = false;
        rowElement.value?.focus({ preventScroll: true });
    }

    /** The crossfade is a one-off, so the next edit can play it again. */
    function onAnimationEnd(event: AnimationEvent): void {
        if (event.animationName.includes("chat-crossfade")) {
            isCrossfading.value = false;
        }
        else if (event.animationName.includes("chat-meta-in")) {
            isEditedNow.value = false;
        }
    }

    // #endregion Event Handlers

    // #region Watchers

    // An edit, a delete or a moderator's hide replaces what the bubble holds, so it crossfades.
    watch(() => [props.message?.edited_at, props.message?.deleted_at, props.message?.visibility], (now, before) => {
        if (before && now.some((value, index) => value !== before[index])) {
            isCrossfading.value = true;
            isEditedNow.value = !!now[0] && now[0] !== before[0];
        }
    });

    // The row lends the column's bar its dock while its message offers one, and takes it back as
    // the message stops offering it or the row goes.
    watch([isBarOffered, barDock, () => props.message?.id], ([isOffered, element, messageId], _before, onCleanup) => {
        if (!columnBar || !isOffered || !element || messageId === undefined) {
            return;
        }

        const dock: ActionBarDock = { element, props: barProps, handlers: actionHandlers };
        columnBar.offer(messageId, dock);
        onCleanup(() => columnBar.withdraw(messageId, dock));
    }, { immediate: true, flush: "post" });

    // Not immediate, so a thread already there when the row draws is not taken for a new one.
    watch(hasThread, (now, before) => {
        if (now && !before) {
            isThreadStartedHere.value = true;
        }
    });

    // #endregion Watchers
</script>
