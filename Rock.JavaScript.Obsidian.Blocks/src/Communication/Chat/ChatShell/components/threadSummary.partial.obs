<template>
    <button type="button"
            class="chat-tsum"
            :class="{ 'is-community': isCommunity, 'is-unread': isUnread, 'is-popping': isPopping }"
            data-testid="thread-summary"
            :aria-label="ariaLabel"
            :title="isCommunity ? undefined : `Last reply ${lastTime}`"
            @click="emit('open', message.id)"
            @animationend.self="isPopping = false">

        <!-- The pill: icon, count and the newest repliers, the unread dot at its outer top corner. -->
        <template v-if="!isCommunity">
            <Icon name="thread" size="sm" />
            <b data-testid="thread-count">{{ count }}</b>
            <span class="chat-tsum-faces" data-testid="thread-faces">
                <Avatar v-for="(face, index) in faces" :key="index" :people="[face]" :size="18" />
            </span>
            <span v-if="isUnread" class="chat-tsum-dot" data-testid="thread-unread-dot"></span>
        </template>

        <!-- The row: square faces, the count led by the unread dot, then the last reply or View thread. -->
        <template v-else>
            <span class="chat-tsum-faces" data-testid="thread-faces">
                <Avatar v-for="(face, index) in faces" :key="index" :people="[face]" :size="20" />
            </span>
            <b data-testid="thread-count"><span v-if="isUnread" class="chat-tsum-cm-dot" data-testid="thread-unread-dot"></span>{{ count }}</b>
            <span class="chat-tsum-last" data-testid="thread-last" aria-hidden="true">Last reply {{ lastWhen }}</span>
            <span class="chat-tsum-view" data-testid="thread-view" aria-hidden="true">View thread<Icon name="left" size="xs" class="chat-tsum-chev" /></span>
        </template>
    </button>
</template>

<style scoped>
.chat-tsum {
    position: relative;
    display: inline-flex;
    gap: 6px;
    align-items: center;
    height: 26px;
    margin: 0;
    padding: 0 4px 0 8px;
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--chat-text-2);
    background: var(--chat-raised);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-full);
    box-shadow: 0 0 0 2px var(--chat-surface);
    transition: border-color var(--chat-t-fast) var(--chat-ease-state), transform var(--chat-t-fast) var(--chat-ease-in);
}

/* A thread that starts while the reader watches pops in as a new reaction does. */
.chat-tsum.is-popping {
    animation: chat-tsum-pop var(--chat-d-rx-pop) var(--chat-ease-spring);
}

@keyframes chat-tsum-pop {
    from {
        opacity: .2;
        transform: scale(var(--chat-react-from));
    }
}

/* Reduced motion: the sheet holds the pop at full size, so what is left is a short fade. */
@media (prefers-reduced-motion: reduce) {
    .chat-tsum.is-popping {
        animation-duration: var(--chat-t-fast);
    }
}

.chat-tsum :deep(.chat-ic) {
    width: 14px;
    height: 14px;
    color: var(--chat-icon);
}

.chat-tsum b {
    font-weight: 650;
    color: inherit;
}

.chat-tsum:hover {
    background: var(--chat-raised);
    border-color: var(--chat-line-strong);
    transform: translateY(-1px);
}

.chat-tsum.is-unread {
    color: var(--chat-brand-ink);
    border-color: var(--chat-thread-unread-line);
}

.chat-tsum.is-unread :deep(.chat-ic) {
    color: var(--chat-brand-ink);
}

.chat-tsum-faces {
    display: inline-flex;
}

/* The pill's faces overlap a fixed 4px, ringed in the pill's own fill so an initial is never cut. */
.chat-tsum-faces :deep(.chat-av) {
    box-shadow: 0 0 0 1.5px var(--chat-raised);
}

.chat-tsum-faces > :deep(.chat-pile + .chat-pile) {
    margin-left: -4px;
}

/* One letter at 18px reads at 9px; the avatar's own 0.37 ratio is set inline, so this must win over it. */
.chat-tsum:not(.is-community) .chat-tsum-faces :deep(.chat-av) {
    font-size: 9px !important;
}

/* At the outer top corner: the right for another person's message, the left for the reader's own. */
.chat-tsum-dot {
    position: absolute;
    top: -2px;
    right: -1px;
    width: 7px;
    height: 7px;
    background: var(--chat-brand-fill);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--chat-surface);
}

/* Community's full-width row, quiet until hovered. */
.chat-tsum.is-community {
    gap: 8px;
    max-width: calc(100% + 4px);
    height: auto;
    min-height: 30px;
    margin: 4px 0 0 -4px;
    padding: 3px 10px 3px 4px;
    font-size: 13px;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--chat-r-md);
    box-shadow: none;
    transform: none;
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), border-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-tsum.is-community:hover {
    background: var(--chat-raised);
    border-color: var(--chat-line);
    transform: none;
}

/* Rounded squares, spaced apart rather than piled. */
.is-community .chat-tsum-faces :deep(.chat-av) {
    font-size: 8px !important;
    border-radius: var(--chat-r-sm);
    box-shadow: none;
}

.is-community .chat-tsum-faces > :deep(.chat-pile + .chat-pile) {
    margin-left: 3px;
}

.chat-tsum.is-community b {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-weight: 650;
    color: var(--chat-brand-ink);
    white-space: nowrap;
}

.chat-tsum-cm-dot {
    flex: none;
    width: 7px;
    height: 7px;
    background: var(--chat-brand-fill);
    border-radius: 50%;
}

.chat-tsum-last,
.chat-tsum-view {
    min-width: 0;
    overflow: hidden;
    font-size: 12px;
    color: var(--chat-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chat-tsum-view {
    display: none;
    gap: 2px;
    align-items: center;
    color: var(--chat-text-2);
}

/* The set has no right chevron, so the left one turns round. */
.chat-tsum-view :deep(.chat-tsum-chev) {
    width: 13px;
    height: 13px;
    color: inherit;
    transform: rotate(180deg);
}

.chat-tsum.is-community:hover .chat-tsum-last,
.chat-tsum.is-community:focus .chat-tsum-last {
    display: none;
}

.chat-tsum.is-community:hover .chat-tsum-view,
.chat-tsum.is-community:focus .chat-tsum-view {
    display: inline-flex;
}

/* A touch screen has no hover, so the last reply's time stays. */
@media (hover: none) {
    .chat-tsum.is-community .chat-tsum-view {
        display: none !important;
    }

    .chat-tsum.is-community .chat-tsum-last {
        display: inline !important;
    }
}
</style>

<script setup lang="ts">
    import { computed, getCurrentInstance, PropType, ref } from "vue";
    import Avatar, { AvatarPerson } from "../ui/avatar.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import { dayLabel, timeLabel } from "../feedLayout.partial";
    import { TimelineMessage } from "../types.partial";

    const props = defineProps({
        /** The root message, which carries its reply count, last reply time and repliers. */
        message: {
            type: Object as PropType<TimelineMessage>,
            required: true
        },

        /** A channel's full-width thread row rather than a direct message's pill. */
        isCommunity: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "open", rootId: number): void
    }>();

    // #region Values

    /*
        The summary is drawn only once a root has a reply, so it mounts either with its row, as a
        conversation draws, or later, when the first reply arrives under a row already on screen.
        Only the second pops; a page load popping every thread at once would be noise.
    */
    const isPopping = ref(getCurrentInstance()?.parent?.isMounted === true);

    // #endregion Values

    // #region Computed Values

    const isUnread = computed((): boolean => !!props.message.thread_unread);

    /** "1 reply", "3 replies", and "99+ replies" past 99, as every count in the chat reads. */
    const count = computed((): string => {
        const replies = props.message.reply_count ?? 0;
        const shown = replies > 99 ? "99+" : String(replies);
        return `${shown} ${replies === 1 ? "reply" : "replies"}`;
    });

    /** The pill has room for three faces, the row for four. */
    const faces = computed((): AvatarPerson[] => (props.message.repliers ?? [])
        .slice(0, props.isCommunity ? 4 : 3)
        .map(person => ({
            name: [person.nick_name, person.last_name].filter(part => !!part).join(" "),
            photoUrl: person.avatar_url ?? null
        })));

    const lastAt = computed((): Date | null => {
        const at = props.message.last_reply_at ? new Date(props.message.last_reply_at) : null;
        return at && !isNaN(at.getTime()) ? at : null;
    });

    const lastTime = computed((): string => lastAt.value ? timeLabel(lastAt.value) : "");

    /** The row writes the day out, "today at 9:41 AM"; a weekday or date keeps its capital. */
    const lastWhen = computed((): string => {
        if (!lastAt.value) {
            return "";
        }

        const day = dayLabel(lastAt.value, new Date());
        const spokenDay = day === "Today" || day === "Yesterday" ? day.toLowerCase() : day;
        return `${spokenDay} at ${lastTime.value}`;
    });

    /** The whole button in one sentence, since its parts are drawn for the eye only. */
    const ariaLabel = computed((): string => {
        const when = props.isCommunity ? lastWhen.value : lastTime.value;
        const unread = isUnread.value ? ", new replies" : "";
        return `${count.value}, last reply ${when}${unread}. Open thread`;
    });

    // #endregion Computed Values
</script>
