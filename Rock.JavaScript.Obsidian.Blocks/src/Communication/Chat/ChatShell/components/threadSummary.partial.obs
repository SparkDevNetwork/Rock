<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <button ref="pillElement"
            type="button"
            class="chat-tsum"
            :class="{ 'is-unread': isUnread, 'is-popping': isPopping }"
            data-testid="thread-summary"
            :aria-label="ariaLabel"
            @mouseenter="onPointerEnter"
            @mouseleave="onPointerLeave"
            @pointerdown="onPointerDown"
            @focus="onFocus"
            @blur="onBlur"
            @click="onClick"
            @animationend.self="isPopping = false">
        <!-- Icon, count and the newest repliers, the unread dot at the pill's outer top corner. -->
        <Icon name="thread" size="sm" />
        <b data-testid="thread-count">{{ count }}</b>
        <span class="chat-tsum-faces" data-testid="thread-faces">
            <Avatar v-for="(face, index) in faces" :key="index" :people="[face]" :size="18" />
        </span>
        <span v-if="isUnread" class="chat-tsum-dot" data-testid="thread-unread-dot"></span>
        <!-- Inside the pill, so the pill stays one element; fixed, so it is placed against the window. -->
        <span v-if="isTipShown"
              ref="tipElement"
              class="chat-tip"
              role="tooltip"
              :style="floatingStyles">Last reply {{ lastTime }}</span>
    </button>
</template>

<style scoped>
.chat-tsum {
    position: relative;
    display: inline-flex;
    gap: 6px;
    align-items: center;
    height: 26px;
    margin: 0;
    padding: 0 4px 0 8px;
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--chat-text-2);
    background: var(--chat-raised);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-full);
    box-shadow: 0 0 0 2px var(--chat-surface);
    transition: border-color var(--chat-t-fast) var(--chat-ease-state), transform var(--chat-t-fast) var(--chat-ease-in);
}

/* A thread that starts while the reader watches pops in as a new reaction does. */
.chat-tsum.is-popping {
    animation: chat-tsum-pop var(--chat-d-rx-pop) var(--chat-ease-spring);
}

@keyframes chat-tsum-pop {
    from {
        opacity: .2;
        transform: scale(var(--chat-react-from));
    }
}

/* Reduced motion: the sheet holds the pop at full size, so what is left is a short fade. */
@media (prefers-reduced-motion: reduce) {
    .chat-tsum.is-popping {
        animation-duration: var(--chat-t-fast);
    }
}

.chat-tsum :deep(.chat-ic) {
    width: 14px;
    height: 14px;
    color: var(--chat-icon);
}

.chat-tsum b {
    font-weight: 650;
    color: inherit;
}

.chat-tsum:hover {
    background: var(--chat-raised);
    border-color: var(--chat-line-strong);
    transform: translateY(-1px);
}

.chat-tsum.is-unread {
    color: var(--chat-brand-ink);
    border-color: var(--chat-thread-unread-line);
}

.chat-tsum.is-unread :deep(.chat-ic) {
    color: var(--chat-brand-ink);
}

.chat-tsum-faces {
    display: inline-flex;
}

/*
    The pill's faces overlap a fixed 4px, ringed in the pill's own fill so an initial is never cut.
    One letter at 18px reads at 9px; the avatar's own 0.37 ratio is set inline, so this must win over it.
*/
.chat-tsum-faces :deep(.chat-av) {
    font-size: 9px !important;
    box-shadow: 0 0 0 1.5px var(--chat-raised);
}

.chat-tsum-faces > :deep(.chat-pile + .chat-pile) {
    margin-left: -4px;
}

/* At the outer top corner: the right for another person's message, the left for the reader's own. */
.chat-tsum-dot {
    position: absolute;
    top: -2px;
    right: -1px;
    width: 7px;
    height: 7px;
    background: var(--chat-brand-fill);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--chat-surface);
}
</style>

<script setup lang="ts">
    import { computed, PropType, ref } from "vue";
    import Avatar, { AvatarPerson } from "../ui/avatar.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import { useTooltip } from "../ui/tooltip.partial";
    import { replyCountText, timeLabel } from "../feedLayout.partial";
    import { TimelineMessage } from "../types.partial";

    const props = defineProps({
        /** The root message, which carries its reply count, last reply time and repliers. */
        message: {
            type: Object as PropType<TimelineMessage>,
            required: true
        },

        /** Whether the row it sits under was already on screen when the summary mounted; read once. */
        isRowOnScreen: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "open", rootId: number): void
    }>();

    // #region Values

    /*
        The summary is drawn only once a root has a reply, so it mounts either with its row, as a
        conversation draws, or later, when the first reply arrives under a row already on screen.
        Only the second pops; a page load popping every thread at once would be noise.
    */
    const isPopping = ref(props.isRowOnScreen);

    const pillElement = ref<HTMLButtonElement>();

    // The chat's own tooltip rather than the browser's, which cannot be styled or timed.
    const { tipElement, isTipShown, floatingStyles, hideTip, onPointerEnter, onPointerLeave, onPointerDown, onFocus, onBlur } = useTooltip(pillElement);

    // #endregion Values

    // #region Computed Values

    const isUnread = computed((): boolean => !!props.message.thread_unread);

    const count = computed((): string => replyCountText(props.message.reply_count ?? 0));

    /** The pill has room for three faces. */
    const faces = computed((): AvatarPerson[] => (props.message.repliers ?? [])
        .slice(0, 3)
        .map(person => ({
            name: [person.nick_name, person.last_name].filter(part => !!part).join(" "),
            photoUrl: person.avatar_url ?? null
        })));

    const lastAt = computed((): Date | null => {
        const at = props.message.last_reply_at ? new Date(props.message.last_reply_at) : null;
        return at && !isNaN(at.getTime()) ? at : null;
    });

    const lastTime = computed((): string => lastAt.value ? timeLabel(lastAt.value) : "");

    /** The whole button in one sentence, since its parts are drawn for the eye only. */
    const ariaLabel = computed((): string => {
        const unread = isUnread.value ? ", new replies" : "";
        return `${count.value}, last reply ${lastTime.value}${unread}. Open thread`;
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onClick(): void {
        hideTip();
        emit("open", props.message.id);
    }

    // #endregion Event Handlers
</script>
