<template>
    <Notice data-testid="error-toast" />
</template>

<script setup lang="ts">
    import { PropType, watch } from "vue";
    import { errorKey, messageForError } from "../errors.partial";
    import { ChatError } from "../types.partial";
    import Notice from "../ui/notice.partial.obs";
    import { NoticeItem, useNotices } from "../ui/notices.partial";

    // #region Types

    /** A notice that is not a failure, such as being back online, with the icon it is drawn with. */
    export type ToastNotice = {
        code: string;
        text: string;
        icon: string;
    };

    // #endregion Types

    // The shell's failures and its passing notices, said as the session's floating notices. The
    // live connection's trouble is shown in the header, not here. Two failures under one code with
    // different sentences are two notices, since each says something the other does not.
    const props = defineProps({
        errors: {
            type: Array as PropType<ChatError[]>,
            required: true
        },

        notices: {
            type: Array as PropType<ToastNotice[]>,
            default: () => []
        }
    });

    const emit = defineEmits<{
        (e: "dismiss", error: ChatError): void;
        (e: "dismissNotice", notice: ToastNotice): void
    }>();

    const shown = useNotices();

    /** The keys this part raised, so it takes back only its own when the shell lets one go. */
    let raised: string[] = [];

    // Failures first. A failure stays until it is let go; a notice passes after the toast life.
    // Each mirrors the shell's own list, so it goes when the shell drops it, never before.
    watch(() => [props.errors, props.notices] as const, ([errors, notices]) => {
        const items: NoticeItem[] = [
            ...errors
                .filter(e => e.severity !== "degraded")
                .map((e): NoticeItem => ({ key: `error ${errorKey(e)}`, code: e.code, text: messageForError(e), tone: "failure", isOwned: true, onDismiss: () => emit("dismiss", e) })),
            ...notices
                .map((n): NoticeItem => ({ key: `notice ${n.code}`, code: n.code, text: n.text, icon: n.icon, isOwned: true, onDismiss: () => emit("dismissNotice", n) }))
        ];
        const keys = items.map(item => item.key);

        raised.filter(key => !keys.includes(key)).forEach(key => shown.withdraw(key));
        items.forEach(item => shown.show(item));
        raised = keys;
    }, { immediate: true });
</script>
