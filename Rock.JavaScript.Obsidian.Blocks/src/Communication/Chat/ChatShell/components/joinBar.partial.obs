<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="chat-joinbar-place" :class="{ 'is-phone': isPhone }">
        <div ref="barElement"
             class="chat-joinbar"
             :class="{ 'is-refused': drawn === 'refused', 'is-pending': drawn === 'pending' }"
             data-testid="join-bar"
             :data-state="drawn">
            <Icon name="door" />
            <span class="chat-joinbar-main">
                <b data-testid="join-bar-title">{{ title }}</b>
                <span v-if="drawn === 'pending'" data-testid="join-bar-text"><span class="chat-spinner"></span>Setting up, a few seconds</span>
                <span v-else-if="drawn === 'refused'" data-testid="join-bar-text">{{ refusal }}</span>
                <span v-else-if="drawn === 'failed'" class="is-failed" data-testid="join-bar-text"><Icon name="alert" size="xs" />{{ failure }}</span>
                <span v-else data-testid="join-bar-text">Join this channel to post and get notifications.</span>
            </span>

            <button v-if="drawn === 'refused'"
                    ref="browseButton"
                    type="button"
                    class="chat-joinbar-btn is-line"
                    data-testid="join-bar-browse"
                    @click="emit('browse')">
                <Icon name="search" size="xs" />Browse channels
            </button>
            <!-- One button through Join and Joining, so focus stays on it while the door is out. -->
            <button v-else-if="drawn !== 'pending'"
                    type="button"
                    class="chat-joinbar-btn is-brand"
                    data-testid="join-channel"
                    :aria-disabled="drawn === 'joining' ? 'true' : undefined"
                    :aria-busy="drawn === 'joining' ? 'true' : undefined"
                    @click="onJoin">
                <template v-if="drawn === 'joining'"><span class="chat-spinner"></span>Joining</template>
                <template v-else>Join channel</template>
            </button>
        </div>
    </div>
</template>

<style scoped>
/*
    The composer's place, held by the bar while the person previews the channel. It takes the
    composer's own padding, so nothing moves when the composer comes back after the join.
*/
.chat-joinbar-place {
    display: flex;
    flex: none;
    flex-direction: column;
    padding: 0 20px 14px;
}

.chat-joinbar-place.is-phone {
    padding: 0 10px 10px;
}

.chat-joinbar {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 12px 12px 12px 16px;
    background: var(--chat-brand-tint);
    border: 1px solid color-mix(in srgb, var(--chat-brand) 35%, transparent);
    border-radius: var(--chat-r-bar);
    animation: chat-strip-in var(--chat-t-base) var(--chat-ease-in);
}

@keyframes chat-strip-in {
    from {
        opacity: 0;
        transform: translateY(6px);
    }
}

.chat-joinbar > :deep(.chat-ic) {
    color: var(--chat-brand-ink);
}

.chat-joinbar-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
}

.chat-joinbar-main b {
    font-size: 14px;
}

.chat-joinbar-main > span {
    font-size: 12.5px;
    color: var(--chat-text-2);
}

/* A Join that did not reach the door says so where its sentence was, as an inline note does. */
.chat-joinbar-main > span.is-failed {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    color: var(--chat-danger-ink);
}

/* Rock has the membership; only the platform's copy is still on its way. */
.chat-joinbar.is-pending .chat-joinbar-main > span {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    color: var(--chat-muted);
}

.chat-joinbar.is-pending .chat-spinner {
    width: 11px;
    height: 11px;
    border-width: 1.5px;
}

.chat-joinbar.is-refused {
    background: var(--chat-danger-soft);
    border-color: color-mix(in srgb, var(--chat-danger) 30%, transparent);
}

.chat-joinbar.is-refused > :deep(.chat-ic) {
    color: var(--chat-danger-ink);
}

/* The design's large brand button and its line button. */
.chat-joinbar-btn {
    display: inline-flex;
    flex: none;
    gap: 6px;
    align-items: center;
    height: 38px;
    padding: 0 18px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), border-color var(--chat-t-fast) var(--chat-ease-state), box-shadow var(--chat-t-fast) var(--chat-ease-state);
}

.chat-joinbar-btn.is-brand {
    color: var(--chat-on-brand);
    background: var(--chat-brand-fill);
    border: 0;
}

.chat-joinbar-btn.is-brand:hover:not([aria-disabled="true"]) {
    box-shadow: inset 0 0 0 999px var(--chat-press);
}

.chat-joinbar-btn.is-line {
    height: 30px;
    padding: 0 14px;
    font-size: 13px;
    color: var(--chat-text);
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
}

.chat-joinbar-btn.is-line:hover {
    border-color: var(--chat-icon);
}

.chat-joinbar-btn .chat-spinner {
    width: 13px;
    height: 13px;
}
</style>

<script setup lang="ts">
    import { computed, nextTick, PropType, ref, watch } from "vue";
    import Icon from "../ui/icon.partial.obs";
    import { JoinState } from "../composables/useRooms.partial";

    const props = defineProps({
        /** The channel's name, written with no "#". */
        name: {
            type: String as PropType<string>,
            required: true
        },

        /** Where the room's Join is, as the rooms hold it. */
        state: {
            type: Object as PropType<JoinState>,
            required: true
        },

        /** Whether the block is drawn one pane at a time, where the composer sits tighter. */
        isPhone: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "join"): void,
        (e: "browse"): void
    }>();

    // #region Values

    const barElement = ref<HTMLElement>();
    const browseButton = ref<HTMLButtonElement>();

    // #endregion Values

    // #region Computed Values

    /**
     * The bar's state. A Join the door could not reach says why and is offered again; a room
     * joined is the composer's place again, so the bar is gone before it would say so.
     */
    const drawn = computed((): "preview" | "joining" | "pending" | "refused" | "failed" => {
        switch (props.state.kind) {
            case "joining":
            case "pending":
            case "refused":
            case "failed":
                return props.state.kind;

            default:
                return "preview";
        }
    });

    const title = computed((): string => {
        switch (drawn.value) {
            case "pending":
                return `You've joined ${props.name}`;

            case "refused":
                return `You can't join ${props.name}`;

            default:
                return `You're previewing ${props.name}`;
        }
    });

    /** The door's own sentence, as it arrived. */
    const refusal = computed((): string => props.state.kind === "refused" ? props.state.text : "");

    /** Why the door could not be reached. */
    const failure = computed((): string => props.state.kind === "failed" ? props.state.text : "");

    // #endregion Computed Values

    // #region Event Handlers

    /** Join, unless the door is already out: held by aria-disabled, so the press arrives and is dropped here. */
    function onJoin(): void {
        if (drawn.value !== "joining") {
            emit("join");
        }
    }

    // #endregion Event Handlers

    // #region Watchers

    // The button the person pressed leaves with a refusal, so focus goes to the way on from here
    // rather than falling to the page; focus anywhere else is the person's and stays.
    watch(drawn, async (now) => {
        const hadFocus = !!barElement.value && barElement.value.contains(document.activeElement);
        if (now !== "refused" || !hadFocus) {
            return;
        }

        await nextTick();
        browseButton.value?.focus();
    }, { flush: "pre" });

    // #endregion Watchers
</script>
