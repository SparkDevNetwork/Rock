<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="chat-attach" :class="{ 'is-strip': !!tray, 'is-own': isOwn }">
        <template v-if="tray">
            <div v-if="tray.files.length > 0 || tray.notice" class="chat-attach-strip" data-testid="attachment-strip">
                <div v-for="file in tray.files"
                     :key="file.localId"
                     class="chat-attach-chip"
                     data-testid="attachment-tray-file"
                     :data-status="file.status">
                    <span class="chat-attach-chip-thumb" aria-hidden="true">
                        <img v-if="file.previewUrl" :src="file.previewUrl" alt="" />
                        <Icon v-else name="file" />
                    </span>
                    <span class="chat-attach-chip-main">
                        <span class="chat-attach-chip-name" data-testid="attachment-tray-name" :title="file.name">{{ file.name }}</span>
                        <!-- A failure stands where a file's size does: its words, then Try again as a link. -->
                        <span v-if="file.status === 'failed'" class="chat-attach-chip-line">
                            <span class="chat-attach-chip-failure" data-testid="attachment-tray-failure" :title="failureText(file)">{{ failureText(file) }}</span>
                            <button v-if="file.failure?.canRetry"
                                    type="button"
                                    class="chat-attach-chip-retry"
                                    data-testid="attachment-tray-retry"
                                    @click="tray.retry(file.localId)">Try again</button>
                        </span>
                        <span v-else-if="file.status !== 'uploaded'"
                              class="chat-attach-progress"
                              role="progressbar"
                              aria-valuemin="0"
                              aria-valuemax="100"
                              :aria-valuenow="Math.round(file.progress * 100)"
                              :aria-label="`Uploading ${file.name}`">
                            <span class="chat-attach-progress-fill" :style="{ transform: `scaleX(${file.progress})` }"></span>
                        </span>
                        <span v-else class="chat-attach-chip-size">{{ formatFileSize(file.size) }}</span>
                    </span>
                    <IconButton icon="x"
                                icon-size="sm"
                                class="chat-attach-chip-remove"
                                :label="`Remove ${file.name}`"
                                data-testid="attachment-tray-remove"
                                @click="tray.remove(file.localId)" />
                </div>
                <span v-if="tray.notice" class="chat-attach-notice" data-testid="attachment-tray-notice">{{ tray.notice }}</span>
            </div>
        </template>

        <template v-else>
            <div v-if="images.length > 0" class="chat-attach-grid" data-testid="attachment-grid" :data-layout="layout" :style="gridStyle">
                <button v-for="(item, index) in shownImages"
                        :key="item.id"
                        type="button"
                        class="chat-attach-tile"
                        data-testid="attachment-image"
                        :data-unavailable="linkOf(item)?.isUnavailable ? 'true' : undefined"
                        :aria-label="`Open photo ${item.name}`"
                        :style="images.length === 1 ? singleStyle : undefined"
                        @click="openViewer(index)">
                    <span v-if="linkOf(item)?.isUnavailable && !imageSource(item)" class="chat-attach-unavailable"><Icon name="eye-off" size="sm" />Unavailable</span>
                    <img v-else-if="imageSource(item)"
                         v-reveal="reveal"
                         :src="imageSource(item) ?? undefined"
                         :alt="item.name"
                         :width="item.width ?? undefined"
                         :height="item.height ?? undefined"
                         decoding="async" />
                    <span v-if="index === shownImages.length - 1 && images.length > shownImages.length" class="chat-attach-more" data-testid="attachment-more">+{{ images.length - shownImages.length }}</span>
                </button>
            </div>

            <component :is="isPending || !linkOf(item)?.downloadUrl ? 'span' : 'a'"
                       v-for="item in files"
                       :key="item.id"
                       class="chat-attach-file"
                       data-testid="attachment-file"
                       :data-unavailable="linkOf(item)?.isUnavailable ? 'true' : undefined"
                       :href="isPending ? undefined : linkOf(item)?.downloadUrl ?? undefined"
                       :rel="isPending || !linkOf(item)?.downloadUrl ? undefined : 'noopener'"
                       :aria-label="isPending || !linkOf(item)?.downloadUrl ? undefined : `Download ${item.name}, ${formatFileSize(item.size)}`"
                       @click="onLinkClick($event, item)">
                <span class="chat-attach-file-icon" aria-hidden="true"><Icon name="file" /></span>
                <span class="chat-attach-file-main">
                    <span class="chat-attach-file-name" data-testid="attachment-file-name">{{ item.name }}</span>
                    <span class="chat-attach-file-size" data-testid="attachment-file-size">{{ linkOf(item)?.isUnavailable ? "Unavailable" : formatFileSize(item.size) }}</span>
                </span>
                <Icon v-if="!isPending && !linkOf(item)?.isUnavailable" name="download" size="sm" class="chat-attach-file-get" />
            </component>

            <Teleport v-if="isViewerMounted" :to="viewerHost ?? 'body'" :disabled="!viewerHost">
                <div class="chat-attach-viewer" @keydown="onViewerKeydown">
                    <Dialog :isOpen="viewerIndex !== null"
                            :title="viewed?.name ?? ''"
                            isPanel
                            isMedia
                            @close="viewerIndex = null">
                        <template #tools>
                            <span v-if="images.length > 1" class="chat-attach-viewer-count" data-testid="attachment-viewer-count">{{ (viewerIndex ?? 0) + 1 }} of {{ images.length }}</span>
                            <IconButton v-if="images.length > 1" icon="left" label="Previous photo" data-testid="attachment-viewer-prev" @click="step(-1)" />
                            <IconButton v-if="images.length > 1" icon="right" label="Next photo" data-testid="attachment-viewer-next" @click="step(1)" />
                            <a v-if="viewed && linkOf(viewed)?.downloadUrl"
                               class="chat-attach-viewer-get"
                               data-testid="attachment-viewer-download"
                               :href="linkOf(viewed)?.downloadUrl ?? undefined"
                               rel="noopener"
                               :aria-label="`Download ${viewed.name}`"
                               @click="onLinkClick($event, viewed)"><Icon name="download" /></a>
                            <IconButton icon="x" label="Close" data-testid="attachment-viewer-close" @click="viewerIndex = null" />
                        </template>
                        <img v-if="viewed && imageSource(viewed)"
                             class="chat-attach-viewer-image"
                             data-testid="attachment-viewer-image"
                             :src="imageSource(viewed) ?? undefined"
                             :alt="viewed.name" />
                    </Dialog>
                </div>
            </Teleport>
        </template>
    </div>
</template>

<style scoped>
.chat-attach {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
    min-width: 0;
}

.chat-attach.is-own {
    align-items: flex-end;
}

/* The strip over the composer's box: a chip per file, wrapping, rising into place as it appears. */
.chat-attach.is-strip {
    align-items: stretch;
}

.chat-attach-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    animation: chat-attach-strip-in var(--chat-t-base) var(--chat-ease-in);
}

@keyframes chat-attach-strip-in {
    from {
        opacity: 0;
        transform: translateY(6px);
    }
}

.chat-attach-chip {
    display: flex;
    gap: 8px;
    align-items: center;
    width: min(240px, 100%);
    padding: 6px 4px 6px 6px;
    background: var(--chat-surface);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-lg);
}

.chat-attach-chip[data-status="failed"] {
    background: var(--chat-danger-soft);
    border-color: transparent;
}

.chat-attach-chip-thumb {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    overflow: hidden;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-md);
}

.chat-attach-chip-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.chat-attach-chip-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    line-height: 1.3;
}

.chat-attach-chip-name {
    overflow: hidden;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--chat-text);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-attach-chip-size {
    font-size: 11.5px;
    color: var(--chat-muted);
}

/*
    A failed file's line under its name, as its size would be: the words give way, cut short, before
    Try again does, so the chip stays one size and Try again stays in reach.
*/
.chat-attach-chip-line {
    display: flex;
    gap: 6px;
    align-items: baseline;
    min-width: 0;
    font-size: 11.5px;
    color: var(--chat-danger-ink);
    white-space: nowrap;
}

.chat-attach-chip-failure {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Try again reads as a link in the line's own color, underlined so it is not color alone. */
.chat-attach-chip-retry {
    flex: none;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    background: transparent;
    border: 0;
}

.chat-attach-chip-retry:hover {
    text-decoration-thickness: 2px;
}

.chat-attach-chip-retry:focus-visible {
    border-radius: var(--chat-r-sm);
    outline: 2px solid var(--chat-focus-line);
    outline-offset: 1px;
}

/* Progress fills from the left by transform alone, so nothing lays out again as it moves. */
.chat-attach-progress {
    display: block;
    height: 4px;
    overflow: hidden;
    background: var(--chat-hover);
    border-radius: var(--chat-r-full);
}

.chat-attach-progress-fill {
    display: block;
    height: 100%;
    background: var(--chat-brand-fill);
    transform-origin: left;
    transition: transform var(--chat-t-fast) var(--chat-ease-state);
}

.chat-attach-chip-remove {
    width: 28px;
    height: 28px;
}

.chat-attach-notice {
    flex-basis: 100%;
    font-size: 12px;
    color: var(--chat-muted);
}

/*
 * The photo grid: one photo at its own shape, two side by side, three with the first standing
 * tall, four or more in a square of four. Each tile holds its place before its photo loads, which
 * needs the grid's own width: a row's column is sized to what it holds, so a width in percent
 * alone would be read against nothing and the tiles would wait for their photos to have a size.
 */
.chat-attach-grid {
    display: grid;
    gap: 2px;
    width: 320px;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--chat-r-lg);
}

.chat-attach-grid[data-layout="1"] {
    width: auto;
    max-width: 100%;
}

.chat-attach-grid[data-layout="2"] {
    grid-template-columns: 1fr 1fr;
}

.chat-attach-grid[data-layout="3"] {
    grid-template-rows: 1fr 1fr;
    grid-template-columns: 1fr 1fr;
}

.chat-attach-grid[data-layout="3"] .chat-attach-tile:first-child {
    grid-row: span 2;
    aspect-ratio: auto;
}

.chat-attach-grid[data-layout="4+"] {
    grid-template-columns: 1fr 1fr;
}

.chat-attach-tile {
    position: relative;
    display: block;
    width: 100%;
    max-width: 100%;
    padding: 0;
    overflow: hidden;
    aspect-ratio: 1;
    cursor: zoom-in;
    background: var(--chat-bubble);
    border: 0;
}

.chat-attach-tile:focus-visible {
    outline: 2px solid var(--chat-focus-line);
    outline-offset: -2px;
}

.chat-attach-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.chat-attach-unavailable {
    display: grid;
    gap: 4px;
    place-content: center;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: 12px;
    color: var(--chat-muted);
}

.chat-attach-more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 20px;
    font-weight: 700;
    color: var(--chat-tip-fg);
    background: var(--chat-scrim);
}

/* A file: a card with its icon, name and size, downloading under its name; as wide as the grid. */
.chat-attach-file {
    display: flex;
    gap: 10px;
    align-items: center;
    width: 320px;
    max-width: 100%;
    padding: 8px 12px 8px 8px;
    color: var(--chat-text);
    text-decoration: none;
    background: var(--chat-raised);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-lg);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

a.chat-attach-file:hover {
    color: var(--chat-text);
    text-decoration: none;
    background: var(--chat-hover);
}

a.chat-attach-file:focus-visible {
    outline: 2px solid var(--chat-focus-line);
    outline-offset: 1px;
}

.chat-attach-file-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-md);
}

.chat-attach-file-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
}

.chat-attach-file-name {
    overflow: hidden;
    font-size: 13.5px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-attach-file-size {
    font-size: 12px;
    color: var(--chat-muted);
}

.chat-attach-file-get {
    flex: none;
    color: var(--chat-icon);
}

/* The viewer's photo, whole within the dialog's body at any shape, and never past its own size. */
.chat-attach-viewer-image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
}

/* The viewer's download, drawn as the head's icon buttons beside it are. */
.chat-attach-viewer-get {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
    color: var(--chat-icon);
    border-radius: 50%;
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-attach-viewer-get:hover {
    color: var(--chat-text);
    background: var(--chat-hover);
}

.chat-attach-viewer-count {
    font-size: 12.5px;
    color: var(--chat-muted);
    font-variant-numeric: tabular-nums;
}

@media (prefers-reduced-motion: reduce) {
    .chat-attach-strip {
        animation-name: chat-crossfade;
    }

    .chat-attach-progress-fill {
        transition: none;
    }
}
</style>

<script setup lang="ts">
    import { computed, inject, nextTick, PropType, ref, watch } from "vue";
    import { AttachmentLink, attachmentViewsKey, AttachmentTray, formatFileSize, TrayFile } from "../composables/useAttachments.partial";
    import { AttachmentItem } from "../types.partial";
    import Dialog from "../ui/dialog.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import { useImageReveal, vReveal } from "../ui/imageReveal.partial";
    import { overlayHostOf } from "../ui/tooltip.partial";

    const props = defineProps({
        /** A message's files, in the order sent: photos drawn in a grid, other files as cards. */
        items: {
            type: Array as PropType<AttachmentItem[]>,
            default: () => []
        },

        /** The files waiting in a composer, drawn as its strip in place of a message's files. */
        tray: {
            type: Object as PropType<AttachmentTray | null>,
            default: null
        },

        /** Whether the message is the reader's own, which lines its files up at the column's end. */
        isOwn: {
            type: Boolean,
            default: false
        },

        /**
         * Whether the message is still being sent: its files draw from the copies picked, and no
         * link is asked, since Storage signs one only for a stored message.
         */
        isPending: {
            type: Boolean,
            default: false
        }
    });

    // #region Values

    /** The session's local copies and links, provided once by the chat; none outside it. */
    const views = inject(attachmentViewsKey, null);

    // One message's photos hide until decoded and reveal together.
    const reveal = useImageReveal();

    /** The photo the viewer shows, by its place among the message's photos; null while closed. */
    const viewerIndex = ref<number | null>(null);

    /** Set at the first opening and kept, so the viewer's closing returns focus as it fades. */
    const isViewerMounted = ref(false);
    const viewerHost = ref<HTMLElement | null>(null);

    /** The card being followed by the click the chat made itself, which its handler lets through. */
    let following: HTMLAnchorElement | null = null;

    /** The most tiles the grid draws; the last of them counts the rest. */
    const gridTiles = 4;

    /** A single photo's largest drawn size, in pixels. */
    const singleWidth = 320;
    const singleHeight = 360;

    // #endregion Values

    // #region Computed Values

    const images = computed((): AttachmentItem[] => props.items.filter(item => item.kind === "image"));

    const files = computed((): AttachmentItem[] => props.items.filter(item => item.kind !== "image"));

    const shownImages = computed((): AttachmentItem[] => images.value.slice(0, gridTiles));

    const layout = computed((): string => images.value.length >= gridTiles ? "4+" : String(images.value.length));

    /**
     * A single photo's box, sized from its declared size before it loads, within the largest
     * width and height, so the feed never moves when it arrives.
     */
    const singleStyle = computed((): Record<string, string> => {
        const item = images.value[0];
        const width = item?.width && item.width > 0 ? item.width : 4;
        const height = item?.height && item.height > 0 ? item.height : 3;
        const drawn = Math.min(singleWidth, width, singleHeight * width / height);

        return { aspectRatio: `${width} / ${height}`, width: `${Math.round(drawn)}px` };
    });

    const gridStyle = computed((): Record<string, string> | undefined => images.value.length === 1 ? { width: singleStyle.value.width } : undefined);

    const viewed = computed((): AttachmentItem | null => viewerIndex.value === null ? null : images.value[viewerIndex.value] ?? null);

    // #endregion Computed Values

    // #region Event Handlers

    function openViewer(index: number): void {
        viewerHost.value = overlayHostOf(document.activeElement) ?? null;
        isViewerMounted.value = true;
        // mounted first, so the dialog sees itself open and takes focus from the tile
        void nextTick(() => viewerIndex.value = index);
    }

    /**
     * A download whose link is near its end waits for a fresh one, then is followed from it, so
     * a link renewed late, or not at all while the network was away, never fails the click. When
     * no fresh link can be had, the one still held is followed while it lasts; past its end the
     * click does nothing, and the card is drawn as text once its link is gone.
     */
    function onLinkClick(event: MouseEvent, item: AttachmentItem): void {
        const anchor = event.currentTarget;
        if (!views || props.isPending || !(anchor instanceof HTMLAnchorElement) || anchor === following || views.links.isFresh(item)) {
            return;
        }

        event.preventDefault();
        const links = views.links;
        void links.fresh(item).then(async fresh => {
            const link = fresh ?? links.linkOf(item);
            if (!link?.downloadUrl || !anchor.isConnected) {
                return;
            }
            // the anchor takes the fresh link before it is followed
            await nextTick();
            if (!anchor.isConnected) {
                return;
            }
            // followed once, as it now reads, never held back again
            following = anchor;
            try {
                anchor.click();
            }
            finally {
                following = null;
            }
        });
    }

    /** Left and right step through the message's photos, round from the last to the first. */
    function onViewerKeydown(event: KeyboardEvent): void {
        if (event.key === "ArrowRight") {
            step(1);
        }
        else if (event.key === "ArrowLeft") {
            step(-1);
        }
    }

    // #endregion Event Handlers

    // #region Functions

    function step(by: number): void {
        if (viewerIndex.value === null || images.value.length < 2) {
            return;
        }

        viewerIndex.value = (viewerIndex.value + by + images.value.length) % images.value.length;
    }

    function linkOf(item: AttachmentItem): AttachmentLink | null {
        return props.isPending ? null : views?.links.linkOf(item) ?? null;
    }

    /** What a photo draws from: the person's own copy where this page sent it, else its link. */
    function imageSource(item: AttachmentItem): string | null {
        return views?.previewOf(item.id) ?? linkOf(item)?.url ?? null;
    }

    /** A failed file's words, the short ones beside its Try again. */
    function failureText(file: TrayFile): string {
        return file.failure?.canRetry ? file.failure.besideRetry : file.failure?.alone ?? "";
    }

    // #endregion Functions

    // #region Watchers

    // Each file on screen is linked, in one call with every other file drawn in the same moment,
    // and kept linked while the row is drawn; letting go when the files change or the row goes.
    watch(() => [props.items, props.isPending] as const, (_value, _old, onCleanup) => {
        if (!props.isPending && props.items.length > 0 && views) {
            onCleanup(views.links.subscribe(props.items));
        }
    }, { immediate: true });

    // #endregion Watchers
</script>
