<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="chat-attach" :class="{ 'is-strip': !!tray, 'is-own': isOwn }">
        <template v-if="tray">
            <div v-if="tray.files.length > 0 || tray.notice" class="chat-attach-strip" data-testid="attachment-strip">
                <div v-for="file in tray.files"
                     :key="file.localId"
                     class="chat-attach-chip"
                     data-testid="attachment-tray-file"
                     :data-status="file.status">
                    <span class="chat-attach-chip-thumb" aria-hidden="true">
                        <img v-if="file.localCopyUrl" :src="file.localCopyUrl" alt="" />
                        <Icon v-else name="file" />
                    </span>
                    <span class="chat-attach-chip-main">
                        <span class="chat-attach-chip-name"
                              data-testid="attachment-tray-name"
                              @mouseenter="onWordsEnter($event, file.name)"
                              @mouseleave="wordsTip.hideTip">{{ file.name }}</span>
                        <!-- A failure stands where a file's size does: its words, then Try again. -->
                        <span v-if="file.status === 'failed'" class="chat-attach-chip-line">
                            <span class="chat-attach-chip-failure"
                                  data-testid="attachment-tray-failure"
                                  @mouseenter="onWordsEnter($event, failureText(file))"
                                  @mouseleave="wordsTip.hideTip">{{ failureText(file) }}</span>
                            <Button v-if="file.failure?.canRetry"
                                    kind="ghost"
                                    size="sm"
                                    class="chat-attach-chip-retry"
                                    data-testid="attachment-tray-retry"
                                    @click="tray.retry(file.localId)">Try again</Button>
                        </span>
                        <span v-else-if="file.status !== 'uploaded'"
                              class="chat-attach-progress"
                              role="progressbar"
                              aria-valuemin="0"
                              aria-valuemax="100"
                              :aria-valuenow="Math.round(file.progress * 100)"
                              :aria-label="`Uploading ${file.name}`">
                            <span class="chat-attach-progress-fill" :style="{ transform: `scaleX(${file.progress})` }"></span>
                        </span>
                        <span v-else class="chat-attach-chip-size">{{ formatFileSize(file.size) }}</span>
                    </span>
                    <IconButton icon="x"
                                icon-size="sm"
                                class="chat-attach-chip-remove"
                                :label="`Remove ${file.name}`"
                                data-testid="attachment-tray-remove"
                                @click="tray.remove(file.localId)" />
                </div>
                <InlineNotice v-if="tray.notice" class="chat-attach-notice" :note="{ kind: 'info', text: tray.notice }" data-testid="attachment-tray-notice" />
            </div>

            <Tip :tip="wordsTip">{{ wordsTipText }}</Tip>
        </template>

        <template v-else>
            <div v-if="images.length > 0" class="chat-attach-grid" data-testid="attachment-grid" :data-layout="layout" :style="gridStyle">
                <button v-for="(item, index) in shownImages"
                        :key="item.id"
                        type="button"
                        class="chat-attach-tile"
                        data-testid="attachment-image"
                        :data-attachment-id="item.id"
                        :data-unavailable="linkOf(item)?.isUnavailable ? 'true' : undefined"
                        :aria-label="`Open photo ${item.name}`"
                        :style="images.length === 1 ? { aspectRatio: singleStyle.aspectRatio } : undefined"
                        @click="openViewer(index)">
                    <span v-if="linkOf(item)?.isUnavailable && !imageSource(item)" class="chat-attach-unavailable"><Icon name="eye-off" size="sm" />Unavailable</span>
                    <!--
                        The photo's stored preview, blurred, holds its shape and colours from the
                        first frame, before any link is signed; the photo sharpens over it once
                        decoded. A photo sent before previews has the tile's still fill alone.
                    -->
                    <span v-else-if="previewOf(item) || imageSource(item)" class="chat-attach-pic">
                        <img v-if="previewOf(item)" v-reveal="previewReveal" class="chat-attach-blur" data-testid="attachment-preview" :src="previewOf(item)!" alt="" aria-hidden="true" />
                        <img v-if="imageSource(item)"
                             v-reveal="reveal"
                             class="chat-attach-shot"
                             data-testid="attachment-photo"
                             :src="imageSource(item) ?? undefined"
                             :alt="item.name"
                             :width="item.width ?? undefined"
                             :height="item.height ?? undefined"
                             :data-broken="brokenPhotos.has(item.id) ? 'true' : undefined"
                             decoding="async"
                             @error="brokenPhotos.add(item.id)" />
                    </span>
                    <span v-if="index === shownImages.length - 1 && images.length > shownImages.length" class="chat-attach-more"><Badge tone="neutral" :label="`+${images.length - shownImages.length}`" data-testid="attachment-more" /></span>
                </button>
            </div>

            <!--
                A GIF: its still always draws in the single photo's box at its stored shape; KLIPY's
                looping mp4 lays over it, playing while on screen, or where motion is reduced from
                the first press of Play. It is unavailable only when its still or its video fails.
            -->
            <span v-for="item in gifs"
                  :key="item.id"
                  class="chat-attach-gif"
                  data-testid="attachment-gif"
                  :data-unavailable="deadGifs.has(item.id) ? 'true' : undefined"
                  :role="deadGifs.has(item.id) ? undefined : isMotionReduced ? 'group' : 'img'"
                  :aria-label="deadGifs.has(item.id) ? undefined : item.title || 'GIF'"
                  :style="boxStyle(item.width, item.height)">
                <template v-if="deadGifs.has(item.id)"><Icon name="eye-off" size="sm" />GIF unavailable</template>
                <template v-else>
                    <img :src="item.still"
                         alt=""
                         decoding="async"
                         @error="deadGifs.add(item.id)" />
                    <video v-if="!isMotionReduced || loadedGifs.has(item.id)"
                           :ref="element => watchGif(item.id, element)"
                           :src="item.url"
                           :poster="item.still"
                           :data-gif="item.id"
                           muted
                           loop
                           playsinline
                           preload="none"
                           @error="deadGifs.add(item.id)"></video>
                    <Badge tone="media" label="GIF" class="chat-attach-gif-badge" data-testid="attachment-gif-badge" />
                    <button v-if="isMotionReduced"
                            type="button"
                            class="chat-attach-gif-play"
                            data-testid="attachment-gif-play"
                            :aria-label="playedGifs.has(item.id) ? 'Pause GIF' : 'Play GIF'"
                            @click="togglePlay(item.id)"><Icon :name="playedGifs.has(item.id) ? 'pause' : 'play'" /></button>
                </template>
            </span>

            <component :is="isPending || !linkOf(item)?.downloadUrl ? 'span' : 'a'"
                       v-for="item in files"
                       :key="item.id"
                       class="chat-attach-file"
                       data-testid="attachment-file"
                       :data-unavailable="linkOf(item)?.isUnavailable ? 'true' : undefined"
                       :href="isPending ? undefined : linkOf(item)?.downloadUrl ?? undefined"
                       :rel="isPending || !linkOf(item)?.downloadUrl ? undefined : 'noopener'"
                       :aria-label="isPending || !linkOf(item)?.downloadUrl ? undefined : `Download ${item.name}, ${formatFileSize(item.size)}`"
                       @click="onLinkClick($event, item)"
                       @auxclick="onLinkClick($event, item)"
                       @pointerenter="renewLink(item)"
                       @focus="renewLink(item)"
                       @touchstart.passive="renewLink(item)">
                <span class="chat-attach-file-icon" aria-hidden="true"><Icon name="file" /></span>
                <span class="chat-attach-file-main">
                    <span class="chat-attach-file-name" data-testid="attachment-file-name">{{ item.name }}</span>
                    <span class="chat-attach-file-size" data-testid="attachment-file-size">{{ linkOf(item)?.isUnavailable ? "Unavailable" : formatFileSize(item.size) }}</span>
                </span>
                <Icon v-if="!linkOf(item)?.isUnavailable" name="download" size="sm" class="chat-attach-file-get" />
            </component>

            <Teleport v-if="isViewerMounted" :to="viewerHost ?? 'body'" :disabled="!viewerHost">
                <div class="chat-attach-viewer" @keydown="onViewerKeydown">
                    <Dialog :isOpen="viewerIndex !== null"
                            :title="viewed?.name ?? ''"
                            isPanel
                            isMedia
                            @close="viewerIndex = null">
                        <template #tools>
                            <span v-if="images.length > 1" class="chat-attach-viewer-count" data-testid="attachment-viewer-count">{{ (viewerIndex ?? 0) + 1 }} of {{ images.length }}</span>
                            <IconButton v-if="images.length > 1" icon="left" label="Previous photo" data-testid="attachment-viewer-prev" @click="step(-1)" />
                            <IconButton v-if="images.length > 1" icon="right" label="Next photo" data-testid="attachment-viewer-next" @click="step(1)" />
                            <a v-if="viewed && linkOf(viewed)?.downloadUrl"
                               class="chat-attach-viewer-get"
                               data-testid="attachment-viewer-download"
                               :href="linkOf(viewed)?.downloadUrl ?? undefined"
                               rel="noopener"
                               :aria-label="`Download ${viewed.name}`"
                               @click="onLinkClick($event, viewed)"
                               @auxclick="onLinkClick($event, viewed)"
                               @pointerenter="renewLink(viewed)"
                               @focus="renewLink(viewed)"
                               @touchstart.passive="renewLink(viewed)"><Icon name="download" /></a>
                            <IconButton icon="x" label="Close" data-testid="attachment-viewer-close" @click="viewerIndex = null" />
                        </template>
                        <img v-if="viewed && imageSource(viewed)"
                             class="chat-attach-viewer-image"
                             data-testid="attachment-viewer-image"
                             :src="imageSource(viewed) ?? undefined"
                             :alt="viewed.name" />
                    </Dialog>
                </div>
            </Teleport>
        </template>
    </div>
</template>

<style scoped>
.chat-attach {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
    min-width: 0;

    /*
     * Capped by the column it sits in. A column that starts its items at the left sizes each to its
     * content, and a photo grid's own width reads as content, so without this cap a single photo
     * would run past a narrow column instead of shrinking to it.
     */
    max-width: 100%;
}

.chat-attach.is-own {
    align-items: flex-end;
}

/* The strip over the composer's box: a chip per file, wrapping, rising into place as it appears. */
.chat-attach.is-strip {
    align-items: stretch;
}

.chat-attach-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    animation: chat-enter var(--chat-t-base) var(--chat-ease-in);
}

.chat-attach-chip {
    display: flex;
    gap: 8px;
    align-items: center;
    width: min(240px, 100%);
    padding: 6px 4px 6px 6px;
    background: var(--chat-surface);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-surface);
}

.chat-attach-chip[data-status="failed"] {
    background: var(--chat-danger-soft);
    border-color: transparent;
}

.chat-attach-chip-thumb {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    overflow: hidden;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-control);
}

.chat-attach-chip-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.chat-attach-chip-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    line-height: 1.3;
}

.chat-attach-chip-name {
    overflow: hidden;
    font-size: var(--chat-fs-ui);
    font-weight: 600;
    color: var(--chat-text);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-attach-chip-size {
    font-size: var(--chat-fs-small);
    color: var(--chat-muted);
}

/*
    A failed file's line under its name, as its size would be: the words give way, cut short, before
    Try again does, so the chip stays one size and Try again stays in reach.
*/
.chat-attach-chip-line {
    display: flex;
    gap: 6px;
    align-items: baseline;
    min-width: 0;
    font-size: var(--chat-fs-small);
    color: var(--chat-danger-ink);
    white-space: nowrap;
}

.chat-attach-chip-failure {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Try again never gives way; the failure's words do. */
.chat-attach-chip-retry {
    flex: none;
}

/* Progress fills from the left by transform alone, so nothing lays out again as it moves. */
.chat-attach-progress {
    display: block;
    height: 4px;
    overflow: hidden;
    background: var(--chat-hover);
    border-radius: var(--chat-r-full);
}

.chat-attach-progress-fill {
    display: block;
    height: 100%;
    background: var(--chat-brand-fill);
    transform-origin: left;
    transition: transform var(--chat-d-progress) var(--chat-ease-state);
}

/* The inline notice takes the strip's whole width, under the chips. */
.chat-attach-notice {
    flex-basis: 100%;
}

/*
 * The photo grid: one photo at its own shape, two side by side, three with the first standing
 * tall, four or more in a square of four. Each tile holds its place before its photo loads, which
 * needs the grid's own width: a row's column is sized to what it holds, so a width in percent
 * alone would be read against nothing and the tiles would wait for their photos to have a size.
 */
.chat-attach-grid {
    display: grid;
    gap: 2px;
    width: 320px;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--chat-r-surface);
}

.chat-attach-grid[data-layout="1"] {
    grid-template-columns: minmax(0, 1fr);
    width: auto;
    max-width: 100%;
}

.chat-attach-grid[data-layout="2"] {
    grid-template-columns: 1fr 1fr;
}

.chat-attach-grid[data-layout="3"] {
    grid-template-rows: 1fr 1fr;
    grid-template-columns: 1fr 1fr;
}

.chat-attach-grid[data-layout="3"] .chat-attach-tile:first-child {
    grid-row: span 2;
    aspect-ratio: auto;
}

.chat-attach-grid[data-layout="4+"] {
    grid-template-columns: 1fr 1fr;
}

.chat-attach-tile {
    position: relative;
    display: block;
    width: 100%;
    max-width: 100%;
    padding: 0;
    overflow: hidden;
    aspect-ratio: 1;
    cursor: zoom-in;
    background: var(--chat-bubble);
    border: 0;
    transition: background-color var(--chat-d-img-in) var(--chat-ease-state) var(--chat-d-img-in);
}

.chat-attach-tile:focus-visible {
    outline: var(--chat-focus-ring);
    outline-offset: -2px;
}

/* The picture's own layer, the tile's whole box: the preview under, the photo over it. */
.chat-attach-pic {
    position: absolute;
    inset: 0;
    overflow: hidden;
}

.chat-attach-pic > img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/*
    The stored preview is 16 by 12 pixels, drawn blurred and a little larger than the tile, so its
    blurred edge never shows. The photo fades in from nothing over it, so the preview stays whole
    for the length of that fade (its delay) and the photo sharpens over it, never over the row
    behind; it goes after, so nothing of it stays behind a photo with clear areas.
*/
.chat-attach-blur {
    filter: blur(10px);
    transform: scale(1.2);
    transition: opacity var(--chat-d-img-in) var(--chat-ease-state) var(--chat-d-img-in);
}

.chat-attach-pic:has(> .chat-attach-shot:not(.chat-img-hold)) > .chat-attach-blur {
    opacity: 0;
}

/*
    Once its photo has loaded and faded in the tile is the photo alone, so a photo's clear areas
    show the row behind it; the fill waits out the fade as the preview does. The reveal shows a
    broken photo too, so only one not marked broken clears it: a failed photo keeps its tile.
*/
.chat-attach-tile:has(> .chat-attach-pic > .chat-attach-shot:not(.chat-img-hold):not([data-broken])) {
    background-color: transparent;
}

/* A GIF: a single photo's box, sized from its stored width and height before anything loads. */
.chat-attach-gif {
    position: relative;
    display: block;
    max-width: 100%;
    overflow: hidden;
    background: var(--chat-bubble);
    border-radius: var(--chat-r-surface);
}

.chat-attach-gif img,
.chat-attach-gif video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Says it moves, and that it is KLIPY's, whether or not it is playing. */
.chat-attach-gif-badge {
    position: absolute;
    bottom: 6px;
    left: 6px;
    z-index: 1;
}

.chat-attach-gif-play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    margin: -22px 0 0 -22px;
    color: var(--chat-media-fg);
    cursor: pointer;
    background: var(--chat-media-scrim);
    border: 0;
    border-radius: var(--chat-r-full);
}

.chat-attach-gif-play:focus-visible {
    outline: var(--chat-focus-ring);
    outline-offset: 2px;
}

/* A GIF whose media is gone keeps its place, saying so as an unavailable photo does. */
.chat-attach-gif[data-unavailable="true"] {
    display: grid;
    gap: 4px;
    place-content: center;
    place-items: center;
    font-size: var(--chat-fs-small);
    color: var(--chat-muted);
}

.chat-attach-unavailable {
    display: grid;
    gap: 4px;
    place-content: center;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: var(--chat-fs-small);
    color: var(--chat-muted);
}

/* The photos past the grid's last tile, counted on a shade over it. */
.chat-attach-more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--chat-scrim);
}

/* A file: a card with its icon, name and size, downloading under its name; as wide as the grid. */
.chat-attach-file {
    display: flex;
    gap: 10px;
    align-items: center;
    width: 320px;
    max-width: 100%;
    padding: 8px 12px 8px 8px;
    color: var(--chat-text);
    text-decoration: none;
    background: var(--chat-raised);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-surface);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

a.chat-attach-file:hover {
    color: var(--chat-text);
    text-decoration: none;
    background: var(--chat-hover);
}

a.chat-attach-file:focus-visible {
    outline: var(--chat-focus-ring);
    outline-offset: 1px;
}

.chat-attach-file-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-control);
}

.chat-attach-file-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
}

.chat-attach-file-name {
    overflow: hidden;
    font-size: var(--chat-fs-ui);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-attach-file-size {
    font-size: var(--chat-fs-small);
    color: var(--chat-muted);
}

.chat-attach-file-get {
    flex: none;
    color: var(--chat-icon);
}

/* The viewer's photo, whole within the dialog's body at any shape, and never past its own size. */
.chat-attach-viewer-image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
}

/* The viewer's download, drawn as the head's icon buttons beside it are. */
.chat-attach-viewer-get {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
    color: var(--chat-icon);
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-attach-viewer-get:hover {
    color: var(--chat-text);
    background: var(--chat-hover);
}

.chat-attach-viewer-count {
    font-size: var(--chat-fs-ui);
    color: var(--chat-muted);
    font-variant-numeric: tabular-nums;
}
</style>

<script setup lang="ts">
    import { computed, inject, nextTick, onBeforeUnmount, PropType, reactive, ref, watch } from "vue";
    import { AttachmentLink, attachmentViewsKey, AttachmentTray, formatFileSize, isStoredPreview, TrayFile } from "../composables/useAttachments.partial";
    import { useIsMotionReduced } from "../ui/viewport.partial";
    import { AttachmentItem, FileItem, GifItem, isGifItem } from "../types.partial";
    import Badge from "../ui/badge.partial.obs";
    import Button from "../ui/button.partial.obs";
    import Dialog from "../ui/dialog.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import InlineNotice from "../ui/inlineNotice.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import { useImageReveal, vReveal } from "../ui/imageReveal.partial";
    import Tip from "../ui/tip.partial.obs";
    import { isCutShort, overlayHostOf, useTooltip } from "../ui/tooltip.partial";

    const props = defineProps({
        /** A message's files, in the order sent: photos drawn in a grid, other files as cards. */
        items: {
            type: Array as PropType<AttachmentItem[]>,
            default: () => []
        },

        /** The files waiting in a composer, drawn as its strip in place of a message's files. */
        tray: {
            type: Object as PropType<AttachmentTray | null>,
            default: null
        },

        /** Whether the message is the reader's own, which lines its files up at the column's end. */
        isOwn: {
            type: Boolean,
            default: false
        },

        /**
         * Whether the message is still being sent: its files draw from the copies picked, and no
         * link is asked, since Storage signs one only for a stored message.
         */
        isPending: {
            type: Boolean,
            default: false
        }
    });

    // #region Values

    /** The session's local copies and links, provided once by the chat; none outside it. */
    const views = inject(attachmentViewsKey, null);

    // One message's photos hide until decoded and reveal together. On the first load the page's
    // reveal waits for their previews, which the history page carries, and never for the photos.
    const reveal = useImageReveal({ isAwaited: false });
    const previewReveal = useImageReveal();

    /** The photo the viewer shows, by its place among the message's photos; null while closed. */
    const viewerIndex = ref<number | null>(null);

    /** Set at the first opening and kept, so the viewer's closing returns focus as it fades. */
    const isViewerMounted = ref(false);
    const viewerHost = ref<HTMLElement | null>(null);

    // One tooltip for the strip's words, anchored to the name or failure the pointer rests on and
    // shown only where the chip cut those words short, as the sidebar shows a room's name.
    const wordsAnchor = ref<HTMLElement>();
    const wordsTipText = ref("");
    const wordsTip = useTooltip(wordsAnchor, () => !isCutShort(wordsAnchor.value));

    /** The card being followed by the click the chat made itself, which its handler lets through. */
    let following: HTMLAnchorElement | null = null;

    /** The cards waiting on a fresh link, so a second click meanwhile joins the follow already coming. */
    const waiting = new Set<HTMLAnchorElement>();

    /** The most tiles the grid draws; the last of them counts the rest. */
    const gridTiles = 4;

    /** A single photo's or a GIF's largest drawn size, in pixels. */
    const singleWidth = 320;
    const singleHeight = 360;

    /** Whether the person asked for less motion, which holds every GIF still until it is played. */
    const isMotionReduced = useIsMotionReduced();

    /** The photos that failed to load, which drop their previews. */
    const brokenPhotos = reactive(new Set<string>());

    /** The GIFs whose media could not be loaded, drawn as unavailable. */
    const deadGifs = reactive(new Set<string>());

    /** The GIFs playing by a press where motion is reduced. */
    const playedGifs = reactive(new Set<string>());

    /** The GIFs whose video a first press mounted where motion is reduced, so a pause keeps its place. */
    const loadedGifs = reactive(new Set<string>());

    /** Each GIF's video by id, while drawn. */
    const gifVideos = new Map<string, HTMLVideoElement>();

    /** Plays a GIF while it is on screen and pauses it once it leaves, so a long history does not play unseen. */
    const gifObserver = typeof IntersectionObserver === "undefined"
        ? null
        : new IntersectionObserver(entries => entries.forEach(entry => {
            const video = entry.target as HTMLVideoElement;
            const id = video.dataset.gif ?? "";
            if (entry.isIntersecting && (!isMotionReduced.value || playedGifs.has(id))) {
                play(video);
            }
            else {
                video.pause();
            }
        }));

    // #endregion Values

    // #region Computed Values

    // Only the kinds this client knows are drawn, so one a later platform adds is never a broken file card.
    const images = computed((): FileItem[] => props.items.filter((item): item is FileItem => item.kind === "image"));

    const files = computed((): FileItem[] => props.items.filter((item): item is FileItem => item.kind === "file"));

    const gifs = computed((): GifItem[] => props.items.filter(isGifItem));

    const shownImages = computed((): FileItem[] => images.value.slice(0, gridTiles));

    const layout = computed((): string => images.value.length >= gridTiles ? "4+" : String(images.value.length));

    /**
     * A single photo's box, sized from its declared size before it loads, within the largest
     * width and height, so the feed never moves when it arrives. The grid carries the width alone
     * and its one column follows it, so a narrow screen shrinks the whole box and the tile only
     * keeps the photo's shape.
     */
    const singleStyle = computed((): Record<string, string> => boxStyle(images.value[0]?.width, images.value[0]?.height));

    const gridStyle = computed((): Record<string, string> | undefined => images.value.length === 1 ? { width: singleStyle.value.width } : undefined);

    const viewed = computed((): FileItem | null => viewerIndex.value === null ? null : images.value[viewerIndex.value] ?? null);

    // #endregion Computed Values

    // #region Event Handlers

    /** The pointer rests on a chip's name or failure: those words are the tip's anchor, shown whole if the chip cut them. */
    function onWordsEnter(event: MouseEvent, words: string): void {
        wordsAnchor.value = event.currentTarget instanceof HTMLElement ? event.currentTarget : undefined;
        wordsTipText.value = words;
        wordsTip.onPointerEnter();
    }

    function openViewer(index: number): void {
        viewerHost.value = overlayHostOf(document.activeElement) ?? null;
        isViewerMounted.value = true;
        // mounted first, so the dialog sees itself open and takes focus from the tile
        void nextTick(() => viewerIndex.value = index);
    }

    /**
     * A card or download link is given a fresh link as the person's pointer, focus or touch reaches
     * it, so whatever gesture follows (a click, a new tab, the context menu) opens a link with its
     * time ahead of it, opened by the browser itself.
     */
    function renewLink(item: FileItem): void {
        if (views && !props.isPending && !views.links.isFresh(item)) {
            void views.links.fresh(item);
        }
    }

    /**
     * A card's link is the browser's to open, for every gesture, while it lasts: a link in its last
     * minute, when it is renewed, still opens. Only a link that ended unseen, as in a tab the
     * browser held back or a computer that slept, is held: the card waits for a fresh link, and a
     * plain click is then followed from it, in the same tab, which a download needs anyway. A
     * gesture asking for a new tab or window is not made again for the person, as a click made
     * after an await is not theirs to the browser, which may block or misread it; the card takes
     * the fresh link and their next gesture opens it. A card is followed once however often it is
     * clicked while it waits. The context menu's button is left to the browser.
     */
    function onLinkClick(event: MouseEvent, item: FileItem): void {
        const anchor = event.currentTarget;
        if (!views || props.isPending || !(anchor instanceof HTMLAnchorElement) || anchor === following
            || (event.type === "auxclick" && event.button !== 1)) {
            return;
        }

        if (waiting.has(anchor)) {
            event.preventDefault();
            return;
        }

        if (views.links.linkOf(item)?.downloadUrl) {
            return;
        }

        event.preventDefault();
        const isPlainClick = event.type === "click" && event.button === 0
            && !event.ctrlKey && !event.metaKey && !event.shiftKey && !event.altKey;
        waiting.add(anchor);
        void views.links.fresh(item).then(async fresh => {
            if (!isPlainClick || !fresh?.downloadUrl) {
                return;
            }
            // the anchor takes the fresh link before it is followed
            await nextTick();
            if (!anchor.isConnected) {
                return;
            }
            // followed once, as it now reads, never held back again
            following = anchor;
            try {
                anchor.click();
            }
            finally {
                following = null;
            }
        }).finally(() => waiting.delete(anchor));
    }

    /** Left and right step through the message's photos, round from the last to the first. */
    function onViewerKeydown(event: KeyboardEvent): void {
        if (event.key === "ArrowRight") {
            step(1);
        }
        else if (event.key === "ArrowLeft") {
            step(-1);
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * A single photo's or a GIF's box, sized from its declared size before it loads, within the
     * largest width and height, so the feed never moves when it arrives.
     */
    function boxStyle(declaredWidth: number | null | undefined, declaredHeight: number | null | undefined): Record<string, string> {
        const width = declaredWidth && declaredWidth > 0 ? declaredWidth : 4;
        const height = declaredHeight && declaredHeight > 0 ? declaredHeight : 3;
        const drawn = Math.min(singleWidth, width, singleHeight * width / height);

        return { aspectRatio: `${width} / ${height}`, width: `${Math.round(drawn)}px` };
    }

    /** Holds a GIF's video while it is drawn, watched for coming on screen. */
    function watchGif(id: string, element: unknown): void {
        const held = gifVideos.get(id);
        if (element === held) {
            return;
        }

        if (held) {
            gifObserver?.unobserve(held);
            gifVideos.delete(id);
        }

        if (element instanceof HTMLVideoElement) {
            gifVideos.set(id, element);
            gifObserver?.observe(element);
        }
    }

    /** Where motion is reduced, a press mounts the video and plays it, and the next pauses it. */
    function togglePlay(id: string): void {
        if (playedGifs.has(id)) {
            playedGifs.delete(id);
            gifVideos.get(id)?.pause();
            return;
        }

        playedGifs.add(id);
        loadedGifs.add(id);
        // the press mounts the video, so it plays once it is drawn
        void nextTick(() => {
            const video = gifVideos.get(id);
            if (video && playedGifs.has(id)) {
                play(video);
            }
        });
    }

    /** Plays a video, as far as the browser allows: one that refuses stays on its still. */
    function play(video: HTMLVideoElement): void {
        try {
            void Promise.resolve(video.play()).catch(() => undefined);
        }
        catch {
            // a browser with no media playback keeps the still
        }
    }

    function step(by: number): void {
        if (viewerIndex.value === null || images.value.length < 2) {
            return;
        }

        viewerIndex.value = (viewerIndex.value + by + images.value.length) % images.value.length;
    }

    function linkOf(item: FileItem): AttachmentLink | null {
        return props.isPending ? null : views?.links.linkOf(item) ?? null;
    }

    /**
     * The photo's stored blurred preview, when it carries one in the one form a preview may take;
     * none once the photo failed to load, so a stand-in never outlives a photo that cannot be drawn.
     */
    function previewOf(item: FileItem): string | null {
        return isStoredPreview(item.preview) && !brokenPhotos.has(item.id) ? item.preview : null;
    }

    /** What a photo draws from: the person's own copy where this page sent it, else its link. */
    function imageSource(item: FileItem): string | null {
        return views?.localCopyOf(item.id) ?? linkOf(item)?.url ?? null;
    }

    /** A failed file's words, the short ones beside its Try again. */
    function failureText(file: TrayFile): string {
        return file.failure?.canRetry ? file.failure.besideRetry : file.failure?.alone ?? "";
    }

    // #endregion Functions

    // #region Watchers

    // Each file on screen is linked, in one call with every other file drawn in the same moment,
    // and kept linked while the row is drawn; letting go when the files change or the row goes.
    watch(() => [props.items, props.isPending] as const, (_value, _old, onCleanup) => {
        if (!props.isPending && props.items.length > 0 && views) {
            onCleanup(views.links.subscribe(props.items));
        }
    }, { immediate: true });

    // A change of the setting starts every GIF over by the one rule: reduced motion unmounts the
    // videos, which stops them, and motion allowed mounts them, which the observer plays on screen.
    watch(isMotionReduced, () => {
        playedGifs.clear();
        loadedGifs.clear();
    });

    // #endregion Watchers

    onBeforeUnmount(() => {
        gifObserver?.disconnect();
    });
</script>
