<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <header class="chat-header">
        <span class="chat-header-title">{{ title }}</span>
        <span v-if="connection" class="label label-warning" data-testid="connection-badge">Reconnecting…</span>
        <span v-else-if="isBehind" class="label label-default" data-testid="catching-up-badge">Catching up…</span>
        <button v-if="isPushOffered" type="button" class="btn btn-xs btn-default" data-testid="push-offer" @click="emit('turnOnPush')">Turn on notifications</button>
    </header>
    <div v-if="banner" class="alert alert-warning chat-header-banner" data-testid="service-banner">{{ banner }}</div>
</template>

<style scoped>
.chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-interface-soft, #dfe0e1);
}

.chat-header-title {
    font-weight: 600;
}

.chat-header-banner {
    margin: 0;
    border-radius: 0;
}
</style>

<script setup lang="ts">
    import { PropType } from "vue";
    import { ChatError } from "../types.partial";

    const emit = defineEmits<{
        (e: "turnOnPush"): void
    }>();

    defineProps({
        title: {
            type: String,
            default: ""
        },

        /** The live connection's trouble, or null when it is healthy. */
        connection: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** The platform's sentence about the service, or about this Rock being too old; null for none. */
        banner: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether the channel's catch-up failed and is trying again, so messages may be missing. */
        isBehind: {
            type: Boolean,
            default: false
        },

        /** Whether to offer "Turn on notifications"; the click is what asks the browser. */
        isPushOffered: {
            type: Boolean,
            default: false
        }
    });
</script>
