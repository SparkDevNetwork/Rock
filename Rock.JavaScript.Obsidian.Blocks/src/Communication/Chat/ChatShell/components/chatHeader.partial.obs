<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <header v-if="!isEmpty" class="chat-header" :class="{ 'is-phone': isPhone }" data-testid="chat-header">
        <IconButton v-if="isPhone"
                    class="chat-header-back"
                    icon="left"
                    label="Back"
                    data-testid="header-back"
                    @click="emit('back')" />

        <!-- A room's mark and title open its details; with no room there is nothing to open. -->
        <component :is="kind ? 'button' : 'div'"
                   class="chat-header-id"
                   v-bind="detailsAttributes"
                   @click="kind && emit('details')">
            <span v-if="kind === 'channel'" class="chat-header-ic">
                <Icon :name="isPublic ? 'hash' : 'lock'" />
            </span>
            <Avatar v-else-if="kind === 'person' && faces.length > 0" :people="faces" :size="36" />
            <GroupFace v-else-if="kind === 'group'" :people="faces" :count="groupOtherCount" :size="36" />

            <span class="chat-header-title">
                <span class="chat-header-name-row">
                    <!--
                        Where focus goes when a conversation slides in on a phone: the button around
                        it, which holds nothing focusable, or with no room to open, the title itself.
                    -->
                    <b class="chat-header-name"
                       data-testid="header-title"
                       :tabindex="kind ? undefined : -1"
                       :data-header-focus="kind ? undefined : ''">{{ title }}</b>
                    <span v-if="kind" class="chat-header-chev"><Icon name="down" size="xs" /></span>
                </span>
                <span v-if="connection" class="chat-header-sub" data-testid="connection-badge" data-tone="warning">
                    <span class="chat-header-live" data-testid="connection-dot"></span>Reconnecting…
                </span>
                <span v-else-if="isBehind" class="chat-header-sub" data-testid="catching-up-badge" data-tone="info">
                    <span class="chat-header-live"></span>Catching up on new messages…
                </span>
                <span v-else-if="shownSubtitle" class="chat-header-sub" data-testid="header-subtitle">{{ shownSubtitle }}</span>
            </span>
        </component>

        <div class="chat-header-actions">
            <!-- A channel's leaders over its head count, or the people icon where none can be shown. -->
            <button v-if="membersKind === 'channel' && facts && !isPhone"
                    type="button"
                    class="chat-header-pile"
                    data-testid="header-members"
                    :aria-label="memberCountLabel"
                    :aria-expanded="isMembersOpen ? 'true' : 'false'"
                    @click="emit('members')">
                <Avatar v-if="pileFaces.length > 0" :people="pileFaces" :size="26" />
                <span v-else class="chat-header-pile-ic"><Icon name="users" size="sm" /></span>
                {{ facts.member_count.toLocaleString() }}
            </button>

            <IconButton v-else-if="membersKind === 'group' && !isPhone"
                        icon="users"
                        :label="groupMembersLabel"
                        tooltip="Members"
                        data-testid="header-members"
                        :aria-expanded="isMembersOpen ? 'true' : 'false'"
                        @click="emit('members')" />

            <IconButton v-if="isThreadsOffered && !isPhone"
                        icon="thread"
                        label="Threads"
                        data-testid="header-threads"
                        :aria-expanded="isThreadsOpen ? 'true' : 'false'"
                        @click="emit('threads')" />

            <IconButton v-if="isMentionsOffered && !isPhone"
                        class="chat-header-dotted"
                        icon="at"
                        :label="hasMentionDot ? 'Mentions, new mentions' : 'Mentions'"
                        tooltip="Mentions"
                        data-testid="header-mentions"
                        :aria-expanded="isMentionsOpen ? 'true' : 'false'"
                        @click="emit('mentions')">
                <span v-if="hasMentionDot" class="chat-header-dot" data-testid="header-mentions-dot" aria-hidden="true"></span>
            </IconButton>

            <!-- A worded pill with no glyph, so the room's notify menu stays the header's only bell. -->
            <button v-if="isPushOffered && !isPhone"
                    type="button"
                    class="chat-header-push is-brand is-sm"
                    data-testid="push-offer"
                    @click="emit('turnOnPush')">Turn on notifications</button>

            <!-- The room's notify menu, the bell drawn as its mode; kept on a phone, where Star moves into More. -->
            <span v-if="isPrefsOffered" class="chat-header-menu" data-testid="header-notify">
                <Menu :icon="notifyIcon"
                      label="Notifications"
                      heading="Notify me about"
                      :items="notifyItems"
                      @select="onNotifySelect" />
            </span>

            <IconButton v-if="isPrefsOffered && !isPhone"
                        :icon="isStarred ? 'star-f' : 'star'"
                        :label="isStarred ? 'Unstar' : 'Star'"
                        :aria-pressed="isStarred ? 'true' : 'false'"
                        data-testid="header-star"
                        @click="emit('star')" />

            <span v-if="isPhone && moreItems.length > 0" class="chat-header-more" data-testid="header-more">
                <Menu icon="dots" :label="hasMentionDot ? 'More, new mentions' : 'More'" :items="moreItems" @select="onMoreSelect" />
                <!-- Over the menu's button, which draws no mark of its own. -->
                <span v-if="hasMentionDot" class="chat-header-dot" data-testid="header-more-dot" aria-hidden="true"></span>
            </span>
        </div>
    </header>

    <Transition name="chat-banner" @enter="onBannerEnter" @afterEnter="onBannerSettled" @leave="onBannerLeave">
        <div v-if="connectionBanner"
             class="chat-conn-banner"
             data-testid="connection-banner"
             :data-tone="connectionBanner"
             :role="connectionBanner === 'warning' ? 'alert' : 'status'">
            <div v-if="connectionBanner === 'warning'" class="chat-conn-banner-row">
                <Icon name="wifi-off" size="sm" />
                <span><b>You're offline.</b> Reconnecting now. You can send again once you're back.</span>
            </div>
            <div v-else class="chat-conn-banner-row">
                <span class="chat-spinner"></span>
                <span>Back online. Catching up on new messages…</span>
            </div>
        </div>
    </Transition>

    <div v-if="banner"
         class="chat-service-banner"
         data-testid="service-banner"
         :data-tone="isUpdateRequired ? 'info' : 'warning'"
         role="status">
        <Icon :name="isUpdateRequired ? 'refresh' : 'alert'" />
        <span>{{ banner }}</span>
    </div>

    <div class="chat-conn-bar-host">
        <!-- A line of no height at the feed's top, so the sweep sits over the messages rather than pushing them down. -->
        <Transition name="chat-fade">
            <div v-if="connection" class="chat-conn-bar" data-testid="connection-sweep"></div>
        </Transition>
    </div>
</template>

<style scoped>
.chat-header {
    display: flex;
    flex: none;
    gap: 12px;
    align-items: center;
    height: 64px;
    padding: 0 12px 0 20px;
    background: var(--chat-surface);
    border-bottom: 1px solid var(--chat-line);
}

.chat-header.is-phone {
    padding-left: 12px;
}

/* Reached through the button's own root, which a scoped rule here does not mark. */
.chat-header :deep(.chat-header-back) {
    margin-left: -8px;
}

/*
    The room's mark and title, the button that opens the room's details, pulled back by its left
    padding so the mark still lines up with the feed's edge.
*/
.chat-header-id {
    /* the button's fill, set by its state alone, which a group's mark rings its faces in over the bar */
    --chat-header-id-fill: transparent;
    --chat-av-ring-over: var(--chat-header-id-fill);

    display: flex;
    flex: 0 1 auto;
    gap: 12px;
    align-items: center;
    min-width: 0;
    padding: 4px 10px 4px 6px;
    margin-left: -6px;
    font: inherit;
    color: inherit;
    text-align: left;
    background: var(--chat-header-id-fill);
    border: 0;
    border-radius: var(--chat-r-lg);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

button.chat-header-id:hover {
    --chat-header-id-fill: var(--chat-hover);
}

button.chat-header-id:active {
    --chat-header-id-fill: var(--chat-press);
}

.chat-header-name-row {
    display: flex;
    gap: 4px;
    align-items: center;
    min-width: 0;
}

/* The chevron says the title opens something, and nudges down on hover. */
.chat-header-chev {
    display: inline-flex;
    flex: none;
    color: var(--chat-icon);
    opacity: .7;
    transition: transform var(--chat-t-fast) var(--chat-ease-in), opacity var(--chat-t-fast) var(--chat-ease-state);
}

button.chat-header-id:hover .chat-header-chev {
    opacity: 1;
    transform: translateY(1px);
}

.is-phone .chat-header-id {
    gap: 10px;
    padding-right: 6px;
}

.chat-header-ic {
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-hdr-ic);
}

.chat-header-title {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
}

.chat-header-name {
    overflow: hidden;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chat-header-sub {
    overflow: hidden;
    font-size: 12.5px;
    color: var(--chat-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* The live dot pulses while the connection's state is being worked out. */
.chat-header-live {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 6px;
    vertical-align: 1px;
    background: var(--chat-warning);
    border-radius: 50%;
    animation: chat-header-pulse var(--chat-d-pulse) var(--chat-ease-state) infinite;
}

.chat-header-sub[data-tone="info"] .chat-header-live {
    background: var(--chat-info);
}

.chat-header-actions {
    display: flex;
    gap: 2px;
    align-items: center;
    margin-left: auto;
}

/* The push offer, the design's small button in the church's color, set a little apart from the icons beside it. */
.chat-header-push {
    display: inline-flex;
    flex: none;
    align-items: center;
    margin: 0 4px;
    font-weight: 600;
    white-space: nowrap;
    border: 0;
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-header-push.is-sm {
    height: 28px;
    padding: 0 11px;
    font-size: 12.5px;
}

.chat-header-push.is-brand {
    color: var(--chat-on-brand);
    background: var(--chat-brand-fill);
}

.chat-header-push.is-brand:hover {
    background: color-mix(in srgb, var(--chat-brand-fill) 88%, var(--chat-shade));
}

.chat-header-more,
.chat-header-menu {
    position: relative;
    display: inline-flex;
}

.chat-header-actions :deep(.chat-header-dotted) {
    position: relative;
}

/* A new mention, over the button's corner, ringed in the bar's color so it reads apart from the icon. */
.chat-header-dot {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 8px;
    height: 8px;
    pointer-events: none;
    background: var(--chat-danger);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--chat-surface);
}

/* The facepile: up to three faces then the head count, in one pill-shaped button. */
.chat-header-pile {
    display: inline-flex;
    flex: none;
    gap: 6px;
    align-items: center;
    height: 34px;
    padding: 0 10px 0 6px;
    margin-right: 4px;
    font: inherit;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--chat-text-2);
    background: transparent;
    border: 0;
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-header-pile:hover,
.chat-header-pile[aria-expanded="true"] {
    background: var(--chat-hover);
}

.chat-header-pile :deep(.chat-av) {
    font-size: 10px !important;
}

/* A room whose faces cannot be shown draws the people icon in a face's place. */
.chat-header-pile-ic {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    color: var(--chat-icon);
    background: var(--chat-hover);
    border-radius: 50%;
}

/* The banner opens by its own height, which script measures, since grid rows do not animate in Safari 14. */
.chat-conn-banner {
    flex: none;
    overflow: hidden;
    background: var(--chat-warning-soft);
}

.chat-conn-banner[data-tone="info"] {
    background: var(--chat-info-soft);
}

.chat-conn-banner-row {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 9px 20px;
    font-size: 13px;
    color: var(--chat-text);
    border-bottom: 1px solid var(--chat-conn-line-warning);
}

.chat-conn-banner-row :deep(.chat-ic) {
    color: var(--chat-warning-ink);
}

.chat-conn-banner[data-tone="info"] .chat-conn-banner-row {
    color: var(--chat-text);
    border-bottom-color: var(--chat-conn-line-info);
}

.chat-conn-banner[data-tone="info"] .chat-spinner {
    color: var(--chat-info-ink);
}

.chat-banner-enter-active,
.chat-banner-leave-active {
    transition: height var(--chat-t-panel) var(--chat-ease-in);
}

.chat-service-banner {
    display: flex;
    flex: none;
    gap: 10px;
    align-items: center;
    margin: 10px 16px 0;
    padding: 10px 12px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--chat-text);
    background: var(--chat-warning-soft);
    border-radius: var(--chat-r-lg);
}

.chat-service-banner :deep(.chat-ic) {
    color: var(--chat-warning-ink);
}

.chat-service-banner[data-tone="info"] {
    background: var(--chat-info-soft);
}

.chat-service-banner[data-tone="info"] :deep(.chat-ic) {
    color: var(--chat-info-ink);
}

.chat-conn-bar-host {
    position: relative;
    z-index: 6;
    flex: none;
    height: 0;
}

.chat-conn-bar {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
    overflow: hidden;
}

.chat-conn-bar::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40%;
    content: "";
    background: linear-gradient(90deg, transparent, var(--chat-warning), transparent);
    animation: chat-header-sweep var(--chat-d-sweep) var(--chat-ease-state) infinite;
}

.chat-fade-enter-active,
.chat-fade-leave-active {
    transition: opacity var(--chat-t-base) var(--chat-ease-state);
}

.chat-fade-enter-from,
.chat-fade-leave-to {
    opacity: 0;
}

@keyframes chat-header-pulse {
    50% {
        opacity: .3;
    }
}

@keyframes chat-header-sweep {
    from {
        transform: translateX(-100%);
    }

    to {
        transform: translateX(260%);
    }
}

/* Looping decoration stops; the words beside it still say what is happening. */
@media (prefers-reduced-motion: reduce) {
    .chat-header-live,
    .chat-conn-bar::after {
        animation: none;
    }

    button.chat-header-id:hover .chat-header-chev {
        transform: none;
    }
}
</style>

<script setup lang="ts">
    import { computed, PropType, ref, watch } from "vue";
    import { ChatCampusBag } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatShell/chatCampusBag";
    import { notifyOptionsFor } from "../composables/usePrefs.partial";
    import { ChannelFacts, ChatError, ChatPerson } from "../types.partial";
    import Avatar, { AvatarPerson } from "../ui/avatar.partial.obs";
    import GroupFace from "../ui/groupFace.partial.obs";
    import { personFace } from "../ui/face.partial";
    import Icon from "../ui/icon.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import Menu, { MenuItem } from "../ui/menu.partial.obs";

    // #region Types

    /** What the room is, which decides the mark beside its title. */
    export type HeaderRoomKind = "channel" | "person" | "group";

    // #endregion Types

    const emit = defineEmits<{
        (e: "turnOnPush"): void,
        (e: "back"): void,
        (e: "backOnline"): void,
        (e: "threads"): void,
        (e: "mentions"): void,
        (e: "members"): void,
        (e: "details"): void,
        /** A notify mode other than the room's own was chosen from the bell's menu. */
        (e: "notify", mode: "all" | "mentions" | "silent"): void,
        /** Star or Unstar, from the header or the phone's More. */
        (e: "star"): void
    }>();

    const props = defineProps({
        title: {
            type: String,
            default: ""
        },

        /**
         * The line under the title the shell worked out, such as a draft's or a group's "3 people",
         * which stands until the room's facts are read; null for none.
         */
        subtitle: {
            type: String as PropType<string | null>,
            default: null
        },

        /** What chat_get_channel answered about the open room, once read; the subtitle comes from it. */
        facts: {
            type: Object as PropType<ChannelFacts | null>,
            default: null
        },

        /** The church's campuses, which name a person's campus. */
        campuses: {
            type: Array as PropType<ChatCampusBag[]>,
            default: () => []
        },

        /** What the room is, or null to draw no mark beside the title. */
        kind: {
            type: String as PropType<HeaderRoomKind | null>,
            default: null
        },

        /** Whether a channel is open to anyone who may join, which draws a hash rather than a lock. */
        isPublic: {
            type: Boolean,
            default: false
        },

        /** The other people of a direct message or group, with their photos, as the sidebar sent them. */
        people: {
            type: Array as PropType<ChatPerson[]>,
            default: () => []
        },

        /**
         * How many other people a group holds as the sidebar counted them, which can be more than
         * the people it sent; null for a named group, whose row carries no count.
         */
        otherCount: {
            type: Number as PropType<number | null>,
            default: null
        },

        /** The live connection's trouble, or null when it is healthy. */
        connection: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** The platform's sentence about the service, or about this Rock being too old; null for none. */
        banner: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether the banner says Rock must be updated, which is told in the info tone. */
        isUpdateRequired: {
            type: Boolean,
            default: false
        },

        /** Whether the channel's catch-up failed and is trying again, so messages may be missing. */
        isBehind: {
            type: Boolean,
            default: false
        },

        /** Whether to offer "Turn on notifications", as the church's prompt timing says; the click is what asks the browser. */
        isPushOffered: {
            type: Boolean,
            default: false
        },

        /** Whether the room is the person's own, so its notify menu and Star are offered. */
        isPrefsOffered: {
            type: Boolean,
            default: false
        },

        /** The room's notify mode for the person, which the bell draws and its menu checks. */
        notifyMode: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether the room is in the person's Starred, which presses Star. */
        isStarred: {
            type: Boolean,
            default: false
        },

        /** Whether the chat is in its one-pane phone layout, which leads with Back and folds actions into a menu. */
        isPhone: {
            type: Boolean,
            default: false
        },

        /** Whether to offer the Threads panel, which needs a conversation that exists. */
        isThreadsOffered: {
            type: Boolean,
            default: false
        },

        /** Whether the Threads panel is open, which its button shows as expanded. */
        isThreadsOpen: {
            type: Boolean,
            default: false
        },

        /** Whether to offer the mentions inbox, which needs the person's chat to be loaded. */
        isMentionsOffered: {
            type: Boolean,
            default: false
        },

        /**
         * Whether to offer the members panel, which needs a conversation that exists; a channel's
         * facepile, a group's Members button, never in a conversation of two.
         */
        isMembersOffered: {
            type: Boolean,
            default: false
        },

        /** Whether the members panel is open, which its button shows as expanded. */
        isMembersOpen: {
            type: Boolean,
            default: false
        },

        /** Whether the mentions inbox is open, which its button shows as expanded. */
        isMentionsOpen: {
            type: Boolean,
            default: false
        },

        /** Whether a mention by name is newer than the person's last look at the inbox. */
        hasMentionDot: {
            type: Boolean,
            default: false
        },

        /** Whether no conversation or draft is open, which leaves the bar out and keeps only the banners. */
        isEmpty: {
            type: Boolean,
            default: false
        }
    });

    // #region Values

    /** Set while the connection is lost and kept until the catch-up after it is done, so "Back online" follows only an outage. */
    const wasOffline = ref(!!props.connection);

    // #endregion Values

    // #region Computed Values

    /**
     * The line under the title, from the room's facts once read: a channel's description, the
     * other person's campus when they show their details, or a group's head count, a named
     * group's included. Until then, whatever the shell worked out.
     */
    const shownSubtitle = computed((): string | null => {
        const facts = props.facts;
        if (!facts) {
            return props.subtitle;
        }

        switch (props.kind) {
            case "channel":
                return facts.description?.trim() || null;

            case "person": {
                const campusId = facts.people[0]?.details?.campus_id?.toLowerCase();
                return campusId ? props.campuses.find(campus => campus.guid.toLowerCase() === campusId)?.name ?? null : null;
            }

            case "group":
                // the listed count leaves out anyone not shown, so a group can be down to one
                return facts.member_count > 0 ? `${facts.member_count.toLocaleString()} ${facts.member_count === 1 ? "person" : "people"}` : null;

            default:
                return props.subtitle;
        }
    });

    /**
     * A person's one face, or a group's people. A named group's row carries none, so its people
     * come from the room's facts once they are read.
     */
    const faces = computed((): AvatarPerson[] => {
        if (props.kind === "person") {
            return props.people.slice(0, 1).map(personFace);
        }

        return (props.people.length > 0 ? props.people : props.facts?.people ?? []).map(personFace);
    });

    /** How many other people a group holds: the row's count, else the room's head count less the reader. */
    const groupOtherCount = computed((): number | null => props.otherCount ?? (props.facts ? props.facts.member_count - 1 : null));

    /** Which way into the members panel the room offers: a channel's facepile, a group's button, or none. */
    const membersKind = computed((): "channel" | "group" | null => props.isMembersOffered && (props.kind === "channel" || props.kind === "group") ? props.kind : null);

    /** Up to three of the room's people, its leaders first, only for someone in it. */
    const pileFaces = computed((): AvatarPerson[] => props.facts?.is_member ? (props.facts.faces ?? []).slice(0, 3).map(personFace) : []);

    const memberCountLabel = computed((): string => {
        const count = props.facts?.member_count ?? 0;
        return `${count.toLocaleString()} ${count === 1 ? "member" : "members"}`;
    });

    /** A group's head count, the reader included, from its facts once read. */
    const groupMembersLabel = computed((): string => {
        const count = props.facts?.member_count ?? props.people.length + 1;
        return `Members, ${count.toLocaleString()} ${count === 1 ? "person" : "people"}`;
    });

    /** The title button's name and role, for a room; the plain title of no room has none. */
    const detailsAttributes = computed((): Record<string, string> => props.kind
        ? {
            "type": "button",
            "aria-haspopup": "dialog",
            "aria-label": `${props.title}, ${props.kind === "channel" ? "channel" : "conversation"} details`,
            "data-testid": "header-details",
            "data-header-focus": ""
        }
        : {});

    /** The phone's overflow menu; empty leaves the button out, since a menu of nothing is a dead end. */
    const moreItems = computed((): MenuItem[] => {
        const items: MenuItem[] = [];

        if (props.isMentionsOffered) {
            items.push({ key: "mentions", label: "Mentions", icon: "at", hasDot: props.hasMentionDot });
        }

        if (membersKind.value) {
            items.push({ key: "members", label: "Members", icon: "users" });
        }

        if (props.isThreadsOffered) {
            items.push({ key: "threads", label: "Threads", icon: "thread" });
        }

        if (props.isPushOffered) {
            items.push({ key: "push", label: "Turn on notifications", icon: "bell" });
        }

        if (props.isPrefsOffered) {
            items.push({ key: "star", label: props.isStarred ? "Unstar" : "Star", icon: props.isStarred ? "star-f" : "star" });
        }

        // Last, as the title opens the same details on a phone too.
        if (props.kind) {
            items.push({ key: "details", label: props.kind === "channel" ? "Channel details" : "Conversation details", icon: "settings" });
        }

        return items;
    });

    /** The bell as the room's mode: on, mentions only, or off. */
    const notifyIcon = computed((): string => props.notifyMode === "silent" ? "bell-off" : props.notifyMode === "mentions" ? "at-bell" : "bell");

    /** "Notify me about": the three modes with what each means, the room's own checked, then its details. */
    const notifyItems = computed((): MenuItem[] => [
        ...notifyOptionsFor(props.kind).map(option => ({
            key: option.value,
            label: option.title,
            description: option.description,
            isChecked: option.value === props.notifyMode
        })),
        { key: "details", label: props.kind === "channel" ? "Channel details" : "Conversation details", icon: "settings", isSeparatorBefore: true }
    ]);

    /** Which banner the connection opens: offline while lost, then back online while catching up after it. */
    const connectionBanner = computed((): "warning" | "info" | null => {
        if (props.connection) {
            return "warning";
        }

        return wasOffline.value && props.isBehind ? "info" : null;
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onMoreSelect(key: string): void {
        if (key === "push") {
            emit("turnOnPush");
        }
        else if (key === "star") {
            emit("star");
        }
        else if (key === "threads") {
            emit("threads");
        }
        else if (key === "mentions") {
            emit("mentions");
        }
        else if (key === "members") {
            emit("members");
        }
        else if (key === "details") {
            emit("details");
        }
    }

    function onNotifySelect(key: string): void {
        if (key === "details") {
            emit("details");
        }
        else if (key !== props.notifyMode && (key === "all" || key === "mentions" || key === "silent")) {
            emit("notify", key);
        }
    }

    /** Opens from no height to the banner's own, measured now since its text wraps to the width. */
    function onBannerEnter(element: Element): void {
        const box = element as HTMLElement;
        box.style.height = "0px";
        // Read once so the browser lays out the closed height before the open one is set.
        void box.offsetHeight;
        box.style.height = `${box.scrollHeight}px`;
    }

    /** Hands the height back to the content, so a banner whose text changes still fits it. */
    function onBannerSettled(element: Element): void {
        (element as HTMLElement).style.height = "";
    }

    function onBannerLeave(element: Element): void {
        const box = element as HTMLElement;
        box.style.height = `${box.scrollHeight}px`;
        void box.offsetHeight;
        box.style.height = "0px";
    }

    // #endregion Event Handlers

    // #region Watchers

    watch(() => [props.connection, props.isBehind] as const, ([connection, isBehind]) => {
        if (connection) {
            wasOffline.value = true;
        }
        else if (!isBehind && wasOffline.value) {
            // The outage is over only once what was missed has been caught up, so the shell says
            // so then and not while the catch-up banner still shows.
            wasOffline.value = false;
            emit("backOnline");
        }
    });

    // #endregion Watchers
</script>
