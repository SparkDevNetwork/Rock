<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <header v-if="!isEmpty" ref="headerElement" class="chat-header" :class="{ 'is-phone': isPhone }" data-testid="chat-header">
        <!--
            The sidebar folded away while a panel is open in a narrow window comes back from here,
            and focus comes back here as it is put away again.
        -->
        <IconButton v-if="isSidebarFolded && !isPhone"
                    icon="sidebar"
                    label="Show conversations"
                    aria-expanded="false"
                    data-testid="header-sidebar"
                    data-focus-stop="sidebar-button"
                    @click="emit('sidebar')" />
        <IconButton v-if="isPhone"
                    class="chat-header-back"
                    icon="left"
                    label="Back"
                    data-testid="header-back"
                    @click="emit('back')" />

        <div class="chat-header-id">
            <ChannelMark v-if="kind === 'channel'" class="chat-header-ic" :isPublic="isPublic" :imageUrl="iconUrl" :name="title" />
            <Avatar v-else-if="kind === 'person' && faces.length > 0" :key="otherAlias ?? undefined" :people="faces" :size="36" :status="otherStatus" />
            <GroupFace v-else-if="kind === 'group'" :people="faces" :count="groupOtherCount" :size="36" />

            <span class="chat-header-title">
                <!--
                    The title, which opens the room's details as a button only as wide as itself; with
                    no room there is nothing to open. Where focus goes when a conversation slides in on
                    a phone: the button, which holds nothing focusable, or with no room, the title.
                -->
                <component :is="kind ? 'button' : 'span'"
                           ref="titleElement"
                           class="chat-header-name-row"
                           v-bind="detailsAttributes"
                           @click="onTitleClick"
                           @mouseenter="titleTip.onPointerEnter"
                           @mouseleave="titleTip.hideTip"
                           @pointerdown="titleTip.onPointerDown"
                           @focus="titleTip.onFocus"
                           @blur="titleTip.onBlur">
                    <b class="chat-header-name"
                       data-testid="header-title"
                       :tabindex="kind ? undefined : -1"
                       :data-focus-stop="kind ? undefined : 'header'">{{ title }}</b>
                    <span v-if="kind" class="chat-header-chev"><Icon name="down" size="xs" /></span>
                </component>
                <span v-if="connection" class="chat-header-sub" data-testid="connection-badge" data-tone="warning">
                    <Dot class="chat-header-live" tone="warning" pulse data-testid="connection-dot" />Reconnecting…
                </span>
                <span v-else-if="isBehind" class="chat-header-sub" data-testid="catching-up-badge" data-tone="info">
                    <Dot class="chat-header-live" tone="info" pulse />Catching up on new messages…
                </span>
                <span v-else-if="shownSubtitle" class="chat-header-sub" data-testid="header-subtitle">{{ shownSubtitle }}</span>
            </span>
        </div>

        <div class="chat-header-actions">
            <!-- A channel's or a group's other people then "+N", or the people icon and the head count where no face is drawn. -->
            <button v-if="membersButton && !isPhone"
                    ref="pileElement"
                    type="button"
                    class="chat-header-pile"
                    data-testid="header-members"
                    data-focus-stop="members-button"
                    :aria-label="membersButton.label"
                    :aria-expanded="isMembersOpen ? 'true' : 'false'"
                    @mouseenter="pileTip.onPointerEnter"
                    @mouseleave="pileTip.hideTip"
                    @pointerenter="emit('membersIntent')"
                    @focus="onPileFocus"
                    @blur="pileTip.onBlur"
                    @pointerdown="onPilePointerDown"
                    @click="onPileClick">
                <Avatar v-if="membersButton.faces.length > 0" :people="membersButton.faces" :size="26" />
                <span v-else class="chat-header-pile-ic"><Icon name="users" size="sm" /></span>
                <span v-if="membersButton.count" class="chat-header-pile-count" data-testid="header-members-count" aria-hidden="true">{{ membersButton.count }}</span>
            </button>

            <IconButton v-if="isThreadsOffered && !isPhone"
                        icon="thread"
                        :label="threadsWords"
                        data-testid="header-threads"
                        data-focus-stop="threads-button"
                        :aria-expanded="isThreadsOpen ? 'true' : 'false'"
                        @click="emit('threads')" />

            <!-- A worded pill with no glyph, so the room's notify menu stays the header's only bell. -->
            <Button v-if="isPushOffered && !isPhone"
                    class="chat-header-push"
                    kind="brand"
                    size="sm"
                    data-testid="push-offer"
                    @click="emit('turnOnPush')">Turn on notifications</Button>

            <!-- The room's notify menu, the bell drawn as its mode and named by it; kept on a phone, where the star moves into More. -->
            <span v-if="isPrefsOffered" class="chat-header-menu" data-testid="header-notify">
                <Menu :icon="notifyIcon"
                      :label="notifyWords"
                      heading="Notify me about"
                      :items="notifyItems"
                      @select="onNotifySelect" />
            </span>

            <IconButton v-if="isPrefsOffered && !isPhone"
                        :icon="isStarred ? 'star-f' : 'star'"
                        :label="starWords"
                        :aria-pressed="isStarred ? 'true' : 'false'"
                        data-testid="header-star"
                        @click="emit('star')" />

            <span v-if="isPhone && moreItems.length > 0" class="chat-header-more" data-testid="header-more" data-focus-stop="more">
                <Menu icon="dots" label="More" :items="moreItems" @select="onMoreSelect" @openChange="onMoreOpenChange" />
            </span>
        </div>
    </header>

    <Teleport :to="tipHost ?? 'body'" :disabled="!tipHost">
        <div v-if="isTitleTipShown"
             ref="titleTipElement"
             class="chat-tip"
             role="tooltip"
             :style="titleTip.floatingStyles.value">{{ detailsWords }}</div>
        <div v-if="isPileTipShown"
             ref="pileTipElement"
             class="chat-tip"
             role="tooltip"
             :style="pileTip.floatingStyles.value">{{ membersButton?.tip }}</div>
    </Teleport>

    <Transition name="chat-banner" @enter="onBannerEnter" @afterEnter="onBannerSettled" @leave="onBannerLeave">
        <div v-if="connectionBanner"
             class="chat-conn-banner"
             data-testid="connection-banner"
             :data-tone="connectionBanner">
            <div v-if="connectionBanner === 'warning'" class="chat-conn-banner-row">
                <span class="chat-conn-ic"><Icon name="wifi-off" size="sm" /></span>
                <span><b>You're offline.</b> Reconnecting now. You can send again once you're back.</span>
            </div>
            <div v-else class="chat-conn-banner-row">
                <span class="chat-spinner"></span>
                <span>Back online. Catching up on new messages…</span>
            </div>
        </div>
    </Transition>

    <div v-if="banner"
         class="chat-service-banner"
         data-testid="service-banner"
         :data-tone="isUpdateRequired ? 'info' : 'warning'">
        <span class="chat-service-ic"><Icon :name="isUpdateRequired ? 'refresh' : 'alert'" /></span>
        <span>{{ banner }}</span>
    </div>

    <div class="chat-conn-bar-host">
        <!-- A line of no height at the feed's top, so the sweep sits over the messages rather than pushing them down. -->
        <Transition name="chat-fade">
            <div v-if="connection" class="chat-conn-bar" data-testid="connection-sweep"></div>
        </Transition>
    </div>
</template>

<style scoped>
/* No line under it: the feed meets it clean at rest and draws the line at its own top once scrolled. */
.chat-header {
    display: flex;
    flex: none;
    gap: 12px;
    align-items: center;
    height: 64px;
    padding: 0 12px 0 20px;
    background: var(--chat-surface);
}

.chat-header.is-phone {
    padding-left: 12px;
}

/* Reached through the button's own root, which a scoped rule here does not mark. */
.chat-header :deep(.chat-header-back) {
    margin-left: -8px;
}

/* The room's mark, then its title over the line under it; a face's badge rings in the bar's fill. */
.chat-header-id {
    --chat-av-ring: var(--chat-surface);
    --chat-av-ring-over: transparent;

    display: flex;
    flex: 0 1 auto;
    gap: 12px;
    align-items: center;
    min-width: 0;
}

/*
    The title and its chevron, the button that opens the room's details. Its box is its words, so
    the column sizes it to the title and the words line up with the line under them; a box padded
    and pulled back by a negative margin was sized by its margin box and clamped by its border box,
    cutting the title short with room to spare.
*/
.chat-header-name-row {
    position: relative;
    isolation: isolate;
    display: flex;
    gap: 4px;
    align-items: center;
    max-width: 100%;
    min-width: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    background: transparent;
    border: 0;
}

/* The hover and press wash, a little past the words on a layer under them. */
.chat-header-name-row::before {
    position: absolute;
    inset: -2px -6px;
    z-index: -1;
    content: "";
    border-radius: var(--chat-r-control);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

button.chat-header-name-row:hover::before {
    background: var(--chat-hover);
}

button.chat-header-name-row:active::before {
    background: var(--chat-press);
}

/* The chevron says the title opens something, and nudges down on hover. */
.chat-header-chev {
    display: inline-flex;
    flex: none;
    color: var(--chat-icon);
    opacity: .7;
    transition: transform var(--chat-t-fast) var(--chat-ease-in), opacity var(--chat-t-fast) var(--chat-ease-state);
}

button.chat-header-name-row:hover .chat-header-chev {
    opacity: 1;
    transform: translateY(var(--chat-nudge));
}

.is-phone .chat-header-id {
    gap: 10px;
}

.chat-header-ic {
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    color: var(--chat-brand-ink);
    background: var(--chat-brand-tint);
    border-radius: var(--chat-r-surface);
}

.chat-header-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    line-height: 1.25;
}

.chat-header-name {
    overflow: hidden;
    font-size: var(--chat-fs-title);
    font-weight: 700;
    letter-spacing: -.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chat-header-sub {
    max-width: 100%;
    overflow: hidden;
    font-size: var(--chat-fs-ui);
    color: var(--chat-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chat-header-actions {
    display: flex;
    gap: 2px;
    align-items: center;
    margin-left: auto;
}

/* The push offer, the small button in the church's color, set a little apart from the icons beside it. */
.chat-header-push {
    margin: 0 4px;
}

.chat-header-more,
.chat-header-menu {
    position: relative;
    display: inline-flex;
}

/* The connection's dot, a word's space before its words, sat on their line. */
.chat-header-live {
    margin-right: 6px;
    vertical-align: 1px;
}

/*
    The members button: up to three faces then a "+N" disc for the people not drawn, or the people
    icon then the head count's disc, in one pill-shaped button.
*/
.chat-header-pile {
    display: inline-flex;
    flex: none;
    align-items: center;
    height: 34px;
    padding: 0 4px;
    margin-right: 4px;
    font: inherit;
    color: var(--chat-text-2);
    background: transparent;
    border: 0;
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-header-pile:hover,
.chat-header-pile[aria-expanded="true"] {
    background: var(--chat-hover);
}

/* A room whose faces cannot be shown draws the people icon in a face's place. */
.chat-header-pile-ic {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    color: var(--chat-icon);
    background: var(--chat-hover);
    border-radius: var(--chat-r-full);
}

/*
    The count joins the stack as its last disc, overlapping as a face does and ringed like one, in
    the quiet fill a group's mark gives its own "+N". Positioned as the faces' pile is, so it paints in
    the same layer and order decides: it lies over the last face, as each face lies over the one before.
*/
.chat-header-pile-count {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-width: 26px;
    height: 26px;
    padding: 0 5px;
    margin-left: -5px;
    font-size: var(--chat-fs-badge);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.02em;
    color: var(--chat-text-2);
    background: var(--chat-line-strong);
    border-radius: var(--chat-r-full);
    box-shadow: 0 0 0 2px var(--chat-av-ring, var(--chat-surface));
}

/* The banner opens by its own height, which script measures, since grid rows do not animate in Safari 14. */
.chat-conn-banner {
    flex: none;
    overflow: hidden;
    background: var(--chat-warning-soft);
}

.chat-conn-banner[data-tone="info"] {
    background: var(--chat-info-soft);
}

.chat-conn-banner-row {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 9px 20px;
    font-size: var(--chat-fs-ui);
    color: var(--chat-text);
    border-bottom: 1px solid var(--chat-conn-line-warning);
}

.chat-conn-ic {
    display: inline-flex;
    color: var(--chat-warning-ink);
}

.chat-conn-banner[data-tone="info"] .chat-conn-banner-row {
    color: var(--chat-text);
    border-bottom-color: var(--chat-conn-line-info);
}

.chat-conn-banner[data-tone="info"] .chat-spinner {
    color: var(--chat-info-ink);
}

.chat-banner-enter-active,
.chat-banner-leave-active {
    transition: height var(--chat-t-panel) var(--chat-ease-in);
}

.chat-service-banner {
    display: flex;
    flex: none;
    gap: 10px;
    align-items: center;
    margin: 10px 16px 0;
    padding: 10px 12px;
    font-size: var(--chat-fs-ui);
    line-height: 1.4;
    color: var(--chat-text);
    background: var(--chat-warning-soft);
    border-radius: var(--chat-r-surface);
}

.chat-service-ic {
    display: inline-flex;
    color: var(--chat-warning-ink);
}

.chat-service-banner[data-tone="info"] {
    background: var(--chat-info-soft);
}

.chat-service-banner[data-tone="info"] .chat-service-ic {
    color: var(--chat-info-ink);
}

.chat-conn-bar-host {
    position: relative;
    z-index: var(--chat-z-bar);
    flex: none;
    height: 0;
}

.chat-conn-bar {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
    overflow: hidden;
}

.chat-conn-bar::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40%;
    content: "";
    background: linear-gradient(90deg, transparent, var(--chat-warning), transparent);
    animation: var(--chat-loop-stop, chat-sweep) var(--chat-d-sweep) var(--chat-ease-state) infinite;
}

.chat-fade-enter-active,
.chat-fade-leave-active {
    transition: opacity var(--chat-t-base) var(--chat-ease-state);
}

.chat-fade-enter-from,
.chat-fade-leave-to {
    opacity: 0;
}
</style>

<script setup lang="ts">
    import { computed, onMounted, PropType, ref, watch } from "vue";
    import { NotifyMode, notifyIconFor, notifyOptionsFor } from "../composables/usePrefs.partial";
    import { useFaceStatus } from "../composables/usePresenceStatus.partial";
    import { ChannelFacts, ChatError, ChatPerson, RoomKind } from "../types.partial";
    import { useChatSession } from "../chatSession.partial";
    import Avatar, { AvatarPerson } from "../ui/avatar.partial.obs";
    import Button from "../ui/button.partial.obs";
    import ChannelMark from "../ui/channelMark.partial.obs";
    import Dot from "../ui/dot.partial.obs";
    import GroupFace from "../ui/groupFace.partial.obs";
    import { peopleCountWords, personFace } from "../ui/face.partial";
    import Icon from "../ui/icon.partial.obs";
    import IconButton from "../ui/iconButton.partial.obs";
    import Menu, { MenuItem } from "../ui/menu.partial.obs";
    import { useAnnouncer } from "../ui/announcer.partial";
    import { overlayHostOf, useTooltip } from "../ui/tooltip.partial";

    // #region Types

    /** What the room is, which decides the mark beside its title: a conversation's kind, kept under this name for the screens that still import it. */
    export type HeaderRoomKind = RoomKind;

    // #endregion Types

    const emit = defineEmits<{
        (e: "turnOnPush"): void,
        (e: "back"): void,
        (e: "backOnline"): void,
        (e: "threads"): void,
        (e: "members"): void,
        /** The person is reaching for the members button, so what the panel needs can be read first. */
        (e: "membersIntent"): void,
        (e: "details"): void,
        /** A notify mode other than the room's own was chosen from the bell's menu. */
        (e: "notify", mode: NotifyMode): void,
        /** Add to or remove from favorites, from the header or the phone's More. */
        (e: "star"): void,
        /** The sidebar folded away while a panel is open is asked back over the conversation. */
        (e: "sidebar"): void
    }>();

    // The one-pane phone layout leads with Back and folds the actions into a menu.
    const { isPhone } = useChatSession();

    const props = defineProps({
        title: {
            type: String,
            default: ""
        },

        /**
         * The line under the title the shell worked out, such as a draft's or a group's "3 people",
         * which stands until the room's facts are read; null for none.
         */
        subtitle: {
            type: String as PropType<string | null>,
            default: null
        },

        /** What chat_get_channel answered about the open room, once read; the subtitle comes from it. */
        facts: {
            type: Object as PropType<ChannelFacts | null>,
            default: null
        },

        /** What the room is, or null to draw no mark beside the title. */
        kind: {
            type: String as PropType<HeaderRoomKind | null>,
            default: null
        },

        /** Whether a channel is open to anyone who may join, which draws a hash rather than a lock. */
        isPublic: {
            type: Boolean,
            default: false
        },

        /** A channel's own image, drawn as its mark in place of the hash or lock; null for none. */
        iconUrl: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The other people of a direct message or group, with their photos, as the sidebar sent them. */
        people: {
            type: Array as PropType<ChatPerson[]>,
            default: () => []
        },

        /**
         * How many other people a group holds as the sidebar counted them, which can be more than
         * the people it sent; null for a named group, whose row carries no count.
         */
        otherCount: {
            type: Number as PropType<number | null>,
            default: null
        },

        /** The live connection's trouble, or null when it is healthy. */
        connection: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** The platform's sentence about the service, or about this Rock being too old; null for none. */
        banner: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether the banner says Rock must be updated, which is told in the info tone. */
        isUpdateRequired: {
            type: Boolean,
            default: false
        },

        /** Whether the channel's catch-up failed and is trying again, so messages may be missing. */
        isBehind: {
            type: Boolean,
            default: false
        },

        /** Whether to offer "Turn on notifications", as the church's prompt timing says; the click is what asks the browser. */
        isPushOffered: {
            type: Boolean,
            default: false
        },

        /** Whether the room is the person's own, so its notify menu and the star are offered. */
        isPrefsOffered: {
            type: Boolean,
            default: false
        },

        /** The room's notify mode for the person, which the bell draws and its menu checks. */
        notifyMode: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether the room is among the person's Favorites, which presses the star. */
        isStarred: {
            type: Boolean,
            default: false
        },

        /** Whether to offer the Threads panel, which needs a conversation that exists. */
        isThreadsOffered: {
            type: Boolean,
            default: false
        },

        /** Whether the Threads panel is open, which its button shows as expanded. */
        isThreadsOpen: {
            type: Boolean,
            default: false
        },

        /**
         * Whether to offer the members panel, which needs a conversation that exists; a channel's
         * facepile, a group's Members button, never in a conversation of two.
         */
        isMembersOffered: {
            type: Boolean,
            default: false
        },

        /** Whether the members panel is open, which its button shows as expanded. */
        isMembersOpen: {
            type: Boolean,
            default: false
        },

        /** Whether no conversation or draft is open, which leaves the bar out and keeps only the banners. */
        isEmpty: {
            type: Boolean,
            default: false
        },

        /** Whether the sidebar is folded away for an open panel, which draws the button that brings it back. */
        isSidebarFolded: {
            type: Boolean,
            default: false
        }
    });

    // #region Values

    /** Set while the connection is lost and kept until the catch-up after it is done, so "Back online" follows only an outage. */
    const wasOffline = ref(!!props.connection);

    const { announce } = useAnnouncer();

    const headerElement = ref<HTMLElement>();
    const titleElement = ref<HTMLElement>();
    const pileElement = ref<HTMLElement>();

    // The title's and the members button's tooltips, which the icon buttons draw for themselves.
    const titleTip = useTooltip(titleElement, () => !props.kind);
    const pileTip = useTooltip(pileElement);
    const { tipElement: titleTipElement, isTipShown: isTitleTipShown } = titleTip;
    const { tipElement: pileTipElement, isTipShown: isPileTipShown } = pileTip;

    /** The chat's root, which the tips are drawn in; null where the header is drawn alone. */
    const tipHost = ref<HTMLElement | null>(null);

    // #endregion Values

    // #region Computed Values

    /**
     * The line under the title, from the room's facts once read: a channel's description, or a
     * group's head count, a named group's included; none for a conversation of two, whose facts
     * carry no campus, which only a person's card names. Until then, whatever the shell worked out.
     */
    const shownSubtitle = computed((): string | null => {
        const facts = props.facts;
        if (!facts) {
            return props.subtitle;
        }

        switch (props.kind) {
            case "channel":
                return facts.description?.trim() || null;

            case "person":
                return null;

            case "group":
                // the listed count leaves out anyone not shown, so a group can be down to one
                return facts.member_count > 0 ? peopleCountWords(facts.member_count) : null;

            default:
                return props.subtitle;
        }
    });

    /**
     * A person's one face, or a group's people. A named group's row carries none, so its people
     * come from the room's facts once they are read.
     */
    const faces = computed((): AvatarPerson[] => {
        if (props.kind === "person") {
            return props.people.slice(0, 1).map(personFace);
        }

        return (props.people.length > 0 ? props.people : props.facts?.people ?? []).map(personFace);
    });

    /**
     * The one other person of a two-person room, by primary alias, which keys the face: a room
     * switch that shows another person draws another face, so the new person's badge and photo are
     * drawn as state, never faded from the last person's.
     */
    const otherAlias = computed((): string | null => props.kind === "person" ? props.people[0]?.person_alias_guid.toLowerCase() ?? null : null);

    const statusOf = useFaceStatus(() => otherAlias.value ? [otherAlias.value] : [], 1);

    const otherStatus = computed(() => otherAlias.value ? statusOf(otherAlias.value) : null);

    /** How many other people a group holds: the row's count, else the room's head count less the reader. */
    const groupOtherCount = computed((): number | null => props.otherCount ?? (props.facts ? props.facts.member_count - 1 : null));

    /** Which rooms offer the members button: a channel or a group, never a conversation of two. */
    const membersKind = computed((): "channel" | "group" | null => props.isMembersOffered && (props.kind === "channel" || props.kind === "group") ? props.kind : null);

    /**
     * What the members button draws, one control for a channel and a group: up to three of the
     * room's other people then "+N" for everyone not drawn, or where no face can be shown, the
     * people icon then the head count. A channel's faces, its leaders first, come with its facts
     * and only for someone in it; a group's are the people the header already has. Null leaves
     * the button out, as for a channel whose facts are not read yet.
     */
    const membersButton = computed((): { faces: AvatarPerson[], count: string | null, label: string, tip: string } | null => {
        let total: number;
        let shown: AvatarPerson[];

        if (membersKind.value === "channel" && props.facts) {
            total = props.facts.member_count;
            shown = props.facts.is_member ? (props.facts.faces ?? []).slice(0, 3).map(personFace) : [];
        }
        else if (membersKind.value === "group") {
            // A group's people are the faces the header already has, drawn as a channel's are:
            // the pile is how a group is told from another at a glance.
            total = props.facts?.member_count ?? (props.otherCount ?? props.people.length) + 1;
            shown = faces.value.slice(0, 3);
        }
        else {
            return null;
        }

        const tip = `${total.toLocaleString()} ${total === 1 ? "member" : "members"}`;
        const label = `${tip}, open member list`;
        if (shown.length === 0) {
            return { faces: [], count: shortCount(total), label, tip };
        }

        // Faces are drawn only for someone in the room, so the reader is one of the total.
        const rest = total - 1 - shown.length;
        return { faces: shown, count: rest > 0 ? `+${shortCount(rest)}` : null, label, tip };
    });

    /** What the title button opens, said in its tooltip. */
    const detailsWords = computed((): string => props.kind === "channel" ? "Channel details" : "Conversation details");

    /** This room's threads, as Threads names them. */
    const threadsWords = computed((): string => `Threads in ${props.title}`);

    /** What the star does, the same words on the header's button and in the phone's More; the sidebar's section is Favorites. */
    const starWords = computed((): string => props.isStarred ? "Remove from favorites" : "Add to favorites");

    /** The title button's name and role, for a room; the plain title of no room has none. */
    const detailsAttributes = computed((): Record<string, string> => props.kind
        ? {
            "type": "button",
            "aria-haspopup": "dialog",
            "aria-label": `${props.title}${otherStatus.value?.label ?? ""}, ${detailsWords.value.toLowerCase()}`,
            "data-testid": "header-details",
            "data-focus-stop": "header"
        }
        : {});

    /**
     * The phone's overflow menu, this conversation's own controls; empty leaves the button out,
     * since a menu of nothing is a dead end.
     */
    const moreItems = computed((): MenuItem[] => {
        const items: MenuItem[] = [];

        if (props.isThreadsOffered) {
            items.push({ key: "threads", label: threadsWords.value, icon: "thread" });
        }

        if (membersKind.value) {
            items.push({ key: "members", label: "Members", icon: "users" });
        }

        if (props.isPushOffered) {
            items.push({ key: "push", label: "Turn on notifications", icon: "bell" });
        }

        if (props.isPrefsOffered) {
            items.push({ key: "star", label: starWords.value, icon: props.isStarred ? "star-f" : "star" });
        }

        // Last, as the title opens the same details on a phone too.
        if (props.kind) {
            items.push({ key: "details", label: detailsWords.value, icon: "settings" });
        }

        return items;
    });

    /** The room's mode, all where it has none. */
    const shownNotifyMode = computed((): NotifyMode => props.notifyMode === "silent" || props.notifyMode === "mentions" ? props.notifyMode : "all");

    /** The bell as the room's mode: on, mentions only, or off. */
    const notifyIcon = computed((): string => notifyIconFor(shownNotifyMode.value));

    /** The bell's name and tooltip, which say the mode in the menu's own words, so the glyph is never the only sign. */
    const notifyWords = computed((): string => {
        const title = notifyOptionsFor(props.kind).find(option => option.value === shownNotifyMode.value)?.title ?? "";
        return `Notifications: ${title.toLowerCase()}`;
    });

    /** "Notify me about": the three modes with what each means, the room's own checked, then its details. */
    const notifyItems = computed((): MenuItem[] => [
        ...notifyOptionsFor(props.kind).map(option => ({
            key: option.value,
            label: option.title,
            description: option.description,
            isChecked: option.value === props.notifyMode
        })),
        { key: "details", label: detailsWords.value, icon: "settings", isSeparatorBefore: true }
    ]);

    /** Which banner the connection opens: offline while lost, then back online while catching up after it. */
    const connectionBanner = computed((): "warning" | "info" | null => {
        if (props.connection) {
            return "warning";
        }

        return wasOffline.value && props.isBehind ? "info" : null;
    });

    // #endregion Computed Values

    // #region Functions

    /**
     * A head count short enough for a 26px disc: in full to 999, then in thousands with one
     * decimal under ten thousand and none above (1k, 1.2k, 13k), rounded down so it never says
     * more people than there are.
     */
    function shortCount(count: number): string {
        if (count < 1000) {
            return String(count);
        }

        const thousands = count < 10000 ? Math.floor(count / 100) / 10 : Math.floor(count / 1000);
        return `${thousands}k`;
    }

    // #endregion Functions

    // #region Event Handlers

    /** More opening on a phone is the person reaching for Members when it holds it, as the pile's hover is. */
    function onMoreOpenChange(isOpen: boolean): void {
        if (isOpen && membersKind.value) {
            emit("membersIntent");
        }
    }

    function onMoreSelect(key: string): void {
        if (key === "push") {
            emit("turnOnPush");
        }
        else if (key === "star") {
            emit("star");
        }
        else if (key === "threads") {
            emit("threads");
        }
        else if (key === "members") {
            emit("members");
        }
        else if (key === "details") {
            emit("details");
        }
    }

    function onNotifySelect(key: string): void {
        if (key === "details") {
            emit("details");
        }
        else if (key !== props.notifyMode && (key === "all" || key === "mentions" || key === "silent")) {
            emit("notify", key);
        }
    }

    function onTitleClick(): void {
        titleTip.hideTip();
        if (props.kind) {
            emit("details");
        }
    }

    /** Reaching for the members button reads what the panel needs first, as a hover does. */
    function onPileFocus(): void {
        emit("membersIntent");
        pileTip.onFocus();
    }

    function onPilePointerDown(): void {
        emit("membersIntent");
        pileTip.onPointerDown();
    }

    function onPileClick(): void {
        pileTip.hideTip();
        emit("members");
    }

    /** Opens from no height to the banner's own, measured now since its text wraps to the width. */
    function onBannerEnter(element: Element): void {
        const box = element as HTMLElement;
        box.style.height = "0px";
        // Read once so the browser lays out the closed height before the open one is set.
        void box.offsetHeight;
        box.style.height = `${box.scrollHeight}px`;
    }

    /** Hands the height back to the content, so a banner whose text changes still fits it. */
    function onBannerSettled(element: Element): void {
        (element as HTMLElement).style.height = "";
    }

    function onBannerLeave(element: Element): void {
        const box = element as HTMLElement;
        box.style.height = `${box.scrollHeight}px`;
        void box.offsetHeight;
        box.style.height = "0px";
    }

    // #endregion Event Handlers

    // #region Watchers

    // The banners are said through the chat's one voice as they come: the outage assertively, its
    // end and the service's sentence politely.
    watch(connectionBanner, (banner, was) => {
        if (banner === "warning" && was !== "warning") {
            announce("You're offline. Reconnecting now. You can send again once you're back.", "assertive");
        }
        else if (banner === "info" && was !== "info") {
            announce("Back online. Catching up on new messages…");
        }
    });

    watch(() => props.banner, banner => {
        if (banner) {
            announce(banner);
        }
    });

    watch(() => [props.connection, props.isBehind] as const, ([connection, isBehind]) => {
        if (connection) {
            wasOffline.value = true;
        }
        else if (!isBehind && wasOffline.value) {
            // The outage is over only once what was missed has been caught up, so the shell says
            // so then and not while the catch-up banner still shows.
            wasOffline.value = false;
            emit("backOnline");
        }
    });

    // #endregion Watchers

    onMounted(() => {
        tipHost.value = overlayHostOf(headerElement.value);
    });
</script>
