<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="chat-feed-frame" :class="{ 'is-community': layout === 'community', 'is-phone': isPhone, 'has-strip': isStripShown, 'has-jump': isJumpShown }">
        <div v-show="isStripShown" class="chat-unread-strip" data-testid="unread-strip">
            <button type="button" class="chat-strip-jump" :aria-label="`${stripText}. Jump to the first`" @click="onStripJump">
                <Icon :name="isDividerAbove ? 'arrow-up' : 'arrow-down'" size="xs" />
                <b>{{ unreadCountText }}</b>
                <span>since {{ unreadSince }}</span>
            </button>
            <button type="button" class="chat-ghost-button" data-testid="mark-read" @click="onMarkRead">Mark as read</button>
        </div>

        <div ref="feed" class="chat-feed" data-testid="message-feed" :data-loaded="timeline.isLoaded ? 'true' : 'false'" @scroll="onScroll">
            <div v-if="isSkeletonShown" class="chat-feed-skeleton" data-testid="history-skeleton" aria-hidden="true">
                <div v-for="index in 5" :key="index" class="chat-skeleton-row" :class="{ 'is-own': index % 3 === 0 }">
                    <span class="chat-skeleton chat-skeleton-bubble"></span>
                </div>
            </div>

            <button v-if="timeline.hasMore" type="button" class="chat-ghost-button chat-feed-older" @click="emit('loadOlder')">
                Show older messages
            </button>

            <section v-for="section in sections" :key="section.key" class="chat-day" data-testid="day-section">
                <div class="chat-day-pill" role="separator" data-testid="day-pill"><span>{{ section.label }}</span></div>

                <template v-for="item in section.items" :key="item.key">
                    <div v-if="item.kind === 'divider'"
                         :ref="setDivider"
                         class="chat-new-divider"
                         :class="{ 'is-read': isMarkedRead }"
                         role="separator"
                         data-testid="unread-divider">
                        <span>New</span>
                    </div>

                    <MessageRow v-else-if="item.kind !== 'group'"
                                :message="item.message"
                                :personAliasGuid="personAliasGuid"
                                :organizationName="organizationName"
                                :layout="layout"
                                :isPhone="isPhone"
                                :isArriving="isArriving(item.message.id)"
                                :data-message-id="item.message.id" />

                    <div v-else class="chat-grp" :class="{ 'is-own': item.isOwn }">
                        <MessageRow v-for="row in item.rows"
                                    :key="row.key"
                                    :message="row.message"
                                    :pending="row.pending"
                                    :isOwn="item.isOwn"
                                    :personAliasGuid="personAliasGuid"
                                    :personName="personName"
                                    :personPhotoUrl="personPhotoUrl"
                                    :organizationName="organizationName"
                                    :layout="layout"
                                    :position="row.position"
                                    :isPhone="isPhone"
                                    :isDirectMessage="isDirectMessage"
                                    :isJustSent="!!row.message && justSentIds.has(row.message.id)"
                                    :isArriving="!!row.pending || (!!row.message && isArriving(row.message.id))"
                                    :senderNames="senderNames"
                                    :data-message-id="row.message?.id"
                                    @retry="emit('retry', $event)"
                                    @discard="emit('discard', $event)" />
                    </div>
                </template>
            </section>
        </div>

        <button v-show="isJumpShown" type="button" class="chat-jump" :class="{ 'has-count': newCount > 0 }" data-testid="jump-latest" @click="onJump">
            <Icon name="arrow-down" size="sm" />{{ jumpText }}
        </button>

        <span class="chat-sr-only" role="status">{{ announcement }}</span>
    </div>
</template>

<style scoped>
.chat-feed-frame {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    --chat-feed-top-mask: 40px;
    --chat-feed-bottom-mask: 14px;
    --chat-day-top: 8px;
}

.chat-feed-frame.has-strip {
    --chat-feed-top-mask: 80px;
    --chat-day-top: 46px;
}

.chat-feed-frame.has-jump {
    --chat-feed-bottom-mask: 64px;
}

/* The edges fade, so text runs under the day pill and Jump to latest rather than into them. */
.chat-feed {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 8px 0 18px;
    overflow-y: auto;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, var(--chat-mask-solid) var(--chat-feed-top-mask), var(--chat-mask-solid) calc(100% - var(--chat-feed-bottom-mask)), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, var(--chat-mask-solid) var(--chat-feed-top-mask), var(--chat-mask-solid) calc(100% - var(--chat-feed-bottom-mask)), transparent 100%);
}

.chat-feed-older {
    align-self: center;
    margin-top: 12px;
}

/* Each day is its own section, so only that day's pill sticks while its messages are on screen. */
.chat-day {
    position: relative;
}

/*
    Community draws the pill on a ruled line. The rule is the section's background rather than a
    piece of the pill, so it stays where the day starts while the pill sticks to the top.
*/
.is-community .chat-day {
    background: linear-gradient(var(--chat-line), var(--chat-line)) no-repeat 20px 26px / calc(100% - 40px) 1px;
}

.is-community.is-phone .chat-day {
    background-position: 12px 26px;
    background-size: calc(100% - 24px) 1px;
}

.chat-day-pill {
    position: sticky;
    top: var(--chat-day-top);
    z-index: 2;
    display: flex;
    justify-content: center;
    margin: 14px 0 6px;
    pointer-events: none;
    transition: top var(--chat-t-base) var(--chat-ease-in);
}

.chat-day-pill span {
    padding: 3px 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--chat-muted);
    background: var(--chat-surface);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-full);
    box-shadow: var(--chat-shadow-day);
}

/* The New divider: a rule that runs up to its label at the line's right end. */
.chat-new-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 12px 20px 8px 24px;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--chat-danger-ink);
    text-transform: uppercase;
    letter-spacing: .04em;
    transition: opacity var(--chat-d-read-fade) var(--chat-ease-state);
}

.is-community .chat-new-divider {
    margin: 10px 20px 2px;
}

.is-community.is-phone .chat-new-divider {
    margin-right: 12px;
    margin-left: 12px;
}

.chat-new-divider::before {
    flex: 1;
    height: 1px;
    content: "";
    background: var(--chat-new-rule);
}

.chat-new-divider span {
    padding: 1px 8px;
    border: 1px solid var(--chat-new-outline);
    border-radius: var(--chat-r-full);
}

.chat-new-divider.is-read {
    opacity: 0;
}

/* A group: one sender's run of messages. Others keep room on the right, the person's own on the left. */
.chat-grp {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 14px;
    padding: 0 64px 0 20px;
}

.chat-grp.is-own {
    padding: 0 20px 0 64px;
}

.is-phone:not(.is-community) .chat-grp {
    padding: 0 36px 0 12px;
}

.is-phone:not(.is-community) .chat-grp.is-own {
    padding: 0 12px 0 44px;
}

.is-community .chat-grp {
    gap: 0;
    margin-top: 6px;
    padding: 0;
}

/*
    A bubble is at most 78 percent of the group's width and 620px, 86 percent on a phone; another
    person's row also holds their face and its gap, so it is that much wider.
*/
.chat-grp :deep(.chat-msg.is-conversational) {
    max-width: calc(min(78%, 620px) + 42px);
}

.chat-grp.is-own :deep(.chat-msg.is-conversational) {
    align-self: flex-end;
    max-width: min(78%, 620px);
}

.is-phone .chat-grp :deep(.chat-msg.is-conversational) {
    max-width: calc(86% + 42px);
}

.is-phone .chat-grp.is-own :deep(.chat-msg.is-conversational) {
    max-width: 86%;
}

.chat-unread-strip {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: 38px;
    padding: 0 8px 0 14px;
    font-size: 13px;
    font-weight: 500;
    background: var(--chat-strip-bg);
    border-bottom: 1px solid var(--chat-strip-line);
    box-shadow: var(--chat-shadow-strip);
    animation: chat-strip-in var(--chat-t-base) var(--chat-ease-in);
}

/* Its padding reaches back into the strip's, so the hover fill has room and the text stays put. */
.chat-strip-jump {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    height: 28px;
    padding: 0 8px;
    margin-left: -8px;
    overflow: hidden;
    color: var(--chat-text-2);
    white-space: nowrap;
    background: none;
    border: 0;
    border-radius: var(--chat-r-sm);
}

.chat-strip-jump b {
    font-weight: 650;
    color: var(--chat-danger-ink);
}

.chat-strip-jump :deep(.chat-ic) {
    color: var(--chat-danger-ink);
}

.chat-strip-jump span {
    overflow: hidden;
    color: var(--chat-muted);
    text-overflow: ellipsis;
}

.chat-strip-jump:hover b {
    text-decoration: underline;
    text-underline-offset: 2px;
}

.chat-ghost-button {
    height: 28px;
    padding: 0 12px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--chat-text-2);
    background: none;
    border: 0;
    border-radius: var(--chat-r-full);
}

.chat-ghost-button:hover {
    background: var(--chat-hover);
}

.chat-jump {
    position: absolute;
    bottom: 14px;
    left: 50%;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--chat-text);
    background: var(--chat-raised);
    border: 0;
    border-radius: var(--chat-r-full);
    box-shadow: var(--chat-shadow-pop);
    transform: translateX(-50%);
    animation: chat-jump-in var(--chat-t-base) var(--chat-ease-in);
}

.chat-jump.has-count {
    color: var(--chat-on-brand);
    background: var(--chat-brand-fill);
}

.chat-feed-skeleton {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
}

.chat-skeleton-row {
    display: flex;
}

.chat-skeleton-row.is-own {
    justify-content: flex-end;
}

.chat-skeleton-bubble {
    width: 44%;
    height: 34px;
    border-radius: var(--chat-r-bubble);
}

.chat-skeleton-row:nth-child(2n) .chat-skeleton-bubble {
    width: 62%;
    height: 54px;
}

@keyframes chat-strip-in {
    from {
        opacity: 0;
        transform: translateY(-4px);
    }
}

@keyframes chat-jump-in {
    from {
        opacity: 0;
        transform: translate(-50%, 10px) scale(.96);
    }
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, onMounted, PropType, reactive, ref, watch } from "vue";
    import MessageRow from "./messageRow.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import { tokenDuration } from "../ui/brand.partial";
    import { TimelineState } from "../composables/useHistory.partial";
    import { FeedLayout, FeedSection, jumpLabel, layoutFeed, newDividerBeforeId, newMessagesText, sentHoldMs, skeletonDelayMs, timeLabel, unreadStripText } from "../feedLayout.partial";
    import { PendingMessage } from "../types.partial";

    const props = defineProps({
        timeline: {
            type: Object as PropType<TimelineState>,
            required: true
        },

        pending: {
            type: Array as PropType<PendingMessage[]>,
            required: true
        },

        personAliasGuid: {
            type: String,
            required: true
        },

        /** The reader's own name and photo, for their messages the platform sent none with. */
        personName: {
            type: String as PropType<string>,
            default: ""
        },

        personPhotoUrl: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The church's name, the sender of a block post nobody signed. */
        organizationName: {
            type: String as PropType<string>,
            default: ""
        },

        layout: {
            type: String as PropType<FeedLayout>,
            default: "conversational"
        },

        isDirectMessage: {
            type: Boolean,
            default: false
        },

        /** Whether the chat is in its one-pane phone layout, where the feed's edges come in. */
        isPhone: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "seen", messageId: number): void,
        (e: "firstShown"): void,
        (e: "retry", localId: string): void,
        (e: "discard", localId: string): void,
        (e: "loadOlder"): void,
        (e: "markRead", messageId: number): void
    }>();

    // #region Values

    /** How far from the bottom the reader may be and still count as at the newest message. */
    const atBottomPx = 48;

    const feed = ref<HTMLElement | null>(null);
    let observer: IntersectionObserver | null = null;
    let dividerObserver: IntersectionObserver | null = null;
    let dividerElement: Element | null = null;

    /** Whether the New divider is out of view, and on which side, as the browser last reported. */
    const isDividerOffScreen = ref(false);
    const isDividerAbove = ref(false);

    const isMarkedRead = ref(false);
    const isScrolledUp = ref(false);

    /** Messages that arrived while the reader was scrolled up, for Jump to latest. */
    const newCount = ref(0);

    const isSkeletonDue = ref(false);
    let skeletonTimer: ReturnType<typeof setTimeout> | null = null;

    /** The person's own sends confirmed while the feed was open, each showing "Sent" for a moment. */
    const justSentIds = reactive(new Set<number>());

    /** Sends confirmed since the timeline last grew, counted the moment their pending row goes. */
    let confirmedSends = 0;

    /** The newest message when the feed first had any; anything newer arrived while it was open. */
    let newestAtLoad: number | null = null;
    let newestSeenInTimeline: number | null = null;

    const announcement = ref("");

    // #endregion Values

    // #region Computed Values

    const dividerBeforeId = computed((): number | null => newDividerBeforeId(
        props.timeline.messages, props.timeline.readCursor, props.timeline.unreadCount, props.personAliasGuid));

    const sections = computed((): FeedSection[] => layoutFeed({
        messages: props.timeline.messages,
        pending: props.pending,
        personAliasGuid: props.personAliasGuid,
        newDividerBeforeId: dividerBeforeId.value,
        layout: props.layout,
        now: new Date()
    }));

    /**
     * The name of each person seen sending in this timeline, by alias guid, so a mention typed in
     * a message not yet stored can show who it names without asking the platform.
     */
    const senderNames = computed((): ReadonlyMap<string, string> => {
        const names = new Map<string, string>();
        for (const message of props.timeline.messages) {
            if (message.person_alias_guid && message.sender_nick_name) {
                const name = [message.sender_nick_name, message.sender_last_name].filter(part => !!part).join(" ");
                names.set(message.person_alias_guid.toLowerCase(), name);
            }
        }
        return names;
    });

    const isSkeletonShown = computed((): boolean => isSkeletonDue.value && !props.timeline.isLoaded);

    /** Shown only while the divider is off screen, and gone once the person marks the channel read. */
    const isStripShown = computed((): boolean => dividerBeforeId.value !== null && isDividerOffScreen.value && !isMarkedRead.value);

    /** One control points down at a time: while the strip points down at the divider, Jump hides. */
    const isJumpShown = computed((): boolean => isScrolledUp.value && !(isStripShown.value && !isDividerAbove.value));

    const unreadCountText = computed((): string => newMessagesText(props.timeline.unreadCount));

    const unreadSince = computed((): string => {
        const first = props.timeline.messages.find(m => m.id === dividerBeforeId.value);
        return first ? timeLabel(new Date(first.created_at)) : "";
    });

    const stripText = computed((): string => {
        const first = props.timeline.messages.find(m => m.id === dividerBeforeId.value);
        return first ? unreadStripText(props.timeline.unreadCount, new Date(first.created_at)) : unreadCountText.value;
    });

    const jumpText = computed((): string => jumpLabel(newCount.value));

    // #endregion Computed Values

    // #region Event Handlers

    function onScroll(): void {
        isScrolledUp.value = !isNearBottom(atBottomPx);
        if (!isScrolledUp.value) {
            newCount.value = 0;
        }
    }

    /** Saves the read position at the newest stored message, as reading it would. */
    function onMarkRead(): void {
        const messages = props.timeline.messages;
        if (messages.length === 0) {
            return;
        }

        emit("markRead", messages[messages.length - 1].id);
        isMarkedRead.value = true;
        announcement.value = "Marked as read";
    }

    function onStripJump(): void {
        if (!feed.value || !dividerElement) {
            return;
        }

        // Just under the strip, so the divider is the first thing read.
        const top = feed.value.scrollTop + dividerElement.getBoundingClientRect().top - feed.value.getBoundingClientRect().top - 52;
        feed.value.scrollTo?.({ top: Math.max(0, top), behavior: scrollBehavior() });
    }

    function onJump(): void {
        if (feed.value) {
            feed.value.scrollTo?.({ top: feed.value.scrollHeight, behavior: scrollBehavior() });
        }
        newCount.value = 0;
    }

    // #endregion Event Handlers

    // #region Functions

    /** Whether the person is at, or near, the bottom of the feed. */
    function isNearBottom(threshold = 80): boolean {
        const element = feed.value;
        return !element || element.scrollHeight - element.scrollTop - element.clientHeight < threshold;
    }

    /** Scrolls to the newest message. */
    function scrollToBottom(): void {
        if (feed.value) {
            feed.value.scrollTop = feed.value.scrollHeight;
        }
    }

    /** Smooth unless the person asked the system for less motion. */
    function scrollBehavior(): ScrollBehavior {
        return window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
    }

    /** Whether a message arrived while the feed was open, so it rises in rather than just being there. */
    function isArriving(messageId: number): boolean {
        return newestAtLoad !== null && messageId > newestAtLoad && !justSentIds.has(messageId);
    }

    /** Watches the New divider as it is drawn, so the strip can point to it while it is out of view. */
    function setDivider(element: unknown): void {
        const next = element instanceof Element ? element : null;
        if (next === dividerElement) {
            return;
        }

        if (dividerElement) {
            dividerObserver?.unobserve(dividerElement);
        }

        dividerElement = next;
        if (next) {
            dividerObserver?.observe(next);
        }
    }

    /**
     * Watches every message row that is not watched yet. A row counts as seen once any of it
     * is on screen, which is what the read position is saved from.
     */
    function observeRows(): void {
        if (!feed.value || !observer) {
            return;
        }

        feed.value.querySelectorAll<HTMLElement>("[data-message-id]:not([data-observed])").forEach(element => {
            element.dataset.observed = "true";
            observer?.observe(element);
        });
    }

    /** The newest id in the timeline, or null when it is empty. */
    function newestId(): number | null {
        const messages = props.timeline.messages;
        return messages.length > 0 ? messages[messages.length - 1].id : null;
    }

    /**
     * Notes what is new since the timeline last grew: the reader's own sends just confirmed show
     * "Sent" for a moment, and what others sent while the reader was scrolled up is counted.
     */
    function noteArrivals(): void {
        const previous = newestSeenInTimeline;
        newestSeenInTimeline = newestId();
        if (previous === null) {
            newestAtLoad ??= newestSeenInTimeline;
            confirmedSends = 0;
            return;
        }

        const me = props.personAliasGuid.toLowerCase();
        const arrived = props.timeline.messages.filter(m => m.id > previous);
        const own = arrived.filter(m => (m.person_alias_guid ?? "").toLowerCase() === me);

        // Each confirmed send is one of the reader's own messages that just came in, newest last.
        if (confirmedSends > 0) {
            own.slice(-confirmedSends).forEach(message => holdSent(message.id));
        }
        confirmedSends = 0;

        if (isScrolledUp.value) {
            newCount.value += arrived.length - own.length;
        }
    }

    /** Shows "Sent" under a confirmed send, then lets it settle to its time. */
    function holdSent(messageId: number): void {
        justSentIds.add(messageId);
        const hold = feed.value ? tokenDuration(feed.value, "--chat-d-sent-hold", sentHoldMs) : sentHoldMs;
        setTimeout(() => justSentIds.delete(messageId), hold);
    }

    // #endregion Functions

    // #region Watchers

    watch(() => props.timeline.messages.length, async (length, previous) => {
        const shouldFollow = previous === 0 || isNearBottom();
        noteArrivals();
        await nextTick();
        observeRows();

        if (shouldFollow) {
            scrollToBottom();
        }

        if (length > 0) {
            emit("firstShown");
        }
    });

    // Counted the moment a pending row goes, before the timeline's own watcher runs, because the
    // send puts the confirmed message in first and takes the pending row out in the same turn.
    watch(() => props.pending.length, (length, previous) => {
        if (length < previous) {
            confirmedSends += previous - length;
        }
    }, { flush: "sync" });

    watch(() => props.pending.length, async () => {
        await nextTick();
        scrollToBottom();
    });

    watch(() => props.timeline.isLoaded, isLoaded => {
        if (isLoaded && skeletonTimer) {
            clearTimeout(skeletonTimer);
            skeletonTimer = null;
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(() => {
        observer = new IntersectionObserver(entries => {
            for (const entry of entries) {
                if (entry.isIntersecting && document.visibilityState === "visible") {
                    emit("seen", Number((entry.target as HTMLElement).dataset.messageId));
                }
            }
        }, { root: feed.value });

        // The divider's own watch: whether it is in view, and if not, above or below.
        dividerObserver = new IntersectionObserver(entries => {
            for (const entry of entries) {
                isDividerOffScreen.value = !entry.isIntersecting;
                isDividerAbove.value = !!entry.rootBounds && entry.boundingClientRect.bottom < entry.rootBounds.top;
            }
        }, { root: feed.value });

        if (dividerElement) {
            dividerObserver.observe(dividerElement);
        }

        // A first page that is quick never shows the skeleton, so a fast load does not flicker.
        if (!props.timeline.isLoaded) {
            skeletonTimer = setTimeout(() => {
                isSkeletonDue.value = true;
                skeletonTimer = null;
            }, skeletonDelayMs);
        }

        newestSeenInTimeline = newestId();
        newestAtLoad = newestSeenInTimeline;

        observeRows();
        if (props.timeline.messages.length > 0) {
            scrollToBottom();
            emit("firstShown");
        }
    });

    onBeforeUnmount(() => {
        observer?.disconnect();
        observer = null;
        dividerObserver?.disconnect();
        dividerObserver = null;
        if (skeletonTimer) {
            clearTimeout(skeletonTimer);
        }
    });

    // #endregion Lifecycle Hooks
</script>
