<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <PanelHost title="Thread"
               :subtitle="conversationTitle || null"
               :backLabel="isFromList ? `Back to ${listTitle}` : null"
               closeLabel="Close thread"
               :entranceKeys="entranceKeys"
               @close="emit('close')"
               @back="emit('back')">
        <template #actions>
            <template v-if="!isLoading && root && !error">
                <!-- Whether the reader follows arrives with the first page, so until it has answered there is nothing true to offer. -->
                <Pill ref="followPill"
                      :selected="isFollowing"
                      :aria-describedby="followTipId"
                      data-testid="thread-follow"
                      @mouseenter="onFollowPointerEnter"
                      @mouseleave="hideFollowTip"
                      @pointerdown="onFollowPointerDown"
                      @focus="onFollowFocus"
                      @blur="onFollowBlur"
                      @click="onFollow">
                    <Icon :name="isFollowing ? 'bell' : 'bell-off'" size="sm" />{{ isFollowing ? "Following" : "Follow" }}
                </Pill>
                <!-- What following means, read with the button and shown as its tooltip; the tip is for the eye only, so it is not read twice. -->
                <span :id="followTipId" class="chat-sr-only">{{ followText }}</span>
                <Teleport :to="followTipHost ?? 'body'" :disabled="!followTipHost">
                    <div v-if="isFollowTipShown"
                         ref="followTipElement"
                         class="chat-tip"
                         role="tooltip"
                         aria-hidden="true"
                         :style="followTipStyles">
                        {{ followText }}
                    </div>
                </Teleport>
            </template>
        </template>

        <div ref="bodyElement"
             class="chat-th-body"
             :class="{ 'is-community': isChannel, 'is-phone': isPhone }"
             @animationend="onAnimationEnd"
             @pointerover="actionBar.onPointerOver"
             @pointerleave="actionBar.onPointerLeave"
             @pointermove="actionBar.onPointerMove"
             @focusin="actionBar.onFocusIn"
             @focusout="actionBar.onFocusOut">
            <!-- Older replies are asked for as this comes into view at the top, once the thread is placed at its newest. -->
            <LoadMoreRow v-if="pagingControl === 'row'"
                         ref="olderRow"
                         edge="start"
                         name="thread-older"
                         label="Load older replies"
                         :load="loadOlderPage" />

            <!-- A failed page, the one notice, where the replies it would have brought stand; said at once. -->
            <SettingNote v-if="pageNote"
                         ref="pageNotePart"
                         class="chat-th-err"
                         :note="pageNote"
                         data-testid="thread-error" />

            <!-- A refused follow change, beside the bell it put back; said at once. -->
            <SettingNote v-if="followNote"
                         class="chat-th-err"
                         :note="followNote"
                         data-testid="thread-follow-error"
                         @retry="onFollowRetry" />

            <template v-if="!root && isLoading">
                <span class="chat-sr-only">Loading thread</span>
                <!-- Rows of the look the thread will draw, as the conversation's feed draws its own. -->
                <div class="chat-th-skeleton" aria-hidden="true">
                    <template v-if="isChannel">
                        <Skeleton v-for="index in 3" :key="index" shape="group" :widths="index % 2 === 0 ? [46, 30] : [64, 40]" />
                    </template>
                    <template v-else>
                        <Skeleton v-for="index in 3" :key="index" shape="bubble" :widths="[index % 2 === 0 ? 100 : 72]" />
                    </template>
                </div>
            </template>

            <!-- The thread waterfalls in by its parts: the root, the replies line, then each run of replies. -->
            <template v-for="(item, index) in items" :key="item.key">
                <div v-if="item.kind === 'thread-divider'"
                     class="chat-th-div chat-enter"
                     :style="{ '--chat-enter-i': index }"
                     data-testid="thread-divider">{{ dividerText }}</div>

                <MessageRow v-else-if="item.kind === 'blocked'"
                            class="chat-enter"
                            :style="{ '--chat-enter-i': index }"
                            :message="item.messages[item.messages.length - 1]"
                            :blockedRun="item.messages"
                            :isChannel="isChannel"
                            :isInThread="true"
                            :reactionHost="reactionHost"
                            :data-row-key="item.key"
                            :data-reply-id="item.isReply ? item.messages[item.messages.length - 1].id : undefined"
                            @messageAction="emit('messageAction', $event)" />

                <MessageRow v-else-if="item.kind !== 'group'"
                            class="chat-enter"
                            :style="{ '--chat-enter-i': index }"
                            :message="item.message"
                            :isChannel="isChannel"
                            :isInThread="true"
                            :isFlashing="item.isReply && item.message.id === flashingId"
                            :reactionHost="reactionHost"
                            :data-row-key="item.key"
                            :data-reply-id="item.isReply ? item.message.id : undefined"
                            @jump="emit('jump', $event)"
                            @messageAction="emit('messageAction', $event)" />

                <div v-else class="chat-grp chat-enter" :class="{ 'is-own': item.isOwn }" :style="{ '--chat-enter-i': index }">
                    <MessageRow v-for="row in item.rows"
                                :key="row.key"
                                :groupKey="item.key"
                                :message="row.message"
                                :pending="row.pending"
                                :isOwn="item.isOwn"
                                :isPersonLeader="isPersonLeader"
                                :isChannel="isChannel"
                                :position="row.position"
                                :isTypingNext="row.isTypingNext"
                                :isDirectMessage="isDirectMessage"
                                :isJustSent="!!row.message?.client_key && justSentKeys.has(row.message.client_key)"
                                :isSendingSlow="!!row.pending && slowSendKeys.has(row.pending.localId)"
                                :senderNames="senderNames"
                                :isInThread="true"
                                :isFlashing="item.isReply && !!row.message && row.message.id === flashingId"
                                :isPreviewing="isPreviewing"
                                :isEditing="!!row.message && row.message.id === editingId"
                                :editError="editError"
                                :isEditSaving="isEditSaving"
                                :reactionHost="reactionHost"
                                :data-row-key="row.key"
                                :data-reply-id="item.isReply && row.message ? row.message.id : undefined"
                                @jump="emit('jump', $event)"
                                @messageAction="emit('messageAction', $event)"
                                @retry="emit('retry', $event)"
                                @discard="emit('discard', $event)" />
                </div>
            </template>

            <!-- Someone typing a reply, as the newest row the layout placed; one element, so it can settle away once its row is gone. -->
            <TypingBubble :typing="drawnTyping"
                          :isGroup="!isChannel && !isDirectMessage"
                          :isInRun="repliesLaidOut?.typing?.isInRun ?? false"
                          :groupKey="repliesLaidOut?.typing?.groupKey ?? 'typing'" />

            <!--
                The thread's one action bar, drawn in the dock of the message it is on. One element for
                the drawer's life, left here while it is on no message, so every show plays its entrance.
            -->
            <Teleport :to="actionBar.dock.value?.element" :disabled="!actionBar.dock.value">
                <ActionBar v-bind="actionBar.dock.value?.props.value"
                           :isShown="actionBar.isShown.value"
                           :isInstant="actionBar.isInstant.value"
                           v-on="actionBar.dock.value?.handlers ?? {}"
                           @holdChange="actionBar.onHoldChange" />
            </Teleport>
        </div>

        <template #foot>
            <slot name="composer" />
        </template>
    </PanelHost>
</template>

<style scoped>
/* Where a notice stands in the thread; how it looks is the notice's own. */
.chat-th-err {
    margin: 8px 14px 6px;
}

.chat-th-skeleton {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 0;
}

/* "3 replies", a rule running from the words to the panel's edge. */
.chat-th-div {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 16px 18px 2px;
    font-size: var(--chat-fs-small);
    font-weight: 600;
    color: var(--chat-muted);
}

.chat-th-div::after {
    flex: 1;
    height: 1px;
    content: "";
    background: var(--chat-line);
}

/*
    A group, as the feed draws one, in the panel's narrower room: 16px on the sender's side and 40px
    on the far side. A phone keeps the feed's own phone padding. Another person's measures are
    stated once, for the groups and for the typing bubble, which stands where their next one will.
    The tail moves the body as one, and a typing bubble going stands in it out of the flow while the
    replies settle into its room.
*/
.chat-th-body {
    position: relative;
    --chat-grp-space: 14px;
    --chat-grp-gap: 2px;
    --chat-grp-inset: 16px;
    --chat-grp-room: 40px;
}

.chat-th-body.is-phone:not(.is-community) {
    --chat-grp-inset: 12px;
    --chat-grp-room: 36px;
}

.chat-grp {
    display: flex;
    flex-direction: column;
    gap: var(--chat-grp-gap);
    margin-top: var(--chat-grp-space);
    padding: 0 var(--chat-grp-room) 0 var(--chat-grp-inset);
}

.chat-grp.is-own {
    padding: 0 16px 0 40px;
}

.is-phone:not(.is-community) .chat-grp.is-own {
    padding: 0 12px 0 44px;
}

.is-community .chat-grp {
    gap: 0;
    margin-top: 6px;
    padding: 0;
}

/* Community's rows come 4px in from the panel's edges, except on a phone, where the row keeps its 12px. */
.chat-th-body.is-community:not(.is-phone) {
    --chat-cm-column-pad: 16px;
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, onMounted, PropType, ref, watch } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import ActionBar from "./actionBar.partial.obs";
    import MessageRow from "./messageRow.partial.obs";
    import TypingBubble from "./typingBubble.partial.obs";
    import Icon from "../ui/icon.partial.obs";
    import LoadMoreRow from "../ui/loadMoreRow.partial.obs";
    import PanelHost from "../ui/panelHost.partial.obs";
    import Pill from "../ui/pill.partial.obs";
    import SettingNote, { Note } from "../ui/settingNote.partial.obs";
    import Skeleton from "../ui/skeleton.partial.obs";
    import { useAnnouncer } from "../ui/announcer.partial";
    import { overlayHostOf, useTooltip } from "../ui/tooltip.partial";
    import { isMotionReduced } from "../ui/viewport.partial";
    import { failureNote } from "../composables/saveRule.partial";
    import { useActionBar } from "../composables/useActionBar.partial";
    import { MessageActionRequest } from "../composables/useMessageActions.partial";
    import { Typing } from "../composables/usePresence.partial";
    import { ReactionHost } from "../composables/useReactions.partial";
    import { useSentHold, useSlowSend } from "../composables/useSend.partial";
    import { FollowError } from "../composables/useThreads.partial";
    import { messageForError } from "../errors.partial";
    import { useViewArrivals } from "../messageMotion.partial";
    import { useFeedTail } from "../composables/useFeedTail.partial";
    import { useNewestEnd } from "../composables/useNewestEnd.partial";

    import { useSeenObserver } from "../composables/useSeenObserver.partial";
    import { FeedItem, FeedLayoutResult, layoutFeed, replyCountText, useLayoutAgain } from "../feedLayout.partial";
    import { useChatSession } from "../chatSession.partial";
    import { ChatError, PendingMessage, TimelineMessage } from "../types.partial";

    // #region Types

    /** What the drawer draws, in order: the feed's items, each marked root or reply, and the divider between. */
    type DrawerItem =
        | (Exclude<FeedItem, { kind: "divider" }> & { isReply: boolean })
        | { kind: "thread-divider", key: string };

    // #endregion Types

    const props = defineProps({
        /** The thread's root, null until its first page arrives. */
        root: {
            type: Object as PropType<TimelineMessage | null>,
            default: null
        },

        /** The replies held, oldest first. */
        replies: {
            type: Array as PropType<TimelineMessage[]>,
            required: true
        },

        /** The person's sends of the thread's conversation that are not stored yet; this root's replies are drawn. */
        pending: {
            type: Array as PropType<PendingMessage[]>,
            default: () => []
        },

        isFollowing: {
            type: Boolean,
            default: false
        },

        /** This thread's newest refused follow change: the change asked, which Try again asks again, and why. */
        followError: {
            type: Object as PropType<FollowError | null>,
            default: null
        },

        /** The conversation's name as the header writes it: a channel's plain, a direct message's people. */
        conversationTitle: {
            type: String as PropType<string>,
            default: ""
        },

        /** A channel's thread is drawn in Community's flat rows, a direct message's in bubbles. */
        isChannel: {
            type: Boolean,
            default: false
        },

        /** A two-person direct message names nobody over a bubble. */
        isDirectMessage: {
            type: Boolean,
            default: false
        },

        /** Opened from a list, the threads list or the mentions inbox, so Escape and the chevron go back to it. */
        isFromList: {
            type: Boolean,
            default: false
        },

        /** The title of the list the thread was opened from, which the back chevron names. */
        listTitle: {
            type: String,
            default: "Threads"
        },

        /** Whether older replies than those held remain. */
        hasMore: {
            type: Boolean,
            default: false
        },

        /** The first page is on its way. */
        isLoading: {
            type: Boolean,
            default: false
        },

        /** Why the first page failed, shown over the replies that are held. */
        error: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /**
         * Why the last page of older replies failed, shown the same way. Kept apart from the first
         * page's failure because it says nothing about whether the reader follows the thread.
         */
        olderError: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** Whether the reader leads this conversation, for the Leader pill on their own messages. */
        isPersonLeader: {
            type: Boolean,
            default: false
        },

        /** The reply a push or a link opened the thread at, once the replies hold it; scrolled to and flashed once. */
        landOnId: {
            type: Number as PropType<number | null>,
            default: null
        },

        /**
         * Fetches the page of replies before the oldest held, settling once it is in or its failure
         * is said; a page that leaves the top in view is then asked for again, which only a loader
         * the drawer can wait on allows.
         */
        loadOlder: {
            type: Function as PropType<() => Promise<void>>,
            required: true
        },

        /** Who else is typing a reply in this thread, drawn as its newest row; null for no one. */
        typing: {
            type: Object as PropType<Typing | null>,
            default: null
        },

        /** The thread's place, whose typing the record names. */
        typingPlace: {
            type: String as PropType<string | null>,
            default: null
        },

        /** A room the person has not joined, where they may read but not act on a message. */
        isPreviewing: {
            type: Boolean,
            default: false
        },

        /** The message open in the editor, which draws no bar, or null. */
        editingId: {
            type: Number as PropType<number | null>,
            default: null
        },

        /** The refusal the editor's last save met, drawn under it. */
        editError: {
            type: Object as PropType<ChatError | null>,
            default: null
        },

        /** The editor's save is out. */
        isEditSaving: {
            type: Boolean,
            default: false
        },

        /** The favorites each row's bar and sheet draw, who reacted, and the message the picker is open on. */
        reactionHost: {
            type: Object as PropType<ReactionHost | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        (e: "close"): void,
        (e: "back"): void,
        (e: "follow", isFollowing: boolean): void,
        (e: "seen", messageId: number): void,
        /** A failed reply's own Try again: the replies to send again, oldest first. */
        (e: "retry", localIds: string[]): void,
        (e: "discard", localId: string): void,
        (e: "jump", quotedMessageId: number): void,
        (e: "messageAction", request: MessageActionRequest): void
    }>();

    // #region Values

    /** The reader, and the phone flag, which draws the thread's body for a phone. */
    const session = useChatSession();
    const isPhone = session.isPhone;

    /** The thread's one action bar, on the message the pointer rests on or a keyboard reaches. */
    const actionBar = useActionBar(() => bodyElement.value);

    /** The panel host's scroller as it was when the drawer opened, which its scroll is heard on. */
    let scrollElement: HTMLElement | null = null;

    const bodyElement = ref<HTMLElement | null>(null);

    const announcer = useAnnouncer();

    /**
     * Whether the reader is at the newest reply, as the conversation keeps its own: kept there
     * through the reply composer growing under the scroller and replies growing as their photos
     * settle, and changed only by the reader's own scroll.
     */
    const reader = useNewestEnd(scroller, bodyElement);

    // A reply counts as seen once any of it is on screen, the same rule as the conversation's.
    const seen = useSeenObserver(scroller, row => emit("seen", Number(row.dataset.replyId)));

    /**
     * What this drawer has drawn new since it opened: a reply sent here or heard arriving live
     * arrives once, as in the conversation; a reply its page or a reread brings is simply there.
     */
    const { arrives } = useViewArrivals(() => blockedRuns.value);

    /**
     * Set once the thread has been scrolled to its newest reply, so the load-more row, drawn only
     * then, asks for nothing before; a row already in view as the thread is placed asks then.
     */
    const isPlaced = ref(false);

    /** The reply flashing now, cleared once its flash ends so a row drawn again does not replay it. */
    const flashingId = ref<number | null>(null);

    /** The reply already landed on, so it is scrolled to and flashed only once per landing. */
    let landedId: number | null = null;

    const olderRow = ref<InstanceType<typeof LoadMoreRow>>();

    const pageNotePart = ref<InstanceType<typeof SettingNote>>();

    const followPill = ref<InstanceType<typeof Pill>>();

    /** Follow's button, which its tip hangs on. */
    const followElement = computed((): HTMLButtonElement | undefined => followPill.value?.element);

    /** A refused follow change as its note, with Try again asking the same change once more where that can pass. */
    const followNote = computed((): Note | null => {
        const failed = props.followError;
        return failed ? failureNote(failed.failure, () => emit("follow", failed.isFollowing)) : null;
    });

    /** Ties Follow to the sentence that says what following means, once per drawer. */
    const followTipId = `chat-th-follow-${newGuid()}`;

    // The chat's own tooltip, drawn in the chat's root so the panel's edges never cut it.
    const {
        tipElement: followTipElement,
        isTipShown: isFollowTipShown,
        floatingStyles: followTipStyles,
        hideTip: hideFollowTip,
        onPointerEnter: onFollowPointerEnter,
        onPointerDown: onFollowPointerDown,
        onFocus: onFollowFocus,
        onBlur: onFollowBlur
    } = useTooltip(followElement);

    const followTipHost = ref<HTMLElement | null>(null);

    // #endregion Values

    // #region Computed Values

    /** What following a thread means, which the room's own notify setting does not say. */
    const followText = computed((): string => props.isFollowing ? "You're notified about every reply." : "Follow to be notified about every reply.");

    /** This root's replies the person is still sending, as the conversation draws its own. */
    const pendingReplies = computed((): PendingMessage[] => props.root ? props.pending.filter(row => row.parentId === props.root?.id) : []);

    /** The keys of the person's replies that settled while the thread was open, each showing "Sent" for a moment, as in the conversation. */
    const justSentKeys = useSentHold(() => pendingReplies.value, bodyElement);
    const slowSendKeys = useSlowSend(() => pendingReplies.value);

    /** Who is typing a reply as the drawer draws it: no one until the root is there, so nothing types under the skeleton. */
    const drawnTyping = computed((): Typing | null => props.root ? props.typing : null);

    /** The replies as the feed lays out its messages, someone typing among them as their next row. */
    // the typing row's run ending changes where the bubble stands, though no input of the layout moves
    const runEnded = useLayoutAgain(() => repliesLaidOut.value?.typing?.endsAt ?? null);

    const repliesLaidOut = computed((): FeedLayoutResult | null => {
        void runEnded.value;
        return props.root ? layOut(props.replies, pendingReplies.value, drawnTyping.value) : null;
    });

    const items = computed((): DrawerItem[] => {
        if (!props.root || !repliesLaidOut.value) {
            return [];
        }

        const flatten = (laid: FeedLayoutResult, isReply: boolean): DrawerItem[] => laid.sections
            .flatMap(section => section.items)
            .filter((item): item is Exclude<FeedItem, { kind: "divider" }> => item.kind !== "divider")
            .map(item => ({ ...item, isReply }));

        return [
            ...flatten(layOut([props.root], [], null), false),
            { kind: "thread-divider", key: "thread-divider" },
            ...flatten(repliesLaidOut.value, true)
        ];
    });

    /** The folded lines drawn, by key, for their tail to claim every message each stands for. */
    const blockedRuns = computed((): ReadonlyMap<string, TimelineMessage[]> => new Map(items.value
        .flatMap(item => item.kind === "blocked" ? [[item.key, item.messages] as const] : [])));

    /** The drawer's tail, as the conversation's: replies glide in, someone typing comes and goes, her reply grows out of her bubble. */
    useFeedTail({
        content: bodyElement,
        // the panel's own entrance plays on its parts, not its scroller
        scroller: () => null,
        place: () => props.typingPlace,
        // a reply can land mid-scroll, before the scroll event for where the reader now is has run
        isFollowing: () => {
            reader.read();
            return isPlaced.value && reader.isAtNewest.value;
        },
        follow: reader.toNewest,
        arrives,
        drawn: () => [drawnTyping.value, newestReplyId(), pendingReplies.value.length, repliesLaidOut.value?.typing?.isInRun]
    });

    /** The thread's parts for the panel's entrance, none until the root is there to draw. */
    const entranceKeys = computed((): string[] | null => props.root ? items.value.map(item => item.key) : null);

    /** Every reply of the thread, not only those loaded, as the root counts them. */
    const dividerText = computed((): string => {
        const count = props.root?.reply_count ?? props.replies.length;
        if (count <= 0) {
            return "No replies yet. Start the thread below.";
        }

        return replyCountText(count);
    });

    /** A failed page as its notice: the first page's alone, an older page's with Try again. */
    const pageNote = computed((): Note | null => {
        if (props.error) {
            return { kind: "error", text: messageForError(props.error) };
        }

        return props.olderError ? { kind: "error", text: messageForError(props.olderError), retry: () => void loadOlderPage() } : null;
    });

    /**
     * What asks for older replies now: the row while more wait once the thread is placed, a
     * failed page's notice, whose Try again asks, or nothing.
     */
    const pagingControl = computed((): "row" | "note" | null => {
        if (props.olderError) {
            return "note";
        }

        return props.hasMore && isPlaced.value ? "row" : null;
    });

    /** Each sender's name this thread holds, so a mention in a reply not stored yet can show who it names. */
    const senderNames = computed((): ReadonlyMap<string, string> => {
        const names = new Map<string, string>();
        for (const message of props.root ? [props.root, ...props.replies] : props.replies) {
            if (message.person_alias_guid && message.sender_nick_name) {
                names.set(message.person_alias_guid.toLowerCase(), [message.sender_nick_name, message.sender_last_name].filter(part => !!part).join(" "));
            }
        }

        return names;
    });

    // #endregion Computed Values

    // #region Event Handlers

    function onScroll(): void {
        actionBar.onScroll();
        reader.read();
    }

    function onFollow(): void {
        hideFollowTip();
        emit("follow", !props.isFollowing);
    }

    /** Try again takes its button away, so the bell it asked again takes focus. */
    async function onFollowRetry(): Promise<void> {
        await nextTick();
        followElement.value?.focus();
    }

    /** A row's flash plays once: the flash goes from the row as it ends. */
    function onAnimationEnd(event: AnimationEvent): void {
        if (flashingId.value !== null && event.animationName.includes("flash")) {
            flashingId.value = null;
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /** Lays out part of the thread by the feed's rules, in the look its conversation draws. */
    function layOut(messages: TimelineMessage[], pending: PendingMessage[], typing: Typing | null): FeedLayoutResult {
        return layoutFeed({
            messages,
            pending,
            personAliasGuid: session.me.value.personAliasGuid,
            newDividerBeforeId: null,
            layout: props.isChannel ? "community" : "conversational",
            now: new Date(),
            typists: typing?.typists.map(typist => typist.alias) ?? []
        });
    }

    /** The panel host's scroller, which holds this body. */
    function scroller(): HTMLElement | null {
        return bodyElement.value?.closest<HTMLElement>(".chat-panel-body") ?? null;
    }

    /** Asks for the page of replies before the oldest held. */
    function loadOlderPage(): Promise<void> {
        return props.loadOlder();
    }

    function newestReplyId(): number | null {
        return props.replies.length > 0 ? props.replies[props.replies.length - 1].id : null;
    }

    /** Opens at the newest reply, once the root is there to open at. */
    async function place(): Promise<void> {
        if (!props.root || isPlaced.value) {
            return;
        }

        await nextTick();
        reader.toNewest();
        observeRows();
        isPlaced.value = true;
        void land();
    }

    /**
     * Brings the reply a push or a link named to the middle of the scroller, flashes it and gives
     * it focus, as a jump to a message does, once the thread is placed at its newest, so that
     * placing does not scroll it away again. Focus moves from the composer to the reply, which is
     * what the person came to read.
     */
    async function land(): Promise<void> {
        const id = props.landOnId;
        if (!isPlaced.value || id === null || id === landedId) {
            return;
        }

        landedId = id;
        flashingId.value = id;
        await nextTick();

        const row = bodyElement.value?.querySelector<HTMLElement>(`[data-reply-id='${id}']`);
        if (!row) {
            flashingId.value = null;
            return;
        }

        // the reader is where the landing takes them from its first frame, so a reply settling on the way does not pull them back
        const element = scroller();
        if (element) {
            const box = row.getBoundingClientRect();
            reader.goingTo(element.scrollTop + box.top - element.getBoundingClientRect().top - (element.clientHeight - box.height) / 2);
        }
        row.scrollIntoView({ block: "center", behavior: isMotionReduced() ? "auto" : "smooth" });
        row.focus({ preventScroll: true });
    }

    /** Watches every reply row not watched yet; the shell keeps only the newest it is told of. */
    function observeRows(): void {
        if (bodyElement.value) {
            seen.observeAll(bodyElement.value, "[data-reply-id]");
        }
    }

    // #endregion Functions

    // #region Watchers

    watch(() => props.root, () => void place());

    // Follow is drawn only once the first page has answered, so its tip finds the chat's root then.
    watch(followElement, element => {
        followTipHost.value = overlayHostOf(element);
    });

    // A failed page and a refused follow change are said at once, each as it first shows. Each
    // failure is its own error, so a retry that fails again with the same words is said again.
    watch(() => props.error ?? props.olderError, error => {
        if (error && pageNote.value) {
            announcer.announce(pageNote.value.text, "assertive");
        }
    }, { immediate: true });

    // The row and a failed page's notice can each be taken away by the page they asked for. Read
    // before the render that removes it, focus held in the one going carries on where the thread
    // grew, as the lists hand it on: to the notice's Try again for a failure, to the row while
    // more wait, else to the first reply the page brought.
    watch(pagingControl, async (control, was) => {
        const noteElement: HTMLElement | undefined = pageNotePart.value?.$el;
        const wasHeld = was === "row" ? !!olderRow.value?.hasFocus() : was === "note" && !!noteElement?.contains(document.activeElement);
        if (!wasHeld || !isPlaced.value) {
            return;
        }

        await nextTick();
        if (control === "note") {
            (pageNotePart.value?.$el as HTMLElement | undefined)?.querySelector<HTMLElement>("button")?.focus();
        }
        else if (control === "row") {
            olderRow.value?.focus();
        }
        else if (props.replies.length > 0) {
            bodyElement.value?.querySelector<HTMLElement>(`[data-reply-id='${props.replies[0].id}']`)?.focus({ preventScroll: true });
        }
    });

    watch(() => followNote.value?.text, text => {
        if (text) {
            announcer.announce(text, "assertive");
        }
    }, { immediate: true });

    // Older replies go in above without moving what the reader is looking at; newer ones, and
    // someone starting to type, are followed when the reader is at the bottom, and the reader's own
    // replies always are.
    watch([() => props.replies[0]?.id, newestReplyId, () => pendingReplies.value.length, () => !!drawnTyping.value], async ([firstId, newestId, pendingCount], [oldFirstId, oldNewestId, oldPendingCount]) => {
        const element = scroller();
        const fromEnd = element ? reader.endOf() - element.scrollTop : 0;
        // the tail reads the reader too, before the same render, and either may run first; a
        // second read with no scroll between changes nothing
        reader.read();
        const shouldFollow = reader.isAtNewest.value || pendingCount > oldPendingCount;

        await nextTick();
        observeRows();
        if (!isPlaced.value || !element) {
            return;
        }

        if (firstId !== oldFirstId && oldFirstId !== undefined && newestId === oldNewestId) {
            element.scrollTop = reader.endOf() - fromEnd;
        }
        else if (shouldFollow) {
            reader.toNewest();
        }
    });

    // A landing the shell lets go of is done, so the next request for the same reply, a second
    // push for a reply whose thread is still open, lands on it again.
    watch(() => props.landOnId, id => {
        if (id === null) {
            landedId = null;
        }

        void land();
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(() => {
        void place();

        // A scroll does not bubble, and the scroller is the panel host's, outside this body.
        scrollElement = scroller();
        scrollElement?.addEventListener("scroll", onScroll, { passive: true });
    });

    onBeforeUnmount(() => {
        scrollElement?.removeEventListener("scroll", onScroll);
        actionBar.stop();
    });

    // #endregion Lifecycle Hooks
</script>
