<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <SettingRow :icon="icon"
                :title="title"
                :sub="description"
                :note="note"
                class="chat-set-row"
                :data-testid="`switch-${name}`"
                @click="onRowClick"
                @retry="switchElement?.focus()">
        <template #default="{ ids }">
            <!-- The words beside a switch toggle it too, as a label would. -->
            <button ref="switchElement"
                    type="button"
                    class="chat-switch"
                    role="switch"
                    :aria-checked="isOn ? 'true' : 'false'"
                    :aria-labelledby="ids.title ?? undefined"
                    :aria-describedby="describedBy(ids)"
                    @click.stop="onToggle">
                <span class="chat-switch-knob"></span>
            </button>
        </template>
    </SettingRow>
</template>

<style scoped>
.chat-set-row {
    cursor: pointer;
}

/* The switch: the line's color off and the church's fill on, its knob sliding across. */
.chat-switch {
    position: relative;
    flex: none;
    width: 36px;
    height: 20px;
    padding: 0;
    background: var(--chat-line-strong);
    border: 0;
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-base) var(--chat-ease-state);
}

.chat-switch:hover {
    background: color-mix(in srgb, var(--chat-line-strong) 80%, var(--chat-text));
}

.chat-switch[aria-checked="true"] {
    background: var(--chat-brand-fill);
}

.chat-switch[aria-checked="true"]:hover {
    background: color-mix(in srgb, var(--chat-brand-fill) 88%, var(--chat-shade));
}

.chat-switch:focus-visible {
    outline-offset: 3px;
}

.chat-switch-knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    background: var(--chat-knob);
    border-radius: 50%;
    box-shadow: var(--chat-shadow-knob);
    transition: transform var(--chat-t-base) var(--chat-ease-in);
}

.chat-switch[aria-checked="true"] .chat-switch-knob {
    transform: translateX(16px);
}
</style>

<script setup lang="ts">
    import { PropType, ref } from "vue";
    import { Note } from "./settingNote.partial.obs";
    import SettingRow, { RowIds } from "./settingRow.partial.obs";

    const props = defineProps({
        /** The setting's key, which names the row for tests and the dialog's own wiring. */
        name: {
            type: String,
            required: true
        },

        icon: {
            type: String as PropType<string | null>,
            default: null
        },

        title: {
            type: String,
            required: true
        },

        /** At most one short line under the title, or null for none. */
        description: {
            type: String as PropType<string | null>,
            default: null
        },

        isOn: {
            type: Boolean,
            default: false
        },

        note: {
            type: Object as PropType<Note | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        /** The switch was pressed, or its words: the value it asks for. */
        (e: "toggle", value: boolean): void;
    }>();

    // #region Values

    const switchElement = ref<HTMLButtonElement>();

    // #endregion Values

    // #region Functions

    /** The line under the title and the note, whichever the row has, or nothing. */
    function describedBy(ids: RowIds): string | undefined {
        return [ids.sub, ids.note].filter(id => id !== null).join(" ") || undefined;
    }

    // #endregion Functions

    // #region Event Handlers

    function onToggle(): void {
        emit("toggle", !props.isOn);
    }

    /** A press on the words toggles the switch and gives it focus, as a label does. */
    function onRowClick(): void {
        switchElement.value?.focus();
        onToggle();
    }

    // #endregion Event Handlers
</script>
