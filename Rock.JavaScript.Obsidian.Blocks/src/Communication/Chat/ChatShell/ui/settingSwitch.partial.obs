<template>
    <SettingRow :icon="icon"
                :title="title"
                :sub="description"
                :note="note"
                class="chat-set-row"
                :data-testid="`switch-${name}`"
                @click="onRowClick"
                @retry="switchElement?.focus()">
        <template #default="{ ids }">
            <!-- The words beside a switch toggle it too, as a label would. -->
            <Switch ref="switchElement"
                    :isOn="isOn"
                    :aria-labelledby="ids.title ?? undefined"
                    :aria-describedby="describedBy(ids)"
                    @click.stop="onToggle" />
        </template>
    </SettingRow>
</template>

<style scoped>
.chat-set-row {
    cursor: pointer;
}
</style>

<script setup lang="ts">
    import { PropType, ref } from "vue";
    import { Note } from "./settingNote.partial.obs";
    import SettingRow, { RowIds } from "./settingRow.partial.obs";
    import Switch from "./switch.partial.obs";

    const props = defineProps({
        /** The setting's key, which names the row for tests and the dialog's own wiring. */
        name: {
            type: String,
            required: true
        },

        icon: {
            type: String as PropType<string | null>,
            default: null
        },

        title: {
            type: String,
            required: true
        },

        /** At most one short line under the title, or null for none. */
        description: {
            type: String as PropType<string | null>,
            default: null
        },

        isOn: {
            type: Boolean,
            default: false
        },

        note: {
            type: Object as PropType<Note | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        /** The switch was pressed, or its words: the value it asks for. */
        (e: "toggle", value: boolean): void;
    }>();

    // #region Values

    const switchElement = ref<InstanceType<typeof Switch>>();

    // #endregion Values

    // #region Functions

    /** The line under the title and the note, whichever the row has, or nothing. */
    function describedBy(ids: RowIds): string | undefined {
        return [ids.sub, ids.note].filter(id => id !== null).join(" ") || undefined;
    }

    // #endregion Functions

    // #region Event Handlers

    function onToggle(): void {
        emit("toggle", !props.isOn);
    }

    /** A press on the words toggles the switch and gives it focus, as a label does. */
    function onRowClick(): void {
        switchElement.value?.focus();
        onToggle();
    }

    // #endregion Event Handlers
</script>
