<template>
    <svg class="chat-ic" :class="sizeClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <template v-for="(shape, index) in shapes" :key="index">
            <path v-if="'d' in shape" :d="shape.d" :class="{ 'is-filled': shape.isFilled }" />
            <circle v-else-if="'r' in shape" :cx="shape.cx" :cy="shape.cy" :r="shape.r" />
            <rect v-else :x="shape.x" :y="shape.y" :width="shape.width" :height="shape.height" :rx="shape.rx" />
        </template>
    </svg>
</template>

<style scoped>
/* One stroke set, 24 units square, drawn in the color of the text around it. */
.chat-ic {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.chat-ic.is-sm {
    width: 15px;
    height: 15px;
}

/* A thin stroke breaks up at 13px, so the smallest size draws heavier. */
.chat-ic.is-xs {
    width: 13px;
    height: 13px;
    stroke-width: 2;
}

.chat-ic .is-filled {
    fill: currentColor;
}
</style>

