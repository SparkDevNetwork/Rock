<template>
    <component :is="as" class="chat-skel" :class="{
                   'is-channel': shape === 'channel',
                   'is-person': shape === 'person',
                   'is-group': shape === 'group',
                   'is-bubble': shape === 'bubble',
                   'is-panel': shape === 'panel',
                   'is-reactor': shape === 'reactor',
                   'is-media': shape === 'media',
                   'is-contact': shape === 'contact',
                   'is-text': shape === 'text',
                   'is-header': shape === 'header',
                   'is-own': isOwn,
                   'is-phone': isPhone
               }" :style="shape === 'media' ? { aspectRatio: ratio } : undefined" aria-hidden="true">
        <i v-if="plan.lead" class="chat-skel-bone" :class="`is-${plan.lead}`" :style="{ width: `${plan.leadSize}px`, height: `${plan.leadSize}px` }"></i>
        <span v-if="plan.lines.length" class="chat-skel-lines">
            <i v-for="(line, index) in plan.lines"
               :key="index"
               class="chat-skel-bone"
               :class="{ 'is-bubble': shape === 'bubble' }"
               :style="{ width: line.width, height: `${line.height}px` }"></i>
            <slot />
        </span>
        <i v-if="plan.trail" class="chat-skel-bone" :style="{ width: plan.trail.width, height: `${plan.trail.height}px` }"></i>
    </component>
</template>

<style scoped>
/*
    Still, with no wait and no fade in: the first frame is the final one, so the skeleton holds the
    real row's place and size and nothing about it moves.
*/
.chat-skel {
    display: flex;
    gap: 10px;
    align-items: center;
    min-width: 0;
    padding: 0 8px;
}

.chat-skel.is-channel {
    height: 44px;
}

.chat-skel.is-person {
    height: 52px;
}

.chat-skel.is-reactor {
    height: 40px;
    padding: 0 10px;
}

/* A picture still to come is itself the one bone, at the picture's own shape. */
.chat-skel.is-media {
    display: block;
    width: 100%;
    padding: 0;
    background: var(--chat-bubble);
    border-radius: var(--chat-r-control);
}

.chat-skel.is-panel {
    align-items: flex-start;
    padding: 10px;
}

/* A profile's contact row: its icon and words at the row's own 32px and gap. */
.chat-skel.is-contact {
    gap: 9px;
    height: 32px;
    padding: 0;
}

/* Words still to come stand where they will be drawn, with no sides of their own. */
.chat-skel.is-text {
    padding: 0;
}

/* A room's head sits in the head's own row, which places it; its lines sit a little closer. */
.chat-skel.is-header {
    flex: 1;
    gap: 12px;
    padding: 0;
}

.chat-skel.is-header .chat-skel-lines {
    gap: 6px;
}

/* A feed group stands as the message row does: its gutter, gap and sides, narrower on a phone. */
.chat-skel.is-group {
    align-items: flex-start;
    gap: 12px;
    padding: 6px 20px;
}

.chat-skel.is-group.is-phone {
    gap: 10px;
    padding: 6px 12px;
}

.chat-skel.is-bubble {
    align-items: flex-end;
    padding: 2px 20px;
}

.chat-skel.is-bubble.is-phone {
    padding: 2px 12px;
}

.chat-skel.is-bubble.is-own {
    justify-content: flex-end;
}

.chat-skel-lines {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
}

.chat-skel.is-bubble .chat-skel-lines {
    flex: 0 1 60%;
}

.chat-skel.is-bubble.is-own .chat-skel-lines {
    align-items: flex-end;
}

.chat-skel-bone {
    display: block;
    flex: none;
    max-width: 100%;
    background: var(--chat-bubble);
    border-radius: var(--chat-r-inset);
}

.chat-skel-bone.is-face {
    border-radius: var(--chat-r-full);
}

.chat-skel-bone.is-tile {
    border-radius: var(--chat-r-control);
}

.chat-skel-bone.is-bubble {
    border-radius: var(--chat-r-bubble);
}

.chat-skel-bone.is-icon {
    border-radius: var(--chat-r-inline);
}
</style>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import { useChatSession } from "../chatSession.partial";
    import { RowElement } from "../types.partial";

    // #region Types

    /** The row a skeleton stands in for. */
    export type SkeletonShape = "channel" | "person" | "group" | "bubble" | "panel" | "reactor" | "media" | "contact" | "text" | "header";

    type Bone = { width: string, height: number };

    type Plan = {
        lead: "face" | "tile" | "icon" | null;
        leadSize: number;
        lines: Bone[];
        trail: Bone | null;
    };

    // #endregion Types

    // One row of the shape the real row will have, so nothing jumps when the real row lands. It
    // is decoration, hidden from a screen reader; what holds it says that it is loading.
    const props = defineProps({
        /**
         * A channel row (44px, a tile and its name), a conversation row (52px, a face, a name, a
         * line and a time), a feed group (a face, a name and lines), a bubble of a two-person
         * conversation (no face, as its rows have none), a panel row (a face over three lines), or
         * a reactor row (40px, a 28px face and a name, as the reactions list draws a person),
         * a picture still to come (one fill at the picture's shape, as a GIF in the picker's grid),
         * a contact row (32px, a small icon and a line, as a profile draws a phone or an email),
         * text (lines alone, one per width given), or a room's head (its 36px mark, its name and,
         * one per further width given, its second line).
         */
        shape: {
            type: String as PropType<SkeletonShape>,
            required: true
        },

        /** The text lines' widths, in percent, so a column of rows reads as text rather than stripes. */
        widths: {
            type: Array as PropType<number[]>,
            default: () => []
        },

        /** A picture's width over its height, such as "16 / 9", for a media row. */
        ratio: {
            type: String as PropType<string>,
            default: "1 / 1"
        },

        /** A bubble the reader sent: at the far side. */
        isOwn: {
            type: Boolean,
            default: false
        },

        /** A room's head for a channel, whose mark is a tile rather than a face. */
        isTile: {
            type: Boolean,
            default: false
        },

        /** The element drawn, li inside a list. */
        as: {
            type: String as PropType<RowElement>,
            default: "div"
        }
    });

    // A feed's rows narrow on a phone, read from the session as the list row reads it.
    const { isPhone } = useChatSession();

    /** The width given for a line, or the shape's own. */
    function widthAt(index: number, fallback: number): string {
        return `${props.widths[index] ?? fallback}%`;
    }

    /** The bones of each shape, measured from the real rows. */
    const plan = computed((): Plan => {
        switch (props.shape) {
            case "channel":
                return { lead: "tile", leadSize: 32, lines: [{ width: widthAt(0, 60), height: 10 }], trail: null };

            case "person":
                return {
                    lead: "face",
                    leadSize: 36,
                    lines: [{ width: widthAt(0, 56), height: 10 }, { width: widthAt(1, 32), height: 8 }],
                    trail: { width: "26px", height: 8 }
                };

            case "group":
                return {
                    lead: "face",
                    leadSize: isPhone.value ? 32 : 36,
                    lines: [{ width: "96px", height: 10 }, { width: widthAt(0, 92), height: 9 }, { width: widthAt(1, 60), height: 9 }],
                    trail: null
                };

            case "bubble":
                return { lead: null, leadSize: 0, lines: [{ width: widthAt(0, 100), height: 40 }], trail: null };

            case "reactor":
                return { lead: "face", leadSize: 28, lines: [{ width: widthAt(0, 44), height: 10 }], trail: null };

            case "media":
                return { lead: null, leadSize: 0, lines: [], trail: null };

            case "contact":
                return { lead: "icon", leadSize: 15, lines: [{ width: widthAt(0, 60), height: 10 }], trail: null };

            case "text":
                return { lead: null, leadSize: 0, lines: (props.widths.length ? props.widths : [88, 72]).map(width => ({ width: `${width}%`, height: 10 })), trail: null };

            // The name in the head's title type, then each further line in its second line's.
            case "header":
                return {
                    lead: props.isTile ? "tile" : "face",
                    leadSize: 36,
                    lines: (props.widths.length ? props.widths : [22]).map((width, index) => ({ width: `${width}%`, height: index === 0 ? 12 : 9 })),
                    trail: null
                };

            default:
                return {
                    lead: "face",
                    leadSize: 32,
                    lines: [{ width: widthAt(0, 46), height: 10 }, { width: widthAt(1, 92), height: 9 }, { width: widthAt(2, 60), height: 9 }],
                    trail: null
                };
        }
    });
</script>
