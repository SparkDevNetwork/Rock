<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <component :is="isButton || isLink ? 'button' : 'div'"
               :type="isButton || isLink ? 'button' : undefined"
               class="chat-sg-row"
               :class="{ 'is-button': isButton || isLink, 'is-danger': isDanger, 'is-asking': isAsking }"
               :role="isListItem ? 'listitem' : undefined">
        <slot name="lead"><Icon v-if="icon" :name="icon" class="chat-sg-ic" /></slot>
        <span class="chat-sg-txt">
            <!-- Spaced apart in words, so a reader never hears the label and its line as one. -->
            <b v-if="title" :id="`${baseId}-l`" class="chat-sg-title">{{ title }}</b>{{ " " }}
            <slot name="text"></slot>{{ " " }}
            <span v-if="sub" :id="`${baseId}-d`" class="chat-sg-sub">{{ sub }}</span>
            <InlineNotice v-if="note"
                         :id="`${baseId}-n`"
                         class="chat-sg-note"
                         :note="note"
                         data-testid="switch-note"
                         @retry="emit('retry')" />
        </span>
        <span v-if="value !== null || isLink" class="chat-sg-value" data-testid="setting-value">{{ value }}<Icon v-if="isLink" name="right" size="xs" /></span>
        <slot :ids="ids"></slot>
    </component>
</template>

<style scoped>
.chat-sg-row {
    display: flex;
    gap: 10px;
    align-items: center;
    width: 100%;
    min-height: var(--chat-sg-row-min);
    padding: 8px 12px 8px 14px;
    margin: 0;
    font: inherit;
    color: var(--chat-text);
    text-align: left;
    background: transparent;
    border: 0;
}

/* Rows in one group are ruled apart. */
.chat-sg-row + .chat-sg-row {
    border-top: 1px solid var(--chat-line);
}

.chat-sg-row.is-button {
    cursor: pointer;
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-sg-row.is-button:hover {
    background: var(--chat-hover);
}

.chat-sg-row.is-button:active {
    background: var(--chat-press);
}

/* The group clips what overflows its corners, so the ring is drawn inside the row. */
.chat-sg-row.is-button:focus-visible {
    outline-offset: -2px;
}

.chat-sg-ic {
    flex: none;
    color: var(--chat-icon);
}

.chat-sg-row.is-danger,
.chat-sg-row.is-danger .chat-sg-ic {
    color: var(--chat-danger-ink);
}

.chat-sg-row.is-danger:hover {
    background: var(--chat-danger-soft);
}

.chat-sg-txt {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    font-size: var(--chat-fs-ui);
    line-height: 1.4;
}

.chat-sg-title {
    font-weight: 500;
    overflow-wrap: anywhere;
}

.chat-sg-row.is-danger .chat-sg-title {
    font-weight: 600;
}

.chat-sg-sub {
    font-size: var(--chat-fs-small);
    color: var(--chat-muted);
}

/* The row's value at its end, muted, its chevron beside it. */
.chat-sg-value {
    display: inline-flex;
    flex: none;
    gap: 6px;
    align-items: center;
    max-width: 60%;
    font-size: var(--chat-fs-ui);
    color: var(--chat-muted);
}

/*
    A row asking a question in place, its answer at its end, is set apart by the hover fill; its line
    is the consequence the person is weighing, so it reads in the secondary text colour, not muted.
*/
.chat-sg-row.is-asking {
    background: var(--chat-hover);
}

.chat-sg-row.is-asking .chat-sg-sub {
    color: var(--chat-text-2);
}

/*
    The Leave motion: a row taken out of its list fades and shrinks to the popover's scale where it
    stands, over the fast time, still in the flow, so its group keeps its height and nothing below
    moves until it has gone; then the group closes and glides the rows below up. Its height never
    animates, and it takes no press on its way out. Under reduced motion the scale is nothing, so it
    only fades.
*/
.chat-sg-row.is-leaving {
    pointer-events: none;
    transition: opacity var(--chat-t-fast) var(--chat-ease-out), transform var(--chat-t-fast) var(--chat-ease-out);
}

.chat-sg-row.is-left {
    opacity: 0;
    transform: scale(var(--chat-pop-scale));
}

/* A note under the row's words, set apart from them. */
.chat-sg-note {
    margin-top: 4px;
}
</style>

<script setup lang="ts">
    // One row of a settings group: its icon, its short label with at most a line under it, a note
    // under them, and its control or value at the end.

    import { computed, inject, PropType } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import Icon from "./icon.partial.obs";
    import InlineNotice, { Note } from "./inlineNotice.partial.obs";

    /** The ids of the row's words, for its control to be named and described by; null for a line it does not have. */
    export type RowIds = { title: string | null, sub: string | null, note: string | null };

    const props = defineProps({
        icon: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The short label, or null where the text slot holds the row's words. */
        title: {
            type: String as PropType<string | null>,
            default: null
        },

        /** At most one short line under the label. */
        sub: {
            type: String as PropType<string | null>,
            default: null
        },

        note: {
            type: Object as PropType<Note | null>,
            default: null
        },

        /** The whole row is one button, such as Members or Leave. */
        isButton: {
            type: Boolean,
            default: false
        },

        /** What the row shows at its end, such as a count; null for none. */
        value: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The row leads to a page, such as Blocked people: one button, its chevron always drawn, after its value once it has one. */
        isLink: {
            type: Boolean,
            default: false
        },

        /** The row asks a question in place, its answer at its end, as Unblock asks in a person's row. */
        isAsking: {
            type: Boolean,
            default: false
        },

        isDanger: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        /** Try again was pressed under the row's words. */
        (e: "retry"): void;
    }>();

    // #region Values

    /** Ties the row's control to its words, once per row. */
    const baseId = `chat-sg-${newGuid()}`;

    /** Whether the row is an item of a group that is a list, such as the people blocked. */
    const isListItem = inject<boolean>("chatSettingList", false);

    // #endregion Values

    // #region Computed Values

    const ids = computed((): RowIds => ({
        title: props.title ? `${baseId}-l` : null,
        sub: props.sub ? `${baseId}-d` : null,
        note: props.note ? `${baseId}-n` : null
    }));

    // #endregion Computed Values
</script>
