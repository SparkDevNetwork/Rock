<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <section class="chat-sg-sec">
        <!-- The short label over the group; a label element where it names a field inside, so the field reads it as its name. -->
        <h4 v-if="label" :id="labelId" class="chat-sg-lbl">
            <label v-if="labelFor" :for="labelFor">{{ label }}</label>
            <template v-else>{{ label }}</template>
        </h4>
        <slot v-if="isBare" :labelId="labelId"></slot>
        <!--
            A list's rows leave by the Leave motion: each row draws its own fade where it stands,
            and once it has gone the list glides the rows below into the gap by its one move. The
            group itself moves nothing, so a row whose ask closes as it starts to leave neither
            glides itself nor sets the rows below gliding while it fades. A row has gone once its
            own fade has ended.
        -->
        <TransitionGroup v-else-if="isList"
                         ref="listGroup"
                         tag="div"
                         class="chat-sg"
                         role="list"
                         :leaveActiveClass="leavingClass"
                         :leaveToClass="leftClass"
                         :aria-labelledby="label && !ariaLabel ? labelId : undefined"
                         :aria-label="ariaLabel ?? undefined"
                         @beforeLeave="onRowLeaving"
                         @leave="onRowFading"
                         @afterLeave="onRowGone">
            <slot :labelId="labelId"></slot>
        </TransitionGroup>
        <div v-else
             class="chat-sg"
             :role="groupRole"
             :aria-labelledby="label && !ariaLabel ? labelId : undefined"
             :aria-label="ariaLabel ?? undefined">
            <slot :labelId="labelId"></slot>
        </div>
    </section>
</template>

<style scoped>
/* Space from what comes before, none at the top of what holds it: a page that opens on a group starts at its surface's padding. */
.chat-sg-sec:not(:first-child) {
    margin-top: 16px;
}

/* Rock's theme styles every heading, so this one states its whole face. */
.chat-sg-lbl {
    margin: 0 0 6px 2px;
    font-family: inherit;
    font-size: var(--chat-fs-ui);
    font-weight: 600;
    line-height: 1.4;
    color: var(--chat-muted);
}

.chat-sg-lbl label {
    margin: 0;
    font-weight: inherit;
    cursor: pointer;
}

/*
    The rounded group its rows sit in, ruled apart by the rows themselves. It sets its rows' least
    height, larger on a phone's settings sheet, so every row in it keeps one measure, a setting row
    or another kind such as the name field's.
*/
.chat-sg {
    --chat-sg-row-min: 44px;

    /* A list reads its rows' places from its own top, the one box they glide in. */
    position: relative;

    overflow: hidden;
    background: var(--chat-surface);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-surface);
}

.chat-modal.is-sheet .chat-sg {
    --chat-sg-row-min: 48px;
}
</style>

<script setup lang="ts">
    import { ComponentPublicInstance, computed, PropType, provide, ref } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { useSurfacePages } from "./surfacePages.partial";
    import { isMotionReduced } from "./viewport.partial";

    const props = defineProps({
        /** The short label over the group, or null for a group with none, such as Leave's. */
        label: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The field the label names, which makes the label a label element for it. */
        labelFor: {
            type: String as PropType<string | null>,
            default: null
        },

        /** A name read in the label's place, where the group means more than its label says. */
        ariaLabel: {
            type: String as PropType<string | null>,
            default: null
        },

        /** A list of rows, such as the people in a group, rather than a group of controls. */
        isList: {
            type: Boolean,
            default: false
        },

        /** Draws the label alone over the slot, for a control that is its own shape, such as a segmented one. */
        isBare: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        /** A list's last row has finished leaving, so what stands for an empty list can take its place. */
        (e: "empty"): void;
    }>();

    // #region Values

    /** Ties the label to the group, or to a bare control through the slot, once per group. */
    const labelId = `chat-sg-${newGuid()}`;

    /** The block's one move, which a list's rows glide by. */
    const moveClass = "chat-move";

    /** A leaving row's classes, which settingRow draws the Leave motion's fade by: under way, and at its end. */
    const leavingClass = "is-leaving";
    const leftClass = "is-left";

    /** A list's own transition, whose element holds its rows. */
    const listGroup = ref<ComponentPublicInstance | null>(null);

    /**
     * Each row's laid-out place in the list as a row began to leave, and after each row has gone;
     * the rows below one that went glide from it to their own. In the list rather than on the
     * screen: a sheet held at its bottom glides its own edge over the same move, so there the rows
     * below hold on the screen while the edge comes down. The surface owns that screen motion.
     */
    const placeOf = new WeakMap<Element, number>();

    /** The pages of the surface the group is drawn in, whose edge follows the list's own closing; null outside one. */
    const surfacePages = useSurfacePages();

    // #endregion Values

    // #region Computed Values

    /** A named group, or no role at all, since a group with no name is only noise to a screen reader. */
    const groupRole = computed((): string | undefined => props.label || props.ariaLabel ? "group" : undefined);

    // #endregion Computed Values

    // #region Functions

    /** The list's rows as they stand, a row still fading included. */
    function listRows(): HTMLElement[] {
        const list = listGroup.value?.$el as HTMLElement | undefined;
        return list ? Array.from(list.children) as HTMLElement[] : [];
    }

    // #endregion Functions

    // #region Event Handlers

    /** A row starts its fade, still holding its place: where every row stands is noted, none having moved. */
    function onRowLeaving(): void {
        for (const row of listRows()) {
            // its laid-out place, whatever glide it is drawn at
            placeOf.set(row, row.offsetTop);
        }
    }

    /**
     * A row is fading: it goes once its own fade has played to its end, or been cut short. Vue
     * alone would end the leave by a timer of the fade's length from when the end class goes on,
     * but a page busy with other work, such as redrawing the conversation an unblock reads again,
     * draws the fade's first frame later than that; the timer then took the row away with its fade
     * cut short, or before any of it was seen. Taking the done callback is what tells Vue the
     * leave's end is decided here.
     *
     * @param row The leaving row.
     * @param done Ends the leave: the row is taken away, and onRowGone follows.
     */
    function onRowFading(row: Element, done: () => void): void {
        const whenFaded = (): void => {
            // Vue ended the leave itself, as it does when a row of the same key comes back, so nothing waits.
            if (!row.classList.contains(leavingClass)) {
                return;
            }
            // Vue puts the end class on a frame or two after the leave starts, and the fade runs
            // from it; until then there is nothing to wait on.
            if (!row.classList.contains(leftClass)) {
                requestAnimationFrame(whenFaded);
                return;
            }
            // The row's own animations: the fade, and no others of a row. A row that draws no
            // fade, such as one not shown or taken out of the page, has none and goes at once; a
            // fade cut short goes too.
            const fades = typeof row.getAnimations === "function" ? row.getAnimations() : [];
            void Promise.allSettled(fades.map(fade => fade.finished)).then(done);
        };
        requestAnimationFrame(whenFaded);
    }

    /**
     * A row has faded and gone, so the group's box has closed by its height. Each row it stood above
     * is drawn back where it was seen, a glide still under way included, and glides to its place by
     * the one move; a row still fading keeps its own fade. The last row's going is told.
     */
    function onRowGone(): void {
        const rows = listRows();
        // Where less motion is asked for the move takes no time, so no transition would end to take
        // it off again: the rows below stand in their new places at once.
        const isGlideShown = !isMotionReduced();
        const gliding = rows.filter(row => {
            const before = placeOf.get(row);
            const place = row.offsetTop;
            const shift = before === undefined || row.classList.contains("is-leaving") ? 0 : before - place;
            placeOf.set(row, place);
            if (shift === 0 || !isGlideShown) {
                return false;
            }
            const seen = row.getBoundingClientRect().top;
            // no transition, so a glide under way stops and the row stands in its new place to be read
            row.style.transition = "none";
            const laid = row.getBoundingClientRect().top;
            row.style.transform = `translateY(${seen - laid + shift}px)`;
            return true;
        });

        if (gliding.length > 0) {
            // drawn where they were seen, then let go to glide
            void (listGroup.value?.$el as HTMLElement).offsetHeight;
            for (const row of gliding) {
                row.classList.add(moveClass);
                row.style.transition = "";
                row.style.transform = "";
                const onGlided = (event: TransitionEvent): void => {
                    if (event.target === row && event.propertyName === "transform") {
                        row.classList.remove(moveClass);
                        row.removeEventListener("transitionend", onGlided);
                    }
                };
                row.addEventListener("transitionend", onGlided);
            }
        }

        // The box closed by a move the list draws, so a surface that follows its content glides its
        // edge over it. Told after the rows are read, since the edge's glide moves them on the screen.
        surfacePages?.followMove();

        if (rows.length === 0) {
            emit("empty");
        }
    }

    // #endregion Event Handlers

    // A list's rows are its items. Told by name rather than a typed key, since a part's file
    // exports no values and the two parts share nothing else.
    provide("chatSettingList", props.isList);
</script>
