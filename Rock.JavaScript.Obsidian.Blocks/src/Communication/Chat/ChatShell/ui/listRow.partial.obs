<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <component :is="as"
               class="chat-lrow"
               :class="{
                   'is-interactive': interactive,
                   'is-selected': selected,
                   'is-stacked': !!$slots.detail,
                   'has-actions': !!$slots.actions,
                   'is-led': actionsShown !== null,
                   'is-held': actionsShown === true,
                   'is-instant': instant,
                   'is-dimmed': dimmed,
                   'is-phone': isPhone
               }">
        <button v-if="interactive"
                v-bind="hitAttrs"
                :ref="onHitRef"
                type="button"
                class="chat-lrow-hit"
                :aria-label="label || undefined"
                :aria-labelledby="label ? undefined : mainId"
                :aria-current="selected ? 'true' : undefined"
                @click="emit('press', $event)"></button>
        <span v-if="$slots.lead" class="chat-lrow-lead" :aria-hidden="isDrawnOnly ? 'true' : undefined" :inert="isDrawnOnly || undefined"><slot name="lead"></slot></span>
        <span :id="mainId" class="chat-lrow-main" :aria-hidden="isDrawnOnly ? 'true' : undefined" :inert="isDrawnOnly || undefined"><slot></slot></span>
        <span v-if="$slots.meta" class="chat-lrow-meta" :aria-hidden="isDrawnOnly ? 'true' : undefined" :inert="isDrawnOnly || undefined"><slot name="meta"></slot></span>
        <div v-if="$slots.detail" class="chat-lrow-detail" :aria-hidden="isDrawnOnly ? 'true' : undefined" :inert="isDrawnOnly || undefined"><slot name="detail"></slot></div>
        <span v-if="$slots.actions" class="chat-lrow-actions"><slot name="actions"></slot></span>
    </component>
</template>

<style scoped>
/*
    A row's fill is set by its state alone, and a face in it rings itself in that fill over the
    list, so the ring always matches what is behind it. A 28px face leaves the row its 40px; a
    larger one keeps 6px above and below it.
*/
.chat-lrow {
    --chat-lrow-fill: transparent;
    --chat-av-ring-over: var(--chat-lrow-fill);

    position: relative;
    display: flex;
    gap: 10px;
    align-items: center;
    min-width: 0;
    min-height: 40px;
    padding: 6px 10px;
    font-size: var(--chat-fs-ui);
    color: var(--chat-text);
    background: var(--chat-lrow-fill);
    border-radius: var(--chat-r-row);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state);
}

/*
    One hover tint, only on a row that opens something, and only where a pointer can hover: a touch
    screen keeps :hover on the row tapped until the next tap.
*/
@media (hover: hover) {
    .chat-lrow.is-interactive:hover {
        --chat-lrow-fill: var(--chat-hover);
    }
}

/* The current row keeps its wash under the pointer, so the list never loses which one it is. */
.chat-lrow.is-selected,
.chat-lrow.is-selected:hover {
    --chat-lrow-fill: var(--chat-brand-wash);
}

.chat-lrow-hit {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    border-radius: inherit;
}

.chat-lrow-hit:focus-visible {
    outline-offset: -2px;
}

.chat-lrow-hit:active {
    background: var(--chat-press);
}

/* Over the button, letting a press through to it. */
.chat-lrow.is-interactive > .chat-lrow-lead,
.chat-lrow.is-interactive > .chat-lrow-main,
.chat-lrow.is-interactive > .chat-lrow-meta,
.chat-lrow.is-interactive > .chat-lrow-detail {
    position: relative;
    pointer-events: none;
}

.chat-lrow-lead {
    display: grid;
    flex: none;
    place-items: center;
}

.chat-lrow-main {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-lrow-meta {
    display: inline-flex;
    flex: none;
    gap: 6px;
    align-items: center;
    color: var(--chat-muted);
    transition: opacity var(--chat-t-fast) var(--chat-ease-state);
}

/* A row kept in place while it is off or on its way out: what it shows fades, its actions stay whole. */
.chat-lrow.is-dimmed > .chat-lrow-lead,
.chat-lrow.is-dimmed > .chat-lrow-main,
.chat-lrow.is-dimmed > .chat-lrow-meta,
.chat-lrow.is-dimmed > .chat-lrow-detail {
    opacity: .55;
}

/*
    A row whose words run on under its first line, as a message's are: the lead beside every line
    at the top, the meta beside the first line, and the lines under it as wide as both.
*/
.chat-lrow.is-stacked {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0;
    align-items: start;
    padding: 10px 10px 11px;
}

.chat-lrow.is-stacked > .chat-lrow-lead {
    grid-row: 1 / span 2;
    grid-column: 1;
    margin-right: 10px;
}

.chat-lrow.is-stacked > .chat-lrow-main {
    grid-row: 1;
    grid-column: 2;
}

.chat-lrow.is-stacked > .chat-lrow-meta {
    grid-row: 1;
    grid-column: 3;
    align-self: center;
    padding-left: 8px;
}

.chat-lrow.is-stacked > .chat-lrow-detail {
    grid-row: 2;
    grid-column: 2 / -1;
    min-width: 0;
}

/* Its actions sit over the meta at its top end, rather than taking a column from every line. */
.chat-lrow.is-stacked > .chat-lrow-actions {
    position: absolute;
    top: 5px;
    right: 6px;
}

/*
    The row's own buttons, over the row's, shown while the row is hovered or holds focus. A list
    that leads them (is-led), as one following the pointer from row to row does, holds them out
    itself (is-held), and they pass from row to row at once while it asks (is-instant). A menu of
    the row open keeps them, and a phone always shows them.
*/
.chat-lrow-actions {
    position: relative;
    display: inline-flex;
    flex: none;
    gap: 4px;
    align-items: center;
    opacity: 0;
    transition: opacity var(--chat-t-fast) var(--chat-ease-state);
}

.chat-lrow.is-instant .chat-lrow-actions,
.chat-lrow.is-instant > .chat-lrow-meta {
    transition: none;
}

@media (hover: hover) {
    .chat-lrow:not(.is-led):hover .chat-lrow-actions {
        opacity: 1;
    }

    .chat-lrow.is-stacked.has-actions:not(.is-led):hover > .chat-lrow-meta {
        opacity: 0;
    }
}

.chat-lrow:focus-within .chat-lrow-actions,
.chat-lrow:has([aria-expanded="true"]) .chat-lrow-actions,
.chat-lrow.is-held .chat-lrow-actions,
.chat-lrow.is-phone .chat-lrow-actions {
    opacity: 1;
}

.chat-lrow.is-stacked.has-actions:focus-within > .chat-lrow-meta,
.chat-lrow.is-stacked.has-actions:has([aria-expanded="true"]) > .chat-lrow-meta,
.chat-lrow.is-stacked.has-actions.is-held > .chat-lrow-meta,
.chat-lrow.is-stacked.has-actions.is-phone > .chat-lrow-meta {
    opacity: 0;
}

/* A finger cannot hover, so its actions are always there. */
@media (hover: none) {
    .chat-lrow-actions {
        opacity: 1;
    }

    .chat-lrow.is-stacked.has-actions > .chat-lrow-meta {
        opacity: 0;
    }
}
</style>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { RowElement } from "../types.partial";
    import { useChatSession } from "../chatSession.partial";

    // One row of a list: a lead (a face or a mark), what it says, a meta at its end, lines under
    // the first where its words run on, and actions. A row that opens something is one button
    // under the whole row, so its actions stay buttons of their own rather than buttons inside a
    // button.
    const props = defineProps({
        /** Opens something when pressed: a button under the row, and the hover tint. */
        interactive: {
            type: Boolean,
            default: false
        },

        /** The current one of the list: the church's wash, and its button says so. */
        selected: {
            type: Boolean,
            default: false
        },

        /** The button's name where what the row says is not the whole of it; what it says by default. */
        label: {
            type: String as PropType<string>,
            default: ""
        },

        /** What the list puts on the row's button: its test id and data, a description, the list's keys. */
        hitAttrs: {
            type: Object as PropType<Record<string, unknown>>,
            default: () => ({})
        },

        /** Hands the list the row's button as it is drawn, and null as it goes, for the list's keys to move focus to. */
        hitRef: {
            type: Function as PropType<(element: unknown) => void>,
            default: null
        },

        /**
         * Whether the list holds the actions out, where it leads them itself; null leaves them to
         * the row's own hover.
         */
        actionsShown: {
            type: Boolean as PropType<boolean | null>,
            default: null
        },

        /** The actions come and go at once, as the list passes them from row to row. */
        instant: {
            type: Boolean,
            default: false
        },

        /** Kept in place while it is off or on its way out: drawn faded. */
        dimmed: {
            type: Boolean,
            default: false
        },

        /** The element drawn, li inside a list. */
        as: {
            type: String as PropType<RowElement>,
            default: "div"
        }
    });

    const emit = defineEmits<{
        (e: "press", event: MouseEvent): void;
    }>();

    const { isPhone } = useChatSession();

    const mainId = `chat-lrow-${newGuid()}`;

    /**
     * Whether the button's label is the row's whole name. What is drawn is then for the eye alone:
     * never read again after the name, and a link or a chip in it never reached.
     */
    const isDrawnOnly = computed((): boolean => props.interactive && !!props.label);

    /** Passes the button to the list as it is drawn and as it goes. */
    function onHitRef(element: unknown): void {
        props.hitRef?.(element);
    }
</script>
