<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <span class="chat-save-ind" :data-state="shownState" aria-hidden="true">
        <!-- Seen, not read: what each save comes to is said in the dialog's own live region. Kept
             inside the root, since a comment beside it makes a fragment that drops the caller's attributes. -->
        <template v-if="state === 'saving'"><span class="chat-spinner"></span><span>Saving</span></template>
        <template v-else-if="state === 'saved'"><Icon name="check" size="xs" /><span>Saved</span></template>
        <template v-else-if="state === 'pending'"><Icon name="clock" size="xs" /><span>Saved, syncing</span></template>
        <template v-else-if="state === 'refused'"><Icon name="alert" size="xs" /><span>Not saved</span></template>
    </span>
</template>

<style scoped>
/* A settings dialog's head: Saving, Saved in success that fades, Saved, syncing, or Not saved. */
.chat-save-ind {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    margin-left: auto;
    font-size: 12px;
    font-weight: 600;
    color: var(--chat-muted);
    white-space: nowrap;
    transition: opacity var(--chat-t-base) var(--chat-ease-state);
}

.chat-save-ind[data-state="saved"] {
    color: var(--chat-success);
}

.chat-save-ind[data-state="fade"] {
    color: var(--chat-success);
    opacity: 0;
}

.chat-save-ind[data-state="refused"] {
    color: var(--chat-danger-ink);
}

.chat-save-ind .chat-spinner {
    width: 11px;
    height: 11px;
}

.chat-save-ind > * {
    animation: chat-save-in var(--chat-t-base) var(--chat-ease-in);
}

@keyframes chat-save-in {
    from {
        opacity: 0;
        transform: translateY(2px);
    }
}

/* Reduced motion: each word only fades in. */
@media (prefers-reduced-motion: reduce) {
    .chat-save-ind > * {
        animation-name: chat-save-fade-in;
    }
}

@keyframes chat-save-fade-in {
    from {
        opacity: 0;
    }
}
</style>

<script setup lang="ts">
    import { computed, onBeforeUnmount, PropType, ref, watch } from "vue";
    import Icon from "./icon.partial.obs";

    /** Where a save stands, as a settings dialog shows it. */
    export type SaveIndicatorState = "saving" | "saved" | "pending" | "refused";

    const props = defineProps({
        /** The newest save's state, or null before any. */
        state: {
            type: String as PropType<SaveIndicatorState | null>,
            default: null
        },

        /** Moves on with each save, so a second Saved in a row shows and fades afresh. */
        mark: {
            type: Number,
            default: 0
        }
    });

    // #region Values

    /** "Saved" fades from the head after this long, the design's hold. */
    const savedFadeMs = 1600;

    const isFaded = ref(false);
    let fadeTimer: ReturnType<typeof setTimeout> | null = null;

    // #endregion Values

    // #region Computed Values

    const shownState = computed((): string | undefined => props.state === "saved" && isFaded.value ? "fade" : props.state ?? undefined);

    // #endregion Computed Values

    // #region Functions

    function clearFade(): void {
        if (fadeTimer !== null) {
            clearTimeout(fadeTimer);
            fadeTimer = null;
        }
    }

    // #endregion Functions

    // #region Watchers

    watch(() => [props.state, props.mark] as const, ([state]) => {
        isFaded.value = false;
        clearFade();
        if (state === "saved") {
            fadeTimer = setTimeout(() => {
                fadeTimer = null;
                isFaded.value = true;
            }, savedFadeMs);
        }
    }, { immediate: true });

    // #endregion Watchers

    onBeforeUnmount(clearFade);
</script>
