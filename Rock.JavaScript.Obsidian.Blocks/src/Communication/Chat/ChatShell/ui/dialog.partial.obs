<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Transition leave-active-class="is-leaving">
        <div v-if="isOpen"
             class="chat-modal"
             :class="{ 'is-sheet': isSheet, 'is-top': placement === 'top' && !isSheet }"
             data-testid="dialog-scrim"
             @mousedown.self="onScrimDown"
             @click.self="onScrimClick">
            <div ref="dialogElement"
                 class="chat-dialog"
                 :class="{ 'is-wide': isWide || isPanel, 'is-panel': isPanel, 'is-media': isMedia }"
                 role="dialog"
                 aria-modal="true"
                 :tabindex="isPanel ? -1 : undefined"
                 :aria-labelledby="titleId"
                 data-testid="dialog"
                 @keydown="onKeydown">
                <!-- A panel: a fixed head with its tools, and a body that scrolls under it. -->
                <template v-if="isPanel">
                    <div class="chat-dialog-head">
                        <h3 :id="titleId" class="chat-dialog-title">{{ title }}</h3>
                        <slot name="tools" />
                    </div>
                    <div class="chat-dialog-scroll">
                        <slot />
                    </div>
                </template>
                <template v-else>
                    <!-- A wide dialog's close button sits beside its title. -->
                    <div v-if="$slots.tools" class="chat-dialog-top">
                        <h3 :id="titleId" class="chat-dialog-title">{{ title }}</h3>
                        <slot name="tools" />
                    </div>
                    <h3 v-else :id="titleId" class="chat-dialog-title">{{ title }}</h3>
                    <p v-if="body" class="chat-dialog-body">{{ body }}</p>
                    <slot />
                    <div v-if="$slots.preview" class="chat-dialog-preview" data-testid="dialog-preview">
                        <slot name="preview" />
                    </div>
                    <div class="chat-dialog-actions">
                        <slot name="actions">
                            <Button ref="cancelElement" kind="line" data-testid="dialog-cancel" @click="emit('close')">Cancel</Button>
                            <Button v-if="confirmLabel"
                                    :kind="isDestructive ? 'danger' : 'brand'"
                                    data-testid="dialog-confirm"
                                    @click="emit('confirm')">{{ confirmLabel }}</Button>
                        </slot>
                    </div>
                </template>
            </div>
        </div>
    </Transition>
</template>

<style scoped>
/* Over the chat's frame, not the page: the host places the dialog inside the frame. */
.chat-modal {
    position: absolute;
    inset: 0;
    z-index: var(--chat-z-modal);
    display: grid;
    place-items: center;
    padding: 16px;
    background: var(--chat-scrim);
    animation: chat-fade-in var(--chat-t-base) var(--chat-ease-state);
}

/*
    Anchored at the top, a header's height down: a body that grows or shrinks while open, as a
    note coming and going, moves only the dialog's foot, never its title.
*/
.chat-modal.is-top {
    place-items: start center;
    padding-top: 64px;
}

.chat-modal.is-leaving {
    animation: chat-fade-out var(--chat-t-fast) var(--chat-ease-out) forwards;
}

/* A dialog with no control to start on holds focus itself, which draws no ring around the whole dialog. */
.chat-dialog:focus {
    outline: none;
}

.chat-dialog {
    width: min(420px, 100%);
    padding: 20px 20px 16px;
    background: var(--chat-raised);
    border-radius: var(--chat-r-surface);
    box-shadow: var(--chat-shadow-pop);
    animation: chat-pop-in var(--chat-d-dialog-in) var(--chat-ease-in);
}

.chat-dialog.is-wide {
    width: min(520px, 100%);
}

/* A panel keeps its head in view and scrolls only its body, within the frame's height. */
.chat-dialog.is-panel {
    display: flex;
    flex-direction: column;
    max-height: calc(100% - 8px);
    padding: 0;
    overflow: hidden;
}

.chat-dialog-head {
    display: flex;
    flex: none;
    gap: 10px;
    align-items: center;
    padding: 14px 12px 12px 20px;
    border-bottom: 1px solid var(--chat-line);
}

.chat-dialog-head .chat-dialog-title {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-size: var(--chat-fs-title);
}

.chat-dialog-scroll {
    padding: 18px 20px 20px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
}

/*
    A photo's panel fills the frame, its body holding the photo whole and centred. The body's one
    cell is the body's own size rather than its content's, so a photo's limits in percent are read
    against it and a tall photo fits the height instead of running past the foot.
*/
.chat-dialog.is-media {
    width: 100%;
    height: 100%;
    max-height: none;
}

.chat-dialog.is-media .chat-dialog-scroll {
    display: grid;
    flex: 1;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    min-height: 0;
    padding: 12px;
    overflow: hidden;
}

/* On a phone a dialog that asks for it rises from the bottom as a sheet. */
.chat-modal.is-sheet {
    place-items: end stretch;
    padding: 0;
}

.chat-modal.is-sheet .chat-dialog-head {
    padding-left: 16px;
}

/* The sheet's body runs nearer the phone's edges, with more room above the home bar. */
.chat-modal.is-sheet .chat-dialog-scroll {
    padding: 16px 16px 24px;
}

.chat-modal.is-sheet .chat-dialog {
    width: 100%;
    max-height: 90%;
    border-radius: var(--chat-r-surface) var(--chat-r-surface) 0 0;
    animation: chat-slide-in var(--chat-t-panel) var(--chat-ease-in);
}

.chat-dialog-top {
    display: flex;
    gap: 8px;
    align-items: center;
    margin: -4px -8px 10px 0;
}

.chat-dialog-top .chat-dialog-title {
    flex: 1;
    min-width: 0;
    margin: 0;
}

.chat-dialog-title {
    margin: 0 0 6px;
    font-size: var(--chat-fs-title);
    font-weight: 700;
    color: var(--chat-text);
}

.chat-dialog-body {
    margin: 0 0 14px;
    color: var(--chat-muted);
}

.chat-dialog-preview {
    padding: 10px 12px;
    margin-bottom: 16px;
    font-size: var(--chat-fs-ui);
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-surface);
}

/* The actions are the button part's, its own or the caller's, lined up at the end. */
.chat-dialog-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}
</style>

<script setup lang="ts">
    import { computed, PropType, ref } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { useChatSession } from "../chatSession.partial";
    import Button from "./button.partial.obs";
    import { useAnnouncerModal } from "./announcer.partial";
    import { useFocusTrap } from "./focusTrap.partial";

    const props = defineProps({
        isOpen: {
            type: Boolean,
            default: false
        },

        /** The dialog's title, which also names it to a screen reader. */
        title: {
            type: String,
            required: true
        },

        /** One line under the title. */
        body: {
            type: String,
            default: ""
        },

        /** The action's label; with none, the dialog draws Cancel alone or the actions slot. */
        confirmLabel: {
            type: String,
            default: ""
        },

        /** Whether the action cannot be undone: it is drawn in danger, and Cancel takes focus first. */
        isDestructive: {
            type: Boolean,
            default: false
        },

        isWide: {
            type: Boolean,
            default: false
        },

        /**
         * Where it stands in the frame: centred, as a question does, or anchored at the top, for
         * a dialog whose body changes height while it is open. A sheet rises from the bottom either way.
         */
        placement: {
            type: String as PropType<"center" | "top">,
            default: "center"
        },

        /**
         * Whether this is a panel rather than a question: a head holding the title and the tools
         * slot, a body that scrolls under it, and no actions row, as settings and lists are.
         */
        isPanel: {
            type: Boolean,
            default: false
        },

        /** Whether the panel shows a photo: it fills the frame and holds its body centred. */
        isMedia: {
            type: Boolean,
            default: false
        },

        /**
         * When the dialog rises from the bottom as a sheet: never, on a phone as the session reads
         * one, or always, for a caller that wants one wherever there is no hover either.
         */
        sheet: {
            type: String as PropType<"never" | "phone" | "always">,
            default: "never"
        },

        /**
         * Finds what focus goes back to on close, for a dialog whose opener was gone before it
         * opened, as a card or a menu closed to ask it; what it finds wins over what had focus.
         */
        returnFocus: {
            type: Function as PropType<() => HTMLElement | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        /** Cancel, Escape or a click on the scrim. */
        (e: "close"): void;
        (e: "confirm"): void;
    }>();

    // #region Values

    const dialogElement = ref<HTMLElement>();
    const cancelElement = ref<InstanceType<typeof Button>>();
    const titleId = `chat-dialog-${newGuid()}`;

    const session = useChatSession();

    /** Whether it is drawn as a sheet now. */
    const isSheet = computed((): boolean => props.sheet === "always" || (props.sheet === "phone" && session.isPhone.value));

    /** Whether the press that ends in a click began on the scrim, so a drag out of the dialog does not close it. */
    let isScrimPress = false;

    // #endregion Values

    // #region Event Handlers

    function onKeydown(event: KeyboardEvent): void {
        if (event.key === "Escape") {
            // The dialog's Escape is its own, never also the panel's or the menu's behind it.
            event.stopPropagation();
            emit("close");
        }
    }

    function onScrimDown(): void {
        isScrimPress = true;
    }

    function onScrimClick(): void {
        if (isScrimPress) {
            emit("close");
        }
        isScrimPress = false;
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * A destructive confirm starts on Cancel, so Enter never deletes by accident; any other on the
     * control it marks, else its first, else the dialog itself. A panel's first control is the
     * close button in its head, which the trap focuses quietly so its tooltip does not show unasked.
     */
    function firstFocus(controls: HTMLElement[]): HTMLElement | null {
        const cancel = cancelElement.value?.buttonElement;
        if (props.isDestructive && cancel) {
            return cancel;
        }

        return dialogElement.value?.querySelector<HTMLElement>("[data-autofocus]") ?? controls[0] ?? dialogElement.value ?? null;
    }

    // #endregion Functions

    // Focus is kept inside while open and goes back to what opened it the moment the dialog closes,
    // not after its fade, so a keyboard user is never left on a vanishing control; quietly, since
    // the person is leaving the dialog, not reaching for the opener, so its tooltip or card does not rise.
    const trapped = (): HTMLElement | undefined => props.isOpen ? dialogElement.value : undefined;
    useFocusTrap(trapped, { returnTo: () => props.returnFocus?.() ?? null, initialFocus: firstFocus });
    useAnnouncerModal(trapped);
</script>
