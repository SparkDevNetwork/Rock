<template>
    <Transition leave-active-class="is-leaving">
        <div v-if="isOpen"
             class="chat-modal"
             :class="{ 'is-sheet': isPhone }"
             data-testid="dialog-scrim"
             @mousedown.self="onScrimDown"
             @click.self="onScrimClick">
            <div ref="dialogElement"
                 class="chat-dialog"
                 :class="{ 'is-wide': isWide || isPanel, 'is-panel': isPanel, 'is-media': isMedia }"
                 role="dialog"
                 aria-modal="true"
                 :tabindex="isPanel ? -1 : undefined"
                 :aria-labelledby="titleId"
                 data-testid="dialog"
                 @keydown="onKeydown">
                <!-- A panel: a fixed head with its tools, and a body that scrolls under it. -->
                <template v-if="isPanel">
                    <div class="chat-dialog-head">
                        <h3 :id="titleId" class="chat-dialog-title">{{ title }}</h3>
                        <slot name="tools" />
                    </div>
                    <div class="chat-dialog-scroll">
                        <slot />
                    </div>
                </template>
                <template v-else>
                    <!-- A wide dialog's close button sits beside its title. -->
                    <div v-if="$slots.tools" class="chat-dialog-top">
                        <h3 :id="titleId" class="chat-dialog-title">{{ title }}</h3>
                        <slot name="tools" />
                    </div>
                    <h3 v-else :id="titleId" class="chat-dialog-title">{{ title }}</h3>
                    <p v-if="body" class="chat-dialog-body">{{ body }}</p>
                    <slot />
                    <div v-if="$slots.preview" class="chat-dialog-preview" data-testid="dialog-preview">
                        <slot name="preview" />
                    </div>
                    <div class="chat-dialog-actions">
                        <slot name="actions">
                            <button ref="cancelElement"
                                    type="button"
                                    class="chat-dialog-btn is-line"
                                    data-testid="dialog-cancel"
                                    @click="emit('close')">Cancel</button>
                            <button v-if="confirmLabel"
                                    type="button"
                                    class="chat-dialog-btn"
                                    :class="isDestructive ? 'is-danger' : 'is-brand'"
                                    data-testid="dialog-confirm"
                                    @click="emit('confirm')">{{ confirmLabel }}</button>
                        </slot>
                    </div>
                </template>
            </div>
        </div>
    </Transition>
</template>

<style scoped>
/* Over the chat's frame, not the page: the host places the dialog inside the frame. */
.chat-modal {
    position: absolute;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    padding: 16px;
    background: var(--chat-scrim);
    animation: chat-scrim-in var(--chat-t-base) var(--chat-ease-state);
}

.chat-modal.is-leaving {
    animation: chat-scrim-out var(--chat-t-fast) var(--chat-ease-out) forwards;
}

@keyframes chat-scrim-in {
    from {
        opacity: 0;
    }
}

@keyframes chat-scrim-out {
    to {
        opacity: 0;
    }
}

/* A dialog with no control to start on holds focus itself, which draws no ring around the whole dialog. */
.chat-dialog:focus {
    outline: none;
}

.chat-dialog {
    width: min(420px, 100%);
    padding: 20px 20px 16px;
    background: var(--chat-raised);
    border-radius: var(--chat-r-dialog);
    box-shadow: var(--chat-shadow-pop);
    animation: chat-dialog-in var(--chat-d-dialog-in) var(--chat-ease-in);
}

.chat-dialog.is-wide {
    width: min(520px, 100%);
}

@keyframes chat-dialog-in {
    from {
        opacity: 0;
        transform: translateY(8px) scale(var(--chat-pop-scale));
    }
}

/* A panel keeps its head in view and scrolls only its body, within the frame's height. */
.chat-dialog.is-panel {
    display: flex;
    flex-direction: column;
    max-height: calc(100% - 8px);
    padding: 0;
    overflow: hidden;
}

.chat-dialog-head {
    display: flex;
    flex: none;
    gap: 10px;
    align-items: center;
    padding: 14px 12px 12px 20px;
    border-bottom: 1px solid var(--chat-line);
}

.chat-dialog-head .chat-dialog-title {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-size: 16px;
}

.chat-dialog-scroll {
    padding: 18px 20px 20px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
}

/* A photo's panel fills the frame, its body holding the photo whole and centred. */
.chat-dialog.is-media {
    width: 100%;
    height: 100%;
    max-height: none;
}

.chat-dialog.is-media .chat-dialog-scroll {
    display: grid;
    flex: 1;
    place-items: center;
    min-height: 0;
    padding: 12px;
    overflow: hidden;
}

/* On a phone a dialog that asks for it rises from the bottom as a sheet. */
.chat-modal.is-sheet {
    place-items: end stretch;
    padding: 0;
}

.chat-modal.is-sheet .chat-dialog-head {
    padding-left: 16px;
}

/* The sheet's body runs nearer the phone's edges, with more room above the home bar. */
.chat-modal.is-sheet .chat-dialog-scroll {
    padding: 16px 16px 24px;
}

.chat-modal.is-sheet .chat-dialog {
    width: 100%;
    max-height: 90%;
    border-radius: var(--chat-r-sheet) var(--chat-r-sheet) 0 0;
    animation: chat-sheet-rise var(--chat-t-panel) var(--chat-ease-in);
}

@keyframes chat-sheet-rise {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
}

.chat-dialog-top {
    display: flex;
    gap: 8px;
    align-items: center;
    margin: -4px -8px 10px 0;
}

.chat-dialog-top .chat-dialog-title {
    flex: 1;
    min-width: 0;
    margin: 0;
}

.chat-dialog-title {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 700;
    color: var(--chat-text);
}

.chat-dialog-body {
    margin: 0 0 14px;
    color: var(--chat-muted);
}

.chat-dialog-preview {
    padding: 10px 12px;
    margin-bottom: 16px;
    font-size: 13.5px;
    background: var(--chat-sidebar);
    border: 1px solid var(--chat-line);
    border-radius: var(--chat-r-lg);
}

.chat-dialog-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}

/* The large button: Cancel outlined, the action in its color; a dialog's own actions use it too. */
.chat-dialog-btn,
:slotted(.chat-dialog-btn) {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    height: 38px;
    padding: 0 18px;
    font-size: 14px;
    font-weight: 600;
    border: 0;
    border-radius: var(--chat-r-full);
    transition: background-color var(--chat-t-fast) var(--chat-ease-state), border-color var(--chat-t-fast) var(--chat-ease-state), color var(--chat-t-fast) var(--chat-ease-state);
}

/* The design's regular button, which Add people's Cancel and Add are, a size under the large one. */
:slotted(.chat-dialog-btn.is-regular) {
    height: 30px;
    padding: 0 14px;
    font-size: 13px;
}

.chat-dialog-btn.is-line,
:slotted(.chat-dialog-btn.is-line) {
    color: var(--chat-text);
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
}

.chat-dialog-btn.is-line:hover,
:slotted(.chat-dialog-btn.is-line:hover) {
    border-color: var(--chat-icon);
}

:slotted(.chat-dialog-btn.is-ghost) {
    color: var(--chat-text-2);
    background: none;
}

:slotted(.chat-dialog-btn.is-ghost:hover) {
    background: var(--chat-hover);
}

.chat-dialog-btn.is-brand,
:slotted(.chat-dialog-btn.is-brand) {
    color: var(--chat-on-brand);
    background: var(--chat-brand-fill);
}

.chat-dialog-btn.is-danger,
:slotted(.chat-dialog-btn.is-danger) {
    color: var(--chat-on-danger);
    background: var(--chat-danger);
}

.chat-dialog-btn.is-danger:hover,
:slotted(.chat-dialog-btn.is-danger:hover:not(:disabled)) {
    background: var(--chat-danger-hover);
}

/* An action waiting for a choice, or for its answer, stays drawn but quiet. */
:slotted(.chat-dialog-btn:disabled) {
    cursor: default;
    opacity: .5;
}

:slotted(.chat-dialog-btn[aria-busy="true"]) {
    opacity: .75;
}

:slotted(.chat-dialog-btn .chat-spinner) {
    width: 13px;
    height: 13px;
}

/* Reduced motion: the dialog only fades in, with the scrim. */
@media (prefers-reduced-motion: reduce) {
    .chat-dialog,
    .chat-modal.is-sheet .chat-dialog {
        animation-name: chat-scrim-in;
    }
}
</style>

<script setup lang="ts">
    import { nextTick, ref, watch } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import { focusQuietly } from "./tooltip.partial";

    const props = defineProps({
        isOpen: {
            type: Boolean,
            default: false
        },

        /** The dialog's title, which also names it to a screen reader. */
        title: {
            type: String,
            required: true
        },

        /** One line under the title. */
        body: {
            type: String,
            default: ""
        },

        /** The action's label; with none, the dialog draws Cancel alone or the actions slot. */
        confirmLabel: {
            type: String,
            default: ""
        },

        /** Whether the action cannot be undone: it is drawn in danger, and Cancel takes focus first. */
        isDestructive: {
            type: Boolean,
            default: false
        },

        isWide: {
            type: Boolean,
            default: false
        },

        /**
         * Whether this is a panel rather than a question: a head holding the title and the tools
         * slot, a body that scrolls under it, and no actions row, as settings and lists are.
         */
        isPanel: {
            type: Boolean,
            default: false
        },

        /** Whether the panel shows a photo: it fills the frame and holds its body centred. */
        isMedia: {
            type: Boolean,
            default: false
        },

        /** Whether the dialog rises from the bottom as a sheet, as one does on a phone. */
        isPhone: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        /** Cancel, Escape or a click on the scrim. */
        (e: "close"): void;
        (e: "confirm"): void;
    }>();

    // #region Values

    const dialogElement = ref<HTMLElement>();
    const cancelElement = ref<HTMLButtonElement>();
    const titleId = `chat-dialog-${newGuid()}`;

    /** What had focus when the dialog opened, given it back on close. */
    let opener: HTMLElement | null = null;

    /** Whether the press that ends in a click began on the scrim, so a drag out of the dialog does not close it. */
    let isScrimPress = false;

    const focusableSelector = "button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [contenteditable='true'], [tabindex='0']";

    // #endregion Values

    // #region Event Handlers

    function onKeydown(event: KeyboardEvent): void {
        if (event.key === "Escape") {
            // The dialog's Escape is its own, never also the panel's or the menu's behind it.
            event.stopPropagation();
            emit("close");
        }
        else if (event.key === "Tab") {
            trapTab(event);
        }
    }

    function onScrimDown(): void {
        isScrimPress = true;
    }

    function onScrimClick(): void {
        if (isScrimPress) {
            emit("close");
        }
        isScrimPress = false;
    }

    // #endregion Event Handlers

    // #region Functions

    /** Keeps Tab inside the dialog, wrapping from the last control to the first and back. */
    function trapTab(event: KeyboardEvent): void {
        const controls = focusables();
        if (controls.length === 0) {
            event.preventDefault();
            return;
        }

        const first = controls[0];
        const last = controls[controls.length - 1];
        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
        }
        else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
        }
    }

    function focusables(): HTMLElement[] {
        return Array.from(dialogElement.value?.querySelectorAll<HTMLElement>(focusableSelector) ?? []);
    }

    /**
     * A destructive confirm starts on Cancel, so Enter never deletes by accident; any other on the
     * control it marks, else its first. A panel's first control is the close button in its head,
     * focused quietly so its tooltip does not show unasked.
     */
    function focusFirst(): void {
        const marked = dialogElement.value?.querySelector<HTMLElement>("[data-autofocus]");
        if (props.isDestructive && cancelElement.value) {
            cancelElement.value.focus({ preventScroll: true });
        }
        else if (marked) {
            marked.focus({ preventScroll: true });
        }
        else if (props.isPanel && focusables()[0]) {
            focusQuietly(focusables()[0]);
        }
        else {
            (focusables()[0] ?? dialogElement.value)?.focus({ preventScroll: true });
        }
    }

    /**
     * Gives focus back to the opener, when it is still on the page, quietly: the person is
     * leaving the dialog, not reaching for the opener, so its tooltip or card does not rise.
     */
    function returnFocus(): void {
        if (opener && opener.isConnected) {
            focusQuietly(opener, { preventScroll: true });
        }
        opener = null;
    }

    // #endregion Functions

    // #region Watchers

    watch(() => props.isOpen, async isOpen => {
        if (isOpen) {
            opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
            await nextTick();
            focusFirst();
        }
        else {
            // At once, not after the fade, so a keyboard user is never left on a vanishing control.
            returnFocus();
        }
    }, { immediate: true });

    // #endregion Watchers
</script>
