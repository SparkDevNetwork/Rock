<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <span class="chat-set-note" :data-kind="note.kind">
        <!-- A line under a setting: what a change means, or why its save failed and Try again. A
             save that lands has no line, since the control already shows it. Kept inside the root,
             since a comment beside it makes a fragment that drops the caller's attributes. -->
        <Icon :name="note.kind === 'error' ? 'alert' : 'info'" size="xs" />
        <span>{{ note.text }}<template v-if="note.retry">{{ " " }}<Button class="chat-set-retry" size="sm" data-testid="note-retry" @click="onRetry">Try again</Button></template></span>
    </span>
</template>

<style scoped>
.chat-set-note {
    display: flex;
    gap: 6px;
    align-items: flex-start;
    font-size: var(--chat-fs-small);
    font-weight: 600;
    color: var(--chat-muted);
    --chat-enter-from: var(--chat-rise-sm);
    animation: chat-enter var(--chat-t-base) var(--chat-ease-in);
}

.chat-set-note[data-kind="error"] {
    color: var(--chat-danger-ink);
}

.chat-set-note :deep(.chat-ic) {
    flex: none;
    margin-top: 2px;
}

/* Try again follows the sentence on its line. */
.chat-set-retry {
    vertical-align: middle;
}
</style>

<script setup lang="ts">
    import { PropType } from "vue";
    import Button from "./button.partial.obs";
    import Icon from "./icon.partial.obs";

    /** A line under a setting: what a change means, or a failed save's sentence with a way to ask it again. */
    export type Note = { kind: "info" | "error", text: string, retry?: () => void };

    const props = defineProps({
        note: {
            type: Object as PropType<Note>,
            required: true
        }
    });

    const emit = defineEmits<{
        /** Try again was pressed, which takes the button away, so the control it is under takes focus. */
        (e: "retry"): void;
    }>();

    // #region Event Handlers

    /** Stopped here, so a row the note sits in does not take the press as its own. */
    function onRetry(event: MouseEvent): void {
        event.stopPropagation();
        props.note.retry?.();
        emit("retry");
    }

    // #endregion Event Handlers
</script>
