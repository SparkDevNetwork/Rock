<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <span class="chat-pile" :class="{ 'is-pile': people.length > 1 }" aria-hidden="true">
        <span v-for="(person, index) in people"
              :key="index"
              class="chat-av"
              :class="{ 'is-photo': !!person.photoUrl }"
              data-testid="avatar"
              :style="faceStyle(person, index)">
            <img v-if="person.photoUrl" v-reveal="reveal" class="chat-av-photo" :src="person.photoUrl" alt="" />
            <template v-else-if="initialsOf(person.name, index)">{{ initialsOf(person.name, index) }}</template>
            <Icon v-else name="users" size="xs" />
        </span>
        <StatusBadgeFade :status="drawnStatus" :faceSize="size" :hasTip="hasStatusTip" />
    </span>
</template>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import Icon from "./icon.partial.obs";
    import StatusBadgeFade from "./statusBadgeFade.partial.obs";
    import { FaceStatus } from "../types.partial";
    import { avatarHue } from "./brand.partial";
    import { shownStatus } from "./face.partial";
    import { useImageReveal, vReveal } from "./imageReveal.partial";

    // #region Types

    /**
     * One face: the name the chat shows for the person, and their photo, null only for someone
     * with none. The photo is never left out, so a face is never drawn from a name alone.
     */
    export type AvatarPerson = {
        name: string;
        photoUrl: string | null;
    };

    // #endregion Types

    const props = defineProps({
        /** The people to draw. One is an avatar; more are a pile, each overlapping the one before. */
        people: {
            type: Array as PropType<AvatarPerson[]>,
            required: true
        },

        /** The size of each face in pixels. */
        size: {
            type: Number as PropType<number>,
            default: 32
        },

        /**
         * Draws one initial, a touch larger, at any size: a face in a group's mark is partly
         * covered or crowded by the others, and reads by one clear letter.
         */
        isOneLetter: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** The person's online status, from the status store, or null for none. */
        status: {
            type: Object as PropType<FaceStatus | null>,
            default: null
        },

        /** Whether this is the person's own face, the only one that draws their Appear offline. */
        own: {
            type: Boolean as PropType<boolean>,
            default: false
        },

        /** Whether the badge shows its words on a resting pointer; not on a face inside a button whose own tip and name carry them. */
        hasStatusTip: {
            type: Boolean,
            default: true
        }
    });

    // #region Values

    // Faces drawn in the same frame fade in together once decoded, over a neutral disc.
    const reveal = useImageReveal({ isShared: true });

    /** At this size and below two letters do not fit, so one is drawn. */
    const largestOneInitialSize = 22;

    /** Below this a status badge would cover too much of the face to read either. */
    const smallestStatusSize = 32;

    /**
     * The status drawn: one face of 32px or more, never a pile, and Appear offline only on the
     * person's own face, since everyone else sees nothing of her. Decided here, so a host's slip
     * cannot draw one where none belongs.
     */
    const drawnStatus = computed(() => {
        const status = props.status;
        if (!status || props.people.length !== 1 || props.size < smallestStatusSize) {
            return null;
        }
        return shownStatus(status, props.own);
    });

    // #endregion Values

    // #region Functions

    /**
     * The first letter of the first and last words, or one letter where two would not fit: on a
     * face of 22px or less, and on a face in a pile that another overlaps, whose visible part is
     * 0.82 of its width less the ring, which two initials centred on the whole face reach past.
     */
    function initialsOf(name: string, index: number): string {
        const words = name.trim().split(/\s+/).filter(word => word !== "");
        if (words.length === 0) {
            return "";
        }

        // Array.from keeps a letter outside the basic plane whole.
        const first = Array.from(words[0])[0].toUpperCase();
        const last = words.length > 1 ? Array.from(words[words.length - 1])[0].toUpperCase() : "";

        const isCovered = index < props.people.length - 1;

        return props.isOneLetter || props.size <= largestOneInitialSize || isCovered ? first : first + last;
    }

    /** The face's size and hue, and its overlap with the face before it in a pile. */
    function faceStyle(person: AvatarPerson, index: number): Record<string, string> {
        const size = props.size;
        const style: Record<string, string> = {
            "--chat-av-hue": String(avatarHue(person.name)),
            width: `${size}px`,
            height: `${size}px`,
            fontSize: `${Math.round(size * (props.isOneLetter ? 0.42 : 0.37) * 100) / 100}px`
        };

        if (index > 0) {
            style.marginLeft = `${-Math.round(size * 0.18 * 100) / 100}px`;
        }

        return style;
    }

    // #endregion Functions
</script>
