<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <!-- The surface's own body, set aside while a page is turned to over it. -->
    <div v-if="isFirst"
         ref="pageElement"
         class="chat-surface-page"
         :class="{ 'is-covered': isCovered }"
         :inert="isCovered || undefined"
         :aria-hidden="isCovered ? 'true' : undefined"
         data-testid="surface-page">
        <slot />
    </div>
    <Transition v-else
                name="chat-page"
                enter-from-class="is-beyond"
                leave-to-class="is-beyond"
                leave-active-class="is-leaving">
        <div v-if="isOpen"
             ref="pageElement"
             class="chat-surface-page"
             :class="{ 'is-covered': isCovered }"
             role="group"
             :aria-label="title"
             :inert="isCovered || undefined"
             :aria-hidden="isCovered ? 'true' : undefined"
             data-testid="surface-page">
            <slot />
        </div>
    </Transition>
</template>

<style scoped>
/*
    A page fills what its surface gives the pages, laid out as the surface's body is. It moves by
    the whole sheet's slide distance and fades as it goes, so where less motion is asked for, the
    distance is nothing and a turn is a fade.
*/
.chat-surface-page {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    transition: transform var(--chat-t-panel) var(--chat-ease-in), opacity var(--chat-t-panel) var(--chat-ease-in), visibility 0s;
}

/*
    Under a page turned to over it: a quarter of the way to the left, faded, and hidden once it is
    there. Out of the flow, so the page on top sets the surface's height.
*/
.chat-surface-page.is-covered {
    position: absolute;
    inset: 0 0 auto;
    visibility: hidden;
    opacity: 0;
    transform: translateX(calc(var(--chat-rise-sheet) / -4));
    transition-delay: 0s, 0s, var(--chat-t-panel);
}

/* Where a page comes in from as it is turned to, and goes back to: the surface's right edge. */
.chat-surface-page.is-beyond {
    opacity: 0;
    transform: translateX(var(--chat-rise-sheet));
}

/* Going back, out of the flow, so the page it uncovers sets the height at once. */
.chat-surface-page.is-leaving {
    position: absolute;
    inset: 0 0 auto;
}
</style>

<script setup lang="ts">
    import { computed, onBeforeUnmount, ref, watch } from "vue";
    import { SurfacePageEntry, useSurfacePages } from "./surfacePages.partial";

    // One page of a sheet or a panel dialog. The surface draws its own body as its first page;
    // a page a choice leads to is drawn in the surface's pages slot and opened by its owner, who
    // closes it again on back. The surface's head shows Back and the page's title meanwhile.

    const props = defineProps({
        /** Whether the page is turned to, over the pages under it. */
        isOpen: {
            type: Boolean,
            default: false
        },

        /** What the surface's head calls the page, and what a screen reader names it. */
        title: {
            type: String,
            default: ""
        },

        /** Whether this is the surface's own body, which is always drawn and never registered. */
        isFirst: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        /** Back or Escape while the page is on top: its owner closes it. */
        (e: "back"): void;
    }>();

    const pages = useSurfacePages();
    const pageElement = ref<HTMLElement>();

    const entry: SurfacePageEntry = {
        title: () => props.title,
        element: () => pageElement.value,
        back: () => emit("back")
    };

    /** Whether another page lies over this one. */
    const isCovered = computed((): boolean => pages?.isCovered(props.isFirst ? null : entry) ?? false);

    // A page goes on the stack the moment its owner opens it, while focus is still on the control
    // that turned it, which focus goes back to as it closes.
    if (!props.isFirst) {
        watch(() => props.isOpen, isOpen => {
            if (isOpen) {
                pages?.turnTo(entry);
            }
            else {
                pages?.turnFrom(entry);
            }
        }, { immediate: true, flush: "sync" });

        onBeforeUnmount(() => {
            pages?.turnFrom(entry);
        });
    }
</script>
