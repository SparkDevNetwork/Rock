<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <section class="chat-panel"
             data-testid="panel-host"
             :aria-label="title"
             @keydown="onKeydown">
        <div class="chat-panel-hdr">
            <IconButton v-if="isBackShown"
                        class="chat-panel-back"
                        icon="left"
                        :label="backLabel ?? 'Back'"
                        data-testid="panel-back"
                        @click="leave" />

            <span class="chat-panel-title">
                <b data-testid="panel-title">{{ title }}</b>
                <span v-if="subtitle" data-testid="panel-subtitle">{{ subtitle }}</span>
            </span>

            <slot name="actions" />

            <IconButton v-if="!isPhone"
                        icon="x"
                        :label="closeLabel"
                        data-testid="panel-close"
                        @click="emit('close')" />
        </div>

        <slot name="top" />

        <!--
            Entering while the first page waterfalls in; the chat's sheet plays each marked row's
            rise from it, all but a row marked settled, drawn after the entrance began.
        -->
        <div ref="bodyElement"
             class="chat-panel-body"
             :class="{ 'is-entering': isEntering }"
             data-chat-scroller
             @animationend="onAnimationEnd">
            <slot />
        </div>

        <!-- Under the scroller, so a thread's composer stays put while its replies scroll. -->
        <slot name="foot" />
    </section>
</template>

<style scoped>
/* The panel column's one frame: the thread drawer and every list share it. */
.chat-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
}

/* 64px with its rule, so it lines up with the sidebar's and the conversation's headers. */
.chat-panel-hdr {
    display: flex;
    flex: none;
    gap: 8px;
    align-items: center;
    height: 64px;
    padding: 0 10px 0 18px;
    border-bottom: 1px solid var(--chat-line);
}

/* Reached through the button's own root, which a scoped rule here does not mark. */
.chat-panel-hdr :deep(.chat-panel-back) {
    margin-left: -8px;
}

.chat-panel-title {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
}

.chat-panel-title b {
    overflow: hidden;
    font-size: 16px;
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chat-panel-title span {
    overflow: hidden;
    font-size: 12.5px;
    color: var(--chat-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chat-panel-body {
    flex: 1;
    min-height: 0;
    padding: 4px 0 16px;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: thin;
}

/* Clipped where the browser can, so a scroll into view never moves the body sideways. */
@supports (overflow: clip) {
    .chat-panel-body {
        overflow-x: clip;
    }
}
</style>

<script setup lang="ts">
    import { computed, onMounted, PropType, ref, watch } from "vue";
    import IconButton from "./iconButton.partial.obs";

    const props = defineProps({
        /** The panel's name, in its header and as its label. */
        title: {
            type: String as PropType<string>,
            required: true
        },

        /** The line under the title, such as the conversation a thread belongs to; null for none. */
        subtitle: {
            type: String as PropType<string | null>,
            default: null
        },

        /** Whether the chat is in its one-pane phone layout, where a panel leaves by its back chevron and has no X. */
        isPhone: {
            type: Boolean,
            default: false
        },

        /** A back chevron with this label, which goes back rather than closing; null for none. */
        backLabel: {
            type: String as PropType<string | null>,
            default: null
        },

        /** What the X says to a screen reader and in its tooltip. */
        closeLabel: {
            type: String as PropType<string>,
            default: "Close panel"
        },

        /**
         * The keys of the rows the panel draws, in order, each marked chat-enter with its place as
         * --chat-enter-i; null while its first page is still loading. The first rows drawn enter.
         */
        entranceKeys: {
            type: Array as PropType<readonly string[] | null>,
            default: null
        }
    });

    const emit = defineEmits<{
        (e: "close"): void,
        (e: "back"): void
    }>();

    // #region Values

    const bodyElement = ref<HTMLElement>();

    /** Whether an entrance is under way. */
    const isEntering = ref(false);

    /** Whether the next rows drawn are a first page, which is so from the open and after each load from nothing. */
    let isAwaitingFirstPage = true;

    /**
     * The first page's rows still to finish rising, read once they are drawn; null until then. A
     * row is its drawn element, since the rows are the panel's and the host knows them only so.
     */
    let rising: Set<Element> | null = null;

    // #endregion Values

    // #region Computed Values

    /** A phone always leaves by the chevron; a wide block shows one only when there is somewhere to go back to. */
    const isBackShown = computed((): boolean => props.isPhone || props.backLabel !== null);

    // #endregion Computed Values

    // #region Event Handlers

    /** A first-page row has risen. */
    function onAnimationEnd(event: AnimationEvent): void {
        if (rising && event.animationName === "chat-enter" && event.target instanceof Element) {
            rising.delete(event.target);
            endWhenRisen();
        }
    }

    function onKeydown(event: KeyboardEvent): void {
        if (event.key === "Escape" && !event.defaultPrevented) {
            event.preventDefault();
            leave();
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Reads the drawn rows while an entrance is under way. The first page's rows are the ones
     * rising; a row drawn after them, a live arrival, a later page or a filter cleared, is marked
     * settled so it does not rise, and the rows already rising keep rising. A first-page row gone,
     * as a filter or a removal takes it, no longer holds the entrance.
     */
    function readRows(): void {
        if (!isEntering.value || !bodyElement.value) {
            return;
        }

        const rows = Array.from(bodyElement.value.querySelectorAll(".chat-enter"));
        if (!rising) {
            rows.forEach(row => row.removeAttribute("data-chat-settled"));
            rising = new Set(rows);
        }
        else {
            const first = rising;
            rows.filter(row => !first.has(row)).forEach(row => row.setAttribute("data-chat-settled", ""));
            rising = new Set(Array.from(first).filter(row => row.isConnected));
        }
        endWhenRisen();
    }

    /** The mark goes once every first-page row has risen or gone, so no row's own later motion is held under it. */
    function endWhenRisen(): void {
        if (rising && rising.size === 0) {
            rising = null;
            isEntering.value = false;
        }
    }

    /** Back to where the panel was opened from when it has a back label, else closed. */
    function leave(): void {
        if (props.backLabel !== null) {
            emit("back");
        }
        else {
            emit("close");
        }
    }

    // #endregion Functions

    // #region Watchers

    // Only a first page enters. Read before the render, so the first page's rows are drawn under
    // the mark.
    watch(() => props.entranceKeys, keys => {
        if (keys === null) {
            isAwaitingFirstPage = true;
            isEntering.value = false;
            rising = null;
            return;
        }

        if (isAwaitingFirstPage) {
            isAwaitingFirstPage = false;
            isEntering.value = keys.length > 0;
            rising = null;
        }
    }, { immediate: true });

    // The rows are read after each render, before it is painted.
    onMounted(readRows);
    watch(() => props.entranceKeys, readRows, { flush: "post" });

    // #endregion Watchers
</script>
