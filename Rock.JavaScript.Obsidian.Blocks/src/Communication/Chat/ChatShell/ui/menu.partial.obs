<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <button v-if="buttonText"
            ref="textAnchor"
            v-bind="anchorAttrs"
            type="button"
            class="chat-menu-text-btn"
            aria-haspopup="menu"
            :aria-expanded="isOpen ? 'true' : 'false'"
            @click="onAnchorClick">
        <!-- A button in words where the menu names its choice, as the intro's notify mode; else an icon. -->
        <Icon :name="icon" size="xs" />{{ buttonText }}
    </button>
    <IconButton v-else
                ref="anchor"
                v-bind="anchorAttrs"
                :icon="icon"
                :label="label"
                aria-haspopup="menu"
                :aria-expanded="isOpen ? 'true' : 'false'"
                :isTooltipDisabled="isOpen"
                @click="onAnchorClick" />

    <Teleport :to="overlayHost ?? 'body'" :disabled="!overlayHost">
        <Transition name="chat-pop">
            <div v-if="isOpen"
                 ref="menuElement"
                 class="chat-menu"
                 role="menu"
                 :aria-label="label"
                 :style="menuStyles"
                 @keydown="onKeydown">
                <!--
                    Moved out to the chat's root when it has one, since a feed's faded edges would fade or cut
                    a menu drawn inside it; left in place where there is no root, as when a part is drawn alone.
                -->
                <div v-if="heading" class="chat-menu-head" role="presentation">{{ heading }}</div>
                <template v-for="item in items" :key="item.key">
                    <div v-if="item.isSeparatorBefore" class="chat-menu-sep" role="separator"></div>
                    <!-- One of a set of choices, the chosen one checked, is a radio item; any other an action. -->
                    <button type="button"
                            class="chat-menu-item"
                            :class="{ 'is-danger': item.isDanger }"
                            :role="item.isChecked === undefined ? 'menuitem' : 'menuitemradio'"
                            :aria-checked="item.isChecked === undefined ? undefined : item.isChecked ? 'true' : 'false'"
                            :data-key="item.key"
                            tabindex="-1"
                            :aria-disabled="item.isDisabled || undefined"
                            @click="choose(item)">
                        <Icon v-if="item.icon" :name="item.icon" />
                        <span v-if="item.description" class="chat-menu-label is-stacked">
                            <span class="chat-menu-title">{{ item.label }}</span>
                            <span class="chat-menu-desc">{{ item.description }}</span>
                        </span>
                        <span v-else class="chat-menu-label">{{ item.label }}</span>
                        <kbd v-if="item.hint" class="chat-menu-hint">{{ item.hint }}</kbd>
                        <span v-if="item.hasDot" class="chat-menu-dot"><span class="chat-sr-only">new</span></span>
                        <span v-if="item.isChecked" class="chat-menu-check" data-testid="menu-check"><Icon name="check" size="sm" /></span>
                    </button>
                </template>
                <!-- Why an action is missing, read in its place after the others. -->
                <template v-if="note">
                    <div class="chat-menu-sep" role="separator"></div>
                    <div class="chat-menu-note" data-testid="menu-note"><Icon name="lock" size="xs" />{{ note }}</div>
                </template>
            </div>
        </Transition>
    </Teleport>
</template>

<style scoped>
/* Fixed, so the chat's clipped frame cannot cut a menu near its edge. */
.chat-menu {
    z-index: 1050;
    display: flex;
    flex-direction: column;
    min-width: 200px;
    max-width: min(360px, calc(100vw - 16px));
    padding: 6px;
    background: var(--chat-raised);
    border-radius: var(--chat-r-pop);
    box-shadow: var(--chat-shadow-pop);
}

.chat-menu-item {
    display: flex;
    gap: 10px;
    align-items: center;
    width: 100%;
    padding: 8px 10px;
    font-size: 13.5px;
    color: var(--chat-text);
    text-align: left;
    background: transparent;
    border: 0;
    border-radius: var(--chat-r-item);
}

.chat-menu-item :deep(.chat-ic) {
    color: var(--chat-icon);
}

.chat-menu-label {
    flex: 1;
    min-width: 0;
    line-height: 1.3;
}

/* A choice with what it means under it, as the notify menu's modes. */
.chat-menu-label.is-stacked {
    display: flex;
    flex-direction: column;
}

.chat-menu-desc {
    font-size: 12px;
    color: var(--chat-muted);
}

.chat-menu-check {
    display: inline-flex;
    flex: none;
    color: var(--chat-brand-ink);
}

.chat-menu-item .chat-menu-check :deep(.chat-ic) {
    color: inherit;
}

/* Rock's theme styles every heading, so the menu's own states its whole face. */
.chat-menu-head {
    padding: 6px 10px 4px;
    font-size: 11px;
    font-weight: 700;
    color: var(--chat-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
}

/* The small outlined button in words, as the intro draws its actions. */
.chat-menu-text-btn {
    display: inline-flex;
    flex: none;
    gap: 5px;
    align-items: center;
    height: 28px;
    padding: 0 11px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--chat-text);
    background: var(--chat-surface);
    border: 1px solid var(--chat-line-strong);
    border-radius: var(--chat-r-full);
    transition: border-color var(--chat-t-fast) var(--chat-ease-state);
}

.chat-menu-text-btn:hover {
    border-color: var(--chat-icon);
}

.chat-menu-text-btn :deep(.chat-ic) {
    width: 14px;
    height: 14px;
    color: var(--chat-icon);
}

.chat-menu-hint {
    padding: 0;
    font: inherit;
    font-size: 11.5px;
    color: var(--chat-muted);
    background: none;
    box-shadow: none;
}

.chat-menu-dot {
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--chat-danger);
    border-radius: 50%;
}

.chat-menu-sep {
    flex: none;
    height: 1px;
    margin: 5px 6px;
    background: var(--chat-line);
}

.chat-menu-note {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 8px 10px;
    font-size: 12.5px;
    color: var(--chat-muted);
}

.chat-menu-note .chat-ic {
    flex: none;
    color: var(--chat-icon);
}

/*
    No outline of its own: a focused item takes the chat's focus ring, as every control does. Only
    the pointer tints, never focus, so a menu opened by a click shows no item picked out before the
    pointer moves and the keyboard's item is marked by the ring alone.
*/
.chat-menu-item:hover {
    background: var(--chat-hover);
}

.chat-menu-item.is-danger,
.chat-menu-item.is-danger :deep(.chat-ic) {
    color: var(--chat-danger-ink);
}

/* Faded as a block post's button that cannot run is, and with no press to give. */
.chat-menu-item[aria-disabled="true"] {
    cursor: default;
    opacity: .5;
}

/*
    Enters from just toward its button and a touch small, and leaves the same way, half as far and
    faster; toward the button is up when the menu opens below it and down when it flips above.
*/
.chat-pop-enter-active {
    transition: opacity var(--chat-t-base) var(--chat-ease-in), transform var(--chat-t-base) var(--chat-ease-in);
}

.chat-pop-leave-active {
    transition: opacity var(--chat-t-fast) var(--chat-ease-out), transform var(--chat-t-fast) var(--chat-ease-out);
}

.chat-pop-enter-from {
    opacity: 0;
    transform: translateY(calc(var(--chat-pop-toward, -1) * var(--chat-rise) * .6)) scale(var(--chat-pop-scale));
}

.chat-pop-leave-to {
    opacity: 0;
    transform: translateY(calc(var(--chat-pop-toward, -1) * var(--chat-rise) * .3)) scale(var(--chat-pop-scale));
}
</style>

<script setup lang="ts">
    import { computed, nextTick, onBeforeUnmount, onMounted, PropType, ref, watch } from "vue";
    import { autoUpdate, flip, offset, shift, useFloating } from "@Obsidian/Libs/floating-ui";
    import Icon from "./icon.partial.obs";
    import IconButton from "./iconButton.partial.obs";
    import { overlayHostOf } from "./tooltip.partial";

    // #region Types

    /** One action in the menu. */
    export type MenuItem = {
        key: string;
        label: string;
        icon?: string;
        isDanger?: boolean;

        /** A key that does the same from elsewhere, drawn at the item's end, such as Up for Edit. */
        hint?: string;

        /** Draws a separator above the item, so a group is never left empty by a missing item. */
        isSeparatorBefore?: boolean;

        /** Draws a dot at the item's end, as the menu button that holds it does, for something new. */
        hasDot?: boolean;

        /** A line under the label saying what the item means. */
        description?: string;

        /** Makes the item one of a set of choices, checked when it is the one chosen. */
        isChecked?: boolean;

        /**
         * Drawn but never chosen. Marked rather than disabled, so the arrows still reach it and a
         * screen reader still reads it out.
         */
        isDisabled?: boolean;
    };

    // #endregion Types

    defineProps({
        /** The icon on the button that opens the menu. */
        icon: {
            type: String as PropType<string>,
            required: true
        },

        /** What the button and the menu are called, for a screen reader and the button's tooltip. */
        label: {
            type: String as PropType<string>,
            required: true
        },

        /** The actions, in order. */
        items: {
            type: Array as PropType<MenuItem[]>,
            required: true
        },

        /** A line drawn after the items, with a lock, saying why an action is not offered. */
        note: {
            type: String,
            default: ""
        },

        /** Attributes for the button, such as a toolbar's class and its roving tab stop. */
        anchorAttrs: {
            type: Object as PropType<Record<string, unknown>>,
            default: () => ({})
        },

        /** A heading over the items, such as "Notify me about". */
        heading: {
            type: String,
            default: ""
        },

        /** Draws the button in words with the icon before them, rather than as an icon alone. */
        buttonText: {
            type: String,
            default: ""
        }
    });

    const emit = defineEmits<{
        (e: "select", key: string): void;
        (e: "openChange", isOpen: boolean): void;
    }>();

    // #region Values

    const anchor = ref<InstanceType<typeof IconButton>>();
    const textAnchor = ref<HTMLButtonElement>();
    const anchorElement = ref<HTMLElement>();
    const menuElement = ref<HTMLElement>();
    const isOpen = ref(false);

    /** The chat's root, which the open menu is drawn in; null where the menu is drawn alone. */
    const overlayHost = ref<HTMLElement | null>(null);

    // Below its button by default, above when it would leave the window, kept 8px inside it.
    // Placed by left and top, since a transform here would override the pop motion's own and the
    // menu would only fade in and out.
    const { floatingStyles, placement, x } = useFloating(anchorElement, menuElement, {
        placement: "bottom-end",
        strategy: "fixed",
        transform: false,
        middleware: [offset(8), flip(), shift({ padding: 8 })],
        whileElementsMounted: autoUpdate
    });

    // #endregion Values

    // #region Computed Values

    /**
     * The placement, with the pop motion grown from the button: from the button's middle along the
     * menu's edge nearest it, and moving toward it, so a menu flipped above its button grows up
     * from below rather than down from a corner it does not touch.
     */
    const menuStyles = computed((): Record<string, string> => {
        const isAbove = placement.value.startsWith("top");
        const button = anchorElement.value?.getBoundingClientRect();
        const width = menuElement.value?.offsetWidth ?? 0;
        const middle = button ? button.left + button.width / 2 - (x.value ?? 0) : width / 2;
        return {
            ...floatingStyles.value,
            transformOrigin: `${Math.max(0, Math.min(width, middle))}px ${isAbove ? "100%" : "0"}`,
            "--chat-pop-toward": isAbove ? "1" : "-1"
        };
    });

    // #endregion Computed Values

    // #region Event Handlers

    async function onAnchorClick(): Promise<void> {
        if (isOpen.value) {
            close(false);
            return;
        }

        anchorElement.value = anchor.value?.buttonElement ?? textAnchor.value ?? undefined;
        isOpen.value = true;
        await nextTick();
        menuItems()[0]?.focus();
    }

    /** Up and Down cycle through the items; Escape closes and returns to the button; Tab leaves. */
    function onKeydown(event: KeyboardEvent): void {
        const items = menuItems();
        const current = items.indexOf(document.activeElement as HTMLElement);

        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
            event.preventDefault();
            const step = event.key === "ArrowDown" ? 1 : -1;
            items[(current + step + items.length) % items.length]?.focus();
        }
        else if (event.key === "Home" || event.key === "End") {
            event.preventDefault();
            items[event.key === "Home" ? 0 : items.length - 1]?.focus();
        }
        else if (event.key === "Escape") {
            event.preventDefault();
            close(true);
        }
        else if (event.key === "Tab") {
            close(false);
        }
        else if ((event.key === "Enter" || event.key === " ") && current >= 0) {
            // Handled here so the choice does not depend on the browser turning a key into a click.
            event.preventDefault();
            items[current].click();
        }
    }

    /** A press anywhere outside the menu and its button closes it, leaving focus where the press put it. */
    function onDocumentPointerDown(event: Event): void {
        const target = event.target as Node;
        if (menuElement.value?.contains(target) || anchorElement.value?.contains(target)) {
            return;
        }

        close(false);
    }

    // #endregion Event Handlers

    // #region Functions

    function menuItems(): HTMLElement[] {
        return Array.from(menuElement.value?.querySelectorAll<HTMLElement>("[role='menuitem'], [role='menuitemradio']") ?? []);
    }

    function choose(item: MenuItem): void {
        if (item.isDisabled) {
            return;
        }

        emit("select", item.key);
        close(true);
    }

    function close(isFocusReturned: boolean): void {
        isOpen.value = false;
        if (isFocusReturned) {
            (anchor.value ?? textAnchor.value)?.focus();
        }
    }

    // #endregion Functions

    // #region Watchers

    // The outside press is listened for only while open, so a closed menu costs the page nothing.
    watch(isOpen, open => {
        emit("openChange", open);
        if (open) {
            document.addEventListener("pointerdown", onDocumentPointerDown, true);
        }
        else {
            document.removeEventListener("pointerdown", onDocumentPointerDown, true);
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onMounted(() => {
        overlayHost.value = overlayHostOf(anchor.value?.buttonElement ?? textAnchor.value);
    });

    onBeforeUnmount(() => {
        document.removeEventListener("pointerdown", onDocumentPointerDown, true);
    });

    // #endregion Lifecycle Hooks
</script>
