<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <span v-if="$slots.trigger" ref="triggerHost" class="chat-menu-trigger">
        <!-- A trigger of the screen's own, such as a face or a button with words, in the icon button's place. -->
        <slot name="trigger" :attrs="triggerAttrs" :isOpen="isOpen"></slot>
    </span>
    <IconButton v-else
                ref="anchor"
                v-bind="anchorAttrs"
                :icon="icon"
                :label="label"
                aria-haspopup="menu"
                :aria-expanded="isOpen ? 'true' : 'false'"
                :isTooltipDisabled="isOpen"
                @click="onAnchorClick">
        <slot name="anchor"></slot>
    </IconButton>

    <Popover :popover="pop"
             :label="label"
             role="menu"
             :aria-describedby="note ? noteId : undefined"
             @keydown="onKeydown">
        <div :class="pop.isSheet.value ? 'chat-menu-rows' : 'chat-menu'">
            <div v-if="heading" class="chat-menu-head" role="presentation">{{ heading }}</div>
            <template v-for="item in items" :key="item.key">
                <div v-if="item.isSeparatorBefore" class="chat-menu-sep" role="separator"></div>
                <div v-if="item.heading" class="chat-menu-head" role="presentation">{{ item.heading }}</div>
                <!-- One of a set of choices, the chosen one checked, is a radio item; any other an action. -->
                <button type="button"
                        :class="[pop.isSheet.value ? 'chat-sheet-item' : 'chat-menu-item', { 'is-danger': item.isDanger }]"
                        :role="item.isChecked === undefined ? 'menuitem' : 'menuitemradio'"
                        :aria-checked="item.isChecked === undefined ? undefined : item.isChecked ? 'true' : 'false'"
                        :data-key="item.key"
                        :aria-label="item.ariaLabel"
                        tabindex="-1"
                        :aria-disabled="item.isDisabled || undefined"
                        @click="choose(item)">
                    <Icon v-if="item.icon" class="chat-menu-ic" :name="item.icon" />
                    <span v-if="item.description" class="chat-menu-label is-stacked">
                        <span class="chat-menu-title">{{ item.label }}</span>
                        <span class="chat-menu-desc">{{ item.description }}</span>
                    </span>
                    <span v-else class="chat-menu-label">{{ item.label }}</span>
                    <kbd v-if="item.hint" class="chat-menu-hint">{{ item.hint }}</kbd>
                    <span v-if="item.hasDot" class="chat-menu-dot"><Dot /><span class="chat-sr-only">new</span></span>
                    <span v-if="item.isChecked" class="chat-menu-check" data-testid="menu-check"><Icon class="chat-menu-check-ic" name="check" size="sm" /></span>
                </button>
            </template>
            <!-- Why an action is missing or cannot be taken, read in its place after the others and said as the menu opens. -->
            <template v-if="note">
                <div class="chat-menu-sep" role="separator"></div>
                <div :id="noteId" class="chat-menu-note" data-testid="menu-note"><Icon class="chat-menu-note-ic" :name="noteIcon" size="xs" />{{ note }}</div>
            </template>
        </div>
    </Popover>
</template>

<style scoped>
/* A trigger of the screen's own lays out as if drawn where the menu is. */
.chat-menu-trigger {
    display: contents;
}

/* The list on its surface: the popover's surface draws the box, the list its own width and spacing. */
.chat-menu {
    display: flex;
    flex-direction: column;
    min-width: 200px;
    max-width: min(360px, calc(100vw - 16px));
    padding: 6px;
}

/* On a phone's sheet the rows run the sheet's width, which sets their spacing. */
.chat-menu-rows {
    display: flex;
    flex-direction: column;
}

.chat-menu-item {
    display: flex;
    gap: 10px;
    align-items: center;
    width: 100%;
    padding: 8px 10px;
    font-size: var(--chat-fs-ui);
    color: var(--chat-text);
    text-align: left;
    background: transparent;
    border: 0;
    border-radius: var(--chat-r-inset);
}

.chat-menu-item .chat-menu-ic {
    color: var(--chat-icon);
}

.chat-menu-label {
    flex: 1;
    min-width: 0;
    line-height: 1.3;
}

/* A choice with what it means under it, as the notify menu's modes. */
.chat-menu-label.is-stacked {
    display: flex;
    flex-direction: column;
}

.chat-menu-desc {
    font-size: var(--chat-fs-small);
    color: var(--chat-muted);
}

.chat-menu-check {
    display: inline-flex;
    flex: none;
    color: var(--chat-brand-ink);
}

.chat-menu-item .chat-menu-check-ic {
    color: inherit;
}

/* Rock's theme styles every heading, so the menu's own states its whole face. */
.chat-menu-head {
    padding: 6px 10px 4px;
    font-size: var(--chat-fs-badge);
    font-weight: 700;
    color: var(--chat-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
}

.chat-menu-hint {
    padding: 0;
    font: inherit;
    font-size: var(--chat-fs-small);
    color: var(--chat-muted);
    background: none;
    box-shadow: none;
}

/* The dot's place at the item's end, holding the word a screen reader hears for it. */
.chat-menu-dot {
    display: inline-flex;
    flex: none;
}

.chat-menu-sep {
    flex: none;
    height: 1px;
    margin: 5px 6px;
    background: var(--chat-line);
}

.chat-menu-note {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 8px 10px;
    font-size: var(--chat-fs-ui);
    color: var(--chat-muted);
}

.chat-menu-note-ic {
    flex: none;
    color: var(--chat-icon);
}

/*
    No outline of its own: a focused item takes the chat's focus ring, as every control does. Only
    the pointer tints, never focus, so a menu opened by a click shows no item picked out before the
    pointer moves and the keyboard's item is marked by the ring alone.
*/
.chat-menu-item:hover {
    background: var(--chat-hover);
}

.chat-menu-item.is-danger,
.chat-menu-item.is-danger .chat-menu-ic {
    color: var(--chat-danger-ink);
}

</style>

<script setup lang="ts">
    import { computed, onBeforeUnmount, onMounted, PropType, ref, watch } from "vue";
    import { newGuid } from "@Obsidian/Utility/guid";
    import Dot from "./dot.partial.obs";
    import Icon from "./icon.partial.obs";
    import IconButton from "./iconButton.partial.obs";
    import Popover from "./popoverSurface.partial.obs";
    import { usePopover } from "./popover.partial";
    import { useChatSession } from "../chatSession.partial";

    // #region Types

    /** One action in the menu. */
    export type MenuItem = {
        key: string;
        label: string;
        icon?: string;
        isDanger?: boolean;

        /** A key that does the same from elsewhere, drawn at the item's end, such as Up for Edit. */
        hint?: string;

        /** Draws a separator above the item, so a group is never left empty by a missing item. */
        isSeparatorBefore?: boolean;

        /** Draws a dot at the item's end, as the menu button that holds it does, for something new. */
        hasDot?: boolean;

        /** A line under the label saying what the item means. */
        description?: string;

        /** Makes the item one of a set of choices, checked when it is the one chosen. */
        isChecked?: boolean;

        /**
         * A heading drawn over the item, after its separator, naming the items from it on. It is
         * passed over by a screen reader, so those items carry its sense in their own names.
         */
        heading?: string;

        /** The item's name for a screen reader where its words alone would not say it, as "Busy for 1 hour" under a Busy heading. */
        ariaLabel?: string;

        /**
         * Drawn but never chosen. Marked rather than disabled, so the arrows still reach it and a
         * screen reader still reads it out.
         */
        isDisabled?: boolean;
    };

    // #endregion Types

    const props = defineProps({
        /**
         * The icon on the button that opens the menu; the anchor slot adds words beside it, as a
         * failed send's Not sent marker does; a screen whose button is its own draws it in the
         * trigger slot instead.
         */
        icon: {
            type: String as PropType<string>,
            default: ""
        },

        /** What the button and the menu are called, for a screen reader and the button's tooltip. */
        label: {
            type: String as PropType<string>,
            required: true
        },

        /** The actions, in order. */
        items: {
            type: Array as PropType<MenuItem[]>,
            required: true
        },

        /** A line drawn after the items, with a lock, saying why an action is not offered or cannot be taken now. */
        note: {
            type: String,
            default: ""
        },

        /** The note's icon: the lock for an action that cannot be taken, or another for a note that says how one is going. */
        noteIcon: {
            type: String,
            default: "lock"
        },

        /** Attributes for the button, such as a toolbar's class and its roving tab stop. */
        anchorAttrs: {
            type: Object as PropType<Record<string, unknown>>,
            default: () => ({})
        },

        /** A heading over the items, such as "Notify me about". */
        heading: {
            type: String,
            default: ""
        },

        /** Where the menu opens from its button: below it at its end by default, or above it at its start, as at the foot of the chat. */
        placement: {
            type: String as PropType<"bottom-end" | "top-start">,
            default: "bottom-end"
        },

        /**
         * Whether it opens as a bottom sheet over a scrim, rather than beside its button; as the
         * session says by default, a sheet on a phone.
         */
        isSheet: {
            type: Boolean,
            default: undefined
        },

    });

    const emit = defineEmits<{
        (e: "select", key: string): void;
        (e: "openChange", isOpen: boolean): void;
    }>();

    // #region Values

    const session = useChatSession();
    const anchor = ref<InstanceType<typeof IconButton>>();

    /** What holds a trigger of the screen's own, whose first element is the button. */
    const triggerHost = ref<HTMLElement>();

    const anchorElement = computed((): HTMLElement | undefined => anchor.value?.buttonElement
        ?? (triggerHost.value?.firstElementChild as HTMLElement | null)
        ?? undefined);

    // Beside its button, or a sheet on a phone. Escape, a press outside, Tab and the sheet's scrim
    // close it, as every popover closes; a choice closes it here, with focus back on the button.
    const pop = usePopover(anchorElement, ref<HTMLElement>(), {
        placement: props.placement,
        isSheet: () => props.isSheet ?? session.isPhone.value
    });

    const isOpen = pop.isOpen;

    /** The note's own element, which the open menu is described by. */
    const noteId = `chat-menu-note-${newGuid()}`;

    /** What a trigger of the screen's own binds: that it opens a menu, whether it is open, and the press that opens it. */
    const triggerAttrs = computed((): Record<string, unknown> => ({
        "aria-haspopup": "menu",
        "aria-expanded": isOpen.value ? "true" : "false",
        onClick: onAnchorClick
    }));

    // #endregion Values

    // #region Event Handlers

    async function onAnchorClick(): Promise<void> {
        if (isOpen.value) {
            pop.close();
            return;
        }

        await open("first");
    }

    /** Down on the closed button opens the menu on its first item, or the one checked, Up on its last, as a menu button does. */
    function onAnchorKeydown(event: KeyboardEvent): void {
        if (!isOpen.value && (event.key === "ArrowDown" || event.key === "ArrowUp")) {
            event.preventDefault();
            void open(event.key === "ArrowDown" ? "first" : "last");
        }
    }

    /** Up and Down cycle through the items, Home and End go to the ends, a letter to its item. */
    function onKeydown(event: KeyboardEvent): void {
        const items = menuItems();
        const current = items.indexOf(document.activeElement as HTMLElement);

        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
            event.preventDefault();
            const step = event.key === "ArrowDown" ? 1 : -1;
            items[(current + step + items.length) % items.length]?.focus();
        }
        else if (event.key === "Home" || event.key === "End") {
            event.preventDefault();
            items[event.key === "Home" ? 0 : items.length - 1]?.focus();
        }
        else if ((event.key === "Enter" || event.key === " ") && current >= 0) {
            // Handled here so the choice does not depend on the browser turning a key into a click.
            event.preventDefault();
            items[current].click();
        }
        else if (event.key.length === 1 && /\p{L}/u.test(event.key)) {
            // A letter goes to the next item that starts with it, round from the end.
            const letter = event.key.toLocaleLowerCase();
            const next = [...items.slice(current + 1), ...items.slice(0, current + 1)]
                .find(item => item.textContent?.trim().toLocaleLowerCase().startsWith(letter));
            next?.focus();
        }
    }

    // #endregion Event Handlers

    // #region Functions

    async function open(at: "first" | "last"): Promise<void> {
        if (!await pop.open()) {
            return;
        }

        // A set of choices opens on the one checked, so Enter keeps what is so rather than
        // choosing the first unasked.
        const items = menuItems();
        const checked = at === "first" ? items.find(item => item.getAttribute("aria-checked") === "true") : undefined;
        (checked ?? items[at === "first" ? 0 : items.length - 1])?.focus();
    }

    function menuItems(): HTMLElement[] {
        return Array.from(pop.floating.value?.querySelectorAll<HTMLElement>("[role='menuitem'], [role='menuitemradio']") ?? []);
    }

    function choose(item: MenuItem): void {
        if (item.isDisabled) {
            return;
        }

        emit("select", item.key);
        pop.close({ isFocusReturned: true });
    }

    // #endregion Functions

    // #region Watchers

    watch(isOpen, open => emit("openChange", open));

    // #endregion Watchers

    // #region Lifecycle Hooks

    // The opening keys are listened for on the button directly, outside Vue's own event handling:
    // Vue drops an event at a listener attached in the same millisecond its first listener saw it,
    // so a toolbar holding the button, as a message's tools do, could miss its own arrows.
    onMounted(() => {
        anchorElement.value?.addEventListener("keydown", onAnchorKeydown);
    });

    onBeforeUnmount(() => {
        anchorElement.value?.removeEventListener("keydown", onAnchorKeydown);
    });

    // #endregion Lifecycle Hooks

    /** The button that opens the menu, for what it opens next to be placed by and hand focus back to. */
    const buttonElement = computed((): HTMLElement | null => anchorElement.value ?? null);

    defineExpose({ buttonElement });
</script>
