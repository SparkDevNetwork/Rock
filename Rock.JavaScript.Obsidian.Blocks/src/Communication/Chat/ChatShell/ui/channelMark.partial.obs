<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <span class="chat-channel-mark" :class="{ 'has-image': isImageShown, 'is-letter': isLetterShown }" :style="isLetterShown ? { '--chat-av-hue': String(avatarHue(tileName!)) } : undefined" aria-hidden="true">
        <!--
            Decorative: the channel's name is always drawn beside its mark. A tile's letter is its
            base layer, so the photo fades in over it through the image reveal rather than into an
            empty box; a mark with no tile name has the photo alone, or its glyph.
        -->
        <span v-if="isLetterShown" class="chat-channel-mark-letter" data-testid="channel-mark-letter">{{ letter }}</span>
        <img v-if="isImageShown"
             v-reveal="reveal"
             class="chat-channel-mark-image"
             :class="{ 'is-over': isLetterShown }"
             data-testid="channel-mark-image"
             :src="imageUrl!"
             alt=""
             @error="failedUrl = imageUrl" />
        <Icon v-else-if="!isLetterShown" :name="isPublic ? 'hash' : 'lock'" :size="iconSize" />
    </span>
</template>

<style scoped>
/* The box is the caller's; the image fills it and takes its corners, so it never moves anything. */
.chat-channel-mark-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
}

/* Over a tile's letter: the photo covers it exactly once revealed, and the letter shows until then. */
.chat-channel-mark.is-letter {
    position: relative;
    overflow: hidden;
}

.chat-channel-mark-image.is-over {
    position: absolute;
    inset: 0;
}
</style>

<script setup lang="ts">
    import { computed, PropType, ref } from "vue";
    import { avatarHue } from "./brand.partial";
    import Icon from "./icon.partial.obs";
    import { useImageReveal, vReveal } from "./imageReveal.partial";

    const props = defineProps({
        /** Whether the channel is open to anyone who may join, which draws a hash rather than a lock. */
        isPublic: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        /** The channel's own image, Rock's group image; null for a channel with none. */
        imageUrl: {
            type: String as PropType<string | null>,
            default: null
        },

        /** The glyph's drawn size when there is no image. */
        iconSize: {
            type: String as PropType<"md" | "sm" | "xs">,
            default: "md"
        },

        /**
         * The channel's name, which turns the mark into a letter tile: with no image, its first
         * letter on the color of its name's hue rather than the hash or lock. Off by default, so
         * the header, the intro and the details keep the glyph.
         */
        tileName: {
            type: String as PropType<string | null>,
            default: null
        }
    });

    // #region Values

    // Marks drawn in the same frame fade their photos in together once decoded.
    const reveal = useImageReveal({ isShared: true });

    /**
     * The image that failed to load, so a broken one gives way to the letter, hash or lock; kept by its
     * address so a new image is tried again rather than staying on the glyph.
     */
    const failedUrl = ref<string | null>(null);

    // #endregion Values

    // #region Computed Values

    const isImageShown = computed((): boolean => !!props.imageUrl && props.imageUrl !== failedUrl.value);

    /** A tile always draws its letter, under any image; a mark without a tile name draws the glyph. */
    const isLetterShown = computed((): boolean => !!props.tileName && letter.value !== "");

    /** The name's first letter, upper case, kept whole outside the basic plane. */
    const letter = computed((): string => (Array.from((props.tileName ?? "").trim())[0] ?? "").toUpperCase());

    // #endregion Computed Values
</script>
