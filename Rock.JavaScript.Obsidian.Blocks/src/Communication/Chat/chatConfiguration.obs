<template>
    <NotificationBox v-if="config.errorMessage" :alertType="AlertType.Warning">
        {{ config.errorMessage }}
    </NotificationBox>

    <Panel v-else type="block" title="Chat Configuration">

        <div v-if="!config.isChatConfigured" class="chat-configuration-empty-state">
            <p>{{ emptyState.message }}</p>
            <a v-if="emptyState.isConnectedServicesLinkShown" :href="connectedServicesUrl">Go to Spark Connected Services</a>
        </div>

        <template v-else>
            <NotificationBox v-if="message" :alertType="messageAlertType">
                {{ message }}
            </NotificationBox>

            <RockForm class="chat-configuration-settings" @submit="onSave">
                <div class="row">
                    <div class="col-md-6">
                        <CheckBox v-model="form.areChatProfilesVisible"
                                  label="Chat Profiles Are Visible"
                                  help="Whether a person's public profile details show on their chat profile card by default: their email, mobile phone (unless marked unlisted), badges and the profile card template below. Anyone signed in to chat can read them, up to a limit of people a minute. A person who has set this for themselves keeps their own answer."
                                  :disabled="isSaving" />

                        <CheckBox v-model="form.isOpenDirectMessagingAllowed"
                                  label="Open Direct Messaging Is Allowed"
                                  help="Whether a person may be direct messaged by anyone. A person who has set this for themselves keeps their own answer. With this off, a person can still be messaged inside a private channel you both belong to."
                                  :disabled="isSaving" />

                        <CheckBox v-model="form.areGifsEnabled"
                                  label="GIFs Are Enabled"
                                  help="Whether people may search for GIFs from KLIPY, filtered to a general audience, and send them in chat. A change reaches each person within about five minutes, without a sync. GIFs already sent stay in the conversation when this is turned off."
                                  :disabled="isSaving" />

                        <div class="chat-configuration-minimum-age">
                            <NumberBox v-model="form.minimumAge"
                                       label="Minimum Age"
                                       help="The youngest age that may use chat at all. Leave blank for no limit. Someone whose birthdate Rock does not know is asked for it once, and is kept out of chat until they give it."
                                       :minimumValue="0"
                                       :disabled="isSaving" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <DataViewPicker v-model="form.directMessageAccessDataView"
                                        label="Direct Message Access Data View"
                                        help="The people who may start a direct message. Leave blank and anyone may. This does not change who may reply."
                                        :entityTypeGuid="EntityType.Person"
                                        :displayPersistedOnly="true"
                                        :multiple="false"
                                        :enhanceForLongLists="true"
                                        :disabled="isSaving" />

                        <DataViewPicker v-model="form.chatBadgeDataViews"
                                        label="Badge Persisted Data Views"
                                        help="Members of these Data Views carry a badge beside their name in chat."
                                        :entityTypeGuid="EntityType.Person"
                                        :displayPersistedOnly="true"
                                        :multiple="true"
                                        :enhanceForLongLists="true"
                                        :disabled="isSaving" />
                    </div>
                </div>

                <CodeEditor v-model="form.profileCardLavaTemplate"
                            label="Profile Card Lava Template"
                            help="Shown on a person's chat profile card below their contact details, only when they show public profile details, to anyone signed in to chat. Merge fields: Person, the person on the card; CurrentPerson, who is looking. The card hides nothing the template prints, an unlisted phone included, so print only what everyone in chat may see, and pass a person's own fields through | Escape. Shown at most 160px tall, scrolling past that."
                            mode="lava"
                            :editorHeight="200"
                            :disabled="isSaving" />

                <LavaCommandPicker v-model="form.profileCardEnabledLavaCommands"
                                   label="Enabled Lava Commands"
                                   help="The Lava commands the profile card template may run. The template runs each time a card opens, so keep it light."
                                   :enhanceForLongLists="false"
                                   multiple
                                   :disabled="isSaving" />

                <div class="actions">
                    <RockButton :btnType="BtnType.Primary" type="submit" :disabled="isSaving">Save</RockButton>
                    <RockButton :btnType="BtnType.Link" :disabled="isSaving" @click="onCancel">Cancel</RockButton>
                </div>
            </RockForm>

            <div class="chat-configuration-platform well">
                <h5>Chat Platform</h5>
                <p class="text-muted">
                    Set up when chat was enabled on Spark Connected Services. Shown here so it
                    can be checked against a support request.
                </p>
                <dl class="dl-horizontal">
                    <dt>Project</dt>
                    <dd>{{ config.configuration?.projectUrl }}</dd>
                    <dt>Publishable Key</dt>
                    <dd>{{ config.configuration?.publishableKey }}</dd>
                    <dt>Organization Id</dt>
                    <dd>{{ config.configuration?.tenantId }}</dd>
                    <dt>Key Id</dt>
                    <dd>{{ config.configuration?.kid }}</dd>
                    <dt>Signing Key</dt>
                    <dd>{{ config.configuration?.isChurchKeyPresent ? "Stored" : "Missing" }}</dd>
                </dl>
                <p class="text-muted">
                    Saved settings reach chat at the next scheduled Chat Platform Sync. Sync Now sends
                    them straight away.
                </p>
                <ChatSyncNowButton class="chat-configuration-sync-now"
                                   :disabled="hasUnsavedEdits || isSaving"
                                   :disabledReason="hasUnsavedEdits ? 'Save your changes first. Sync Now sends what is saved.' : ''" />
            </div>
        </template>
    </Panel>
</template>

<script setup lang="ts">
    import { computed, ref } from "vue";
    import { hasUnsavedChanges, toBag, toEmptyState, toFormModel } from "./ChatConfiguration/viewModel.partial";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import ChatSyncNowButton from "@Obsidian/Controls/Internal/chatSyncNowButton.obs";
    import DataViewPicker from "@Obsidian/Controls/dataViewPicker.obs";
    import CodeEditor from "@Obsidian/Controls/codeEditor.obs";
    import LavaCommandPicker from "@Obsidian/Controls/lavaCommandPicker.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import NumberBox from "@Obsidian/Controls/numberBox.obs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { makeUrlRedirectSafe } from "@Obsidian/Utility/url";
    import { ChatConfigurationInitializationBox } from "@Obsidian/ViewModels/Blocks/Communication/Chat/ChatConfiguration/chatConfigurationInitializationBox";

    const config = useConfigurationValues<ChatConfigurationInitializationBox>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const form = ref(toFormModel(config.configuration));

    // The form as last saved or loaded, which is what Sync Now would send.
    const savedForm = ref(toFormModel(config.configuration));
    const connectedServicesUrl = ref(config.connectedServicesUrl ?? "");

    /** What the screen says when chat cannot run here, which depends on why. */
    const emptyState = toEmptyState(config);

    const isSaving = ref(false);
    const message = ref("");
    const messageAlertType = ref<string | undefined>(undefined);

    // #endregion Values

    // #region Computed Values

    /** Whether the form holds edits a Sync Now press would not send. */
    const hasUnsavedEdits = computed((): boolean => hasUnsavedChanges(form.value, savedForm.value));

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Stores the settings. Only the church's own settings are sent: the platform half
     * is shown from the box and never travels back.
     */
    async function onSave(): Promise<void> {
        if (isSaving.value) {
            return;
        }

        try {
            isSaving.value = true;
            message.value = "";

            const result = await invokeBlockAction("SaveConfiguration", { bag: toBag(form.value) });

            if (result.isSuccess) {
                savedForm.value = toFormModel(toBag(form.value));
                message.value = "Settings saved.";
                messageAlertType.value = AlertType.Success;
            }
            else {
                message.value = result.errorMessage || "The settings could not be saved.";
                messageAlertType.value = AlertType.Warning;
            }
        }
        finally {
            isSaving.value = false;
        }
    }

    /**
     * Leaves without saving.
     */
    function onCancel(): void {
        const parentPage = config.navigationUrls?.["ParentPage"];

        if (parentPage) {
            window.location.href = makeUrlRedirectSafe(parentPage);
        }
    }

    // #endregion Event Handlers
</script>
