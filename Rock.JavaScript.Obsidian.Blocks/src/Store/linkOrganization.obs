<template>
    <Panel type="block"
           title="Link Organization"
           titleIconCssClass="ti ti-link">

        <h1 class="mt-0">Store Configuration</h1>

        <p>
            In order for us to get the store ready for your first download
            we need to do a bit of configuration. The first step is to match
            your Rock install to a registered organization so we can remember
            your purchases.
        </p>

        <NotificationBox v-if="errorMessage" alertType="danger">{{ errorMessage }}</NotificationBox>

        <NotificationBox v-if="warningMessage" alertType="warning">
            <span v-html="warningMessage"></span>
        </NotificationBox>

        <!-- Step: Authenticate -->
        <div v-if="currentStep === Step.Authenticate">
            <NotificationBox alertType="info"><strong>Which Password?</strong> Use the username and password below that you created on the Rock RMS website.</NotificationBox>
            <RockForm @submit="retrieveOrganizations">
                <TextBox v-model="username"
                         :inputProps="{ autocomplete: 'off' }"
                         label="Rock RMS Username"
                         rules="required" />

                <TextBox v-model="password"
                         label="Rock RMS Password"
                         type="password"
                         :inputProps="{ autocomplete: 'off' }"
                         rules="required" />

                <div class="actions">
                    <RockButton :btnType="BtnType.Primary"
                                type="submit"
                                :isLoading="isProcessing">
                        Retrieve Organization
                    </RockButton>
                </div>
            </RockForm>
        </div>

        <!-- Step: Select Organization -->
        <div v-else-if="currentStep === Step.SelectOrganization">
            <NotificationBox alertType="info"><strong>Success!</strong> We found multiple organizations tied to your account. Select the organization Rock should use for remembering purchases.</NotificationBox>
            <RockForm @submit="selectOrganization">
                <RadioButtonList label="Organization"
                                 v-model="selectedOrganizationKey"
                                 :items="organizations"
                                 :horizontal="false"
                                 :repeatColumns="0"
                                 rules="required" />
                <RockButton :btnType="BtnType.Primary"
                            type="submit"
                            :isLoading="isProcessing">
                    Select Organization
                </RockButton>
                <RockButton :btnType="BtnType.Link"
                            type="button"
                            :isLoading="isProcessing"
                            @click="currentStep = Step.Authenticate">
                    Cancel
                </RockButton>
            </RockForm>
        </div>

        <!-- Step: Average Weekly Attendance -->
        <div v-else-if="currentStep === Step.AverageWeeklyAttendance">
            <NotificationBox alertType="info"><strong>Confirm:</strong> Please confirm the size of your organization below. This will update your organization size on the Spark server which impacts your suggested donation amount and the relative pricing of Rock Shop plugins.
                <br />
                <br />
                Rock runs on integrity so we rely on the information below being accurate.
            </NotificationBox>
            <RockForm @submit="saveAverageAttendance">
                <NumberBox v-model="averageAttendance"
                           label="Average Weekend Attendance"
                           rules="required|integer"
                           :minimumValue="0" />

                <RockButton :btnType="BtnType.Primary"
                            type="submit"
                            :isLoading="isProcessing">
                    Save
                </RockButton>
            </RockForm>
        </div>

        <!-- Step: Complete -->
        <div v-else-if="currentStep === Step.Complete">
            <NotificationBox alertType="success"><strong>Success!</strong> We were able to configure the store for use by {{ organizationName }}.</NotificationBox>
            <RockButton :btnType="BtnType.Primary"
                        @click="onContinue">
                Continue
            </RockButton>
        </div>
    </Panel>
</template>

<script setup lang="ts">
    import { ref } from "vue";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { LinkOrganizationInitializationBox } from "@Obsidian/ViewModels/Blocks/Store/LinkOrganization/linkOrganizationInitializationBox";
    import { RetrieveOrganizationsRequestBag } from "@Obsidian/ViewModels/Blocks/Store/LinkOrganization/retrieveOrganizationsRequestBag";
    import { RetrieveOrganizationsResponseBag } from "@Obsidian/ViewModels/Blocks/Store/LinkOrganization/retrieveOrganizationsResponseBag";
    import { SaveAttendanceRequestBag } from "@Obsidian/ViewModels/Blocks/Store/LinkOrganization/saveAttendanceRequestBag";
    import { Step } from "./LinkOrganization/types.partial";
    import RadioButtonList from "@Obsidian/Controls/radioButtonList.obs";
    import NumberBox from "@Obsidian/Controls/numberBox.obs";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    // #region Values

    const config = useConfigurationValues<LinkOrganizationInitializationBox>();

    const invokeBlockAction = useInvokeBlockAction();

    const currentStep = ref<Step>(Step.Authenticate);

    const username = ref("");
    const password = ref("");

    const organizations = ref<ListItemBag[]>([]);
    const selectedOrganizationKey = ref("");
    const averageAttendance = ref<number | null>(null);
    const organizationName = ref("");

    const errorMessage = ref("");
    const warningMessage = ref("");
    const isProcessing = ref(false);

    // #endregion Values

    // #region Event Handlers

    /**
     * Retrieves the organizations tied to the supplied store account and
     * advances to the step indicated by the server.
     */
    async function retrieveOrganizations(): Promise<void> {
        errorMessage.value = "";
        warningMessage.value = "";
        isProcessing.value = true;

        try {
            const request: RetrieveOrganizationsRequestBag = {
                username: username.value,
                password: password.value
            };

            const result = await invokeBlockAction<RetrieveOrganizationsResponseBag>("RetrieveOrganizations", { bag: request });

            if (!result.isSuccess || !result.data) {
                errorMessage.value = result.errorMessage ?? "Unable to retrieve organizations.";
                return;
            }

            const response = result.data;

            // A warning means the credentials were valid but no usable
            // organization was found; stay on the authenticate step.
            if (response.warningMessage) {
                warningMessage.value = response.warningMessage;
                return;
            }

            organizations.value = response.organizations ?? [];
            currentStep.value = (response.nextStep as Step) ?? Step.Authenticate;
        }
        finally {
            isProcessing.value = false;
        }
    }

    /**
     * Links the organization the user chose from the list and advances to the
     * average weekly attendance step.
     */
    async function selectOrganization(): Promise<void> {
        errorMessage.value = "";
        warningMessage.value = "";
        isProcessing.value = true;

        try {
            const result = await invokeBlockAction("SelectOrganization", {
                organizationKey: selectedOrganizationKey.value
            });

            if (!result.isSuccess) {
                errorMessage.value = result.errorMessage ?? "Unable to select the organization.";
                return;
            }

            currentStep.value = Step.AverageWeeklyAttendance;
        }
        finally {
            isProcessing.value = false;
        }
    }

    /**
     * Saves the organization's average weekly attendance and advances to the
     * complete step.
     */
    async function saveAverageAttendance(): Promise<void> {
        errorMessage.value = "";
        warningMessage.value = "";
        isProcessing.value = true;

        try {
            const request: SaveAttendanceRequestBag = {
                username: username.value,
                password: password.value,
                averageWeeklyAttendance: averageAttendance.value ?? 0
            };

            const result = await invokeBlockAction<string>("SaveAttendance", { bag: request });

            if (!result.isSuccess) {
                errorMessage.value = result.errorMessage ?? "Unable to save average attendance.";
                return;
            }

            organizationName.value = result.data ?? "";
            currentStep.value = Step.Complete;
        }
        finally {
            isProcessing.value = false;
        }
    }

    /**
     * Navigates to the configured continue URL once configuration is complete.
     */
    function onContinue(): void {
        window.location.href = config.continueUrl ?? "/RockShop";
    }

    // #endregion Event Handlers
</script>
