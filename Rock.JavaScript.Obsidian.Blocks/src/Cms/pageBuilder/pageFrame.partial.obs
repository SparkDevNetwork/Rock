<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <iframe ref="frameElement"
            class="page-frame"
            :src="src"
            title="Page preview"
            @load="onFrameLoad"></iframe>
</template>

<style scoped>
.page-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
}
</style>

<script setup lang="ts">
    import { PropType, ref, watch } from "vue";
    import { PageBuilderModuleTypeBag } from "@Obsidian/ViewModels/Blocks/Cms/PageBuilder/pageBuilderModuleTypeBag";
    import { builderStyles, builderStyleVariableNames } from "./frameStyles.partial";
    import {
        ModuleDrop,
        ModuleSelectRequest,
        ModuleTypeDragEndRequest,
        ModuleTypeDragLeaveRequest,
        ModuleTypeDragOverRequest,
        ModuleTypeDragStartRequest,
        ModuleTypeDropRequest,
        PageFrameReloadRequest
    } from "./types.partial";

    // #region Types

    /** Where a dropped module will be placed. */
    type DropTarget = {
        /** The zone content element that will receive the module. */
        containerElement: HTMLElement;

        /** The existing child the module is placed before, or null to place it last. */
        beforeElement: Element | null;
    };

    // #endregion Types

    const props = defineProps({
        /** The URL of the page to compose. */
        src: {
            type: String as PropType<string>,
            required: true
        },

        /** The module types that can be on the page, used to name a selected module. */
        moduleTypes: {
            type: Array as PropType<PageBuilderModuleTypeBag[]>,
            required: true
        },

        dragStartRequest: {
            type: Object as PropType<ModuleTypeDragStartRequest | null | undefined>,
            required: true
        },

        dragOverRequest: {
            type: Object as PropType<ModuleTypeDragOverRequest | null | undefined>,
            required: true
        },

        dropRequest: {
            type: Object as PropType<ModuleTypeDropRequest | null | undefined>,
            required: true
        },

        dragLeaveRequest: {
            type: Object as PropType<ModuleTypeDragLeaveRequest | null | undefined>,
            required: true
        },

        dragEndRequest: {
            type: Object as PropType<ModuleTypeDragEndRequest | null | undefined>,
            required: true
        },

        reloadRequest: {
            type: Object as PropType<PageFrameReloadRequest | null | undefined>,
            required: true
        },

        selectRequest: {
            type: Object as PropType<ModuleSelectRequest | null | undefined>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "moduleDropped", value: ModuleDrop): void;
        (e: "moduleSelected", blockId: number | null): void;
        (e: "moduleEditRequested", blockId: number): void;
        (e: "moduleDeleteRequested", blockId: number): void;
    }>();

    // #region Values

    const zoneSelector = "[data-pagebuilder=\"true\"]";
    const scrollTriggerDistance = 40;

    const frameElement = ref<HTMLIFrameElement | undefined>();
    const draggingModuleType = ref<PageBuilderModuleTypeBag | null>(null);
    const dropTarget = ref<DropTarget | null>(null);
    const placeholderElement = ref<HTMLElement | null>(null);
    const lastClientX = ref<number | null>(null);
    const lastClientY = ref<number | null>(null);
    const selectedBlockElement = ref<HTMLElement | null>(null);
    const pendingSelectBlockId = ref<number | null>(null);

    let isReloadPending = false;

    // #endregion Values

    // #region Event Handlers

    /**
     * Prepares the framed page for composing each time it loads, including after
     * navigating within the frame.
     */
    function onFrameLoad(): void {
        const frameDocument = getFrameDocument();

        if (!frameDocument) {
            return;
        }

        addBuilderStyles(frameDocument);
        decorateZones(frameDocument);

        // Capture so a click inside a module selects it before the module's own content, such as a link, can act on it.
        frameDocument.addEventListener("click", onFrameClick, true);

        // A reload replaces the document, so any previous selection is gone.
        if (selectedBlockElement.value) {
            selectedBlockElement.value = null;
            emit("moduleSelected", null);
        }

        isReloadPending = false;

        if (pendingSelectBlockId.value !== null) {
            selectCanvasBlock(pendingSelectBlockId.value);

            // A block the loaded page does not show, such as one just deleted, is no longer waited for.
            pendingSelectBlockId.value = null;
        }
    }

    /**
     * Selects the Canvas block that was clicked and handles the selected
     * block's controls. Clicking anything else clears the selection.
     */
    function onFrameClick(event: MouseEvent): void {
        const target = event.target as Element | null;

        // Rock's own block configuration bar keeps working as it does on any block.
        if (!target || typeof target.closest !== "function" || target.closest(".block-configuration")) {
            return;
        }

        const blockElement = target.closest<HTMLElement>(".block-instance");
        const blockId = getBlockId(blockElement);
        const isCanvasBlock = !!blockElement?.querySelector(".canvas-module");

        if (!blockElement || blockId === null || !isCanvasBlock) {
            clearSelection();
            return;
        }

        event.preventDefault();
        event.stopPropagation();

        if (target.closest(".pagebuilder-selection-edit")) {
            emit("moduleEditRequested", blockId);
            return;
        }

        if (target.closest(".pagebuilder-selection-delete")) {
            emit("moduleDeleteRequested", blockId);
            return;
        }

        if (blockElement !== selectedBlockElement.value) {
            selectBlockElement(blockElement);
        }
    }

    /**
     * Begins a drag, which outlines every builder-enabled zone as a possible
     * drop target.
     */
    function onDragStart(request: ModuleTypeDragStartRequest): void {
        draggingModuleType.value = request.moduleType;
        lastClientX.value = null;
        lastClientY.value = null;

        getFrameDocument()?.documentElement.classList.add("pagebuilder-dragging");
    }

    /**
     * Moves the drop placeholder to follow the pointer.
     *
     * The parent fires this repeatedly even while the pointer is still, so
     * unchanged coordinates are ignored unless the frame needs to scroll.
     */
    function onDragOver(request: ModuleTypeDragOverRequest): void {
        const frameDocument = getFrameDocument();

        if (!frameDocument || !frameElement.value || !draggingModuleType.value) {
            return;
        }

        const frameHeight = frameElement.value.getBoundingClientRect().height;

        if (request.clientY < scrollTriggerDistance) {
            frameElement.value.contentWindow?.scrollBy({ top: -scrollTriggerDistance, behavior: "smooth" });
        }
        else if (request.clientY > frameHeight - scrollTriggerDistance) {
            frameElement.value.contentWindow?.scrollBy({ top: scrollTriggerDistance, behavior: "smooth" });
        }
        else if (request.clientX === lastClientX.value && request.clientY === lastClientY.value) {
            return;
        }

        lastClientX.value = request.clientX;
        lastClientY.value = request.clientY;

        const target = findDropTarget(frameDocument, request.clientX, request.clientY);

        if (target) {
            showDropTarget(frameDocument, target);
        }
        else {
            clearDropTarget();
        }
    }

    /**
     * Reports where the module was released so it can be added to the page.
     * The target is resolved again from the release point, because a fast
     * drag can release somewhere the last move never reported.
     */
    function onDrop(request: ModuleTypeDropRequest): void {
        const frameDocument = getFrameDocument();
        const moduleType = draggingModuleType.value;

        clearDropTarget();

        if (!frameDocument || !moduleType) {
            return;
        }

        const target = findDropTarget(frameDocument, request.clientX, request.clientY);
        const zoneName = target?.containerElement.parentElement?.getAttribute("data-pagebuilder-zone");

        if (!target || !zoneName) {
            return;
        }

        emit("moduleDropped", {
            moduleType,
            zoneName,
            beforeBlockId: getBlockId(target.beforeElement)
        });
    }

    function onDragEnd(): void {
        clearDropTarget();
        draggingModuleType.value = null;

        getFrameDocument()?.documentElement.classList.remove("pagebuilder-dragging");
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Gets the framed page's document, or null when it has not loaded or
     * belongs to another origin.
     */
    function getFrameDocument(): Document | null {
        try {
            return frameElement.value?.contentDocument ?? null;
        }
        catch {
            return null;
        }
    }

    /*
        09/23/26 - JMH

        The builder chrome is styled with Rock's CSS variables. The framed page can belong to any
        site and theme, so any of those variables it does not define are copied from the builder's
        own document. Variables the page already defines are left alone, so the builder never
        restyles the site's own content.

        Reason: Keeps the builder chrome working on pages whose theme does not define Rock's variables.
    */
    function addBuilderStyles(frameDocument: Document): void {
        const builderStyle = getComputedStyle(frameElement.value ?? document.documentElement);
        const frameStyle = frameDocument.defaultView?.getComputedStyle(frameDocument.documentElement);
        const missingVariableDeclarations = builderStyleVariableNames
            .filter(name => !frameStyle?.getPropertyValue(name).trim())
            .map(name => `${name}: ${builderStyle.getPropertyValue(name)};`)
            .join(" ");

        const styleElement = frameDocument.createElement("style");
        styleElement.textContent = `:root { ${missingVariableDeclarations} }${builderStyles}`;
        frameDocument.head.appendChild(styleElement);
    }

    /**
     * Outlines and labels each builder-enabled zone and shows the empty state
     * in any that have no content yet.
     */
    function decorateZones(frameDocument: Document): void {
        frameDocument.querySelectorAll<HTMLElement>(zoneSelector).forEach(zoneElement => {
            zoneElement.classList.add("pagebuilder-zone");

            const chipIconElement = frameDocument.createElement("i");
            chipIconElement.className = "pagebuilder-zone-chip-icon ti ti-table-options";

            const chipNameElement = frameDocument.createElement("span");
            chipNameElement.textContent = getZoneName(zoneElement);

            const chipElement = frameDocument.createElement("div");
            chipElement.classList.add("pagebuilder-zone-chip");
            chipElement.append(chipIconElement, chipNameElement);
            zoneElement.prepend(chipElement);

            const containerElement = getZoneContentElement(zoneElement);

            if (containerElement) {
                updateEmptyState(frameDocument, containerElement);
            }
        });
    }

    /**
     * Gets the zone's display name. Rock only renders the name for viewers who
     * can configure the page, so the zone's id is the fallback.
     */
    function getZoneName(zoneElement: HTMLElement): string {
        const configuredName = zoneElement.querySelector(":scope > .zone-configuration .zone-configuration-bar > span")?.textContent?.trim();

        if (configuredName) {
            return configuredName;
        }

        const key = zoneElement.id.replace(/^zone-/, "");

        return key.charAt(0).toUpperCase() + key.slice(1);
    }

    function getZoneContentElement(zoneElement: Element): HTMLElement | null {
        return zoneElement.querySelector<HTMLElement>(":scope > .zone-content");
    }

    /**
     * Gets the children of a zone's content that represent page content,
     * leaving out the elements the builder adds.
     */
    function getContentChildren(containerElement: HTMLElement): Element[] {
        return Array.from(containerElement.children)
            .filter(child => !child.classList.contains("pagebuilder-placeholder") && !child.classList.contains("pagebuilder-zone-empty"));
    }

    /**
     * Finds the zone and position a module would land in if dropped at the
     * given point.
     */
    function findDropTarget(frameDocument: Document, clientX: number, clientY: number): DropTarget | null {
        const zoneElement = frameDocument.elementFromPoint(clientX, clientY)?.closest(zoneSelector);
        const containerElement = zoneElement ? getZoneContentElement(zoneElement) : null;

        if (!containerElement) {
            return null;
        }

        // Rock renders a zone's site and layout blocks ahead of its page blocks whatever their order,
        // so a new block can only be placed after the last of them.
        const contentChildren = getContentChildren(containerElement);
        let firstPositionIndex = 0;

        contentChildren.forEach((child, index) => {
            const zoneLocation = child.getAttribute("data-zone-location");

            if (zoneLocation === "Site" || zoneLocation === "Layout") {
                firstPositionIndex = index + 1;
            }
        });

        const beforeElement = contentChildren.slice(firstPositionIndex).find(child => {
            const rect = child.getBoundingClientRect();

            return clientY < rect.top + (rect.height / 2);
        }) ?? null;

        return { containerElement, beforeElement };
    }

    /**
     * Selects the Canvas block with the given identifier, or remembers it to
     * select once the frame shows it.
     */
    function selectCanvasBlock(blockId: number): void {
        const blockElement = getFrameDocument()?.getElementById(`bid_${blockId}`);

        // A document that is about to be replaced by a reload would lose the selection.
        if (isReloadPending || !blockElement?.querySelector(".canvas-module")) {
            pendingSelectBlockId.value = blockId;
            return;
        }

        pendingSelectBlockId.value = null;
        selectBlockElement(blockElement);
        blockElement.scrollIntoView({ block: "nearest" });
    }

    /**
     * Marks a Canvas block as selected and adds the selection chip and
     * controls to it, clearing any previous selection.
     */
    function selectBlockElement(blockElement: HTMLElement): void {
        const frameDocument = blockElement.ownerDocument;
        const moduleTypeKey = blockElement.querySelector(".canvas-module")?.getAttribute("data-module-type");
        const moduleType = props.moduleTypes.find(type => type.key === moduleTypeKey);

        clearSelection();

        const chipIconElement = frameDocument.createElement("i");
        chipIconElement.className = "pagebuilder-selection-chip-icon ti ti-hexagons";

        const chipNameElement = frameDocument.createElement("span");
        chipNameElement.textContent = moduleType?.name ?? "Module";

        const chipElement = frameDocument.createElement("div");
        chipElement.classList.add("pagebuilder-selection-chip");
        chipElement.append(chipIconElement, chipNameElement);

        const actionsElement = frameDocument.createElement("div");
        actionsElement.classList.add("pagebuilder-selection-actions");
        actionsElement.append(
            createSelectionControl(frameDocument, "pagebuilder-selection-edit", "Edit", "ti ti-edit"),
            createSelectionControl(frameDocument, "pagebuilder-selection-delete", "Delete", "ti ti-x"));

        const controlsElement = frameDocument.createElement("div");
        controlsElement.classList.add("pagebuilder-selection-controls");
        controlsElement.append(
            createSelectionControl(frameDocument, "pagebuilder-selection-drag", "Move", "ti ti-grip-vertical"),
            actionsElement);

        blockElement.classList.add("pagebuilder-selected");
        blockElement.prepend(chipElement, controlsElement);
        selectedBlockElement.value = blockElement;

        emit("moduleSelected", getBlockId(blockElement));
    }

    /**
     * Removes the selection chrome from the selected Canvas block, if any.
     */
    function clearSelection(): void {
        const blockElement = selectedBlockElement.value;

        if (!blockElement) {
            return;
        }

        blockElement.classList.remove("pagebuilder-selected");
        blockElement.querySelectorAll(":scope > .pagebuilder-selection-chip, :scope > .pagebuilder-selection-controls")
            .forEach(element => element.remove());
        selectedBlockElement.value = null;

        emit("moduleSelected", null);
    }

    function createSelectionControl(frameDocument: Document, cssClass: string, title: string, iconCssClass: string): HTMLElement {
        const iconElement = frameDocument.createElement("i");
        iconElement.className = iconCssClass;

        const controlElement = frameDocument.createElement("button");
        controlElement.type = "button";
        controlElement.className = `pagebuilder-selection-control ${cssClass}`;
        controlElement.title = title;
        controlElement.appendChild(iconElement);

        return controlElement;
    }

    /**
     * Gets the identifier of the block an element is the wrapper for, or null
     * when it is not a block wrapper.
     */
    function getBlockId(element: Element | null): number | null {
        const match = element ? /^bid_(\d+)$/.exec(element.id) : null;

        return match ? parseInt(match[1]) : null;
    }

    /**
     * Shows where the module will land. An empty zone is highlighted as a whole,
     * because inserting a placeholder would collapse its empty state and move
     * the zone out from under the pointer.
     */
    function showDropTarget(frameDocument: Document, target: DropTarget): void {
        clearDropTarget();
        dropTarget.value = target;

        if (getContentChildren(target.containerElement).length === 0) {
            target.containerElement.parentElement?.classList.add("pagebuilder-zone-over");
            return;
        }

        if (!placeholderElement.value || placeholderElement.value.ownerDocument !== frameDocument) {
            placeholderElement.value = createPlaceholderElement(frameDocument);
        }

        target.containerElement.insertBefore(placeholderElement.value, target.beforeElement);
    }

    function clearDropTarget(): void {
        placeholderElement.value?.remove();
        dropTarget.value?.containerElement.parentElement?.classList.remove("pagebuilder-zone-over");
        dropTarget.value = null;
    }

    /**
     * Shows the empty state in a zone with no content, or removes it once the
     * zone has some.
     */
    function updateEmptyState(frameDocument: Document, containerElement: HTMLElement): void {
        const emptyStateElement = containerElement.querySelector(":scope > .pagebuilder-zone-empty");
        const hasContent = getContentChildren(containerElement).length > 0;

        containerElement.parentElement?.classList.toggle("pagebuilder-zone-is-empty", !hasContent);

        if (hasContent) {
            emptyStateElement?.remove();
        }
        else if (!emptyStateElement) {
            containerElement.appendChild(createEmptyStateElement(frameDocument));
        }
    }

    function createEmptyStateElement(frameDocument: Document): HTMLElement {
        const emptyStateElement = frameDocument.createElement("div");
        emptyStateElement.classList.add("pagebuilder-zone-empty");

        const plusElement = frameDocument.createElement("i");
        plusElement.className = "ti ti-plus";

        const iconElement = frameDocument.createElement("div");
        iconElement.classList.add("pagebuilder-zone-empty-icon");
        iconElement.appendChild(plusElement);

        const titleElement = frameDocument.createElement("div");
        titleElement.classList.add("pagebuilder-zone-empty-title");
        titleElement.textContent = "Drop a Module or Element to Begin";

        const textElement = frameDocument.createElement("div");
        textElement.classList.add("pagebuilder-zone-empty-text");
        textElement.textContent = "Drag and drop modules from the left sidebar to begin.";

        emptyStateElement.append(iconElement, titleElement, textElement);

        return emptyStateElement;
    }

    function createPlaceholderElement(frameDocument: Document): HTMLElement {
        const placeholder = frameDocument.createElement("div");
        placeholder.classList.add("pagebuilder-placeholder");

        const lineElement = frameDocument.createElement("div");
        lineElement.classList.add("pagebuilder-placeholder-line");

        const pillElement = frameDocument.createElement("div");
        pillElement.classList.add("pagebuilder-placeholder-pill");
        pillElement.textContent = "Drop it here";

        placeholder.append(lineElement, pillElement, lineElement.cloneNode());

        return placeholder;
    }

    // #endregion Functions

    // #region Watchers

    watch(() => props.dragStartRequest, request => {
        if (request) {
            onDragStart(request);
        }
    });

    watch(() => props.dragOverRequest, request => {
        if (request) {
            onDragOver(request);
        }
    });

    watch(() => props.dropRequest, request => {
        if (request) {
            onDrop(request);
        }
    });

    watch(() => props.dragLeaveRequest, request => {
        if (request) {
            clearDropTarget();
        }
    });

    watch(() => props.dragEndRequest, request => {
        if (request) {
            onDragEnd();
        }
    });

    watch(() => props.reloadRequest, request => {
        if (!request) {
            return;
        }

        // The selected module stays selected in the reloaded page, unless another selection is already waiting.
        if (pendingSelectBlockId.value === null && selectedBlockElement.value) {
            pendingSelectBlockId.value = getBlockId(selectedBlockElement.value);
        }

        isReloadPending = true;
        frameElement.value?.contentWindow?.location.reload();
    });

    watch(() => props.selectRequest, request => {
        if (request) {
            selectCanvasBlock(request.blockId);
        }
    });

    // #endregion Watchers
</script>
