<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="ranked-list">
        <div v-for="item in visibleItems" :key="item.label ?? ''" class="ranked-row">
            <div class="ranked-row-header">
                <span class="ranked-label" :title="item.label ?? ''">{{ item.label }}</span>
                <span class="ranked-stats">
                    <span class="ranked-percent">{{ itemPercent(item.count) }}</span>
                    <span class="ranked-count">{{ item.count.toLocaleString() }}</span>
                </span>
            </div>
            <div class="ranked-track">
                <div class="ranked-fill" :style="{ width: itemBarWidth(item.count) }"></div>
            </div>
        </div>

        <TransitionVerticalCollapse>
            <div v-show="isExpanded" class="ranked-hidden-group">
                <div v-for="item in hiddenItems" :key="item.label ?? ''" class="ranked-row">
                    <div class="ranked-row-header">
                        <span class="ranked-label" :title="item.label ?? ''">{{ item.label }}</span>
                        <span class="ranked-stats">
                            <span class="ranked-percent">{{ itemPercent(item.count) }}</span>
                            <span class="ranked-count">{{ item.count.toLocaleString() }}</span>
                        </span>
                    </div>
                    <div class="ranked-track">
                        <div class="ranked-fill" :style="{ width: itemBarWidth(item.count) }"></div>
                    </div>
                </div>
            </div>
        </TransitionVerticalCollapse>
    </div>

    <button v-if="hiddenItems.length > 0"
            type="button"
            class="btn btn-link ranked-show-more"
            @click="isExpanded = !isExpanded">
        <span>{{ isExpanded ? "Show Less" : `Show ${hiddenItems.length} More` }}</span>
        <i :class="isExpanded ? 'ti ti-chevron-up' : 'ti ti-chevron-down'"></i>
    </button>
</template>

<style scoped>
.ranked-row {
    margin-bottom: var(--spacing-medium);
}

/* overflow:hidden makes the group a block formatting context so its last row's margin-bottom
   is contained rather than collapsing through. That keeps the height the collapse transition
   measures equal to what's rendered, which removes the jitter at the end of the close. */
.ranked-hidden-group {
    overflow: hidden;
}

.ranked-row-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-medium);
    margin-bottom: var(--spacing-xsmall);
}

.ranked-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-interface-stronger);
}

.ranked-stats {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-medium);
    flex-shrink: 0;
}

.ranked-percent {
    font-size: var(--font-size-small);
    color: var(--color-interface-medium);
}

.ranked-count {
    font-weight: var(--font-weight-semibold);
    color: var(--color-interface-stronger);
}

.ranked-track {
    height: 20px;
    background-color: var(--color-interface-soft);
    border-radius: 9999px;
    overflow: hidden;
}

.ranked-fill {
    height: 100%;
    background-color: var(--color-categorical-1);
    border-radius: 9999px;
}

.ranked-show-more {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xsmall);
    padding-left: 0;
}
</style>

<script setup lang="ts">
    import { computed, ref } from "vue";
    import TransitionVerticalCollapse from "@Obsidian/Controls/transitionVerticalCollapse.obs";
    import { MetricSliceBag } from "@Obsidian/ViewModels/Blocks/Cms/ContentChannelItemMetrics/metricSliceBag";

    // #region Types

    const props = withDefaults(defineProps<{
        /** The labeled counts to rank, ordered highest to lowest. */
        items: MetricSliceBag[];

        /** The number of rows shown before the Show More toggle. */
        visibleCount?: number;
    }>(), {
        visibleCount: 5
    });

    // #endregion Types

    // #region Values

    const isExpanded = ref<boolean>(false);

    // #endregion Values

    // #region Computed Values

    // The total of all rows, used as the percentage denominator even when collapsed.
    const totalCount = computed<number>(() => {
        return props.items.reduce((sum, item) => sum + item.count, 0);
    });

    // The highest count, used to scale the bar widths so the top row fills the track.
    const maxCount = computed<number>(() => {
        return Math.max(0, ...props.items.map(item => item.count));
    });

    // The rows always shown, before the Show More toggle.
    const visibleItems = computed<MetricSliceBag[]>(() => {
        return props.items.slice(0, props.visibleCount);
    });

    // The rows revealed by the Show More toggle, collapsed by default.
    const hiddenItems = computed<MetricSliceBag[]>(() => {
        return props.items.slice(props.visibleCount);
    });

    // #endregion Computed Values

    // #region Functions

    /**
     * Gets the CSS width for a row's bar, scaled so the highest count fills the track.
     *
     * @param count The row's count.
     */
    function itemBarWidth(count: number): string {
        if (maxCount.value <= 0) {
            return "0%";
        }

        return `${(count / maxCount.value) * 100}%`;
    }

    /**
     * Gets a row's share of the total, as a rounded percentage string.
     *
     * @param count The row's count.
     */
    function itemPercent(count: number): string {
        if (totalCount.value <= 0) {
            return "0%";
        }

        return `${Math.round((count / totalCount.value) * 100)}%`;
    }

    // #endregion Functions
</script>
