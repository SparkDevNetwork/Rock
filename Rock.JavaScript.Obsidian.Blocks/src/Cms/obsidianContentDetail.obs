<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <NotificationBox v-if="blockError"
                     alertType="danger">{{ blockError }}</NotificationBox>

    <!-- Edit mode: authorized administrators only. -->
    <Panel v-else-if="isEditing"
           title="Obsidian Content"
           type="block">
        <EditPanel v-model="source"
                   :compileError="compileError" />

        <div class="mt-3">
            <label class="form-label">Preview</label>
            <PreviewPanel :compiledContent="previewContent" />
        </div>

        <template #footerActions>
            <RockButton btnType="primary"
                        :disabled="!canSave"
                        :isLoading="isSaving"
                        @click="onSave">Save</RockButton>
            <RockButton btnType="link"
                        :disabled="isSaving"
                        @click="onCancel">Cancel</RockButton>
        </template>
    </Panel>

    <!-- View mode: everyone. -->
    <template v-else>
        <div v-if="isEditable"
             class="text-right mb-2">
            <RockButton btnType="default"
                        btnSize="xs"
                        :isLoading="isEnteringEdit"
                        @click="onEdit">
                <i class="ti ti-pencil"></i>
                {{ hasContent ? "Edit" : "Add Content" }}
            </RockButton>
        </div>

        <ViewPanel v-if="hasContent"
                   :compiledContent="compiledContent" />

        <NotificationBox v-else-if="isEditable"
                         alertType="info">
            This block has no content yet. Click <strong>Add Content</strong> to author it.
        </NotificationBox>
    </template>
</template>

<script setup lang="ts">
    import { computed, onBeforeUnmount, ref, watch } from "vue";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { ObsidianContentDetailInitializationBox } from "@Obsidian/ViewModels/Blocks/Cms/ObsidianContentDetail/obsidianContentDetailInitializationBox";
    import { SaveObsidianContentRequestBag } from "@Obsidian/ViewModels/Blocks/Cms/ObsidianContentDetail/saveObsidianContentRequestBag";
    import EditPanel from "./obsidianContentDetail/editPanel.partial.obs";
    import PreviewPanel from "./obsidianContentDetail/previewPanel.partial.obs";
    import ViewPanel from "./obsidianContentDetail/viewPanel.partial.obs";
    import { compileSource, loadCompilerAsync, ObsidianContentCompileResult } from "./obsidianContentDetail/obsidianContentCompiler.partial";

    /** How long to wait after the last keystroke before recompiling for the live preview. */
    const compileDebounceMs = 500;

    const config = useConfigurationValues<ObsidianContentDetailInitializationBox>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    /** The starter source shown when an author opens an unconfigured block. */
    const defaultSource = `<template>
    <div class="obsidian-content-example">
        <RockLabel>Count is {{ count }}</RockLabel>
        <RockButton btnType="primary" @click="increment">Add one</RockButton>
    </div>
</template>

<script setup>
import RockButton from "@Obsidian/Controls/rockButton.obs";
import RockLabel from "@Obsidian/Controls/rockLabel.obs";
import { ref } from "vue";

const count = ref(0);

function increment() {
    count.value += 1;
}
<\/script>

<style scoped>
.obsidian-content-example {
    display: flex;
    gap: 8px;
    align-items: center;
}
</style>`;

    const blockError = ref(config.errorMessage ?? "");
    const isEditable = ref(config.isEditable);
    const isEditing = ref(false);
    const isEnteringEdit = ref(false);
    const isSaving = ref(false);
    const source = ref(config.source ?? "");
    const compiledContent = ref(config.compiledContent ?? "");
    const previewContent = ref("");
    const compileError = ref("");
    const lastCompile = ref<ObsidianContentCompileResult | null>(null);
    let compileTimer: number | null = null;

    // #endregion Values

    // #region Computed Values

    const hasContent = computed((): boolean => !!compiledContent.value);

    const canSave = computed((): boolean => {
        return isEditing.value && !isSaving.value && compileError.value === "" && lastCompile.value !== null;
    });

    // #endregion Computed Values

    // #region Functions

    /**
     * Compiles the current source for the live preview, surfacing any compile error
     * inline. On failure the last good preview is kept so the preview does not blank
     * out mid-typing.
     */
    function runLiveCompile(): void {
        try {
            const result = compileSource(source.value);

            lastCompile.value = result;
            previewContent.value = result.compiledContent;
            compileError.value = "";
        }
        catch (e) {
            lastCompile.value = null;
            compileError.value = e instanceof Error ? e.message : "The source could not be compiled.";
        }
    }

    /**
     * Debounces the live compile so it runs shortly after the author stops typing.
     */
    function scheduleCompile(): void {
        if (compileTimer !== null) {
            window.clearTimeout(compileTimer);
        }

        compileTimer = window.setTimeout(() => {
            compileTimer = null;
            runLiveCompile();
        }, compileDebounceMs);
    }

    // #endregion Functions

    // #region Event Handlers

    /**
     * Enters edit mode, lazy-loading the compiler asset (only now, only for the
     * authorized administrator) and compiling once for the initial preview.
     */
    async function onEdit(): Promise<void> {
        isEnteringEdit.value = true;
        blockError.value = "";

        try {
            await loadCompilerAsync();

            if (!source.value) {
                source.value = defaultSource;
            }

            isEditing.value = true;
            runLiveCompile();
        }
        catch (e) {
            blockError.value = e instanceof Error ? e.message : "The editor could not be loaded.";
        }
        finally {
            isEnteringEdit.value = false;
        }
    }

    /**
     * Recompiles to ensure the stored artifact matches the current source, then saves
     * both the source and the compiled output. A compile failure is surfaced inline and
     * blocks the save.
     */
    async function onSave(): Promise<void> {
        // Guarantee the compiled output matches the current source (a debounced compile
        // may still be pending), and block the save if it does not compile.
        runLiveCompile();

        const compileResult = lastCompile.value;

        if (compileError.value !== "" || compileResult === null) {
            return;
        }

        isSaving.value = true;

        try {
            const bag: SaveObsidianContentRequestBag = {
                source: source.value,
                compiledContent: compileResult.compiledContent,
                compiledVueVersion: compileResult.vueVersion
            };

            const response = await invokeBlockAction("SaveContent", { bag });

            if (!response.isSuccess) {
                blockError.value = response.errorMessage ?? "The content could not be saved.";
                return;
            }

            compiledContent.value = compileResult.compiledContent;
            isEditing.value = false;
        }
        finally {
            isSaving.value = false;
        }
    }

    /**
     * Leaves edit mode, discarding any unsaved source edits.
     */
    function onCancel(): void {
        if (compileTimer !== null) {
            window.clearTimeout(compileTimer);
            compileTimer = null;
        }

        source.value = config.source ?? "";
        compileError.value = "";
        isEditing.value = false;
    }

    // #endregion Event Handlers

    // #region Watchers

    watch(source, () => {
        if (isEditing.value) {
            scheduleCompile();
        }
    });

    // #endregion Watchers

    // #region Lifecycle Hooks

    onBeforeUnmount(() => {
        if (compileTimer !== null) {
            window.clearTimeout(compileTimer);
        }
    });

    // #endregion Lifecycle Hooks
</script>
