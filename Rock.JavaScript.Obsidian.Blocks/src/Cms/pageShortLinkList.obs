<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Grid :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="idKey"
          itemTerm="Shortened Links"
          title="Shortened Links"
          :entityTypeGuid="EntityType.PageShortLink"
          stickyHeader
          liveUpdates
          gridSettings
          :gridSettingsActive="hasSettingsFilters"
          @gridSettingsClick="onGridSettingsClick"
          :onAddItem="config.isAddEnabled ? onAddItem : undefined"
          :showLaunchWorkflow="false"
          @selectItem="onSelectItem">

        <TextColumn name="shortLink"
                    title="Shortened URL"
                    field="shortLink"
                    :filter="textValueFilter"
                    visiblePriority="xs" />

        <DateTimeColumn name="createdDateTime"
                        title="Created On"
                        field="createdDateTime"
                        :filter="dateValueFilter"
                        visiblePriority="xs" />

        <TextColumn name="site"
                    title="Site"
                    field="site"
                    :filter="pickExistingValueFilter"
                    visiblePriority="xs" />

        <TextColumn name="token"
                    title="Token"
                    field="token"
                    :filter="textValueFilter"
                    visiblePriority="xs" />

        <TextColumn name="url"
                    title="Original URL"
                    field="url"
                    :filter="textValueFilter"
                    visiblePriority="md" />

        <TextColumn name="category"
                    title="Category"
                    field="category"
                    :filter="pickExistingValueFilter"
                    visiblePriority="md" />

        <NumberColumn name="clickCount"
                      title="Click Count"
                      field="clickCount"
                      :filter="numberValueFilter"
                      visiblePriority="xs" />

        <BooleanColumn name="isPinned"
                       title="Pinned"
                       field="isPinned"
                       :filter="booleanValueFilter"
                       visiblePriority="xs" />

        <ButtonColumn name="qrCode"
                      tooltip="Download QR Code Image"
                      iconClass="ti ti-qrcode"
                      visiblePriority="xs"
                      @click="onGetQrCodeClick" />

        <ButtonColumn name="copy"
                      tooltip="Copy to Clipboard"
                      iconClass="ti ti-clipboard"
                      visiblePriority="xs"
                      @click="onCopyClick" />

        <AttributeColumns :attributes="config.gridDefinition?.attributeFields ?? []" />

        <DeleteColumn v-if="config.isDeleteEnabled" @click="onDeleteClick" />
    </Grid>

    <GridSettingsModal v-model="gridSettings"
                       v-model:visible="isGridSettingsVisible"
                       :currentPerson="config.options?.currentPerson ?? {}" />
</template>

<script setup lang="ts">
    import { useConfigurationValues, useInvokeBlockAction, usePersonPreferences } from "@Obsidian/Utility/block";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import Grid, { TextColumn, textValueFilter, DeleteColumn, NumberColumn, numberValueFilter, ButtonColumn, pickExistingValueFilter, BooleanColumn, booleanValueFilter, AttributeColumns, DateTimeColumn, dateValueFilter } from "@Obsidian/Controls/grid";
    import { alert } from "@Obsidian/Utility/dialogs";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { PageShortLinkListOptionsBag } from "@Obsidian/ViewModels/Blocks/Cms/PageShortLinkList/pageShortLinkListOptionsBag";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { GridSettingsOptions, NavigationUrlKey, PreferenceKey } from "./PageShortLinkList/types.partial";
    import { reactive, ref, computed, watch } from "vue";
    import { IGridState } from "@Obsidian/Types/Controls/grid";
    import GridSettingsModal from "./PageShortLinkList/gridSettingsModal.partial.obs";
    import { safeParseJson } from "@Obsidian/Utility/stringUtils";
    import { parseSlidingDateRangeString, slidingDateRangeToString } from "@Obsidian/Utility/slidingDateRange";

    const config = useConfigurationValues<ListBlockBox<PageShortLinkListOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();
    const preferences = usePersonPreferences().blockPreferences;

    // #region Values

    const gridDataSource = ref<Promise<GridDataBag>>();
    let gridData: GridDataBag | undefined;

    const isGridSettingsVisible = ref(false);
    const gridSettings = ref<GridSettingsOptions>({
        createdBy: safeParseJson(preferences.getValue(PreferenceKey.FilterCreatedBy)),
        filterPerson: safeParseJson(preferences.getValue(PreferenceKey.FilterPerson)),
        createdDateRange: parseSlidingDateRangeString(preferences.getValue(PreferenceKey.FilterCreatedDateRange))
    });

    // #endregion

    // #region Computed Values

    /** `true` if the grid settings is performing any filtering. */
    const hasSettingsFilters = computed((): boolean => {
        return !!gridSettings.value.createdBy?.value
            || !!gridSettings.value.filterPerson?.value
            || !!gridSettings.value.createdDateRange;
    });

    // #endregion

    // #region Functions

    /**
     * Called when the grid is requesting the row data be loaded.
     */
    async function loadGridData(): Promise<GridDataBag> {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (result.isSuccess && result.data) {
            gridData = reactive(result.data);
            return gridData;
        }
        else {
            throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
        }
    }

    // #endregion

    // #region Event Handlers

    /**
     * Called when a row has been selected by the individual.
     *
     * @param key The key of the row that was selected.
     */
    function onSelectItem(key: string): void {
        if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
            window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", key);
        }
    }

    /**
     * Called when a row's delete button has been clicked by the individual. This
     * happens only if they have confirmed the delete action.
     */
    async function onDeleteClick(key: string): Promise<void> {
        const result = await invokeBlockAction<string>("Delete", {
            key
        });

        if (result.isSuccess) {
            if (gridData && gridData.rows) {
                const index = gridData.rows.findIndex(r => r["idKey"] === key);

                if (index !== -1) {
                    gridData.rows?.splice(index, 1);
                }
            }
        }
        else {
            await alert(result.errorMessage ?? "Unknown error while trying to delete page short link.");
        }
    }

    /**
     * Called when the Add button has been clicked by the indivual.
     */
    function onAddItem(): void {
        if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
            window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", "0");
        }
    }

    /**
    * The function to download a QR code for a specific short link.
    *
    * @param key The key of the row whose QR code is to be downloaded.
    * @param grid The grid state.
    */
    async function onGetQrCodeClick(key: string, grid: IGridState): Promise<void> {
        const row = grid.rows.find(r => r.idKey === key);
        const shortLink = row?.shortLink;

        if (!shortLink || typeof shortLink !== "string") {
            await alert("Unable to generate the QR code for this short link.");
            return;
        }

        try {
            const qrCodeUrl = `/GetQRCode.ashx?data=${encodeURIComponent(shortLink)}`;
            const response = await fetch(qrCodeUrl);

            if (!response.ok) {
                throw new Error("QR code request failed.");
            }

            const blob = await response.blob();
            const downloadUrl = window.URL.createObjectURL(blob);
            const link = document.createElement("a");
            const fileNameBase = typeof row.token === "string" && row.token ? row.token : key;

            link.href = downloadUrl;
            link.download = `${fileNameBase}-qr-code.png`;
            document.body.appendChild(link);
            link.click();
            link.remove();
            window.URL.revokeObjectURL(downloadUrl);
        }
        catch {
            await alert("Unknown error while trying to download the QR code.");
        }
    }

    /**
    * The function to copy a specific website link to the clipboard.
    *
    * @param key The key of the row whose link is to be copied.
    * @param grid The grid state.
    */
    async function onCopyClick(key: string, grid: IGridState): Promise<void> {
        const row = grid.rows.find(r => r.idKey === key);
        if (row) {
            const shortLink = row.shortLink;
            await navigator.clipboard.writeText(shortLink as string);
            alert("Short link copied to clipboard.");
        }
    }

    /**
    * Called when the grid setting icon is clicked, displays the block filters.
    *
    */
    function onGridSettingsClick(): void {
        isGridSettingsVisible.value = true;
    }

    // #endregion

    watch(gridSettings, async () => {
        preferences.setValue(PreferenceKey.FilterCreatedBy, JSON.stringify(gridSettings.value.createdBy));
        preferences.setValue(PreferenceKey.FilterPerson, JSON.stringify(gridSettings.value.filterPerson));
        preferences.setValue(PreferenceKey.FilterCreatedDateRange, gridSettings.value.createdDateRange ? slidingDateRangeToString(gridSettings.value.createdDateRange) : "");

        await preferences.save();

        gridDataSource.value = loadGridData();
    });

    gridDataSource.value = loadGridData();
</script>
