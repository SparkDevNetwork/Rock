<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <NotificationBox v-if="errorMessage" alertType="warning">
        {{ errorMessage }}
    </NotificationBox>

    <div v-else class="page-builder">
        <aside class="page-builder-sidebar">
            <h5 class="page-builder-sidebar-title">Modules</h5>

            <div class="page-builder-module-types">
                <div v-for="moduleType in moduleTypes"
                     :key="moduleType.key ?? ''"
                     class="page-builder-module-type"
                     @pointerdown="onModuleTypeDragStart($event, moduleType)">
                    <i :class="moduleType.iconCssClass"></i>
                    <span>{{ moduleType.name }}</span>
                </div>
            </div>
        </aside>

        <div class="page-builder-stage">
            <div ref="frameContainerElement" class="page-builder-frame-container">
                <PageFrame :src="targetPageUrl"
                           :moduleTypes="moduleTypes"
                           :dragStartRequest="dragStartRequest"
                           :dragOverRequest="dragOverRequest"
                           :dropRequest="dropRequest"
                           :dragLeaveRequest="dragLeaveRequest"
                           :dragEndRequest="dragEndRequest"
                           :reloadRequest="reloadRequest"
                           :selectRequest="selectRequest"
                           :moduleAddedRequest="moduleAddedRequest"
                           :moduleAddFailedRequest="moduleAddFailedRequest"
                           :moduleContentRequest="moduleContentRequest"
                           :moduleRemoveRequest="moduleRemoveRequest"
                           :moduleMoveFailedRequest="moduleMoveFailedRequest"
                           :pendingBlockId="pendingBlockId"
                           :isBusy="isBuilderBusy"
                           @moduleDropped="onModuleDropped"
                           @moduleMoved="onModuleMoved"
                           @moduleSelected="onModuleSelected"
                           @moduleEditRequested="onModuleEditRequested"
                           @moduleDeleteRequested="onModuleDeleteRequested" />

                <NotificationBox v-if="blockActionErrorMessage"
                                 class="page-builder-alert"
                                 alertType="danger"
                                 dismissible
                                 @dismiss="blockActionErrorMessage = ''">
                    {{ blockActionErrorMessage }}
                </NotificationBox>

                <Overlay :isVisible="isOverlayShown"
                         backgroundColor="transparent"
                         targetSelector=".page-builder-frame-container" />
            </div>
        </div>

        <Sheet v-model="isModuleSheetShown" title="Edit Module" :beforeClose="canLeaveEditedModule">
            <NotificationBox v-if="moduleSheetErrorMessage" alertType="danger">
                {{ moduleSheetErrorMessage }}
            </NotificationBox>

            <LoadingIndicator v-if="isModuleSettingsLoading" />

            <template v-else-if="isModuleSettingsLoaded">
                <Panel v-model="isModuleSettingsExpanded" hasCollapse>
                    <template #title>
                        <span class="page-builder-section-icon"><i class="ti ti-binary-tree"></i></span>
                        Module Settings
                    </template>

                    <RockForm v-model:submit="submitModuleSettings" @submit="onModuleSettingsSubmit">
                        <AttributeValuesContainer v-if="hasModuleAttributes"
                                                  v-model="moduleAttributeValues"
                                                  :attributes="moduleAttributes"
                                                  :disabled="isModuleSaving"
                                                  isEditMode
                                                  :showCategoryLabel="false"
                                                  :numberOfColumns="1" />

                        <p v-else class="text-muted mb-0">This module has no settings.</p>
                    </RockForm>
                </Panel>

                <Panel v-model="isModuleItemsExpanded" hasCollapse>
                    <template #title>
                        <span class="page-builder-section-icon"><i class="ti ti-file-text"></i></span>
                        Module Items
                    </template>

                    <p class="text-muted mb-0">No item settings are available for this module.</p>
                </Panel>

                <Panel v-model="isDisplaySettingsExpanded" hasCollapse>
                    <template #title>
                        <span class="page-builder-section-icon"><i class="ti ti-settings"></i></span>
                        Display Settings
                    </template>

                    <p class="text-muted mb-0">No display settings are available for this module.</p>
                </Panel>
            </template>

            <template #footer>
                <RockButton :btnType="BtnType.Default"
                            :disabled="!isModuleSettingsLoaded || isModuleSaving"
                            :isLoading="isModuleSaving && !isClosingAfterSave"
                            @click="onModuleSaveClick(false)">
                    Save
                </RockButton>

                <RockButton :btnType="BtnType.Primary"
                            :disabled="!isModuleSettingsLoaded || isModuleSaving"
                            :isLoading="isModuleSaving && isClosingAfterSave"
                            @click="onModuleSaveClick(true)">
                    Save and Close
                </RockButton>
            </template>
        </Sheet>
    </div>
</template>

<style scoped>
.page-builder {
    display: flex;
    height: 100%;
}

.page-builder-sidebar {
    flex: 0 0 200px;
    padding: var(--spacing-medium);
    overflow-y: auto;
    border-right: 1px solid var(--color-interface-soft);
}

.page-builder-sidebar-title {
    margin-top: 0;
}

.page-builder-module-types {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-small);
}

.page-builder-module-type {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-tiny);
    aspect-ratio: 1;
    font-size: var(--font-size-small);
    text-align: center;
    cursor: grab;
    user-select: none;
    /* A vertical swipe scrolls the sidebar, so a drag toward the page can start from any other direction. */
    touch-action: pan-y;
    border: 1px solid var(--color-interface-soft);
    border-radius: var(--border-radius-base);
}

.page-builder-module-type i {
    font-size: 20px;
}

.page-builder-module-type:active {
    cursor: grabbing;
    border-color: var(--color-primary);
}

.page-builder-drag-mirror {
    position: absolute;
    z-index: 1060;
    pointer-events: none;
    cursor: grabbing;
    background-color: var(--color-interface-softest);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25), 0 30px 40px rgba(0, 0, 0, 0.1);
    transform: translate(-50%, -50%);
    transition: transform 0.1s ease-in-out;
}

.page-builder-drag-mirror.is-lifted {
    transform: translate(-50%, -50%) rotate(5deg);
}

.page-builder-stage {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    padding: var(--spacing-large);
    background-color: var(--color-interface-softer);
}

.page-builder-frame-container {
    /* Relatively position so the overlay can cover the frame exactly. */
    position: relative;
    height: 100%;
}

.page-builder-alert {
    position: absolute;
    top: var(--spacing-medium);
    right: var(--spacing-medium);
    left: var(--spacing-medium);
}

.page-builder-section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2em;
    height: 2em;
    margin-right: var(--spacing-xsmall);
    color: var(--color-primary);
    background-color: var(--color-primary-soft);
    border-radius: var(--rounded-small);
}

@media (max-width: 767px) {
    .page-builder {
        flex-direction: column;
    }

    .page-builder-sidebar {
        flex: 0 0 auto;
        padding: var(--spacing-small);
        overflow-x: auto;
        overflow-y: hidden;
        border-right: 0;
        border-bottom: 1px solid var(--color-interface-soft);
    }

    .page-builder-sidebar-title {
        margin-bottom: var(--spacing-xsmall);
    }

    .page-builder-module-types {
        grid-template-columns: none;
        grid-auto-flow: column;
        grid-auto-columns: 72px;
    }

    .page-builder-module-type {
        /* The strip scrolls sideways, so a drag down into the page starts from a vertical pull. */
        touch-action: pan-x;
    }

    .page-builder-stage {
        padding: var(--spacing-small);
    }
}
</style>

<script setup lang="ts">
    import { computed, nextTick, ref } from "vue";
    import AttributeValuesContainer from "@Obsidian/Controls/attributeValuesContainer.obs";
    import LoadingIndicator from "@Obsidian/Controls/loadingIndicator.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import Overlay from "@Obsidian/Controls/Internal/overlay.obs";
    import Sheet from "@Obsidian/Controls/Internal/sheet.obs";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { Guid } from "@Obsidian/Types";
    import { createInvokeBlockAction, onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
    import { confirm, confirmDelete } from "@Obsidian/Utility/dialogs";
    import { emptyGuid } from "@Obsidian/Utility/guid";
    import { useHttp } from "@Obsidian/Utility/http";
    import { deepEqual } from "@Obsidian/Utility/util";
    import { PageBuilderAddModuleBag } from "@Obsidian/ViewModels/Blocks/Cms/PageBuilder/pageBuilderAddModuleBag";
    import { PageBuilderAddModuleResponseBag } from "@Obsidian/ViewModels/Blocks/Cms/PageBuilder/pageBuilderAddModuleResponseBag";
    import { PageBuilderInitializationBox } from "@Obsidian/ViewModels/Blocks/Cms/PageBuilder/pageBuilderInitializationBox";
    import { PageBuilderModuleSettingsBag } from "@Obsidian/ViewModels/Blocks/Cms/PageBuilder/pageBuilderModuleSettingsBag";
    import { PageBuilderModuleTypeBag } from "@Obsidian/ViewModels/Blocks/Cms/PageBuilder/pageBuilderModuleTypeBag";
    import { PageBuilderMoveModuleBag } from "@Obsidian/ViewModels/Blocks/Cms/PageBuilder/pageBuilderMoveModuleBag";
    import { ObsidianBlockConfigBag } from "@Obsidian/ViewModels/Cms/obsidianBlockConfigBag";
    import { PublicAttributeBag } from "@Obsidian/ViewModels/Utility/publicAttributeBag";
    import PageFrame from "./pageBuilder/pageFrame.partial.obs";
    import {
        ModuleAddedRequest,
        ModuleAddFailedRequest,
        ModuleContentRequest,
        ModuleDrop,
        ModuleMove,
        ModuleMoveFailedRequest,
        ModuleRemoveRequest,
        ModuleSelectRequest,
        ModuleTypeDragEndRequest,
        ModuleTypeDragLeaveRequest,
        ModuleTypeDragOverRequest,
        ModuleTypeDragStartRequest,
        ModuleTypeDropRequest,
        PageFrameReloadRequest
    } from "./pageBuilder/types.partial";

    const config = useConfigurationValues<PageBuilderInitializationBox>();
    const invokeBlockAction = useInvokeBlockAction();
    const http = useHttp();

    // #region Values

    const errorMessage = config.errorMessage ?? "";
    const targetPageUrl = config.targetPageUrl ?? "";
    const targetPageGuid = config.targetPageGuid ?? null;
    const moduleTypes = config.moduleTypes ?? [];

    const frameContainerElement = ref<HTMLElement | undefined>();
    const isOverlayShown = ref(false);
    const blockActionErrorMessage = ref("");
    const dragStartRequest = ref<ModuleTypeDragStartRequest | null>(null);
    const dragOverRequest = ref<ModuleTypeDragOverRequest | null>(null);
    const dropRequest = ref<ModuleTypeDropRequest | null>(null);
    const dragLeaveRequest = ref<ModuleTypeDragLeaveRequest | null>(null);
    const dragEndRequest = ref<ModuleTypeDragEndRequest | null>(null);
    const reloadRequest = ref<PageFrameReloadRequest | null>(null);
    const selectRequest = ref<ModuleSelectRequest | null>(null);
    const moduleAddedRequest = ref<ModuleAddedRequest | null>(null);
    const moduleAddFailedRequest = ref<ModuleAddFailedRequest | null>(null);
    const moduleContentRequest = ref<ModuleContentRequest | null>(null);
    const moduleRemoveRequest = ref<ModuleRemoveRequest | null>(null);
    const moduleMoveFailedRequest = ref<ModuleMoveFailedRequest | null>(null);
    const selectedBlockId = ref<number | null>(null);
    const pendingBlockId = ref<number | null>(null);
    const isAddingModule = ref(false);

    const isModuleSheetShown = ref(false);
    const editingBlockId = ref<number | null>(null);
    const editingBlockGuid = ref<Guid | null>(null);
    const moduleAttributes = ref<Record<string, PublicAttributeBag>>({});
    const moduleAttributeValues = ref<Record<string, string>>({});
    const savedModuleAttributeValues = ref<Record<string, string>>({});
    const isModuleSettingsLoading = ref(false);
    const isModuleSettingsLoaded = ref(false);
    const isModuleSaving = ref(false);
    const isClosingAfterSave = ref(false);
    const moduleSheetErrorMessage = ref("");
    const submitModuleSettings = ref(false);
    const isModuleSettingsExpanded = ref(true);
    const isModuleItemsExpanded = ref(true);
    const isDisplaySettingsExpanded = ref(true);

    // #endregion Values

    // #region Computed Values

    const hasModuleAttributes = computed((): boolean => Object.keys(moduleAttributes.value).length > 0);

    const isModuleSettingsDirty = computed((): boolean => !deepEqual(moduleAttributeValues.value, savedModuleAttributeValues.value, true));

    /** Whether a change to the page is waiting on the server, which locks the builder until it is confirmed. */
    const isBuilderBusy = computed((): boolean => pendingBlockId.value !== null || isAddingModule.value);

    // #endregion Computed Values

    // #region Event Handlers

    /*
        09/23/26 - JMH

        Pointer events do not cross into the iframe, so the page frame never sees the drag directly.
        Instead the pointer is captured by the tile being dragged, the parent page translates each
        move into frame coordinates, and each step is handed to the frame as a request. The frame
        resolves the drop target from its own DOM. A transparent overlay also covers the frame for
        the duration so the framed page cannot react to the pointer.

        Pointer events are used rather than native drag and drop for two reasons. The browser's
        native drag image cannot be styled, so it cannot show the tilted copy of the tile. And a
        touch drag keeps sending its events to the element where it started, so hit testing has to
        run from the captured pointer rather than from events on the overlay.

        Reason: A drag in the parent page cannot target elements inside an iframe, with a mouse or with touch.
    */
    function onModuleTypeDragStart(event: PointerEvent, moduleType: PageBuilderModuleTypeBag): void {
        // Only the primary button of the first pointer starts a drag, and not while a change is waiting on the server.
        if (!event.isPrimary || event.button !== 0 || isBuilderBusy.value) {
            return;
        }

        event.preventDefault();

        const tileElement = event.currentTarget as HTMLElement;
        const pointerId = event.pointerId;
        const dragMirrorElement = createDragMirror(tileElement, event);
        const previousCursor = document.body.style.cursor;
        let isOverFrame = false;

        try {
            tileElement.setPointerCapture(pointerId);
        }
        catch {
            // Intentionally ignored: capture fails if the pointer is already gone, and the
            // overlay still keeps mouse events out of the frame without it.
        }

        document.body.style.cursor = "grabbing";

        function onPointerMove(moveEvent: PointerEvent): void {
            if (moveEvent.pointerId !== pointerId) {
                return;
            }

            dragMirrorElement.style.left = `${moveEvent.pageX}px`;
            dragMirrorElement.style.top = `${moveEvent.pageY}px`;

            const framePoint = getFramePoint(moveEvent);

            if (framePoint) {
                isOverFrame = true;
                dragOverRequest.value = framePoint;
            }
            else if (isOverFrame) {
                isOverFrame = false;
                dragLeaveRequest.value = { type: "MODULE_TYPE_DRAG_LEAVE_REQUEST" };
            }
        }

        async function onPointerUp(upEvent: PointerEvent): Promise<void> {
            if (upEvent.pointerId !== pointerId) {
                return;
            }

            window.removeEventListener("pointermove", onPointerMove);
            window.removeEventListener("pointerup", onPointerUp);
            window.removeEventListener("pointercancel", onPointerUp);

            dragMirrorElement.remove();
            document.body.style.cursor = previousCursor;
            isOverlayShown.value = false;

            // A cancelled pointer, such as a touch the browser turned into a scroll, never drops.
            const dropPoint = upEvent.type === "pointerup" ? getFramePoint(upEvent) : null;

            if (dropPoint) {
                dropRequest.value = dropPoint;
            }

            // Waiting a tick guarantees the frame handles the drop before this ends the drag.
            await nextTick();
            dragEndRequest.value = { type: "MODULE_TYPE_DRAG_END_REQUEST" };
        }

        window.addEventListener("pointermove", onPointerMove);
        window.addEventListener("pointerup", onPointerUp);
        window.addEventListener("pointercancel", onPointerUp);

        isOverlayShown.value = true;
        dragStartRequest.value = { moduleType };
    }

    /**
     * Adds a dropped module to the page in a new Canvas block, which the frame
     * shows as a placeholder until the target page has rendered it. Then it is
     * selected and the sheet opens on it, unless the person keeps unsaved
     * changes to the module already in the sheet.
     */
    async function onModuleDropped(drop: ModuleDrop): Promise<void> {
        blockActionErrorMessage.value = "";
        isAddingModule.value = true;

        const bag: PageBuilderAddModuleBag = {
            zoneName: drop.zoneName,
            moduleTypeKey: drop.moduleType.key,
            beforeBlockId: drop.beforeBlockId
        };

        const result = await invokeBlockAction<PageBuilderAddModuleResponseBag>("AddModule", { bag });

        if (!result.isSuccess || !result.data) {
            isAddingModule.value = false;
            moduleAddFailedRequest.value = { type: "MODULE_ADD_FAILED_REQUEST" };
            blockActionErrorMessage.value = result.errorMessage || `The ${drop.moduleType.name} module could not be added.`;
            return;
        }

        const { blockId, blockGuid } = result.data;
        const html = await getRenderedModuleHtml(blockGuid);

        isAddingModule.value = false;

        // The module was added either way, so a reload shows it when its HTML could not be rendered.
        if (html === null) {
            reloadRequest.value = { type: "PAGE_FRAME_RELOAD_REQUEST" };
        }
        else {
            moduleAddedRequest.value = { blockId, blockGuid, html };
        }

        if (!await canLeaveEditedModule()) {
            return;
        }

        selectRequest.value = { blockId };

        await openModuleSheet(blockId);
    }

    /**
     * Saves a module's new position after it was dragged by its handle. The
     * frame already shows it there, so only a move the server rejects changes
     * the page, putting the module back.
     */
    async function onModuleMoved(move: ModuleMove): Promise<void> {
        blockActionErrorMessage.value = "";
        pendingBlockId.value = move.blockId;

        const bag: PageBuilderMoveModuleBag = {
            blockId: move.blockId,
            zoneName: move.zoneName,
            beforeBlockId: move.beforeBlockId
        };

        const result = await invokeBlockAction("MoveModule", { bag });

        pendingBlockId.value = null;

        if (!result.isSuccess) {
            moduleMoveFailedRequest.value = { type: "MODULE_MOVE_FAILED_REQUEST" };
            blockActionErrorMessage.value = result.errorMessage || "The module could not be moved.";
        }
    }

    /**
     * Moves an open sheet to the module that was selected, asking first when
     * that would discard unsaved changes.
     */
    async function onModuleSelected(blockId: number | null): Promise<void> {
        selectedBlockId.value = blockId;

        // Clearing the selection, which a frame reload also does, leaves the sheet where it is.
        if (!isModuleSheetShown.value || blockId === null || blockId === editingBlockId.value) {
            return;
        }

        if (!await canLeaveEditedModule()) {
            // Selecting the module in the sheet again keeps the selection and the sheet in agreement.
            if (editingBlockId.value !== null) {
                selectRequest.value = { blockId: editingBlockId.value };
            }

            return;
        }

        await openModuleSheet(blockId);
    }

    /**
     * Opens the sheet on the module whose edit control was clicked.
     */
    async function onModuleEditRequested(blockId: number): Promise<void> {
        if (isModuleSheetShown.value && blockId === editingBlockId.value) {
            return;
        }

        if (await canLeaveEditedModule()) {
            await openModuleSheet(blockId);
        }
    }

    /**
     * Deletes a Canvas block and its module after confirming. The module shows
     * as pending until the server confirms, then comes off the page.
     */
    async function onModuleDeleteRequested(blockId: number): Promise<void> {
        if (isBuilderBusy.value || !await confirmDelete("module")) {
            return;
        }

        blockActionErrorMessage.value = "";
        pendingBlockId.value = blockId;

        const result = await invokeBlockAction("DeleteModule", { blockId });

        pendingBlockId.value = null;

        if (!result.isSuccess) {
            blockActionErrorMessage.value = result.errorMessage || "The module could not be deleted.";
            return;
        }

        if (editingBlockId.value === blockId) {
            isModuleSheetShown.value = false;
            editingBlockId.value = null;
            isModuleSettingsLoaded.value = false;
        }

        moduleRemoveRequest.value = { blockId };
    }

    /**
     * Validates and saves the module's settings, then closes the sheet when
     * asked to.
     */
    function onModuleSaveClick(isClosing: boolean): void {
        isClosingAfterSave.value = isClosing;
        submitModuleSettings.value = true;
    }

    /**
     * Saves the module's settings once they pass validation. The module shows
     * as pending until the target page has rendered it with them, and then
     * only that module changes.
     */
    async function onModuleSettingsSubmit(): Promise<void> {
        const blockId = editingBlockId.value;
        const blockGuid = editingBlockGuid.value;

        if (blockId === null) {
            return;
        }

        moduleSheetErrorMessage.value = "";
        isModuleSaving.value = true;
        pendingBlockId.value = blockId;

        const attributeValues = { ...moduleAttributeValues.value };
        const bag: PageBuilderModuleSettingsBag = {
            blockId,
            blockGuid: blockGuid ?? emptyGuid,
            attributeValues
        };

        const result = await invokeBlockAction("SaveModuleSettings", { bag });

        if (!result.isSuccess) {
            isModuleSaving.value = false;
            pendingBlockId.value = null;
            moduleSheetErrorMessage.value = result.errorMessage || "The module's settings could not be saved.";
            return;
        }

        savedModuleAttributeValues.value = attributeValues;

        if (isClosingAfterSave.value) {
            isModuleSheetShown.value = false;
        }

        const html = blockGuid ? await getRenderedModuleHtml(blockGuid) : null;

        isModuleSaving.value = false;
        pendingBlockId.value = null;

        // The settings were saved either way, so a reload shows them when the module could not be rendered.
        if (html === null) {
            reloadRequest.value = { type: "PAGE_FRAME_RELOAD_REQUEST" };
        }
        else {
            moduleContentRequest.value = { blockId, html };
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Opens the sheet on a module and loads its settings into it.
     */
    async function openModuleSheet(blockId: number): Promise<void> {
        editingBlockId.value = blockId;
        editingBlockGuid.value = null;
        moduleAttributes.value = {};
        moduleAttributeValues.value = {};
        savedModuleAttributeValues.value = {};
        moduleSheetErrorMessage.value = "";
        isModuleSettingsLoaded.value = false;
        isModuleSettingsLoading.value = true;
        isModuleSheetShown.value = true;

        const result = await invokeBlockAction<PageBuilderModuleSettingsBag>("GetModuleSettings", { blockId });

        // The sheet may have moved on to another module while these settings loaded.
        if (editingBlockId.value !== blockId) {
            return;
        }

        isModuleSettingsLoading.value = false;

        if (!result.isSuccess || !result.data) {
            moduleSheetErrorMessage.value = result.errorMessage || "The module's settings could not be loaded.";
            return;
        }

        editingBlockGuid.value = result.data.blockGuid;
        moduleAttributes.value = result.data.attributes ?? {};
        moduleAttributeValues.value = result.data.attributeValues ?? {};
        isModuleSettingsLoaded.value = true;

        // Field editors can normalize a value as they mount, so the unsaved changes baseline waits for them.
        await nextTick();
        savedModuleAttributeValues.value = { ...moduleAttributeValues.value };
    }

    /**
     * Checks whether the sheet can move off the module it shows, asking first
     * when that would discard unsaved changes.
     */
    async function canLeaveEditedModule(): Promise<boolean> {
        if (!isModuleSheetShown.value) {
            return true;
        }

        // The sheet stays on a module until its save finishes.
        if (isModuleSaving.value) {
            return false;
        }

        if (!isModuleSettingsDirty.value) {
            return true;
        }

        return await confirm("Changes have been made that have not yet been saved. Do you want to leave without saving?");
    }

    /*
        09/24/26 - JMH

        A Canvas block renders its module's HTML in its own RefreshObsidianBlockInitialization action,
        the one Rock's block reload calls, so asking the block for it renders just that module, with
        its Lava in the target page's context. Rock only reloads a block itself from the Block
        Properties dialog, through a WebForms trigger that also posts back the whole page, so the
        builder calls the action directly and places the HTML itself.

        Reason: Updates one module in place without reloading the page.
    */
    async function getRenderedModuleHtml(blockGuid: Guid): Promise<string | null> {
        if (!targetPageGuid) {
            return null;
        }

        const invokeCanvasBlockAction = createInvokeBlockAction(http.post, targetPageGuid, blockGuid, {}, emptyGuid, emptyGuid);
        const result = await invokeCanvasBlockAction<ObsidianBlockConfigBag>("RefreshObsidianBlockInitialization");

        return result.isSuccess && result.data ? result.data.initialContent ?? "" : null;
    }

    /**
     * Creates the copy of a module type tile that follows the pointer while
     * dragging, centered on the pointer.
     */
    function createDragMirror(tileElement: HTMLElement, event: PointerEvent): HTMLElement {
        const tileRect = tileElement.getBoundingClientRect();
        const dragMirrorElement = tileElement.cloneNode(true) as HTMLElement;

        dragMirrorElement.classList.add("page-builder-drag-mirror");
        dragMirrorElement.style.width = `${tileRect.width}px`;
        dragMirrorElement.style.height = `${tileRect.height}px`;
        dragMirrorElement.style.left = `${event.pageX}px`;
        dragMirrorElement.style.top = `${event.pageY}px`;

        document.body.appendChild(dragMirrorElement);

        // Applied after the copy is in the page so the tilt animates.
        setTimeout(() => dragMirrorElement.classList.add("is-lifted"), 0);

        return dragMirrorElement;
    }

    /**
     * Converts a pointer position to coordinates relative to the page frame,
     * or returns null when the pointer is outside it.
     */
    function getFramePoint(event: PointerEvent): ModuleTypeDragOverRequest | null {
        if (!frameContainerElement.value) {
            return null;
        }

        const frameRect = frameContainerElement.value.getBoundingClientRect();
        const isInsideFrame = event.clientX >= frameRect.left
            && event.clientX <= frameRect.right
            && event.clientY >= frameRect.top
            && event.clientY <= frameRect.bottom;

        if (!isInsideFrame) {
            return null;
        }

        return {
            clientX: event.clientX - frameRect.left,
            clientY: event.clientY - frameRect.top
        };
    }

    // #endregion Functions

    onConfigurationValuesChanged(useReloadBlock());
</script>
