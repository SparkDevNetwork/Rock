{% comment %}{% include '~~/Assets/Lava/StyleGuide/Components/typography-and-colors.lava' %}{%endcomment%}

{%- capture codeOpen -%}<figure><pre><code>{%- endcapture -%}
{%- capture codeClose %}</code></pre></figure>{%- endcapture -%}

{% comment %} ~ Capture Headers and Subheaders Section {% endcomment %}

{% capture headersAndSubheaders %}
<h1 class="display mb-3">This is an H1 Display</h1>

<h2 class="display mb-3">This is an H2 Display</h2>

<h3 class="display mb-3">This is an H3 Display</h3>

<h1 class="mb-3">H1 - This is a Header</h1>

<h2 class="mb-3">H2 - This is a Header</h2>

<h3 class="mb-3">H3 - This is a Header</h3>

<h4 class="mb-3">H4 - This is a SubHeader</h4>

<h5 class="mb-3">H5 - This is a SubHeader</h5>

<h6>H6 - This is a SubHeader</h6>
{% endcapture %}

{% capture headersAndSubheadersEscaped %}
{{ codeOpen }}<blockquote class="mb-0">Header and Subheader Text</blockquote>
{{ headersAndSubheaders | Escape }}
{{ codeClose }}
{% endcapture %}



{% comment %} ~ Capture Body and Blockquotes Section {% endcomment %}

{% capture bodyAndBlockquotes %}
<p class="lead"><strong>Lead: 22px</strong> - Lorem ipsum dolor sit amet, incididunt <strong>ut labore et</strong> dolore magna aliqua. Ut enim ad <a href="#">minim veniam</a>, quis nostrud exercitation.</p>

<p><strong>Body 18px</strong> - Lorem ipsum dolor sit amet, incididunt <strong>ut labore et</strong> dolore magna aliqua. Ut enim ad <a href="#">minim veniam</a>, quis nostrud exercitation.</p>

<p class="small"><strong>Small 16px</strong> - Lorem ipsum dolor sit amet, incididunt <strong>ut labore et</strong> dolore magna aliqua. Ut enim ad <a href="#">minim veniam</a>, quis nostrud exercitation.</p>

<blockquote>
  <span>Source Name - Lorem ipsum dolor sit amet, consectetur adipiscing elit.</span>
  <footer class="mb-0">Someone famous in <cite title="Source Title">Source Title</cite></footer>
</blockquote>

<div class="bg-advantage-dark text-white p-3">
  <blockquote>
    <p>We believe the Bible teaches that the church and the family are called to work together to see our kids come to faith </p>
  </blockquote>
</div>
{% endcapture %}

{% capture bodyAndBlockquotesEscaped %}
  {{ codeOpen }}<blockquote class="mb-0">Body Text and Blockquotes</blockquote>
  {{ bodyAndBlockquotes | Escape }}
  {{ codeClose }}
{% endcapture %}

{% comment %} ~ Capture Text Colors Section {% endcomment %}

{% capture textColors %}
<div class="text-advantage-orange mb-3">This is an example of the <code>.text-advantage-orange</code> class</div>
<div class="text-advantage-blue mb-3">This is an example of the <code>.text-advantage-blue</code> class</div>
<div class="text-muted mb-3">This is an example of the <code>.text-muted</code> class</div>
<div class="bg-advantage-blue p-3">
  <div class="text-white mb-3">This is an example of the <code>.text-white</code> class</div>
</div>
{% endcapture %}

{% capture textColorsEscaped %}
  {{ codeOpen }}<blockquote class="mb-0">Text Colors</blockquote>
  {{ textColors | Escape }}
  {{ codeClose }}
{% endcapture %}





{% comment %} ~ Capture Background Colors Section {% endcomment %}

{% capture backgroundColors %}
<div class="row d-flex flex-wrap">
  <div class="col-xs-12 col-sm-6">
    <div class="h-100 d-flex flex-column">
      <div class="flex-fill mt-3">This is an example of the <code>.bg-advantage-blue</code> class</div>
      <div class="bg-advantage-blue" style="height: 64px;"></div>
    </div>
  </div>
  <div class="col-xs-12 col-sm-6">
    <div class="h-100 d-flex flex-column">
      <div class="flex-fill mt-3">This is an example of the <code>.bg-advantage-orange</code> class</div>
      <div class="bg-advantage-orange" style="height: 64px;"></div>
    </div>
  </div>

  <div class="col-xs-12 col-sm-6">
    <div class="h-100 d-flex flex-column">
      <div class="flex-fill mt-3">This is an example of the <code>.bg-advantage-light</code> class</div>
      <div class="bg-advantage-light" style="height: 64px;"></div>
    </div>
  </div>

  <div class="col-xs-12 col-sm-6">
    <div class="h-100 d-flex flex-column">
      <div class="flex-fill mt-3">This is an example of the <code>.bg-advantage-dark</code> class</div>
      <div class="bg-advantage-dark" style="height: 64px;"></div>
    </div>

  </div>
{% endcapture %}

{% capture backgroundColorsEscaped %}
  {{codeOpen}}<blockquote class="mb-0">Background Colors</blockquote>
  {{ backgroundColors | Escape }}
  {{ codeClose }}
{% endcapture %}

{% comment %} ~ Print sections {% endcomment %}

<h3 class="sg-section-header">Headers and Subheaders</h3>
{{ headersAndSubheaders }}
{{ headersAndSubheadersEscaped }}

<hr class="my-5">

<h3 class="sg-section-header">Body Text and Blockquotes</h3>
{{ bodyAndBlockquotes }}
{{ bodyAndBlockquotesEscaped }}

<hr class="my-5">

<h3 class="sg-section-header">Text Colors</h3>
{{ textColors }}
{{ textColorsEscaped }}

<hr class="my-5">

<h3 class="sg-section-header">Background Colors</h3>
{{ backgroundColors }}
{{ backgroundColorsEscaped }}
