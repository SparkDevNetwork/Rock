//- Appendeed selector name generated by the content collection filter name
{% assign jsPrimarySelectorName = PrimaryFilterName | Default:'category' %}
{% assign jsSecondarySelectorName = SecondaryFilterName | Default:'topic' %}

//- Sets category if parameter exists in url
{% if PageParameter.category and PageParameter.category != empty %}
    {% assign parameter = PageParameter.category %}
{% else %}
    {% assign parameter = '' %}
{% endif %}

<script>
     $(window).on('load', function() {
      // Mapping GUIDs to arrays of corresponding filter-{{ jsSecondarySelectorName }} IDs
      var guidToIdMap = {
        {%- definedvalue where:'DefinedTypeId == 147' iterator:'Topics' securityenabled:'false' -%}
            {%- assign sortedTopics = Topics | SortByAttribute:'Category1' -%}
            {%- assign categoryGuid = '' -%}
            {%- for item in sortedTopics -%}
                {%- if forloop.first -%}
                    {%- assign categoryGuid = item | Attribute:'Category1','RawValue' -%}
                    '{{ categoryGuid }}': [
                {%- endif -%}
                {%- unless forloop.first -%}
                    {%- assign nextCategoryGuid = item | Attribute:'Category1','RawValue' -%}
                    {%- if categoryGuid != nextCategoryGuid -%}
                        {%- assign categoryGuid = item | Attribute:'Category1','RawValue' -%}
                        ],
                        '{{ categoryGuid }}': [
                    {%- endif %}
                {%- endunless -%}
                '{{ item.Id }}'{%- if forloop.first -%},{% endif %}{%- unless categoryGuid != nextCategoryGuid -%},{%- endunless -%}
                {%- if forloop.last %}]{% endif -%}
            {%- endfor -%}
        {%- enddefinedvalue -%}
      };

      // Set the initial GUID (if one is provided)
      var initialGuid = '{{ parameter }}'; // Change this to the desired initial GUID

      // Function to trigger click on .filter-{{ jsSecondarySelectorName }} radio input with "All" label-text
      function clickFilterTopicAll() {
        $('.filter-{{ jsSecondarySelectorName }} .radio-inline').each(function() {
          if ($(this).find('.label-text').text() === 'All') {
            $(this).find('input').trigger('click'); // Click and check the input
          }
        });
      }

      // When any radio input inside .filter-{{ jsPrimarySelectorName }} is clicked
      $('.filter-{{ jsPrimarySelectorName }} .radio-inline input').on('click', function() {
        // Get the GUID value of the clicked radio input
        var selectedGuid = $(this).val();

        // Check if the label text is "All"
        var isAllSelected = $(this).siblings('.label-text').text() === 'All';

        // Trigger a click on the .filter-{{ jsSecondarySelectorName }} radio input with label-text "All"
        clickFilterTopicAll();

        if (isAllSelected) {
          // Remove both 'd-none' and 'd-inline-block' classes from all filter-{{ jsSecondarySelectorName }} radio inputs
          $('.filter-{{ jsSecondarySelectorName }} .radio-inline').removeClass('d-none d-inline-block');
        } else {
          // Get the corresponding array of IDs from the map
          var relatedIds = guidToIdMap[selectedGuid];

          // Loop through all radio inputs inside .filter-{{ jsSecondarySelectorName }}
          $('.filter-{{ jsSecondarySelectorName }} .radio-inline').each(function() {
            var inputValue = $(this).find('input').val();

            // If the label-text is "All", do not add/remove classes
            if ($(this).find('.label-text').text() === 'All') {
              return;
            }

            // If the value matches one of the related IDs, show it; otherwise, hide it
            if (relatedIds && relatedIds.includes(inputValue)) {
              $(this).removeClass('d-none').addClass('d-inline-block');
            } else {
              $(this).removeClass('d-inline-block').addClass('d-none');
            }
          });
        }
      });

      // If an initial GUID is provided, trigger click on the corresponding filter-{{ jsPrimarySelectorName }} radio input
      if (initialGuid) {
        $('.filter-{{ jsPrimarySelectorName }} .radio-inline input').each(function() {
          if ($(this).val() === initialGuid) {
            $(this).prop('checked', true).trigger('click');
          }
        });
      }
    });
</script>
