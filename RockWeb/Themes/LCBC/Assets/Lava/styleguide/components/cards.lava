<div class="card mb-4" id="card-horizontal">
    <div class="card-header">
        <h4 class="m-0">Card Horizontal</h4>
    </div>
    <div class="card-body">
        <div class="alert alert-default">Use <code>card-footer card-footer-centered</code> to vertically center footer buttons with <code>card-horizontal</code>.</div>
        {{ codeMarkup }}
    </div>
    <div class="card-footer">
        <pre><code>{{ codeMarkup | Trim | Escape }}</code></pre>
    </div>
</div>

{% capture codeMarkup %}
<div class="row g g-4">
    <div class="col-xs-12">
        <div class="card card-transparent card-horizontal">
            <div class="card-img-header">
                <img src="https://via.placeholder.com/426x213" alt="" class="card-img-top img-responsive">
            </div>
            <div class="card-body">
                <h3 class="card-title">Worship In-Person</h3>
                <p class="card-text">Check in your child safely right here and we’ll take care of the rest. Check in your child safely right here and we’ll take care of the rest. Check in your child safely right here and we’ll take care of the rest.</p>
            </div>
        </div>
    </div>

    <div class="col-xs-12">
