<div class="card mb-4" id="card-horizontal-transparent">
    <div class="card-header">
        <h4 class="m-0">Card Horizontal Transparent</h4>
    </div>
    <div class="card-body">
        {{ codeMarkup }}
    </div>
    <div class="card-footer">
        <pre><code>{{ codeMarkup | Trim | Escape }}</code></pre>
    </div>
</div>


<div class="card mb-4" id="eventfeature">
    <div class="card-header">
        <h4 class="m-0">Event Feature</h4>
    </div>
    <div class="card-body">
        /- Event Example -/
        {% capture codeMarkup %}
        <div class="row d-flex flex-wrap">
            {% for i in (1..3) %}
                <div class="col-md-4 col-xs-12 mb-5">
                    <div class="card card-event h-100">
                        <div class="card-header">
                            <h6 class="card-title">Berks</h6>
                        </div>
                        <div class="card-body">
                            <span class="d-block h6 mt-0">Contact Details</span>

                            <div class="text-sm">
                                Justin Ashcraft
                                <a href="mailto:justinashcraft@lcbcchurch.com">justinashcraft@lcbcchurch.com</a>
                                {% if forloop.first %}
                                Lorem ipsum dolor sit amet consectetur adipisicing elit. Assumenda alias, nulla qui veniam aut laborum laudantium placeat quo sunt quibusdam eos modi tempora. Recusandae quae asperiores voluptatibus voluptas saepe hic!
                                {% endif %}
                            </div>
                        </div>

                        <div class="card-cell">
                            <div><i class="fa fa-map-marker"></i> Atrium</div>
                            <div><i class="fa fa-calendar"></i> 12/4/2022 9:00AM</div>
                            <div><i class="fa fa-child"></i> kidCare</div>
                        </div>

                        {% if true %}
                            <div class="card-footer">
                                <a href="#" class="btn btn-primary btn-block">Register</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
        {% endcapture %}
        /- EndEventExample -/
        <div class="bg-black p-4">{{ codeMarkup }}</div>
    </div>
</div>




<script>
    var swiper = new Swiper(".campus-swiper", {
      lazy: true,
      loop: true,
      pagination: {
        el: ".swiper-pagination",
        clickable: true
      },
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
    });
  </script>
