/- {% include '~~/Assets/Lava/styleguide/components/cards.lava' %} -/


<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css"
  />

  <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>

{% include '~~/Assets/Images/campus-symbols.svg' %}

{% capture cardMarkup %}
<div class="card h-100">
    <div class="card-img-header">
        <img src="https://via.placeholder.com/491x180" alt="" class="card-img-top img-responsive">
    </div>
    <div class="card-body">
        <h3 class="card-title">Card Title</h3>
        <div class="card-text">Lorem ipsum dolor, sit amet consectetur adipisicing elit. Laborum excepturi fuga hic, aut expedita molestias illo dolorum!</div>
    </div>
    <div class="card-footer">
        <a href="#" class="btn btn-sm btn-primary">More Info</a>
        <a href="#" class="btn btn-sm btn-action">Register</a>
    </div>
</div>
{% endcapture %}


<h1>Cards</h1>
<h6>Styles</h6>
<ul class="nav nav-pills mb-4">
        <li><a href="#standard">Standard</a></li>
        <li><a href="#transparent">Transparent</a></li>
        <li><a href="#shadow">Shadow</a></li>
        <li><a href="#map">Map</a></li>
        <li><a href="#campus">Campus</a></li>
</ul>

<h6>Formats</h6>
<ul class="nav nav-pills mb-4">
        <li><a href="#card-horizontal">Card Horizontal</a></li>
</ul>

<h6>In Use</h6>
<ul class="nav nav-pills mb-4">
        <li><a href="#eventfeature">Event Feature</a></li>
</ul>



<div class="card mb-4" id="standard">
    <div class="card-header">
        <h4 class="m-0">Standard</h4>
    </div>
    <div class="card-body">
        <div class="row g">
            {% for i in (1..2) %}
                <div class="col-xs-12 col-sm-6 mb-4">
                    {{ cardMarkup }}
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="card-footer">
        <pre><code>{{ cardMarkup | Trim | Escape }}</code></pre>
    </div>
</div>


{% capture codeMarkup %}
<div class="row g">
    <div class="col-xs-12 col-md-6">
        <div class="card card-transparent h-100">
            <div class="card-img-header">
                <img src="https://via.placeholder.com/426x213" alt="" class="card-img-top img-responsive">
            </div>
            <div class="card-body">
                <h3 class="card-title">Worship In-Person</h3>
                <p class="card-text">Check in your child safely right here and we’ll take care of the rest</p>
            </div>
            <div class="card-footer">
                <a href="#" class="btn btn-sm btn-primary">Worship In-Person</a>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-md-6"></div>
</div>
{% endcapture %}

<div class="card mb-4" id="transparent">
    <div class="card-header">
        <h4 class="m-0">Transparent</h4>
    </div>
    <div class="card-body">
        {{ codeMarkup }}
    </div>
    <div class="card-footer">
        <pre><code>{{ codeMarkup | Trim | Escape }}</code></pre>
    </div>
</div>


{% capture codeMarkup %}
