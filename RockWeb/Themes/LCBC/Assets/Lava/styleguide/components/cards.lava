{% capture codeMarkup %}
<div class="row g g-4">
    <div class="col-xs-12 col-md-6">
        <div class="card card-map h-100">
            <div class="card-body d-flex flex-row align-items-start">
                <img src="{{ '~~/Assets/Images/icons/campus.svg' | ResolveRockUrl }}" class="flex-shrink-0 mr-3">
                <div>
                    <h3 class="h6 card-title mb-2">Waynesboro Campus</h3>
                    <div class="card-text">
                        4686 US Route 209<br>
                        Elizabethville, PA 17023 in Lykens Valley Plaza<br><br>

                        <a href="#">717-921-5977</a>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a href="#" class="btn btn-primary btn-sm"><span class="icon-alignment">
                    <svg class="icon"><use xlink:href="#info" /></svg> Details
                </span></a>
                <a href="#" class="btn btn-default btn-sm"><span class="icon-alignment">
                    <svg class="icon"><use xlink:href="#envelope" /></svg> Send Email
                </span></a>
                <a href="#" class="btn btn-default btn-sm"><span class="icon-alignment">
                    <svg class="icon"><use xlink:href="#info" /></svg> Directions
                </span></a>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-md-6">
        <div class="card card-map h-100">
            <div class="card-body d-flex flex-row align-items-start">
                <img src="{{ '~~/Assets/Images/icons/gathering.svg' | ResolveRockUrl }}" class="flex-shrink-0 mr-3">
                <div>
                    <h3 class="h6 card-title mb-2">Coal Township Community Gathering</h3>
                    <div class="card-text">
                        4686 US Route 209<br>
                        Elizabethville, PA 17023 in Lykens Valley Plaza<br><br>

                        <a href="#">717-921-5977</a>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a href="#" class="btn btn-primary btn-sm"><span class="icon-alignment">
                    <svg class="icon"><use xlink:href="#info" /></svg> Details
                </span></a>
                <a href="#" class="btn btn-default btn-sm"><span class="icon-alignment">
                    <svg class="icon"><use xlink:href="#envelope" /></svg> Send Email
                </span></a>
                <a href="#" class="btn btn-default btn-sm"><span class="icon-alignment">
                    <svg class="icon"><use xlink:href="#info" /></svg> Directions
                </span></a>
            </div>
        </div>
    </div>
</div>
{% endcapture %}

<div class="card mb-4" id="map">
    <div class="card-header">
        <h4 class="m-0">Map</h4>
    </div>
    <div class="card-body">
        {{ codeMarkup }}
    </div>
    <div class="card-footer">
        <pre><code>{{ codeMarkup | Trim | Escape }}</code></pre>
    </div>
</div>


{% capture codeMarkup %}
<div class="row g g-3">
    <div class="col-xs-12">
        <div class="card card-shadow card-campus card-horizontal h-100">
            <div class="card-img-header">
                <img src="https://swiperjs.com/demos/images/nature-1.jpg" class="w-100 h-100" />
            </div>
            <div class="card-body">
                <h4 class="card-title my-0">LCBC Online</h4>
                <span class="d-block text-primary">No Matter Where You Are</span>
                <div class="card-text">
                    Saturdays: 4pm, & 6pm<br>
                    Sundays: 9am, 10:45am, 1pm, 3pm, 5pm, 7pm, 9pm, & 11pm<br>
                    Mondays: 6:30pm, 9pm, & 11pm
                </div>
            </div>
            <div class="card-footer">
                <a href="#" class="btn btn-sm btn-primary btn-square">
                    <svg class="icon"><use xlink:href="#monitor" /></svg>
                </a>
            </div>
        </div>
    </div>

    <div class="col-xs-12">
        <div class="card card-shadow card-campus card-horizontal h-100">
            <div class="card-img-header">
                <div class="swiper campus-swiper">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <img src="https://swiperjs.com/demos/images/nature-1.jpg" loading="lazy" />
                            <div class="swiper-lazy-preloader swiper-lazy-preloader-white"></div>
                          </div>
                          <div class="swiper-slide">
                            <img src="https://swiperjs.com/demos/images/nature-2.jpg" loading="lazy" />
                            <div class="swiper-lazy-preloader swiper-lazy-preloader-white"></div>
                          </div>
                          <div class="swiper-slide">
                            <img src="https://swiperjs.com/demos/images/nature-3.jpg" loading="lazy" />
                            <div class="swiper-lazy-preloader swiper-lazy-preloader-white"></div>
                          </div>
                          <div class="swiper-slide">
                            <img src="https://swiperjs.com/demos/images/nature-4.jpg" loading="lazy" />
                            <div class="swiper-lazy-preloader swiper-lazy-preloader-white"></div>
                          </div>
                          <div class="swiper-slide">
                            <img src="https://swiperjs.com/demos/images/nature-5.jpg" loading="lazy" />
                            <div class="swiper-lazy-preloader swiper-lazy-preloader-white"></div>
                          </div>
                    </div>
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-pagination"></div>
                  </div>
            </div>
            <div class="card-body">
                <h4 class="card-title my-0">Berks Campus</h4>
                <div class="card-text">
                    Sundays: 9am, 10:45am
                </div>

                <div class="card-details">40.4 miles away</div>
            </div>
            <div class="card-footer">
                <a href="#" class="btn btn-sm btn-action btn-square">
                    <svg class="icon"><use xlink:href="#info" /></svg>
                </a>
                <a href="#" class="btn btn-sm btn-action btn-square">
                    <svg class="icon"><use xlink:href="#campus" /></svg>
                </a>
            </div>
        </div>
    </div>

    <div class="col-xs-12">
        <div class="card card-shadow card-campus card-horizontal h-100">
            <div class="card-img-header">
                <div class="swiper campus-swiper">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <img src="https://swiperjs.com/demos/images/nature-1.jpg" loading="lazy" />
                            <div class="swiper-lazy-preloader swiper-lazy-preloader-white"></div>
                          </div>
                          <div class="swiper-slide">
                            <img src="https://swiperjs.com/demos/images/nature-2.jpg" loading="lazy" />
                            <div class="swiper-lazy-preloader swiper-lazy-preloader-white"></div>
                          </div>
                          <div class="swiper-slide">
                            <img src="https://swiperjs.com/demos/images/nature-3.jpg" loading="lazy" />
                            <div class="swiper-lazy-preloader swiper-lazy-preloader-white"></div>
                          </div>
                          <div class="swiper-slide">
                            <img src="https://swiperjs.com/demos/images/nature-4.jpg" loading="lazy" />
                            <div class="swiper-lazy-preloader swiper-lazy-preloader-white"></div>
                          </div>
                          <div class="swiper-slide">
                            <img src="https://swiperjs.com/demos/images/nature-5.jpg" loading="lazy" />
                            <div class="swiper-lazy-preloader swiper-lazy-preloader-white"></div>
                          </div>
                    </div>
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-pagination"></div>
                  </div>
            </div>
            <div class="card-body">
                <h4 class="card-title my-0">Coal Township Community Gathering</h4>
                <div class="card-text">
                    Sundays: 9am, 10:45am
                </div>

                <div class="card-details">40.4 miles away</div>
            </div>
            <div class="card-footer">
                <a href="#" class="btn btn-sm btn-action btn-square">
                    <svg class="icon"><use xlink:href="#info" /></svg>
                </a>
                <a href="#" class="btn btn-sm btn-action btn-square">
                    <svg class="icon"><use xlink:href="#gathering" /></svg>
                </a>
            </div>
        </div>
    </div>

    <div class="col-xs-12">
        <div class="card card-shadow card-campus card-horizontal h-100">
            <div class="card-img-header bg-primary text-white">
                <svg class="icon"><use xlink:href="#home" /></svg>
            </div>
            <div class="card-body">
                <h4 class="card-title my-0">Home Gathering - College State, West</h4>
                <div class="card-text">
                    Saturdays: 9am
                </div>

                <div class="card-details">40.4 miles away</div>
            </div>
            <div class="card-footer">
                <a href="#" class="btn btn-sm btn-action btn-square">
                    <svg class="icon"><use xlink:href="#info" /></svg>
                </a>
                <a href="#" class="btn btn-sm btn-action btn-square">
                    <svg class="icon"><use xlink:href="#home" /></svg>
                </a>
            </div>
        </div>
    </div>
</div>
{% endcapture %}

