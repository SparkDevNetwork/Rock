/- {% include '~~/Assets/Lava/_SiteNav.lava' %} -/

<div class="container flexfix">
    <div class="navbar-header">
        <a class="navbar-brand" aria-label="LCBC Home" href="/">
            {% raw %}
            <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMinYMid" viewBox="0 0 468 219" class="logo-image"><path d="M302.4 83.7c-.9 5.6-3 10.2-6.5 13.8a29 29 0 0 1-13.3 7.7v.3c3 .3 5.8 1 8.2 2.3 2.4 1.3 4.4 3 6 5.1 1.6 2.1 2.8 4.5 3.5 7.2.8 2.7.9 5.7.4 8.8-.7 5.3-2.4 9.7-5.1 13.1a30.2 30.2 0 0 1-9.7 8.1c-3.9 2-8 3.4-12.6 4.3-4.5.8-8.9 1.2-13.3 1.2h-28.4l13.3-95.3H274c3.9 0 7.7.4 11.4 1.2a26 26 0 0 1 9.6 4c2.6 1.8 4.7 4.2 6.1 7.2 1.5 2.9 1.9 6.6 1.3 11Zm-151.9 39.8a29.3 29.3 0 0 0 30.3 24 39 39 0 0 0 29.5-13.3l7.4 7.1a47.3 47.3 0 0 1-17.3 12.6 53.6 53.6 0 0 1-21.1 4.1c-6.8 0-13-1.3-18.5-3.8a38.6 38.6 0 0 1-22-26.2 58 58 0 0 1 17.8-55.6c4.9-4.5 10.5-8 16.8-10.7a52.2 52.2 0 0 1 38.2-.4c5.6 2.4 10 6.2 13.4 11.5l-10.9 7.1a23.8 23.8 0 0 0-9.4-8.7 28.5 28.5 0 0 0-12.7-2.9c-5.3 0-10.3 1.1-15.1 3.3a46.8 46.8 0 0 0-26.9 36.3c-.8 5.6-.7 10.8.5 15.6ZM417 110.2c45-51.6-3.1-94.9-107.5-96.6-74.7-1.2-158 19.2-215.8 49.9l-11.5 81.6h43.6l-1.4 10.5H69.5l11.9-85.2a174 174 0 0 0-42.3 33.7C-6 155.8 42.2 199 146.5 200.7a481.1 481.1 0 0 0 203.3-43.5 42.1 42.1 0 0 1-23.4-13.4 40.7 40.7 0 0 1-8-15.8 58 58 0 0 1 17.7-55.6c5-4.5 10.6-8 16.9-10.7a51.3 51.3 0 0 1 38.1-.4 28.8 28.8 0 0 1 13.4 11.5l-10.9 7.1a23 23 0 0 0-9.3-8.7c-4-1.9-8.2-2.9-12.8-2.9a41.5 41.5 0 0 0-27.8 12 47.1 47.1 0 0 0-13.7 43.2 30.3 30.3 0 0 0 30.4 24c3.7 0 7.2-.5 10.5-1.4 19.1-11 34.9-23.1 46.1-35.9Zm-148.6.9h-19.3l-4.9 34h19.1a40 40 0 0 0 8.4-.9c2.9-.6 5.5-1.5 7.8-2.8a19 19 0 0 0 6.1-5.2c1.7-2.1 2.7-4.6 3.2-7.7.4-3.3.1-6.1-.8-8.3-1-2.3-2.5-4.1-4.4-5.4a17 17 0 0 0-6.9-2.8 37 37 0 0 0-8.3-.9Zm16.8-37.5a16.8 16.8 0 0 0-6.3-2.2c-2.4-.4-4.9-.6-7.4-.6h-16.8l-4.2 29.8h15.6c2.7 0 5.4-.1 8-.5 2.6-.3 5-1.1 7.2-2.2a15.9 15.9 0 0 0 8.7-12.7c.3-3 .1-5.4-.8-7.2-.9-1.9-2.3-3.3-4-4.4Zm181.7-13.7c-7.1-41.6-76-65.8-178.3-58.4a432.7 432.7 0 0 0-59.9 10.3c24.8-4.1 50-6.3 74.5-6.3l6.4.1c32.9.5 61.8 5.2 83.8 13.6 22.5 8.5 38 21 44.7 36a44.4 44.4 0 0 1 2.2 29.7 76.5 76.5 0 0 1-17.3 30.6 187.8 187.8 0 0 1-48.1 37.5c60.2-26.2 97.4-61.2 92-93.1ZM146.4 208.7c-32.8-.5-61.8-5.2-83.8-13.6-22.5-8.5-38-21-44.6-36a44.1 44.1 0 0 1-2.3-29.6c.8-3.2 1.9-6.4 3.4-9.5l-3 2.9C-57.8 237 141.8 228.4 224 203.1a464.8 464.8 0 0 1-71.2 5.7l-6.4-.1Z" class="c"/></svg>
            {% endraw %}
        </a>
    </div>
    <div id="main-navcol" class="navbar-collapse collapse flexfix">
        <button class="navbar-toggle navbar-toggle-mobile" type="button" data-toggle="collapse" data-target="#main-navcol">
            <i class="fa fa-times"></i>
        </button>
        {% if Page.DisplayChildPages and Page.Pages != empty %}
            <ul class="nav navbar-nav">

                {% for childPage in Page.Pages %}
                    {% assign childCount = childPage.Pages.size %}

                    <li class="{% if childCount > 0 %}dropdown{% endif %} {% if childPage.Current %}active{% endif %}">
                        <a href="{{ childPage.Url }}" data-bs-toggle="dropdown">{{ childPage.Title }}</a>
                        {% if childCount > 0 %}
                            <ul class="dropdown-menu">
                                {%- for grandchildPage in childPage.Pages -%}
                                    <li><a role="menu-item" href="{{ grandchildPage.Url }}">{{ grandchildPage.Title }}</a></li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                    </li>
                {% endfor %}
                {% for includedPage in IncludePageList %}
                    {% assign path = 'Global' | Page:'Path' %}
                    {% assign attributeParts = includedPage | PropertyToKeyValue %}
                    <li{% if path == attributeParts.Value %} class="active"{% endif %}>
                        <a href="{{ attributeParts.Value }}">{{ attributeParts.Key }}</a>
                    </li>
                {% endfor %}

            </ul>
        {% endif %}
    </div>
    <div class="navbar-end">

        <a href="/search" class="btn btn-default btn-nav" aria-label="Search">
            {% raw %}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
            {% endraw %}
        </a>

        {% if CurrentPerson %}
            <div class="dropdown">
            {% if CurrentPerson.PhotoId != null %}
                <button type="button" class="btn btn-default btn-nav btn-user has-photo" data-toggle="dropdown" aria-haspopup="menu" aria-label="View profile and more" aria-expanded="false">
                    <img src="/GetImage.ashx?Id={{ CurrentPerson.PhotoId }}&w=128&h=128" alt="">
                </button>
                {% else %}
                <button type="button" class="btn btn-default btn-nav btn-user" data-toggle="dropdown" aria-haspopup="menu" aria-label="View profile and more" aria-expanded="false">
                    {% raw %}
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    {% endraw %}
                </button>
                {% endif %}
                <ul class="dropdown-menu dropdown-menu-right">
                    <li><a href="/my/details">My Account</a></li>
                    <li><a href="/my">Edit Account</a></li>
                    <li role="separator" class="divider"></li>
                    <li><a href="/logout">Log Out</a></li>
                </ul>
            </div>
        {% else %}
            <a href="/login" class="btn btn-default btn-nav">
                {% raw %}
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                {% endraw %}
            </a>
        {% endif %}

        <button class="navbar-toggle" type="button" data-toggle="collapse" data-target="#main-navcol">
            <i class="fa fa-bars"></i>
        </button>
    </div>
</div>
