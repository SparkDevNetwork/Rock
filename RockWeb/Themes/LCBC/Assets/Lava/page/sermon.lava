/- {% include '~~/Assets/Lava/page/sermon.lava' %} -/

{% assign version = PageParameter.version %}

<div class="container">
    <div class="row g g-6 g-md-3 g-lg-6 justify-content-between mt-0 block-pad-bottom">
        <div class="col-md-9 col-lg-9">
            <div class="mb-3">
                <h5 class="my-0 text-link"><a href="#">Living with Lions</a></h5>
                <h3 class="my-0">When It Feels Like You've Lost Control</h3>
                <span class="d-block">Matt Parks | {{ 'Now' | Date:'MMMM d, yyyy' }}</span>
            </div>

            <section>

                {% case version %}
                    {% when 'podcast' %}
                        <iframe height="200px" width="100%" frameborder="no" scrolling="no" seamless src="https://player.simplecast.com/4a9d928c-a14b-4564-983e-f2cdbecb3cb6?dark=false"></iframe>
                    {% when 'es' %}
                        <div class="embed-responsive embed-responsive-16by9">
                            <iframe width="1280" height="720" src="https://www.youtube.com/embed/0ix_IUVkEnQ" title="Spanish Service August 28, 2022" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                        </div>
                    {% when 'asl' %}
                        <div class="embed-responsive embed-responsive-16by9">
                            <iframe width="1280" height="720" src="https://www.youtube.com/embed/-9cQ_5pogLQ" title="ASL August 27, 2022" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                        </div>
                    {% else %}
                        <div class="embed-responsive embed-responsive-16by9">
                            <img src="https://storage.googleapis.com/lcbc-assets/images/LWL-Week1Thumbnail_2022-10-11-200339_eqbj.jpg" alt="" class="img-responsive" width="1920" height="1080">
                        </div>
                {% endcase %}

            </section>



            <div class="row g g-3 g-lg-5 justify-content-between flexfix mt-4">
                <div class="col-xs-12 col-md-7 col-lg-8 order-2 order-md-1">
                    <h5 class="mt-0">Description</h5>
                    <div>What do we do when it feels like everything is falling apart? When people are being hurt, when the chaos is overwhelming, and it feels like evil has won - is it still possible to trust that God is in control?</div>

                    <div class="mt-3">
                        <i class="fa fa-tag text-primary"></i> <span>Faith</span>
                    </div>

                    <div class="d-flex flex-column align-items-center align-items-md-start mt-4">
                        <strong>Share This Message</strong>
                        <ul class="socialsharing">
                            <li>
                                <a href="https://www.facebook.com/sharer/sharer.php?u={{ 'Global' | Page:'Url' | EscapeDataString }}" onclick="return fbs_click()" target="_blank" class="socialicon socialicon-facebook" title="" data-original-title="Share via Facebook">
                                    <i class="fa fa-fw fa-facebook"></i>
                                </a>
                            </li>
                            <li>
                                <a href="https://twitter.com/intent/tweet?text={{ 'Global' | Page:'Url' | EscapeDataString }}" class="socialicon socialicon-twitter" title="" data-original-title="Share via Twitter">
                                    <i class="fa fa-fw fa-twitter"></i>
                                </a>
                            </li>
                            <li>
                                <a href="mailto:?Subject={{ Event.Name | EscapeDataString }}&Body={{ 'Global' | Page:'Url' }}" class="socialicon socialicon-email" title="" data-original-title="Share via Email">
                                    <i class="fa fa-fw fa-envelope-o"></i>
                                </a>
                            </li>
                            <li>
                                <a href="#" class="socialicon socialicon-email btn-copy-url" title="" data-original-title="Copy URL">
                                    <i class="fa fa-fw fa-clipboard"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="col-xs-12 col-md-5 col-lg-4 order-1 order-md-2">
                    <h5 class="mt-0">Other Ways to Tune In</h5>
                    <div class="list-group list-group-lcbc">

                        <a href="/page/1825?version=video" class="list-group-item {% if version == null or version == 'video' %}active{% endif %}"><span>Watching Message Video</span>
                            <img src="{{ '~~/Assets/Images/icons/play-circle.svg' | ResolveRockUrl }}" alt="">
                        </a>
                        <a href="/page/1825?version=podcast" class="list-group-item {% if version == 'podcast' %}active{% endif %}"><span>Listen{% if version == 'podcast' %}ing{% endif %} to Podcast</span> <img src="{{ '~~/Assets/Images/icons/waves.svg' | ResolveRockUrl }}" alt=""></a>
                        <a href="/page/1825?version=es" class="list-group-item {% if version == 'es' %}active{% endif %}"><span>Watch{% if version == 'es' %}ing{% endif %} Spanish Translation</span><img src="{{ '~~/Assets/Images/icons/es.svg' | ResolveRockUrl }}" alt=""></a>
                        <a href="/page/1825?version=asl" class="list-group-item {% if version == 'asl' %}active{% endif %}"><span>Watch{% if version == 'asl' %}ing{% endif %} ASL Translation</span><img src="{{ '~~/Assets/Images/icons/asl.svg' | ResolveRockUrl }}" alt=""></a>
                      </div>
                </div>
            </div>

        </div>

        <div class="col-md-3">
            <h4>More in this Series</h4>
            {% for i in (1..4) %}
                <div class="card card-transparent">
                    <img src="https://storage.googleapis.com/lcbc-assets/images/Foolproof-YoutubeThumbnail-Week1_2022-10-11-190500_doek.jpg" class="card-img-top" alt="">
                    <div class="card-body">
                        <h6 class="card-title"><a href="#" class="stretched-link">Living with Lions</a></h6>
                        <span class="text-sm d-block card-subtitle">Matt Parks  |  August 28, 2022</span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
