/- {% include '~~/Assets/Lava/page/landingpage.lava' %} -/
{% assign pageNavigation = Item | Attribute:'PageNavigation' %}

{% assign heroImage = Item | Attribute:'HeaderImage','Object' %}
{% assign heroVideo = Item | Attribute:'HeaderVideo','RawValue' %}
{% assign heroTemplate = Item | Attribute:'HeroTemplate','RawValue' %}

{% assign timesLocationsCategory = Item | Attribute:'TimesLocationsCategoryId' %}

{% assign churchOnlineCategoryId = Item | Attribute:'ChurchOnlineScheduleCategoryId' %}

{% assign showShare = Item | Attribute:'ShowShare','RawValue' | AsBoolean %}
{% assign share = Item | Attribute:'Share' %}

{% assign faqs = Item | Attribute:'FAQs','Object' %}
{% assign digitalInviteUrl = Item | Attribute:'DigitalInviteURL' %}
                {% assign timesLocation = Item | Attribute:'TimesLocationsLinks' %}

<nav id="main-navcol" class="navbar navbar-default navbar-static-top">
    <div class="container flexfix">
        <div class="navbar-header">
            <a class="navbar-brand" aria-label="LCBC Home" href="/">
                <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMinYMid" viewBox="0 0 468 219" class="logo-image"><g style="fill:none"><path style="fill:none" d="M467.4 219V.2H0V219z"></path><path d="M302.4 83.7c-.9 5.6-3 10.2-6.5 13.8a29 29 0 0 1-13.3 7.7v.3c3 .3 5.8 1 8.2 2.3 2.4 1.3 4.4 3 6 5.1 1.6 2.1 2.8 4.5 3.5 7.2.8 2.7.9 5.7.4 8.8-.7 5.3-2.4 9.7-5.1 13.1a30.2 30.2 0 0 1-9.7 8.1c-3.9 2-8 3.4-12.6 4.3-4.5.8-8.9 1.2-13.3 1.2h-28.4l13.3-95.3H274c3.9 0 7.7.4 11.4 1.2a26 26 0 0 1 9.6 4c2.6 1.8 4.7 4.2 6.1 7.2 1.5 2.9 1.9 6.6 1.3 11Zm-151.9 39.8a29.3 29.3 0 0 0 30.3 24 39 39 0 0 0 29.5-13.3l7.4 7.1a47.3 47.3 0 0 1-17.3 12.6 53.6 53.6 0 0 1-21.1 4.1c-6.8 0-13-1.3-18.5-3.8a38.6 38.6 0 0 1-22-26.2 58 58 0 0 1 17.8-55.6c4.9-4.5 10.5-8 16.8-10.7a52.2 52.2 0 0 1 38.2-.4c5.6 2.4 10 6.2 13.4 11.5l-10.9 7.1a23.8 23.8 0 0 0-9.4-8.7 28.5 28.5 0 0 0-12.7-2.9c-5.3 0-10.3 1.1-15.1 3.3a46.8 46.8 0 0 0-26.9 36.3c-.8 5.6-.7 10.8.5 15.6ZM417 110.2c45-51.6-3.1-94.9-107.5-96.6-74.7-1.2-158 19.2-215.8 49.9l-11.5 81.6h43.6l-1.4 10.5H69.5l11.9-85.2a174 174 0 0 0-42.3 33.7C-6 155.8 42.2 199 146.5 200.7a481.1 481.1 0 0 0 203.3-43.5 42.1 42.1 0 0 1-23.4-13.4 40.7 40.7 0 0 1-8-15.8 58 58 0 0 1 17.7-55.6c5-4.5 10.6-8 16.9-10.7a51.3 51.3 0 0 1 38.1-.4 28.8 28.8 0 0 1 13.4 11.5l-10.9 7.1a23 23 0 0 0-9.3-8.7c-4-1.9-8.2-2.9-12.8-2.9a41.5 41.5 0 0 0-27.8 12 47.1 47.1 0 0 0-13.7 43.2 30.3 30.3 0 0 0 30.4 24c3.7 0 7.2-.5 10.5-1.4 19.1-11 34.9-23.1 46.1-35.9Zm-148.6.9h-19.3l-4.9 34h19.1a40 40 0 0 0 8.4-.9c2.9-.6 5.5-1.5 7.8-2.8a19 19 0 0 0 6.1-5.2c1.7-2.1 2.7-4.6 3.2-7.7.4-3.3.1-6.1-.8-8.3-1-2.3-2.5-4.1-4.4-5.4a17 17 0 0 0-6.9-2.8 37 37 0 0 0-8.3-.9Zm16.8-37.5a16.8 16.8 0 0 0-6.3-2.2c-2.4-.4-4.9-.6-7.4-.6h-16.8l-4.2 29.8h15.6c2.7 0 5.4-.1 8-.5 2.6-.3 5-1.1 7.2-2.2a15.9 15.9 0 0 0 8.7-12.7c.3-3 .1-5.4-.8-7.2-.9-1.9-2.3-3.3-4-4.4Zm181.7-13.7c-7.1-41.6-76-65.8-178.3-58.4a432.7 432.7 0 0 0-59.9 10.3c24.8-4.1 50-6.3 74.5-6.3l6.4.1c32.9.5 61.8 5.2 83.8 13.6 22.5 8.5 38 21 44.7 36a44.4 44.4 0 0 1 2.2 29.7 76.5 76.5 0 0 1-17.3 30.6 187.8 187.8 0 0 1-48.1 37.5c60.2-26.2 97.4-61.2 92-93.1ZM146.4 208.7c-32.8-.5-61.8-5.2-83.8-13.6-22.5-8.5-38-21-44.6-36a44.1 44.1 0 0 1-2.3-29.6c.8-3.2 1.9-6.4 3.4-9.5l-3 2.9C-57.8 237 141.8 228.4 224 203.1a464.8 464.8 0 0 1-71.2 5.7l-6.4-.1Z" class="c"></path></g></svg>
            </a>
        </div>
        <div id="main-navcol" class="navbar-collapse collapse flexfix flex-fill">
            <ul class="nav navbar-nav">

                {% if timesLocationsCategory != '' %}
                    <li>
                        <a href="#times">Times</a>
                    </li>
                {% endif %}

                {% if churchOnlineCategoryId != '' %}
                <li>
                    <a href="#churchonline">Church Online</a>
                </li>
                {% endif %}

                {% if digitalInviteUrl != '' %}
                    <li>
                        <a href="#invite">Invite</a>
                    </li>
                {% endif %}

                {% if showShare %}
                <li>
                    <a href="#share">Share</a>
                </li>
                {% endif %}

                {% if faqs and faqs.AttributeMatrixItems != empty %}
                <li>
                    <a href="#faqs">FAQs</a>
                </li>
                {% endif %}

                {% for link in pageNavigation %}
                    {% assign attributeParts = link | PropertyToKeyValue %}
                    <li>
                        <a href="{{ attributeParts.Value }}">{{ attributeParts.Key }}</a>
                    </li>
                {% endfor %}
            </ul>
        </div>
        <div class="navbar-end">
            <a href="/search" class="btn btn-default btn-nav">
                <i class="fa fa-search"></i>
            </a>

            <div class="dropdown">

                <button type="button" class="btn btn-default btn-nav btn-user has-photo" data-toggle="dropdown" aria-haspopup="menu" aria-label="View profile and more" aria-expanded="false">
                    <img src="/GetImage.ashx?Id=706&amp;w=128&amp;h=128" alt="">
                </button>

                <ul class="dropdown-menu dropdown-menu-right">
                    <li><a href="/my/details">My Account</a></li>
                    <li><a href="/my">Edit Account</a></li>
                    <li role="separator" class="divider"></li>
                    <li><a href="/logout">Log Out</a></li>
                </ul>
            </div>

            <button class="navbar-toggle" type="button" data-toggle="collapse" data-target=".navbar-collapse">
                <i class="fa fa-bars"></i>
            </button>

        </div>
    </div>
</nav>

<section class="page-header has-image full-page" role="banner">
    {% if heroVideo != '' %}
        <video id="hero-video" autoplay loop muted playsinline class="hero-video" preload="auto">
            <source src="{{ heroVideo }}" type="video/mp4">
        </video>
        <div class="hero-overlay"></div>
    {% else %}
        {% if heroImage != empty %}
            {% assign photoUrl = heroImage.Guid | Prepend:'/GetImage.ashx?Guid=' %}
            {% assign width = heroImage.Width %}
            <img
                src="{{ photoUrl | TriumphImgCdn:'w=1100&h=550&fit=crop&auto=compress' }}"
                srcset="{%- if width >= 550 -%}{{ photoUrl | TriumphImgCdn:'w=350&h=175&fit=crop&auto=format,compress' }} 350w{%- endif -%}
                        {%- if width >= 1100 -%},{{ photoUrl | TriumphImgCdn:'w=750&h=375&fit=crop&auto=format,compress' }} 750w{%- endif -%}
                        {%- if width >= 1445 -%},{{ photoUrl | TriumphImgCdn:'w=1100&h=550&fit=crop&auto=format,compress' }} 1100w{%- endif -%}
                        {%- if width >= 1680 -%},{{ photoUrl | TriumphImgCdn:'w=1500&h=750&fit=crop&auto=format,compress' }} 1500w{%- endif -%}
                        {%- if width >= 2048 -%},{{ photoUrl | TriumphImgCdn:'w=2200&h=1100&fit=crop&auto=format,compress' }} 2200w{%- endif -%}
                        {%- if width >= 3000 -%},{{ photoUrl | TriumphImgCdn:'w=3000&h=1500&fit=crop&auto=format,compress' }} 3000w{%- endif -%}"
                sizes="100vw"
                class="hero-image"
                alt=""
                width="{{ heroImage.Width }}"
                height="{{ heroImage.Height }}"
                itemprop="image">
            <div class="hero-overlay"></div>
        {% endif %}
    {% endif %}

    <!-- Start Hero Template -->
    {{ heroTemplate | RunLava }}
    <!-- End Hero Template -->

    <a href="#main">
        <div class="hero-arrow bounce">
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" class="arrow-circle-down bounce">
              <path d="M191.1 352c-1.1 0-3.969-.7344-5.531-2.219L34.47 205.8c-3.187-3.047-3.312-8.125-.25-11.31c3.094-3.188 8.156-3.281 11.31-.25l146.5 138.7l146.5-138.7c3.219-3.031 8.281-2.938 11.31 .25c3.062 3.188 2.937 8.266-.25 11.31l-151.1 144C195.1 351.3 193.1 352 191.1 352z" fill="#fff"></path>
           </svg>
        </div>
     </a>
</section>

<section id="main" class="page-section">
    {{ Item.Content | RunLava }}
</section>

{% if timesLocationsCategory != '' %}
    {% assign timesLocationsCategory = timesLocationsCategory | AsInteger  %}
    <section id="times" class="page-section bg-gray">
        <div class="container text-center">
            <h1 class="display-2">Times &amp; Locations</h1>
            {% assign timesLocation = Item | Attribute:'TimesLocationsLinks' %}

            {% for link in timesLocation %}
                {% assign attributeParts = link | PropertyToKeyValue %}
                {% if forloop.index0 == 2 %}<br class="d-none d-sm-block">{% endif %}
                <a href="{{ attributeParts.Value }}" class="btn {% if forloop.first %}btn-primary{% elseif forloop.index0 == 1%}btn-outline-primary{% else %}btn-link{% endif %} btn-lg d-block d-sm-inline-block mb-2 mb-sm-0">{{ attributeParts.Key }}</a>
            {% endfor %}

            <hr>
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <h5>Our Times</h5>
                <input type="text" placeholder="Search for a Location" class="form-control input-width-xl js-filter-items-search" spellcheck="false">
            </div>

            {% assign gatherings = 'GatheringsSource' | PersistedDataset %}

            <div class="js-filter-items col3 text-left">
            {[ accordion paneltype:'primary' firstopen:'false' ]}
            {% for campusItem in gatherings %}
                {% assign schedules = campusItem.Schedules | Where:'CategoryId',timesLocationsCategory %}
                [[ item title:'{{ campusItem | Property:'CampusName' }}' ]]
                    {% assign hasASL = false | AsBoolean %}
                    {% assign hasES = false | AsBoolean %}
                    {% assign prevDay = '' %}
                    {% for schedule in schedules %}
                        {% if schedule.NextDayOfWeek != prevDay %}
                            {% if prevDay != '' %}</span></div>{% endif %}
                            <div class="d-flex justify-content-between">
                            <strong>{{ schedule.NextDayOfWeek }}, {{ schedule.NextStartDateTime | Date:'MMMM d' }}</strong>
                            <span class="text-right">
                        {% endif %}

                        {{ schedule.NextStartDateTime | Date:'h:mmtt' | Downcase }}{% if schedule.ASL == 'true' and schedule.Espanol == 'true' %}<sup>ES/ASL</sup>{% assign hasASL = true %}{% assign hasES = true %}{% elseif schedule.ASL == 'True' %}<sup>ASL</sup>{% assign hasASL = true %}{% elseif schedule.Espanol == 'true' %}<sup>ES</sup>{% assign hasES = true %}{% endif %}/-Commas-/{% if forloop.last %}</div>{% else %}{% assign nextItemI = forloop.index0 | Plus:1 %}{% assign nextItem = schedules[nextItemI].NextDayOfWeek %}{% if nextItem == schedule.NextDayOfWeek %},{% endif %}{% endif %}

                        {% assign prevDay = schedule.NextDayOfWeek %}
                    {% endfor %}

                    {% if hasES or hasASL %}
                        <div class="mt-3 text-sm o-70">
                            {% if hasES %}
                                <span class="d-block"><sup>ES</sup> Traducción en español disponible</span>
                            {% endif %}
                            {% if hasASL %}
                                <span class="d-block"><sup>ASL</sup> ASL translation available</span>
                            {% endif %}
                        </div>
                    {% endif %}

                [[ enditem ]]
            {% endfor %}
            {[ endaccordion ]}
            </div>

        </div>
    </section>
{% endif %}

{% if churchOnlineCategoryId != '' %}
    {% assign gatherings = 'GatheringsSource' | PersistedDataset %}
    {% assign gatherings = gatherings | Where:'CampusId',15 %}
    <section id="churchonline" class="page-section">
        <div class="container text-center">
            <h1 class="display-2">Church Online</h1>
            <a href="https://lcbc.online.church/" class="btn btn-primary btn-lg">Watch Online</a>

            <div class="row mt-5">
                <div class="col-xs-12">
                    <div class="list-group list-group-flush">
                        {% for campusItem in gatherings %}
                            {% assign schedules = campusItem.Schedules | Where:'CategoryId',timesLocationsCategory %}
                                {% assign hasASL = false | AsBoolean %}
                                {% assign hasES = false | AsBoolean %}
                                {% assign prevDay = '' %}
                                {% for schedule in schedules %}
                                    {% if schedule.NextDayOfWeek != prevDay %}
                                        {% if prevDay != '' %}</span></li>{% endif %}
                                        <li class="list-group-item d-flex flexfix justify-content-between bg-transparent"><span class="h6 text-nowrap mr-3">
                                        {{ schedule.NextDayOfWeek }}, {{ schedule.NextStartDateTime | Date:'MMMM d' }}</span>
                                        <span class="text-right h6">
                                    {% endif %}

                                    {{ schedule.NextStartDateTime | Date:'h:mmtt' | Downcase }}{% if schedule.ASL == 'true' and schedule.Espanol == 'true' %}<sup>ES/ASL</sup>{% assign hasASL = true %}{% assign hasES = true %}{% elseif schedule.ASL == 'True' %}<sup>ASL</sup>{% assign hasASL = true %}{% elseif schedule.Espanol == 'true' %}<sup>ES</sup>{% assign hasES = true %}{% endif %}/-Commas-/{% if forloop.last %}</span></li>{% else %}{% assign nextItemI = forloop.index0 | Plus:1 %}{% assign nextItem = schedules[nextItemI].NextDayOfWeek %}{% if nextItem == schedule.NextDayOfWeek %},{% endif %}{% endif %}

                                    {% assign prevDay = schedule.NextDayOfWeek %}
                                {% endfor %}

                                {% if hasES or hasASL %}
                                    <div class="mt-3 text-sm o-70">
                                        {% if hasES %}
                                            <span class="d-block"><sup>ES</sup> Traducción en español disponible</span>
                                        {% endif %}
                                        {% if hasASL %}
                                            <span class="d-block"><sup>ASL</sup> ASL translation available</span>
                                        {% endif %}
                                    </div>
                                {% endif %}

                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endif %}

{% if digitalInviteUrl != '' %}
    {% capture pageUrl %}https://{{ 'Global' | Page:'Host' }}{{ 'Global' | Page:'Path' }}{% endcapture %}
    {{ '/Scripts/clipboard.js/clipboard.min.js' | AddScriptLink }}
    <script>
    $('#copy').tooltip({
    trigger: 'click',
    placement: 'bottom'
  });

  function setTooltip(message) {
    $('#copy').tooltip('hide')
      .attr('data-original-title', message)
      .tooltip('show');
  }

  function hideTooltip() {
    setTimeout(function() {
      $('#copy').tooltip('hide');
    }, 1000);
  }

  // Clipboard
  var clipboard = new ClipboardJS('#copy');

  clipboard.on('success', function(e) {
       setTooltip('Copied!');
       hideTooltip();
  });

  clipboard.on('error', function(e) {
      setTooltip('Failed!');
      hideTooltip();
  });
    </script>
    <section class="page-section bg-gray">
        <div class="container text-center">
            <h1 class="display-2">Invite Someone</h1>
            <a href="{{ digitalInviteUrl }}" class="btn btn-primary btn-lg d-block d-sm-inline-block">Digital Invite</a>

            <div class="mt-5">
                <strong>Other Ways to Invite</strong>
                <div class="d-flex gap-2 mt-2 flex-column flex-sm-row justify-content-center">
                    <a href="https://www.facebook.com/share.php?u={{ pageUrl }}&title={{ Item.Title | EscapeDataString | Replace:' ','%20' }}" class="btn btn-muted d-block d-sm-inline-block" target="_blank"><i class="fa fa-facebook text-facebook icon-left"></i>Facebook</a>
                    <a href="https://twitter.com/intent/tweet?text=You%27re%20invited%20to%20join%20me%20for%20{{ Item.Title | EscapeDataString | Replace:' ','%20' }}!+{{ pageUrl }}" class="btn btn-muted d-block d-sm-inline-block" target="_blank"><i class="fa fa-twitter text-twitter icon-left"></i>Twitter</a>
                    <button id="copy" class="btn btn-muted d-block d-sm-inline-block" type="button" data-clipboard-text="{{ pageUrl }}">
                        <i class="fa fa-clipboard text-curlean o-70 icon-left"></i>Copy URL
                    </button>
                </div>
            </div>
        </div>
    </section>
{% endif %}

{% if showShare %}
    {% assign shareImages = Item | Attribute:'ShareImages','Object' %}
    {% assign shareImagesCount = shareImages.AttributeMatrixItems | Size %}
    <section id="share" class="page-section">
        {{ share | RunLava }}
        {% if shareImagesCount > 0 %}
            <div class="container overflow-hidden">
                <div class="row g g-4 g-lg-6">
                    {% for item in shareImages.AttributeMatrixItems %}
                        {% assign image = item | Attribute:'Image','RawValue' %}
                        <div class="col-xs-6 col-md-4">
                            //- Use Get Image directly (At the same domain) to download image.
                            <a href="/GetImage.ashx?guid={{ image }}" download="image">
                                <img src="/GetImage.ashx?guid={{ image }}" alt="" class="img-responsive shadow">
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

    </section>
{% endif %}

{% if faqs and faqs.AttributeMatrixItems != empty %}
    <section id="FAQs" class="page-section bg-gray">
        <div class="container text-center">
            <h1 class="display-2">FAQS</h1>
        </div>

        {% assign firstCol = '' %}
        {% assign secondCol = '' %}
        {% assign questionCount = faqs.AttributeMatrixItems | Size %}
        {% for item in faqs.AttributeMatrixItems %}
            {% assign mod = forloop.index | Modulo:2 %}
            {% assign question = item | Attribute:'Question' %}
            {% assign answer = item | Attribute:'Description1' %}

            {% capture output %}
                [[ item title:'{{ question }}' ]]
                    {{ answer }}
                [[ enditem ]]
            {% endcapture %}

            {% if questionCount > 4 %}
                {%- if mod == 0 -%}
                    {% assign firstCol = firstCol | Append:output %}
                {%- else -%}
                    {% assign secondCol = secondCol | Append:output %}
                {%- endif -%}
            {% else %}
                {% assign firstCol = firstCol | Append:output %}
            {% endif %}
        {% endfor %}

        <div class="container">
            <div class="row g justify-content-center">
                <div class="col-md-6 col-xs-12">
                    {[ accordion ]}
                        {{ firstCol }}
                    {[ endaccordion ]}
                </div>
                {% if questionCount > 4 %}
                    <div class="col-md-6 col-xs-12">
                        {[ accordion ]}
                            {{ secondCol }}
                        {[ endaccordion ]}
                    </div>
                {% endif %}
            </div>
        </div>
    </section>
{% endif %}
