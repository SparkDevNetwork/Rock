<section class="page-section">
    <div class="container">
        <section class="page-section bg-primary text-center rounded px-3">
            <div class="row d-flex justify-content-center">
                <div class="col-md-8">
                    <h3 class="mt-0 mb-3 text-white">Looking for a location near you?<br>
                    Explore our current Locations of Interest</h3>
                    <p>At LCBC, our mission is to introduce people to Jesus and together fully follow him. We want to continue to see that happen across the state of Pennsylvania, and we want to invite you into that opportunity with us!</p>
                    <a href="#" class="btn btn-default btn-lg mt-3">View Locations of Interest</a>
                </div>
            </div>
        </section>
    </div>
</section>


<section class="page-section bg-gray">
