                    <div class="col-xs-12 col-md-6 mb-2 mb-md-0"><a href="#" class="btn btn-primary btn-lg d-block"><i class="fa fa-youtube icon-left icon-fade"></i>Watch Now</a></div>
                    <div class="col-xs-12 col-md-6"><a href="#" class="btn btn-primary btn-lg d-block"><i class="fa fa-map-marker icon-left icon-fade"></i>Find a Location</a></div>
