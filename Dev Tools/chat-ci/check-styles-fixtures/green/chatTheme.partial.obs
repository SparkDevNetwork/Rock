<style>
/* The token sheet is the one file allowed to hold the values every component reads. */
.chat-shell {
    --chat-surface: var(--color-interface-softest, #fdfdfd);
    --chat-hover: rgba(13, 17, 23, .045);
    --chat-ease-in: cubic-bezier(.1, .9, .2, 1);
    --chat-t-msg: 260ms;
    --chat-spin: .7s;
}
</style>
