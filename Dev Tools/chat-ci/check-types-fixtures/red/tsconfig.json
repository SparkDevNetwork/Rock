{
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2016",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["DOM", "ES2016"]
  },
  "vueCompilerOptions": {
    "extensions": [".obs"]
  },
  "include": ["./**/*.ts", "./**/*.obs"]
}
