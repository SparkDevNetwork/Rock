<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Rock.SchemaCheck</RootNamespace>
    <AssemblyName>Rock.SchemaCheck</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!--
        The comparison core lives in Rock.dll (internal, no EF). This tool adds
        the command line and the EF6 model adapter, which is the only code that
        reads EF metadata.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Rock\Rock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Match the version Rock.csproj resolves to avoid a conflicting graph. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The integration tests run the mapping check with the EF6 model adapter. -->
    <InternalsVisibleTo Include="Rock.Tests.Integration" />
  </ItemGroup>

</Project>
