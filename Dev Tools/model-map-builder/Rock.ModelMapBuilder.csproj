<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Rock.ModelMapBuilder</RootNamespace>
    <AssemblyName>Rock.ModelMapBuilder</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!--
        This tool loads Rock's internal configuration types (RockApp, HostingSettings,
        etc.) to stand up a headless RockApp. Building against the source Rock.csproj
        guarantees it always reflects over this checkout's Rock.dll.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Rock\Rock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Match the version Rock.csproj resolves to avoid a conflicting graph. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

</Project>
